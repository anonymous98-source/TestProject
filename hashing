import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.oauth2.server.resource.authentication.BearerTokenAuthentication;

@Slf4j
public class SecurityContextExtractor {

    private SecurityContextExtractor() {
        throw new IllegalStateException("Utility class");
    }



    public static String getAccessToken() {
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        if (auth != null) {
            if (auth instanceof BearerTokenAuthentication bearerTokenAuthentication) {
                log.atInfo().setMessage("Authentication is of type BearerTokenAuthentication").log();
                return bearerTokenAuthentication.getToken().getTokenValue();
            } else if (auth instanceof AbstractAuthenticationToken tokenAuth) {
                log.atInfo().setMessage("Authentication is of type AbstractAuthenticationToken").log();
                return (String) tokenAuth.getCredentials();
            }
        }
        
        log.atInfo().setMessage("Returned auth token is Null from SecurityContextExtractor").log();
        return null;
    }
}

