            String flowType,
            Long responseTime) {

        String apiCode = getApiCode(flowType);
        UUID shipmentId = null;

        if (responseDto instanceof ShipmentBookResponseDto shipmentBookResponseDto) {
            shipmentId = CommonUtil.getUUIDFromString(shipmentBookResponseDto.getId());
        }

        SendFlexRecordDto sendFlexRecordDto = SendFlexRecordDto.builder()
