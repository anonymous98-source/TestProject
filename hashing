    MessagingSubscriber.configure(googlePubsubConfig, subscription, super::handleMessage);
  }

  @Override
  @SneakyThrows
  protected void receiveMessage(PubsubMessage pubsubMessage) {
    dlqMessagePersister.persistMessage(pubsubMessage, serviceName, topic);
  }
}

