    @Test
    void groupAndSortDeliveryDates_normalDates_sortedCorrectly() {
        // Arrange: two dates out of order, each with unsorted slots
        List<DeliveryDateDto> deliveryDates = new ArrayList<>();

        DeliveryDateDto date1 = new DeliveryDateDto();
        date1.setDeliveryDate("2023-10-02");
        List<DeliverySlot> slots1 = new ArrayList<>();
        DeliverySlot slot1 = new DeliverySlot();
        slot1.setDeliveryTime("14:00:00");
        slots1.add(slot1);
        DeliverySlot slot2 = new DeliverySlot();
        slot2.setDeliveryTime("09:00:00");
        slots1.add(slot2);
        date1.setAvailableSlots(slots1);

        DeliveryDateDto date2 = new DeliveryDateDto();
        date2.setDeliveryDate("2023-10-01");
        List<DeliverySlot> slots2 = new ArrayList<>();
        DeliverySlot slot3 = new DeliverySlot();
        slot3.setDeliveryTime("11:00:00");
        slots2.add(slot3);
        date2.setAvailableSlots(slots2);

        deliveryDates.add(date1);
        deliveryDates.add(date2);

        // Act
        List<DeliveryDateDto> result = shipPlanDataMapperService.groupAndSortDeliveryDates(deliveryDates);

        // Assert: dates sorted ascending
        assertEquals(2, result.size());
        assertEquals("2023-10-01", result.get(0).getDeliveryDate());
        assertEquals("2023-10-02", result.get(1).getDeliveryDate());

        // Assert: slots within each date sorted ascending by time
        List<DeliverySlot> sortedSlots = result.get(1).getAvailableSlots();
        assertEquals(2, sortedSlots.size());
        assertEquals("09:00:00", sortedSlots.get(0).getDeliveryTime());
        assertEquals("14:00:00", sortedSlots.get(1).getDeliveryTime());
    }

    @Test
    void groupAndSortDeliveryDates_nullDatePresent_sortedCorrectly() {
        // Arrange: one normal date and one null date (null should sort last)
        List<DeliveryDateDto> deliveryDates = new ArrayList<>();

        DeliveryDateDto dateWithNull = new DeliveryDateDto();
        dateWithNull.setDeliveryDate(null);
        List<DeliverySlot> nullSlots = new ArrayList<>();
        DeliverySlot nullSlot = new DeliverySlot();
        nullSlot.setDeliveryTime("08:00:00");
        nullSlots.add(nullSlot);
        dateWithNull.setAvailableSlots(nullSlots);

        DeliveryDateDto normalDate = new DeliveryDateDto();
        normalDate.setDeliveryDate("2023-10-01");
        List<DeliverySlot> normalSlots = new ArrayList<>();
        DeliverySlot normalSlot = new DeliverySlot();
        normalSlot.setDeliveryTime("10:00:00");
        normalSlots.add(normalSlot);
        normalDate.setAvailableSlots(normalSlots);

        deliveryDates.add(dateWithNull);
        deliveryDates.add(normalDate);

        // Act
        List<DeliveryDateDto> result = shipPlanDataMapperService.groupAndSortDeliveryDates(deliveryDates);

        // Assert: non-null date comes first, null date is last (nullsLast)
        assertEquals(2, result.size());
        assertEquals("2023-10-01", result.get(0).getDeliveryDate());
        assertNull(result.get(1).getDeliveryDate());

        // Assert: null-date slot gets LocalDateTime.MAX so it still appears in the list
        assertEquals(1, result.get(1).getAvailableSlots().size());
        assertEquals("08:00:00", result.get(1).getAvailableSlots().get(0).getDeliveryTime());
    }

    @Test
    void groupAndSortDeliveryDates_nullTimePresent_sortedCorrectly() {
        // Arrange: one date with a null-time slot mixed with normal-time slots
        List<DeliveryDateDto> deliveryDates = new ArrayList<>();

        DeliveryDateDto date1 = new DeliveryDateDto();
        date1.setDeliveryDate("2023-10-01");
        List<DeliverySlot> slots = new ArrayList<>();

        DeliverySlot slot1 = new DeliverySlot();
        slot1.setDeliveryTime("10:00:00");
        slots.add(slot1);

        DeliverySlot slot2 = new DeliverySlot();
        slot2.setDeliveryTime(null);
        slots.add(slot2);

        DeliverySlot slot3 = new DeliverySlot();
        slot3.setDeliveryTime("08:00:00");
        slots.add(slot3);

        date1.setAvailableSlots(slots);
        deliveryDates.add(date1);

