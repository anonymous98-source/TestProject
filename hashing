                                        .value(charge.getValue())
                                        .build())
                                .collect(Collectors.toList()))
                        .baseCost(totalBaseChargeAmount)
                        .accessorialCost(totalSurchargeAmount)
                        //.baseChargeAmount(total-surcharge)
                        .total(total)
                        .build();
            } else if (ocmResponseDTO != null && ocmResponseDTO.getCustomer() != null &&
                    ocmResponseDTO.getCustomer().getUspsPricingVisibility().equalsIgnoreCase(ServiceCommonConstants.SHOW_TOTAL_PRICING_ONLY)) {
                total = charges.stream().filter(t -> PRICE_TOTAL.equalsIgnoreCase(t.getType())).findFirst().map(ChargeDTO::getValue).orElse(null);
                return PriceResult.builder()
                        .lineItem(lineItem)
                        .baseCost(totalBaseChargeAmount)
                        .accessorialCost(totalSurchargeAmount)
                        .total(total)
                        .build();
            }
            return PriceResult.builder()
                    .lineItem(lineItem)
                    .baseCost(totalBaseChargeAmount)
                    .accessorialCost(totalSurchargeAmount)
                    .total(total)
                    .build();
        }
        return null;
    }


    /**
     * Maps the shipment booking request to the shipment request model.
     *
     * @param shipmentBookRequest the request containing shipment booking details.
     * @return ShipmentRequestModel containing the mapped shipment request details.
     */

    public ShipmentRequestModel maptoShipmentRequestModel(ShipmentBookRequest shipmentBookRequest,
                                                          Map<String, String> customerDetails) {
        Address shipFromAdd = Address.builder()
                .streetLines(shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getAddressLines())
                .city(shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getCity())
                .residential(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().isResidential())
                .countryCode(shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getCountry())
                .stateOrProvinceCode(shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getState())
                .postalCode(shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getZipCode())
                .build();

        Address shipToAdd = Address.builder()
                .streetLines(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getAddressLines())
                .city(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getCity())
                .residential(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().isResidential())
                .countryCode(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getCountry())
                .stateOrProvinceCode(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getState())
                .postalCode(shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getZipCode())
                .build();

        Shipper shipper = Shipper.builder().address(shipFromAdd).build();
        Recipient recipient = Recipient.builder().address(shipToAdd).build();

        List<RequestedPackageLineItem> requestedPackageLineItemList =
                shipmentBookRequest.getPackagingDetails()
                        .stream()
                        .map(packagingDetails -> getRequestedPackageLineItem(shipmentBookRequest, packagingDetails))
                        .collect(Collectors.toList());


        return getShipmentRequestModel(shipmentBookRequest,
                getRequestedShipment(shipmentBookRequest, shipper, recipient, requestedPackageLineItemList), customerDetails);
    }

    private ShipmentRequestModel getShipmentRequestModel(
            ShipmentBookRequest shipmentBookRequest,
            RequestedShipment requestedShipment,
            Map<String, String> customerDetails) {

        if (CollectionUtils.isEmpty(customerDetails)) {
            customerDetails = customerHierarchyServiceImpl
                    .getCustomerHierarchyDetailsForBook(
                            shipmentBookRequest.getFacilityId());
        }

        return ShipmentRequestModel.builder()
                .billingGroupId(UUID.fromString(customerDetails.get("sustainId")))
                .requestId(UUID.randomUUID())
                .requestedShipment(requestedShipment)
                .carrierCodes(getCarrierCodes(shipmentBookRequest))
                .build();
    }

    public List<CarrierCode> getCarrierCodes(ShipmentBookRequest shipmentBookRequest) {
        CarrierCode carrierCodes = CarrierCode.builder().build();

        ServiceLevelEntity serviceLevelEntity =
                serviceLevelRepository.findBySendflexShipVia(shipmentBookRequest.getShipViaOptions().get(0).getCode());
        carrierCodes.setValue(serviceLevelEntity.getCarrierCode());
        return Collections.singletonList(carrierCodes);

    }


    private RequestedShipment getRequestedShipment(ShipmentBookRequest shipmentBookRequest,
                                                   Shipper shipper, Recipient recipient,
                                                   List<RequestedPackageLineItem> requestedPackageLineItemList) {
        return RequestedShipment.builder()
                .rateRequestType(List.of(RATE_REQUEST_TYPE_ACCOUNT))
                .shipper(shipper)
                .recipient(recipient)
                .packagingType(YOUR_PACKAGING)
                .pickupType(USE_SCHEDULED_PICKUP)
                .isShipmentProtection(getIsShipmentProtection(shipmentBookRequest.getPackagingDetails()))
                .serviceType(getServiceType(shipmentBookRequest))
                .shipDateStamp(OffsetDateTime.parse(shipmentBookRequest.getShipByDate()).toLocalDate().toString())
                .totalPackageCount(shipmentBookRequest.getTotalPackageCount())
                .requestedPackageLineItems(requestedPackageLineItemList)
                .build();
    }

    public boolean getIsShipmentProtection(List<PackagingDetails> packagingDetails) {
        for (PackagingDetails packagingDetail : packagingDetails) {
            if (packagingDetail.getPackaging().getIsIndividualShipmentProtection() == null) return false;
            if (Boolean.TRUE.equals(packagingDetail.getPackaging().getIsIndividualShipmentProtection())) {
                return true;
            }
        }
        return false;
    }

    public String getServiceType(ShipmentBookRequest shipmentBookRequest) {
        try {
            ServiceLevelEntity serviceLevelEntity =
                    serviceLevelRepository.findBySendflexShipVia(shipmentBookRequest.getShipViaOptions().get(0).getCode());
            return serviceLevelEntity.getServiceType();
        } catch (Exception e) {
            log.atError().setMessage("Service type not found").setCause(e).log();
            throw new ResourceNotFoundException("Service type not found");
        }

    }

    public RequestedPackageLineItem getRequestedPackageLineItem(ShipmentBookRequest shipmentBookRequest,
                                                                PackagingDetails packagingDetails) {
        RequestedPackageLineItem requestedPackageLineItem = RequestedPackageLineItem.builder()
                .dimensions(getDimensions(packagingDetails))
                .weight(getWeight(packagingDetails))
                .packageSpecialServices(getPackageSpecialServices(shipmentBookRequest, packagingDetails))
                .build();

        if (packagingDetails.getPackaging().getIsIndividualShipmentProtection() == null) {
            packagingDetails.getPackaging().setIsIndividualShipmentProtection(false);
        }
        if (Boolean.TRUE.equals(packagingDetails.getPackaging().getIsIndividualShipmentProtection())) {
            requestedPackageLineItem.setDeclaredValue(DeclaredValue.builder().amount(packagingDetails.getPackaging().getCoverageAmount() != null ? packagingDetails.getPackaging().getCoverageAmount() : 0.0).build());
        }
        if (Boolean.FALSE.equals(packagingDetails.getPackaging().getIsIndividualShipmentProtection()) && packagingDetails.getAccessorials().isDeclaredValue()) {
            requestedPackageLineItem.setDeclaredValue(getDeclaredValue(packagingDetails));
        }


        return requestedPackageLineItem;

    }

    public PackageSpecialServices getPackageSpecialServices(ShipmentBookRequest shipmentBookRequest, PackagingDetails packagingDetails) {
        List<String> specialServiceTypes = new ArrayList<>();
        String signatureOptionType = "SERVICE_DEFAULT";

        AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();
        if (packagingDetails.getAccessorials() != null && additionalAccessorial != null) {
            //SIGNATURE
            if (additionalAccessorial.isSignatureRequired()) {
                specialServiceTypes.add("SIGNATURE_OPTION");
                signatureOptionType = getSignatureOptionType(additionalAccessorial);
            }
            //INTERVENTION
            if (hasText(additionalAccessorial.getInterventionService())) {
                String interventionService = additionalAccessorial.getInterventionService().trim();
                if (interventionService.equalsIgnoreCase(ServiceCommonConstants.FEDEX_SURROUND_PREMIUM)) {
                    specialServiceTypes.add(ServiceCommonConstants.FEDEX_SURROUND_PREMIUM_SERVICE_TYPE);
                } else if (interventionService.equalsIgnoreCase(ServiceCommonConstants.FEDEX_SURROUND_PREFERRED)) {
                    specialServiceTypes.add(ServiceCommonConstants.FEDEX_SURROUND_PREFERRED_SERVICE_TYPE);
                }
            }
        }

        return PackageSpecialServices.builder()
                .specialServiceTypes(specialServiceTypes)
                .signatureOptionType(signatureOptionType)
                .build();
    }

    public String getSignatureOptionType(AdditionalAccessorial additionalAccessorial) {
        if (additionalAccessorial.isSignatureRequired() && ServiceCommonConstants.INDIRECT_SIGNATURE_REQUIRED.equalsIgnoreCase(additionalAccessorial.getSignatureLevel())) {
            return "INDIRECT";
        } else if (additionalAccessorial.isSignatureRequired() && ServiceCommonConstants.DIRECT_SIGNATURE_REQUIRED.equalsIgnoreCase(additionalAccessorial.getSignatureLevel())) {
            return "DIRECT";
        } else if (additionalAccessorial.isSignatureRequired() && ServiceCommonConstants.ADULT_SIGNATURE_REQUIRED.equalsIgnoreCase(additionalAccessorial.getSignatureLevel())) {
            return "ADULT";
        } else {
            return "SERVICE_DEFAULT";
        }
    }

    public Weight getWeight(PackagingDetails packagingDetails) {
        return Weight.builder()
                .units("LB")
                .value(packagingDetails.getPackaging().getWeight())
                .build();
    }

    public Dimensions getDimensions(PackagingDetails packagingDetails) {
        return Dimensions.builder()
                .units(packagingDetails.getPackaging().getDimensionUOM().toUpperCase())
                .width(packagingDetails.getPackaging().getWidth())
                .height(packagingDetails.getPackaging().getHeight())
                .length(packagingDetails.getPackaging().getLength())
                .build();
    }

    public DeclaredValue getDeclaredValue(PackagingDetails packagingDetails) {

        return packagingDetails.getAccessorials().getValueOfContent() != null
                ? DeclaredValue.builder()
                .amount(packagingDetails.getAccessorials().getValueOfContent())
                .build() : null;
    }

}


