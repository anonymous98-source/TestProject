class PerfTestDeterminerTest {

  @Test
  void returnsTrueWhenHeaderIsPerfTestAndValueIsTrue() {
    ServletRequestAttributes mockAttributes = mock(ServletRequestAttributes.class);
    var mockHttpServletRequest = mock(HttpServletRequest.class);
    when(mockAttributes.getRequest()).thenReturn(mockHttpServletRequest);
    when(mockHttpServletRequest.getHeader("is-perf-test")).thenReturn("true");
    RequestContextHolder.setRequestAttributes(mockAttributes);

    PerfTestDeterminer determiner = new PerfTestDeterminer();
    boolean result = determiner.usePerfTestUrl();

    assertThat(result).isTrue();
  }

  @Test
  void returnsFalseWhenHeaderIsPerfTestAndValueIsNotTrue() {
    ServletRequestAttributes mockAttributes = mock(ServletRequestAttributes.class);
    var mockHttpServletRequest = mock(HttpServletRequest.class);
    when(mockAttributes.getRequest()).thenReturn(mockHttpServletRequest);
    when(mockHttpServletRequest.getHeader("is-perf-test")).thenReturn("false");
    RequestContextHolder.setRequestAttributes(mockAttributes);

    PerfTestDeterminer determiner = new PerfTestDeterminer();
    boolean result = determiner.usePerfTestUrl();

    assertThat(result).isFalse();
  }

  @Test
  void returnsFalseWhenHeaderIsPerfTestAndValueIsNull() {
    ServletRequestAttributes mockAttributes = mock(ServletRequestAttributes.class);
    var mockHttpServletRequest = mock(HttpServletRequest.class);
    when(mockAttributes.getRequest()).thenReturn(mockHttpServletRequest);
    when(mockHttpServletRequest.getHeader("is-perf-test")).thenReturn(null);
    RequestContextHolder.setRequestAttributes(mockAttributes);

    PerfTestDeterminer determiner = new PerfTestDeterminer();
    boolean result = determiner.usePerfTestUrl();

    assertThat(result).isFalse();
  }

  @Test
  void returnsFalseWhenRequestAttributesAreNotServletRequestAttributes() {
    RequestContextHolder.setRequestAttributes(null);

    PerfTestDeterminer determiner = new PerfTestDeterminer();
    boolean result = determiner.usePerfTestUrl();

    assertThat(result).isFalse();
  }
}

