import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;
import org.springframework.security.task.DelegatingSecurityContextAsyncTaskExecutor;

import java.util.concurrent.Executor;
import java.util.concurrent.ThreadPoolExecutor;

/**
 * Configuration class for setting up asynchronous task executors.
 * Do add new executors only if it is absolutely necessary. Reuse common thread pool wherever possible.
 */
@EnableAsync
@Configuration
public class AsyncConfig {

    private final AdvShippingIntegrationApiProperties properties;

    public AsyncConfig(AdvShippingIntegrationApiProperties properties) {
        this.properties = properties;
    }

    /**
     * Creates and configures the default asynchronous task executor.
     *
     * @return the configured Executor instance
     */
    @Bean(name = AsyncConstants.BEAN_QUALIFIER)
    public Executor taskExecutor() {
        var asyncConfig = properties.getAsyncConfig().getDefaultConfig();
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(asyncConfig.getCorePoolSize());
        executor.setMaxPoolSize(asyncConfig.getMaxPoolSize());
        executor.setQueueCapacity(asyncConfig.getQueueCapacity());
        executor.setRejectedExecutionHandler(new ThreadPoolExecutor.CallerRunsPolicy());
        executor.setThreadNamePrefix(AsyncConstants.THREAD_NAME_PREFIX);
        executor.initialize();
        return new DelegatingSecurityContextAsyncTaskExecutor(executor);
    }

    @Bean(name = AsyncConstants.CHILD_BEAN_QUALIFIER)
    public Executor childExecutor() {
        var asyncConfig = properties.getAsyncConfig().getDefaultConfig();
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(asyncConfig.getCorePoolSize());
        executor.setMaxPoolSize(asyncConfig.getMaxPoolSize());
        executor.setQueueCapacity(asyncConfig.getQueueCapacity());
        executor.setRejectedExecutionHandler(new ThreadPoolExecutor.CallerRunsPolicy());
        executor.setThreadNamePrefix(AsyncConstants.CHILD_THREAD_NAME_PREFIX);
        executor.initialize();
        return new DelegatingSecurityContextAsyncTaskExecutor(executor);
    }
