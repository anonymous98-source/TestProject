package com.cardinalhealth.adv.shipping.integration.api.database.repository;

import com.cardinalhealth.adv.shipping.integration.api.database.entity.Documents;
import jakarta.persistence.EntityManager;
import jakarta.persistence.Query;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Repository
@RequiredArgsConstructor
@Transactional(readOnly = true)
public class DocumentsCustomRepository {
    private final EntityManager entityManager;

    @SuppressWarnings("unchecked")
    public List<Documents> findDocumentsByTypeAndVersion(Map<String, String> typeAndVersion) {
        var queryBuilder = new StringBuilder();
        queryBuilder.append("SELECT d.* FROM adv_shipping_integration_api.documents d WHERE ");

        List<String> conditions = new ArrayList<>();
        Map<String, Object> params = new HashMap<>();

        var index = 0;
        for (Map.Entry<String, String> entry : typeAndVersion.entrySet()) {
            String typeKey = "type" + index;
            String versionKey = "version" + index;

            if (entry.getValue() != null) {
                conditions.add("(d.type = :" + typeKey + " AND d.version = :" + versionKey + ")");
                params.put(typeKey, entry.getKey());
                params.put(versionKey, entry.getValue());
            } else {
                conditions.add("d.id IN (SELECT d2.id FROM adv_shipping_integration_api.documents d2 WHERE d2.type = :" + typeKey +
                        " ORDER BY string_to_array(d2.version, '.')\\:\\:int[] DESC LIMIT 1)");
                params.put(typeKey, entry.getKey());
            }
            index++;
        }

        queryBuilder.append(String.join(" OR ", conditions));

        Query query = entityManager.createNativeQuery(queryBuilder.toString(), Documents.class);
        params.forEach(query::setParameter);

        return query.getResultList();
    }
}

