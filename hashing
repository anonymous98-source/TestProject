package com.cardinalhealth.adv.shipping.integration.api.service.impl;

import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.doThrow;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import com.google.cloud.WriteChannel;
import com.google.cloud.storage.BlobInfo;
import com.google.cloud.storage.Storage;
import java.io.IOException;
import java.nio.ByteBuffer;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.atomic.AtomicReference;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

@ExtendWith(MockitoExtension.class)
class GCSFileWriterTest {

  @Mock private Storage storage;
  @Mock private WriteChannel writeChannel;

  @Test
  @DisplayName("writeFileToBucket should write payload bytes to the configured blob path")
  void writeFileToBucketShouldWritePayloadBytesToConfiguredBlobPath() throws IOException {
	when(storage.writer(any(BlobInfo.class))).thenReturn(writeChannel);
	byte[] payload = "payload".getBytes(StandardCharsets.UTF_8);
	AtomicReference<byte[]> writtenBytes = new AtomicReference<>();
	when(writeChannel.write(any(ByteBuffer.class)))
		.thenAnswer(
			invocation -> {
			  ByteBuffer buffer = invocation.getArgument(0);
			  int remaining = buffer.remaining();
			  ByteBuffer copy = buffer.asReadOnlyBuffer();
			  byte[] bytes = new byte[copy.remaining()];
			  copy.get(bytes);
			  writtenBytes.set(bytes);
			  buffer.position(buffer.limit());
			  return remaining;
			});
	var subject = new GCSFileWriter(storage);

	subject.writeFileToBucket("my-bucket", "folder/file.json", payload);

	ArgumentCaptor<BlobInfo> blobInfoCaptor = ArgumentCaptor.forClass(BlobInfo.class);
	verify(storage).writer(blobInfoCaptor.capture());
	BlobInfo writtenBlob = blobInfoCaptor.getValue();
	org.junit.jupiter.api.Assertions.assertEquals("my-bucket", writtenBlob.getBucket());
	org.junit.jupiter.api.Assertions.assertEquals("folder/file.json", writtenBlob.getName());

	verify(writeChannel).write(any(ByteBuffer.class));
	assertArrayEquals(payload, writtenBytes.get());
  }

  @Test
  @DisplayName("writeFileToBucket should continue writing until the entire payload is written")
  void writeFileToBucketShouldContinueWritingUntilEntirePayloadIsWritten() throws IOException {
	when(storage.writer(any(BlobInfo.class))).thenReturn(writeChannel);
	when(writeChannel.write(any(ByteBuffer.class)))
		.thenAnswer(
			invocation -> {
			  ByteBuffer buffer = invocation.getArgument(0);
			  int bytesToWrite = Math.min(3, buffer.remaining());
			  buffer.position(buffer.position() + bytesToWrite);
			  return bytesToWrite;
			});
	var subject = new GCSFileWriter(storage);

	subject.writeFileToBucket(
		"my-bucket", "folder/file.json", "payload".getBytes(StandardCharsets.UTF_8));

	verify(writeChannel, org.mockito.Mockito.atLeast(3)).write(any(ByteBuffer.class));
  }

  @Test
  @DisplayName("writeFileToBucket should propagate error when storage writer cannot be created")
  void writeFileToBucketShouldPropagateErrorWhenStorageWriterCannotBeCreated() {
	when(storage.writer(any(BlobInfo.class))).thenThrow(new RuntimeException("writer unavailable"));
	var subject = new GCSFileWriter(storage);

	assertThrows(
		RuntimeException.class,
		() -> subject.writeFileToBucket("my-bucket", "folder/file.json", "payload".getBytes()));
  }

  @Test
  @DisplayName("writeFileToBucket should propagate write errors from channel")
  void writeFileToBucketShouldPropagateWriteErrorsFromChannel() throws IOException {
	when(storage.writer(any(BlobInfo.class))).thenReturn(writeChannel);
	doThrow(new IOException("write failed")).when(writeChannel).write(any(ByteBuffer.class));
	var subject = new GCSFileWriter(storage);

	assertThrows(
		IOException.class,
		() ->
			subject.writeFileToBucket(
				"my-bucket", "folder/file.json", "payload".getBytes(StandardCharsets.UTF_8)));
  }

  @Test
  @DisplayName("writeFileToBucket should throw when channel reports a zero-byte write before completion")
  void writeFileToBucketShouldThrowWhenChannelReportsZeroByteWriteBeforeCompletion()
	  throws IOException {
	when(storage.writer(any(BlobInfo.class))).thenReturn(writeChannel);
	when(writeChannel.write(any(ByteBuffer.class))).thenReturn(0);
	var subject = new GCSFileWriter(storage);

	assertThrows(
		IOException.class,
		() ->
			subject.writeFileToBucket(
				"my-bucket", "folder/file.json", "payload".getBytes(StandardCharsets.UTF_8)));
	verify(writeChannel).write(any(ByteBuffer.class));
  }

  @Test
  @DisplayName("writeFileToBucket should throw when data is null")
  void writeFileToBucketShouldThrowWhenDataIsNull() {
	var subject = new GCSFileWriter(storage);

	assertThrows(
		NullPointerException.class,
		() -> subject.writeFileToBucket("my-bucket", "folder/file.json", null));
  }
}

