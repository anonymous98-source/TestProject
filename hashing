    public SuccessResponse updateAddressIfExists(AddressBookRequest request) {
        log.atInfo().setMessage("Inside service method to update an existing address in the address book")
                .log();

        // Check for valid UUID -> If not a valid UUID then method throws exception to be handled globally
        final UUID addressId = validateAndConvertUUID(request.getAddressId(),
                AddressBookConstants.OPERATION_TYPE_UPDATE, AddressBookConstants.ADDRESS_ID);

        // Check if provided Address ID is present in address facility mapping table
        ShipToAddressFacilityMapping existingShipToAddressFacilityMapping =
                shipToAddressFacilityMappingRepository.findById(addressId)
                        .orElseThrow(() -> new ResourceNotFoundException(
                                "Address not found in address facility mapping table for address ID: " + addressId));

        if (existingShipToAddressFacilityMapping.getShipToAddress() == null) {
            throw new ResourceNotFoundException("Ship to Address not found in ship_to_address_facility_mapping" +
                    " table for address ID: " + addressId);
        }

        // Updating the existing address entity for saving into DB
        existingShipToAddressFacilityMapping = AddressMappingUtils.mapRequestToShipToAddressFacilityMappingEntity(
                request, existingShipToAddressFacilityMapping);

        log.atInfo()
                .setMessage("Updated ship to address facility mapping entity")
                .log();

        shipToAddressFacilityMappingRepository.saveAndFlush(existingShipToAddressFacilityMapping);

        log.atInfo()
                .setMessage("Address successfully updated in the address book")
