@Component
@RequiredArgsConstructor
public class OperatorPriorityResolver {

    private final OperatorRegistry operatorRegistry;
    public RuleDefinition resolve(List<RuleDefinition> rules) {
        return rules.stream().min(Comparator.comparingInt(
                rule -> operatorRegistry.getPriority(rule.getOperator())
        )).orElseThrow(() -> new IllegalArgumentException("Rule List cannot be empty"));
    }

    public List<RuleDefinition> sortByPriority(List<RuleDefinition> ruleDefinitions) {
        return ruleDefinitions.stream()
                .sorted(Comparator.comparingInt(rule -> operatorRegistry.getPriority(rule.getOperator())))
                .toList();
    }
}

