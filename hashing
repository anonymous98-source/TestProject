public class ZipCodeValidationServiceImpl implements ZipCodeValidationService {


    private final CustomerHierarchyServiceImpl customerHierarchyService;
    private final OCMWebClientService ocmWebClientService;
    private final CustomerService customerService;



    @Override
    public ZipCodeValidationResponse validateZipCode(
            ZipCodeValidationRequest request, String authToken) {
       validateFacilityId(request.getFacilityId());

        /// Fetching Customer ID.
        String customerId = getCustomerId(request.getFacilityId());

        /// Preparing the Request DTO
        ZipCodeValidationRequestDto requestDto = prepareZipCodeValidationRequest(request, customerId);

        /// Call OCM
        log.atInfo().setMessage("Calling OCM to validate zipcode.").log();
        ZipCodeValidationResponseDto responseDto =
                ocmWebClientService.validateZipCodeFromOCM(requestDto);

        /// Prepare and return the Response
        return prepareZipCodeValidationResponse(responseDto);
    }

    // Method to fetch Customer ID.
    public String getCustomerId(String facilityId) {
        return customerHierarchyService.getCustomerIdByFacilityId(facilityId);
    }

    // Method to prepare request DTO.
     public ZipCodeValidationRequestDto prepareZipCodeValidationRequest(
            ZipCodeValidationRequest request, String customerId) {
        return ZipCodeValidationRequestDto.builder()
                .customerId(customerId)
                .facilityId(request.getFacilityId())
                .shipToZipcode(request.getZipCode())
                .build();
    }

    // Method to prepare response.
     public ZipCodeValidationResponse prepareZipCodeValidationResponse(
            ZipCodeValidationResponseDto responseDto) {
        return ZipCodeValidationResponse.builder()
                .status(
                        Boolean.TRUE.equals(responseDto.getStatus())
                                ? ServiceCommonConstants.VOID_SUCCESS
                                : ServiceCommonConstants.VOID_FAIL)
                .facility(responseDto.getFacility())
                .carriers(responseDto.getCarriers())
                .build();
    }
    public void validateFacilityId(String facilityId) {
        if (StringUtils.isBlank(facilityId)) {
            throw new ValidationException("Facility ID cannot be null or empty.");
        }
        if (!isValidUUID(facilityId)) {
            throw new ValidationException("Invalid facilityId format: " + facilityId);
        }
    }
    public boolean isValidUUID(String uuid) {
        try {
            UUID.fromString(uuid);
            return true;
        } catch (IllegalArgumentException e) {
            return false;
        }
    }
}

