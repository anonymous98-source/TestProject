package com.cardinalhealth.adv.shipping.integration.api.usercreation;

import com.cardinalhealth.adv.shipping.integration.api.config.AdvShippingIntegrationApiProperties;
import java.net.URI;
import java.util.List;
import java.util.Map;
import lombok.SneakyThrows;
import org.apache.http.HttpHeaders;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.DefaultUriBuilderFactory;

@Service
public class AuthenticationService {
  public static final String SSWS = "SSWS ";
  public static final String BEARER = "Bearer ";
  public static final String USERS = "users";
  public static final String V_1 = "v1";
  public static final String API = "api";
  private final WebClient webClientNoAuth;
  private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;

  public AuthenticationService(
      @Qualifier("webClientNoAuth") WebClient webClientNoAuth,
      AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties) {
    this.webClientNoAuth = webClientNoAuth;
    this.advShippingIntegrationApiProperties = advShippingIntegrationApiProperties;
  }

  @SneakyThrows
  public OktaUser makeOktaUser(
      String firstName,
      String lastName,
      String email,
      String password,
      String title,
      String recoveryQuestion,
      String recoveryAnswer) {
    var oktaUser = new OktaUser();
    oktaUser.setProfile(
        Map.of(
            "firstName",
            firstName,
            "lastName",
            lastName,
            "email",
            email,
            "login",
            email,
            "title",
            title));
    oktaUser.setCredentials(
        Map.of(
            "password",
            Map.of("value", password),
            "recovery_question",
            Map.of("question", recoveryQuestion, "answer", recoveryAnswer)));
    oktaUser.setGroupIds(List.of(advShippingIntegrationApiProperties.getOktaGroupId()));

    deleteOktaUser(oktaUser.getProfile().get("login"));

    return webClientNoAuth
        .post()
        .uri(getOktaCreateUserUri())
        .accept(MediaType.APPLICATION_JSON)
        .contentType(MediaType.APPLICATION_JSON)
        .header(
            HttpHeaders.AUTHORIZATION, SSWS + advShippingIntegrationApiProperties.getOktaApiKey())
        .bodyValue(oktaUser)
        .retrieve()
        .bodyToMono(OktaUser.class)
        .block();
  }

  @SneakyThrows
  private void deleteOktaUser(String username) {
    List<OktaUser> oktaUsers =
        webClientNoAuth
            .get()
            .uri(oktaFindUserUri(username))
            .accept(MediaType.APPLICATION_JSON)
            .header(
                HttpHeaders.AUTHORIZATION,
                SSWS + advShippingIntegrationApiProperties.getOktaApiKey())
            .retrieve()
            .bodyToMono(new ParameterizedTypeReference<List<OktaUser>>() {})
            .block();

    if (oktaUsers != null && oktaUsers.size() == 1) {
      webClientNoAuth
          .delete()
          .uri(oktaDeleteUserUri(oktaUsers.get(0).getId()))
          .header(
              HttpHeaders.AUTHORIZATION, SSWS + advShippingIntegrationApiProperties.getOktaApiKey())
          .retrieve()
          .toBodilessEntity()
          .block();
      webClientNoAuth
          .delete()
          .uri(oktaDeleteUserUri(oktaUsers.get(0).getId()))
          .header(
              HttpHeaders.AUTHORIZATION, SSWS + advShippingIntegrationApiProperties.getOktaApiKey())
          .retrieve()
          .toBodilessEntity()
          .block();
    }
  }

  private URI oktaFindUserUri(String username) {
    var factory = new DefaultUriBuilderFactory();
    return factory
        .uriString(advShippingIntegrationApiProperties.getOktaUrl())
        .pathSegment(API, V_1, USERS)
        .queryParam("q", username)
        .queryParam("limit", 1)
        .build();
  }

  private URI getOktaCreateUserUri() {
    var uriBuilder =
        new DefaultUriBuilderFactory()
            .uriString(advShippingIntegrationApiProperties.getOktaUrl())
            .path("/api/v1/users")
            .queryParam("activate", "true");

    return uriBuilder.build();
  }

  private URI oktaDeleteUserUri(String oktaUserId) {
    var uriBuilder =
        new DefaultUriBuilderFactory()
            .uriString(advShippingIntegrationApiProperties.getOktaUrl())
            .path("/api/v1/users/{oktaUserId}");

    return uriBuilder.build(Map.of("oktaUserId", oktaUserId));
  }
}

