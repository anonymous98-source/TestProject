package com.cardinalhealth.adv.shipping.integration.api.exception;

import com.cardinalhealth.adv.shipping.integration.api.service.dto.addressbook.AddressBookCsvResponse;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.Ordered;
import org.springframework.core.annotation.Order;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.AccessDeniedException;
import org.springframework.validation.FieldError;
import org.springframework.web.HttpRequestMethodNotSupportedException;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.MissingServletRequestParameterException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.context.request.WebRequest;
import org.springframework.web.multipart.MaxUploadSizeExceededException;
import org.springframework.web.server.ResponseStatusException;
import org.springframework.web.servlet.NoHandlerFoundException;
import org.springframework.web.servlet.resource.NoResourceFoundException;
import org.springframework.http.converter.HttpMessageNotReadableException;

import java.util.HashMap;
import java.util.Map;

import static com.cardinalhealth.adv.shipping.integration.api.service.impl.addressbook.AddressBookExportAndStoreImpl.FAILED;

@RestControllerAdvice
@Slf4j
@Order(Ordered.HIGHEST_PRECEDENCE)
public class GlobalExceptionHandler {

  @ExceptionHandler({ResourceNotFoundException.class })
  public ResponseEntity<ErrorResponse> handleResourceNotFoundException(
      ResourceNotFoundException ex, WebRequest request) {
      return new ResponseEntity<>(buildErrorResponse(request,ex.getMessage(),ErrorConstant.NOT_FOUND,HttpStatus.NOT_FOUND.value()), HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler({ MissingServletRequestParameterException.class})
  public ResponseEntity<ErrorResponse> handleMissingServletRequestParameterNotFoundException(
          MissingServletRequestParameterException ex, WebRequest request) {
    return new ResponseEntity<>(buildErrorResponse(request, ex.getMessage(),ErrorConstant.NOT_FOUND,HttpStatus.NOT_FOUND.value() ), HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler(ValidationException.class)
  public ResponseEntity<ErrorResponse> handleValidationException(
      ValidationException ex, WebRequest request) {
    return new ResponseEntity<>(buildErrorResponse(request,ex.getMessage(),ErrorConstant.VALIDATION_ERROR,HttpStatus.BAD_REQUEST.value()), HttpStatus.BAD_REQUEST);
  }

  @ExceptionHandler({NoHandlerFoundException.class, NoResourceFoundException.class})
  public ResponseEntity<ErrorResponse> endPointNotFoundException(Exception ex, WebRequest request) {
    log.error("EndPoint not found: ", ex);
    return new ResponseEntity<>(buildErrorResponse(request,"EndPoint Not Found : " + ex.getMessage(),ErrorConstant.NOT_FOUND,HttpStatus.NOT_FOUND.value()), HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler({HttpRequestMethodNotSupportedException.class})
  public ResponseEntity<ErrorResponse> methodNotSupportedException(
      Exception ex, WebRequest request) {

    log.error("Invalid method: ", ex);

    return new ResponseEntity<>(buildErrorResponse(request,"Method Not Allowed : " + ex.getMessage(),ErrorConstant.METHOD_NOT_ALLOWED,HttpStatus.METHOD_NOT_ALLOWED.value()), HttpStatus.METHOD_NOT_ALLOWED);
  }

  @ExceptionHandler(UnAuthorizedException.class)
  public ResponseEntity<ErrorResponse> handleUnAuthorizedException(
      Exception ex, WebRequest request) {

    log.error("UnAuthorized request : ", ex);
    return new ResponseEntity<>(buildErrorResponse(request,"Unauthorized request",ErrorConstant.UNAUTHORIZED_REQUEST,HttpStatus.UNAUTHORIZED.value()), HttpStatus.UNAUTHORIZED);
  }

  @ExceptionHandler(AccessDeniedException.class)
  public ResponseEntity<ErrorResponse> handleAccessDeniedException(Exception ex, WebRequest request) {
    log.error("Access Denied request : ", ex);
    return new ResponseEntity<>(buildErrorResponse(request, ex.getMessage(), ErrorConstant.FORBIDDEN_ERROR, HttpStatus.FORBIDDEN.value()), HttpStatus.FORBIDDEN);
  }

  @ExceptionHandler(MethodArgumentNotValidException.class)
  public ResponseEntity<FieldValidationErrorResponse> handleFieldValidationError(
      MethodArgumentNotValidException ex, WebRequest request) {

    Map<String, String> fieldErrors = new HashMap<>();
    ex.getBindingResult()
        .getAllErrors()
        .forEach(
            error -> {
              String fieldName = ((FieldError) error).getField();
              String errorMessage = error.getDefaultMessage();
              fieldErrors.put(fieldName, errorMessage);
            });

      FieldValidationErrorResponse fieldValidationErrorResponse =
          new FieldValidationErrorResponse(
              "field validation error",
              fieldErrors,
              getPathFromWebRequest(request),
              HttpStatus.BAD_REQUEST.value());
    return new ResponseEntity<>(fieldValidationErrorResponse, HttpStatus.BAD_REQUEST);
  }


  private String getPathFromWebRequest(WebRequest request) {
    return (request != null)
        ? request.getDescription(false).replace("uri=", "")
        : "Path not available";
  }

  /**
   * Build ErrorResponse
   * @param request request send by user
   * @param message error message
   * @param httpStatusType  status type
   * @param httpStatusCode  status code
   * @return ErrorResponse
   */
  private ErrorResponse buildErrorResponse(WebRequest request,String message,String httpStatusType,int httpStatusCode) {
    return new ErrorResponse(
                    httpStatusType,
                    message,
                    getPathFromWebRequest(request),
                    httpStatusCode);

  }
  @ExceptionHandler(ResponseStatusException.class)
  public ResponseEntity<ErrorResponse> handleResponseStatusException(
          ResponseStatusException ex, WebRequest request) {

    log.error("ResponseStatusException occurred: ", ex);

    ErrorResponse errorResponse = buildErrorResponse(
            request,
            ex.getReason() != null ? ex.getReason() : "Unexpected error",
            "Bad Request",
            ex.getStatusCode().value()
    );
    return new ResponseEntity<>(errorResponse, ex.getStatusCode());
  }

  @ExceptionHandler(MaxUploadSizeExceededException.class)
  public ResponseEntity<AddressBookCsvResponse> handleMaxSizeException(MaxUploadSizeExceededException e) {
    AddressBookCsvResponse response=AddressBookCsvResponse.builder().status(FAILED).message("File size should not exceed 12 MB").build();
    return ResponseEntity.ok(response);
  }

  @ExceptionHandler(HttpMessageNotReadableException.class)
  public ResponseEntity<ErrorResponse> handleHttpMessageNotReadable(HttpMessageNotReadableException ex, WebRequest request) {
      String message = ex.getMostSpecificCause().getMessage() != null
              ? "Invalid value for request field: " + ex.getMostSpecificCause().getMessage()
              : "invalid field value or malformed JSON.";
      log.error("HttpMessageNotReadableException: ", ex);
      return new ResponseEntity<>(buildErrorResponse(request, message, ErrorConstant.VALIDATION_ERROR, HttpStatus.BAD_REQUEST.value()), HttpStatus.BAD_REQUEST);
  }
}

