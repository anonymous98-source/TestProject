    private final ShipToAddressFavouriteRepository shipToAddressFavouriteRepository;
    private final UserDetailsService userDetailsService;
    private final AddressBookRetrievalService addressBookRetrievalService;


    /**
     * Find the logged-in user id and find all those addresses that are marked as favourite
     * by the logged-in user for the given facility ID
     * and map those address details in ShipToAddressResponseDto and return the List
     *
     * @param facilityId       Facility ID for which location we need to find favourite address
     * @param oflUserPrincipal User details for which we need to find favourite addresses
     * @param pageNumber       Page Number
     * @param pageSize         Number of Addresses in each page
     * @return List of ShipToAddressResponseDto which is marked as favourite for the facilityId for the User
     */
    @Override
    public AllContactsResponseDTO fetchAllFavouriteAddressDetails(
            final String facilityId, final OflUserPrincipal oflUserPrincipal,
            long pageNumber, long pageSize) {

        // Number of address to be returned validation (either positive value or null is applicable)
        // If Address count provided then it should be more than 0 else throw Validation Exception
        if (pageSize <= 0L || pageNumber < 0) {
            log.atInfo()
                    .setMessage("Either page number: {} or page size: {} must be Valid")
                    .addArgument(pageNumber)
                    .addArgument(pageSize)
                    .addKeyValue("pageNumber", pageNumber)
                    .addKeyValue("pageSize", pageSize)
                    .log();
            throw new ValidationException("Either provided page number or page size is inValid");
        }

        // Get UserId from UserPrincipal
        final UUID userId = userDetailsService.getUserIdFromUserPrincipal(oflUserPrincipal);
        final UUID monarchId = userDetailsService.buildUserDtoFromOflUserPrincipal(oflUserPrincipal).getMonarchUserId();

        // Fetch pageable ShipToAddress Favourite list
        Page<ShipToAddressFavorite> allAddressMarkedFavouritePage =
                fetchAllFavouriteAddressMappedToUserAndFacilityId(facilityId, userId, pageNumber, pageSize);
        if (allAddressMarkedFavouritePage == null) {
            log.atInfo().setMessage("Pageable object from Favourite address DB call is Null,"
                            + " throwing ResourceNotFoundException")
                    .log();
            throw new ResourceNotFoundException("Pageable object from Favourite address DB call is coming null");
        }

        long allFavouriteAddressCount = allAddressMarkedFavouritePage.getTotalElements();
        var isLast = true; // For pageable implementation identification
        long currentUpperCountAsPerPageSizeAndNumber = pageSize * (pageNumber + 1);
        if (currentUpperCountAsPerPageSizeAndNumber < allFavouriteAddressCount) {
            isLast = false;
        }

        // Map all the facility mapping to ResponseDto and limit the count and sort based on address name
        List<ShipToAddressResponseDto> allFavouriteAddressResponseDTOs = new ArrayList<>();
        allAddressMarkedFavouritePage.getContent()
                .stream()
                .map(favouriteAddress ->
                        AddressMappingUtils.mapAddressDetailsToResponseDto(favouriteAddress,
                                AddressBookConstants.MAPPING_OPERATION_TYPE_FAVOURITE_ADDRESS_VIEW, userId)
                )
                .filter(responseDTO -> responseDTO != null
                        && responseDTO.getRecipientName() != null)
                .forEach(address -> {
                    log.atInfo()
                            .setMessage("Mapped ShipToAddress ResponseDTO")
                            .log();
                    allFavouriteAddressResponseDTOs.add(address);
                });

        log.atInfo().setMessage("For Favourite address view, returning "
                        + allFavouriteAddressResponseDTOs.size() + " addresses")
                .log();

        // Fetch all address counts
        Map<String, Long> addressCountMap = addressBookRetrievalService.fetchAllAddressCount(
                userId, facilityId, monarchId);
        log.atInfo()
                .setMessage("All address counts are fetched")
                .log();

        return AllContactsResponseDTO.builder()
                .isLast(isLast)
                .addresses(allFavouriteAddressResponseDTOs)
                .allContactsCount(addressCountMap.get(AddressBookConstants.ALL_ADDRESS_COUNT))
                .favouriteAddressCount(addressCountMap.get(AddressBookConstants.FAVOURITE_ADDRESS_COUNT))
                .totalRecentAddresses(addressCountMap.get(AddressBookConstants.RECENT_ADDRESS_COUNT))
                .build();
    }

    /**
     * Calls repository method to fetch all the favourite address for particular facility and logged-in user
     * If no favourites found then throws Resource not found exception
     *
     * @param facilityId Facility ID
     * @param userId     Logged in User Id
     * @param pageNumber Page Number
     * @param pageSize   Number of elements per page
     * @return List of ShipToAddressFacilityMapping that satisfies the criteria
     */
    private Page<ShipToAddressFavorite> fetchAllFavouriteAddressMappedToUserAndFacilityId(
            final String facilityId, final UUID userId, Long pageNumber, Long pageSize) {
        // Construct pageable object
        Pageable pageable = PageRequest.of(pageNumber.intValue(), pageSize.intValue());

        // Fetch List of Favourite address for the specific Facility ID and User ID
        Page<ShipToAddressFavorite> allAddressMarkedFavouritePageable = shipToAddressFavouriteRepository
                .findAllFavouriteAddressDetailsByFacilityIdAndUserId(userId, facilityId, pageable);

        // Handle no data found scenario
        if (allAddressMarkedFavouritePageable == null
                || allAddressMarkedFavouritePageable.getTotalElements() == 0
                || allAddressMarkedFavouritePageable.getContent().isEmpty()) {
            log.atWarn()
                    .setMessage("No favourite address found for given FacilityID and userID for pageNumber: {} and pageSize: {}")
                    .addArgument(pageNumber)
                    .addArgument(pageSize)
                    .addKeyValue("pageNumber", pageNumber)
                    .addKeyValue("pageSize", pageSize)
                    .log();
        }

        return allAddressMarkedFavouritePageable;
    }
}

