@RequestMapping("/v1/api/preferred/shipfrom/address")
public class PreferredAddressController {

  private final PreferredAddressService preferredAddressService;
  private final UserAccessUtil userAccessUtil;

  @PostMapping
  public ResponseEntity<SuccessResponse> upsertShipFromPreferredAddress(
      @RequestHeader HttpHeaders headers,
      @RequestBody @Valid PreferredShipFromAddressDTO requestDTO,
      @AuthenticationPrincipal final OflUserPrincipal oflUserPrincipal) {
    log.atInfo()
        .addKeyValue("facilityId", requestDTO.getFacilityId())
        .log("Received request to upsert preferred address");
    if (CommonUtil.isInvalidUUID(requestDTO.getFacilityId())) {
      throw new ValidationException("Invalid facilityId - " + requestDTO.getFacilityId());
    }
    String userEmail = UserPrincipalUtils.getEmail(oflUserPrincipal);
    userAccessUtil.validateUserFacilityAccess(userEmail, requestDTO.getFacilityId());
    SuccessResponse response =
        preferredAddressService.upsertPreferredAddress(requestDTO, userEmail);
    return ResponseEntity.ok(response);
  }

  @DeleteMapping
  public ResponseEntity<SuccessResponse> deletePreferredAddress(
      @RequestParam String facilityId,
      @RequestHeader HttpHeaders headers,
      @AuthenticationPrincipal final OflUserPrincipal oflUserPrincipal) {

    log.atInfo()
        .addKeyValue("facilityId", facilityId)
        .log("Received request to delete preferred ship from address");

    if (CommonUtil.isInvalidUUID(facilityId)) {
      throw new ValidationException("Invalid facilityId - " + facilityId);
    }

    String userEmail = UserPrincipalUtils.getEmail(oflUserPrincipal);
    SuccessResponse response =
        preferredAddressService.deletePreferredAddress(userEmail, facilityId);
    return ResponseEntity.ok(response);
  }
}

