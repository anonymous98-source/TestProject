     */

    @Override
    public AllContactsResponseDTO getAddressByFacilityId(String facilityId, String sortingColumn,
                                                         String sortingDirection, String search, int pageNo,
                                                         int pageSize, OflUserPrincipal oflUserPrincipal) {
        // Validate sorting direction and sorting column to prevent errors
        sortingDirection = AddressBookConstants.DESC.equalsIgnoreCase(sortingDirection)
                ? AddressBookConstants.DESC : AddressBookConstants.ASC;

        sortingColumn = (sortingColumn.equalsIgnoreCase(AddressBookConstants.ADDRESS_NAME)
                || sortingColumn.equalsIgnoreCase(""))
                ? AddressBookConstants.ADDRESS_NAME : sortingColumn;

        // Finding the logged-in user ID
        final UUID userId = userDetailsService.getUserIdFromUserPrincipal(oflUserPrincipal);
        final UUID monarchId = userDetailsService.buildUserDtoFromOflUserPrincipal(oflUserPrincipal).getMonarchUserId();

        log.atInfo()
                        .setMessage("fetching the list of mapped addresses by facility Id")
                        .log();

        Pageable pageable = PageRequest.of(pageNo, pageSize);
        Page<ShipToAddressFacilityMappingWithFavorite> facilityAddressMappings = shipToAddressFacilityMappingCustomRepository
                .findByFacilityId(facilityId, userId, sortingColumn, sortingDirection, search, pageable);

        log.atInfo().
                        setMessage("fetching the count of mapped addresses by facility Id")
                        .log();

        //setting isLast to verify whether page is last or not
        boolean isLast = facilityAddressMappings.isLast();
        Long searchResultsCount = search != null && search.length() >= 3
                ? facilityAddressMappings.getTotalElements() : 0;

        List<ShipToAddressResponseDto> shipToAddressResponseDtoPage =
                facilityAddressMappings
                        .stream()
                        .map(ShipToAddressMapper::toDto)
                        .toList();

        // Fetch all address counts
        Map<String, Long> addressCountMap = addressBookRetrievalService.fetchAllAddressCount(
                userId, facilityId, monarchId);
