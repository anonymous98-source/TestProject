import com.cardinalhealth.adv.shipping.integration.api.service.base.HcidService;
import com.cardinalhealth.adv.shipping.integration.api.service.dto.hcid.HcidNodeDto;
import com.cardinalhealth.adv.shipping.integration.api.service.dto.hcid.HcidSubCodeDto;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

@RequiredArgsConstructor
@Service
public class HcidServiceImpl implements HcidService {

    private final HcidRepository hcidRepository;
    private final HcidCache hcidCache;

    @Override
    public List<HcidNodeDto> getAllHcid() {
        List<HcidNodeDto> cached = hcidCache.get();
        if (cached != null && !cached.isEmpty()) {
            return cached;
        }
        List<Hcid> hcids = hcidRepository.findAll();
        Map<String, Hcid> parentHcids = new LinkedHashMap<>();
        Map<String, List<Hcid>> childHcids = new LinkedHashMap<>();
        for (Hcid hcid : hcids) {
            if (hcid.getParentCode() == null) {
                parentHcids.put(hcid.getCode(), hcid);
            } else {
                childHcids.computeIfAbsent(hcid.getParentCode(), k -> new ArrayList<>()).add(hcid);
            }
        }
        List<HcidNodeDto> result = new ArrayList<>();
        parentHcids.forEach((code, hcid) -> {
            HcidNodeDto node = new HcidNodeDto();
            node.setId(hcid.getId());
            node.setCode(hcid.getCode());
            node.setName(hcid.getName());
            List<HcidSubCodeDto> subCodes = childHcids.getOrDefault(code, new ArrayList<>())
                    .stream()
                    .map(child -> {
                        HcidSubCodeDto subCode = new HcidSubCodeDto();
                        subCode.setId(child.getId());
                        subCode.setName(child.getName());
                        subCode.setCode(child.getCode());
                        return subCode;
                    })
                    .toList();
            node.setSubCodes(subCodes);
            result.add(node);
        });
        hcidCache.put(result);
        return result;
    }
}

