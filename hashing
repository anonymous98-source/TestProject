@Service
@AllArgsConstructor
@Slf4j
public class UserFacilitiesServiceImpl implements UserFacilitiesService {

    private final UserDetailsService userDetailsService;
    private final UserRepository userRepository;
    private final CustomAsyncConfigProvider customExecutor;
    /**
     * Get all the facilities name for User
     * @param userName user email id
     * @return list of user facility name
     */
    public List<String> getUserFacilities(String userName) {
        UserCustomerProfile prof= userDetailsService.getUserCustomerProfile(userName);
        return prof.getFacilityList().stream().map(Facility::getId).toList();
    }


    /**
     * Find Billing group based on user email and facilityId
     * @param userName user email id
     * @param facilityId facilityId for the user
     * @return BillingGroup
     */
    public Map<String,UUID> getUserBillingGroupId(String userName, String facilityId) {
        UserCustomerProfile userCustomerProfile = userDetailsService.getUserCustomerProfile(userName);
        Facility facility=Optional.ofNullable(userCustomerProfile.getFacilities().get(facilityId.trim()))
                .orElseThrow(() -> new ResourceNotFoundException("Could not find facility for the facility id"));
        return Map.of(BILLING_GROUP_ID, UUID.fromString(facility.getBillingGroupId()));
    }

    /**
     * Fetches all locations associated with the given user email.
     *
     * @param userName the email of the user
     * @return a list of FacilitiesResponse
     */
    @Override
    public List<FacilitiesResponse> fetchAllLocation(String userName, String userId) {
        log.atInfo()
                        .setMessage("Fetching all locations for user: " + userName)
                        .log();

        CompletableFuture<UserCustomerProfile> userProfileFuture =
                CompletableFuture.supplyAsync(() -> userDetailsService.getUserCustomerProfile(userName), customExecutor.getExecutor());

        CompletableFuture<User> userFuture = CompletableFuture.supplyAsync(() -> {
            if (!userId.equals(EMPTY_UUID_STRING)) {
                return userRepository.findUserById(UUID.fromString(userId));
            }
            return null;
        }, customExecutor.getExecutor());

        // Wait for both
        CompletableFuture.allOf(userProfileFuture, userFuture).join();
        UserCustomerProfile userCustomerProfile = userProfileFuture.join();
        User user = userFuture.join();

        boolean matched = false;
        if (user != null) {
            String facilityId = Optional.ofNullable(user.getDefaultFacilityId())
                    .map(Object::toString)
                    .orElse("");
           matched = userCustomerProfile.getFacilityList().stream()
                        .filter(facility -> facility.getId().equals(facilityId))
                        .findFirst()
                        .map(facility -> { facility.setDefaultFacility(true); return true; })
                        .orElse(false);
        }

        if (!matched) {
            userCustomerProfile.getFacilityList().stream()
                    .findFirst()
                    .ifPresent(facility -> facility.setDefaultFacility(true));
        }

        return mapFacilitiesToResponse(userCustomerProfile);
    }

    /**
     * Maps the list of facilities to a list of FacilitiesResponse.
     *
     * @param userCustomerProfile customer profile
     * @return a list of FacilitiesResponse
     */
    public List<FacilitiesResponse> mapFacilitiesToResponse(UserCustomerProfile userCustomerProfile) {
        log.atInfo()
                        .setMessage("Mapping facilities to response objects")
                        .log();
        List<Facility> facilities = userCustomerProfile.getFacilityList();
        if (facilities.isEmpty()) {
            log.warn("Facility list is empty");
            return List.of();
        }
        String customerName = userCustomerProfile.getCustomers().get(facilities.get(0).getCustomerId()).getName();
        String emailAddress = userCustomerProfile.getBillingGroups().get(facilities.get(0).getBillingGroupId()).getEmail();
        return facilities.stream().
                map(facility -> FacilitiesResponse.builder().facilityId(facility.getId())
                        .name(facility.getFacilityName())
                        .company(customerName)
                        .addressLines(List.of(facility.getAddress1(), facility.getAddress2(), facility.getAddress3()))
                        .zipCode(facility.getZip())
                        .city(facility.getCity())
                        .state(facility.getState())
                        .country(facility.getCountry())
                        .emailAddress(emailAddress)
                        .phoneNumber(facility.getPhone())
                        .phoneExt(null)
                        .defaultShipFromAddress(facility.isDefaultFacility()).build())
                .toList();
    }

    @Override
    public String getUserDefaultLocation(String email) {
        Optional<User> userOptional = userRepository.findByUserEmail(email);
        return userOptional.map(user -> Optional.ofNullable(user.getDefaultFacilityId())
                .map(Object::toString)
                .orElse("")).orElse("");
    }
}

