                        .active(true)
                        .source(NAVIGATOR)
                        .build();
                codesToSaveOrUpdate.add(newCode);
            }
        }
        ruleDefinitionRepository.saveAll(codesToSaveOrUpdate);
        return ZipCodeRuleResponseDto.builder()
                .status(SUCCESS)
                .message(ZIP_CODE_SAVE_UPDATE_MESSAGE)
                .build();
    }

    @Override
    public ShippingRuleResult<ZipCodeConfigResponse> fetchShippingRules(String facilityId, String customerId, String search, Pageable pageable) {

//        // creating threads to perform parallel operation
        final ExecutorService baseExecutor = Executors.newFixedThreadPool(2);
        ExecutorService executor = new DelegatingSecurityContextExecutorService(baseExecutor);

        CompletableFuture<UserConfigResponseDTO> userConfigFuture =
                CompletableFuture.supplyAsync(() -> ocmWebClientService.getUserConfigDataFromOCM(facilityId, customerId), executor);

        CompletableFuture<List<ZipCodeDetails>> zipCodeDetailsFuture =
                CompletableFuture.supplyAsync(() -> ocmWebClientService.getZipCodeConfigDataFromOCM(customerId, facilityId), executor);

        CompletableFuture<Void> allFutures = CompletableFuture.allOf(userConfigFuture, zipCodeDetailsFuture);

        allFutures.thenRun(executor::shutdown).join(); // Shutdown after both complete

        UserConfigResponseDTO ocmResponseDTO = userConfigFuture.join();
        List<ZipCodeDetails> ocmZipCodes = zipCodeDetailsFuture.join();

        Boolean isFedex = ocmResponseDTO.getLocation().getFedexConfiguration().getFedexAccess();
        Boolean isUsps = ocmResponseDTO.getLocation().getUspsConfiguration().getUspsAccess();
        Boolean isDhl = ocmResponseDTO.getLocation().getDhlConfiguration().getDhlAccess();

        List<ZipCodeRuleProjection> shippingProfileRules = ruleDefinitionRepository.findAllByFacilityIdAndRuleTypeAndActiveTrue(facilityId, RuleType.ZIP_CODE.toString());

        Map<String, UUID> shippingProfileRuleMap = new HashMap<>();
        for (ZipCodeRuleProjection shippingProfileRule : shippingProfileRules) {
            shippingProfileRuleMap.put(shippingProfileRule.getValue(), shippingProfileRule.getShippingProfileId());
        }
        Map<String, ZipCodeConfigResponse> zipCodeResponseMap = new HashMap<>();

        if(ocmZipCodes != null) {
            zipCodeResponseMap = ocmZipCodes.stream()
                    .map(zipCode -> {
                        String zip = String.valueOf(zipCode.getZipCode());
                        UUID profileId = shippingProfileRuleMap.get(zip);
                        return ZipCodeConfigResponse.builder()
                                .zipCode(String.valueOf(zipCode.getZipCode()))
                                .isFedex(isFedex)
                                .isUsps(isUsps)
                                .isDhl(isDhl)
                                .isCmsSameDay(zipCode.getSameday())
                                .isCmsNextDay(zipCode.getNextday())
                                .isCmsSameDayState(zipCode.getSamedayState())
                                .isLock(true)  // isLock will be set true for OCM fetched zipcodes
                                .shippingProfileId(profileId)
                                .build();
                    })
                    .collect(Collectors.toMap(ZipCodeConfigResponse::getZipCode, Function.identity()));
        }

        for (ZipCodeRuleProjection rule : shippingProfileRules) {
            String zip = rule.getValue();
            zipCodeResponseMap.computeIfAbsent(zip, k -> ZipCodeConfigResponse.builder()
                    .id(rule.getId())
                    .zipCode(zip)
                    .isFedex(isFedex)
                    .isUsps(isUsps)
                    .isCmsSameDay(false)
                    .isCmsNextDay(false)
                    .isCmsSameDayState(false)
                    .isDhl(isDhl)
                    .isLock(false)  // isLock will be set false for ASP fetched zipcodes
                    .shippingProfileId(rule.getShippingProfileId())
                    .build());
        }

        Map<String, ZipCodeConfigResponse> zipCodeSearchResponseMap = new HashMap<>();
        List<ZipCodeConfigResponse> finalList;

        if (StringUtils.isNotBlank(search)) {
            getSearchResponse(facilityId, search, zipCodeResponseMap, zipCodeSearchResponseMap);
            finalList = new ArrayList<>(zipCodeSearchResponseMap.values());
        } else {
            finalList = new ArrayList<>(zipCodeResponseMap.values());
        }

        // Sort finalList by zipCode before converting into subList
        finalList.sort(Comparator.comparing(ZipCodeConfigResponse::getZipCode));

        // Applying logical pagination by creating subList from finalList
        int pageNo = pageable.getPageNumber();
        int pageSize = pageable.getPageSize();
        int totalElements = finalList.size();
        int totalPages = (int) Math.ceil((double) totalElements / pageSize);
        int start = pageNo * pageSize;
        int end = Math.min(start + pageSize, finalList.size());

        List<ZipCodeConfigResponse> paginatedList = (start < totalElements) ? finalList.subList(start, end) : Collections.emptyList();
        boolean isLastPage = pageNo + 1 >= totalPages;

        return new ShippingRuleResult<>(paginatedList, totalElements, totalPages, pageNo, pageSize, isLastPage);
    }

    @Override
    public ZipCodeRuleResponseDto deleteShippingRules(String ruleType, String ruleId) {
        if (!ZIP_CODE_RULE.equalsIgnoreCase(ruleType)) {
            throw new ValidationException(String.format("Provided rule type: %s is invalid for %s deletion for id: %s",
                    ruleType, ShippingRuleConstants.ZIP_CODE_RULE_DESCRIPTION, ruleId));
        }

        UUID zipCodeRuleUUID = CommonUtil.getUUIDFromStringIfValid(ruleId); // Validate ship via ruleId format
        boolean zipCodeRuleExists = ruleDefinitionRepository.existsByRuleTypeAndId(RuleType.ZIP_CODE.toString(), zipCodeRuleUUID); // Check existence

        if (!zipCodeRuleExists) { // If ship via rule does not exist, return NOT_FOUND response
            return ZipCodeRuleResponseDto.builder()
                    .status(FAILURE)
                    .message(ZIP_CODE_RULE_DESCRIPTION.concat(NOT_FOUND).concat(ruleId))
                    .build();
        }

        ruleDefinitionRepository.deleteById(zipCodeRuleUUID);
        return ZipCodeRuleResponseDto.builder()
                .status(SUCCESS)
                .message(ZIP_CODE_RULE_DESCRIPTION.concat(RULE_DELETION_SUCCESSFUL))
                .build();
    }

    private void getSearchResponse(String facilityId, String searchQuery, Map<String, ZipCodeConfigResponse> zipCodeResponseMap, Map<String, ZipCodeConfigResponse> zipCodeSearchResponseMap) {

        List<ShippingProfile> shippingProfiles = shippingProfileRepository.findByFacilityIdAndActiveIsNotFalseAndShippingProfileNameContainingIgnoreCase(facilityId, searchQuery);
        Map<UUID, String> shippingProfileMap = shippingProfiles.stream()
                .collect(Collectors.toMap(ShippingProfile::getId, ShippingProfile::getShippingProfileName));
        for (Map.Entry<String, ZipCodeConfigResponse> entry : zipCodeResponseMap.entrySet()) {
            ZipCodeConfigResponse zipCodeConfigResponse = entry.getValue();
            if (shippingProfileMap.containsKey(zipCodeConfigResponse.getShippingProfileId())) {
                zipCodeSearchResponseMap.put(entry.getKey(), zipCodeConfigResponse);
            }
        }
        for (Map.Entry<String, ZipCodeConfigResponse> entry : zipCodeResponseMap.entrySet()) {
            ZipCodeConfigResponse zipCodeConfigResponse = entry.getValue();
            if (entry.getKey().contains(searchQuery)) {
                zipCodeSearchResponseMap.put(entry.getKey(), zipCodeConfigResponse);
            }
        }
    }
}

