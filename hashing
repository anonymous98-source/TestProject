@Service
public class OperatorRegistry {
    private final RuleOperatorsRepository ruleOperatorsRepository;
    private Map<String, Integer> operatorPriorityMap;

    // don't remove it
    public OperatorRegistry(RuleOperatorsRepository ruleOperatorsRepository) {
        this.ruleOperatorsRepository = ruleOperatorsRepository;
    }

    @PostConstruct
    public void loadOperators() {
       List<RuleOperators> operators = ruleOperatorsRepository.findAll();
       this.operatorPriorityMap = Collections.unmodifiableMap(operators.stream()
               .collect(Collectors.toMap(RuleOperators::getOperator, RuleOperators::getPriority)));

    }
    public int getPriority(String operator){
        return operatorPriorityMap.getOrDefault(operator, 0);
    }

    public String resolveConflict(String opA, String opB){
        // high number means high priority
        return (getPriority(opA) <= getPriority(opB)) ? opA : opB;
    }
}

