   * @param addressValidationRequest The address validation request DTO containing address details.
   * @return AddressValidationResponseDTO containing validation results, including whether the
   *     address is valid or not.
   */
  @Override
  public AddressValidationResponseDTO validateAddress(
          AddressValidationRequest addressValidationRequest) throws JsonProcessingException {

    AddressValidationRequestDTO addressValidationRequestDTO =
            buildAddressValidationRequestDTO(addressValidationRequest);

    Mono<AddressValidationResponseDTO> monoAddressValidationResponse =
            sendFlexWebClientService.sendFlexRequest(
                    ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT,
                    HttpMethod.POST,
                    Map.of(),
                    addressValidationRequestDTO,
                    AddressValidationResponseDTO.class);

    try {

      AddressValidationResponseDTO addressValidationResponseDTO =
              monoAddressValidationResponse.block();

      persistAddressValidationResponse(
              addressValidationRequestDTO,
              addressValidationResponseDTO);

      return addressValidationResponseDTO;

    } catch (ValidationException exception) {

      persistAddressValidationValidationFailure(
              addressValidationRequestDTO,
              exception);

      return buildAddressValidationErrorResponse(addressValidationRequest);

    } catch (Exception exception) {

      persistAddressValidationFailure(
              addressValidationRequestDTO,
              exception);

      throw new ShippingIntegrationException(
              "An unexpected error occurred while saving address validation response "
                      + exception.getMessage(),
              exception);
    }
  }

  private SendFlexRecordDto persistAddressValidationResponse(
          AddressValidationRequestDTO addressValidationRequestDTO,
          AddressValidationResponseDTO addressValidationResponseDTO) {
    log.atInfo().setMessage("saving the address validation response").log();

    SendFlexRecordDto sendFlexRecordDto =
            SendFlexRecordDto.builder()
                    .shipmentId(null)
                    .sendflexTxid(null)
                    .requestObject(addressValidationRequestDTO)
                    .responseObject(addressValidationResponseDTO)
                    .statusCode(
                            addressValidationResponseDTO.getResult() != null
                                    ? addressValidationResponseDTO.getResult().getStatusCode()
                                    : null)
                    .apiCode(ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT)
                    .build();
    return sendFlexRecordUtil.saveSendflexRecord(sendFlexRecordDto);
  }
  SendFlexRecordDto persistAddressValidationFailure(
          AddressValidationRequestDTO addressValidationRequestDTO,
          Exception e) {
    String detailMessage = e.getMessage();
    Throwable cause = e.getCause();
    String causeMessage = (cause != null) ? cause.getMessage() : null;
    SendFlexRecordDto sendFlexRecordDto =
            SendFlexRecordDto.builder()
                    .requestObject(addressValidationRequestDTO)
                    .responseObject(detailMessage + causeMessage)
                    .statusCode(FAILURE)
                    .apiCode(ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT)
                    .build();
    return sendFlexRecordUtil.saveSendflexRecord(sendFlexRecordDto);
  }

  private AddressValidationRequestDTO buildAddressValidationRequestDTO(
          AddressValidationRequest addressValidationRequest) {
    Address address = addressValidationRequest.getAddress();

    return AddressValidationRequestDTO.builder()
            .profileCode(fetchProfileCode(addressValidationRequest))
            .validationType(ServiceCommonConstants.ADDRESS_VALIDATION_VALIDATION_TYPE)
            .shipViaCode(ShipViaCode.getValueByName(addressValidationRequest.getShippingProfile()))
            .addressToValidate(
                    AddressToValidate.builder()
                            .description(address.getName())
                            .name(address.getCompany())
                            .contact(
                                    Contact.builder()
                                            .name(address.getName())
                                            .phone(address.getPhoneNumber())
                                            .email(address.getEmailAddress())
                                            .title(null)
                                            .department(EMPTY_STRING)
                                            .build())
                            .addressLines(address.getAddressLines())
                            .city(address.getCity())
                            .state(address.getState())
                            .residential(address.isResidential())
                            .postalCode(address.getZipCode())
                            .countryCode(address.getCountry())
                            .type(RECEIVER)
                            .build())
            .build();
  }

  public AddressValidationResponse buildAddressValidationResponse(
          AddressValidationResponseDTO responseDTO) {

    return AddressValidationResponse.builder()
            .data(
                    AddressData.builder()
                            .validationDetail(buildValidationDetail(responseDTO.getAddressToValidate()))
                            .addressValid(responseDTO.isAddressValid())
                            .suggestedAddress(buildAddressSuggestionResp(responseDTO))
                            .build())
            .message(responseDTO.getResult() != null ? responseDTO.getResult().getStatusCode() : "")
            .build();
  }

  private ValidationDetailResponse buildValidationDetail(AddressToValidate addressToValidate) {
    var isValid = false;
    if (addressToValidate != null && addressToValidate.getValidationDetail() != null) {
      isValid = addressToValidate.getValidationDetail().isValidated();
    }
    return ValidationDetailResponse.builder().validated(isValid).build();
  }

  private AddressSuggestionResp buildAddressSuggestionResp(
