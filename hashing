import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertTrue;

@ExtendWith(MockitoExtension.class)
class NotificationAccessServiceImplTest {

    @InjectMocks
    private NotificationAccessServiceImpl notificationAccessService;

    @Mock
    private NotificationWebclientService notificationWebclientService;

    @Test
    void testPhoneNumberHasOptedOut_Success() {
        String phoneNumber = "1234567890";
        PhoneStatusCheckResponseDto mockResponse = new PhoneStatusCheckResponseDto();
        mockResponse.setHasOptedOut(true);

        Mockito.when(notificationWebclientService.validateNotificationPhoneNumber(phoneNumber))
                .thenReturn(mockResponse);

        PhoneStatusCheckResponseDto result = notificationAccessService.validateNotificationPhoneNumberAccess(phoneNumber);

        assertNotNull(result);
        assertTrue(result.isHasOptedOut());
        assertEquals("This phone number has opted out for SMS notification and must first reply ‘START’ to allow future notifications.",
                result.getStatusMessage());
    }

    @Test
    void testPhoneNumberHasOptedIn_Success() {
        String phoneNumber = "1234567890";
        PhoneStatusCheckResponseDto mockResponse = new PhoneStatusCheckResponseDto();
        mockResponse.setHasOptedOut(false);
        mockResponse.setHasInitialInviteSent(false);
        mockResponse.setHasOptedIn(true);

        Mockito.when(notificationWebclientService.validateNotificationPhoneNumber(phoneNumber))
                .thenReturn(mockResponse);

        PhoneStatusCheckResponseDto result = notificationAccessService.validateNotificationPhoneNumberAccess(phoneNumber);

        assertNotNull(result);
        assertFalse(result.isHasOptedOut());
        assertNull(result.getStatusMessage());
        assertTrue(result.isHasOptedIn());
        assertFalse(result.isHasInitialInviteSent());
        assertNull(result.getSmsNotificationConsentStatus());
    }

    @Test
    void testPhoneNumberConsentNotYetAcknowledged_Success() {
        String phoneNumber = "1234567890";
        PhoneStatusCheckResponseDto mockResponse = new PhoneStatusCheckResponseDto();
        mockResponse.setHasOptedOut(false);
        mockResponse.setHasInitialInviteSent(true);
        mockResponse.setHasOptedIn(false);

        Mockito.when(notificationWebclientService.validateNotificationPhoneNumber(phoneNumber))
                .thenReturn(mockResponse);

        PhoneStatusCheckResponseDto result = notificationAccessService.validateNotificationPhoneNumberAccess(phoneNumber);

        assertNotNull(result);
        assertFalse(result.isHasOptedOut());
        assertNull(result.getStatusMessage());
        assertFalse(result.isHasOptedIn());
        assertTrue(result.isHasInitialInviteSent());
        assertEquals(ServiceCommonConstants.SMS_CONSENT_PENDING_WARNING_MESSAGE, result.getSmsNotificationConsentStatus());
    }

    @Test
    void testEmptyWebclientResponse() {
        String phoneNumber = "1234567890";

        Mockito.when(notificationWebclientService.validateNotificationPhoneNumber(phoneNumber))
                .thenReturn(null);

        PhoneStatusCheckResponseDto result = notificationAccessService.validateNotificationPhoneNumberAccess(phoneNumber);

        assertNull(result);
    }
}

