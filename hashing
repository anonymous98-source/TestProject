    /**
     * This method retrieves the ondemand shipping service option for a given shipment book request.
     *
     * @param request The shipment book request containing the necessary details.
     */
    public void getOndemandShippingServiceOption(ShipmentBookRequest request) {
        LocalDateTime shipByDate = LocalDateTime.parse(request.getPickupStartDate());
        var shipByDateStr = shipByDate.toLocalDate().toString();
        String shipToZipCode = Optional.ofNullable(request.getShipToAddress())
                .map(ShipToAddress::getAddressData)
                .map(ShipToAddressData::getAddress)
                .map(ShipToAddressDetails::getZipCode)
                .filter(zip -> zip != null && !zip.isEmpty())
                .map(zip -> zip.split("-")[0])
                .orElseThrow(() -> new ValidationException("Ship-to zip code is missing or invalid"));
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern(CMS_DATEFORMAT);
        OcmShipmentResponseDTO ocmResponse = ocmWebClientService.getSchedules(
                request.getFacilityId(), shipByDateStr, OCM_SHIPMENT_TYPE_SAMEDAYSTATE,shipToZipCode);

        if (ocmResponse != null && ocmResponse.getSchedules() != null) {
            String scheduleId = request.getScheduleId();

            ocmResponse.getSchedules().stream()
                    .filter(schedule -> schedule.getId().equals(scheduleId))
                    .findFirst()
                    .ifPresentOrElse(schedule -> {
                        String pickupStart = LocalDateTime.of(
                                LocalDate.parse(schedule.getPickup().getDate()),
                                LocalTime.parse(schedule.getPickup().getStartTime())
                        ).format(formatter);
                        String pickupEnd = LocalDateTime.of(
                                LocalDate.parse(schedule.getPickup().getDate()),
                                LocalTime.parse(schedule.getPickup().getEndTime())
                        ).format(formatter);

                        String deliveryStart = LocalDateTime.of(
                                LocalDate.parse(schedule.getDelivery().getDate()),
                                LocalTime.parse(schedule.getDelivery().getStartTime())
                        ).format(formatter);

                        String deliveryEnd = LocalDateTime.of(
                                LocalDate.parse(schedule.getDelivery().getDate()),
                                LocalTime.parse(schedule.getDelivery().getEndTime())
                        ).format(formatter);

                        request.setPickupStartDate(pickupStart);
                        request.setPickupEndDate(pickupEnd);
                        request.setDeliveryStartDate(deliveryStart);
                        request.setDeliveryEndDate(deliveryEnd);

                        log.atInfo().setMessage("ShipmentBookRequest updated with scheduleId: " + scheduleId).log();
                    }, () -> {
                        throw new ValidationException(NO_SHIPPING_SERVICE_AVAILABLE);
                    });
        }else {
            throw new ValidationException(NO_SHIPPING_SERVICE_AVAILABLE);
        }

    }

    public void shippingServiceValidateForSameDayAndNextDay(ShipmentBookRequest request, String serviceType) {
        LocalDateTime shipByDate = LocalDateTime.parse(request.getPickupStartDate());
        var shipByDateStr = shipByDate.toLocalDate().toString();
        String shipToZipCode = Optional.ofNullable(request.getShipToAddress())
                .map(ShipToAddress::getAddressData)
                .map(ShipToAddressData::getAddress)
                .map(ShipToAddressDetails::getZipCode)
                .filter(zip -> zip != null && !zip.isEmpty())
                .map(zip -> zip.split("-")[0])
                .orElseThrow(() -> new ValidationException("Ship-to zip code is missing or invalid"));
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern(CMS_DATEFORMAT);
        OcmShipmentResponseDTO ocmResponse = ocmWebClientService.getSchedules(
                request.getFacilityId(), shipByDateStr, serviceType,shipToZipCode);

        if (ocmResponse != null && ocmResponse.getSchedules() != null) {
            String scheduleId = request.getScheduleId();
            boolean hasMatchingWindow =
                    ocmResponse.getSchedules().stream()
                            .filter(schedule -> Objects.equals(schedule.getId(), scheduleId))
                            .anyMatch(
                                    schedule -> {
                                        String pickupStart =
                                                LocalDateTime.of(
                                                                LocalDate.parse(schedule.getPickup().getDate()),
                                                                LocalTime.parse(schedule.getPickup().getStartTime()))
                                                        .format(formatter);
                                        String pickupEnd =
                                                LocalDateTime.of(
                                                                LocalDate.parse(schedule.getPickup().getDate()),
                                                                LocalTime.parse(schedule.getPickup().getEndTime()))
                                                        .format(formatter);
                                        String deliveryStart =
                                                LocalDateTime.of(
                                                                LocalDate.parse(schedule.getDelivery().getDate()),
                                                                LocalTime.parse(schedule.getDelivery().getStartTime()))
                                                        .format(formatter);
                                        String deliveryEnd =
                                                LocalDateTime.of(
                                                                LocalDate.parse(schedule.getDelivery().getDate()),
                                                                LocalTime.parse(schedule.getDelivery().getEndTime()))
                                                        .format(formatter);

                                        return pickupStart.equals(request.getPickupStartDate())
                                                && pickupEnd.equals(request.getPickupEndDate())
                                                && deliveryStart.equals(request.getDeliveryStartDate())
                                                && deliveryEnd.equals(request.getDeliveryEndDate());
                                    });

            if (!hasMatchingWindow) {
                throw new ValidationException("Pickup and delivery window timing does not match the selected values during shipping service.");
            }
        }else {
            throw new ValidationException(NO_SHIPPING_SERVICE_AVAILABLE);
        }

    }


    /**
     * Validates the shipment booking request data.
     *
     * @param shipmentBookRequest The shipment booking request to validate.
     * @throws ValidationException if any validation errors occur.
     */
    private void dataValidation(ShipmentBookRequest shipmentBookRequest) {
        if (!isCmsServiceLevel(shipmentBookRequest)) {
            throw new ValidationException("Invalid combination of shippingProfile and shipViaOptions code. It must be {" +
                    CMS_COURIER_SAME_DAY + "," + SAMEDAY.name() + "} or {" + CMS_COURIER_NEXT_DAY + "," + NEXTDAY.name() + "} or {" + CMS_COURIER_SAME_DAY_STATE + ","+ SAMEDAYSTATE.name() + "} ");
        }
        var errors = new StringBuilder();
        validateRequiredDates(shipmentBookRequest, errors);
        validateTotalPackageCount(shipmentBookRequest, errors);
        validateAdditionalAccessorial(shipmentBookRequest, errors);
        validatePackagingDetails(shipmentBookRequest, errors);

        if (!errors.isEmpty()) {
            throw new ValidationException(errors.toString());
        }

        pickupAndDeliveryDateValidation(
                shipmentBookRequest.getPickupStartDate(),
                shipmentBookRequest.getPickupEndDate(),
                shipmentBookRequest.getDeliveryStartDate(),
                shipmentBookRequest.getDeliveryEndDate(),
                shipmentBookRequest.getShipViaOptions().get(0).getCode()
        );
    }

    private void validateRequiredDates(ShipmentBookRequest req, StringBuilder errors) {
        if (req.getDeliveryStartDate() == null) {
            errors.append("deliveryStartDate can not be null.\n ");
        }
        if (req.getPickupEndDate() == null) {
            errors.append("pickupEndDate can not be null.\n ");
        }
        if (req.getPickupStartDate() == null) {
            errors.append("pickupStartDate can not be null.\n ");
        }
        if (req.getDeliveryEndDate() == null) {
            errors.append("deliveryEndDate can not be null.\n ");
        }
    }

    private void validateTotalPackageCount(ShipmentBookRequest req, StringBuilder errors) {
        if (req.getTotalPackageCount() != null && req.getTotalPackageCount() != 1) {
            errors.append("Total package count must be greater than 0 and less than or equal to 1.\n");
        }
    }

    private void validateAdditionalAccessorial(ShipmentBookRequest req, StringBuilder errors) {
        var acc = req.getAdditionalAccessorial();
        if (acc != null) {
            if (acc.getReadyTime() != null && isNotValidLocalDate(acc.getReadyTime())) {
                errors.append("Invalid date format for readyTime. Expected format: yyyy-MM-dd'T'HH:mm:ss.SSS\n");
            }
            if (acc.getAvailableUntil() != null && isNotValidLocalDate(acc.getAvailableUntil())) {
                errors.append("Invalid date format for availableUntil. Expected format: yyyy-MM-dd'T'HH:mm:ss.SSS\n");
            }
            if (acc.isSignatureRequired() && StringUtils.isBlank(acc.getSignatureLevel())) {
                errors.append("Signature level is required when signatureRequired is true.\n");
            }
        }
    }

    private void validatePackagingDetails(ShipmentBookRequest req, StringBuilder errors) {
        var packagingDetails = req.getPackagingDetails();
        if ((packagingDetails != null && !packagingDetails.isEmpty()) && packagingDetails.size() > 1 ) {
            errors.append("Exactly one packagingDetails entry is required.\n");
        }
    }

    /**
     * Checks if the shipment is a CMS shipment based on the shipViaOptions.
     *
     * @param shipmentBookRequest The shipment booking request to check.
     * @return true if it is a CMS shipment, false otherwise.
     */
    private boolean isCmsServiceLevel(ShipmentBookRequest shipmentBookRequest) {
        if(shipmentBookRequest.getShipViaOptions() != null && !shipmentBookRequest.getShipViaOptions().isEmpty()) {
            String code=shipmentBookRequest.getShipViaOptions().get(0).getCode();
            String shippingProfile=shipmentBookRequest.getShippingProfile();
            if(shippingProfile.equalsIgnoreCase(CMS_COURIER_SAME_DAY) && !code.equalsIgnoreCase(ServiceType.SAMEDAY.name())) {
                return false;
            } else if (shippingProfile.equalsIgnoreCase(CMS_COURIER_NEXT_DAY) && !code.equalsIgnoreCase(ServiceType.NEXTDAY.name())) {
                return false;
            } else return !shippingProfile.equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE) || code.equalsIgnoreCase(ServiceType.SAMEDAYSTATE.name());
        }
        return false;
    }
    /**
     * Validates the pickup and delivery dates.
     *
     * @param pickupStartDate pickupStartDate
     * @param pickupEndDate pickupEndDate
     * @param deliveryStartDate deliveryStartDate
     * @param deliveryEndDate deliveryEndDate
     * @param serviceType    The service type to validate against.
     * @throws ValidationException if any validation errors occur.
     */
    private void pickupAndDeliveryDateValidation(String pickupStartDate, String pickupEndDate, String deliveryStartDate,  String deliveryEndDate,String serviceType) {
        var stringBuilder = new StringBuilder();
        var pickupFrom=LocalDateTime.parse(pickupStartDate);
        var pickupTo=LocalDateTime.parse(pickupEndDate);
        var deliveryFromDate=LocalDateTime.parse(deliveryStartDate);
        var deliveryToDate=LocalDateTime.parse(deliveryEndDate);
        if(!serviceType.equalsIgnoreCase(ServiceType.SAMEDAYSTATE.name()))
             validateFutureDate(pickupFrom,pickupTo,deliveryFromDate,deliveryToDate);

        if(pickupTo.isBefore(pickupFrom)) {
            stringBuilder.append("pickupEndDate must be after pickupStartDate .\n");
        }
        if(deliveryToDate.isBefore(deliveryFromDate)) {
            stringBuilder.append("deliveryEndDate must be after deliveryStartDate .\n");
        }
        if(NEXTDAY.name().equalsIgnoreCase(serviceType)){
            if (deliveryFromDate.isBefore(pickupFrom)) {
                stringBuilder.append("pickupStartDate must be before deliveryStartDate .\n");
            }

            if (deliveryToDate.isBefore(pickupTo)) {
                stringBuilder.append("pickupEndDate must be before deliveryEndDate.\n");
            }
        }
        if(serviceType.equals(ServiceType.NEXTDAY.name()) && !deliveryToDate.toLocalDate().isAfter(pickupTo.toLocalDate())) {
            stringBuilder.append("pickup date and delivery date must be diff for NEXTDAY service type.\n");
        }

        if(!stringBuilder.isEmpty()) {
            throw new ValidationException(stringBuilder.toString());
        }
    }


    /**
     * Validates that the given dates are in the future.
     *
     * @param pickupFromDate The pickup from date to validate.
     * @param pickupToDate   The pickup to date to validate.
     * @param deliveryFromDate The delivery from date to validate.
     * @param deliveryToDate The delivery to date to validate.
     * @throws ValidationException if any of the dates are not in the future.
     */
    private void validateFutureDate(LocalDateTime pickupFromDate,LocalDateTime pickupToDate,LocalDateTime deliveryFromDate,LocalDateTime deliveryToDate) {
        var now = LocalDate.now();
        var stringBuilder = new StringBuilder();
        if(pickupFromDate.toLocalDate().isBefore(now)) {
            stringBuilder.append("pickupStartDate must be in the future.\n");
        }
        if(pickupToDate.toLocalDate().isBefore(now)) {
            stringBuilder.append("pickupEndDate must be in the future.\n");
        }
        if(deliveryFromDate.toLocalDate().isBefore(now)) {
            stringBuilder.append("deliveryStartDate must be in the future.\n");
        }
        if(deliveryToDate.toLocalDate().isBefore(now)) {
            stringBuilder.append("deliveryEndDate must be in the future.\n");
        }
        if(!stringBuilder.isEmpty()) {
            throw new ValidationException(stringBuilder.toString());
        }
    }

    /**
     * Checks if the given date string is not valid according to the specified format.
     *
     * @param date The date string to check.
     * @return true if the date is not valid, false otherwise.
     */
    public static boolean isNotValidLocalDate(String date) {
        var formatter = DateTimeFormatter.ofPattern(CMS_DATEFORMAT);
        try {
            LocalDate.parse(date, formatter);
            return false; // Valid date
        } catch (Exception e) {
            return true; // Invalid date
        }
    }
    private void validateDryIceWeight(ShipmentBookRequest request) {
        for (PackagingDetails details : request.getPackagingDetails()) {
            Packaging packaging = details.getPackaging();
            Accessorials accessorials = details.getAccessorials();
            if (packaging != null && accessorials != null && accessorials.isContainsDryIce()) {

