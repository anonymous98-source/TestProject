  }

  private void validateSmsValues(
      @Valid ShipmentBookRequest shipmentBookRequest,
      PremiumFeatureResponse premiumFeatureResponse) {
    List<SmsNotifications> smsNotifications =
        shipmentBookRequest.getAdditionalAccessorial().getSmsNotification();
    if (neitherNullNorEmpty(smsNotifications)) {
      smsNotifications.forEach(
          sms -> {
            if (sms.getPhoneNumber() != null
                && !sms.getPhoneNumber().isBlank()
                && sms.getNotify().isEmpty())
              throw new ValidationException(
                  "At least one notification type must be selected for phone number");
          });

      if (Boolean.TRUE.equals(premiumFeatureResponse.getBeaconPlus())) {
        if (smsNotifications.size() > SMS_NOTIFICATION_PHONE_NUMBER_LIMIT) {
          throw new ValidationException(
              String.format("Cannot Subscribe to SMS Notifications for more than %d phone numbers", SMS_NOTIFICATION_PHONE_NUMBER_LIMIT));
        }
        Set<String> allSmsNotifications =
            shipmentBookRequest.getAdditionalAccessorial().getSmsNotification().stream()
                .map(SmsNotifications::getNotify)
                .filter(Objects::nonNull)
                .flatMap(List::stream)
                .collect(Collectors.toSet());
        List<String> allowedNotifications = new ArrayList<>(SMS_NOTIFICATIONS);
        validateAdditionalNotification(
            shipmentBookRequest, allSmsNotifications, allowedNotifications);
        shippingProfileServiceImpl.validSubscription(
            new ArrayList<>(allSmsNotifications), allowedNotifications, SMS);
      } else {
        throw new ValidationException(
            "SMS Notifications cannot be subscribed for users not having Beacon Plus access.");
      }
    }
  }

  private void validateAdditionalNotification(ShipmentBookRequest shipmentBookRequest,
                                              Set<String> allSmsNotifications,
                                              List<String> allowedNotifications) {

    if (!allSmsNotifications.contains(NOTIFICATION_WHEN_DELIVERY_EXCEPTION_OCCURS)) {
      validateNotifyListSizeForAll(shipmentBookRequest);
      return;
    }

    if (!CMS_CARRIERS.contains(shipmentBookRequest.getShippingProfile().toLowerCase())) {
      throw new ValidationException(
              "Notification when delivery exception occurs is only available for CMS carriers.");
    }

    validateDeliveryExceptionNotification(shipmentBookRequest, allowedNotifications);
  }

  private void validateNotifyListSizeForAll(ShipmentBookRequest shipmentBookRequest) {
    shipmentBookRequest.getAdditionalAccessorial().getSmsNotification().stream()
            .filter(sn -> CollectionUtils.isNotEmpty(sn.getNotify()) && sn.getNotify().size() > SMS_NOTIFY_LIST_SIZE_LIMIT)
            .findAny()
            .ifPresent(sn -> {
              throw new ValidationException(
                      String.format("Notify list must not contain more than %d elements.", SMS_NOTIFY_LIST_SIZE_LIMIT));
            });
  }

  private void validateDeliveryExceptionNotification(ShipmentBookRequest shipmentBookRequest,
                                                     List<String> allowedNotifications) {
    String senderPhoneNumber = shipmentBookRequest.getShipFromAddress().getAddressData().getAddress().getPhoneNumber();

    validateSenderNotifyListSize(shipmentBookRequest, senderPhoneNumber);
    Set<String> nonSenderNotifications = collectAndValidateNonSenderNotifications(shipmentBookRequest, senderPhoneNumber);

    if (nonSenderNotifications.contains(NOTIFICATION_WHEN_DELIVERY_EXCEPTION_OCCURS)) {
      throw new ValidationException(
              "Notification when delivery exception occurs can be set only for sender's phone number.");
    }
    allowedNotifications.add(NOTIFICATION_WHEN_DELIVERY_EXCEPTION_OCCURS);
  }


  private void validateSenderNotifyListSize(ShipmentBookRequest shipmentBookRequest, String senderPhoneNumber) {
    shipmentBookRequest.getAdditionalAccessorial().getSmsNotification().stream()
            .filter(sn -> StringUtils.equalsIgnoreCase(sn.getPhoneNumber(), senderPhoneNumber))
            .findFirst()
            .filter(sn -> CollectionUtils.isNotEmpty(sn.getNotify()) && sn.getNotify().size() > SMS_NOTIFY_LIST_SIZE_LIMIT)
            .ifPresent(sn -> {
              throw new ValidationException(
                      String.format("Sender sms notify list must not contain more than %d elements.", SMS_NOTIFY_LIST_SIZE_LIMIT));
            });
  }

  private Set<String> collectAndValidateNonSenderNotifications(ShipmentBookRequest shipmentBookRequest,
                                                               String senderPhoneNumber) {
    return shipmentBookRequest.getAdditionalAccessorial().getSmsNotification().stream()
            .filter(sn -> !StringUtils.equalsIgnoreCase(sn.getPhoneNumber(), senderPhoneNumber))
            .peek(this::validateNonSenderNotifyListSize)
            .map(SmsNotifications::getNotify)
            .filter(Objects::nonNull)
            .flatMap(List::stream)
            .collect(Collectors.toSet());
  }

  private void validateNonSenderNotifyListSize(SmsNotifications sn) {
    if (CollectionUtils.isNotEmpty(sn.getNotify()) && sn.getNotify().size() > SMS_NOTIFY_LIST_SIZE_LIMIT) {
      throw new ValidationException(
              String.format("Non sender sms notify list must not contain more than %d elements.", SMS_NOTIFY_LIST_SIZE_LIMIT));
    }
  }

  private List<UUID> getPackageIds(ShipmentBookRequest shipmentBookRequest) {
    return shipmentBookRequest.getPackagingDetails().stream()
        .filter(packageDetails -> Objects.nonNull(packageDetails.getPackaging()))
        .map(packagingDetails -> packagingDetails.getPackaging().getPackagingId())
        .filter(this::neitherNullNorEmpty)
        .map(UUID::fromString)
        .toList();
  }

  private boolean neitherNullNorEmpty(Object object) {
    return Objects.nonNull(object)
        && ((object instanceof String s && !s.isBlank())
            || (object instanceof java.util.Collection<?> c && !c.isEmpty()));
  }

  private Map<UUID, PackageType> prepareIdPackageTypeMap(List<UUID> packageIds) {
    return packageTypeRepository.findAllById(packageIds).stream()
        .collect(
            Collectors.toMap(
                pkg -> {
                  if (Boolean.FALSE.equals(pkg.getActive())) {
                    throw new ValidationException(
                        "Selected custom package - "
                            + pkg.getPackageTypeName()
                            + COLON
                            + pkg.getId()
                            + " - is inactive.");
                  }
                  return pkg.getId();
                },
                Function.identity()));
  }

  private void validateInnerDimensions(Packaging packaging) {
    if ((validateDimValueNotNull(packaging.getInnerLength())
            || validateDimValueNotNull(packaging.getInnerWidth())
            || validateDimValueNotNull(packaging.getInnerHeight()))
        && (validateDimValueNull(packaging.getInnerLength())
            || validateDimValueNull(packaging.getInnerWidth())
            || validateDimValueNull(packaging.getInnerHeight()))) {
      throw new ValidationException("All or none of the Inner Dimensions must be provided");
    }
  }

  private boolean validateDimValueNull(Double dimValue) {
    return Objects.isNull(dimValue) || dimValue <= 0;
  }

  private boolean validateDimValueNotNull(Double dimValue) {
    return Objects.nonNull(dimValue) && dimValue > 0;
  }

  private void setPackageTypeDetails(Packaging packaging, PackageType packageType) {
    packaging.setRatedLength(packageType.getRatedLength());
    packaging.setPackagePackagingType(packageType.getPackagingType());
    packaging.setPackageBrand(packageType.getPackageBrand());
    packaging.setPackageProductName(packageType.getPackageProductName());
    packaging.setPackageDescription(packageType.getPackageDescription());
    packaging.setPackageModelIdentifier(packageType.getPackageModelIdentifier());
    packaging.setInnerHeight(packageType.getInnerHeight());
    packaging.setInnerWidth(packageType.getInnerWidth());
    packaging.setInnerLength(packageType.getInnerLength());
  }

  private void validateHcidCodes(
      List<HCIDCode> hcidCodes, PremiumFeatureResponse premiumFeatureResponse) {
    if (!(Boolean.TRUE.equals(premiumFeatureResponse.getBeaconPlus())
        && Boolean.TRUE.equals(premiumFeatureResponse.getInterventionServicesSetup()))) {
      throw new ValidationException(
          "HCID Options cannot be selected by users not having Beacon Plus and Intervention access.");
    }

    // get all the possible HCID values from DB
    List<Hcid> hcidValuesList = hcidRepository.findAll();

    Set<String> codeName =
        hcidValuesList.stream()
            .filter(hcid -> Objects.isNull(hcid.getParentCode()))
            .map(hcid -> concatWithColon(hcid.getCode(), hcid.getName()))
            .collect(Collectors.toSet());
    Set<String> tempCodeTempName =
        hcidValuesList.stream()
            .filter(hcid -> Objects.nonNull(hcid.getParentCode()))
            .map(hcid -> concatWithColon(hcid.getCode(), hcid.getName(), hcid.getParentCode()))
            .collect(Collectors.toSet());

    // Validate HCID values
    hcidCodes.forEach(
        hcidReq -> {
          if (isNotParentHcid(hcidReq, codeName)
              || (isChildHcidPresent(hcidReq) && isNotChildHcid(hcidReq, tempCodeTempName))) {
            throw new ValidationException("Invalid HCID value combination - " + hcidReq);
          }
        });
  }

  private String concatWithColon(String... parts) {
    return String.join(COLON, parts);
  }

  private boolean isNotParentHcid(HCIDCode hcidReq, Set<String> codeName) {
    return !codeName.contains(concatWithColon(hcidReq.getCode(), hcidReq.getName()));
  }

  private boolean isChildHcidPresent(HCIDCode hcidReq) {
    return neitherNullNorEmpty(hcidReq.getTempCode()) || neitherNullNorEmpty(hcidReq.getTempName());
  }

  private boolean isNotChildHcid(HCIDCode hcidReq, Set<String> tempCodeTempName) {
    return !tempCodeTempName.contains(
        concatWithColon(hcidReq.getTempCode(), hcidReq.getTempName(), hcidReq.getCode()));
  }
}

