@Component
@Slf4j
@RequiredArgsConstructor
public class AddressBookBatchProcessing {

    private final ShipToAddressFacilityMappingRepository shipToAddressFacilityMappingRepository;
    private final ShipToAddressRepository shipToAddressRepository;

    /**
     * Saves valid entries to the database.
     * If isAppend is false, it deletes existing records for the facilityId before saving.
     *
     * @param facilityId The facility ID to which the entries belong.
     * @param isAppend   Whether to append to existing records or replace them.
     * @param validEntries The list of valid ShipToAddressFacilityMapping entries to save.
     */
    @Transactional
    protected void saveValidEntries(String facilityId, boolean isAppend, List<ShipToAddressFacilityMapping> validEntries) {
        if (!isAppend) {
            log.atInfo().setMessage("isAppend is false, deleting existing records for facilityId started").log();
            shipToAddressFacilityMappingRepository.deleteShipToAddressByMonarchShipFromFacilityId(facilityId);
            log.atInfo().setMessage("isAppend is false, deleting existing records for facilityId completed").log();

        }
        var batchSize = 500;
        for (var i = 0; i < validEntries.size(); i += batchSize) {
            int end = Math.min(i + batchSize, validEntries.size());
            List<ShipToAddressFacilityMapping> batch = validEntries.subList(i, end);
            try {
                shipToAddressFacilityMappingRepository.saveAll(batch);
                log.atInfo().setMessage("Batch saved successfully")
                        .addKeyValue("batchStartIndex", i)
                        .addKeyValue("batchEndIndex", end - 1)
                        .addKeyValue("batchSize", batch.size())
                        .log();
            } catch (Exception e) {
                throw new DatabaseException("Error saving batch to database: " +
                        FACILITY_ID + facilityId + "Message: " + e.getMessage() + Arrays.toString(e.getStackTrace()));
            }
        }
    }

