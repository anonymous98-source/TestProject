  void persistAddressValidationFailure_shouldSaveFailureRecord() {

    AddressValidationRequestDTO requestDTO = new AddressValidationRequestDTO();

    Exception exception = new Exception("Validation failed", new RuntimeException("Invalid address"));

    SendFlexRecordDto expectedRecord = SendFlexRecordDto.builder().requestObject(requestDTO).responseObject("Validation failedInvalid address").statusCode(FAILURE).apiCode(ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT).build();

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenReturn(expectedRecord);

    SendFlexRecordDto result = addressValidationService.persistAddressValidationFailure(requestDTO, exception);

    assertNotNull(result);
    assertEquals(FAILURE, result.getStatusCode());
    assertEquals(ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT, result.getApiCode());

    verify(sendFlexRecordUtil, times(1)).saveSendflexRecord(any());
  }

