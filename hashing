  private List<String> validateLithiumBatteryOptionsWithWeight(ShippingProfileRequest request) {
    List<String> allowedServiceLevels = new ArrayList<>();
    if (request.isLithiumBattery() && Objects.nonNull(request.getWeight())) {
      allowedServiceLevels.add(DHL_GROUND_CODE);
      if (isLithiumContained(request))
        allowedServiceLevels.add(DHL_EXPEDITED_CODE);
      if ((isLithiumContained(request) || isLithiumPacked(request))
              && isOverWeightLimit(request, LITHIUM_LBS_LIMIT, LITHIUM_OZ_LIMIT))
        throw new ValidationException(
                "Maximum value is 11lbs/176oz. Maximum weight is limited to the lithium battery selection.");
      if ((request.getIonStandalone() || request.getMetalStandalone())
              && isOverWeightLimit(request, LITHIUM_STANDALONE_LBS_LIMIT, LITHIUM_STANDALONE_OZ_LIMIT))
        throw new ValidationException(
                "Maximum value is 5lbs/80oz. Maximum weight is limited to the lithium battery selection.");
    }
    return allowedServiceLevels;
  }

  private static boolean isLithiumContained(ShippingProfileRequest request) {
    return request.getIonContainedInEquipment() || request.getMetalContainedInEquipment();
  }

  private static boolean isLithiumPacked(ShippingProfileRequest request) {
    return request.getIonPackedWithEquipment() || request.getMetalPackedWithEquipment();
