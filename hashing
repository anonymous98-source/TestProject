@Slf4j
@Service
@RequiredArgsConstructor
public class AdvShippingBookDataPersistCmsService {

    private final ShipmentAdapter shipmentAdapter;
    private final TrackingResourceWebClientService trackingResourceWebClientService;

    public NewShipmentResourceDto persistShipmentBookDataToTrackingResource(CmsBookResponse cmsBookResponse,
                                                                            ShipmentBookRequest shipmentBookRequest,
                                                                            UserDto userDto,
                                                                            Map<String, String> customerDetails,
                                                                            String shipmentId,
                                                                            UserDefaultsResponse userDefaultsResponse,
                                                                            PremiumFeatureResponse premiumFeatureDetails) {


        log.atInfo().setMessage("Persisting the Shipment book details in ASP DB").log();
        if(cmsBookResponse==null){
            throw new ShippingIntegrationException("CMS Book Response is null");
        }

        NewShipmentDto newShipmentDto = shipmentAdapter.formShipmentDtoWhenCmsForTrackingApi(
                cmsBookResponse, shipmentBookRequest, userDto, customerDetails,shipmentId, userDefaultsResponse, premiumFeatureDetails);

        // set aspectName field (required to call tracking resource)
        newShipmentDto.setAspectName(ModelConstants.SHIPMENT_BOOK_DATA);
        newShipmentDto.setShipmentSource(SHIPMENT_SOURCE_ASP_NAVIGATOR);
        // set masterTrackingNumber field is same as orderTrackingID from cmsBookResponse .As courier currently not supporting multi package shipment.
        // so we are setting masterTrackingNumber same as orderTrackingID from cmsBookResponse.
        newShipmentDto.setMasterTrackingNumber(String.valueOf(cmsBookResponse.getOrderTrackingID()));
        log.atInfo().setMessage("tracking-resource api call to persist cms shipment data.").log();
        Mono<NewShipmentResourceDto> shipmentResourceDtoMono = trackingResourceWebClientService.trackingResourceRequest(
                "/tracking/entities",  HttpMethod.POST,  new HashMap<>(), newShipmentDto,
                NewShipmentResourceDto.class, "shipmentBook");

        NewShipmentResourceDto newShipmentResourceDto = shipmentResourceDtoMono.block();
        if (newShipmentResourceDto != null) {
            AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();
            newShipmentResourceDto.getShipmentDto().setSmsNotifications(additionalAccessorial != null &&
                    !CollectionUtils.isEmpty(additionalAccessorial.getSmsNotification())
                    ? additionalAccessorial.getSmsNotification() : Collections.emptyList());
            log.atInfo().setMessage("New shipment details persisted").addKeyValue("shipmentId",
                    newShipmentResourceDto.getShipmentDto().getId().toString()).log();
        }

        log.atInfo().setMessage("Shipment book details has been saved in Tracking Resource DB. ")
                .log();
        return newShipmentResourceDto;


    }


    public void updateOnEpicPublish(boolean onEpicPublish, String shipmentTxId) {
        if (onEpicPublish) {
            try {
                GetShipmentRequest request =
                        GetShipmentRequest.builder()
                                .aspectName(GET_SHIPMENT)
                                .shipmentTransactionId(shipmentTxId)
                                .build();

                Mono<NewShipmentResourceDto> shipmentResourceDtoMono =
                        trackingResourceWebClientService.trackingResourceRequest(
                                TRACKING_ENTITIES,
                                HttpMethod.POST,
                                new HashMap<>(),
                                request,
                                NewShipmentResourceDto.class,
                                GET_SHIPMENT);

                ShipmentResourceDto shipmentDto =
                        Objects.requireNonNull(shipmentResourceDtoMono.block()).getShipmentDto();

                shipmentDto
                        .getPackages()
                        .forEach(
                                packageDto ->
                                        packageDto.getTracking().setTrackingNumberUpdatedOnEpic(LocalDateTime.now()));

                SaveShipmentRequest saveShipmentRequest =
                        SaveShipmentRequest.builder()
                                .shipmentDto(shipmentDto)
                                .aspectName(UPDATE_TRACKING)
                                .build();

                trackingResourceWebClientService
                        .trackingResourceRequest(
                                TRACKING_ENTITIES,
                                HttpMethod.POST,
                                new HashMap<>(),
                                saveShipmentRequest,
                                GenericResponse.class,
                                UPDATE_TRACKING)
                        .block();
            } catch (Exception e) {
                log.error(e.getMessage(), e);
            }
        }
    }

