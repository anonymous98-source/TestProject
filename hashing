        if (CommonUtil.isInvalidUUID(ruleId)) {
            throw new ValidationException("Invalid RuleId");
        }
        validator.validateUserAuthorization(userEmail, facilityId, customerId);
        Optional<RuleDefinition> ruleDefinitionOptional = repository.findByIdAndRuleTypeAndFacilityIdAndCustomerIdAndActive(
                UUID.fromString(ruleId), COMPOUND_RULE, facilityId, customerId, true);
        if (ruleDefinitionOptional.isPresent()) {
            RuleDefinition ruleDefinition = ruleDefinitionOptional.get();
            ruleDefinition.setActive(false);
            repository.save(ruleDefinition);
            return SuccessResponse.builder()
                    .status(SUCCESS)
                    .message(String.format("Compound rule with ID: %s has been deleted successfully", ruleId))
                    .build();
        } else {
            log.atWarn().setMessage("Compound rule not found for deletion")
                    .addKeyValue("ruleId", ruleId)
                    .log();
            throw new ResourceNotFoundException(
                    "Compound rule not found for deletion");
        }
    }


    private @NonNull CompoundRuleDTO getCompoundRuleResponseDTO(RuleDefinition ruleDefinition) {
        CompoundRuleDTO responseDTO = new CompoundRuleDTO();
        responseDTO.setConditions(new ArrayList<>());
        responseDTO.setId(ruleDefinition.getId());
        responseDTO.setRuleType(ruleDefinition.getRuleType());
        responseDTO.setFacilityId(ruleDefinition.getFacilityId());
        responseDTO.setCustomerId(ruleDefinition.getCustomerId());
        responseDTO.setPriority(ruleDefinition.getPriority());
        responseDTO.setShippingProfileId(ruleDefinition.getShippingProfileId() != null
                ? ruleDefinition.getShippingProfileId().toString() : null);
        for (RuleCondition condition : ruleDefinition.getRuleConditions()) {
            ConditionDTO conditionDTO = ConditionDTO.builder()
                    .id(condition.getId())
                    .operator(condition.getOperator())
                    .value(parseComparisonValue(condition.getFieldName(), condition.getOperator(), condition.getComparisonValue()))
                    .key(condition.getFieldName())
                    .fieldType(condition.getFieldType())
                    .joiningOperator(condition.getLogicalOp())
                    .conditionOrder(condition.getConditionOrder())
                    .build();
            responseDTO.getConditions().add(conditionDTO);
        }
        return responseDTO;
    }

    private Object parseComparisonValue(String key, String operator, String comparisonValue) {
        if (comparisonValue == null) {
            return null;
        }

        if (IS_ONE_OF.name().equalsIgnoreCase(operator) || IS_NOT_ONE_OF.name().equalsIgnoreCase(operator)) {
            String trimmed = comparisonValue.trim();

            if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
                trimmed = trimmed.substring(1, trimmed.length() - 1);
            }

            if (trimmed.isBlank()) {
                return List.of();
            }

            return Arrays.stream(trimmed.split("\\s*,\\s*"))
                    .map(String::trim)
                    .collect(Collectors.toList());
        }
        return mapValueToType(key, comparisonValue);
    }

    private Object mapValueToType(String key, String comparisonValue) {
        Map<String, String> fieldTypeMap = compoundValidationData.getTypeMapping();
        String mappedType = fieldTypeMap.get(key.toLowerCase(Locale.ROOT));

        if (mappedType == null) {
            return String.valueOf(comparisonValue);
        }

        switch (mappedType) {
            case NUMBER_TYPE -> {
                return comparisonValue.contains(".")
                        ? Double.parseDouble(comparisonValue)
                        : Long.parseLong(comparisonValue);
            }
            case BOOLEAN_TYPE -> {
                return Boolean.valueOf(comparisonValue);
            }
            default -> {
                return String.valueOf(comparisonValue);
            }
        }
    }
}

