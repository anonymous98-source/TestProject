  private Map<String, PackageProfileEntity> fetchPackageProfileMapIfNotYourPkg(
      ShipmentBookRequest shipmentBookRequest) {
    List<PackagingDetails> packagingDetailsList = shipmentBookRequest.getPackagingDetails();
    if (CollectionUtils.isEmpty(packagingDetailsList)) {
      throw new ValidationException("Packaging details must be provided");
    }
    return packagingDetailsList.parallelStream()
        .map(
            packagingDetails -> {
              PackageProfileEntity packageProfileEntity =
                  fetchPackageProfileIfNotYourPkg(packagingDetails);
              return Objects.nonNull(packageProfileEntity)
                  ? new AbstractMap.SimpleEntry<>(
                      packagingDetails.getPackaging().getPackagingId(), packageProfileEntity)
                  : null;
            })
        .filter(Objects::nonNull)
        .collect(
            Collectors.toMap(
                Map.Entry::getKey,
                Map.Entry::getValue,
                (existing, replacement) -> replacement)); // duplicate overwrite
  }

  private PackageProfileEntity fetchPackageProfileIfNotYourPkg(PackagingDetails packagingDetails) {
    String packagingType = packagingDetails.getPackaging().getPackagingType();
    PackageType customPackage =
        packageTypeRepository.findByIdAndActiveIsTrue(
            UUID.fromString(packagingDetails.getPackaging().getPackagingId()));
    if (!packagingType.equalsIgnoreCase(PACKAGING_TYPE) && Objects.isNull(customPackage)) {

      // apply check here - if packagingId is null or empty throw exception
      Optional<PackageProfileEntity> packageProfileEntityOptional =
          packageProfileRepository.findById(
              UUID.fromString(packagingDetails.getPackaging().getPackagingId()));

      if (packageProfileEntityOptional.isEmpty()) {
        log.atInfo().setMessage("Package Profile details not found").log();
        throw new ResourceNotFoundException(
            "Package Profile not found for provided packagingId "
                + packagingDetails.getPackaging().getPackagingId());
      }
      return packageProfileEntityOptional.get();
    }
    return null;
  }

  private void setProfileCodeForCarrier(
      ShipmentBookRequest shipmentBookRequest, List<UserDefaultsResponse> userDefaultsResponses) {
    String uspsProfileCode = userDefaultsResponses.get(0).getData().getUspsProfileCode();
    String fedexProfileCode = userDefaultsResponses.get(0).getData().getProfileCode();
    String dhlProfileCode = userDefaultsResponses.get(0).getData().getDhlProfileCode();

    if (USPS.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())) {
      shipmentBookRequest.setProfile(uspsProfileCode);
    } else if (DHL.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())) {
      shipmentBookRequest.setProfile(dhlProfileCode);
    } else {
      shipmentBookRequest.setProfile(fedexProfileCode);
    }
  }

  public void updateOnEpicPublish(boolean onEpicPublish, String shipmentTxId) {
    if (onEpicPublish) {
      try {
        GetShipmentRequest request =
            GetShipmentRequest.builder()
                .aspectName(GET_SHIPMENT)
                .shipmentTransactionId(shipmentTxId)
                .build();

        Mono<NewShipmentResourceDto> shipmentResourceDtoMono =
            trackingResourceWebClientService.trackingResourceRequest(
                "/tracking/entities",
                HttpMethod.POST,
                new HashMap<>(),
                request,
                NewShipmentResourceDto.class,
                GET_SHIPMENT);

        ShipmentResourceDto shipmentDto =
            Objects.requireNonNull(shipmentResourceDtoMono.block()).getShipmentDto();

        shipmentDto
            .getPackages()
            .forEach(
                packageDto ->
                    packageDto.getTracking().setTrackingNumberUpdatedOnEpic(LocalDateTime.now()));

        SaveShipmentRequest saveShipmentRequest =
            SaveShipmentRequest.builder()
                .shipmentDto(shipmentDto)
                .aspectName(UPDATE_TRACKING)
                .build();

        trackingResourceWebClientService
            .trackingResourceRequest(
                "/tracking/entities",
                HttpMethod.POST,
                new HashMap<>(),
                saveShipmentRequest,
                GenericResponse.class,
                "updateTracking")
            .block();
      } catch (Exception e) {
        log.error(e.getMessage(), e);
      }
    }
  }
