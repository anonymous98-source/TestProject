                    }
                }).retrieve()
                .bodyToFlux(responseType)
                .retryWhen(retryConfig.createRetry(3, 2))
                .onErrorMap(throwable -> handleErrorMap(throwable, new Object(), null, method))
                .collectList();
    }

  URI getURI(String endpoint, String aspectName) {
    return new DefaultUriBuilderFactory()
