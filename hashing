import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.SHIP_VIA_RULE_DESCRIPTION;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.SUCCESS;

@Slf4j
@Service
@RequiredArgsConstructor
public class ShipViaRuleService implements ShippingRuleService<ShipViaRuleResponseDto> {

    private final RuleDefinitionRepository ruleDefinitionRepository;
    private final ServiceUtil serviceUtil;

    /**
     * save/update shipping rules of type "SHIP_VIA_RULE" for a given facility
     *
     * @param shippingRuleRequestDto request body containing details of the shipping rules to be saved or updated
     * @return a ShippingRuleResponseDto indicating the result of the save/update operation
     */
    @Override
    public ShippingRuleResponseDto saveOrUpdateShippingRules(ShippingRuleRequestDto shippingRuleRequestDto) {
        if (!(shippingRuleRequestDto instanceof ShipViaRuleRequestDto shipViaRuleRequestDto)) {
            throw new IllegalArgumentException(INVALID_SHIP_VIA_REQUEST_DTO);
        }

        validateUUID(shipViaRuleRequestDto);
        if (shipViaRuleRequestDto.getShippingProfileId() != null) {
            serviceUtil.isShippingProfileExists(shipViaRuleRequestDto.getShippingProfileId(), shipViaRuleRequestDto.getFacilityId());
        }
        List<RuleDefinition> rulesToSaveOrUpdate = new ArrayList<>();
        // Normalize shipViaCodes to uppercase and remove duplicates (case-insensitive)
        List<String> shipViaCodes = shipViaRuleRequestDto.getShipViaCodes().stream()
                .map(String::toUpperCase)
                .distinct()
                .toList();
        List<RuleDefinition> existingRules = ruleDefinitionRepository.findAllByRuleTypeAndFacilityIdAndValueInAndActiveTrue(
                RuleType.SHIP_VIA.toString(), shipViaRuleRequestDto.getFacilityId(), shipViaCodes);

        // Mapping existing rules by their value
        Map<String, RuleDefinition> existingRuleMap = new HashMap<>();
        for (RuleDefinition rule : existingRules) {
            existingRuleMap.put(rule.getValue(), rule);
        }

        for (String shipViaCode : shipViaCodes) {
            RuleDefinition existingRule = existingRuleMap.get(shipViaCode);
            if (existingRule != null) {
                log.atInfo().setMessage("updating the existing shipVia Rule: " + shipViaCode).log();
                existingRule.setShippingProfileId(shipViaRuleRequestDto.getShippingProfileId() != null ?
                        UUID.fromString(shipViaRuleRequestDto.getShippingProfileId()) : null);
                rulesToSaveOrUpdate.add(existingRule);
            } else {
                log.atInfo().setMessage("creating new shipVia Rule: " + shipViaCode).log();
                RuleDefinition ruleDefinition = RuleDefinition.builder()
                        .facilityId(shipViaRuleRequestDto.getFacilityId())
                        .customerId(shipViaRuleRequestDto.getCustomerId())
                        .ruleType(RuleType.SHIP_VIA.toString())
                        .value(shipViaCode)
                        .ruleEvalMethod(RuleEvalMethod.VALUE.getMethod())
                        .shippingProfileId(shipViaRuleRequestDto.getShippingProfileId() != null ?
                                UUID.fromString(shipViaRuleRequestDto.getShippingProfileId()) : null)
                        .active(true)
                        .source(NAVIGATOR)
                        .build();
                rulesToSaveOrUpdate.add(ruleDefinition);
            }
        }

        ruleDefinitionRepository.saveAll(rulesToSaveOrUpdate);

        return RulesGenericResponse.builder()
                .status(SUCCESS)
                .message(SAVE_UPDATE_MESSAGE)
                .build();
    }

    /**
     * Fetches shipping rules of type "SHIP_VIA_RULE" for a given facility, with optional search and pagination.
     *
     * @param facilityId the unique identifier of the facility for which to fetch shipping rules
     * @param customerId
     * @param search     an optional search string to filter the shipping rules
     * @param pageable   pagination information including page number and size
     * @return a ShippingRuleResult containing a page of ShipViaRuleResponseDto objects
     */
    @Override
    public ShippingRuleResult<ShipViaRuleResponseDto> fetchShippingRules(String facilityId, String customerId, String search, Pageable pageable) {

        if(CommonUtil.isInvalidUUID(facilityId)) {
            throw new ValidationException("Invalid Facility Id");
        }

        Page<ShipViaRuleProjection> responsePage;

        try {
            if (search != null && !search.isBlank()) {
                // Perform search based retrieval
                log.atInfo().setMessage("searching shipViaRules with search term: " + search).log();
                responsePage = ruleDefinitionRepository
                        .searchShipViaRules(RuleType.SHIP_VIA.toString(), facilityId, search, pageable);
            } else {
                // Standard retrieval without search
                log.atInfo().setMessage("fetching shipViaRules").log();
                responsePage = ruleDefinitionRepository
                        .findAllByRuleTypeAndFacilityIdAndActiveTrueOrderByValueAsc(
                                RuleType.SHIP_VIA.toString(),
                                facilityId,
                                ShipViaRuleProjection.class,
                                pageable);
            }
        } catch (Exception ex) {
            throw new InternalServerException(ERROR_OCCURRED_WHILE + " fetching shipping rules.",ex);
        }
        Page<ShipViaRuleResponseDto> dtoPage = mapToDto(responsePage);

        return new ShippingRuleResult<>(dtoPage);
    }

    /**
     * Deletes a ship via shipping rule based on the provided rule ID after validating the rule type and existence.
     *
     * @param ruleType the type of the rule to be deleted; must be "SHIP_VIA_RULE"
     * @param ruleId   the unique identifier of the rule to be deleted
     * @return a response DTO indicating the result of the deletion operation
     * @throws ValidationException if the provided rule type is invalid or if the rule ID format is incorrect
     */
    @Override
    @Transactional
    public RulesGenericResponse deleteShippingRules(String ruleType, String ruleId) {
        if (!SHIP_VIA_RULE.equalsIgnoreCase(ruleType)) {
            throw new ValidationException(String.format("Provided rule type: %s is invalid for %s deletion for id: %s",
                    ruleType, ShippingRuleConstants.SHIP_VIA_RULE_DESCRIPTION, ruleId));
        }

        UUID shipViaRuleUUID = CommonUtil.getUUIDFromStringIfValid(ruleId); // Validate ship via ruleId format
        boolean shipViaRuleExists = ruleDefinitionRepository.existsByRuleTypeAndId(RuleType.SHIP_VIA.toString(), shipViaRuleUUID); // Check existence

        if (!shipViaRuleExists) { // If ship via rule does not exist, return NOT_FOUND response
            return RulesGenericResponse.builder()
                    .status(FAILURE)
                    .message(SHIP_VIA_RULE_DESCRIPTION.concat(NOT_FOUND).concat(ruleId))
                    .build();
        }

        ruleDefinitionRepository.deleteById(shipViaRuleUUID);
        return RulesGenericResponse.builder()
                .status(SUCCESS)
                .message(SHIP_VIA_RULE_DESCRIPTION.concat(RULE_DELETION_SUCCESSFUL))
                .build();
    }

    /**
     * Private helper methods starts here
     */

    private void validateUUID(ShipViaRuleRequestDto shipViaRuleRequestDto) {
        if (CommonUtil.isInvalidUUID(shipViaRuleRequestDto.getFacilityId())) {
            throw new ValidationException("Invalid Facility Id UUID");
        }
        if (CommonUtil.isInvalidUUID(shipViaRuleRequestDto.getCustomerId())) {
            throw new ValidationException("Invalid Customer Id UUID");
        }
        if (shipViaRuleRequestDto.getShippingProfileId() != null && CommonUtil.isInvalidUUID(shipViaRuleRequestDto.getShippingProfileId())) {
            throw new ValidationException("Invalid Shipping Profile Id UUID");
        }
    }

    private Page<ShipViaRuleResponseDto> mapToDto(Page<ShipViaRuleProjection> projectionPage) {
        return projectionPage.map(projection ->
                ShipViaRuleResponseDto.builder()
                        .id(projection.getId())
                        .facilityId(projection.getFacilityId())
                        .customerId(projection.getCustomerId())
                        .ruleName(projection.getName())
                        .shipViaCode(projection.getValue())
                        .shippingProfileId(projection.getShippingProfileId() != null ? projection.getShippingProfileId().toString() : null)
                        .build()
        );
    }
