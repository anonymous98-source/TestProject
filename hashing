  private void setMultiPackagesToShipment(
      ShipmentBookResponseDto shipmentBookResponseDto,
      ShipmentBookRequest shipmentBookRequest,
      NewShipmentDto shipment,
      String epicSkipReason) {

    List<ShippingUnitResponseDto> shippingUnitRespDtos = shipmentBookResponseDto.getShippingUnits();
    List<PackagingDetails> packagingDetailsList = shipmentBookRequest.getPackagingDetails();

    List<ShipmentPackageDto> packageList =
        IntStream.range(0, shippingUnitRespDtos.size())
            .mapToObj(
                index ->
                    buildPackage(
                        shippingUnitRespDtos.get(index),
                        packagingDetailsList.get(index),
                        shipmentBookRequest,
                        shipmentBookResponseDto,
                        index,
                        epicSkipReason))
            .toList();
    if (isReturn(shipmentBookRequest, shipmentBookResponseDto)) {
      packageList.get(0).setPackageNickName(packageList.get(0).getPackageNickName() + RETURN);
    }
    shipment.setShipmentPackageDtos(packageList);
  }

  private boolean isReturn(
      ShipmentBookRequest shipmentBookRequest, ShipmentBookResponseDto shipmentBookResponseDto) {
    String returnType = shipmentBookRequest.getGenerateLabelReturnType();
    return StringUtils.isNotBlank(returnType)
        && (returnType.equalsIgnoreCase(STANDALONE) || returnType.equalsIgnoreCase(FORWARD))
        && shipmentBookResponseDto.getResult().getActionType().equalsIgnoreCase(RETURN_VALUE);
  }

  private ShipmentPackageDto buildPackage(
      ShippingUnitResponseDto shippingUnitResponseDto,
      PackagingDetails packagingDetails,
      ShipmentBookRequest shipmentBookRequest,
      ShipmentBookResponseDto shipmentBookResponseDto,
      int index,
      String epicSkipReason) {

    Packaging requestedPackaging =
        shipmentBookRequest.getPackagingDetails().get(index).getPackaging();
    boolean isYourPackaging =
        requestedPackaging.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE);
    Reference reference =
        Objects.nonNull(packagingDetails.getReference())
            ? packagingDetails.getReference()
            : new Reference();


    ShipmentPackageDto shipmentPackageDto =
        ShipmentPackageDto.builder()
            .packageName(packagingDetails.getPackaging().getPackagingType())
            .packageProfileId(
                getUuidFromString(
                    packagingDetails
                        .getPackaging()
                        .getPackagingId())) // check if packagingId is PackageProfileId or not
            .packageLength(
                (isYourPackaging
                    ? requestedPackaging.getLength()
                    : shippingUnitResponseDto.getLength()))
            .packageWidth(
                isYourPackaging
                    ? requestedPackaging.getWidth()
                    : shippingUnitResponseDto.getWidth())
            .packageHeight(
                (isYourPackaging
                    ? requestedPackaging.getHeight()
                    : shippingUnitResponseDto.getHeight()))
            .packageWeight(shippingUnitResponseDto.getWeight())
            .packageDimUnit(shippingUnitResponseDto.getDimensionUOM())
            .packageWeightUnit(shippingUnitResponseDto.getWeightUOM())
            .packageDryIceWeight(isDryIcePresent(packagingDetails))
            .packageLabelReference1(reference.getReference1())
            .packageLabelReference2(reference.getReference2())
            .packageLabelReference3(reference.getReference3())
            .packageLabelReference4(reference.getReference4())
            .internalDesignationReference(reference.getInternalDesignationReference())
            .specialInstructions(
                Objects.nonNull(shipmentBookRequest.getAdditionalAccessorial())
                    ? shipmentBookRequest.getAdditionalAccessorial().getSpecialInstructions()
                    : null)
            .pharmacyOrderNumber(reference.getPharmacyOrderNumber())
            .packageNickName(packagingDetails.getPackaging().getPackageNickname())
            // PackageProfile Details
            .isCustomPackage(packagingDetails.getPackaging().isCustomPackage())
            .innerLength(packagingDetails.getPackaging().getInnerLength())
            .innerWidth(packagingDetails.getPackaging().getInnerWidth())
            .innerHeight(packagingDetails.getPackaging().getInnerHeight())
            .ratedLength(packagingDetails.getPackaging().getRatedLength())
            .packagePackagingType(packagingDetails.getPackaging().getPackagePackagingType())
            .packageBrand(packagingDetails.getPackaging().getPackageBrand())
            .packageProductName(packagingDetails.getPackaging().getPackageProductName())
            .packageDescription(packagingDetails.getPackaging().getPackageDescription())
            .packageModelIdentifier(packagingDetails.getPackaging().getPackageModelIdentifier())
            .build();

    // set additional package details into package
    shipmentPackageDto.setPackageAdditionalDetails(
        buildAdditionalServicePackage(packagingDetails, shipmentBookRequest, false));

    // set external reference into package
    PackageExternalReferenceDto packageExternalReferenceDto =
        getPackageExternalReference(
            packagingDetails.getReference(), shipmentBookRequest.getPatientInformation());
    shipmentPackageDto.setPackageExternalReferenceDto(packageExternalReferenceDto);

    // set FillDto to package
    if (Objects.nonNull(packagingDetails.getReference())) {
      shipmentPackageDto.setFills(getFillDtoForPackage(packagingDetails.getReference()));
    }

    // set tracking details into package
    ShipmentPackageTracking shipmentPackageTracking =
        buildShipmentPackageTracking(
            shippingUnitResponseDto, shipmentBookRequest, shipmentBookResponseDto, epicSkipReason);

    shipmentPackageDto.setShipmentPackageTracking(shipmentPackageTracking);
    return shipmentPackageDto;
  }

  ShipmentPackageTracking buildShipmentPackageTracking(
      ShippingUnitResponseDto shippingUnitResponseDto,
      ShipmentBookRequest shipmentBookRequest,
      ShipmentBookResponseDto shipmentBookResponseDto,
      String epicSkipReason) {
    var lastUpdatedAt = LocalDateTime.now(ZoneOffset.UTC);
    String zipCode =
        shipmentBookRequest.getShipToAddress().getAddressData().getAddress().getZipCode();
    zipCode = zoneDataLoader.getZipCode(zipCode);
    ShipmentPackageTracking shipmentPackageTracking =
        ShipmentPackageTracking.builder()
            .trackingNumber(getTrackingNUmber(shippingUnitResponseDto))
            .labelType(shipmentBookRequest.getLabelType())
            .labelContent(
                getLabelContent(
                    shippingUnitResponseDto, shipmentBookResponseDto, shipmentBookRequest))
            .shipDate(
                getLocalDateTimeFromIsoDateTime(
                    shipmentBookResponseDto.getShipmentSummary().getPickupDate()))
            .expectedDeliveryDate(
                buildLocalDateTimeFromTimeZone(
                    getLocalDateTimeFromIsoDateTime(
                        shipmentBookResponseDto.getShipmentSummary().getDeliverByDate()),
                    zoneDataLoader.getTimeZone(zipCode)))
            .trackingUrl(
                getTrackingUrl(
                    shipmentBookRequest.getShippingProfile(),
                    getTrackingNUmber(shippingUnitResponseDto)))
            .trackingLastScanLocation(getLastScanLocation(shipmentBookRequest))
            .trackingDataSource(TRACKING_DATA_SOURCE_FEDEX_USPS)
            .applicationSource(APPLICATION_SOURCE_NAVIGATOR)
            .trackingLastUpdatedAt(lastUpdatedAt)
            .trackingLastStatus(TrackingStatusCode.LABEL_CREATED.getStatus())
            .trackingLastMessage(LABEL_GENERATED)
            .epicSkipReason(epicSkipReason)
            .build();

    // add tracking events in tracking
    shipmentPackageTracking.setShipmentTrackingEventDtoList(
        getShipmentTrackingEventList(lastUpdatedAt, shipmentBookRequest, false, null));

    // add notification details in tracking
    shipmentPackageTracking.setNotifications(
        advShippingCommonDataPersistService.buildNotifications(shipmentBookRequest));
    return shipmentPackageTracking;
  }

