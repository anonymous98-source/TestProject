                .exchangeToMono(response -> {
                    if (response.statusCode().is2xxSuccessful()) {
                        return response.bodyToMono(CarrierRegisterResponse.class)
                                .map(carrierRegisterResponse -> CarrierRegisterResult.builder().success(carrierRegisterResponse).build());
                    } else if (response.statusCode().is4xxClientError()) {
                        return response.bodyToMono(SendFlexErrorResponse.class)
