  private void validateIntervention(
      ShipmentBookRequest shipmentBookRequest, PremiumFeatureResponse premiumFeatureResponse) {
    String intervention = shipmentBookRequest.getAdditionalAccessorial().getInterventionService();
    String carrier = shipmentBookRequest.getShippingProfile().toLowerCase();
    shippingProfileServiceImpl.validateInterventionService(
        intervention, carrier, premiumFeatureResponse);
