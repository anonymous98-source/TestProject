  @Test
  void validateAddress_success() throws JsonProcessingException {

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(userConfigResponseDTO);

    sendFlexRecordDto = SendFlexRecordDto.builder().apiCode("shipment/book").build();

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenReturn(sendFlexRecordDto);

    when(sendFlexWebClientService.sendFlexRequest(anyString(), any(), anyMap(), any(), eq(AddressValidationResponseDTO.class))).thenReturn(Mono.just(responseDTO));

    AddressValidationResponseDTO result = addressValidationService.validateAddress(validRequest);

    assertEquals(responseDTO, result);

    verify(sendFlexRecordUtil).saveSendflexRecord(any(SendFlexRecordDto.class));
  }

