public class ShipmentDetailsServiceImpl implements ShipmentDetailsService {


    private final OCMWebClientService ocmWebClientService;
    private final TrackingResourceWebClientService trackingResourceWebClientService;
    private final ObjectMapper objectMapper;

    /**
     * Fetches shipment details and adds access level information based on the billing group ID.
     * Response JsonNode can be deserialized into ShipmentDto.
     *
     * @param shipmentId The ID of the shipment to fetch.
     * @return A JsonNode containing the shipment details along with access level information.
     * @throws ResourceNotFoundException if shipment details or billing group ID are not found.
     */
    @Override
    public JsonNode getShipment(String shipmentId) {
        log.atInfo().setMessage("Fetching shipment details")
                .log();
        var shipmentDetails = fetchShipmentDetails(shipmentId);
        var billingGroupId = extractBillingGroupId(shipmentDetails);

        log.atInfo().setMessage("Fetching premium access levels")
                .log();
        var premiumAccessLevel = ocmWebClientService.fetchPremiumFeature(
                BillingGroupListDto.builder().billingGroupIds(List.of(billingGroupId)).build()
        );

        // Add access level info to shipment details
        var accessLevelNode = buildAccessLevelNode(premiumAccessLevel);
        ((ObjectNode) shipmentDetails).set(ServiceCommonConstants.ACCESS_LEVEL, accessLevelNode);
        return shipmentDetails;
    }

    private JsonNode fetchShipmentDetails(String shipmentId) {
        var requestPath = ServiceCommonConstants.SHIPMENT_DETAILS_URI
                .replace(ServiceCommonConstants.SHIPMENT_ID_PLACEHOLDER, shipmentId);
        var response = trackingResourceWebClientService
                .trackingResourceRequest(requestPath, HttpMethod.GET, Map.of(), null, JsonNode.class, "")
                .block();
        if (response == null) {
            throw new ResourceNotFoundException("Failed to fetch shipment details");
        }
        return response;
    }

    private String extractBillingGroupId(JsonNode shipmentDetails) {
        var billingGroupIdNode = shipmentDetails.get(ServiceCommonConstants.BILLING_GROUP_ID);
        if (billingGroupIdNode == null) {
            throw new ResourceNotFoundException("Billing Group Id not found for the shipment");
        }
        return billingGroupIdNode.asText();
    }

    private ObjectNode buildAccessLevelNode(PremiumFeatureResponse premiumFeatureResponse) {
        log.atInfo().setMessage("Setting access levels").log();
        var accessLevel = AccessLevel.builder()
                .navigatorLevel(getNavigatorLevel(premiumFeatureResponse))
                .beaconLevel(getBeaconLevel(premiumFeatureResponse))
                .build();
        return objectMapper.valueToTree(accessLevel);
    }

    private String getNavigatorLevel(PremiumFeatureResponse premiumFeatureResponse) {
        if (Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorNone())) {
            return ServiceCommonConstants.NONE;
        } else if (Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorPlus())) {
            return ServiceCommonConstants.NAVIGATOR_PLUS;
        } else {
            return ServiceCommonConstants.NAVIGATOR;
        }
    }

    private String getBeaconLevel(PremiumFeatureResponse premiumFeatureResponse) {
        return Boolean.TRUE.equals(premiumFeatureResponse.getBeaconPlus()) ?
                ServiceCommonConstants.BEACON_PLUS : ServiceCommonConstants.BEACON;
    }
}

