    @Override
    public MultiPackageShipmentBookResponse bookShipmentGenerateLabel(ShipmentBookRequest shipmentBookRequest,
                                                                      PremiumFeatureResponse premiumFeatureDetails,
                                                                      OflUserPrincipal oflUserPrincipal,
                                                                      HttpHeaders httpHeaders,
                                                                      String requestId) {
        try {
            log.atInfo().setMessage("Request to book shipment came for CMS").log();
            if (shipmentBookRequest.getScheduleId() == null)
                throw new ValidationException("Schedule ID must be present for shipping profile "+shipmentBookRequest.getShippingProfile());
            dataValidation(shipmentBookRequest);
            validateDryIceWeight(shipmentBookRequest);
            // Validate notification details if any are present in the request
            NotificationGeneralizationUtils.validateSubscribedNotificationDetails(shipmentBookRequest);

            String serviceType = shipmentBookRequest.getShipViaOptions().get(0).getCode();
            if (ServiceType.SAMEDAYSTATE.name().equalsIgnoreCase(serviceType) && shipmentBookRequest.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE)) {
                getOndemandShippingServiceOption(shipmentBookRequest);
