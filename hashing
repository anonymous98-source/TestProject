    private boolean checkAndFillHcidDetails(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap, boolean containsHcid) {
        if (packagingDetails.getPackaging().getHcidCode() != null &&
                !packagingDetails.getPackaging().getHcidCode().isEmpty()) {

          for (HCIDCode hcidCode : packagingDetails.getPackaging().getHcidCode()) {
            String apivalue = HcidService.getApiValue(hcidCode.getCode());
            if (apivalue != null && !apivalue.isEmpty()) {
              carrierAddOnsMap.put(apivalue, null);
              containsHcid = true;
            }
          }
        }
        return containsHcid;
    }

    private void setCarrierAddOnMap(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap) {
        if (packagingDetails.getAccessorials() != null && packagingDetails.getAccessorials().getContainsDryIce()) {
          CarrierAddOnsDTO dryIceCarrierAddOn = CarrierAddOnsDTO.builder()
                  .key("DryIceWeight")
                  .value(String.valueOf(packagingDetails.getAccessorials().getWeight())).build();
          carrierAddOnsMap.put("DryIce", List.of(dryIceCarrierAddOn));
