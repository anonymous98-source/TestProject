package com.cardinalhealth.adv.shipping.integration.api.utils;

import com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddress;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddressFacilityMapping;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddressFavorite;
import com.cardinalhealth.adv.shipping.integration.api.model.addressbook.AddressBookRequest;
import com.cardinalhealth.adv.shipping.integration.api.model.addressbook.ShipToAddressResponseDto;
import lombok.extern.slf4j.Slf4j;

import javax.annotation.Nullable;
import java.util.UUID;

@Slf4j
public class AddressMappingUtils {

    private AddressMappingUtils() {
    }

    /**
     * Maps the {@link AddressBookRequest} to a {@link ShipToAddressFacilityMapping} entity, either by
     * creating a new mapping or updating an existing one based on the presence of an existing address.
     *
     * @param request         the address book request containing the details to map to the entity
     * @param existingAddress the existing {@link ShipToAddressFacilityMapping} entity to update,
     *                        or null to create a new mapping
     * @return the mapped or updated {@link ShipToAddressFacilityMapping} entity
     */
    public static ShipToAddressFacilityMapping mapRequestToShipToAddressFacilityMappingEntity(
            final AddressBookRequest request, final ShipToAddressFacilityMapping existingAddress) {

        ShipToAddress shipToAddress = ShipToAddress.builder()
                .company(request.getCompany())
                .addressName(request.getRecipientName())
                .addressLine1(request.getAddresses().get(0))
                .addressLine2((request.getAddresses().size() > 1 && request.getAddresses().get(1) != null)
                        ? request.getAddresses().get(1) : null)
                .addressLine3((request.getAddresses().size() > 2 && request.getAddresses().get(2) != null)
                        ? request.getAddresses().get(2) : null)
                .zipCode(request.getZipCode())
                .city(request.getCity())
                .state(request.getState())
                .country(request.getCountry())
                .phoneNumber(request.getPhone())
                .email(request.getEmail())
                .deliveryNotes(request.getDeliveryNotes())
                .addressType(request.isResidential()
                        ? AddressBookConstants.ADDRESS_TYPE_RESIDENTIAL
                        : AddressBookConstants.ADDRESS_TYPE_REGULAR)
                .extension(request.getExtension())
                .isResidentialAddress(request.isResidential())
                // If it's an update request then take the previous ID else create new ID for ShipToAddress
                .id(existingAddress != null ? existingAddress.getShipToAddress().getId() : null)
                .build();

        if (existingAddress != null) { // Update the existing Address
            existingAddress.setShipToAddress(shipToAddress);
            existingAddress.setMonarchShipFromFacilityId(request.getFacilityId());
            return existingAddress;
        } else { // Create new address
            return ShipToAddressFacilityMapping.builder()
                    .shipToAddress(shipToAddress)
                    .monarchShipFromFacilityId(request.getFacilityId())
                    .build();
        }
    }

    /**
     * Map the address details from ShipToAddressFacilityMapping entity to DTOs to be sent back as response
     *
     * @param shipToAddressFavorite ShipToAddressFacilityMapping entity
     * @param mappingOperationType  Mapping operation type (Favourite Address / All address)
     * @param userId                User ID for which this mapping is being done -> optional
     * @return ShipToAddressResponseDto object after mapping all the fields
     */
    public static ShipToAddressResponseDto mapAddressDetailsToResponseDto(
            ShipToAddressFavorite shipToAddressFavorite, String mappingOperationType, @Nullable UUID userId) {
        if (shipToAddressFavorite == null) {
            log.atWarn().setMessage("Inside 'mapAddressDetailsToResponseDto' method of AddressMappingUtils"
                    + " and sent ShipToAddressFavorite is null, so returning null from this method")
                    .log();
            return null;
        }

        if (shipToAddressFavorite.getShipToAddressFacilityMapping() == null
                || shipToAddressFavorite.getShipToAddressFacilityMapping().getShipToAddress() == null) {
            log.atWarn().setMessage("Either Sent ShipToAddressFavorite does not have any associated "
                    + "ShipToAddressFacilityMapping or associated ShipToAddressFacilityMapping does not have "
                    + "ShipToAddress, so returning null from this method")
                    .log();
            return null;
        }

        // Extract the ShiToAddress mapped to the corresponding FacilityMapping
        ShipToAddressFacilityMapping addressFacilityMapping = shipToAddressFavorite.getShipToAddressFacilityMapping();
        ShipToAddress shipToAddress = addressFacilityMapping.getShipToAddress();

        // Construct ShipToAddressResponseDto based on ShipToAddress & FacilityMappingAddress
        return ShipToAddressResponseDto.builder()
                .shipToAddressId(shipToAddress.getId())
                .company(shipToAddress.getCompany())
                .recipientName(shipToAddress.getAddressName())
                .addressLine1(shipToAddress.getAddressLine1())
                .addressLine2(shipToAddress.getAddressLine2())
                .addressLine3(shipToAddress.getAddressLine3())
                .zipCode(shipToAddress.getZipCode())
                .city(shipToAddress.getCity())
                .state(shipToAddress.getState())
                .country(shipToAddress.getCountry())
                .phone(shipToAddress.getPhoneNumber())
                .email(shipToAddress.getEmail())
                .deliveryNotes(shipToAddress.getDeliveryNotes())
                .addressType(shipToAddress.getAddressType())
                .extension(shipToAddress.getExtension())
                .isResidentialAddress(shipToAddress.isResidentialAddress())
                .isFavorite(
                        AddressBookConstants.MAPPING_OPERATION_TYPE_FAVOURITE_ADDRESS_VIEW
                                .equalsIgnoreCase(mappingOperationType)
                                ? Boolean.TRUE
                                : checkIfAddressMarkedFavouriteByUser(addressFacilityMapping, userId)
                )
                .facilityId(addressFacilityMapping.getMonarchShipFromFacilityId())
                .id(addressFacilityMapping.getId())
                .shipToAddressFavouriteId(shipToAddressFavorite.getId())
                .build();
    }

    /**
     * Check if Address marked as favourite by User
     *
     * @param shipToAddressFacilityMapping Facility mapping entity
     * @param userId                       User ID who may have marked this address as favourite
     * @return True if it is marked favourite by user else false
     */
    public static boolean checkIfAddressMarkedFavouriteByUser(
            ShipToAddressFacilityMapping shipToAddressFacilityMapping, UUID userId) {
        if (userId == null) {
            return false;
        }

        if (shipToAddressFacilityMapping.getShipToAddressFavorite() == null
                || shipToAddressFacilityMapping.getShipToAddressFavorite().isEmpty()) {
            return false;
        }

        return shipToAddressFacilityMapping.getShipToAddressFavorite()
                .stream()
                .filter(favorite -> favorite.getUser().getId().equals(userId))
                .map(ShipToAddressFavorite::getId)
                .toList()
                .contains(shipToAddressFacilityMapping.getId());
    }

}

