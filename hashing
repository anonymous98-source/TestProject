    @Override
    public VoidShipmentResponse voidForwardAndReturn(VoidShipmentRequest request, String userEmail, OflUserPrincipal oflUserPrincipal) {
        NewShipmentResourceDto shipment= getShipment(request);

        VoidShipmentResponse forwardShipmentResponse = voidShipment(shipment, userEmail, oflUserPrincipal);

        List<VoidShipmentTrackingDetails> trackingDetails =
                new ArrayList<>(forwardShipmentResponse.getTrackingDetails());

        NewShipmentResourceDto returnshipment= getShipmentByParent(request);
        if(returnshipment!=null) {
            VoidShipmentResponse returnShipmentResponse = voidShipment(returnshipment, userEmail, oflUserPrincipal);
            trackingDetails.addAll(returnShipmentResponse.getTrackingDetails());
        }

        boolean allFailed =
                trackingDetails.stream().allMatch(details -> VOID_FAIL.equals(details.getStatus()));
        String overallStatusCode = allFailed ? VOID_FAIL : VOID_SUCCESS;

        log.atInfo()
                .addKeyValue("overallStatusCode", overallStatusCode)
                .setMessage("Processed void forward and return shipment")
                .log();

        return VoidShipmentResponse.builder()
                .statusCode(overallStatusCode)
                .trackingDetails(trackingDetails)
                .build();
    }

    VoidShipmentResponse voidShipment(NewShipmentResourceDto shipment, String userEmail, OflUserPrincipal oflUserPrincipal) {
        if(shipment == null){
            throw new ValidationException("Shipment not found.");
        }
        VoidShipmentResponse voidShipmentResponse;
        latestTrackingEvent(shipment);

        List<ShipmentDetailsDTO>  shipmentDetailsDTO= new ArrayList<>();
        shipment.getShipmentDto().getPackages().forEach(packageDTO ->
            packageDTO.getTracking().getTrackingEvents().forEach(trackingEvent -> {
                ShipmentDetailsDTO dto = ShipmentDetailsDTO.builder()
                        .trackingNumber(packageDTO.getTracking().getTrackingNumberUniqueId())
                        .scanLocation(packageDTO.getTracking().getTrackingLastScanLocation())
                        .returnType(shipment.getShipmentDto().getReturnType())
                        .trackingStatus(trackingEvent.getTrackingStatus())
                        .createdBy(shipment.getShipmentDto().getCreatedBy())
                        .build();
                shipmentDetailsDTO.add(dto);
            })
        );

        if (!validForVoid(shipment, userEmail, oflUserPrincipal)) {
             return voidShipmentDtoCreationUtil.createVoidShipmentResponse(VOID_FAIL, shipmentDetailsDTO);
        }

        VoidShipmentRequestDTO voidShipmentRequestDTO =VoidShipmentRequestDTO.builder().id(shipment.getShipmentDto().getShipmentTransactionId()).build();

        VoidShipmentResponseDTO voidShipmentResponseDTO = null;
        // if condition to check carrier, if carrier is courier ignore calling sendflex API and just update the tracking resource with void status

        String carrier = shipment.getShipmentDto().getShipmentCarrierDetails();
        if (!"courier".equalsIgnoreCase(carrier)) {

            try {
                voidShipmentResponseDTO =sendToVoidShipment(voidShipmentRequestDTO);

                sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
                        voidShipmentRequestDTO,
                        voidShipmentResponseDTO,
                        voidShipmentRequestDTO.getId(),
                        VOID
                );

            } catch (Exception e) {
                log.error("Error occurred while cancelling shipment");

                sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
                        voidShipmentRequestDTO,
                        voidShipmentRequestDTO.getId(),
                        VOID,
                        e
                );
                throw e;
            }

            if (voidShipmentResponseDTO == null) {
                throw new ResourceNotFoundException("SendFlex returned null");
            }
        }
        else{

            voidShipmentResponseDTO = VoidShipmentResponseDTO.builder()
                    .result(ResultDTO.builder()
                            .actionType(VOID)
                            .build())
                    .build();
        }

        VoidShipmentResponseDTO finalVoidShipmentResponseDTO = voidShipmentResponseDTO;


        shipment.getShipmentDto().getPackages().forEach(packageDTO -> {
            TrackingResourceDto tracking = packageDTO.getTracking();

            if (tracking != null) {
                tracking.setExpectedDeliveryDate(null);

                tracking.setTrackingLastUpdatedAt(LocalDateTime.now());
                tracking.setTrackingLastStatus(VOID);
                tracking.setTrackingLastMessage(VOID);

                List<TrackingEventResourceDto> eventResourceDtos = new ArrayList<>(tracking.getTrackingEvents());

                eventResourceDtos.add(
                        TrackingEventResourceDto.builder()
                                .trackingEventType(finalVoidShipmentResponseDTO.getResult().getActionType())
                                .trackingStatus(VOID)
                                .trackingEventMessage(VOID)
                                .trackingEventStatusUpdatedAt(LocalDateTime.now())
                                .build()
                );
                tracking.setTrackingEvents(eventResourceDtos);
            }
        });

        SaveShipmentRequest saveShipmentRequest= SaveShipmentRequest.builder()
                .shipmentDto(shipment.getShipmentDto())
                .aspectName(ModelConstants.SAVE_SHIPMENT).build();


        GenericResponse response = trackingResourceWebClientService.trackingResourceRequest(
                TRACKING_ENTITIES,
                HttpMethod.POST,
                new HashMap<>(),
                saveShipmentRequest,
                GenericResponse.class,
                ModelConstants.SAVE_SHIPMENT).block();

        if (response != null) {

            log.atInfo().setMessage("New shipment resource details persisted").log();
        }


        voidShipmentResponse =
                voidShipmentDtoCreationUtil.createVoidShipmentResponse(VOID_SUCCESS, shipmentDetailsDTO);
        return voidShipmentResponse;

    }
    NewShipmentResourceDto getShipment(VoidShipmentRequest request) {

        GetShipmentRequest getShipmentRequest = GetShipmentRequest.builder()
                .aspectName("getShipment")
                .shipmentTransactionId(request.getShipmentTransactionId())
                .build();

         return trackingResourceWebClientService.trackingResourceRequest(
                 TRACKING_ENTITIES,
                 HttpMethod.POST,
                 new HashMap<>(),
                 getShipmentRequest,
                 NewShipmentResourceDto.class, "getShipment").block();

    }
    NewShipmentResourceDto getShipmentByParent(VoidShipmentRequest request) {

        GetShipmentRequest getShipmentRequest = GetShipmentRequest.builder()
                .aspectName(GET_PARENT_SHIPMENT_ID)
                .shipmentTransactionId(request.getShipmentTransactionId())
                .build();

        NewShipmentResourceDto  newShipmentResourceDto= trackingResourceWebClientService.trackingResourceRequest(
                TRACKING_ENTITIES,
                 HttpMethod.POST,
                new HashMap<>(),
                getShipmentRequest,
                NewShipmentResourceDto.class, GET_PARENT_SHIPMENT_ID).block();

        if(newShipmentResourceDto == null || newShipmentResourceDto.getShipmentDto() == null){
            return null;
        }
        return newShipmentResourceDto;
    }


    public boolean validForVoid(NewShipmentResourceDto newShipmentResourceDto, String userEmail, OflUserPrincipal oflUserPrincipal) {
        boolean isCustomerAdmin = oflUserPrincipal.getUserPermissionList()
                .stream()
                .anyMatch(userPermission ->
                        userPermission.getUserRole().getName().equalsIgnoreCase("ADVSHIP_CUSTOMER_ADMIN"));
        if(newShipmentResourceDto == null
                || newShipmentResourceDto.getShipmentDto() == null
                || newShipmentResourceDto.getShipmentDto().getCreatedBy() == null
                || (!isCustomerAdmin
                && !newShipmentResourceDto.getShipmentDto().getCreatedBy().equalsIgnoreCase(userEmail))) {
            throw new ValidationException("Shipment was created by another user and cannot be canceled.");
        }
        List<PackageResourceDto> filteredPackages = newShipmentResourceDto.getShipmentDto().getPackages();
            for (PackageResourceDto packageResourceDto : filteredPackages) {
                for (TrackingEventResourceDto trackingEvent : packageResourceDto.getTracking().getTrackingEvents()) {

                    if (trackingEvent.getTrackingStatus().isBlank()
                            ||!trackingEvent.getTrackingStatus().equalsIgnoreCase(VOID_LABEL_CREATED)
                            ||!packageResourceDto.getTracking().getTrackingLastStatus().equalsIgnoreCase(LABEL_GENERATED)) {
                        return false;
                    }
                }
            }
            return true;
    }
   public  void latestTrackingEvent(NewShipmentResourceDto  shipment) {
       List<PackageResourceDto> filteredPackages = shipment.getShipmentDto().getPackages().stream()
               .map(pkg -> {
                   TrackingResourceDto tracking = pkg.getTracking();
                   if (tracking != null && tracking.getTrackingEvents() != null) {
                       Optional<TrackingEventResourceDto> latestEvent = tracking.getTrackingEvents().stream()
                               .filter(event -> event.getTrackingStatus() != null && !event.getTrackingStatus().isBlank())
                               .max(Comparator.comparing(TrackingEventResourceDto::getTrackingEventStatusUpdatedAt));

                       latestEvent.ifPresent(event -> {
                           String normalizedStatus = event.getTrackingStatus()
                                   .trim()
                                   .replace(" ", "_")
                                   .toUpperCase();
                           event.setTrackingStatus(normalizedStatus);
                           tracking.setTrackingEvents(List.of(event));
                       });

                       if (latestEvent.isEmpty()) {
                           tracking.setTrackingEvents(List.of());
                       }
                   }
                   return pkg;
               })
               .toList();

       shipment.getShipmentDto().setPackages(filteredPackages);

    }
    public VoidShipmentResponseDTO sendToVoidShipment(VoidShipmentRequestDTO  voidShipmentRequestDTO) {
      return sendFlexWebClientService.sendFlexRequest(
                SHIPMENT_VOID_SUB_URI,
                HttpMethod.POST,
                Map.of(),
                voidShipmentRequestDTO,
                VoidShipmentResponseDTO.class).block();

    }

}

