import java.util.stream.Collectors;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpMethod;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
@RequiredArgsConstructor
@Slf4j
public class HoldAtLocationServiceImpl implements HoldAtLocationService {
  private final SendFlexRecordUtil sendFlexRecordUtil;
  private final SendFlexWebClientService sendFlexWebClientService;
  private final PackageProfileRepository packageProfileRepository;

  @Override
  public HoldAtLocationResponse getHoldAtLocations(HoldAtLocationRequest request) {
    if (!request.getShippingProfile().equalsIgnoreCase(FEDEX)) {
      throw new ValidationException("Shipping profile must be FedEx");
    }
    HoldAtLocationRequestDTO holdAtLocationRequestDTO = prepareRequest(request);
    HoldAtLocationResponseDTO responseDto = callHoldAtLocation(holdAtLocationRequestDTO);
    return prepareResponse(responseDto, request);
  }

  private HoldAtLocationResponse prepareResponse(
      HoldAtLocationResponseDTO responseDto, HoldAtLocationRequest request) {

    List<LocationSuggestion> locationSuggestionList = new ArrayList<>();
    if (CollectionUtils.isNotEmpty(responseDto.getLocationSuggestions())) {
      float maxWeight = getMaxWeight(request);
      List<PackageProfileEntity> packageProfiles = getStandardPackages(request);
      float maxLength = getMaxLength(request, packageProfiles);
      float maxWidth = getMaxWidth(request, packageProfiles);
      float maxHeight = getMaxHeight(request, packageProfiles);
      boolean checkDimensions = maxLength > 0 || maxWidth > 0 || maxHeight > 0;
      validatePackageLimits(
          responseDto,
          maxWeight,
          checkDimensions,
          maxLength,
          maxWidth,
          maxHeight,
          locationSuggestionList);
    }
    return buildResponse(responseDto, locationSuggestionList);
  }

  private static void validatePackageLimits(
      HoldAtLocationResponseDTO responseDto,
      float maxWeight,
      boolean checkDimensions,
      float maxLength,
      float maxWidth,
      float maxHeight,
      List<LocationSuggestion> locationSuggestionList) {
    for (LocationSuggestion locationSuggestion : responseDto.getLocationSuggestions()) {
        if (!validateNotClosed(locationSuggestion))
            continue;
        boolean weightInLimit = true;
        boolean lengthInLimit = true;
        boolean widthInLimit = true;
        boolean heightInLimit = true;
        if (Objects.nonNull(locationSuggestion.getPackageLimits())) {
          weightInLimit = isWeightInLimit(locationSuggestion, weightInLimit, maxWeight);
          if (checkDimensions) {
            lengthInLimit = isLengthInLimit(locationSuggestion, lengthInLimit, maxLength);
            widthInLimit = isWidthInLimit(locationSuggestion, widthInLimit, maxWidth);
            heightInLimit = isHeightInLimit(locationSuggestion, heightInLimit, maxHeight);
          }
        }
        if (weightInLimit && lengthInLimit && widthInLimit && heightInLimit) {
          locationSuggestionList.add(locationSuggestion);
        }
        if (locationSuggestionList.size() == 10) {
          return;
        }
    }
  }

  private static boolean validateNotClosed(LocationSuggestion locationSuggestion) {
    return Optional.ofNullable(locationSuggestion.getOperationalSchedule())
        .orElse(Collections.emptyList())
        .stream()
        .anyMatch(opSchedule -> !CLOSED.equalsIgnoreCase(opSchedule.getOperationalScheduleType()));
  }

  private static HoldAtLocationResponse buildResponse(
      HoldAtLocationResponseDTO responseDto, List<LocationSuggestion> locationSuggestionList) {
    return HoldAtLocationResponse.builder()
        .status(responseDto.getResult().getStatusCode())
        .locationSuggestions(locationSuggestionList)
        .message(
            locationSuggestionList.isEmpty()
                ? "No locations found matching the package criteria."
                : "Locations found matching the package criteria.")
        .build();
  }

  private static boolean isHeightInLimit(
      LocationSuggestion locationSuggestion, boolean heightInLimit, float maxHeight) {
    if (Objects.nonNull(locationSuggestion.getPackageLimits().getHeight())) {
      String dimensionUOM = locationSuggestion.getPackageLimits().getDimensionUoM();
      double heightLimit = locationSuggestion.getPackageLimits().getHeight();
      heightLimit = correctionForDimensionUom(dimensionUOM, heightLimit);
      heightInLimit = maxHeight <= heightLimit;
    }
    return heightInLimit;
  }

  private static boolean isWidthInLimit(
      LocationSuggestion locationSuggestion, boolean widthInLimit, float maxWidth) {
    if (Objects.nonNull(locationSuggestion.getPackageLimits().getWidth())) {
      String dimensionUOM = locationSuggestion.getPackageLimits().getDimensionUoM();
      double widthLimit = locationSuggestion.getPackageLimits().getWidth();
      widthLimit = correctionForDimensionUom(dimensionUOM, widthLimit);
      widthInLimit = maxWidth <= widthLimit;
    }
    return widthInLimit;
  }

  private static boolean isLengthInLimit(
      LocationSuggestion locationSuggestion, boolean lengthInLimit, float maxLength) {
    if (Objects.nonNull(locationSuggestion.getPackageLimits().getLength())) {
      String dimensionUOM = locationSuggestion.getPackageLimits().getDimensionUoM();
      double lengthLimit = locationSuggestion.getPackageLimits().getLength();
      lengthLimit = correctionForDimensionUom(dimensionUOM, lengthLimit);
      lengthInLimit = maxLength <= lengthLimit;
    }
    return lengthInLimit;
  }

  private static double correctionForDimensionUom(String dimensionUOM, double dimension) {
    if (!dimensionUOM.equalsIgnoreCase(DIMENSION_INCH)) {
      if (dimensionUOM.equalsIgnoreCase(DIMENSION_CENTIMETER)) {
        dimension = dimension / CM_TO_IN;
      } else {
        throw new ValidationException("Package Limit Dimension UOM not supported: " + dimensionUOM);
      }
    }
    return dimension;
  }

  private static boolean isWeightInLimit(
      LocationSuggestion locationSuggestion, boolean weightInLimit, float maxWeight) {
    if (Objects.nonNull(locationSuggestion.getPackageLimits().getWeight())) {
      String weightUOM = locationSuggestion.getPackageLimits().getWeightUoM();
      double weightLimit = locationSuggestion.getPackageLimits().getWeight();
      if (!weightUOM.equalsIgnoreCase(WEIGHT_POUND)) {
        if (weightUOM.equalsIgnoreCase(WEIGHT_KILOGRAM)) {
          weightLimit = weightLimit * KG_TO_LB;
        } else {
          throw new ValidationException("Package Limit Weight UOM not supported: " + weightUOM);
        }
      }
      weightInLimit = maxWeight <= weightLimit;
    }
    return weightInLimit;
  }

  private List<PackageProfileEntity> getStandardPackages(HoldAtLocationRequest request) {
    List<PackageProfileEntity> packageProfiles = null;
    List<UUID> packageIds =
        request.getPackaging().stream()
            .filter(pkg -> !Boolean.TRUE.equals(pkg.isCustomPackage())
                    && !pkg.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE))
            .map(pkg -> UUID.fromString(pkg.getPackagingId()))
            .collect(Collectors.toSet())
            .stream()
            .toList();
    if (CollectionUtils.isNotEmpty(packageIds)) {
      packageProfiles = packageProfileRepository.findAllByIdIn(packageIds).stream().toList();
      if (packageIds.size() > packageProfiles.size()) {
        List<UUID> foundIds = packageProfiles.stream()
                .map(PackageProfileEntity::getId)
                .toList();
        List<UUID> missingIds = packageIds.stream()
                .filter(id -> !foundIds.contains(id))
                .toList();
        throw new ValidationException("Packages not found for the given IDs : " + missingIds);
      }
    }
    return packageProfiles;
  }

  private float getMaxHeight(
      HoldAtLocationRequest request, List<PackageProfileEntity> packageProfiles) {
    return Math.max(
        request.getPackaging().stream()
            .map(Packaging::getHeight)
            .filter(Objects::nonNull)
            .max(Float::compare)
            .orElse(0f),
        Objects.nonNull(packageProfiles)
            ? packageProfiles.stream()
                .map(PackageProfileEntity::getPackageProfileHeight)
                .filter(Objects::nonNull)
                .max(Float::compare)
                .orElse(0f)
            : 0f);
  }

  private float getMaxWidth(
      HoldAtLocationRequest request, List<PackageProfileEntity> packageProfiles) {
    return Math.max(
        request.getPackaging().stream()
            .map(Packaging::getWidth)
            .filter(Objects::nonNull)
            .max(Float::compare)
            .orElse(0f),
        Objects.nonNull(packageProfiles)
            ? packageProfiles.stream()
                .map(PackageProfileEntity::getPackageProfileWidth)
                .filter(Objects::nonNull)
                .max(Float::compare)
                .orElse(0f)
            : 0f);
  }

  private float getMaxLength(
      HoldAtLocationRequest request, List<PackageProfileEntity> packageProfiles) {
    return Math.max(
        request.getPackaging().stream()
            .map(Packaging::getLength)
            .filter(Objects::nonNull)
            .max(Float::compare)
            .orElse(0f),
        Objects.nonNull(packageProfiles)
            ? packageProfiles.stream()
                .map(PackageProfileEntity::getPackageProfileLength)
                .filter(Objects::nonNull)
                .max(Float::compare)
                .orElse(0f)
            : 0f);
  }

  private static Float getMaxWeight(HoldAtLocationRequest request) {
    return request.getPackaging().stream().map(Packaging::getWeight).max(Float::compare).orElse(0f);
  }

  private HoldAtLocationResponseDTO callHoldAtLocation(
          HoldAtLocationRequestDTO holdAtLocationRequestDTO) {

    HoldAtLocationResponseDTO holdAtLocationResponseDTO;
    long startTime = ApiResponseTimeUtil.startTime();

    try {
      Mono<HoldAtLocationResponseDTO> holdAtLocationResponseDTOMono =
              sendFlexWebClientService.sendFlexRequest(
                      HOLD_AT_LOCATION_SUB_URI,
                      HttpMethod.POST,
                      Map.of(),
                      holdAtLocationRequestDTO,
                      HoldAtLocationResponseDTO.class);

      holdAtLocationResponseDTO = holdAtLocationResponseDTOMono.block();

      long responseTime =
              ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
              holdAtLocationRequestDTO,
              holdAtLocationResponseDTO,
              null,
              HOLD_AT_LOCATION,
              responseTime);

    } catch (Exception e) {
      log.error("Error occurred while hold at location");

      long responseTime = ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
              holdAtLocationRequestDTO,
              null,
              HOLD_AT_LOCATION,
              e,
              responseTime);

      throw e;
    }

    return holdAtLocationResponseDTO;
  }

  HoldAtLocationRequestDTO prepareRequest(HoldAtLocationRequest request) {
    return HoldAtLocationRequestDTO.builder()
        .carrier(request.getShippingProfile())
        .address(
            AddressDTO.builder()
                .city(request.getAddress().getCity())
                .name(request.getAddress().getName())
                .type(request.getAddress().getType())
                .state(request.getAddress().getState())
                .contact(
                    ContactDTO.builder()
                        .name(request.getAddress().getName())
                        .phone(request.getAddress().getPhoneNumber())
                        .email(request.getAddress().getEmailAddress())
                        .build())
                .postalCode(request.getAddress().getZipCode())
                .countryCode(request.getAddress().getCountry())
                .residential(request.getAddress().isResidential())
                .addressLines(request.getAddress().getAddressLines())
                .build())
        .searchDistance(
            SearchDistance.builder().uoM(DISTANCE_MILE).value(HAL_SEARCH_RADIUS).build())
        .maxResults(null)
        .hideUnavailableLocations(true)
        .build();
  }
}

