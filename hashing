  @Test
  void testPriceBreakDown_USPS_Success() {
    // Arrange
    shipmentBookRequest.setShippingProfile("usps");

    ShipmentRequestDTO dto = new ShipmentRequestDTO();

    // Top-level charges only
    ChargeDTO freightCharge = new ChargeDTO();
    freightCharge.setType("Freight");
    freightCharge.setDescription("Freight Charges");
    freightCharge.setValue(6.94);
    freightCharge.setCurrencyType("USD");

    ChargeDTO totalCharge = new ChargeDTO();
    totalCharge.setType("Total");
    totalCharge.setDescription("Total Charges");
    totalCharge.setValue(8.0);
    totalCharge.setCurrencyType("USD");

    ChargeDTO accessorialCharge = new ChargeDTO();
    accessorialCharge.setType("Accessorial");
    accessorialCharge.setDescription("Accessorial Charges");
    accessorialCharge.setValue(1.06);
    accessorialCharge.setCurrencyType("USD");

    List<ChargeDTO> charges = List.of(freightCharge, totalCharge, accessorialCharge);

    RateDTO rateDTO1 = RateDTO.builder().charges(List.of()).build(); // dummy rate
    RateDTO rateDTO2 = RateDTO.builder().charges(charges).type("Customer").build(); // actual rate

    ShipViaOptionDTO shipViaOptionDTO = ShipViaOptionDTO.builder()
            .rates(List.of(rateDTO1, rateDTO2))
            .build();

    ShipmentResponseDTO shipmentResponseDTO = new ShipmentResponseDTO();
    shipmentResponseDTO.setShipViaOptions(List.of(shipViaOptionDTO));

    USPSConfigDTO mockUspsConfig = USPSConfigDTO.builder().uspsProfileCode("USPSCode").build();
    FedexConfig mockFedexConfig = FedexConfig.builder()
            .fedexAccess(true)
            .fedexServiceLevels(List.of("PRIORITY_OVERNIGHT", "STANDARD_OVERNIGHT"))
            .build();

    LocationConfigDTO mockLocation = LocationConfigDTO.builder()
            .facilityId("FAC12")
            .uspsConfiguration(mockUspsConfig)
            .fedexConfiguration(mockFedexConfig)
            .build();

    UserConfigResponseDTO mockResponse = new UserConfigResponseDTO();
    mockResponse.setError("error");
    mockResponse.setLocation(mockLocation);
    mockResponse.setCustomer(OCMCustomerDTO.builder()
            .epicConfiguration(EpicConfigDTO.builder().isEpicCustomer(true).build())
            .fedexPricingVisibility("SHOW_TOTAL_PRICING_ONLY")
            .uspsPricingVisibility("SHOW_LINE_ITEM_PRICING")
            .build());

    UserDefaultsData userDefaultsData = mock(UserDefaultsData.class);
    UserDefaultsResponse userDefaultsResponse = UserDefaultsResponse.builder()
            .data(userDefaultsData)
            .error(Collections.emptyMap())
            .build();

    when(userDefaultsService.getDefaultValues(oflUserPrincipal, shipmentBookRequest.getFacilityId()))
            .thenReturn(List.of(userDefaultsResponse));

    when(shipPlanDataMapperService.mapToSendFlexRequest(eq(shipmentBookRequest), eq(oflUserPrincipal), eq(userDefaultsData)))
            .thenReturn(dto);

    when(sendFlexWebClientService.sendFlexRequest(
            eq(ServiceCommonConstants.SHIPMENT_PLAN_SUB_URI),
            eq(HttpMethod.POST),
            anyMap(),
            eq(dto),
            eq(ShipmentResponseDTO.class)))
            .thenReturn(Mono.just(shipmentResponseDTO));

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(mockResponse);

    // Act
    PriceResult result = priceBreakDownService.priceBreakDown(shipmentBookRequest, oflUserPrincipal);

    // Assert
    assertNotNull(result);
    assertEquals(8.0, result.getTotal(), 0.01);
    assertEquals(3, result.getLineItem().size());

    assertEquals("Freight Charges", result.getLineItem().get(0).getDescription());
    assertEquals(6.94, result.getLineItem().get(0).getValue(), 0.01);

    assertEquals("Total Charges", result.getLineItem().get(1).getDescription());
    assertEquals(8.0, result.getLineItem().get(1).getValue(), 0.01);

    assertEquals("Accessorial Charges", result.getLineItem().get(2).getDescription());
    assertEquals(1.06, result.getLineItem().get(2).getValue(), 0.01);
  }


