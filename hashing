  private List<ShippingProfile> sortProfilesByCarrierOrder(List<ShippingProfile> profiles, List<String> carrierOrder) {

    Map<String, Integer> orderMap = new HashMap<>();
    for (var i = 0; i < carrierOrder.size(); i++) {
      orderMap.put(carrierOrder.get(i), i);
    }

    return profiles.stream()
            .sorted(Comparator.comparingInt(p -> orderMap.getOrDefault(p.getCarrier(), Integer.MAX_VALUE)))
            .toList();
  }

  private void validateDefaultShippingProfile(ShippingProfileRequest request) {
