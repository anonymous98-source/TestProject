    /**
     * Check invoice date for older than 90days and throw validation exception
     * @param invoiceDetails invoiceDetails
     */
    void invoiceDateValidation(@Valid InvoiceDetails invoiceDetails) {
        LocalDate invoiceDate;
        LocalDate ninetyDaysAgo = LocalDate.now().minusDays(90);
        try {
            invoiceDate = LocalDate.parse(invoiceDetails.getInvoiceDate());
        } catch (DateTimeParseException e) {
            throw new ValidationException("Invalid invoice date: " + invoiceDetails.getInvoiceDate());
        }

        if(invoiceDate.isBefore(ninetyDaysAgo))
            throw new ValidationException(INVOICE_DATE_OLDER_90DAYS_MESSAGE);
        //For future date error check after 1days
        if(invoiceDate.isAfter(LocalDate.now().plusDays(1)))
            throw new ValidationException(INVOICE_DATE_FUTURE_DATE_MESSAGE);

    }


