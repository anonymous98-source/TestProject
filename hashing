import java.util.Map;
import java.util.UUID;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.BEARER;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.CUSTOMERID;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.IMAGE_PARAM;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.ORDER_PARAM;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.REQUEST_ID;

@Slf4j
@Service
public class CmsWebClient {

    private final WebClient webClientNoAuth;
    private final RetryConfig retryConfig;
    private final WebClientErrorHandler webClientErrorHandler;

    private final AdvShippingIntegrationApiProperties properties;
    private final WebClient uaaWebClient;


    public CmsWebClient(@Qualifier("webClientNoAuth") WebClient webClientNoAuth, RetryConfig retryConfig, WebClientErrorHandler webClientErrorHandler, AdvShippingIntegrationApiProperties properties, WebClient uaaWebClient) {
        this.webClientNoAuth = webClientNoAuth;
        this.retryConfig = retryConfig;
        this.webClientErrorHandler = webClientErrorHandler;
        this.properties = properties;
        this.uaaWebClient = uaaWebClient;
    }


    /**
     * This method is used to submit order to CMS API.
     * @param requestBody The request body to be sent to the CMS API.
     * @param requestId The unique identifier for the request.
     * @return CmsBookResponse The response from the CMS API.
     */
    public CmsBookResponse cmsSubmitOrderApicall(String requestBody,String requestId,HttpHeaders httpHeaders) {
        log.atInfo()
                .addKeyValue(REQUEST_ID, requestId)
                .setMessage("Request to submit order API")
                .log();
        String submitOrderUrl = UriBuilderUtil.buildUri(properties.getCmsBaseUrl(), ServiceCommonConstants.CMS_GENERATE_LABEL_PATH_URI, null).toString();
        String authorizationHeader = httpHeaders.getFirst(HttpHeaders.AUTHORIZATION);
        if (authorizationHeader != null && authorizationHeader.startsWith(BEARER)) {
            return webClientNoAuth.post()
                    .uri(submitOrderUrl)
                    .header(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                    .header(HttpHeaders.AUTHORIZATION, authorizationHeader)
                    .bodyValue(requestBody)
                    .retrieve()
                    .bodyToMono(CmsBookResponse.class)
                    .retryWhen(retryConfig.createRetry(3, 2))
                    .onErrorMap(error -> webClientErrorHandler.handleErrorMap(error, ServiceCommonConstants.CMS_GENERATE_LABEL_PATH_URI, requestId, requestBody))
                    .block();

        }
        throw new UnAuthorizedException("Authorization header is missing or invalid" + REQUEST_ID + requestId);

    }
    /**
     * This method makes a GET request to the CMS API to fetch POD content.
     * It uses the provided image type, order tracking ID, and customer ID as query parameters.
     *
     * @param imageType The type of image to be fetched (e.g., "thumbnail", "fullsize").
     * @param orderTrackingId The tracking ID of the order for which POD content is to be fetched.
     * @param customerId The unique identifier of the customer associated with the order.
     * @return The response body as a String containing the POD content.
     */
    public String getCmsPodContent(String imageType,String orderTrackingId,String customerId) {
        var requestId = UUID.randomUUID().toString();
        Map<String,String> queryParams = Map.of(
                IMAGE_PARAM, imageType,
                ORDER_PARAM, orderTrackingId,
                CUSTOMERID, customerId
        );
        String cmsPodUrl = UriBuilderUtil.buildUri(properties.getCmsBaseUrl(), ServiceCommonConstants.CMS_POD_DOWNLOAD_PATH_URI, queryParams).toString();
        return uaaWebClient.get()
                .uri(cmsPodUrl)
                .header(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                .retrieve()
                .bodyToMono(String.class)
                .retryWhen(retryConfig.createRetry(3, 2))
                .onErrorMap(error -> webClientErrorHandler.handleErrorMap(error, ServiceCommonConstants.CMS_POD_DOWNLOAD_PATH_URI, requestId, orderTrackingId))
                .block();
    }



}


