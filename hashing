            .setMessage("Request to update favorite status of an address")
            .log();
    subscriptionAccessValidator.validatePremiumFeatureAccess(request.getFacilityId());
    SuccessResponse response =
        addressBookService.updateFavorite(
            request.getAddressId(), oflUserPrincipal, request.getIsFavorite());
    log.atInfo()
            .setMessage(
                "Update favorite status response is "
                    + response.getMessage()
                    + " and status code is "
                    + response.getStatus())
            .log();
    return ResponseEntity.ok(response);
