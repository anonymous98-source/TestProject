public class CompoundRuleValidator {

    private final ShippingProfileRepository shippingProfileRepository;
    private final CompoundValidationData conditionValidationData;
    private final UserDetailsService userService;
    private final OCMWebClientService ocmWebClientService;
    private final RuleDefinitionRepository ruleDefinitionRepository;
    private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;


    public void validateCompoundRuleRequest(CompoundRuleDTO compoundRuleDTO) {
        if (compoundRuleDTO == null) {
            throw new ValidationException("compoundRuleRequest is null");
        }
        if (CommonUtil.isInvalidUUID(compoundRuleDTO.getShippingProfileId())) {
            throw new ValidationException("Invalid Shipping Profile Id UUID");
        }

        if (compoundRuleDTO.getConditions() == null || compoundRuleDTO.getConditions().isEmpty()) {
            throw new ValidationException("At least one condition is required");
        }
        validateOperatorAndFields(compoundRuleDTO);
        validateFacilityConstraints(compoundRuleDTO);
    }

    private void validateOperatorAndFields(CompoundRuleDTO compoundRuleDTO) {
        boolean firstCondition = true;
        Map<String, List<String>> supportedOperators = conditionValidationData.getOperatorMapping();
        for (ConditionDTO condition : compoundRuleDTO.getConditions()) {
            if (StringUtils.isBlank(condition.getOperator()) || StringUtils.isBlank(condition.getKey())) {
                throw new ValidationException("Operator or field is null or empty");
            }
            if (!supportedOperators.containsKey(condition.getKey().toLowerCase())) {
                throw new ValidationException("Only five input parameters allowed: weight, shipVia, value, zipCode & coldChain");
            }
            if (!supportedOperators.get(condition.getKey().toLowerCase()).contains(condition.getOperator().toUpperCase(Locale.ROOT))) {
                throw new ValidationException("Operator not allowed for the input parameter for key: " + condition.getKey());
            }
            if (!validateJoiningOperator(firstCondition, condition.getJoiningOperator())) {
                throw new ValidationException("Only AND and OR allowed for joining operator, joining operator is not valid for key: " + condition.getKey());
            }
            if (firstCondition) {
                firstCondition = false;
            }
        }
    }

    private boolean validateJoiningOperator(boolean firstCondition, String joiningOperator) {
        if (firstCondition) {
            return true;
        }
        if (joiningOperator == null) {
            throw new ValidationException("Joining operator is mandatory from second condition");
        }
        return AND.equalsIgnoreCase(joiningOperator) || OR.equalsIgnoreCase(joiningOperator);
    }

    private void validateFacilityConstraints(CompoundRuleDTO compoundRuleDTO) {
        List<RuleDefinitionProjection> ruleDefinitions = ruleDefinitionRepository.getPrioritiesByFacilityId(compoundRuleDTO.getFacilityId(), COMPOUND_RULE);
        if (ruleDefinitions != null && compoundRuleDTO.getId() == null && ruleDefinitions.size() >= advShippingIntegrationApiProperties.getCompoundRule().getLimit()) {
            throw new ValidationException("Compound rule creation limit exceeded. Maximum limit is " + advShippingIntegrationApiProperties.getCompoundRule().getLimit());
        }

        if (ruleDefinitions != null) {
            if (compoundRuleDTO.getPriority() < 1 || compoundRuleDTO.getPriority() > advShippingIntegrationApiProperties.getCompoundRule().getPriorityLimit()) {
                throw new ValidationException("Invalid priority. Allowed range is 1-" +  advShippingIntegrationApiProperties.getCompoundRule().getPriorityLimit());
            }
            Optional<RuleDefinitionProjection> conflictingRule = ruleDefinitions.stream()
                    .filter(r -> r.getPriority() == compoundRuleDTO.getPriority())
                    .findFirst();

            if (compoundRuleDTO.getId() == null && conflictingRule.isPresent()) {
                throw new ValidationException(
                        "Rule already exist on same priority. ruleId: " + conflictingRule.get().getId());
            }
        }
        UserConfigResponseDTO userConfigResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(compoundRuleDTO.getFacilityId(), compoundRuleDTO.getCustomerId());
        Optional<ShippingProfile> shippingProfile = shippingProfileRepository.findById(UUID.fromString(compoundRuleDTO.getShippingProfileId()));
        if (shippingProfile.isPresent() && !Boolean.FALSE.equals(shippingProfile.get().getActive())) {
            String carrier = shippingProfile.get().getCarrier();
            Map<String, Boolean> accessMap = getAccessMap(userConfigResponseDTO);
            if (shippingProfile.get().getFacilityId() != null &&
                    !compoundRuleDTO.getFacilityId().equals(shippingProfile.get().getFacilityId())){
                throw new ValidationException("Shipping profile is not associated with the facility.");
            }
            if (accessMap.containsKey(carrier) && Boolean.TRUE.equals(accessMap.get(carrier))) {
                return;
            }
            throw new ValidationException("Shipping profile is inactive as carrier is disable");
        }
        throw new ValidationException("Shipping profile does not exist.");

    }

    public void validateUserAuthorization(String userEmail, String facilityId, String customerId) {
        if (CommonUtil.isInvalidUUID(facilityId)) {
            throw new ValidationException("Invalid facilityId");
        }
        if (CommonUtil.isInvalidUUID(customerId)) {
            throw new ValidationException("Invalid customerId");
        }
        OflUser user = Optional.ofNullable(userService.getUser(userEmail))
                .orElseThrow(() -> new ResourceNotFoundException(USER_DATA_NOT_FOUND));

        UserCustomerProfile userCustomerProfile = userService.getUserCustomerProfile(null, user);
        if (userCustomerProfile == null) {
            throw new ResourceNotFoundException(USER_DATA_NOT_FOUND);
        }
        boolean found = false;
        for (Map.Entry<String, Customer> entry : userCustomerProfile.getCustomers().entrySet()) {
            if (entry.getValue() != null && entry.getValue().getId().equals(customerId)) {
                found = true;
                break;
            }
        }
        if (!found) {
            throw new ValidationException("Access denied. The user is not authorized to perform actions for the specified customer.");
        }
        boolean facilityFound = userCustomerProfile.getFacilityList().stream().anyMatch(facility -> facility.getId().equals(facilityId));
        if (!facilityFound) {
            throw new ValidationException("Access denied. The user is not authorized to perform actions for the specified facility.");
        }

    }

    private Map<String, Boolean> getAccessMap(UserConfigResponseDTO userConfigResponseDTO) {
        boolean isCmsSameDay = false;
        boolean isCmsNextDay = false;
        boolean isCmsSameDayState = false;
        Boolean isCmsAccess = userConfigResponseDTO.getLocation().getCmsConfiguration().getCmsAccess();
        boolean cmsAccess = Boolean.TRUE.equals(isCmsAccess);

        if(cmsAccess) {
            List<String> cmsServiceLevels = userConfigResponseDTO.getLocation().getCmsConfiguration().getCmsServiceLevels();
            isCmsSameDayState = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAYSTATE));
            isCmsNextDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_NEXTDAY));
            isCmsSameDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAY));
        }

        boolean isFedexAccess = userConfigResponseDTO.getLocation().getFedexConfiguration().getFedexAccess();
        boolean isUspsAccess = userConfigResponseDTO.getLocation().getUspsConfiguration().getUspsAccess();
        boolean isDhlAccess = userConfigResponseDTO.getLocation().getDhlConfiguration() != null &&
                Boolean.TRUE.equals(userConfigResponseDTO.getLocation().getDhlConfiguration().getDhlAccess());
        Map<String, Boolean> accessMap = new HashMap<>();
        accessMap.put(ShippingProfileConstants.FEDEX, isFedexAccess);
        accessMap.put(ShippingProfileConstants.USPS, isUspsAccess);
        accessMap.put(CMS_COURIER_SAME_DAY_STATE, isCmsSameDayState);
        accessMap.put(CMS_COURIER_SAME_DAY, isCmsSameDay);
        accessMap.put(CMS_COURIER_NEXT_DAY, isCmsNextDay);
        accessMap.put(ShippingProfileConstants.DHL, isDhlAccess);
        return accessMap;
    }


}

