        rd.setRuleType(SHIPMENT_VALUE.toString());
        rd.setCarrier(carrier);
        rd.setActive(true);

        rd.setValue(value);
        rd.setAccessorial(accessorial);
        rd.setSecondaryConfig(secondaryConfig);

        return rd;
