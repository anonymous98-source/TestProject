@Slf4j
@Service
@RequiredArgsConstructor
public class ServiceUtil {

    private final ShippingProfileRepository shippingProfileRepository;

    public void isShippingProfileExists(String shippingProfileId, String facilityId) {
        if (!shippingProfileRepository.existsByIdAndFacilityIdOrFacilityIdIsNull(UUID.fromString(shippingProfileId), facilityId)) {
            throw new ValidationException(SHIPPING_PROFILE_ID_NOT_EXIST);
        }
    }

    // Save ShipmentValueRule Condition
    public void saveShipmentValueRuleCondition(ShipmentValueRuleReqDto request, RuleDefinition ruleDefinition) {

        log.atInfo().setMessage("Saving ShipmentValueRule condition for ruleDefinitionId: " + ruleDefinition.getId()).log();

        saveRuleCondition(
                request.getRuleType(),
                request.getOperation(),
                request.getValue(),
                ruleDefinition
        );
    }

    // Save WeightRule Condition
    public void saveWeightRuleCondition(ShippingRuleWeightRequestDto request, RuleDefinition ruleDefinition) {

        log.atInfo().setMessage("Saving WeightRule condition for ruleDefinitionId: " + ruleDefinition.getId()).log();

        saveRuleCondition(
                request.getRuleType(),
                request.getOperation(),
                request.getWeight().toPlainString(),
                ruleDefinition
        );
    }

    private void saveRuleCondition(
            String ruleType,
            String operation,
            String comparisonValue,
            RuleDefinition ruleDefinition) {
        // conditionOrder = 1, since we are only handling one condition for each rule type currently.

        RuleCondition ruleCondition = ruleDefinition.getRuleConditions()
                .stream()
                .filter(cond ->
                        Objects.equals(ONE, cond.getConditionOrder()) && Objects.equals(getFieldName(ruleType), cond.getFieldName()))
                .findFirst().orElseGet(RuleCondition::new);
        //clear the existing conditions.
        ruleDefinition.getRuleConditions().clear();

        ruleCondition.setRuleDefinition(ruleDefinition);
        ruleCondition.setFieldName(getFieldName(ruleType));
        ruleCondition.setOperator(operation);
        ruleCondition.setFieldType(getFieldType(ruleType));
        ruleCondition.setLogicalOp(null);
        ruleCondition.setConditionOrder(ONE);
        ruleCondition.setComparisonValue(comparisonValue);

        // Save the updated or created rule condition
        ruleDefinition.getRuleConditions().add(ruleCondition);
    }

    private String getFieldName(String ruleType) {
        return switch (ruleType) {
            case WEIGHT_RULE -> WEIGHT_VALUE;
            case SHIPMENT_VALUE_RULE -> SHIPMENT_VALUE;
            // Add more cases as needed for different rule types
            default -> throw new ValidationException(INVALID_RULE_TYPE_ERROR + ruleType);
        };
    }

    private String getFieldType(String ruleType) {
        return switch (ruleType) {
            case WEIGHT_RULE, SHIPMENT_VALUE_RULE -> FIELD_TYPE;
            // Add more cases as needed for different rule types
            default -> throw new ValidationException(INVALID_RULE_TYPE_ERROR + ruleType);
        };
    }
}

