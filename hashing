      }
      if (Boolean.TRUE.equals(saturdayPickup)) {
        throw new ValidationException("saturdayPickup is not supported for DHL shipments.");
      }
      if (Boolean.TRUE.equals(emailNotification)) {
        throw new ValidationException("email notification is not supported for DHL shipments.");
      }
      if (LBS.equalsIgnoreCase(weightUOM) && weight >= 25) {
        throw new ValidationException("maximum weight for DHL shipments in lbs is 24.99 lbs.");
      }
    }
  }

  private void validateAddressParameters(ShipmentBookRequest request) {
    String senderCompanyName = request.getShipFromAddress().getAddressData().getAddress().getCompany();
    String recipientCompanyName = request.getShipToAddress().getAddressData().getAddress().getCompany();
    String senderEmail = request.getShipFromAddress().getAddressData().getAddress().getEmailAddress();
    String recipientEmail = request.getShipToAddress().getAddressData().getAddress().getEmailAddress();
    String senderName = request.getShipFromAddress().getAddressData().getAddress().getName();
    String recipientName = request.getShipToAddress().getAddressData().getAddress().getName();
    if (senderName.length() > 30 || recipientName.length() > 30) {
      throw new ValidationException("Sender or recipient name must not exceed 30 characters for DHL shipments");
    }
    if ((Objects.nonNull(senderCompanyName) && senderCompanyName.length() > 30)
            || (Objects.nonNull(recipientCompanyName) && recipientCompanyName.length() > 30)) {
      throw new ValidationException("Sender or recipient company name must not exceed 30 characters for DHL shipments");
    }
    if ((Objects.nonNull(senderEmail) && senderEmail.length() > 50)
            || (Objects.nonNull(recipientEmail) && recipientEmail.length() > 50)) {
      throw new ValidationException("Sender or recipient email must not exceed 50 characters for DHL shipments");
    }
  }

  private void validateLithiumBatteryCount(Accessorials accessorials) {
    int count = (int) Stream.of(accessorials.getMetalContainedInEquipment(), accessorials.getMetalPackedWithEquipment(),
            accessorials.getMetalStandalone(), accessorials.getIonContainedInEquipment(),
            accessorials.getIonPackedWithEquipment(), accessorials.getIonStandalone()
    ).filter(Boolean.TRUE::equals).count();
    if (count > 1) {
      throw new ValidationException("Only one lithium battery option can be selected for DHL shipments.");
    }
  }

  private void validateReturnShipViaCode(ShipmentBookRequest shipmentBookRequest) {
    if (isReturnTypeForFedex(shipmentBookRequest, STANDALONE)) {
      boolean isMatch =
          shipmentBookRequest.getShipViaOptions().stream()
              .anyMatch(
                  shipViaOption ->
                      shipViaOption.getCode().equalsIgnoreCase(FEDEX_EXPRESS_SAVER_CODE));
      if (isMatch) {
        throw new ValidationException(
            "ShipViaCode cannot be FedEx Express Saver for Standalone return Shipments.");
      }
    }
    if (isReturnTypeForFedex(shipmentBookRequest, FORWARD)
        && !StringUtils.isBlank(shipmentBookRequest.getShipViaReturnCode())
        && shipmentBookRequest.getShipViaReturnCode().equalsIgnoreCase(FEDEX_EXPRESS_SAVER_CODE)) {
      throw new ValidationException(
          "ShipViaReturnCode cannot be FedEx Express Saver for Forward Return Shipments.");
    }
  }

  private void validateAccessorialsForStandaloneReturn(ShipmentBookRequest request) {
    if (isReturnTypeForFedex(request, STANDALONE)
        && (request.getPackagingDetails().get(0).getAccessorials().isLithiumBattery()
            || request.getAdditionalAccessorial().isSaturdayPickup()
            || request.getAdditionalAccessorial().isSaturdayDelivery())) {
      throw new ValidationException(
          "Lithium Battery, Saturday PickUp, Saturday Delivery accessorials "
              + "are not applicable during standalone return processing.");
    }
  }

  /** this is a helper method which checks for the specific return type for FedEx */
  private static boolean isReturnTypeForFedex(
      ShipmentBookRequest shipmentBookRequest, String returnType) {
    return !StringUtils.isBlank(shipmentBookRequest.getGenerateLabelReturnType())
        && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(returnType)
        && FEDEX.equalsIgnoreCase(shipmentBookRequest.getShippingProfile());
  }

  private void validateSignature(ShipmentBookRequest request) {
    AdditionalAccessorial additionalAccessorial = request.getAdditionalAccessorial();
    if (additionalAccessorial.isSignatureRequired()
        && StringUtils.isBlank(additionalAccessorial.getSignatureLevel())) {
      throw new ValidationException(
          "Signature level is required when signature is marked as required.");
    }
    if (DHL.equalsIgnoreCase(request.getShippingProfile()) && additionalAccessorial.isSignatureRequired()) {
      boolean signatureLevel = SIGNATURE_CONFIRMATION.equalsIgnoreCase(additionalAccessorial.getSignatureLevel())
              || ADULT_SIGNATURE_OLDER_REQUIRED.equalsIgnoreCase(additionalAccessorial.getSignatureLevel())
              || ADULT_SIGNATURE_RESTRICTED_DELIVERY.equalsIgnoreCase(additionalAccessorial.getSignatureLevel());
      if (!signatureLevel) {
        throw new ValidationException("provided signature level is not supported for DHL shipments.");
      }
    }
  }

  private void validatePackagingDetails(ShipmentBookRequest request) {

    List<PackagingDetails> packagingDetailsList = request.getPackagingDetails();
    Integer totalPackageCount = request.getTotalPackageCount();
    boolean isFedex = request.getShippingProfile().equalsIgnoreCase(FEDEX);
    boolean isUsps = request.getShippingProfile().equalsIgnoreCase(USPS);
    boolean isDhl = request.getShippingProfile().equalsIgnoreCase(DHL);
    boolean isFedexOrUspsOrDhl = isFedex || isUsps || isDhl;

    validateMaxPackagesCount(packagingDetailsList);
    validatePackagePresentAndTotalCount(packagingDetailsList, totalPackageCount);
    validatePackageCountForUspsAndDhl(isUsps, isDhl, packagingDetailsList.size());

    packagingDetailsList.forEach(
        packagingDetails -> {
          Packaging packaging = packagingDetails.getPackaging();
          Accessorials accessorials = packagingDetails.getAccessorials();

          validatePackageDimensions(packaging);
          validateDryIceLithiumBatteryCombination(accessorials, isFedexOrUspsOrDhl);
          validateDryIceWeight(packaging, accessorials, isFedexOrUspsOrDhl);
          validateAccessorialsForGenerateLabel(packaging, accessorials);
        });
  }

  private void validateMaxPackagesCount(List<PackagingDetails> packagingDetailsList) {
    if (Objects.nonNull(packagingDetailsList)
        && packagingDetailsList.size() > properties.getMaxPackageCount()) {
      throw new ValidationException(
          "No more than " + properties.getMaxPackageCount() + " packages are allowed");
    }
  }

  private static void validatePackagePresentAndTotalCount(
      List<PackagingDetails> packagingDetailsList, Integer totalPackageCount) {
    if (Objects.nonNull(packagingDetailsList)
        && Objects.nonNull(totalPackageCount)
        && packagingDetailsList.size() != totalPackageCount) {
      throw new ValidationException("totalPackageCount must match the number of packagingDetails");
    }
  }

  private static void validatePackageCountForUspsAndDhl(
      boolean isUsps, boolean isDhl, Integer packageCount) {
    if (isUsps && packageCount > 1) {
      throw new ValidationException("Multi package shipment is not supported for USPS");
    } else if (isDhl && packageCount > 1) {
      throw new ValidationException("Multi package shipment is not supported for DHL");
    }
  }

  public void validatePackageDimensions(Packaging packaging) {
    if (packaging.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE)
        && Stream.of(packaging.getLength(), packaging.getWidth(), packaging.getHeight())
                    .filter(d -> d >= 1)
                    .count()
                % 3
            != 0) {
      throw new ValidationException(
          "Either all or none of the values of Length, Width & Height must be provided, Package ID- "
              + packaging.getPackagingId());
    }
  }

  private void validateDryIceLithiumBatteryCombination(
      Accessorials accessorials, boolean isFedexOrUspsOrDhl) {
    if (Objects.nonNull(accessorials)
        && accessorials.isContainsDryIce()
        && accessorials.isLithiumBattery()
        && isFedexOrUspsOrDhl) {
      throw new ValidationException(
          "Unsupported combination of services. Dry ice cannot be selected with Lithium Battery.");
    }
  }

  private void validateDryIceWeight(
      Packaging packaging, Accessorials accessorials, boolean isFedexOrUspsOrDhl) {
    if (Objects.nonNull(packaging)
        && Objects.nonNull(accessorials)
        && isFedexOrUspsOrDhl
        && accessorials.isContainsDryIce()
        && accessorials.getWeight() > packaging.getWeight()) {
      throw new ValidationException(
          "Your dry ice weight cannot exceed the total weight of the package.");
    }
  }

  private void validateAccessorialsForGenerateLabel(
      Packaging packaging, Accessorials accessorials) {

    boolean isLithiumBattery = accessorials.isLithiumBattery();
    boolean hasSecondaryAccessorial = hasSecondaryAccessorial(accessorials);

    isLithiumBatteryNoSecondaryAccessorial(isLithiumBattery, hasSecondaryAccessorial);
    noLithiumBatteryHasSecondaryAccessorial(isLithiumBattery, hasSecondaryAccessorial);

    validateDryIce(accessorials);
    validateCoverageAmount(packaging);
    validateValueOfContent(accessorials);
  }

  private boolean hasSecondaryAccessorial(Accessorials accessorials) {
    return Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())
        || Boolean.TRUE.equals(accessorials.getIonContainedInEquipment())
        || Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())
        || Boolean.TRUE.equals(accessorials.getMetalPackedWithEquipment())
            || Boolean.TRUE.equals(accessorials.getMetalStandalone())
            || Boolean.TRUE.equals(accessorials.getIonStandalone());
  }

  private static void isLithiumBatteryNoSecondaryAccessorial(
      boolean isLithiumBattery, boolean hasSecondaryAccessorial) {
    if (isLithiumBattery && !hasSecondaryAccessorial) {
      throw new ValidationException(
          "At least one secondary accessorial is required for lithium battery");
    }
  }

  private static void noLithiumBatteryHasSecondaryAccessorial(
      boolean isLithiumBattery, boolean hasSecondaryAccessorial) {
    if (!isLithiumBattery && hasSecondaryAccessorial) {
      throw new ValidationException(
          "Secondary accessorial options cannot be selected unless the lithium Battery option is enabled.");
    }
  }

  private static void validateDryIce(Accessorials accessorials) {
    if (accessorials.isContainsDryIce() && accessorials.getWeight() <= 0) {
      throw new ValidationException("Dry Ice weight must be greater than zero");
    }
  }

  private static void validateCoverageAmount(Packaging packaging) {
    if (Boolean.TRUE.equals(packaging.getIsIndividualShipmentProtection())
        && (Objects.isNull(packaging.getCoverageAmount()) || packaging.getCoverageAmount() <= 0)) {
      throw new ValidationException("Coverage amount must be greater than zero");
    }
  }

  private static void validateValueOfContent(Accessorials accessorials) {
    if (accessorials.isDeclaredValue()
        && (Objects.isNull(accessorials.getValueOfContent())
            || accessorials.getValueOfContent() <= 0)) {
      throw new ValidationException("Value of content can't be null and must be greater than zero");
    }
  }

  private void validateInsuranceForUSPSAndDHL(ShipmentBookRequest shipmentBookRequest) {
    Accessorials accessorials = shipmentBookRequest.getPackagingDetails().get(0).getAccessorials();
    if (USPS.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
            && (Boolean.TRUE.equals(accessorials.getAddOnInsurance())
            && (Objects.isNull(accessorials.getAddOnInsuranceValue())
            || accessorials.getAddOnInsuranceValue() <= 0))){
      throw new ValidationException(
          "AddOnInsurance value can't be null and must be greater than zero");
    }
    if (DHL.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
            && Boolean.TRUE.equals(accessorials.getAddOnInsurance())) {
      throw new ValidationException("Insurance is not supported for DHL shipments.");
    }
  }

