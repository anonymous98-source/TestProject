    AddressSuggestion addressSuggestionDto = null;
    if (!responseDTO.isAddressValid()) {
      if (responseDTO.getAddressSuggestions() != null) {
        addressSuggestionDto = responseDTO.getAddressSuggestions().get(0);
      }
      if (addressSuggestionDto != null) {
        return AddressSuggestionResp.builder()
