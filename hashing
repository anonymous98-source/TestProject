    /**
     * MFA Request Id to track the MFA registration process
     */
    @Override
    public MeteringResponse registerAndSendFlexProfileLink(MeteringRequest request, OflUserPrincipal oflUserPrincipal) {
        if(request.getInvoiceDetails()!=null && request.getMfaDetails()!=null)
            return buildSendFlexMfaResponse(BOTH_INVOICE_AND_MFA_PROVIDED, ResponseStatus.FAILED.name());

        if(request.getInvoiceDetails()==null && request.getMfaDetails()==null)
            return buildSendFlexMfaResponse(EITHER_INVOICE_OR_MFA_REQUIRED , ResponseStatus.FAILED.name());

        OflUser user = Optional.ofNullable(userService.getUser(oflUserPrincipal.getUserName()))
                        .orElseThrow(() -> new ResourceNotFoundException(USER_DATA_NOT_FOUND));

        UserCustomerProfile userCustomerProfile = userDetailsService.getUserCustomerProfile(null, user);
        List<Facility> facilities = userCustomerProfile.getFacilityList();
        if (facilities.isEmpty()) {
            throw new ResourceNotFoundException(NO_ASSOCIATED_FACILITIES);
        }
        Facility facilityDetail=facilities.stream().filter(facility -> facility.getId().equalsIgnoreCase(request.getFacilityId()))
                .findFirst().orElseThrow(() -> new ResourceNotFoundException(FACILITY_DETAILS_NOT_FOUND));

        String fedexAccountNumber = facilityDetail.getShipperNumber();
        if (StringUtils.isBlank(fedexAccountNumber)) {
            return buildSendFlexMfaResponse(NO_SHIPPER_ACCOUNT, ResponseStatus.FAILED.name());
        }
        return processMeteringForFacility(request,facilityDetail,fedexAccountNumber,user.getId());

    }

    /**
     * Process metering for a facility
     * @param request SendFlexMfaRequest
     * @param facilityDetail Facility
     * @param fedexAccountNumber FedexAccountNumber
     * @return SendFlexMfaResponse
     */
    MeteringResponse processMeteringForFacility(MeteringRequest request, Facility facilityDetail, String fedexAccountNumber, UUID meteredBy) {
        if(isMetered(fedexAccountNumber)) {
            return buildSendFlexMfaResponse(LOCATION_METERED, ResponseStatus.SUCCESS.name());
        }
        FedexMeteringRecord fedexMeteringRecord=fedexMeteringRecordRepository.findByShipperAccountNumber(fedexAccountNumber);
        UserConfigResponseDTO ocmResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(request.getFacilityId(),request.getCustomerId());
        String profileCode=ocmResponseDTO.getLocation().getFedexConfiguration().getFedexProfileCode();
        if(StringUtils.isBlank(profileCode)) {
            return buildSendFlexMfaResponse(NO_FEDEX_PROFILE,ResponseStatus.FAILED.name());
        }
        CarrierSettings carrierSettings;
        if(request.getInvoiceDetails() != null) {
            invoiceDateValidation(request.getInvoiceDetails());
            //invoice details
            carrierSettings=InvoiceCarrierSettings.builder()
                    .invoiceNumber(request.getInvoiceDetails().getInvoiceNumber())
                    .invoiceCurrency(USD)
                    .invoiceAmount(request.getInvoiceDetails().getInvoiceAmount().replace(USD,"").replace(DOLLAR_SIGN,"").trim())
                    .invoiceDate(request.getInvoiceDetails().getInvoiceDate())
                    .build();
            return meteringInvoiceRecord(request,fedexMeteringRecord, facilityDetail, fedexAccountNumber, profileCode, carrierSettings,meteredBy);
        }else {
            return meteringMfaRecord(request, facilityDetail, fedexAccountNumber, fedexMeteringRecord, profileCode,meteredBy);
        }

    }


    MeteringResponse meteringMfaRecord(MeteringRequest request, Facility facilityDetail, String fedexAccountNumber, FedexMeteringRecord fedexMeteringRecord, String profileCode, UUID meteredBy) {
        //mfa details
        if(fedexMeteringRecord ==null) {
            return meteringMfaFirstTime(request, facilityDetail, fedexAccountNumber, profileCode);

        }else if(fedexMeteringRecord.getRequestId() != null){
            return meteringMfaForExistingRecord(request, facilityDetail, fedexAccountNumber, fedexMeteringRecord, profileCode,meteredBy);

        } else {
            log.atError().setMessage(REQUEST_ID_NULL+ fedexMeteringRecord.getShipperAccountNumber()).log();
            return buildSendFlexMfaResponse(ERROR_OCCURRED_METERING_REGISTERATION, ResponseStatus.FAILED.name());
        }
    }

    MeteringResponse meteringMfaForExistingRecord(MeteringRequest request, Facility facilityDetail, String fedexAccountNumber, FedexMeteringRecord fedexMeteringRecord, String profileCode, UUID meteredBy) {
        CarrierSettings carrierSettings;
        if(fedexMeteringRecord.getStatus().equalsIgnoreCase(MeteringState.LINK_FAILED.name())) {
            //profile linking failed earlier, so try profile linking again
            return profileCodeLinkingProcess(profileCode, fedexMeteringRecord.getRequestId(), fedexMeteringRecord,meteredBy);
        } else {
            //status: Pending/Failed scenario handle --> User initiate metering by MFA
            carrierSettings=MfaCarrierSettings.builder()
                    .mfaCode(request.getMfaDetails().getMfaCode())
                    .build();
            if(StringUtils.isNotBlank(request.getMfaDetails().getMfaCode())){
                CarrierRegisterRequest carrierRegisterRequest= meteringDataMapper.buildCarrierRegisterRequest(fedexMeteringRecord.getRequestId(), facilityDetail, fedexAccountNumber, profileCode, carrierSettings);
                CarrierRegisterResult carrierRegisterResult=mfaRegisterAndLinkWebClient.mfaRegistration(carrierRegisterRequest);
                if(carrierRegisterResult!=null && carrierRegisterResult.getSuccess()!=null) {
                    //profile code entry when profile linking is done.
                    fedexMeteringRecord.setMeteredBy(meteredBy);
                    fedexMeteringRecord.setMeteringMethodDetail(MfaOtpState.OTP.name());
                    fedexMeteringRecord.setStatus(MeteringState.COMPLETED.name());
                    fedexMeteringRecord.setMeteredAt(LocalDateTime.now(ZoneOffset.UTC));
                    fedexMeteringRecord.setErrorMessage(null);
                    FedexMeteringRecord savedRecord=fedexMeteringRecordRepository.save(fedexMeteringRecord);
                    return profileCodeLinkingProcess(profileCode, carrierRegisterResult.getSuccess().getId(), savedRecord,meteredBy);
                }else if(carrierRegisterResult!=null && carrierRegisterResult.getError()!=null) {
                    fedexMeteringRecord.setStatus(MeteringState.FAILED.name());
                    fedexMeteringRecord.setMeteringMethodDetail(MfaOtpState.OTP.name());
                    fedexMeteringRecord.setErrorMessage(carrierRegisterResult.getError().getDetail());
                    fedexMeteringRecordRepository.save(fedexMeteringRecord);
                    return buildSendFlexMfaResponse(ERROR_OCCURRED_METERING_REGISTERATION + carrierRegisterResult.getError().getDetail(), ResponseStatus.FAILED.name());
                }else {
                    return buildSendFlexMfaResponse(ERROR_OCCURRED_METERING_REGISTERATION, ResponseStatus.FAILED.name());
                }

            }else if(StringUtils.isNotBlank(fedexMeteringRecord.getRequestId())){
                return regenerateOtpForMfaRecord(request, facilityDetail, fedexAccountNumber, fedexMeteringRecord, profileCode);

            }else {
                return buildSendFlexMfaResponse(MFA_REQUIRED, ResponseStatus.FAILED.name());
            }
        }
    }

    MeteringResponse regenerateOtpForMfaRecord(MeteringRequest request, Facility facilityDetail, String fedexAccountNumber, FedexMeteringRecord fedexMeteringRecord, String profileCode) {
        CarrierSettings carrierSettings;
        //Regenerate OTP scenario handle --> user forget to provide OTP in request after PreRegistration
        carrierSettings=MfaCarrierSettings.builder()
                .mfaMethod(request.getMfaDetails().getMfaType().toUpperCase())
                .mfaCode(MfaOtpState.RESET.name())
