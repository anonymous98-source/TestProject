package com.cardinalhealth.adv.shipping.integration.api.redis.auth;

import com.google.auth.oauth2.GoogleCredentials;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.IOException;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.util.Collections;

/**
 * Provides IAM authentication tokens for GCP Memorystore Redis connections.
 *
 * Uses Google Cloud Application Default Credentials (ADC) to generate access tokens
 * with appropriate Redis scopes. Handles automatic token refresh when tokens expire.
 *
 * Thread-safe implementation suitable for use in Spring Boot applications.
 */
public class GcpIamTokenProvider {

    private static final Logger logger = LoggerFactory.getLogger(GcpIamTokenProvider.class);

    /**
     * Redis IAM scope for Memorystore
     */
    private static final String REDIS_SCOPE = "https://www.googleapis.com/auth/cloud-platform";

    /**
     * Buffer time before token expiry to trigger refresh (5 minutes)
     */
    private static final Duration TOKEN_REFRESH_BUFFER = Duration.ofMinutes(5);

    private final GoogleCredentials credentials;
    private final Clock clock;
    private volatile String currentToken;
    private volatile Instant tokenExpiry;

    /**
     * Creates a new GCP IAM token provider using Application Default Credentials.
     *
     * @throws IOException if ADC cannot be found or initialized
     */
    public GcpIamTokenProvider() throws IOException {
        this.credentials = GoogleCredentials.getApplicationDefault()
                .createScoped(Collections.singleton(REDIS_SCOPE));
        this.clock = Clock.systemUTC();
        refreshToken();
        logger.info("GCP IAM Token Provider initialized successfully");
    }

    /**
     * Creates a new GCP IAM token provider with custom credentials.
     *
     * @param credentials Google credentials to use for token generation
     * @throws IOException if credentials cannot be refreshed
     */
    public GcpIamTokenProvider(GoogleCredentials credentials) throws IOException {
        this(credentials, Clock.systemUTC());
    }

    GcpIamTokenProvider(GoogleCredentials credentials, Clock clock) throws IOException {
        this.credentials = credentials.createScoped(Collections.singleton(REDIS_SCOPE));
        this.clock = clock;
        refreshToken();
        logger.info("GCP IAM Token Provider initialized with custom credentials");
    }

    /**
     * Gets a valid access token, refreshing if necessary.
     *
     * @return a valid access token string
     * @throws IOException if token refresh fails
     */
    public synchronized String getToken() throws IOException {
        if (isTokenExpired()) {
            refreshToken();
        }
        return currentToken;
    }

    /**
     * Gets the username for Redis AUTH command.
     * For IAM authentication, the username is always "default".
     *
     * @return the string "default"
     */
    public String getUsername() {
        return "default";
    }

    /**
     * Checks if the current token is expired or will expire soon.
     *
     * @return true if token needs refresh, false otherwise
     */
    private boolean isTokenExpired() {
        if (currentToken == null || tokenExpiry == null) {
            return true;
        }
        Instant refreshThreshold = tokenExpiry.minus(TOKEN_REFRESH_BUFFER);
        return Instant.now(clock).isAfter(refreshThreshold);
    }

    /**
     * Refreshes the access token using the credentials.
     *
     * @throws IOException if token refresh fails
     */
    private void refreshToken() throws IOException {
        logger.debug("Refreshing GCP IAM access token");
        credentials.refresh();

        com.google.auth.oauth2.AccessToken accessToken = credentials.getAccessToken();
        if (accessToken == null) {
            throw new IOException("Failed to obtain access token from credentials");
        }

        this.currentToken = accessToken.getTokenValue();

        // Calculate expiry time
        if (accessToken.getExpirationTime() != null) {
            this.tokenExpiry = accessToken.getExpirationTime().toInstant();
        } else {
            // Default to 1 hour if no expiry info available
            this.tokenExpiry = Instant.now(clock).plus(Duration.ofHours(1));
        }

        logger.debug("GCP IAM token refreshed successfully, expires at: {}", tokenExpiry);
    }

    /**
     * Gets the expiry time of the current token.
     *
     * @return the instant when the current token expires
     */
    public Instant getTokenExpiry() {
        return tokenExpiry;
    }
}

