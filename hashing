  @BeforeEach
  void setUp() {

    userConfigResponseDTO = UserConfigResponseDTO.builder().location(LocationConfigDTO.builder().uspsConfiguration(USPSConfigDTO.builder().uspsProfileCode("USPSCardinal").build()).build()).build();

    validRequest = getAddressValidationRequest();

    Address address = validRequest.getAddress();

    responseDTO = new AddressValidationResponseDTO();
    responseDTO.setAddressValid(true);
    responseDTO.setProfile(validRequest.getProfileCode());

    AddressToValidate addressToValidate = new AddressToValidate();

    addressToValidate.setAddressLines(address.getAddressLines());
    addressToValidate.setCity(address.getCity());
    addressToValidate.setState(address.getState());
    addressToValidate.setCountryCode(address.getCountry());
    addressToValidate.setResidential(address.isResidential());

    responseDTO.setAddressToValidate(addressToValidate);

    AddressSuggestion as = new AddressSuggestion();

    as.setAddressLines(address.getAddressLines());
    as.setCity(address.getCity());
    as.setState(address.getState());
    as.setCountryCode(address.getCountry());
    as.setName(address.getName());
    as.setPostalCode(address.getZipCode());
    as.setResidential(address.isResidential());

    responseDTO.setAddressSuggestions(Arrays.asList(as));

    response = new AddressValidationResponse();

    response.setMessage("Validated");

    validRequest2 = new AddressValidationRequest();

    validRequest2.setAddress(address);
    validRequest2.setProfileCode("f8e385fd-234e-4bd5-bfb5-6e6c04433b08");
    validRequest2.setShippingProfile(null);

    invalidRequest = new AddressValidationRequest();
  }

