import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.FEDEX;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.FEDEX_PREFERRED;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.FEDEX_PREMIUM;

@Component
@Slf4j
@RequiredArgsConstructor
public class SubscriptionAccessValidator {
    private final PremiumFeatureService premiumFeatureService;

    public PremiumFeatureResponse validatePremiumFeatureAccess(String facilityId) {
        if (CommonUtil.isInvalidUUID(facilityId)) {
            throw new ValidationException(ErrorCommonConstant.INVALID_FACILITY_ID);
        }

        var premiumFeatureResponse = premiumFeatureService.getPremiumFeatureDetails(facilityId, true, null);
        if (Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorNone())) {
            throw new AccessDeniedException(ErrorCommonConstant.ACCESS_DENIED);
        }
        return premiumFeatureResponse;
    }

    public void validateShipBookRequestBasedOnSubscription(ShipmentBookRequest shipmentBookRequest, PremiumFeatureResponse premiumFeatureResponse) {
        var isBeaconPlus = Boolean.TRUE.equals(premiumFeatureResponse.getBeaconPlus());
        var isNavigatorPlus = Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorPlus());

        if (!isBeaconPlus) {
            validateBeaconFeatureAccess(shipmentBookRequest);
        }
        if (!isNavigatorPlus) {
            validateNavigatorFeatureAccess(shipmentBookRequest);
        }
        if (shipmentBookRequest.getAdditionalAccessorial() != null) {
            validateInterventionService(shipmentBookRequest, premiumFeatureResponse);
            validateSMSNotificationFeature(shipmentBookRequest, premiumFeatureResponse);
        }
    }

    private void validateNavigatorFeatureAccess(ShipmentBookRequest shipmentBookRequest) {
        var carrier = shipmentBookRequest.getShippingProfile();
        if (carrier != null && !FEDEX.equalsIgnoreCase(carrier)) {
            throw new ValidationException("Only FedEx carrier is allowed for Navigator.");
        }
    }

    private void validateBeaconFeatureAccess(ShipmentBookRequest shipmentBookRequest) {
        validatePackagingDetails(shipmentBookRequest);

        var accessorial = shipmentBookRequest.getAdditionalAccessorial();
        if (accessorial != null) {
            validateSmsNotification(accessorial);
        }
    }

    private void validateSmsNotification(AdditionalAccessorial accessorial) {
        if (accessorial.isSubscribeToSmsUpdate()) {
            throw new ValidationException("SMS subscription is only available for Beacon Plus.");
        }
        if (accessorial.getSmsNotification() != null && !accessorial.getSmsNotification().isEmpty()) {
            throw new ValidationException("SMS Notification is only available for Beacon Plus.");
        }
    }

    private void validatePackagingDetails(ShipmentBookRequest shipmentBookRequest) {
        shipmentBookRequest.getPackagingDetails().forEach(packagingDetail -> {
            var packaging = packagingDetail.getPackaging();
            if (packaging == null) {
                return;
            }
            var hcidCode = packaging.getHcidCode();
            if (hcidCode != null && !hcidCode.isEmpty()) {
                throw new ValidationException("HCID Code is only available for Beacon Plus.");
            }
        });
    }

    private void validateInterventionService(ShipmentBookRequest shipmentBookRequest, PremiumFeatureResponse premiumFeatureResponse) {
        var carrier = shipmentBookRequest.getShippingProfile();
        var intervention = shipmentBookRequest.getAdditionalAccessorial().getInterventionService();
        var isInterventionServiceSetup = Boolean.TRUE.equals(premiumFeatureResponse.getInterventionServicesSetup());

        if (carrier == null || intervention == null || intervention.isEmpty()) {
            return;
        }

        List<String> validInterventions = Arrays.asList(FEDEX_PREFERRED, FEDEX_PREMIUM);

        if (isInterventionServiceSetup) {
            if (FEDEX.equalsIgnoreCase(carrier)) {
                if (!validInterventions.contains(intervention)) {
                    throw new ValidationException("Invalid intervention service for FedEx. Allowed: " + validInterventions);
                }
            } else {
                throw new ValidationException("Intervention must be empty or null for non-FedEx carriers.");
            }
        } else {
            throw new ValidationException("Intervention service is not allowed.");
        }
    }

    /**
     * Validates SMS notification feature based on subscription
     *
     * @param shipmentBookRequest    Shipment book request
     * @param premiumFeatureResponse Premium feature response
     */
    private void validateSMSNotificationFeature(ShipmentBookRequest shipmentBookRequest,
                                                PremiumFeatureResponse premiumFeatureResponse) {
        AdditionalAccessorial accessorial = shipmentBookRequest.getAdditionalAccessorial();
        if (accessorial.isSubscribeToSmsUpdate()) {
            if (!Boolean.TRUE.equals(premiumFeatureResponse.getSmsNotificationsEnabled())) {
                throw new ValidationException("SMS notification is disabled for this billing group");
            }

            if (CollectionUtils.isEmpty(accessorial.getSmsNotification())) {
                throw new ValidationException("At least one SMS notification type and phone number must be selected when subscribing to SMS updates");
            }
        }
    }

    public void validatePremiumFeatureAccessForNavigatorApi(String facilityId) {
        if (CommonUtil.isInvalidUUID(facilityId)) {
            throw new ValidationException(ErrorCommonConstant.INVALID_FACILITY_ID);
        }

        var premiumFeatureResponse = premiumFeatureService.getPremiumFeatureDetails(facilityId, true, null);
        if (Boolean.FALSE.equals(premiumFeatureResponse.getNavigatorPlus())) {
            throw new AccessDeniedException(ErrorCommonConstant.ACCESS_DENIED);
        }
    }
}

