  public static String addDaysToCurrentDateTime(int daysToAdd) {
    long toAdd = daysToAdd * 86400000L;
    Instant instant = Instant.ofEpochMilli(System.currentTimeMillis() + toAdd);
    DateTimeFormatter formatter =
        DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'")
            .withZone(ZoneId.systemDefault());

