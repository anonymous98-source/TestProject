import com.cardinalhealth.adv.shipping.integration.api.database.entity.RuleEngineFields;
import com.cardinalhealth.adv.shipping.integration.api.database.repository.RuleEngineFieldsRepository;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.RuleOperatorsCompatibility;
import lombok.Getter;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import javax.annotation.PostConstruct;
import java.util.Collections;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Objects;
import java.util.stream.Collectors;

@Component
@RequiredArgsConstructor
public class CompoundValidationData {
    private final RuleEngineFieldsRepository ruleEngineFieldsRepository;
    @Getter
    private Map<String, List<String>> operatorMapping;
    @Getter
    private Map<String, String> regexMapping;
    @Getter
    private Map<String, String> typeMapping;

    List<RuleEngineFields> ruleEngineFieldsList;

    @PostConstruct
    public void init() {
        operatorMapping = getOperatorAndFieldsMapping();
        regexMapping = getFieldAndRegexMapping();
        typeMapping = getFieldAndTypeMapping();
    }

    private Map<String, List<String>> getOperatorAndFieldsMapping() {
        ruleEngineFieldsList = ruleEngineFieldsRepository.findAll();
        if (ruleEngineFieldsList.isEmpty()) {
            return Collections.emptyMap();
        }

        return ruleEngineFieldsList.stream()
                .filter(Objects::nonNull)
                .filter(field -> field.getKey() != null)
                .collect(Collectors.toMap(
                        field -> field.getKey().toLowerCase(Locale.ROOT),
                        field -> field.getRuleOperatorsCompatibilities() == null
                                ? Collections.emptyList()
                                : field.getRuleOperatorsCompatibilities().stream()
                                .filter(Objects::nonNull)
                                .map(RuleOperatorsCompatibility::getOperator)
                                .filter(Objects::nonNull)
                                .distinct()
                                .toList()
                ));
    }

    private Map<String, String> getFieldAndRegexMapping() {
        if (ruleEngineFieldsList.isEmpty()) {
            return Collections.emptyMap();
        }

        return ruleEngineFieldsList.stream()
                .filter(Objects::nonNull)
                .filter(field -> field.getKey() != null)
                .flatMap(field -> {
                    if (field.getRuleOperatorsCompatibilities() == null) {
                        return java.util.stream.Stream.empty();
                    }

                    return field.getRuleOperatorsCompatibilities().stream()
                            .filter(Objects::nonNull)
                            .filter(compatibility -> compatibility.getOperator() != null)
                            .filter(compatibility -> compatibility.getRegex() != null)
                            .map(compatibility -> Map.entry(
                                    field.getKey().toLowerCase(Locale.ROOT) + "#" + compatibility.getOperator().toLowerCase(Locale.ROOT),
                                    compatibility.getRegex()
                            ));
                })
                .collect(Collectors.toMap(
                        Map.Entry::getKey,
                        Map.Entry::getValue
                ));
    }

    private Map<String, String> getFieldAndTypeMapping() {
        if (ruleEngineFieldsList.isEmpty()) {
            return Collections.emptyMap();
        }

        return ruleEngineFieldsList.stream()
                .filter(Objects::nonNull)
                .filter(field -> field.getKey() != null && field.getType() != null)
                .collect(Collectors.toMap(
                        field -> field.getKey().toLowerCase(Locale.ROOT),
                        field -> field.getType().toLowerCase(Locale.ROOT)
                ));
    }




}

