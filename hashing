                .setMessage("All address counts are fetched")
                .log();

        return AllContactsResponseDTO.builder()
                .searchResultsCount(searchResultsCount)
                .allContactsCount(addressCountMap.get(AddressBookConstants.ALL_ADDRESS_COUNT))
                .favouriteAddressCount(addressCountMap.get(AddressBookConstants.FAVOURITE_ADDRESS_COUNT))
                .totalRecentAddresses(addressCountMap.get(AddressBookConstants.RECENT_ADDRESS_COUNT))
                .isLast(isLast)
                .addresses(shipToAddressResponseDtoPage)
                .build();
