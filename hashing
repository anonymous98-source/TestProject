                                    .deliveryNotes(s.getDeliveryNotes())
                                    .extension(s.getExtension())
                                    .isResidentialAddress(s.isResidentialAddress())
                                    .build())
                            .toList();


                    StringWriter stringWriter = new StringWriter();
                    CSVPrinter printer = csvGenerator.createPrinter(stringWriter);

                    if (isFirstChunk) {
                        csvGenerator.writeHeader(printer);
                        isFirstChunk = false;
                    }

                    csvGenerator.writeRows(dtos, printer);
                    printer.flush();

                    sink.next(stringWriter.toString());

                    page++;
                }
                sink.complete();
            } catch (Exception e) {sink.error(e);
            }
        });
    }
