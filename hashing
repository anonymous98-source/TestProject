@Service
@Slf4j
@RequiredArgsConstructor
public class CompoundRuleEvaluationServiceImpl implements CompoundRuleEvaluationService {

    private final RuleDefinitionRepository repository;
    private final CompoundRuleServiceUtils ruleServiceUtils;
    private final ShippingProfileRepository shippingProfileRepository;
    private final OCMWebClientService ocmWebClientService;
    private final CustomAsyncConfigProvider customExecutor;
    private final CompoundRuleValidator validator;
    private final ConditionValueValidator conditionValueValidator;
    private final CompoundValidationData compoundValidationData;

    /**
     * Evaluates compound rules based on the provided request and user principal.
     *
     * @param request   The compound rule evaluation request DTO containing the necessary parameters for
     *                  evaluation.
     * @param userEmail The user principal representing the authenticated user making the request.
     * @return A CompoundRuleEvaluationResponseDto containing the evaluation results, including
     * selected shipping profile and trace information.
     */
    @Override
    public CompoundRuleEvaluationResponseDto evaluate(
            CompoundRuleEvaluationRequestDto request, String userEmail) {

        long currentTime = System.currentTimeMillis();
        request.setRuleType(RuleType.COMPOUND);
        if (!request.isAutomation() || StringUtils.isNotBlank(userEmail)) {
            validator.validateUserAuthorization(
                    userEmail, request.getFacilityId(), request.getCustomerId());
        }
        ShippingRuleCommonUtils.validateZipcode(request.getZipCode());
        validateContextFields(request.getContext());

        RuleEvaluationTraceDto.RuleEvaluationTraceDtoBuilder ruleEvaluationTraceDto =
                RuleEvaluationTraceDto.builder();
        List<EvaluationRuleDto> evaluationRules = new ArrayList<>();
        EvaluationRuleDto.EvaluationRuleDtoBuilder evaluationRuleDto = EvaluationRuleDto.builder();

        List<RuleDefinition> rules =
                repository.findByCustomerIdAndFacilityIdAndRuleTypeAndActiveTrueOrderByPriorityAsc(
                        request.getCustomerId(), request.getFacilityId(), COMPOUND_RULE);

        StandardEvaluationContext context =
                ruleServiceUtils.standardEvaluationContext(request.getContext());

        if (Objects.nonNull(context)) {
            ShippingProfileResponseDTO shippingProfileResponseDTO;
            // Courier eligibility check is done based on the zip code, so we need to fetch the zip code
            // details from OCM asynchronously
            CompletableFuture<ZipCodeDetails> zipCodeDetailsFuture =
                    CompletableFuture.supplyAsync(
                            () ->
                                    ocmWebClientService.getSingleZipCodeConfigDataFromOCM(
                                            Long.parseLong(request.getZipCode().substring(0, 5)),
                                            request.getFacilityId()),
                            customExecutor.getExecutor());
            // Get carrier access (FedEx, USPS, DHL) for facility
            CompletableFuture<UserConfigResponseDTO> userConfigResponseDTOFuture =
                    CompletableFuture.supplyAsync(
                            () ->
                                    ocmWebClientService.getUserConfigDataFromOCM(
                                            request.getFacilityId(), request.getCustomerId()),
                            customExecutor.getExecutor());
            // Get city and state from zipcode
            CompletableFuture<ZipCodeLocationDto> zipCodeLocationDtoFuture =
                    CompletableFuture.supplyAsync(
                            () ->
                                    ocmWebClientService.fetchLocationByZipCode(request.getZipCode().substring(0, 5)),
                            customExecutor.getExecutor());

            ZipCodeDetails zipCodeDetails = zipCodeDetailsFuture.join();
            UserConfigResponseDTO userConfigResponseDTO = userConfigResponseDTOFuture.join();
            if (userConfigResponseDTO == null || userConfigResponseDTO.getLocation() == null) {
                throw new ResourceNotFoundException(
                        "User Config not found for facilityId: " + request.getFacilityId());
            }
            ZipCodeLocationDto zipCodeLocationDto = zipCodeLocationDtoFuture.join();

            // Fetching the Zipcode City and state from OCM to validate the carrier eligibility based on
            // the location
            OCMResponse ocmResponse =
                    ruleServiceUtils.getAllCarrierAccess(
                            zipCodeLocationDto, userConfigResponseDTO, zipCodeDetails);

            if (!ruleServiceUtils.isPreferredRule(request)) {
                evaluationRuleDto.skipReason(PREFERRED_RULE_NOT_FOUND).skip(true);
                evaluationRules.add(evaluationRuleDto.build());
                ruleEvaluationTraceDto.rules(evaluationRules);
                ruleEvaluationTraceDto.status(CompoundRuleConstants.UNRESOLVED);
                return ruleServiceUtils.getDefaultResponse(
                        request,
                        null,
                        ocmResponse,
                        PREFERRED_RULE_NOT_FOUND,
                        ruleEvaluationTraceDto.build(),
                        System.currentTimeMillis() - currentTime);
            }
            if (CollectionUtils.isEmpty(rules)) {
                evaluationRuleDto.skipReason(RULES_NOT_FOUND).skip(true);
                evaluationRules.add(evaluationRuleDto.build());
                ruleEvaluationTraceDto.rules(evaluationRules);
                ruleEvaluationTraceDto.status(CompoundRuleConstants.UNRESOLVED);
                return ruleServiceUtils.getDefaultResponse(
                        request,
                        null,
                        ocmResponse,
                        RULES_NOT_FOUND,
                        ruleEvaluationTraceDto.build(),
                        System.currentTimeMillis() - currentTime);
            }

            for (RuleDefinition rule : rules) {

                evaluationRuleDto =
                        EvaluationRuleDto.builder()
                                .ruleId(rule.getId().toString())
                                .ruleExpression(rule.getExpression())
                                .rulePriority(rule.getPriority());

                if (rule.getShippingProfileId() == null) {
                    evaluationRuleDto.skipReason(RULE_SHIPPING_PROFILE_ID_BLANK).skip(true);
                    evaluationRules.add(evaluationRuleDto.build());
                    continue;
                }

                boolean matched =
                        ruleServiceUtils.evaluate(
                                rule.getExpression(), context, evaluationRuleDto, evaluationRules);

                if (matched) {
                    shippingProfileResponseDTO = fetchShippingProfileById(rule.getShippingProfileId());
                    AssignedShippingProfile assignedShippingProfile =
                            ruleServiceUtils.validateShippingProfile(
                                    shippingProfileResponseDTO, ocmResponse.getCarrierAccessibilityMap());

                    if (!isNotEligibleShippingProfile(
                            shippingProfileResponseDTO,
                            zipCodeDetails,
                            userConfigResponseDTO,
                            evaluationRuleDto,
                            request,
                            assignedShippingProfile,
                            evaluationRules)) {
                        Details details =
                                new Details(
                                        rule.getId().toString(),
                                        shippingProfileResponseDTO.getId().toString(),
                                        shippingProfileResponseDTO.getShippingProfileName());
                        evaluationRules.add(
                                evaluationRuleDto
                                        .selectedProfileId(shippingProfileResponseDTO.getId().toString())
                                        .skip(false)
                                        .build());
                        ruleEvaluationTraceDto.status(CompoundRuleConstants.RESOLVED);
                        ruleEvaluationTraceDto.details(details);
                        ruleEvaluationTraceDto.rules(evaluationRules);
                        return getEvaluationResponseDto(
                                request,
                                rule,
                                ocmResponse,
                                assignedShippingProfile,
                                ruleEvaluationTraceDto.build(),
                                System.currentTimeMillis() - currentTime);
                    }
                }
            }
            ruleEvaluationTraceDto.rules(evaluationRules);
            ruleEvaluationTraceDto.status(CompoundRuleConstants.UNRESOLVED);
            return ruleServiceUtils.getDefaultResponse(
                    request,
                    null,
                    ocmResponse,
                    RULE_NOT_ELIGIBLE,
                    ruleEvaluationTraceDto.build(),
                    System.currentTimeMillis() - currentTime);
        }
        return null;
    }

    private void validateContextFields(Map<String, Object> context) {
        Set<String> fieldList = compoundValidationData.getTypeMapping().keySet();

        // Validate the context keys and values in the request against the allowed field list
        context.keySet().stream()
                .filter(
                        key ->
                                !StringUtils.isBlank(key)
                                        && fieldList.contains(key.toLowerCase(Locale.ROOT))
                                        && context.get(key) != null
                                        && !context.get(key).toString().isBlank())
                .forEach(
                        key -> {
                            if (key.equals(CompoundRuleConstants.SHIP_DAY_KEY)) {
                                boolean isValid =
                                        conditionValueValidator.isValueValidForKey(
                                                key.toLowerCase(Locale.ROOT),
                                                RuleOperator.IS_ONE_OF.name().toLowerCase(Locale.ROOT),
                                                context.get(CompoundRuleConstants.SHIP_DAY_KEY));
                                if (!isValid) {
                                    throw new ValidationException(
                                            "Invalid value or dataType for key: "
                                                    + key
                                                    + " with value: "
                                                    + context.get(key));
                                }
                            } else {
                                boolean isValid =
                                        conditionValueValidator.isValueValidForKey(
                                                key.toLowerCase(Locale.ROOT),
                                                RuleOperator.IS.name().toLowerCase(Locale.ROOT),
                                                context.get(key));
                                if (!isValid) {
                                    throw new ValidationException(
                                            "Invalid value or dataType for key: "
                                                    + key
                                                    + " with value: "
                                                    + context.get(key));
                                }
                            }
                        });
    }

    private CompoundRuleEvaluationResponseDto getEvaluationResponseDto(
            CompoundRuleEvaluationRequestDto request,
            RuleDefinition rule,
            OCMResponse ocmResponse,
            AssignedShippingProfile assignedShippingProfile,
            RuleEvaluationTraceDto ruleEvaluationTraceDto,
            Long evaluationTimeTaken) {
        return ruleServiceUtils.getResolvedResponse(
                request,
                rule,
                assignedShippingProfile,
                ocmResponse,
                ruleEvaluationTraceDto,
                evaluationTimeTaken);
    }

    boolean isNotEligibleShippingProfile(
            ShippingProfileResponseDTO shippingProfileResponseDTO,
            ZipCodeDetails zipCodeDetails,
            UserConfigResponseDTO userConfigResponseDTO,
            EvaluationRuleDto.EvaluationRuleDtoBuilder evaluationRuleDto,
            CompoundRuleEvaluationRequestDto request,
            AssignedShippingProfile assignedShippingProfile,
            List<EvaluationRuleDto> evaluationRules) {
        if (shippingProfileResponseDTO == null) return true;
        if (assignedShippingProfile == null) {
            evaluationRuleDto.skipReason(SHIPPING_PROFILE_NOT_RESOLVED).skip(true);
            evaluationRules.add(evaluationRuleDto.build());
            return true;
        }
        String carrier =
                shippingProfileResponseDTO.getCarrier() != null
                        ? shippingProfileResponseDTO.getCarrier().toLowerCase()
                        : "";

        if (!isCarrierEnabledByLocation(userConfigResponseDTO, carrier)) {
            evaluationRuleDto.skipReason(CARRIERS_ARE_NOT_ENABLED_FACILITY).skip(true);
            evaluationRules.add(evaluationRuleDto.build());
            return true;
        }

        if (isNotEligibleCarrierByZipCode(carrier, zipCodeDetails)) {
            evaluationRuleDto.skipReason(CARRIERS_ARE_NOT_ENABLED_ZIPCODE).skip(true);
            evaluationRules.add(evaluationRuleDto.build());
            return true;
        }
        if (!StringUtils.isBlank(shippingProfileResponseDTO.getFacilityId())
                && !StringUtils.isBlank(shippingProfileResponseDTO.getType())
                && !getShipmentType(request.getShipmentType())
                .equalsIgnoreCase(shippingProfileResponseDTO.getType())) {
            evaluationRuleDto.skipReason(SHIPPING_PROFILE_TYPE_NOT_MATCHED).skip(true);
            evaluationRules.add(evaluationRuleDto.build());
            return true;
        }

        return false;
    }

    boolean isNotEligibleCarrierByZipCode(String carrier, ZipCodeDetails zipCodeDetails) {
        if (carrier == null || zipCodeDetails == null) return false;
        if (carrier.equalsIgnoreCase(COURIER_SAME_DAY)
                && !Boolean.TRUE.equals(zipCodeDetails.getSameday())) {
            return true;
        }
        if (carrier.equalsIgnoreCase(COURIER_NEXT_DAY)
                && !Boolean.TRUE.equals(zipCodeDetails.getNextday())) {
            return true;
        }
        if (carrier.equalsIgnoreCase(COURIER_SAME_DAY_STATE)
                && !Boolean.TRUE.equals(zipCodeDetails.getSamedayState())) {
            return true;
        }
        return false;
    }

    private boolean isCarrierEnabledByLocation(
            UserConfigResponseDTO userConfigResponseDTO, String carrier) {
        return switch (carrier) {
            case FEDEX_LOWER_CASE -> Boolean.TRUE.equals(
                    userConfigResponseDTO.getLocation().getFedexConfiguration() != null
                            ? userConfigResponseDTO.getLocation().getFedexConfiguration().getFedexAccess()
                            : null);
            case USPS_LOWER_CASE -> Boolean.TRUE.equals(
                    userConfigResponseDTO.getLocation().getUspsConfiguration() != null
                            ? userConfigResponseDTO.getLocation().getUspsConfiguration().getUspsAccess()
                            : null);
            case DHL_LOWER_CASE -> Boolean.TRUE.equals(
                    userConfigResponseDTO.getLocation().getDhlConfiguration() != null
                            ? userConfigResponseDTO.getLocation().getDhlConfiguration().getDhlAccess()
                            : null);
            // Courier availability is validated via zipcode flags in isNotEligibleCarrierByZipCode(...)
            case COURIER_SAME_DAY, COURIER_NEXT_DAY, COURIER_SAME_DAY_STATE -> true;
            default -> false;
        };
    }

    public ShippingProfileResponseDTO fetchShippingProfileById(UUID shippingProfileId) {

        log.atInfo().setMessage("calling db to fetch the shipping profile data").log();

        ShippingProfile shippingProfile =
                shippingProfileRepository
                        .findById(shippingProfileId)
                        .orElseThrow(
                                () ->
                                        new ResourceNotFoundException(
                                                "shipping profile not found for id: " + shippingProfileId));

        return mapToShippingProfileDto(shippingProfile);
    }

    private ShippingProfileResponseDTO mapToShippingProfileDto(ShippingProfile shippingProfile) {

        return ShippingProfileResponseDTO.builder()
                .id(shippingProfile.getId())
                .shippingProfileName(shippingProfile.getShippingProfileName())
                .type(shippingProfile.getType())
                .facilityId(shippingProfile.getFacilityId())
                .carrier(shippingProfile.getCarrier())
                .build();
    }

    private String getShipmentType(String shipmentType) {
        if (CompoundRuleConstants.FORWARD.equalsIgnoreCase(shipmentType)) {
            return CompoundRuleConstants.SMALL_PARCEL_SHIPMENT;
        } else if (CompoundRuleConstants.RETURN.equalsIgnoreCase(shipmentType)) {
            return CompoundRuleConstants.RETURN_LABEL;
        }
        return "";
    }
