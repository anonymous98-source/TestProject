            }

            Map<String, String> customerDetails =
                    customerHierarchyServiceImpl.getCustomerHierarchyDetailsForBook(
                            shipmentBookRequest.getFacilityId());
            //calling the userDefaultService cause that is where we get if the customer is an epic customer
            List<UserDefaultsResponse> userDefaultsResponses =
                    userDefaultsService.getDefaultValues(oflUserPrincipal, shipmentBookRequest.getFacilityId());

            // Convert the shipment booking request to a CMS request
            CmsBookRequest cmsBookRequest =mapperUtil.mapToCmsBookRequestFromShipmentBookRequest(shipmentBookRequest,requestId,shipmentBookRequest.getFacilityId());
            // Call the CMS API to submit the order
            CmsBookResponse cmsBookResponse=cmsWebClient.cmsSubmitOrderApicall(ObjectMapperUtils.toJson(cmsBookRequest),requestId,httpHeaders);
            //call to persist
            var customShipmentId = UUID.randomUUID().toString();
            // call Tracking resource to persist shipment data for CMS carrier
            NewShipmentResourceDto newShipmentResourceDto = advShippingBookDataPersistService.persistShipmentBookDataToTrackingResource(
                    cmsBookResponse, shipmentBookRequest, userDto, customerDetails, customShipmentId, userDefaultsResponses.get(0), premiumFeatureDetails);

            //call to publish the shipment to epic
            boolean publishStatus = shipBookPublisherService.publishShipmentToEpic(newShipmentResourceDto.getShipmentDto(), oflUserPrincipal,
                    premiumFeatureDetails, shipmentBookRequest);
