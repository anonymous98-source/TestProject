import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Slf4j
@Component
public class RuleExecutionChain {
    private final Map<RuleType, RuleTypeStrategy> strategies;

    public RuleExecutionChain(List<RuleTypeStrategy> listOfStrategy) {
        this.strategies = listOfStrategy.stream()
                .collect(Collectors.toMap(RuleTypeStrategy::supports, Function.identity()));
    }

    public RuleEvaluationResult execute(RuleEvaluationRequestDto request) {
        log.atInfo()
                .setMessage("Processing the rule evaluation for ruleType: " + request.getRuleType())
                .log();

        RuleTypeStrategy strategy = strategies.get(request.getRuleType());
        if (strategy == null) {
            throw new IllegalArgumentException("No strategy found for rule type: " + request.getRuleType());
        }
        return strategy.evaluate(request);
    }
}

