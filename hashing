package com.cardinalhealth.adv.shipping.integration.api.service.impl;

import com.cardinalhealth.adv.shipping.integration.api.database.entity.Hcid;
import com.cardinalhealth.adv.shipping.integration.api.database.repository.HcidRepository;
import jakarta.annotation.PostConstruct;
import org.springframework.stereotype.Service;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

@Service
public class HcidService {

    private static HcidRepository staticHcidRepository;

    private static Map<String, String> hcidCodeToApiValueMap = new HashMap<>();

    private final HcidRepository hcidRepository;

    public HcidService(HcidRepository hcidRepository) {
        this.hcidRepository = hcidRepository;
    }

    @PostConstruct
    public void init() {
        synchronized (HcidService.class) {
            if (staticHcidRepository != null) {
                return;
            }
            staticHcidRepository = hcidRepository;
            loadHcidData();
        }
    }

    private static void loadHcidData() {
        List<Hcid> allHcids = staticHcidRepository.findAll();
        hcidCodeToApiValueMap = allHcids.stream()
                .collect(Collectors.toMap(Hcid::getCode, Hcid::getApivalue));
    }

    public static String getApiValue(String code) {
        return hcidCodeToApiValueMap.get(code);
    }

    public static Map<String, String> getAllMappings() {
        return hcidCodeToApiValueMap;
    }
}

