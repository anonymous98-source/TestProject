package com.cardinalhealth.adv.shipping.integration.api.database.repository;

import com.cardinalhealth.adv.shipping.integration.api.database.dto.ShipToAddressFacilityMappingWithFavorite;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddress;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddressFacilityMapping;
import com.cardinalhealth.adv.shipping.integration.api.database.entity.ShipToAddressFavorite;
import jakarta.persistence.EntityManager;
import jakarta.persistence.Tuple;
import jakarta.persistence.TypedQuery;
import jakarta.persistence.criteria.*;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageImpl;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.List;
import java.util.UUID;

@Repository
@RequiredArgsConstructor
@Transactional(readOnly = true)
public class ShipToAddressFacilityMappingCustomRepository {
    private static final String USER = "user";
    private static final String SHIP_TO_ADDRESS = "shipToAddress";
    private static final String ID= "id";
    private static final String SHIP_TO_ADDRESS_FAVORITE = "shipToAddressFavorite";
    private static final String ASC="ASC";

    private final EntityManager entityManager;
    private static final String MONARCH_SHIP_FROM_FACILITY_ID = "monarchShipFromFacilityId";

    public Page<ShipToAddressFacilityMappingWithFavorite> findByFacilityId(
            String facilityId, UUID userId, String sortingColumn, String sortingDirection, String search, Pageable pageable) {

        CriteriaBuilder cb = entityManager.getCriteriaBuilder();
        CriteriaQuery<Tuple> query = cb.createTupleQuery();
        Root<ShipToAddressFacilityMapping> root = query.from(ShipToAddressFacilityMapping.class);

        // INNER JOIN with ShipToAddress
        Join<ShipToAddressFacilityMapping, ShipToAddress> addressJoin = root.join(SHIP_TO_ADDRESS, JoinType.INNER);

        // Base predicate for facility ID (always needed)
        Predicate facilityCondition = cb.equal(root.get(MONARCH_SHIP_FROM_FACILITY_ID), facilityId);

        List<Predicate> predicates = new ArrayList<>();
        predicates.add(facilityCondition);

        // Incorporate search logic
        if (search != null && search.length() >= 3) {
            predicates.add(buildSearchPredicate(cb, addressJoin, search));
        }
        Expression<Boolean> isFavoriteExpr = cb.literal(false);
        if(userId != null) {
            // LEFT JOIN with ShipToAddressFavorite only when userId is provided
            Join<ShipToAddressFacilityMapping, ShipToAddressFavorite> favoriteJoin = root.join(SHIP_TO_ADDRESS_FAVORITE, JoinType.LEFT);

            // Add the join conditions
            Predicate joinCondition = cb.equal(favoriteJoin.get(USER).get(ID), userId);

            // Apply the join condition
            favoriteJoin.on(joinCondition);

            // CASE statement for is_favorite
            isFavoriteExpr = cb.<Boolean>selectCase()
                    .when(cb.isNotNull(favoriteJoin.get(USER).get(ID)), true)
                    .otherwise(false);


        }
        query.multiselect(root, isFavoriteExpr);
        query.where(cb.and(predicates.toArray(new Predicate[0])));

        // Handling Sorting Dynamically
        if (sortingColumn != null && sortingDirection != null) {
            Path<?> sortPath = addressJoin.get(sortingColumn);
            Order order = sortingDirection.equalsIgnoreCase(ASC) ? cb.asc(sortPath) : cb.desc(sortPath);
            query.orderBy(order);
        }

        // Pagination handling
        TypedQuery<Tuple> typedQuery = entityManager.createQuery(query);
        typedQuery.setFirstResult((int) pageable.getOffset()); // Offset for pagination
        typedQuery.setMaxResults(pageable.getPageSize()); // Page size limit

        // Getting results
        List<ShipToAddressFacilityMappingWithFavorite> results = typedQuery.getResultList().stream()
                .map(tuple -> new ShipToAddressFacilityMappingWithFavorite(
                        tuple.get(0, ShipToAddressFacilityMapping.class),
                        tuple.get(1, Boolean.class)
                ))
                .toList();
        // Returning as pageable format
        return new PageImpl<>(results, pageable, getSearchResultsCount(facilityId, search));
    }

    public Long getSearchResultsCount(String facilityId, String search) {
        CriteriaBuilder cb = entityManager.getCriteriaBuilder();
        CriteriaQuery<Long> countQuery = cb.createQuery(Long.class);
        Root<ShipToAddressFacilityMapping> countRoot = countQuery.from(ShipToAddressFacilityMapping.class);

        // INNER JOIN with ShipToAddress for search
        Join<ShipToAddressFacilityMapping, ShipToAddress> addressJoin = countRoot.join(SHIP_TO_ADDRESS, JoinType.INNER);

        // Base predicate for facility ID
        List<Predicate> predicates = new ArrayList<>();
        predicates.add(cb.equal(countRoot.get(MONARCH_SHIP_FROM_FACILITY_ID), facilityId));

        // Add search predicates if search parameter exists
        if (search != null && search.length() >= 3) {
            predicates.add(buildSearchPredicate(cb, addressJoin, search));
        }

        // Apply all predicates
        countQuery.where(cb.and(predicates.toArray(new Predicate[0])));

        // Select count
        countQuery.select(cb.count(countRoot));

        // Execute and return the count
        return entityManager.createQuery(countQuery).getSingleResult();
    }

    public Long findAllContactCount(String facilityId) {
        CriteriaBuilder cb = entityManager.getCriteriaBuilder();
        CriteriaQuery<Long> countQuery = cb.createQuery(Long.class);
        Root<ShipToAddressFacilityMapping> countRoot = countQuery.from(ShipToAddressFacilityMapping.class);
        countQuery.where(cb.equal(countRoot.get(MONARCH_SHIP_FROM_FACILITY_ID), facilityId));
        countQuery.select(cb.count(countRoot));
        return entityManager.createQuery(countQuery).getSingleResult();
    }

    private Predicate buildSearchPredicate(CriteriaBuilder cb,
                                           Join<ShipToAddressFacilityMapping, ShipToAddress> addressJoin,
                                           String search) {

        List<Predicate> searchPredicates = new ArrayList<>();
        String searchTerm = "%" + search.toLowerCase() + "%";

        List<String> searchFields = List.of(
                "addressName", "company", "addressLine1", "addressLine2",
                "addressLine3", "city", "zipCode", "state", "country",
                "phoneNumber", "email", "deliveryNotes", "extension"
        );

        for (String field : searchFields) {
            searchPredicates.add(cb.like(cb.lower(addressJoin.get(field)), searchTerm));
        }

        // Combine all search predicates with OR
        return cb.or(searchPredicates.toArray(new Predicate[0]));
    }
}

