  private ShipmentBookResponseDto getShipmentBookResponseDto(String trackingNumber) {
    List<TrackingNumberDto> trackingNumberDtos = new ArrayList<>();
    trackingNumberDtos.add(TrackingNumberDto.builder().value(trackingNumber).build());

    List<ShippingUnitResponseDto> shippingUnitResponseDtos = new ArrayList<>();
    shippingUnitResponseDtos.add(
        ShippingUnitResponseDto.builder().trackingNumber(trackingNumberDtos).build());

    List<UniqueBoxTypeDto> uniqueBoxTypes = new ArrayList<>();
    uniqueBoxTypes.add(UniqueBoxTypeDto.builder().build());

    return ShipmentBookResponseDto.builder()
        .id(UUID.randomUUID().toString())
        .shippingUnits(shippingUnitResponseDtos)
        .shipmentSummary(
            ShipmentSummaryDto.builder().totalVolume(1).uniqueBoxTypes(uniqueBoxTypes).build())
        .build();
  }

