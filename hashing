                                ? addressSuggestionDto.getContact().getName()
                                : "")
                .phoneNumber(
                        addressSuggestionDto.getContact() != null
                                ? addressSuggestionDto.getContact().getPhone()
                                : "")
                .emailAddress(
                        addressSuggestionDto.getContact() != null
                                ? addressSuggestionDto.getContact().getEmail()
                                : "")
                .residential(addressSuggestionDto.isResidential())
                .build();
      }
    }
    return null;
  }

  /**
   * Retrieves the carrier profile code (USPS, FedEx, or DHL) based on the given carrier and the shipping profile in the request.
   *
   * @param carrier The carrier name (USPS, FedEx, or DHL).
   * @param request The address validation request containing the shipping profile and facility ID.
   * @return The corresponding carrier profile code if the shipping profile matches the carrier, otherwise null.
   */


  private String getProfileCodeByCarrier(String carrier, AddressValidationRequest request) {
    UserConfigResponseDTO ocmResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(request.getFacilityId(), customerHierarchyService.getCustomerIdByFacilityId(request.getFacilityId()));
    if (ocmResponseDTO == null || ocmResponseDTO.getLocation() == null) {
      return null;
    }
    if (USPS.equalsIgnoreCase(carrier) && USPS.equalsIgnoreCase(request.getShippingProfile())) {
      return ocmResponseDTO.getLocation().getUspsConfiguration() != null
              ? ocmResponseDTO.getLocation().getUspsConfiguration().getUspsProfileCode()
              : null;
    } else if (DHL.equalsIgnoreCase(carrier) && DHL.equalsIgnoreCase(request.getShippingProfile())) {
      return ocmResponseDTO.getLocation().getDhlConfiguration() != null
              ? ocmResponseDTO.getLocation().getDhlConfiguration().getDhlProfileCode()
              : null;
    } else if (FEDEX.equalsIgnoreCase(carrier) && !USPS.equalsIgnoreCase(request.getShippingProfile())) {
      return ocmResponseDTO.getLocation().getFedexConfiguration() != null
              ? ocmResponseDTO.getLocation().getFedexConfiguration().getFedexProfileCode()
              : null;
    }
    return null;
  }


  private String fetchProfileCode(AddressValidationRequest request) {
    String shippingProfile = request.getShippingProfile();
    if (USPS.equalsIgnoreCase(shippingProfile)) {
      return getProfileCodeByCarrier(USPS, request);
    } else if (DHL.equalsIgnoreCase(shippingProfile)) {
      return getProfileCodeByCarrier(DHL, request);
    } else if (FEDEX.equalsIgnoreCase(shippingProfile)) {
      return getProfileCodeByCarrier(FEDEX, request);
    }
    return null;
  }

  private AddressValidationResponseDTO buildAddressValidationErrorResponse(
          AddressValidationRequest addressValidationRequest) {

    AddressValidationResponseDTO responseDTO =
            new AddressValidationResponseDTO();

    responseDTO.setAddressValid(false);

    AddressToValidate addressToValidate =
            new AddressToValidate();

    Address address = addressValidationRequest.getAddress();

    if (address != null) {
      addressToValidate.setName(address.getName());
      addressToValidate.setAddressLines(address.getAddressLines());
      addressToValidate.setCity(address.getCity());
      addressToValidate.setState(address.getState());
      addressToValidate.setCountryCode(address.getCountry());
      addressToValidate.setResidential(address.isResidential());
      addressToValidate.setContact(
              Contact.builder()
                      .name(address.getName())
                      .phone(address.getPhoneNumber())
                      .email(address.getEmailAddress())
                      .build());
    }

    responseDTO.setAddressToValidate(addressToValidate);

    return responseDTO;
  }

  private SendFlexRecordDto persistAddressValidationValidationFailure(
          AddressValidationRequestDTO addressValidationRequestDTO,
          ValidationException exception) {

    SendFlexRecordDto sendFlexRecordDto =
            SendFlexRecordDto.builder()
                    .requestObject(addressValidationRequestDTO)
                    .responseObject(exception.getMessage())
                    .statusCode(FAILURE)
                    .apiCode(ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT)
                    .build();

    return sendFlexRecordUtil.saveSendflexRecord(sendFlexRecordDto);
  }

}

