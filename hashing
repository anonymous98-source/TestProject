/**
 * This class is responsible for resolving the shipping profile based on the matched rule definition
 */

@Slf4j
@Component
@RequiredArgsConstructor
public class ShippingProfileResolver {

    private final ShippingProfileRepository shippingProfileRepository;

    /**
     * validate assigned shipping profile and return final "assignedShippingProfile" node.
     * case 1: if profile is not assigned - @return null
     * case 2: if profile is assigned but by any chance profile not found on findById() - @return null
     * case 3: if profile is assigned and found in DB but profile's carrier is not accessible - @return null
     * case 4: ideal case: if profile is assigned and found in DB and profile's carrier is accessible - @return "assignedShippingProfile"
     */
    public AssignedShippingProfile validateShippingProfile(RuleDefinition matchedRule,
                                                           Map<String, Boolean> carrierAccessibilityMap) {

        if (matchedRule.getShippingProfileId() != null) {
            ShippingProfile assignedProfile = shippingProfileRepository.findById(matchedRule.getShippingProfileId())
                    .orElse(null);

            if (assignedProfile != null && Boolean.TRUE.equals(carrierAccessibilityMap.get(assignedProfile.getCarrier()))) {
                return AssignedShippingProfile.builder()
                        .shippingProfileId(assignedProfile.getId())
                        .shippingProfileName(assignedProfile.getShippingProfileName())
                        .carrier(assignedProfile.getCarrier())
                        .build();
            }
        }
        return null;
    }
}

