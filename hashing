    public String getServiceType(ShipmentBookRequest shipmentBookRequest) {
        String serviceType = shipmentBookRequest.getShipViaOptions().get(0).getCode();
        if(serviceType.equalsIgnoreCase(ServiceType.SAMEDAY.name())){
            return ServiceType.SAMEDAY.name();
        }else if(serviceType.equalsIgnoreCase(ServiceType.NEXTDAY.name())){
            return ServiceType.NEXTDAY.name();
        } else if (serviceType.equalsIgnoreCase(ServiceType.SAMEDAYSTATE.name())) {
        return ServiceType.SAMEDAYSTATE.name();
    }
        throw new ValidationException("Invalid service type: " + serviceType);
    }

    /**
     * This method is used to get the unique notifications from the additional accessorial ane merge the notify lists.
     *
     * @param additionalAccessorial The additional accessorial object.
     * @return A list of unique notifications.
     */
    private List<NotificationsItem> getUniqueNotifications(AdditionalAccessorial additionalAccessorial) {
        if (additionalAccessorial == null ) {
            return List.of();
        }
        if(additionalAccessorial.isSubscribeToEmailUpdate() && (additionalAccessorial.getNotification() == null || additionalAccessorial.getNotification().isEmpty())) {
            throw new ValidationException("notification list is required when subscribeToEmailUpdate is true");
        }
        if(!additionalAccessorial.isSubscribeToEmailUpdate() && (additionalAccessorial.getNotification() != null && !additionalAccessorial.getNotification().isEmpty())) {
            throw new ValidationException("notification list is not required when subscribeToEmailUpdate is false");
        }
        if (!additionalAccessorial.isSubscribeToEmailUpdate()) {
            return List.of();
        }
        return additionalAccessorial.getNotification().stream()
                .filter(notification -> notification.getEmail() != null) // Ensure email is not null
                .collect(
                        Collectors.toMap(
                                Notifications::getEmail, // Use email as the key
                                notification -> notification, // Keep the entire object
                                (existing, replacement) -> { // Merge notify lists for duplicates
                                    List<String> mergedNotify = new ArrayList<>(existing.getNotify());
                                    mergedNotify.addAll(replacement.getNotify());
                                    existing.setNotify(mergedNotify.stream().distinct().toList());
                                    return existing;
                                }
                        )
                )
                .values()
                .stream()
                .map(notification -> NotificationsItem.builder()
                        .email(notification.getEmail())
                        .pickup(containsKeyword(notification.getNotify(), PICKUP))
                        .delivery(containsKeyword(notification.getNotify(), DELIVERY))
                        .shipment(containsKeyword(notification.getNotify(), LABEL))
                        .build())
                .toList();
    }

    /**
     * This method checks if the notification list contains a specific keyword.
     *
     * @param notify  The list of notifications.
     * @param keyword The keyword to check for.
     * @return true if the keyword is found in any notification, false otherwise.
     */
    public boolean containsKeyword(List<String> notify, String keyword) {
        if (notify == null || notify.isEmpty() || keyword == null) {
            return false;
        }
        return notify.stream().anyMatch(notification -> notification.toLowerCase().contains(keyword.toLowerCase()));
    }

