    public static final String EVALUATION_FAILED_FOR_EXPRESSION = "SpEL evaluation failed for expression: %s. Returning false. Error: %s";
    private final ExpressionParser parser = new SpelExpressionParser();
    private final CompoundRuleEvaluationLogUtil ruleEvaluationLogUtil;
    private final PreferredRuleTypeRepository preferredRuleTypeRepository;

    public StandardEvaluationContext standardEvaluationContext(Map<String, Object> attributes) {
        StandardEvaluationContext context = new StandardEvaluationContext();
        if (attributes == null) {
            return context;
        }

        attributes.forEach((key, value) -> {
            switch (value) {
                case null -> {
                    return;
                }
                case CharSequence charSequence when StringUtils.isBlank(charSequence) -> {
                    return;
                }
                case Map<?, ?> mapValue when mapValue.isEmpty() -> {
                    return;
                }
                case Iterable<?> iterableValue when !iterableValue.iterator().hasNext() -> {
                    return;
                }
                default -> {

                }
            }
            if (value.getClass().isArray() && java.lang.reflect.Array.getLength(value) == 0) {
                return;
            }
            if (VALUE.equals(key) && value instanceof String str) {
                context.setVariable(key, Integer.valueOf(str));
            } else if (WEIGHT_VALUE.equals(key) && value instanceof String str) {
                context.setVariable(key, Double.valueOf(str));
            } else if (UPPERCASE_KEYS.contains(key)) {
                if (LABEL_REFERENCE_KEYS.contains(key)) {
                    context.setVariable(key, value.toString().replace(CompoundRuleConstants.SINGLE_QUOTE, CompoundRuleConstants.SINGLE_QUOTE_REPLACEMENT).toUpperCase(Locale.ROOT));
                } else {
                    context.setVariable(key, value.toString().toUpperCase(Locale.ROOT));
                }
            } else {
                context.setVariable(key, value);
            }
        });
        return context;
    }

    public boolean evaluate(String expression,
                            StandardEvaluationContext context, EvaluationRuleDto.EvaluationRuleDtoBuilder evaluationRuleDto,
                            List<EvaluationRuleDto> evaluationRules) {
        try {
            if (StringUtils.isBlank(expression)) {
                evaluationRuleDto.skipReason(EXPRESSION_IS_BLANK).skip(true);
                evaluationRules.add(evaluationRuleDto.build());
                return false;
            }
            Boolean result = parser.parseExpression(expression).getValue(context, Boolean.class);

            if (Boolean.TRUE.equals(result)) {
                return true;
            } else {
                evaluationRuleDto.skipReason(RULE_NOT_MATCHED).skip(true);
                evaluationRules.add(evaluationRuleDto.build());
                return false;
            }

        } catch (ExpressionException ex) {
            log.atWarn()
                    .setMessage(String.format(EVALUATION_FAILED_FOR_EXPRESSION, expression, ex.getMessage()))
                    .addKeyValue("expression", expression)
                    .addKeyValue("error", ex.getMessage())
                    .log();
            evaluationRuleDto.skipReason(String.format(EVALUATION_FAILED_FOR_EXPRESSION, expression, ex.getMessage())).skip(true);
            evaluationRules.add(evaluationRuleDto.build());
            return false;
        }
    }

