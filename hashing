  /**
   * Invoke retry in case of API Error and throw exception once maximum retries get exhausted
   *
   * @param maxAttempts Maximum number of retry allowed
   * @param initialDelay Delay before every retry
   * @return Retry object with details
   */
  public Retry retryOnFailure(int maxAttempts, Duration initialDelay) {
    log.atInfo().setMessage("OCM API request retry call ").log();
    return Retry.backoff(maxAttempts, initialDelay)
        .maxBackoff(Duration.ofSeconds(5))
        .jitter(0.5)
        .filter(this::isRetryable)
            .onRetryExhaustedThrow((retryBackoffSpec, retrySignal) -> {
                Throwable lastError = retrySignal.failure();
                if (lastError instanceof RuntimeException) {
                    return lastError;
                }
                return new RuntimeException("Retries exhausted for the ocm request", lastError);
            });
  }

  /**
   * Check for retry applicability based on the API error
   *
   * @param throwable Exception Object
   * @return true if retryable else false
   */
  public boolean isRetryable(Throwable throwable) {
    // retry will happen for 5XX error and also for network issue and unknown exceptions
    if (throwable instanceof WebClientResponseException ex) {
      int statusCode = ex.getStatusCode().value();
      boolean isRetryable = statusCode >= 500 && statusCode < 600;
     log.atError()
              .setMessage("Is this request retryable? - " + isRetryable)
              .addKeyValue("statusCode", statusCode)
              .log();
      return isRetryable;
    }
    return true;
  }

  /**
   * Handle error occurred from OCM call and return appropriate & required Exception
   *
   * @param throwable Throwable object
   * @return Exception
   */
  public Exception handleErrorMap(Throwable throwable) {
    if (throwable instanceof WebClientResponseException ex) {
     log.atError()
              .setCause(ex)
              .setMessage(ex.getMessage())
              .setMessage("OCM API call failed with error")
              .log();

      String errorDetailsResponse = ex.getResponseBodyAsString();
      String messageToUse;
      try {
        ObjectMapper mapper = new ObjectMapper();
        JsonNode node = mapper.readTree(errorDetailsResponse);
        JsonNode errorMessageNode = node.get("errorMessage");
        messageToUse =
            (errorMessageNode != null) ? errorMessageNode.asText() : errorDetailsResponse;
      } catch (Exception e) {
        messageToUse = errorDetailsResponse;
      }
      return switch (ex.getStatusCode().value()) {
        case OCMCommonConstants.OCM_BAD_REQUEST_API_CODE -> new ValidationException(messageToUse);
        case OCMCommonConstants.OCM_UNAUTHORIZED_API_CODE ->
            new UnAuthorizedException("Un authorized request in OCM API" + errorDetailsResponse);
        case OCMCommonConstants.OCM_NOT_FOUND_API_CODE ->
            new ResourceNotFoundException("Resource is not found: " + errorDetailsResponse);
        default ->
            new RuntimeException(
                "Unknown HTTP error occurred: "
                    + ex.getStatusCode()
                    + " - "
                    + errorDetailsResponse);
      };
    } else {
      return new RuntimeException(
          "OCM API call failed and it's not WebClientResponseException: "
              + throwable.getMessage()
              + Arrays.toString(throwable.getStackTrace()));
    }
  }

