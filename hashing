import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class GCSServiceImplTest {

    private static final String BUCKET = "test-bucket";
    private static final String FILE_1 = "legal-documents/eula_v1.0.pdf";
    private static final String FILE_2 = "legal-documents/tos_v2.0.pdf";
    private static final String KEY_1 = BUCKET + UNDERSCORE_DELIMITER + FILE_1;
    private static final String KEY_2 = BUCKET + UNDERSCORE_DELIMITER + FILE_2;

    @Mock
    private Storage storage;
    @Mock
    private RedisRegionService redisRegionService;
    @Mock
    private CustomAsyncConfigProvider customExecutor;

    @InjectMocks
    private GCSServiceImpl gcsService;

    // --- getEncodedLegalDocFileContents (single-file) ---

    @Test
    void testGetEncodedLegalDocFileContents_CacheMiss() {
        String fileName = "test-file.txt";
        String bucketName = "test-bucket";
        byte[] fileContent = "Hello, world!".getBytes();
        String expectedEncoded = Base64.getEncoder().encodeToString(fileContent);
        String key = bucketName + UNDERSCORE_DELIMITER + fileName;
        when(redisRegionService.get(LEGAL_DOCUMENT_CONTENT_REGION, key, LegalDocumentContentCacheDto.class)).thenReturn(java.util.Optional.empty());
        when(storage.readAllBytes(bucketName, fileName)).thenReturn(fileContent);

        String result = gcsService.getEncodedLegalDocFileContents(fileName, bucketName);

        assertEquals(expectedEncoded, result);
    }

    @Test
    void testGetEncodedLegalDocFileContents_CacheHit() {
        String fileName = "test-file.txt";
        String bucketName = "test-bucket";
        String cachedEncoded = "cached-content";
        String key = bucketName + UNDERSCORE_DELIMITER + fileName;
        LegalDocumentContentCacheDto cachedDto = new LegalDocumentContentCacheDto(key, cachedEncoded);
        when(redisRegionService.get(anyString(), anyString(), any())).thenReturn(java.util.Optional.of(cachedDto));

        String result = gcsService.getEncodedLegalDocFileContents(fileName, bucketName);

        assertEquals(cachedEncoded, result);
        verify(storage, never()).readAllBytes(anyString(), anyString());
    }

    // --- getEncodedLegalDocFileContentsBulk ---

    @Test
    void getEncodedLegalDocFileContentsBulk_allCacheHits_neverCallsGCS() {
        when(redisRegionService.findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class))
                .thenReturn(List.of(
                        new LegalDocumentContentCacheDto(KEY_1, "encoded-1"),
                        new LegalDocumentContentCacheDto(KEY_2, "encoded-2")
                ));

        Map<String, String> result = gcsService.getEncodedLegalDocFileContentsBulk(List.of(FILE_1, FILE_2), BUCKET);

        assertEquals("encoded-1", result.get(FILE_1));
        assertEquals("encoded-2", result.get(FILE_2));
        verify(storage, never()).readAllBytes(anyString(), anyString());
    }

    @Test
    void getEncodedLegalDocFileContentsBulk_allCacheMisses_fetchesAllFromGCS() {
        when(redisRegionService.findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class))
                .thenReturn(List.of());
        when(customExecutor.getChildExecutor()).thenReturn(Runnable::run);
        when(storage.readAllBytes(BUCKET, FILE_1)).thenReturn("content-1".getBytes());
        when(storage.readAllBytes(BUCKET, FILE_2)).thenReturn("content-2".getBytes());

        Map<String, String> result = gcsService.getEncodedLegalDocFileContentsBulk(List.of(FILE_1, FILE_2), BUCKET);

        assertEquals(Base64.getEncoder().encodeToString("content-1".getBytes()), result.get(FILE_1));
        assertEquals(Base64.getEncoder().encodeToString("content-2".getBytes()), result.get(FILE_2));
        verify(redisRegionService).put(eq(LEGAL_DOCUMENT_CONTENT_REGION), eq(KEY_1), any());
        verify(redisRegionService).put(eq(LEGAL_DOCUMENT_CONTENT_REGION), eq(KEY_2), any());
    }

    @Test
    void getEncodedLegalDocFileContentsBulk_partialCacheHit_onlyFetchesMissesFromGCS() {
        when(redisRegionService.findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class))
                .thenReturn(List.of(new LegalDocumentContentCacheDto(KEY_1, "cached-1")));
        when(customExecutor.getChildExecutor()).thenReturn(Runnable::run);
        when(storage.readAllBytes(BUCKET, FILE_2)).thenReturn("content-2".getBytes());

        Map<String, String> result = gcsService.getEncodedLegalDocFileContentsBulk(List.of(FILE_1, FILE_2), BUCKET);

        assertEquals("cached-1", result.get(FILE_1));
        assertEquals(Base64.getEncoder().encodeToString("content-2".getBytes()), result.get(FILE_2));
        verify(storage, never()).readAllBytes(BUCKET, FILE_1);
        verify(storage).readAllBytes(BUCKET, FILE_2);
    }

    @Test
    void getEncodedLegalDocFileContentsBulk_gcsFailure_throwsCompletionException() {
        when(redisRegionService.findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class))
                .thenReturn(List.of());
        when(customExecutor.getChildExecutor()).thenReturn(Runnable::run);
        when(storage.readAllBytes(BUCKET, FILE_1)).thenThrow(new RuntimeException("GCS unavailable"));

        assertThrows(CompletionException.class, () ->
                gcsService.getEncodedLegalDocFileContentsBulk(List.of(FILE_1), BUCKET));
    }

    @Test
    void getEncodedLegalDocFileContentsBulk_emptyInput_returnsEmptyMap() {
        when(redisRegionService.findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class))
                .thenReturn(List.of());

        Map<String, String> result = gcsService.getEncodedLegalDocFileContentsBulk(List.of(), BUCKET);

        assertTrue(result.isEmpty());
        verify(storage, never()).readAllBytes(anyString(), anyString());
    }
}

