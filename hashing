     */
    private ShipBookNoPhiDetailsDTO constructNoPhiShipmentDataToPublish(
            ShipmentResourceDto shipmentDto, List<PackageResourceDto> packages, List<PriceQuoteResourceDto> priceQuotes,
            AdditionalServiceShipmentResourceDto additionalServiceShipment) {

        // Concatenate the address fields to form a single address string
        String locationAddress = Stream.of(
                        shipmentDto.getShipFromAddressLine1(),
                        shipmentDto.getShipFromAddressLine2(),
                        shipmentDto.getShipFromAddressLine3(),
                        StringUtils.isNotBlank(shipmentDto.getShipFromCity()) ? shipmentDto.getShipFromCity() + "," : ",",
                        shipmentDto.getShipFromState(),
                        shipmentDto.getShipFromZip())
                .filter(StringUtils::isNotBlank)
                .collect(Collectors.joining(" "));

        String referenceTrackingNumber = shipmentDto.getReferenceTrackingNumber();

        // Null-safe concatenation of first and last name
        String userFullName = (shipmentDto.getUserFirstName() != null ? shipmentDto.getUserFirstName() : "")
                + (shipmentDto.getUserLastName() != null && !shipmentDto.getUserLastName().isEmpty() ? " " + shipmentDto.getUserLastName() : "");

        return ShipBookNoPhiDetailsDTO
                .builder()
                .shippingTransactionId(shipmentDto.getShipmentTransactionId())
                .shipDate(shipmentDto.getShipmentExpectedPickupDatetime() != null
                        ? shipmentDto.getShipmentExpectedPickupDatetime().toLocalDate().toString() : null)
                .billingGroupId(shipmentDto.getBillingGroupId())
                .locationName(shipmentDto.getShipFromName())
                .locationState(shipmentDto.getShipFromState())
                .locationZip(shipmentDto.getShipFromZip())
                .locationAddress(locationAddress)
                .shipperUserName(userFullName)
                .shippingProfileName(shipmentDto.getShippingProfileName())
                .referenceTrackingNumber(referenceTrackingNumber)
                .masterTrackingNumber(shipmentDto.getMasterTrackingNumber())
                .carrier(shipmentDto.getShipmentCarrierDetails())
                .carrierService(shipmentDto.getShipmentServiceLevel())
                .saturdayDelivery(additionalServiceShipment.getSaturdayDelivery())
                .saturdayPickup(additionalServiceShipment.getSaturdayPickup())
                .signature(Boolean.TRUE.equals(additionalServiceShipment.getSignatureRequired())
                        ? additionalServiceShipment.getSignatureLevel() : null)
                .shipToState(shipmentDto.getShipToState())
                .shipToZip(shipmentDto.getShipToZip())
                .baseCost(shipmentDto.getBaseCost())
                .accessorialCost(shipmentDto.getAccessorialCost())
                .interventionServices(additionalServiceShipment.getInterventionService())
                .deliveryNotesPopulated(!StringUtils.isBlank(shipmentDto.getDeliveryNotes()))
                .totalCost((priceQuotes == null || priceQuotes.isEmpty())
                        ? null : priceQuotes.get(0).getTotalAmount())
                .updatedOn(packages.get(0).getTracking().getTrackingLastUpdatedAt().toString())
                .packages(
                        packages
                                .stream()
                                .map(this::mapPackagesForNoPHIData)
                                .toList()
                )
                .nonStandardShippingProfile(Objects.nonNull(shipmentDto.getIsCustomShippingProfile()) ? shipmentDto.getIsCustomShippingProfile() : null)
                .navigatorLevel(Objects.nonNull(shipmentDto.getNavigatorLevel()) ? shipmentDto.getNavigatorLevel() : null)
                .beaconLevel(Objects.nonNull(shipmentDto.getBeaconLevel()) ? shipmentDto.getBeaconLevel() : null)
                .epicWillowAmbulatoryIntegration(Objects.nonNull(shipmentDto.getEpicWillowAmbulatoryIntegration()) ? shipmentDto.getEpicWillowAmbulatoryIntegration() : null)
                .notification(mapNotifications(shipmentDto))
                .halRequested(shipmentDto.isHal())
                .shipViaCode(shipmentDto.getShipViaCode())
                .needsByDate(Optional.ofNullable(shipmentDto.getNeedsByDate()).map(LocalDate::toString).orElse(null))
                .suggestedAddressUsage(shipmentDto.getSuggestedAddressUsage() != null ? shipmentDto.getSuggestedAddressUsage() : null)
                .suggestedResidentialFlagUsage(shipmentDto.getSuggestedResidentialFlagUsage() != null ? shipmentDto.getSuggestedResidentialFlagUsage() : null)
                .applicationSource(shipmentDto.getApplicationSource())
                .build();
    }

    /**
     * This method maps the notification related details for No-PHI shipping data publish
     *
     * @param shipmentDto Shipment entity for which data needs to be published in shipping nophi topic
     * @return Notification related details to be published in No-PHI shipping data
     */
    private static ShipBookNoPhiDetailsDTO.NotificationNoPhiDTO mapNotifications(ShipmentResourceDto shipmentDto) {
        return ShipBookNoPhiDetailsDTO.NotificationNoPhiDTO.builder()
                .emailRecipients((int) shipmentDto.getPackages().stream()
                        .map(PackageResourceDto::getTracking)
                        .filter(Objects::nonNull)
                        .flatMap(tracking -> Optional.ofNullable(tracking.getNotifications())
                                .orElse(emptyList())
                                .stream())
                        .filter(notification -> notification.getNotificationCommunicationChannel().equalsIgnoreCase(EMAIL))
                        .map(NotificationResourceDto::getNotificationCommunicationValue)
                        .distinct()
                        .count())
                .emailEvents(shipmentDto.getPackages().stream()
                        .map(PackageResourceDto::getTracking)
                        .filter(Objects::nonNull)
                        .flatMap(tracking -> Optional.ofNullable(tracking.getNotifications())
                                .orElse(emptyList())
                                .stream())
                        .filter(notification -> notification.getNotificationCommunicationChannel().equalsIgnoreCase(EMAIL))
                        .flatMap(notification -> Optional.ofNullable(notification.getNotificationEventSubscription())
                                .orElse(emptyList())
                                .stream())
                        .distinct()
                        .toList())
                .smsEvents(Optional.ofNullable(shipmentDto.getSmsNotifications()).orElse(emptyList())
                        .stream()
                        .map(SmsNotifications::getNotify)
                        .filter(Objects::nonNull)
                        .flatMap(Collection::stream)
                        .filter(StringUtils::isNotBlank)
                        .distinct()
                        .toList())
                .smsRecipients((int) Optional.ofNullable(shipmentDto.getSmsNotifications()).orElse(emptyList())
                        .stream()
                        .map(SmsNotifications::getPhoneNumber)
                        .filter(StringUtils::isNotBlank)
                        .distinct()
                        .count())
                .build();
    }

    /**
     * This method maps required package level fields for publishing No-PHI shipping data
     *
     * @param packageInfo Package Entity in ASP DB
     * @return Package details info to be published
     */
    private PackageInfoNoPhiDetailsDTO mapPackagesForNoPHIData(PackageResourceDto packageInfo) {
        AdditionalServicePackageResourceDto additionalServicePackage = packageInfo.getAdditionalServicePackage();
        return PackageInfoNoPhiDetailsDTO
                .builder()
                .trackingNumber(packageInfo.getTracking().getTrackingNumberUniqueId())
                .dryIce(packageInfo.getPackageDryIceWeight() != null
                        ? String.valueOf(packageInfo.getPackageDryIceWeight()) : null)
                .lithiumBattery(
                        (additionalServicePackage.getLithiumBattery() != null
                                && !additionalServicePackage.getLithiumBattery().isEmpty())
                                ? String.join(",", additionalServicePackage.getLithiumBattery()) : null)
                .coldChain(additionalServicePackage.getIsColdChain())
                .shipmentProtectionAmount(
                        (Boolean.TRUE.equals(additionalServicePackage.getIsShipmentProtection())
                                && additionalServicePackage.getShipmentProtectionAmount() != null)
                                ? String.valueOf(additionalServicePackage.getShipmentProtectionAmount()) : null
                )
                .declaredValueAmount(
                        (Boolean.TRUE.equals(additionalServicePackage.getDeclaredValue())
                                && additionalServicePackage.getValueOfContent() != null)
                                ? String.valueOf(additionalServicePackage.getValueOfContent()) : null
                )
                .additionalInsuranceAmount(additionalServicePackage.getAdditionalInsurance() != null
                        ? String.valueOf(additionalServicePackage.getAdditionalInsurance()) : null)
                .usedHcid(additionalServicePackage.getHcidCodes() != null && !additionalServicePackage.getHcidCodes().isEmpty())
                .packageType(packageInfo.getPackageProfileName()) // in ASP packageName - in tracking-resource packageProfileName
                .packageWeight(packageInfo.getPackageWeight() != null
                        ? String.valueOf(packageInfo.getPackageWeight()) : null)
                .packageLength(packageInfo.getPackageLength() != null
                        ? String.valueOf(packageInfo.getPackageLength()) : null)
                .packageHeight(packageInfo.getPackageHeight() != null
                        ? String.valueOf(packageInfo.getPackageHeight()) : null)
                .packageWidth(packageInfo.getPackageWidth() != null
                        ? String.valueOf(packageInfo.getPackageWidth()) : null)
                .usedNonStandardPackageType(packageInfo.getIsCustomPackage())
                .innerDimensions(getInnerDimensions(packageInfo))
                .durationHours(packageInfo.getRatedLength() != null ? String.valueOf(packageInfo.getRatedLength()) : null)
                .type(packageInfo.getPackagingType())
                .brandVendor(packageInfo.getPackageBrand())
                .productName(packageInfo.getPackageProductName())
                .modelIdentifier(packageInfo.getPackageModelIdentifier())
                .build();
    }

    /**
     * This method constructs inner dimension string in LxWxH in inches format
     *
     * @param packageInfo Package Entity in ASP DB
     * @return Inner dimension string in LxWxH in inches format
     */
    private static String getInnerDimensions(PackageResourceDto packageInfo) {
        String innerDimensions;
        if (packageInfo.getInnerLength() == null && packageInfo.getInnerWidth() == null
                && packageInfo.getInnerHeight() == null) {
            innerDimensions = ""; // If all dimensions are null, set to empty string
        } else {
            innerDimensions = (packageInfo.getInnerLength() == null ? 0 : packageInfo.getInnerLength()) + "X"
                    + (packageInfo.getInnerWidth() == null ? 0 : packageInfo.getInnerWidth()) + "X"
                    + (packageInfo.getInnerHeight() == null ? 0 : packageInfo.getInnerHeight()) + " in";
        }
        return innerDimensions;
    }
}

