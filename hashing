  private void saveTags(ShippingProfile shippingProfile, ShippingProfileRequest request) {
    String customerId = request.getCustomerId();
    List<String> tags = request.getTags() ==  null ? Collections.emptyList() : request.getTags();
    UUID shippingProfileId = shippingProfile.getId();

    if(Objects.nonNull(request.getShippingProfileId())) {
      tagMappingRepository.deleteByEntityIdAndEntityType(UUID.fromString(request.getShippingProfileId()), SHIPPING);
    }
    //  Get existing tags for the customer
    List<Tag> existingTags = repositoryCallsUtil.getTagIds(tags, customerId);
    Map<String, Tag> tagNametoTagMap =
        existingTags.stream().collect(Collectors.toMap(Tag::getTagName, Function.identity()));

    //  Create and save new tags if they don't exist
    List<Tag> newTags =
        tags.stream()
            .filter(tagName -> !tagNametoTagMap.containsKey(tagName))
            .map(
                tagName ->
                    Tag.builder()
                        .tagName(tagName)
                        .customerId(UUID.fromString(customerId))
                        .active(true)
                        .build())
            .collect(Collectors.toList());
    if (!newTags.isEmpty()) {
      newTags = repositoryCallsUtil.saveTags(newTags);
      newTags.forEach(tag -> tagNametoTagMap.put(tag.getTagName(), tag));
    }

    // Collect all tag IDs to be mapped
    Set<UUID> newTagIds =
        tags.stream()
            .map(tagName -> tagNametoTagMap.get(tagName).getId())
            .collect(Collectors.toSet());

    // Need to update existing mapping if update request
    if (request.getShippingProfileId() != null) {
      List<TagMapping> existingMap =
          repositoryCallsUtil.getExistingTagMapping(shippingProfile.getId(), SHIPPING);

      Set<UUID> existingTagIds =
          existingMap.stream().map(TagMapping::getId).collect(Collectors.toSet());

      Set<UUID> tagsToRemove = new HashSet<>(existingTagIds);
      tagsToRemove.removeAll(newTagIds);

      Set<UUID> tagsToAdd = new HashSet<>(newTagIds);
      tagsToAdd.removeAll(existingTagIds);

      if (!tagsToRemove.isEmpty()) {
        List<TagMapping> toDelete =
            existingMap.stream()
                .filter(tagMapping -> tagsToRemove.contains(tagMapping.getTag().getId()))
                .toList();
        repositoryCallsUtil.removeTagMapping(toDelete);
      }

      List<TagMapping> toAdd =
          tagsToAdd.stream()
              .map(
                  tagId -> {
                    Tag tag =
                        tagNametoTagMap.values().stream()
                            .filter(t -> t.getId().equals(tagId))
                            .findFirst()
                            .orElseThrow(
                                () -> new DatabaseException("Tag not found for ID: " + tagId));
                    return TagMapping.builder()
                        .entityId(shippingProfileId)
                        .entityType(SHIPPING)
                        .tag(tag)
                        .build();
                  })
              .collect(Collectors.toList());
      repositoryCallsUtil.saveTagMapping(toAdd);
    } else {
      // Just add mapping as create scenario
      List<TagMapping> newMappings =
          tags.stream()
              .map(
                  tagName ->
                      TagMapping.builder()
                          .entityId(shippingProfileId)
                          .entityType("Shipping")
                          .tag(tagNametoTagMap.get(tagName))
                          .build())
              .collect(Collectors.toList());
      repositoryCallsUtil.saveTagMapping(newMappings);
    }
  }

  public ShippingProfileResponse getShippingProfileResponse(
      boolean saveShippingProfile, boolean isProfileSaved) {
    return ShippingProfileResponse.builder()
        .status(isProfileSaved ? VOID_SUCCESS : VOID_FAIL)
        .message(getResponseMessage(saveShippingProfile, isProfileSaved))
        .build();
  }

  private String getResponseMessage(boolean saveShippingProfile, boolean isProfileSaved) {
      String operation = saveShippingProfile ? "sav" : "updat";
    return isProfileSaved
        ? "Shipping profile " + operation + "ed." + COMMON_PROFILE_MESSAGE
        : "Error while " + operation + "ing shipping profile.";
  }

  public ShippingProfile getShippingProfile(String shippingProfileId) {
    Optional<ShippingProfile> optional = repositoryCallsUtil.findById(shippingProfileId);
    return optional.orElse(null);
  }

  private LocalTime getLocalTime(String localTime) {
    var formatter = DateTimeFormatter.ofPattern("h:mm a", Locale.ENGLISH);
    return Objects.isNull(localTime) ? null : LocalTime.parse(localTime, formatter);
  }
