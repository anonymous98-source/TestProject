import com.cardinalhealth.adv.shipping.integration.api.service.dto.hcid.HcidNodeDto;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.time.Instant;
import java.util.List;
import java.util.concurrent.atomic.AtomicReference;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.TTL_MILLIS_HCID_CACHE;

@Component
public class HcidCache {

    private final AtomicReference<CacheEntry> cache = new AtomicReference<>();

    public void put(List<HcidNodeDto> hcidList) {
        cache.set(new CacheEntry(hcidList, Instant.now().toEpochMilli()));
    }

    public List<HcidNodeDto> get() {
        CacheEntry entry = cache.get();
        if (entry == null || isExpired(entry)) {
            cache.set(null);
            return List.of();
        }
        return entry.hcidList;
    }

    private boolean isExpired(CacheEntry entry) {
        return Instant.now().toEpochMilli() - entry.createdAt > TTL_MILLIS_HCID_CACHE;
    }

    @Scheduled(fixedRate = 60 * 60 * 1000)
    public void cleanup() {
        CacheEntry entry = cache.get();
        if (entry != null && isExpired(entry)) {
            cache.set(null);
        }
    }

    private static class CacheEntry {
        private final List<HcidNodeDto> hcidList;
        private final long createdAt;

        CacheEntry(List<HcidNodeDto> hcidList, long createdAt) {
            this.hcidList = hcidList;
            this.createdAt = createdAt;
        }
    }
}

