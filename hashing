package com.cardinalhealth.adv.shipping.integration.api.redis.service;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.redis.core.RedisCallback;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.stereotype.Service;

import java.time.Duration;
import java.util.*;
import java.util.stream.Collectors;

@Service
public class RedisRegionService {

    private final int redisTTL;

    private final RedisTemplate<String, Object> redisTemplate;
    private final RedisPublisher redisPublisher;

    public RedisRegionService(
            RedisTemplate<String, Object> redisTemplate,
            RedisPublisher redisPublisher,
            @Value("${redis.ttl:0}") int redisTTL
    ) {
        this.redisTemplate = redisTemplate;
        this.redisPublisher = redisPublisher;
        this.redisTTL = redisTTL;
    }

    private String buildKey(String region, String id) {
        return  region + ":" + id;
    }

    private String buildIndexKey(String region) {
        return "IDX:" + region;
    }

    public <T> Optional<T> get(String region, String id, Class<T> type) {
        Object value = redisTemplate.opsForValue().get(buildKey(region, id));
        return Optional.ofNullable(type.cast(value));
    }

    public <T> Optional<T> getById(String key, Class<T> type) {
        Object value = redisTemplate.opsForValue().get(key);
        return Optional.ofNullable(type.cast(value));
    }

    public boolean keyExist(String key) {
        return redisTemplate.hasKey(key);
    }

    public boolean keyExist(String region,String id) {
        String redisKey = buildKey(region, id);
        return redisTemplate.hasKey(redisKey);
    }

    public void put(String region, String id, Object value) {

        String redisKey = buildKey(region, id);
        boolean isExist = redisTemplate.hasKey(redisKey);
        if(redisTTL==0){
            redisTemplate.opsForValue().set(redisKey, value);
        }else {
            redisTemplate.opsForValue().set(redisKey, value, Duration.ofSeconds(redisTTL));
        }
        redisTemplate.opsForSet().add(buildIndexKey(region), redisKey);
        if(isExist){
            redisPublisher.publish(redisKey,region,"UPDATE");
        }else{
            redisPublisher.publish(redisKey,region,"CREATE");
        }
    }

    public void put(String region, String id, Object value, Duration ttl) {
        String redisKey = buildKey(region, id);
        boolean isExist = redisTemplate.hasKey(redisKey);
        redisTemplate.opsForValue().set(redisKey, value,ttl);
        redisTemplate.opsForSet().add(buildIndexKey(region), redisKey);
        if(isExist){
            redisPublisher.publish(redisKey,region,"UPDATE");
        }else{
            redisPublisher.publish(redisKey,region,"CREATE");
        }
    }

    public void delete(String region, String id) {
        String redisKey = buildKey(region, id);
        redisTemplate.delete(redisKey);
        redisTemplate.opsForSet().remove(buildIndexKey(region), redisKey);
    }

    public void deleteAll(String region) {
        String idx = buildIndexKey(region);
        Set<Object> keys = redisTemplate.opsForSet().members(idx);
        if (keys == null || keys.isEmpty()) return;
        redisTemplate.executePipelined((RedisCallback<Object>) conn -> {
            for (Object k : keys) {
                conn.del(redisTemplate.getStringSerializer().serialize(k.toString()));
            }
            conn.del(redisTemplate.getStringSerializer().serialize(idx));
            return null;
        });
    }

    public <T> List<T> findAll(String region, Class<T> type) {
        String idxKey = buildIndexKey(region);
        Set<Object> keys = redisTemplate.opsForSet().members(idxKey);
        if (keys == null || keys.isEmpty()) {
            return Collections.emptyList();
        }
        List<Object> values = redisTemplate.opsForValue().multiGet(
                keys.stream().map(Object::toString).collect(Collectors.toList())
        );
        if (values == null) {
            return Collections.emptyList();
        }
        return values.stream()
                .filter(Objects::nonNull)
                .map(type::cast)
                .collect(Collectors.toList());
    }
    public void removeIdx(String region, String redisKey) {
        redisTemplate.opsForSet().remove(buildIndexKey(region), redisKey);
    }
}

