  /**
   * Creating ShipmentBookDto from ShipmentBookRequest model for SendFlex shipment book API
   *
   * @return ShipmentBookDto
   */
  public static ShipmentBookDto buildShipmentBookDto(
      ShipmentBookRequest shipmentBookRequest,
      Map<String, PackageProfileEntity> packageProfileEntityMap,
      Boolean isUserEnrolledInOSP,Boolean isReturn) {

    return ShipmentBookDto.builder()
        .profileCode(shipmentBookRequest.getProfile())
        .addresses(
            getFromAddressToAddress(
                shipmentBookRequest.getShipFromAddress(),
                shipmentBookRequest.getShipToAddress(),
                shipmentBookRequest.getHoldLocationAddress(),
                shipmentBookRequest.getDeliveryNotes(),
                    shipmentBookRequest.getGenerateLabelReturnType(),
                    isReturn))
        .shipViaOptions(buildShipViaOptions(shipmentBookRequest.getShipViaOptions()))
        .shippingUnits(
            buildShippingUnits(
                shipmentBookRequest.getPackagingDetails(),
                packageProfileEntityMap,
                shipmentBookRequest.getAdditionalAccessorial(),
                shipmentBookRequest.getShippingProfile(),
                shipmentBookRequest,
                isUserEnrolledInOSP))
        .pickupOptions(buildPickupOptionsDto(shipmentBookRequest))
        .carrierAddOns(getCarrierAddOns(shipmentBookRequest)) // can maybe drop this
        .payor(
            USPS.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
                    || DHL.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
                ? null
                : getPayorDto(shipmentBookRequest))
        .requestedEmailNotification(buildRequestedEmailNotification(shipmentBookRequest))
            .transactionIdentifier(StringUtils.defaultIfBlank(MDC.get(ServiceCommonConstants.CORRELATION_ID), null))
        .build();
  }

  private static List<AddressDto> getFromAddressToAddress(
          ShipFromAddress shipFromAddress, ShipToAddress shipToAddress, HoldLocationAddress holdLocation, String deliveryNotes, String genrateLabelReturnType,Boolean isReturn) {
    AddressDto senderDto =
        buildAddressDto(shipFromAddress.getAddressData().getAddress(), deliveryNotes);
    AddressDto receiverDto =
        buildAddressDtoFromShipAddress(shipToAddress.getAddressData().getAddress(), deliveryNotes);
    AddressDto payorDto =
        AddressDto.builder()
            .countryCode(senderDto.getCountryCode())
            .type(ServiceCommonConstants.PAYOR)
            .build();
    if(holdLocation!=null && !isReturn && genrateLabelReturnType==null) {
      AddressDto holdLocationDto =
              buildHoldLocationAddressDto(holdLocation.getAddressData().getAddress(), deliveryNotes);
      return Arrays.asList(senderDto, receiverDto, holdLocationDto,payorDto);
    }
    return Arrays.asList(senderDto, receiverDto, payorDto);
  }
  private static AddressDto buildHoldLocationAddressDto(ShipToAddressDetails address, String deliveryNotes){
   return AddressDto.builder()
            .description(address.getName())
            .notes(deliveryNotes)
            .contact(buildContactDtoFromShipAddress(address))
            .name(address.getCompany())
            .addressLines(address.getAddressLines())
            .city(address.getCity())
            .state(address.getState())
            .postalCode(address.getZipCode())
            .countryCode(address.getCountry())
            .residential(false)
            .type("HoldLocation")
            .build();
  }

