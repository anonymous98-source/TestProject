                        FE_NEXT_DAY_KEY, zipCodeDetails.getNextday(),
                        FE_ON_DEMAND_KEY, zipCodeDetails.getSamedayState()
                ))
                .city(zipCodeLocationDto.getCity())
                .state(zipCodeLocationDto.getState())
                .build();

    }

    /**
     * Get default response in case of unresolved rule.
     */
    public RuleEvaluationResponseDto getDefaultResponse(
            RuleEvaluationRequestDto request,
            OCMResponse ocmResponse,
            String reason
    ) {

        RuleDetails ruleDetails = buildRuleDetails(
                request.getRuleType().toString(),
                reason,
                false,
                null,
                null
        );

        RuleEvaluationResponseDto responseDto = buildRuleEvaluationResponse(
                ruleDetails, null, null, ocmResponse);

        // log the evaluation result
        ruleEvaluationLogUtil.saveEvaluationLogAsync(
                request, responseDto, null, reason, getCorrelationId());

        return responseDto;
    }

    /**
     * Get the final resolved response in case of rule matches
     */
    public RuleEvaluationResponseDto getResolvedResponse(
            RuleEvaluationRequestDto request,
            RuleEvaluationResult result,
            AssignedShippingProfile shippingProfile,
            OCMResponse ocmResponse
    ) {

        log.atInfo().setMessage("Resolving and returning final response.").log();

        RuleDetails ruleDetails = buildRuleDetails(
                request.getRuleType().toString(),
                null,
                true,
                null,
                null
        );

        RuleEvaluationResponseDto response;
        if (!request.getRuleType().equals(RuleType.SHIPMENT_VALUE)) {

            response = buildRuleEvaluationResponse(
                    ruleDetails, shippingProfile, null, ocmResponse);
        } else {
            log.atInfo()
                    .setMessage("Preparing accessorial rule details in response for ruleType:" + request.getRuleType())
                    .log();

            ruleDetails.setCarrier(request.getCarrier());

            // when rule type is SHIPMENT_VALUE, return multiple rule details keyed by accessorial multi winner output. preserve the requested carrier
            Map<String, RuleDetails> accessorialRuleDetails = result.getAccessorials() == null
                    ? Collections.emptyMap()
                    : result.getAccessorials().entrySet()
                    .stream()
                    .collect(Collectors.toMap(Map.Entry::getKey,
                            entry -> {
                                RuleDefinition rule = entry.getValue();
                                return buildRuleDetails(
                                        null,
                                        null,
                                        null,
                                        rule.getAccessorial(),
                                        rule.getSecondaryConfig()
                                );
                            }
                    ));

            response = buildRuleEvaluationResponse(
                    ruleDetails,
                    null,
                    accessorialRuleDetails,
                    ocmResponse);
        }

        // log the evaluation result
        ruleEvaluationLogUtil.saveEvaluationLogAsync(
                request, response, result, RULE_RESOLVED, getCorrelationId());

        return response;
    }

    /**
     * Helper method to build rule evaluation response dto
     */

    private RuleDetails buildRuleDetails(
            String ruleType,
            String reason,
            Boolean isMatched,
            JsonNode accessorials,
            JsonNode secondaryConfigs) {

        return RuleDetails.builder()
                .ruleType(ruleType != null ? RuleType.valueOf(ruleType) : null)
                .reason(reason)
                .isMatched(isMatched)
                .accessorials(accessorials)
                .secondaryConfigs(secondaryConfigs)
                .build();
    }

    private RuleEvaluationResponseDto buildRuleEvaluationResponse(
            RuleDetails ruleDetails,
            AssignedShippingProfile assignedShippingProfile,
            Map<String, RuleDetails> accessorialRuleDetails,
            OCMResponse ocmResponse) {

        return RuleEvaluationResponseDto.builder()
                .ruleDetails(ruleDetails)
                .assignedShippingProfile(assignedShippingProfile)
                .accessorialRuleDetails(accessorialRuleDetails)
                .carrierAccessibility(ocmResponse.getCarrierAccessibilityMap())
                .city(ocmResponse.getCity())
                .state(ocmResponse.getState())
                .build();
    }

    private String getCorrelationId() {
        return MDC.get(CORRELATION_ID);
    }
}

