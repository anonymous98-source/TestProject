package com.cardinalhealth.adv.shipping.integration.api.controller.shipbook;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.*;

import com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.ShipmentBookRequest;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.response.MultiPackageShipmentBookResponse;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.response.ShipmentBookResponse;
import com.cardinalhealth.adv.shipping.integration.api.service.dto.shipbook.resp.*;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.stereotype.Component;

@Slf4j
@Component
public class ShipmentBookResponseUtil {

  public MultiPackageShipmentBookResponse getMultiPackageShipmentBookResponse(
      ShipmentBookResponseDto responseDto, ShipmentBookRequest shipmentBookRequest) {
    var containsReturn = false;
    boolean isMultiPackage = shipmentBookRequest.getPackagingDetails().size() > 1;
    if (!isMultiPackage
        && !StringUtils.isBlank(shipmentBookRequest.getGenerateLabelReturnType())
        && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(FORWARD)) {
      shipmentBookRequest.setTotalPackageCount(2);
      shipmentBookRequest.setPackagingDetails(
          List.of(
              shipmentBookRequest.getPackagingDetails().get(0),
              shipmentBookRequest.getPackagingDetails().get(0)));
      containsReturn = true;
    }
    List<ShipmentBookResponse> shipmentBookResponses = new ArrayList<>();
    List<ShippingUnitResponseDto> shippingUnitResponseDtoList = responseDto.getShippingUnits();
    var index = 0;

    log.atInfo()
            .setMessage("shipping profile received ")
            .log();

      populateShipmentBookResponses(responseDto, shipmentBookRequest, shippingUnitResponseDtoList, index, containsReturn, shipmentBookResponses);
      MultiPackageShipmentBookResponse shipBookResponseMultiPackage =
        MultiPackageShipmentBookResponse.builder()
            .status(getStatusCode(responseDto))
            .shipmentTransactionId(responseDto.getId())
            .shipmentBookResponses(shipmentBookResponses)
            .priceBreakDown(responseDto.getPriceBreakDown())
            .allLabelType(shipmentBookRequest.getLabelType())
            .build();
    if (!responseDto.isPublishStatus()) {
      shipBookResponseMultiPackage.setShipmentBookPubErrorMsg(PUB_ERR_MSG);
    }
    if (!StringUtils.isBlank(shipmentBookRequest.getGenerateLabelReturnType())
        && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(FORWARD)) {
      if (isMultiPackage) {
        shipBookResponseMultiPackage.setForwardReturnStatus("MultiPackaged returns not allowed");
      } else {
        if (responseDto.getShippingUnits().size() == 1) {
          shipBookResponseMultiPackage.setForwardReturnStatus(
              "Failed to generate return label, please try again.");
        }
      }
    }
    if (responseDto.getId().contains(RETURN)) {
      String[] transactionIds = responseDto.getId().split(RETURN);
      shipBookResponseMultiPackage.setShipmentTransactionId(transactionIds[0]);
      shipBookResponseMultiPackage.setReturnShipmentTransactionId(transactionIds[1]);
    }
    shipBookResponseMultiPackage.setEpicSkipped(responseDto.isEpicSkipped());
    shipBookResponseMultiPackage.setSaturdayPickupScheduled(responseDto.getSaturdayPickupScheduled());
    return shipBookResponseMultiPackage;
  }

    private void populateShipmentBookResponses(ShipmentBookResponseDto responseDto, ShipmentBookRequest shipmentBookRequest, List<ShippingUnitResponseDto> shippingUnitResponseDtoList, int index, boolean containsReturn, List<ShipmentBookResponse> shipmentBookResponses) {
        for (ShippingUnitResponseDto shippingUnitResponseDto : shippingUnitResponseDtoList) {

          String trackingNumber = null;
          String content = null;
          List<TrackingNumberDto> trackingNumberDetails = shippingUnitResponseDto.getTrackingNumber();
          if (trackingNumberDetails != null && !trackingNumberDetails.isEmpty()) {
            trackingNumber = trackingNumberDetails.get(0).getValue();
          }
          List<DocumentDto> documents =
              USPS.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
                  ? responseDto.getDocuments().stream().map(this::convertToDocumentDto).toList()
                  : shippingUnitResponseDto.getDocuments();
          if (documents != null
              && !documents.isEmpty()
              && documents.get(0).getContents() != null
              && !documents.get(0).getContents().isEmpty()) {
            content = documents.get(0).getContents().get(0);
          }

            String packageNickname = getPackageNickname(shipmentBookRequest, index, containsReturn);

            index++;

          ShipmentBookResponse shipmentBookResponse =
              ShipmentBookResponse.builder()
                  .trackingNumber(trackingNumber)
                  .labelType(shipmentBookRequest.getLabelType())
                  .labelContent(content)
                  .packageNickname(packageNickname)
                  .fileName(getFileName("." + shipmentBookRequest.getLabelType(), trackingNumber))
                  .build();
          shipmentBookResponses.add(shipmentBookResponse);
        }
    }

    private String getPackageNickname(ShipmentBookRequest shipmentBookRequest, int index, boolean containsReturn) {
        String packageNickname =
            shipmentBookRequest.getPackagingDetails() != null
                ? shipmentBookRequest
                    .getPackagingDetails()
                    .get(index)
                    .getPackaging()
                    .getPackageNickname()
                : null;
        if (!StringUtils.isBlank(packageNickname)
            && !StringUtils.isBlank(shipmentBookRequest.getGenerateLabelReturnType())) {
          if (containsReturn
              && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(FORWARD)
              && index == 1) {
            packageNickname += RETURN;
          }
          if (shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(STANDALONE)) {
            packageNickname += RETURN;
          }
        }
        return packageNickname;
    }

    public DocumentDto convertToDocumentDto(Object document) {
    if (document instanceof LinkedHashMap map) {
      return DocumentDto.builder()
          .type((String) map.get(TYPE))
          .category((String) map.get(CATEGORY))
          .format((String) map.get(FORMAT))
          .description((String) map.get(DESCRIPTION))
          .contents((List<String>) map.get(CONTENTS))
          .peripheralClientSettings(
              convertToPeripheralClientSettingsDto(map.get(PERIPHERAL_CLIENT_SETTINGS)))
          .labelOptions((List<Object>) map.get(LABEL_OPTIONS))
          .build();
    }
    return (DocumentDto) document;
  }

  public PeripheralClientSettingsDto convertToPeripheralClientSettingsDto(
      Object peripheralClientSettings) {
    if (peripheralClientSettings instanceof LinkedHashMap) {
      LinkedHashMap<String, Object> map = (LinkedHashMap<String, Object>) peripheralClientSettings;
      return PeripheralClientSettingsDto.builder()
          .landscape((Boolean) map.get(LANDSCAPE))
          .rotate((Integer) map.get(ROTATE))
          .scale((Integer) map.get(SCALE))
          .printLater((Boolean) map.get(PRINT_LATER))
          .build();
    }
    return (PeripheralClientSettingsDto) peripheralClientSettings;
  }

  private String getFileName(String extensionType, String trackingNumber) {

    return trackingNumber
        + ServiceCommonConstants.FILE_NAME_MID_CONSTANT
        + LocalDate.now()
        + extensionType;
  }

  private static String getStatusCode(ShipmentBookResponseDto responseDto) {
    ResultDto resultDto = responseDto.getResult();
    if (resultDto != null) {
      return resultDto.getStatusCode();
    }
    return "";
  }
}

