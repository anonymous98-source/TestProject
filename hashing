package com.cardinalhealth.adv.shipping.integration.api.utils;

import com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants;
import com.cardinalhealth.adv.shipping.integration.api.exception.ShippingIntegrationException;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.Builder;
import lombok.Data;
import lombok.extern.slf4j.Slf4j;
import org.springframework.util.StringUtils;

import javax.annotation.PreDestroy;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.Base64;
import java.util.Date;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.locks.ReentrantReadWriteLock;

@Slf4j
public class TokenCacheUtils {

    private TokenCacheUtils() { // Util class
        throw new IllegalStateException("Utility class");
    }

    private static final ConcurrentHashMap<String, CachedToken> TOKEN_CACHE_MAP = new ConcurrentHashMap<>();
    
    private static final ReentrantReadWriteLock readWriteLock = new ReentrantReadWriteLock();

    /**
     * This method uses read lock over Cache Map and fetches the Cached Token, if not found returns null
     *
     * @param tokenKey Key with which Token needs to be fetched
     * @return Token if found else returns null
     */
    public static String getCachedToken(String tokenKey) {
        readWriteLock.readLock().lock(); // Read lock is acquired
        try {
            var cachedToken = TOKEN_CACHE_MAP.get(tokenKey);
            if (cachedToken == null) {
                log.atInfo().setMessage("Token cache miss, need to call API to fetch token").log();
                return null;
            }

            long now = LocalDateTime.now().atZone(ZoneId.systemDefault()).toInstant().toEpochMilli();
            if (cachedToken.expiryTimeInMillis != null
                    && (cachedToken.expiryTimeInMillis - ServiceCommonConstants.EXPIRY_BUFFER_MS) >= now) {
                return cachedToken.token;
            } else {
                log.atInfo().setMessage("Token cache miss, need to call API to fetch token").log();
                return null;
            }
        } finally {
            readWriteLock.readLock().unlock();
        }
    }

    // Parses the JWT token and remove the existing one and then puts the latest token in Cache
    @SuppressWarnings("unchecked")
    public static void addNewTokenInCache(String tokenKey, String newAccessToken) {
        if (!StringUtils.hasText(tokenKey) && !StringUtils.hasText(newAccessToken)) {
            log.atDebug()
                    .setMessage("Either Token key or new token is null or empty, not saved in Token Cache")
                    .log();
            return;
        }

        String[] parts = newAccessToken.split("\\.");
        if (parts.length < 2) {
            throw new IllegalArgumentException("Invalid JWT token, expected to have 3 parts, but got " + parts.length);
        }

        var tokenJson = new String(Base64.getUrlDecoder().decode(parts[1]));
        ObjectMapper mapper = new ObjectMapper();
        Map<String, Object> parsedTokenKeyVal = null;
        try {
            parsedTokenKeyVal = mapper.readValue(tokenJson, Map.class);
        } catch (JsonProcessingException ex) {
            log.atWarn()
                    .setMessage("Error processing token Json into map and details is: {}")
                    .addArgument(ex.getMessage())
                    .addKeyValue("error", ex.getMessage())
                    .log();
            throw new ShippingIntegrationException("Token parsing exception in token cache", ex.getCause());
        }

        if (parsedTokenKeyVal == null || parsedTokenKeyVal.isEmpty()) {
            log.atDebug().setMessage("Token parsing issue, not stored in token cache").log();
            return;
        }

        Date expiresAt = null;
        if (parsedTokenKeyVal.containsKey(ServiceCommonConstants.EXPIRY_KEY)) {
            var exp = ((Number) parsedTokenKeyVal.get(ServiceCommonConstants.EXPIRY_KEY)).longValue();
            expiresAt = new Date(exp * 1000); // Convert seconds to milliseconds
        }

        if (expiresAt == null) { // If no expiry time, treat this as invalid
            throw new IllegalArgumentException("Invalid JWT - without expiration time");
        }

        readWriteLock.writeLock().lock();
        try { // Construct Cached token and put it in Cache Map
            CachedToken newToken = CachedToken
                    .builder()
                    .token(newAccessToken)
                    .expiryTimeInMillis(expiresAt.getTime())
                    .build();
            TOKEN_CACHE_MAP.remove(tokenKey); // remove
            TOKEN_CACHE_MAP.put(tokenKey, newToken); // update
        } finally {
            log.atInfo().setMessage("Token cache successfully updated and write lock released").log();
            readWriteLock.writeLock().unlock();
        }
    }

    @PreDestroy
    public static void clearTokenCache() {
        TOKEN_CACHE_MAP.clear();
    }

    @Data
    @Builder
    public static class CachedToken {
        private final String token;
        private final Long expiryTimeInMillis;
    }
}

