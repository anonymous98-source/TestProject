@SneakyThrows
  public Exception handleErrorMap(Throwable throwable, Object requestBody, String aspectName,HttpMethod httpMethod) {

    if (shouldLogFailure(httpMethod, aspectName)) {
      TrackingFailureLog failureLog = TrackingFailureLog.builder()
              .aspectName(aspectName)
              .requestJson(objectMapper.writeValueAsString(requestBody)) // Proper JSON
              .responseJson(objectMapper.writeValueAsString(throwable.getMessage()))
              .build();

      trackingFailureLogRepository.save(failureLog);
    }

      if (throwable instanceof WebClientResponseException ex) {
     log.atError()
                      .setMessage(ex.getMessage())
                      .setCause (ex)
                      .setMessage("sendflex API request failed error ")
                      .log() ;
      List<String> errorMessages = extractErrorMessages(ex.getResponseBodyAsString());
          return switch (ex.getStatusCode().value()) {
              case SendFlexErrorConstants.UNAUTHORIZED ->
                      new UnAuthorizedException("Not authorized request" + errorMessages);
              case SendFlexErrorConstants.BAD_REQUEST -> new ValidationException("Data is not valid: " + errorMessages);
              case SendFlexErrorConstants.NOT_FOUND -> new ResourceNotFoundException(
                      "Resource is not found: " + errorMessages);
              default -> new RuntimeException(
                      "Unknown HTTP error occurred: "
                              + ex.getStatusCode()
                              + " - "
                              + errorMessages);
          };
    } else {
      return new RuntimeException("sendflex API request failed and it's not WebClientResponseException: " + throwable.getMessage() + Arrays.toString(throwable.getStackTrace()));
    }
  }

  public boolean shouldLogFailure(HttpMethod method, String aspectName) {
    return method == HttpMethod.POST
            && !aspectName.equals(GET_SHIPMENT)
            && !aspectName.equals(GET_PARENT_SHIPMENT_ID)
            && !aspectName.isBlank();
  }



  public void findErrors(JsonNode root, Set<String> errors) {
    if(root.isArray()) {
      root.elements().forEachRemaining(element ->
              findErrors(element, errors)
      );
    } else if(root.isObject()) {
      root.fieldNames().forEachRemaining(fieldName -> {
        JsonNode value = root.get(fieldName);
        if(fieldName.equals("errorMessage") || fieldName.equals("fieldErrors")) {
          errors.add(value.asText());
        }
        findErrors(value, errors);
      });
    }
  }
  List<String> extractErrorMessages(String responseBody) {
    LinkedHashSet<String> errorMessages = new LinkedHashSet<>();
    ObjectMapper mapper = new ObjectMapper();
    try {
      JsonNode root = mapper.readTree(responseBody);
      findErrors(root, errorMessages);
    } catch (Exception e) {
      log.error("Failed to parse error messages from response body", e);
    }
    return new ArrayList<>(errorMessages);
  }

  // retry will happen for 5XX error and also for network issue and unknown exceptions
  boolean isRetryable(Throwable throwable) {
    if (throwable instanceof WebClientResponseException ex) {
      int statusCode = ex.getStatusCode().value();
     log.atError()
                      .setMessage("Is this request retryable?")
                      .addKeyValue("statusCode", statusCode)
                      .log();
      return statusCode >= 500 && statusCode < 600;
    }
    return true;
  }

  Map<String,String> getDefaultHeaders() {
    String authenticationJWTToken = SecurityContextExtractor.getAccessToken();
    if (!StringUtils.hasText(authenticationJWTToken)) {
      log.atWarn().setMessage("JWT token is empty").log();
    }
    Map<String, String> headers = new HashMap<>();
    headers.put("Content-Type", ServiceCommonConstants.CONTENT_TYPE);
    headers.put("Accept", ServiceCommonConstants.ACCEPT_TYPE);
    if (authenticationJWTToken != null) {
      headers.put(HttpHeaders.AUTHORIZATION, ServiceCommonConstants.BEARER + authenticationJWTToken);
    }
    return headers;
  }

  /**
   * Calls the Tracking Resource Manifest Status API to get the shipment status of each manifest and count of shipment since last manifest.
   *
   * @param request ManifestStatusRequest
   * @return Mono<ManifestStatusResponse>
   */

  @SneakyThrows
  public Mono<ManifestStatusResponse> getManifestStatusFromTracking(ManifestStatusRequest request){

      URI uri = new DefaultUriBuilderFactory()
              .uriString(advshipIntegrationApiProperties.getResource().getUrl())
              .path(TRACKING_MANIFEST_STATUS_API)
              .build();

      log.atInfo()
              .addKeyValue("path", uri.toString())
              .addKeyValue(METHOD, HttpMethod.POST.toString())
              .setMessage("Calling Tracking Resource Manifest Status API").log();

      return webClient.post()
              .uri(uri)
              .headers(httpHeaders -> getDefaultHeaders().forEach(httpHeaders::add))
              .bodyValue(request)
              .retrieve()
              .bodyToMono(ManifestStatusResponse.class)
              .retryWhen(retryConfig.createRetry(3, 2))
              .onErrorMap(throwable -> handleErrorMap(throwable, request, "", HttpMethod.POST));
  }
}

