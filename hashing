    @Override
    public PriceResult priceBreakDown(ShipmentBookRequest shipmentBookRequest, OflUserPrincipal oflUserPrincipal) {
        ShipmentRequestModel shipReq = null;
        try {
            if (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(USPS)) {
                List<UserDefaultsResponse> userDefaultsResponses =
                        userDefaultsService.getDefaultValues(oflUserPrincipal, shipmentBookRequest.getFacilityId());
                ShipmentRequestDTO shipmentRequestDTO =
                        shipPlanDataMapperService.mapToSendFlexRequest(shipmentBookRequest, oflUserPrincipal, userDefaultsResponses.get(0).getData());
                UserConfigResponseDTO ocmResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(shipmentBookRequest.getFacilityId(), shipmentBookRequest.getCustomerId());
                return uspsPriceBreakdown(shipmentRequestDTO, ocmResponseDTO);
            }
            // STANDALONE
            if (isReturnTypeForFedex(shipmentBookRequest, STANDALONE)) {
                prepareRequestForReturn(shipmentBookRequest, null);
            }
            shipReq = maptoShipmentRequestModel(shipmentBookRequest, null);
            RatesDto rates = rateQuoteWebClientService.getRateQuote(shipReq);

            log.atInfo()
                    .setMessage("Successfully returned Rates from rate quote")
                    .log();

            sendFlexRecordUtil.savePriceRecordDtoForSuccess(shipReq, rates);

            PriceResult priceResult = getResult(rates, shipmentBookRequest);

            log.atInfo()
                    .setMessage("Successfully returned price breakdown")
                    .addKeyValue("priceResult", JsonUtilService.toJsonString(priceResult))
                    .log();
            return priceResult;
        } catch (Exception e) {
            log.warn("rate quote API returned an error");
            sendFlexRecordUtil.savePriceRecordDtoForFailure(shipReq, e);
            throw new ResourceNotFoundException(OPTI_ERROR_MSG +
                    "An error occurred while processing the price breakdown: " + e.getMessage() + Arrays.toString(e.getStackTrace()));
        }
    }

    public PriceResult getResult(RatesDto ratesDto, ShipmentBookRequest shipmentBookRequest) {

        UserConfigResponseDTO ocmResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(shipmentBookRequest.getFacilityId(), shipmentBookRequest.getCustomerId());
        RatedShipmentDetail ratedShipmentDetail = ratesDto.getResult()
                .getRateReplyDetails().get(0)
                .getRatedShipmentDetails().get(0);

        // Extract base charge and surcharges
        Double totalBaseChargeAmount = null;
        Double totalSurchargeAmount = null;
        Double total = null;
        // Create line items list
        List<LineItemDto> lineItems = new ArrayList<>();
        if (ocmResponseDTO != null && ocmResponseDTO.getCustomer() != null &&
                (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(FEDEX) &&
                        ocmResponseDTO.getCustomer().getFedexPricingVisibility().equalsIgnoreCase(ServiceCommonConstants.SHOW_LINE_ITEM_PRICING))) {

            totalBaseChargeAmount = ratedShipmentDetail.getTotalBaseCharge();
            totalSurchargeAmount = ratedShipmentDetail.getShipmentRateDetail().getTotalSurcharges();
            // Add base charge line item
            lineItems.add(new LineItemDto(ServiceCommonConstants.TOTAL_BASE_CHARGE_AMOUNT, totalBaseChargeAmount));

            // Add each surcharge as a separate line item
            //Intervention surcharges should now be getting returned from the ratequote API, so no need to calculate separately
            List<Surcharge> surcharges = ratedShipmentDetail.getShipmentRateDetail().getSurcharges();
            for (Surcharge surcharge : surcharges) {
                String surchargeLower = surcharge.getType().toLowerCase().replace(ServiceCommonConstants.UNDERSCORE_DELIMITER, ServiceCommonConstants.SPACE_DELIMITER);
                lineItems.add(new LineItemDto(surchargeLower.substring(0, 1).toUpperCase() + surchargeLower.substring(1), surcharge.getAmount()));
            }

            total = totalBaseChargeAmount + totalSurchargeAmount;
        } else if (ocmResponseDTO != null && ocmResponseDTO.getCustomer() != null
                && (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(FEDEX) &&
                ocmResponseDTO.getCustomer().getFedexPricingVisibility().equalsIgnoreCase(ServiceCommonConstants.SHOW_TOTAL_PRICING_ONLY))) {
            Double baseChanges = ratedShipmentDetail.getTotalBaseCharge();
            Double surroundCharges = ratedShipmentDetail.getShipmentRateDetail().getTotalSurcharges();

            total = baseChanges + surroundCharges;
        }
        // Build and return the final price result
        return PriceResult.builder()
                .lineItem(lineItems)
                .total(total)
                .baseCost(totalBaseChargeAmount)
                .accessorialCost(totalSurchargeAmount)
                .build();
    }


    public PriceResult uspsPriceBreakdown(ShipmentRequestDTO shipmentRequestDTO, UserConfigResponseDTO ocmResponseDTO) {
