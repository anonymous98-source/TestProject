public class PreferredAddressServiceImpl implements PreferredAddressService {

  private final PreferredShipFromAddressRepository preferredShipFromAddressRepository;

  @Override
  public SuccessResponse upsertPreferredAddress(
      PreferredShipFromAddressDTO preferredAddressDto, String userEmail) {

    Optional<PreferredShipFromAddress> preferredShipFromAddress =
        preferredShipFromAddressRepository.findByFacilityIdAndUserEmail(
            preferredAddressDto.getFacilityId(), userEmail);
    if (preferredShipFromAddress.isEmpty()) {
      PreferredShipFromAddress preferredShipFromAddressInsert =
          mapToEntity(preferredAddressDto, userEmail, null);
      preferredShipFromAddressRepository.save(preferredShipFromAddressInsert);
      return SuccessResponse.builder()
          .status(SUCCESS)
          .message("Preferred address saved successfully")
          .build();
    } else {
      PreferredShipFromAddress updateEntity = preferredShipFromAddress.get();
      mapToEntity(preferredAddressDto, userEmail, updateEntity);
      preferredShipFromAddressRepository.save(updateEntity);
      return SuccessResponse.builder()
          .status(SUCCESS)
          .message("Preferred address updated successfully")
          .build();
    }
  }

  @Override
  public SuccessResponse deletePreferredAddress(String userEmail, String facilityId) {
    long deletedCount =
        preferredShipFromAddressRepository.deleteByUserEmailAndFacilityId(userEmail, facilityId);

    if (deletedCount == 0) {
      throw new ResourceNotFoundException(
          "Preferred ship from address not found for given facilityId: " + facilityId);
    }

    return SuccessResponse.builder()
        .status(SUCCESS)
        .message("Preferred ship from address deleted successfully")
        .build();
  }

  private PreferredShipFromAddress mapToEntity(
      PreferredShipFromAddressDTO dto, String userEmail, PreferredShipFromAddress entity) {

    if (entity == null) {
      entity = new PreferredShipFromAddress();
    }

    Address address = dto.getAddress();
    List<String> addressLines = address.getAddressLines();

    entity.setUserEmail(userEmail);
    entity.setFacilityId(dto.getFacilityId());
    entity.setShipFromAddressName(address.getName());
    entity.setShipFromCompany(address.getCompany());
    entity.setShipFromAddressLine1(getAddressLine(addressLines, 0));
    entity.setShipFromAddressLine2(getAddressLine(addressLines, 1));
    entity.setShipFromAddressLine3(getAddressLine(addressLines, 2));
    entity.setShipFromZip(address.getZipCode());
    entity.setShipFromCity(address.getCity());
    entity.setShipFromState(address.getState());
    entity.setShipFromCountry(address.getCountry());
    entity.setShipFromPhoneNumber(address.getPhoneNumber());
    entity.setShipFromEmail(address.getEmailAddress());
    entity.setShipFromPhoneExtension(address.getPhoneExt());

    return entity;
  }

  private String getAddressLine(List<String> addressLines, int index) {
    return (addressLines != null && addressLines.size() > index) ? addressLines.get(index) : null;
  }
}

