/** This WebClient service is used for TrackingResource API call. */
@Component
@Slf4j
public class TrackingResourceWebClientService {

  private final AdvShippingIntegrationApiProperties advshipIntegrationApiProperties;
  private final WebClient webClient;
  private final RetryConfig retryConfig;
 
  private final TrackingFailureLogRepository trackingFailureLogRepository;

  private final ObjectMapper objectMapper;

  public TrackingResourceWebClientService(@Qualifier("webClientNoAuth") WebClient webClient,
                                          AdvShippingIntegrationApiProperties advshipIntegrationApiProperties, RetryConfig retryConfig, TrackingFailureLogRepository trackingFailureLogRepository,
                                          ObjectMapper objectMapper) {
    this.advshipIntegrationApiProperties = advshipIntegrationApiProperties;
      this.retryConfig = retryConfig;
      this.objectMapper = objectMapper;
    this.webClient =
            webClient.mutate()
                    .clientConnector(
                            new ReactorClientHttpConnector(
                                    HttpClient.create()
                                            .responseTimeout(Duration.ofSeconds(TIMEOUT_SECONDS))
                                            .doOnConnected(connection -> connection.addHandlerLast(new ReadTimeoutHandler(TIMEOUT_SECONDS)).addHandlerLast(new WriteTimeoutHandler(TIMEOUT_SECONDS)))))
                    .build();
      this.trackingFailureLogRepository = trackingFailureLogRepository;
  }

  @SneakyThrows
  public <T> Mono<T> trackingResourceRequest(
          String endpoint,
          HttpMethod method,
          Map<String, String> additionalHeaders,
          Object requestBody,
          Class<T> responseType, String aspectName) {

    log.atInfo()
            .addKeyValue("endpoint", endpoint)
            .addKeyValue(METHOD, method.toString())
            .addKeyValue("additional headers", additionalHeaders.toString())
            .setMessage("Tracking Resource API request call")
            .log();

    String jsonBody = objectMapper.writeValueAsString(requestBody);

    return webClient
            .method(method)
            .uri(getURI(endpoint, aspectName))
            .headers(httpHeaders -> {
              getDefaultHeaders().forEach(httpHeaders::add);
              if(!additionalHeaders.isEmpty()) {
                additionalHeaders.forEach(httpHeaders::add);
              }
            })
            .bodyValue(requestBody == null ? BodyInserters.empty() : jsonBody)
            .retrieve()
            .bodyToMono(responseType)
            .retryWhen(retryConfig.createRetry(3,2))
            .onErrorMap(throwable -> handleErrorMap(throwable, requestBody, aspectName, method));
  }

    @SneakyThrows
    public <T> Mono<List<T>> trackingResourceGetRequest(
            String endpoint,
            HttpMethod method,
            Map<String, String> additionalHeaders,
            Class<T> responseType, Map<String, String> queryParams) {

      log.atInfo()
              .addKeyValue("endpoint", endpoint)
              .addKeyValue(METHOD, method.toString())
              .addKeyValue("additional headers", additionalHeaders.toString())
