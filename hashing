package com.cardinalhealth.adv.shipping.integration.api.service.wrapper;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import java.lang.reflect.Field;
import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

class CsvGeneratorTest {

    static class DummyDto {
        public String field1;
        public String field2;
        public DummyDto(String f1, String f2) { this.field1 = f1; this.field2 = f2; }
    }

    private CsvGenerator<DummyDto> csvGenerator;

    @BeforeEach
    void setUp() {
        Field[] fields = DummyDto.class.getDeclaredFields();
        csvGenerator = new CsvGenerator<>(DummyDto.class, fields);
    }

    @Test
    void testExtractHeadersAndValues() throws Exception {
        Field[] fields = DummyDto.class.getDeclaredFields();
        List<String> headers = csvGenerator.getAllHeaders(fields);
        assertNotNull(headers);
        DummyDto dto = new DummyDto("a", "b");
        java.lang.reflect.Method m = CsvGenerator.class.getDeclaredMethod("extractValues", Object.class);
        m.setAccessible(true);
        List<Object> values = (List<Object>) m.invoke(csvGenerator, dto);
        assertEquals(2, values.size());
        assertEquals("a", values.get(0));
        assertEquals("b", values.get(1));
    }
}

