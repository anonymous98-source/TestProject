import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;
import reactor.netty.http.client.HttpClient;

/**
 * This WebClient service is used for SendFlex API call.
 */
@Component
@Slf4j
public class SendFlexWebClientService {

  private final PerfTestDeterminer perfTestDeterminer;
  private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;
  private final RetryConfig retryConfig;

  @Qualifier("webClientNoAuth")
  private final WebClient webClient;


  public SendFlexWebClientService(RetryConfig retryConfig, @Qualifier("webClientNoAuth") WebClient webClient, AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties, PerfTestDeterminer perfTestDeterminer) {

    this.retryConfig = retryConfig;
    this.perfTestDeterminer = perfTestDeterminer;
    this.advShippingIntegrationApiProperties = advShippingIntegrationApiProperties;

    this.webClient = webClient.mutate().clientConnector(new ReactorClientHttpConnector(HttpClient.create().responseTimeout(Duration.ofSeconds(TIMEOUT_SECONDS)).doOnConnected(connection -> connection.addHandlerLast(new ReadTimeoutHandler(TIMEOUT_SECONDS)).addHandlerLast(new WriteTimeoutHandler(TIMEOUT_SECONDS))))).build();
  }

  @SneakyThrows
  public <T> Mono<T> sendFlexRequest(String endpoint, HttpMethod method, Map<String, String> additionalHeaders, Object requestBody, Class<T> responseType) {

    log.atInfo().log("sendflex API request call, endpoint: {}, method: {}, additional headers: {}", endpoint, method.toString(), additionalHeaders.toString());

    return webClient.method(method).uri(getURI(endpoint)).headers(httpHeaders -> {
      getDefaultHeaders().forEach(httpHeaders::add);
      if (!additionalHeaders.isEmpty()) {
        additionalHeaders.forEach(httpHeaders::add);
      }
    }).bodyValue(requestBody == null ? Mono.empty() : requestBody).retrieve().bodyToMono(responseType).retryWhen(retryConfig.createRetry(MAX_ATTEMPTS, INITIAL_DELAY_SECONDS)).onErrorMap(throwable -> handleErrorMap(throwable, endpoint));
  }

  private boolean usePerfTestSendFlexUrl(String endpoint) {
    if (endpoint.equals(ServiceCommonConstants.SHIPMENT_BOOK_SUB_URI)) {
      return perfTestDeterminer.usePerfTestUrl();
    }
    return false;
  }

  private URI getURI(String endpoint) {
    var baseUrl = usePerfTestSendFlexUrl(endpoint) ? advShippingIntegrationApiProperties.getSendflex().getApi().getPerfTestUrl() : advShippingIntegrationApiProperties.getSendflex().getApi().getUrl();
    return new DefaultUriBuilderFactory().uriString(baseUrl).path(endpoint).build();
  }

  public Exception handleErrorMap(Throwable throwable, String endpoint) {

    if (throwable instanceof WebClientResponseException ex) {

      List<String> errorMessages =
              extractErrorMessages(ex.getResponseBodyAsString());

      int statusCode = ex.getStatusCode().value();

      if (statusCode == SendFlexErrorConstants.BAD_REQUEST
              && isIgnorableAddressValidationError(endpoint, errorMessages)) {

        log.atWarn()
                .addKeyValue("reason", ex.getMessage())
                .setMessage(
                        "SendFlex address validation returned an ignorable validation error")
                .log();

        return new ValidationException(
                "Data is not valid: " + errorMessages,
                errorMessages.toString());
      }

      return switch (statusCode) {

        case SendFlexErrorConstants.BAD_REQUEST -> {
          log.atError()
                  .setMessage(ex.getMessage())
                  .setCause(ex)
                  .setMessage("SendFlex API request failed")
                  .log();

          yield new ValidationException(
                  "Data is not valid: " + errorMessages,
                  errorMessages.toString());
        }

        case SendFlexErrorConstants.UNAUTHORIZED -> {
          log.atError()
                  .setMessage(ex.getMessage())
                  .setCause(ex)
                  .setMessage("SendFlex API request failed")
                  .log();

          yield new UnAuthorizedException(
                  "Not authorized request" + errorMessages);
        }

        case SendFlexErrorConstants.NOT_FOUND -> {
          log.atError()
                  .setMessage(ex.getMessage())
                  .setCause(ex)
                  .setMessage("SendFlex API request failed")
                  .log();

          yield new ResourceNotFoundException(
                  "Resource is not found: " + errorMessages);
        }

        default -> {
          log.atError()
                  .setMessage(ex.getMessage())
                  .setCause(ex)
                  .setMessage("SendFlex API request failed")
                  .log();

          yield new RuntimeException(
                  "Unknown HTTP error occurred: "
                          + ex.getStatusCode()
                          + " - "
                          + errorMessages);
        }
      };

    } else {

      log.atError()
              .log(
                      "Unexpected SendFlex API error occurred: {}",
                      throwable.getMessage(),
                      throwable);

      return new RuntimeException(
              "Unexpected error occurred: "
                      + "sendflex API request failed and it's not WebClientResponseException"
                      + throwable.getMessage()
                      + Arrays.toString(throwable.getStackTrace()));
    }
  }

  public void findErrors(JsonNode root, Set<String> errors) {
    if (root.isArray()) {
      root.elements().forEachRemaining(element -> findErrors(element, errors));
    } else if (root.isObject()) {
      root.fields()
          .forEachRemaining(
              field -> {
                if (field.getKey().equals("contents")) {
                  errors.add(field.getValue().asText());
                }
                findErrors(field.getValue(), errors);
              });
    }
  }

  private List<String> extractErrorMessages(String responseBody) {
    LinkedHashSet<String> errorMessages = new LinkedHashSet<>();
    try {
      ObjectMapper mapper = new ObjectMapper();
      JsonNode root = mapper.readTree(responseBody);
      findErrors(root, errorMessages);
    } catch (Exception e) {
      log.error("Failed to parse error messages from response body", e);
    }
    return new ArrayList<>(errorMessages);
  }


  private Map<String, String> getDefaultHeaders() {
    Map<String, String> headers = new HashMap<>();
    headers.put("Content-Type", CONTENT_TYPE);
    headers.put("Accept", ACCEPT_TYPE);
    headers.put("X-API-Key", advShippingIntegrationApiProperties.getSendflex().getApi().getKey());
    return headers;
  }

  public <T> Mono<List<T>> sendFlexListRequest(String endpoint, HttpMethod method, Map<String, String> additionalHeaders, Object requestBody, ParameterizedTypeReference<List<T>> responseType) {

    return webClient.method(method).uri(getURI(endpoint)).headers(httpHeaders -> {
      getDefaultHeaders().forEach(httpHeaders::add);
      if (!additionalHeaders.isEmpty()) {
        additionalHeaders.forEach(httpHeaders::add);
      }
    }).bodyValue(requestBody).retrieve().bodyToMono(responseType).retryWhen(retryConfig.createRetry(MAX_ATTEMPTS, INITIAL_DELAY_SECONDS)).onErrorMap(throwable -> handleErrorMap(throwable, endpoint));
  }

  private boolean isIgnorableAddressValidationError(
          String endpoint, List<String> errorMessages) {

    if (!ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT.equals(endpoint)) {
      return false;
    }

    return errorMessages.stream().anyMatch(errorMessage ->
            errorMessage.contains("SYSTEM.UNEXPECTED.ERROR")
                    || errorMessage.contains(
                    ServiceCommonConstants.FED_EX_WAS_UNABLE_TO_PROVIDE_ANY_VALID_ADDRESS_SUGGESTIONS)
                    || errorMessage.contains(ServiceCommonConstants.STANDARDIZED_ADDRESS_NOTFOUND)
                    || errorMessage.contains(ServiceCommonConstants.INTERPOLATED_STREET_ADDRESS)
                    || errorMessage.contains(ServiceCommonConstants.STATEORPROVINCECODE_TOO_LONG)
                    || errorMessage.contains(ServiceCommonConstants.INVALID_SUITE_NUMBER));
  }

}

