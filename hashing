  private static List<FillDto> getFillsFromResourceResponse(PackageResourceDto packageResourceDto) {

    Reference referenceDetails = new Reference();
    if (Objects.nonNull(packageResourceDto.getExternalReference())) {
      try {
        referenceDetails =
            objectMapper.convertValue(
                packageResourceDto.getExternalReference().getExternalReferenceValueJson(),
                Reference.class);
      } catch (Exception e) {
        log.atError()
                .setMessage("Error to create Reference from ExternalReferenceResourceDto")
                .log();
        referenceDetails = new Reference();
      }
    }
    return prepareFillDtos(
        prepareList(referenceDetails.getFillId()),
        prepareList(referenceDetails.getPrescriptionNumber()));
  }

  private static List<FillDto> prepareFillDtos(
      List<String> fillIds, List<String> prescriptionNumbers) {
    // Check if both lists have same count of elements, if not then adjust them
    adjustElementCount(fillIds, prescriptionNumbers);
    return IntStream.range(0, fillIds.size())
        .mapToObj(i -> new FillDto(fillIds.get(i), prescriptionNumbers.get(i)))
        .toList();
  }

  // used for epic
  private static List<NotificationDto> getNotificationsFromTrackingResourceDto(
      TrackingResourceDto trackingResourceDto) {
    if (Objects.nonNull(trackingResourceDto)
        && Objects.nonNull(trackingResourceDto.getNotifications())) {
      return trackingResourceDto.getNotifications().stream()
          .map(
              n ->
                  NotificationDto.builder()
                      .notificationCommunicationChannel(n.getNotificationCommunicationChannel())
                      .notificationCommunicationValue(n.getNotificationCommunicationValue())
                      .notificationEventSubscription(n.getNotificationEventSubscription())
                      .notificationId(n.getId())
                      .build())
          .toList();
    }
    // tracking or getNotifications is null
    return Collections.emptyList();
  }

