import org.springframework.aop.support.AopUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Component
public class ShippingRuleServiceFactory {
    private final Map<String, ShippingRuleService<?>> shippingRuleServices = new HashMap<>();


    @Autowired
    public ShippingRuleServiceFactory(
            List<ShippingRuleService<?>> serviceList) {

        // Register generic services
        for (ShippingRuleService<?> service : serviceList) {
            shippingRuleServices.put(resolveKey(service), service);
        }
    }

    private static final Map<Class<?>, String> SERVICE_KEY_MAP = Map.ofEntries(
            Map.entry(ShippingRuleWeightService.class, ShippingRuleConstants.WEIGHT_RULE),
            Map.entry(ShipmentValueRuleService.class, ShippingRuleConstants.SHIPMENT_VALUE_RULE),
            Map.entry(ShipViaRuleService.class, ShippingRuleConstants.SHIP_VIA_RULE),
            Map.entry(ColdChainRuleService.class, ShippingRuleConstants.COLD_CHAIN_RULE),
            Map.entry(ZipCodeRuleService.class, ShippingRuleConstants.ZIP_CODE_RULE)
    );

    private String resolveKey(Object service) {
        String key = SERVICE_KEY_MAP.get(AopUtils.getTargetClass(service));
        if (key == null) {
            throw new IllegalArgumentException("Unknown service type: " + service.getClass());
        }
        return key;
    }

    public ShippingRuleService<ShippingRuleResponseDto> getShippingRuleService(String ruleType) {
        ShippingRuleService<ShippingRuleResponseDto> shippingRuleService = (ShippingRuleService<ShippingRuleResponseDto>) shippingRuleServices.get(ruleType);
        if (shippingRuleService == null) {
            throw new IllegalArgumentException("No service found for ruleType : " + ruleType);
        }
        return shippingRuleService;
    }

}

