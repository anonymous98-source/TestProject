import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.SHIPMENT_VALUE_CARRIER_DISABLED;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.SHIPPING_PROFILE_NOT_RESOLVED;

/**
 * Facade to orchestrate the rule evaluation process. It validates the request, preferred rule, checks for applicable rules,
 * executes the rule evaluation chain, and resolves the shipping profile based on the matched rule.
 */

@Slf4j
@Component
@RequiredArgsConstructor
public class RuleEvaluationFacade {

    private final PreferredRuleValidator preferredRuleValidator;
    private final ApplicableRuleFilter applicableRuleFilter;
    private final RuleExecutionChain executionChain;
    private final ShippingProfileResolver shippingProfileResolver;
    private final RuleEvaluatorUtil ruleEvaluatorUtil;

    /**
     * Orchestrates the rule evaluation process for a given request. It performs the following steps:
     * 1. Validates the incoming request payload.
     * 2. Retrieves carrier access information based on the request parameters.
     * 3. CASE-1: Validates if the requested rule type is the preferred rule type (except for SHIPMENT_VALUE).
     * 4. CASE-2: Checks if the requested rule is applicable for the given request. -
     * 5. CASE-3: For SHIPMENT_VALUE rule type, validates carrier access before executing the rule evaluation.
     * 6. Executes the rule evaluation chain to find the matched rule.
     * 7. CASE-4: If a matched rule is found, and it's not SHIPMENT_VALUE, it resolves the shipping profile based on the matched rule and carrier accessibility.
     * 8. Returns the final response with the matched rule and assigned shipping profile if applicable, or a default response if no rule
     *
     */

    public RuleEvaluationResponseDto evaluate(RuleEvaluationRequestDto request) {

        log.atInfo()
                .setMessage("Starting rule evaluation process for ruleType: " + request.getRuleType())
                .log();

        //validate request payload
        ruleEvaluatorUtil.validateRequest(request);

        // extract all carrier/courier access
        OCMResponse ocmResponse = ruleEvaluatorUtil
                .getAllCarrierAccess(request.getFacilityId(), request.getCustomerId(), request.getZipCode().substring(0, 5));

        // validate if the request rule is preferred rule type
        if (!request.getRuleType().equals(RuleType.SHIPMENT_VALUE)
                && !preferredRuleValidator.isPreferredRule(request)) {
            log.atInfo().setMessage(PREFERRED_RULE_NOT_FOUND).log();
            return ruleEvaluatorUtil.getDefaultResponse(
                    request,
                    ocmResponse,
                    PREFERRED_RULE_NOT_FOUND);
        }

        // validate if requested rule is applicable for the request
        if (!applicableRuleFilter.isApplicableRule(request)) {
            log.atInfo().setMessage(RULE_NOT_APPLICABLE).log();
            return ruleEvaluatorUtil.getDefaultResponse(
                    request,
                    ocmResponse,
                    RULE_NOT_APPLICABLE);
        }

        // validate carrier access for shipmentValueRule before executing
        if (request.getRuleType().equals(RuleType.SHIPMENT_VALUE)
                && Boolean.FALSE.equals(ocmResponse.getCarrierAccessibilityMap().get(request.getCarrier()))
        ) {
            log.atInfo().setMessage(SHIPMENT_VALUE_CARRIER_DISABLED).log();
            return ruleEvaluatorUtil.getDefaultResponse(
                    request,
                    ocmResponse,
                    SHIPMENT_VALUE_CARRIER_DISABLED);
        }

        /**
         *  Finally execute the rule evaluation chain to get the matched rule and
         *  get final matched rule after all conflict resolution, validations and filters
         */
        RuleEvaluationResult result = executionChain.execute(request);
        if (result != null && result.getPrimary() != null
                && !request.getRuleType().equals(RuleType.SHIPMENT_VALUE)) {

            log.atInfo().setMessage("Matched rule found, processing for shipping profile resolution").log();

            AssignedShippingProfile assignedShippingProfile = shippingProfileResolver
                    .validateShippingProfile(result.getPrimary(), ocmResponse.getCarrierAccessibilityMap());

            if (assignedShippingProfile == null) {
                return ruleEvaluatorUtil.getDefaultResponse(
                        request,
                        ocmResponse,
                        SHIPPING_PROFILE_NOT_RESOLVED);
            }

            return ruleEvaluatorUtil.getResolvedResponse(
                    request,
                    result,
                    assignedShippingProfile,
                    ocmResponse);
        }

        // Return final response: mostly hit when ruleType is SHIPMENT_VALUE
        return (result != null && result.hasAnyMatch())
                ? ruleEvaluatorUtil.getResolvedResponse(request, result, null, ocmResponse)
                : ruleEvaluatorUtil.getDefaultResponse(request, ocmResponse, RULE_NOT_FOUND);
    }
}

