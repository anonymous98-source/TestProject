public class AdditionalServicesMapper {


    public void mapAdditionalServices(ShipmentRequestDTO sendFlexRequest, ShipPlanRequest shipPlanRequest) {
        String shippingProfile = shipPlanRequest.getShippingProfile();
        // Handle package-level accessorials
        mapPackageLevelAccessorials(sendFlexRequest, shipPlanRequest, shippingProfile);
    }

    private void mapPackageLevelAccessorials(ShipmentRequestDTO sendFlexRequest, ShipPlanRequest shipPlanRequest, String shippingProfile) {
        List<ShippingUnitDTO> shippingUnits = sendFlexRequest.getShippingUnits();

        for (var i = 0; i < shipPlanRequest.getPackagingDetails().size(); i++) {
            PackagingDetails packagingDetails = shipPlanRequest.getPackagingDetails().get(i);
            ShippingUnitDTO shippingUnit = shippingUnits.get(i);

            // Ensure the map is mutable
            Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap = shippingUnit.getCarrierAddOns() != null ?
                    new HashMap<>(shippingUnit.getCarrierAddOns()) : new HashMap<>();

            // Handle FedEx-specific services
            if (shippingProfile.equalsIgnoreCase(FEDEX)) {
                handleFedExSpecificServices(packagingDetails, carrierAddOnsMap);
            }

            // Handle USPS-specific services
            if (shippingProfile.equalsIgnoreCase(USPS)) {
                handleUSPSSpecificServices(packagingDetails, carrierAddOnsMap);
            }

            // handle DHL-specific services
            if (shippingProfile.equalsIgnoreCase(DHL)){
                handleDHLSpecificServices(packagingDetails, carrierAddOnsMap);
            }

            // Handle services applicable to both FedEx, USPS and DHL
            handleCommonServices(packagingDetails, carrierAddOnsMap, shippingProfile);

            // Add references for FedEx only
            if (shippingProfile.equalsIgnoreCase(FEDEX)) {
                List<ReferencesDTO> references = getReferences(packagingDetails.getReference());
                shippingUnit.setReferences(references);
            }

            shippingUnit.setCarrierAddOns(carrierAddOnsMap);
        }
    }

    private void handleFedExSpecificServices(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap) {
        // Handle Lithium Batteries
        if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getLithiumBattery())) {
            List<CarrierAddOnsDTO> lithiumBatteryAddOns = new ArrayList<>();
            if (packagingDetails.getAccessorials().getMetalContainedInEquipment()) {
                CarrierAddOnsDTO lithiumBatteryAddOn = CarrierAddOnsDTO.builder()
                        .key(MATERIAL)
                        .value(LITHIUM_METAL)
                        .build();
                CarrierAddOnsDTO lithiumPackingAddOn = CarrierAddOnsDTO.builder()
                        .key(PACKING)
                        .value(CONTAINED_IN_EQUIPMENT)
                        .build();
                lithiumBatteryAddOns.add(lithiumBatteryAddOn);
                lithiumBatteryAddOns.add(lithiumPackingAddOn);
            }
            if (packagingDetails.getAccessorials().getMetalPackedWithEquipment()) {
                CarrierAddOnsDTO lithiumBatteryAddOn = CarrierAddOnsDTO.builder()
                        .key(MATERIAL)
                        .value(LITHIUM_METAL)
                        .build();
                CarrierAddOnsDTO lithiumPackingAddOn = CarrierAddOnsDTO.builder()
                        .key(PACKING)
                        .value(PACKED_WITH_EQUIPMENT)
                        .build();
                lithiumBatteryAddOns.add(lithiumBatteryAddOn);
                lithiumBatteryAddOns.add(lithiumPackingAddOn);
            }
            if (packagingDetails.getAccessorials().getIonContainedInEquipment()) {
                CarrierAddOnsDTO lithiumBatteryAddOn = CarrierAddOnsDTO.builder()
                        .key(MATERIAL)
                        .value(LITHIUM_ION)
                        .build();
                CarrierAddOnsDTO lithiumPackingAddOn = CarrierAddOnsDTO.builder()
                        .key(PACKING)
                        .value(CONTAINED_IN_EQUIPMENT)
                        .build();
                lithiumBatteryAddOns.add(lithiumBatteryAddOn);
                lithiumBatteryAddOns.add(lithiumPackingAddOn);
            }
            if (packagingDetails.getAccessorials().getIonPackedWithEquipment()) {
                CarrierAddOnsDTO lithiumBatteryAddOn = CarrierAddOnsDTO.builder()
                        .key(MATERIAL)
                        .value(LITHIUM_ION)
                        .build();
                CarrierAddOnsDTO lithiumPackingAddOn = CarrierAddOnsDTO.builder()
                        .key(PACKING)
                        .value(PACKED_WITH_EQUIPMENT)
                        .build();
                lithiumBatteryAddOns.add(lithiumBatteryAddOn);
                lithiumBatteryAddOns.add(lithiumPackingAddOn);
            }
            carrierAddOnsMap.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
        }

        // Handle Shipment Protection (OptiFreight®)
        if (packagingDetails.getPackaging().getIsIndividualShipmentProtection()) {
            CarrierAddOnsDTO shipmentProtectionAddOn = CarrierAddOnsDTO.builder()
                    .key(INSURANCE_VALUE)
                    .value(String.valueOf(packagingDetails.getPackaging().getCoverageAmount()))
                    .build();
            carrierAddOnsMap.put(INSURANCE, List.of(shipmentProtectionAddOn));
        } else if (packagingDetails.getAccessorials().isDeclaredValue()) {
            // Handle Declared Value
            CarrierAddOnsDTO declaredValueAddOn = CarrierAddOnsDTO.builder()
                    .key(INSURANCE_VALUE)
                    .value(String.valueOf(packagingDetails.getAccessorials().getValueOfContent()))
                    .build();
            carrierAddOnsMap.put(INSURANCE, List.of(declaredValueAddOn));
        }
    }

    private void handleUSPSSpecificServices(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap) {
        Accessorials accessorials = packagingDetails.getAccessorials();

        // Handle Lithium Batteries for USPS
        if (Boolean.TRUE.equals(accessorials.getLithiumBattery())) {
            // Validate only one lithium battery option is selected
            validateSingleLithiumBatterySelection(accessorials, USPS);

            List<CarrierAddOnsDTO> lithiumBatteryAddOns = new ArrayList<>();

            if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) {
                lithiumBatteryAddOns.add(CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
                lithiumBatteryAddOns.add(CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_STANDALONE).build());
            }

            if (Boolean.TRUE.equals(accessorials.getMetalPackedWithEquipment()) ||
                    Boolean.TRUE.equals(accessorials.getIonContainedInEquipment()) ||
                    Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) {
                lithiumBatteryAddOns.add(CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
                lithiumBatteryAddOns.add(CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
            }

            if (!lithiumBatteryAddOns.isEmpty()) {
                carrierAddOnsMap.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
            }
        }

        // Handle Additional Insurance
        if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getAddOnInsurance())) {
            CarrierAddOnsDTO additionalInsuranceAddOn = CarrierAddOnsDTO.builder()
                    .key(INSURANCE_VALUE)
                    .value(String.valueOf(packagingDetails.getAccessorials().getAddOnInsuranceValue()))
                    .build();
            carrierAddOnsMap.put(INSURANCE, List.of(additionalInsuranceAddOn));
        }
    }

    private void handleDHLSpecificServices(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap) {
        Accessorials accessorials = packagingDetails.getAccessorials();

        if(Boolean.TRUE.equals(accessorials.getContainsDryIce())){
            throw new ValidationException("Dry Ice is not supported for DHL shipments.");
        }

        if(Boolean.TRUE.equals(accessorials.getColdChain())){
            throw new ValidationException("Cold Chain is not supported for DHL shipments.");
        }

        // Handle Lithium Batteries for DHL
        if (Boolean.TRUE.equals(accessorials.getLithiumBattery())){
            // Validate only one lithium battery option is selected
            validateSingleLithiumBatterySelection(accessorials, DHL);

            List<CarrierAddOnsDTO> lithiumBatteryAddOns = new ArrayList<>();
            if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_METAL).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(CONTAINED_IN_EQUIPMENT).build());
            } else if (Boolean.TRUE.equals(accessorials.getMetalPackedWithEquipment())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_METAL).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
            } else if (Boolean.TRUE.equals(accessorials.getIonContainedInEquipment())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(CONTAINED_IN_EQUIPMENT).build());
            } else if (Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
            } else if (Boolean.TRUE.equals(accessorials.getIonStandalone())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_STANDALONE).build());
            } else if (Boolean.TRUE.equals(accessorials.getMetalStandalone())) {
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_METAL).build());
                lithiumBatteryAddOns.add(
                        CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_STANDALONE).build());
            }
             carrierAddOnsMap.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
        }

        // Handle Additional Insurance
        if (Boolean.TRUE.equals(accessorials.getAddOnInsurance())) {
            CarrierAddOnsDTO additionalInsuranceAddOn = CarrierAddOnsDTO.builder()
                    .key(INSURANCE_VALUE)
                    .value(String.valueOf(accessorials.getAddOnInsuranceValue()))
                    .build();
            carrierAddOnsMap.put(INSURANCE, List.of(additionalInsuranceAddOn));
        }

    }

    private void handleCommonServices(PackagingDetails packagingDetails, Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap, String shippingProfile) {
        Accessorials accessorials = packagingDetails.getAccessorials();

        // Validation: Dry Ice cannot be present with Lithium Batteries for USPS and DHL
        if (Boolean.TRUE.equals(accessorials.getContainsDryIce()) &&
                Boolean.TRUE.equals(accessorials.getLithiumBattery()) &&
                (USPS.equalsIgnoreCase(shippingProfile) || DHL.equalsIgnoreCase(shippingProfile))) {
            throw new ValidationException("Dry Ice cannot be shipped with Lithium Batteries for " + shippingProfile + " shipments.");
        }

        // Handle Dry Ice
        if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getContainsDryIce())) {
            CarrierAddOnsDTO dryIceAddOn = CarrierAddOnsDTO.builder()
                    .key(DRY_ICE_WEIGHT)
                    .value(String.valueOf(packagingDetails.getAccessorials().getWeight()))
                    .build();
            carrierAddOnsMap.put(DRY_ICE, List.of(dryIceAddOn));
        }
    }

    private static List<ReferencesDTO> getReferences(Reference reference) {
        List<ReferencesDTO> referencesList = new ArrayList<>();
        referencesList.add(ReferencesDTO.builder().name(REFERENCE1).value(reference.getReference3()).build());
        referencesList.add(ReferencesDTO.builder().name(REFERENCE2).value(reference.getReference1()).build());
        referencesList.add(ReferencesDTO.builder().name(REFERENCE3).value(reference.getReference2()).build());
        referencesList.add(ReferencesDTO.builder().name(REFERENCE4).value(reference.getReference4()).build());
        referencesList.add(ReferencesDTO.builder().name(REFERENCE5).value(reference.getInternalDesignationReference()).build());
        return referencesList;
    }

    private void validateSingleLithiumBatterySelection(Accessorials accessorials, String shippingProfile) {
        long lithiumOptionsCount = Stream.of(
                accessorials.getMetalContainedInEquipment(),
                accessorials.getMetalPackedWithEquipment(),
                accessorials.getIonContainedInEquipment(),
                accessorials.getIonPackedWithEquipment(),
                accessorials.getIonStandalone(),
                accessorials.getMetalStandalone()
        ).filter(Boolean.TRUE::equals).count();

        if (lithiumOptionsCount > 1) {
            throw new ValidationException("Only one lithium battery configuration can be selected for " + shippingProfile + " shipments.");
        }
    }
