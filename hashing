    /**
     * Processes the uploaded address book CSV file and stores valid entries in the database.
     * It validates each row, checks for duplicates, and handles errors appropriately.
     *
     * @param facilityId The facility ID to which the address book belongs.
     * @param file       The uploaded CSV file containing address book entries.
     * @param isAppend   Whether to append to existing records or replace them.
     * @return A map containing the status of the operation and any relevant messages or counts.
     */
    @Override
    public AddressBookCsvResponse processAddressBookAndStore(String facilityId, MultipartFile file, Boolean isAppend) {
        log.atInfo().setMessage("Starting address book processing")
                .addKeyValue("isAppend", isAppend).log();

        validateFacilityId(facilityId);

        String originalFilename = file.getOriginalFilename();
        if (originalFilename == null || !originalFilename.toLowerCase().endsWith(".csv")) {
            return AddressBookCsvResponse.builder().status(FAILED).message("Invalid file type. Please upload a CSV file (comma-separated, UTF-8 encoded).").build();
        }

        Map<String,ShipToAddressFacilityMapping> validEntries = new HashMap<>();
        Map<Integer,String> errorRows = new HashMap<>();
        List<String> duplicateRows = new ArrayList<>();

        try (BufferedReader reader = new BufferedReader(new InputStreamReader(file.getInputStream(), StandardCharsets.UTF_8))) {

            String headerLine = reader.readLine();
            if (headerLine == null || !headerLine.contains(",")) {
                return AddressBookCsvResponse.builder().status(FAILED).message("CSV appears to be empty or not comma-separated.").build();

            }
            String[] headers = headerLine.split(",");
            List<String> actualHeaders = Arrays.asList(headers);

            // Check if all required headers are present
            List<String> missingHeaders = EXPECTED_HEADERS.stream()
                    .filter(expected -> !actualHeaders.contains(expected))
                    .toList();
            if (!missingHeaders.isEmpty()) {
                return AddressBookCsvResponse.builder().status(FAILED).message("CSV is missing required headers: " + missingHeaders).build();
            }

            csvRowProcessing(reader, validEntries, errorRows, duplicateRows, facilityId, headers);
        } catch (Exception e) {
            throw new ShippingIntegrationException("Error processing CSV file" + e.getMessage() + Arrays.toString(e.getStackTrace()));

        }

        if(!errorRows.isEmpty()) {
            return validationFailureErrorMessage(errorRows);
        }


        Set<String> duplicateDatabaseEntries;
        List<ShipToAddressFacilityMapping> databaseDuplicateFilterList;
        if(Boolean.TRUE.equals(isAppend)){
            duplicateDatabaseEntries= getDuplicateRowsDBLevel(validEntries.keySet(),facilityId);
            databaseDuplicateFilterList=validEntries.keySet().stream().filter(key-> !duplicateDatabaseEntries.contains(key)).map(validEntries::get).toList();
        }
        else {
            duplicateDatabaseEntries = new HashSet<>();
            databaseDuplicateFilterList=validEntries.values().stream().toList();
        }
        saveDatabaseEntries(facilityId, isAppend, databaseDuplicateFilterList);
        return successMessage(databaseDuplicateFilterList.size(), duplicateRows.size()+duplicateDatabaseEntries.size(),isAppend);
    }

    private Set<String> getDuplicateRowsDBLevel(Set<String> uniqueRowKeys, String monarchFacilityId) {
        int page = 0;
        int pageSize = 10000;
        Set<String> duplicateDebaseEntries = new HashSet<>();

        try {
            while (true) {
                Pageable pageable = PageRequest.of(page, pageSize);
                Page<ShipToAddress> currentPage =
                        shipToAddressFacilityMappingRepository.findShipToAddressByMonarchFacilityId(monarchFacilityId, pageable);
                if (currentPage.isEmpty()) break;
                List<ShipToAddress> shipToAddresses = currentPage.getContent();
                for (ShipToAddress shipToAddress : shipToAddresses) {
                    String uniqueRowKey = EXPECTED_HEADERS.stream()
                            .map(header -> {
                                String value = switch (header) {
                                    case COMPANY_NAME -> shipToAddress.getCompany();
                                    case ADDRESS_NAME -> shipToAddress.getAddressName();
                                    case ADDRESS_LINE_1 -> shipToAddress.getAddressLine1();
                                    case ADDRESS_LINE_2 -> shipToAddress.getAddressLine2();
                                    case ADDRESS_LINE_3 -> shipToAddress.getAddressLine3();
                                    case ZIP -> shipToAddress.getZipCode();
                                    case CITY -> shipToAddress.getCity();
                                    case STATE -> shipToAddress.getState();
                                    case COUNTRY -> shipToAddress.getCountry();
                                    case PHONE_NUMBER -> shipToAddress.getPhoneNumber();
                                    case EMAIL -> shipToAddress.getEmail();
                                    case DELIVERY_NOTES -> shipToAddress.getDeliveryNotes();
                                    case ADDRESS_EXTENSION -> shipToAddress.getExtension();
                                    case IS_RESIDENTIAL -> String.valueOf(shipToAddress.isResidentialAddress());
                                    default -> "";
                                };
                                return StringUtils.trimToEmpty(value).toLowerCase().trim();
                            })
                            .collect(Collectors.joining("|")); // delimiter can be anything not present in data

                    if (uniqueRowKeys.contains(uniqueRowKey)) {
                        duplicateDebaseEntries.add(uniqueRowKey);
                    }
                }
                page++;
            }
        } catch (Exception e) {
            throw new DatabaseException("Error fetching unique database entries from the database"
            + e.getMessage() + Arrays.toString(e.getStackTrace()));
        }
        return duplicateDebaseEntries;
    }


    /**
     * Processes each row of the CSV file, validates it, checks for duplicates,
     * and maps valid rows to ShipToAddressFacilityMapping entities.
     *
     * @param reader            The BufferedReader to read the CSV file.
     * @param validEntries      The list to store valid ShipToAddressFacilityMapping entries.
     * @param errorRows         A map to store error messages for invalid rows.
     * @param duplicateRows     A list to store messages about duplicate rows.
     * @param facilityId        The facility ID to which the entries belong.
     * @param headers           The headers of the CSV file.
     * @throws IOException If an error occurs while reading the file.
     */
    private void csvRowProcessing(BufferedReader reader, Map<String,ShipToAddressFacilityMapping> validEntries, Map<Integer, String> errorRows, List<String> duplicateRows, String facilityId, String[] headers) throws IOException {
        String rowLine;
        int rowNum=2;
        while ((rowLine = reader.readLine()) != null) {
            String[] values = rowLine.split(",", -1);
            Map<String, String> row = new HashMap<>();
            for (int i = 0; i < headers.length; i++) {
                row.put(headers[i], values.length > i ? values[i].trim() : "");
            }

            // Create a normalized unique string for the entire row
            String uniqueRowKey = EXPECTED_HEADERS.stream()
                    .map(header -> {
                        if (header.equalsIgnoreCase(IS_RESIDENTIAL)) {
                            return String.valueOf(RESIDENTIAL_ADDRESS_TRUE_VALUES.contains(row.getOrDefault(header, "").toLowerCase().trim()));
                        } else {
                            return row.getOrDefault(header, "").toLowerCase().trim();
                        }
                    })
                    .collect(Collectors.joining("|"));// delimiter can be anything not present in data

            if (validEntries.containsKey(uniqueRowKey)) {
                duplicateRows.add("Row " + rowNum + ": Duplicate row skipped.");
                rowNum++;
                continue;
            } else {
                validEntries.put(uniqueRowKey,null);
            }

            Optional<String> error = validateRow(row);
            if (error.isPresent()) {
                errorRows.put(rowNum , error.get());
            } else {
                ShipToAddressFacilityMapping entry = mapToEntity(row, facilityId);
                validEntries.put(uniqueRowKey,entry);
            }
            rowNum++;
        }
    }


    /**
     * Validates a single row of the address book CSV.
     * Checks for required fields, valid formats, and other constraints.
     *
     * @param row The map representing a single row of the CSV.
     * @return An Optional containing an error message if validation fails, or empty if valid.
     */
     Optional<String> validateRow(Map<String, String> row) {
        List<String> errors = new ArrayList<>();
        for (String field : REQUIRED_FIELDS) {
            if (StringUtils.isBlank(row.getOrDefault(field, ""))) {
                errors.add("Missing required field: " + field);
            }
        }

         String contactName = StringUtils.trimToEmpty(row.get(ADDRESS_NAME));
         validateMaxLength(errors, contactName, 100, ADDRESS_NAME);

         String company = StringUtils.trimToEmpty(row.get(COMPANY_NAME));
         validateMaxLength(errors, company, 100, COMPANY_NAME);

         String address1 = StringUtils.trimToEmpty(row.get(ADDRESS_LINE_1));
         validateMaxLength(errors, address1, 35, ADDRESS_LINE_1);

         String address2 = StringUtils.trimToEmpty(row.get(ADDRESS_LINE_2));
         validateMaxLength(errors, address2, 35, ADDRESS_LINE_2);

         String address3 = StringUtils.trimToEmpty(row.get(ADDRESS_LINE_3));
         validateMaxLength(errors, address3, 35, ADDRESS_LINE_3);

         String zip = StringUtils.trimToEmpty(row.get(ZIP));
         if (!zip.matches("\\d{5}(-\\d{4})?")) {
             errors.add("Invalid ZIP code.");
         }

         String city = StringUtils.trimToEmpty(row.get(CITY));
         validateMaxLength(errors, city, 35, CITY);

         String state = StringUtils.trimToEmpty(row.get(STATE));
         if (!state.matches("^[A-Z]{2}$")) {
             errors.add("Invalid state.");
         }

         String country = StringUtils.trimToEmpty(row.get(COUNTRY));
         if (!"US".equalsIgnoreCase(country)) {
             errors.add("Invalid country.");
         }

         String phone = StringUtils.trimToEmpty(row.get(PHONE_NUMBER));
         validatePhoneNumber(errors, phone);

         String extension = StringUtils.trimToEmpty(row.get(ADDRESS_EXTENSION));
         if (extension.length() > 6) {
             errors.add("Extension exceeds 6 digits.");
         }

         String email = StringUtils.trimToEmpty(row.get(EMAIL));
         if (StringUtils.isNotBlank(email)) {
             if (email.length() > 74) {
                 errors.add("Email exceeds 74 characters.");
             } else if (!email.matches("^[\\w.-]+@[\\w.-]+\\.[a-zA-Z]{2,6}$")) {
                 errors.add("Invalid email format.");
             }
         }

         String residentialAddress = StringUtils.trimToEmpty(row.get(IS_RESIDENTIAL));
         if (!isValidResidentialAddress(residentialAddress)) {
             errors.add("Invalid Residential Address: Only TRUE/FALSE/YES/NO/Y/N (case-insensitive) are allowed.");
         }

         String deliveryNotes = StringUtils.trimToEmpty(row.get(DELIVERY_NOTES));
         validateDeliveryNotes(errors, deliveryNotes);

        if(!errors.isEmpty()) {
            return Optional.of(String.join(", ", errors));
        }

        return Optional.empty();
    }

    /**
     * Validates the residential address field input.
     * <p>
     * This method checks whether the input value is either blank (which is considered valid)
     * or matches one of the allowed case-insensitive values: "true", "false", "yes", "no", "y", "n".
     * </p>
     *
     * @param residentialAddress the input string representing the residential address value
     * @return {@code true} if the input is blank or matches an allowed value; {@code false} otherwise
     */
    public static boolean isValidResidentialAddress(String residentialAddress) {
        if (StringUtils.isBlank(residentialAddress)) {
            return true;
        }

        String normalized = residentialAddress.trim().toLowerCase();
        return ALLOWED_RESIDENTIAL_ADDRESS_VALUES.contains(normalized);
    }

    /**
     * Validates the delivery notes field.
     * It checks if the notes are not too long and contain only alphanumeric characters.
     *
     * @param errors The list to collect error messages.
     * @param notes  The delivery notes to validate.
     */
    private void validateDeliveryNotes(List<String> errors, String notes) {
        if (StringUtils.isNotBlank(notes)) {
            if (notes.length() > 140) {
                errors.add("Delivery notes too long (max 140 characters).");
            }
            if (!notes.matches("[a-zA-Z0-9 ]*")) {
                errors.add("Delivery notes must be alphanumeric only (no special characters).");
            }
        }
    }

    /**
     * Validates the phone number format.
     * It checks if the phone number is in a valid format after removing the US country code.
     *
     * @param errors The list to collect error messages.
     * @param phone  The phone number to validate.
     */
    private void validatePhoneNumber(List<String> errors, String phone) {
        if (StringUtils.isNotBlank(phone)) {
            // Remove leading +1 or 1 (country code for US)
            phone = phone.trim();
            if (phone.startsWith("+1")) {
                phone = phone.substring(2);
            } else if (phone.startsWith("1") && phone.length() == 11) {
                phone = phone.substring(1);
            }

            // Now validate remaining 10 digits
            if (!phone.matches("^\\d{10}$")) {
                errors.add("Invalid phone number. Must be 10 digits after removing country code.");
            }
        } else {
            errors.add("Phone number is required.");
        }
    }

    /**
     * Validates that the given string does not exceed the specified maximum length.
     *
     * @param errors    The list to collect error messages.
     * @param value     The string value to validate.
     * @param max       The maximum allowed length for the value.
     * @param fieldName The name of the field being validated, used in the error message.
     */
    private void validateMaxLength(List<String> errors, String value, int max, String fieldName) {
        if (value.length() > max) {
            errors.add(fieldName + " exceeds " + max + " characters.");
        }
    }

    /**
     * Maps a row from the CSV to a ShipToAddressFacilityMapping entity.
     * This method creates a ShipToAddress object and wraps it in a ShipToAddressFacilityMapping.
     *
     * @param row        The map representing a single row of the CSV.
     * @param facilityId The facility ID to which this address belongs.
     * @return A ShipToAddressFacilityMapping entity ready for database storage.
     */
    private ShipToAddressFacilityMapping mapToEntity(Map<String, String> row, String facilityId) {
        ShipToAddress shipToAddress = ShipToAddress.builder()
                .company(row.get(COMPANY_NAME))
                .addressName(row.get(ADDRESS_NAME))
                .addressLine1(row.get(ADDRESS_LINE_1))
                .addressLine2(StringUtils.isNotBlank(row.get(ADDRESS_LINE_2)) ? row.get(ADDRESS_LINE_2) : null)
                .addressLine3(StringUtils.isNotBlank(row.get(ADDRESS_LINE_3)) ? row.get(ADDRESS_LINE_3) : null)
                .zipCode(row.get(ZIP))
                .city(row.get(CITY))
                .state(row.get(STATE))
                .country(row.get(COUNTRY))
                .phoneNumber(row.get(PHONE_NUMBER))
                .extension(row.get(ADDRESS_EXTENSION))
                .email(row.get(EMAIL))
                .deliveryNotes(row.get(DELIVERY_NOTES))
                .addressType(StringUtils.isNotBlank(row.get(IS_RESIDENTIAL))
                                ? AddressBookConstants.ADDRESS_TYPE_RESIDENTIAL
                                : AddressBookConstants.ADDRESS_TYPE_REGULAR)
                .isResidentialAddress(
                        Optional.ofNullable(row.get(IS_RESIDENTIAL))
                                .map(val -> {
                                            String v = val.trim().toLowerCase();
                                            return v.equals("y") || v.equals("yes") || v.equals("true");
                                        })
                                .orElse(false))
                .build();

        return ShipToAddressFacilityMapping.builder()
                .shipToAddress(shipToAddress)
                .monarchShipFromFacilityId(facilityId)
                .build();
    }

    /**
     * Validates if the given UUID string is in a valid format.
     *
     * @param uuid The UUID string to validate.
     * @return true if the UUID is valid, false otherwise.
     */
    public boolean isValidUUID(String uuid) {
        try {
            UUID.fromString(uuid);
            return true;
        } catch (IllegalArgumentException e) {
            return false;
        }
    }

    /**
     * Validates the facility ID.
     * Checks if the facility ID is not null, not empty, and is a valid UUID.
     * Also checks if the facility exists in the customer service.
     *
     * @param facilityId The facility ID to validate.
     */
     void validateFacilityId(String facilityId) {
        if (StringUtils.isBlank(facilityId)) {
            throw new ValidationException("Facility ID cannot be null or empty.");
        }
        if (!isValidUUID(facilityId)) {
            throw new ValidationException("Invalid facilityId format: " + facilityId);
        }
        UserCustomerProfile userCustomerProfile = Optional.ofNullable(customerService.getCustomerByFacilityId(UUID.fromString(facilityId)))
                .orElseThrow(() -> new ResourceNotFoundException("Invalid facilityId: " + facilityId));
        if (userCustomerProfile == null || userCustomerProfile.getFacilities()== null || userCustomerProfile.getFacilities().isEmpty()) {
            throw new ResourceNotFoundException("Facility not found for facilityId: " + facilityId);
        }
    }

    /**
     * Constructs a success message with the number of uploaded and duplicate entries.
     * If isAppend is true, it includes a specific message indicating that the import was successful.
     *
     * @param uploadedCount  The number of new addresses uploaded.
     * @param duplicateCount The number of duplicate rows skipped.
     * @param isAppend       Whether the import was an append operation.
     * @return A map containing the status and message of the operation.
