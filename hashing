    private ManifestRequestDto prepareManifestRequest(ManifestRequest request, String dhlProfileCode, OffsetDateTime startDateTime) {
        log.atInfo().setMessage("preparing request payload for SendFlex manifest API").log();
        DateRange dateRange = DateRange.builder()
                .start(startDateTime != null ? String.valueOf(startDateTime) : null)
                .end(LocalDateTime.now().truncatedTo(ChronoUnit.MILLIS).atOffset(ZoneOffset.UTC).toString())
                .build();

        Filter filter = Filter.builder()
                .profileCode(dhlProfileCode)
                .carrier(request.getCarrier())
                .serviceGroups(List.of(ALL))
                .dateRange(dateRange)
                .build();

        return ManifestRequestDto.builder()
                .filter(filter)
                .build();
    }

    private void validateRequest(UUID facilityId, UUID customerId) {
        if (Objects.isNull(facilityId) || Objects.isNull(customerId)) {
            log.atError().setMessage("Facility ID or Customer ID is null or empty").log();
            throw new ValidationException("Facility ID or Customer ID cannot be null or empty");
        }
    }

    private List<Manifest> fetchManifests(String facilityId, String customerId) {
        log.atInfo().setMessage("Fetching manifests from repository").log();

        try {
            LocalDateTime endTime = LocalDateTime.now();
            LocalDateTime startTime = endTime.minusHours(24);

            return manifestRepository.fetchManifests(facilityId, customerId, startTime, endTime);
        } catch (Exception ex) {
            log.atError().setMessage("Error fetching manifests from repository").setCause(ex).log();
            throw new ResourceNotFoundException(ex.getMessage());
        }
    }

    private ManifestStatusResponse callTrackingService(List<Manifest> manifestList, String facilityId, String customerId) {
        log.atInfo().setMessage("Preparing tracking request for non-scanned manifests").log();

        LocalDateTime lastManifestDate = manifestList.stream()
                .map(Manifest::getManifestDate)
                .max(LocalDateTime::compareTo)
                .orElse(LocalDateTime.now().minusHours(24));

        List<Manifest> nonScannedManifests = manifestList.stream()
                .filter(manifest -> !SCANNED.equalsIgnoreCase(manifest.getStatus()))
                .toList();

        ManifestStatusRequest trackingRequest = ManifestStatusRequest.builder()
                .facilityId(facilityId)
                .customerId(customerId)
                .lastManifestDate(lastManifestDate.toString())
                .manifestRequests(
                        nonScannedManifests.stream().map(
                                manifest -> com.cardinalhealth.adv.shipping.integration.api.service.dto.manifest.tracking.ManifestRequest.builder()
                                        .manifestId(manifest.getManifestId())
                                        .startTime(manifest.getStartTime().toString())
                                        .endTime(manifest.getEndTime().toString())
                                        .packageCount(Long.valueOf(manifest.getNumberOfPackages()))
                                        .build()
                        ).collect(Collectors.toList())
                )
                .build();

        // call tracking service to get status
        Mono<ManifestStatusResponse> responseMono = trackingResourceWebClientService
                .getManifestStatusFromTracking(trackingRequest);

        return responseMono.block();
    }

    private ManifestHistoryResponse mapToResponseDto(List<Manifest> manifestList,
                                                     Long totalShipmentSinceLastManifest,
                                                     UUID facilityId,
                                                     UUID customerId) {
        List<ManifestHistory> manifestHistories = manifestList.stream()
