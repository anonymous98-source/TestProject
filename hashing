    @Test
    void resolve_returnsOnlyRule_whenSingleElement() {
        RuleDefinition rule = mockRule("42");
        List<RuleDefinition> rules = Collections.singletonList(rule);

        RuleDefinition result = resolver.resolve(rules);

        assertSame(rule, result);
