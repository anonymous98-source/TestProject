            ServiceInvoker<Object, MultiPackageShipmentBookResponse> invoker =
                    (ServiceInvoker<Object, MultiPackageShipmentBookResponse>) invocation.getArgument(1);
            // This may throw IOException, which is fine for test coverage of the exception path
            return invoker.invoke(reqArg);
        }).when(serviceDecorator).decorate(
                any(), // request (generic T)
                any(ServiceInvoker.class), // serviceMethod
                any(OflUserPrincipal.class) // principal
        );
    }

