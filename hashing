import org.springframework.web.reactive.function.client.WebClientResponseException;
import reactor.util.retry.Retry;

import java.time.Duration;

/**
 * Thin wrapper over Google Places Autocomplete v1 API.
 * This service expects a raw JSON body string that will be passed directly to
 * https://places.googleapis.com/v1/places:autocomplete and return the raw JSON response.
 */

@Slf4j
@Component
@RequiredArgsConstructor
public class GooglePlacesWebClientService {

    private final WebClient.Builder webClientBuilder;

    /**
     * Call Google Places Autocomplete with the given JSON request body.
     *
     * @param requestBodyJson JSON string containing at minimum the `input` field.
     * @return raw JSON response as String
     */
    public String autocomplete(String requestBodyJson, String uiApiKey) {
        String apiKey = (uiApiKey != null && !uiApiKey.isBlank()) ? uiApiKey : "";
        if (apiKey.isBlank()) {
            log.error("X-Goog-Api-Key header is missing or blank");
        }
        WebClient webClient =
                webClientBuilder
                        .clone()
                        .baseUrl("https://places.googleapis.com")
                        .defaultHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                        .build();
        try {
            return webClient
                    .post()
                    .uri("/v1/places:autocomplete")
                    .header("X-Goog-Api-Key", apiKey)
//                    .header("X-Goog-FieldMask", "suggestions.placePrediction.text.text,suggestions.queryPrediction.text.text")
                    .bodyValue(requestBodyJson)
                    .retrieve()
                    .bodyToMono(String.class)
                    .retryWhen(
                            Retry.backoff(3, Duration.ofMillis(200))
                                    .filter(throwable ->
                                            throwable instanceof WebClientResponseException
                                                    && ((WebClientResponseException) throwable)
                                                    .getStatusCode()
                                                    .is5xxServerError()))
                    .block();
        } catch (WebClientResponseException ex) {
            log.error("Google Places API returned error: status={} body={}",
                    ex.getStatusCode(), ex.getResponseBodyAsString(), ex);
            throw ex;
        } catch (Exception ex) {
            log.error("Error calling Google Places Autocomplete", ex);
            throw ex;
        }
    }


}

