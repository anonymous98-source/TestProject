public class LabelAndPriceBreakDownCommonUtils {
    private LabelAndPriceBreakDownCommonUtils() {}
    public static boolean isReturnTypeForFedex(
            ShipmentBookRequest shipmentBookRequest, String returnType) {
        return !StringUtils.isBlank(shipmentBookRequest.getGenerateLabelReturnType())
                && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(returnType)
                && FEDEX.equalsIgnoreCase(shipmentBookRequest.getShippingProfile());
    }
    public static void prepareRequestForReturn(
            ShipmentBookRequest shipmentBookRequest, ShipmentBookResponseDto shipmentBookResponseDto) {
        Address shipFromAddress = mapShipToToShipFrom(shipmentBookRequest);
        ShipToAddressDetails shipToAddress = mapShipFromToShipTo(shipmentBookRequest);
        shipmentBookRequest.getShipFromAddress().getAddressData().setAddress(shipFromAddress);
        shipmentBookRequest.getShipToAddress().getAddressData().setAddress(shipToAddress);
        if (Objects.nonNull(shipmentBookResponseDto) && shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(FORWARD)) {
            shipmentBookRequest
                    .getBillingInformation()
                    .setOriginalShipmentTrackingNumber(
                            shipmentBookResponseDto
                                    .getShippingUnits()
                                    .get(0)
                                    .getTrackingNumber()
                                    .get(0)
                                    .getValue());
            if (!StringUtils.isBlank(shipmentBookRequest.getShipViaReturnCode())) {
                shipmentBookRequest
                        .getShipViaOptions()
                        .get(0)
                        .setCode(shipmentBookRequest.getShipViaReturnCode());
            }
        }
    }
    public static Address mapShipToToShipFrom(ShipmentBookRequest shipmentBookRequest) {
        ShipToAddressDetails shipToAddressData =
                shipmentBookRequest.getShipToAddress().getAddressData().getAddress();
        return Address.builder()
                .type(shipToAddressData.getType())
                .name(shipToAddressData.getName())
                .company(shipToAddressData.getCompany())
                .addressLines(shipToAddressData.getAddressLines())
                .zipCode(shipToAddressData.getZipCode())
                .city(shipToAddressData.getCity())
                .state(shipToAddressData.getState())
                .country(shipToAddressData.getCountry())
                .emailAddress(
                        Objects.nonNull(shipToAddressData.getEmailAddress())
                                ? shipToAddressData.getEmailAddress()
                                : shipmentBookRequest
                                .getShipFromAddress()
                                .getAddressData()
                                .getAddress()
                                .getEmailAddress())
                .phoneNumber(shipToAddressData.getPhoneNumber())
                .phoneExt(shipToAddressData.getPhoneExt())
                .build();
    }
    public static ShipToAddressDetails mapShipFromToShipTo(ShipmentBookRequest shipmentBookRequest) {
        Address shipFromAddressData =
                shipmentBookRequest.getShipFromAddress().getAddressData().getAddress();
        return ShipToAddressDetails.builder()
                .type(shipFromAddressData.getType())
                .name(shipFromAddressData.getName())
                .company(shipFromAddressData.getCompany())
                .addressLines(shipFromAddressData.getAddressLines())
                .zipCode(shipFromAddressData.getZipCode())
                .city(shipFromAddressData.getCity())
                .state(shipFromAddressData.getState())
                .country(shipFromAddressData.getCountry())
                .emailAddress(
                        Objects.nonNull(
                                shipmentBookRequest
                                        .getShipToAddress()
                                        .getAddressData()
                                        .getAddress()
                                        .getEmailAddress())
                                ? shipFromAddressData.getEmailAddress() : null)
                .phoneNumber(shipFromAddressData.getPhoneNumber())
                .phoneExt(shipFromAddressData.getPhoneExt())
                .residential(false)
                .build();
    }
