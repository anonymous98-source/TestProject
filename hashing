  private PackageAdditionalDetails buildAdditionalServicePackage(
      PackagingDetails packagingDetails, ShipmentBookRequest shipmentBookRequest, boolean isCms) {

    Packaging packaging =
        Objects.nonNull(packagingDetails.getPackaging())
            ? packagingDetails.getPackaging()
            : Packaging.builder().build();

    Accessorials accessorials =
        Objects.nonNull(packagingDetails.getAccessorials())
            ? packagingDetails.getAccessorials()
            : Accessorials.builder().build();

    PackageAdditionalDetails.PackageAdditionalDetailsBuilder packageBuilder =
        PackageAdditionalDetails.builder();
    packageBuilder.isColdChain(accessorials.isColdChain());

    if (!isCms) {
      packageBuilder
          .declaredValue(accessorials.isDeclaredValue())
          .valueOfContent(getValueOfContentIfDeclaredValueTrue(packagingDetails))
          .isShipmentProtection(packaging.getIsIndividualShipmentProtection())
          .shipmentProtectionAmount(getCoverageAmount(packaging))
          .lithiumBattery(getLithiumBattery(packagingDetails))
          .additionalInsurance(
              (USPS.equalsIgnoreCase(shipmentBookRequest.getShippingProfile())
                      && Boolean.TRUE.equals(
                          packagingDetails.getAccessorials().getAddOnInsurance()))
                  ? packagingDetails.getAccessorials().getAddOnInsuranceValue()
                  : null);
    }

    // Package Accessorial Level
    packageBuilder.packageTags(packaging.getPackageTags());

    List<String> hcidCodes = new ArrayList<>();
    List<String> hcidTempCodes = new ArrayList<>();
    Optional.ofNullable(packaging.getHcidCode()).orElse(Collections.emptyList()).stream()
        .filter(Objects::nonNull)
        .forEach(
            hcid -> {
              hcidCodes.add(hcidFormatting(hcid.getCode(), hcid.getName()));
              hcidTempCodes.add(hcidFormatting(hcid.getTempCode(), hcid.getTempName()));
            });
    packageBuilder.hcidCodes(checkFormattedValues(hcidCodes));
    packageBuilder.hcidTemperatureCode(checkFormattedValues(hcidTempCodes));

    return packageBuilder.build();
  }

  private List<String> checkFormattedValues(List<String> formattedHcid) {
    return Optional.ofNullable(formattedHcid)
        .map(hcid -> hcid.stream().filter(s -> Objects.nonNull(s) && !s.equals(COLON)).toList())
        .filter(hcid -> !hcid.isEmpty())
        .orElse(null);
  }

  public List<String> getLithiumBattery(PackagingDetails packagingDetails) {
    List<String> lithiumBatteryAttributes = new ArrayList<>();
    if (Objects.nonNull(packagingDetails.getAccessorials())
        && packagingDetails.getAccessorials().isLithiumBattery()) {
      if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getMetalContainedInEquipment())) {
        lithiumBatteryAttributes.add(LITHIUM_METAL_CONTAINED_IN_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getIonPackedWithEquipment())) {
        lithiumBatteryAttributes.add(LITHIUM_ION_PACKED_WITH_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getIonContainedInEquipment())) {
        lithiumBatteryAttributes.add(LITHIUM_ION_CONTAINED_IN_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(packagingDetails.getAccessorials().getMetalPackedWithEquipment())) {
        lithiumBatteryAttributes.add(LITHIUM_METAL_PACKED_WITH_EQUIPMENT);
      }
    }
    return lithiumBatteryAttributes;
  }

