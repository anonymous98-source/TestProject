public class ShippingRuleCommonUtils {

    private ShippingRuleCommonUtils() {
        // Private constructor to prevent instantiation
    }

    /**
     * Builds a SpEL expression string for the given value and operation.
     * Example: if operation is "<" and value is 50, returns "#value < 50"
     */
    public static String buildValueExpression(String operation, Integer value) {
        validateOperator(operation);
        String literal = JAVA_BIG_DECIMAL + value.toString() + CLOSE_PARENTHESIS;
        return switch (operation) {
            case OPERATOR_EQUAL -> VALUE_SPEL_PREFIX + literal + ") == 0";
            case OPERATOR_GREATER -> VALUE_SPEL_PREFIX + literal + ") > 0";
            case OPERATOR_GREATER_EQUAL -> VALUE_SPEL_PREFIX + literal + ") >= 0";
            case OPERATOR_LESS -> VALUE_SPEL_PREFIX + literal + ") < 0";
            case OPERATOR_LESS_EQUAL -> VALUE_SPEL_PREFIX + literal + ") <= 0";
            default -> throw new ValidationException("Invalid operator: " + operation);
        };
    }

    public static void validateOperator(String operation) {
        if (!OPERATOR_LIST.contains(operation)) {
            throw new ValidationException(INVALID_OPERATOR + ": " + operation);
        }
    }

    public static String buildWeightExpression(String operation, java.math.BigDecimal weight) {
        validateOperator(operation);
        String literal = "new java.math.BigDecimal('" + weight.toPlainString() + "')";
        return switch (operation) {
            case "=" -> "weight.compareTo(" + literal + ") == 0";
            case ">" -> "weight.compareTo(" + literal + ") > 0";
            case ">=" -> "weight.compareTo(" + literal + ") >= 0";
            case "<" -> "weight.compareTo(" + literal + ") < 0";
            case "<=" -> "weight.compareTo(" + literal + ") <= 0";
            default ->
                    throw new com.cardinalhealth.adv.shipping.integration.api.exception.ValidationException("Invalid operator: " + operation);
        };
    }

    public static void validateRequestPayload(String facilityId, String customerId, String shippingProfileId) {
        if (Objects.nonNull(facilityId)) validateUUID(facilityId, "Facility Id");
        if (Objects.nonNull(customerId)) validateUUID(customerId, "Customer Id");
        if (Objects.nonNull(shippingProfileId)) validateUUID(shippingProfileId, "Shipping Profile Id");
    }

    public static void validateCarrier(String carrier) {
        List<String> validCarriers = List.of(
                FE_FEDEX_KEY,
                FE_USPS_KEY,
                FE_DHL_KEY,
                FE_SAME_DAY_KEY,
                FE_NEXT_DAY_KEY,
                FE_ON_DEMAND_KEY
        );
        boolean isValid = carrier != null && !carrier.isBlank() &&
                (validCarriers.contains(carrier) || validCarriers.stream().anyMatch(c -> c.equalsIgnoreCase(carrier)));

        if (!isValid) {
            throw new ValidationException("Carrier must be one of: " + validCarriers);
        }
    }

    /**
     * helper methods
     */
    public static void validateUUID(String uuid, String fieldName) {
        if (CommonUtil.isInvalidUUID(uuid)) {
            throw new ValidationException("Invalid " + fieldName + ".");
        }
    }

    public static void validateZipcode(String zipcode) {
        if (zipcode == null || !zipcode.matches(ZIPCODE_REGEX)) {
            throw new ValidationException("Zip-Code must be in format XXXXX or XXXXX-XXXX");
        }
    }
