     *
     * @param shipmentResourceDto Shipment entity for which data needs to be published in shipping nophi topic
     */
    @Async
    public void transformAndPublishNoPHIData(ShipmentResourceDto shipmentResourceDto) {
        if (shipmentResourceDto == null) {
            log.atWarn().setMessage("Provided shipment entity is null for publishing in Nophi Shipping topic").log();
            return;
        }

        // Extract All the required entity attached to Shipment Entity
        AdditionalServiceShipmentResourceDto additionalServiceShipment =
                shipmentResourceDto.getAdditionalServiceShipment();
        List<PriceQuoteResourceDto> priceQuotes = shipmentResourceDto.getPriceQuote();
        List<PackageResourceDto> packages = shipmentResourceDto.getPackages();

        if (additionalServiceShipment == null || packages == null || packages.isEmpty()) {
            log.atWarn().setMessage("Either attached additional service shipment packages or "
                    + "user entity is null or empty, not processing NoPHI data publish").log();
            return;
        }

       log.atInfo().setMessage("Starting mapping and processing to publish No-PHI data "
                        + "for shipment transaction id: " + shipmentResourceDto.getShipmentTransactionId())
                .log();

        ShipBookNoPhiDetailsDTO noPhiShipmentDataToPublish =
                constructNoPhiShipmentDataToPublish(shipmentResourceDto, packages,
                        priceQuotes, additionalServiceShipment);

        // Check if Email notification is associated with any packages
        Boolean isEmailNotificationEnable =
                packages.stream()
                        .map(PackageResourceDto::getTracking)
                        .filter(tracking -> tracking != null && tracking.getNotifications() != null
                                && !tracking.getNotifications().isEmpty())
                        .flatMap(e -> e.getNotifications().stream())
                        .anyMatch(notification -> notification != null
                                && EMAIL.equalsIgnoreCase(
                                notification.getNotificationCommunicationChannel()));

        // Update email notification based on if table has some data in notification
       log.atInfo().setMessage("For No-PHI shipping data publish Setting emailNotifications flag as "
                + isEmailNotificationEnable).log();
        noPhiShipmentDataToPublish.setEmailNotifications(isEmailNotificationEnable);

        Boolean publishStatus = shipmentBookNoPhiDataPublisher.publishNoPhiData(
                PubSubCommonConstants.NO_PHI_SHIPPING_TOPIC_KEY, noPhiShipmentDataToPublish);

        log.atInfo()
                .setMessage("No-PHI data publishing completed for shipment transaction id: {} and captured publishing status against tracking number is {}")
                .addArgument(shipmentResourceDto.getShipmentTransactionId())
                .addArgument(publishStatus)
                .addKeyValue("shipmentTransactionId", shipmentResourceDto.getShipmentTransactionId())
                .addKeyValue("publishStatus", publishStatus)
                .log();
    }


