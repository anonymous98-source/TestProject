@Slf4j
public class ShipmentProtectionMapperUtil {

    private ShipmentProtectionMapperUtil() {
        throw new IllegalStateException("Utility class");
    }

    /**
     * This method determines insurance is required and the insurance amount
     * and return Carried add on to be sent in SendFlex request for Shipment Book API
     *
     * @param shippingProfile     Carrier
     * @param isUserEnrolledInOSP Do user have access to OSP protection
     * @param accessorials        Accessorials DTO from Request body of Shipment Book API
     * @return Insurance added in singleton List of Carrier Add ons
     */
    public static List<CarrierAddOnKeyValue> getInsuranceForShipBook(
            String shippingProfile, Boolean isUserEnrolledInOSP,
            com.cardinalhealth.adv.shipping.integration.api.model.shipbook.Accessorials accessorials) {

        ShipmentProtectionDetailsDTO protectionDetailsDTO = getInsurance(
                shippingProfile, isUserEnrolledInOSP != null && isUserEnrolledInOSP,
                accessorials.isDeclaredValue(),
                accessorials.getValueOfContent(),
                accessorials.getAddOnInsurance() != null && accessorials.getAddOnInsurance(),
                accessorials.getAddOnInsuranceValue()
        );

        if (protectionDetailsDTO.isInsuranceEnrolled()) {
            log.atInfo()
                    .setMessage("Shipment protection type is {}")
                    .addArgument(protectionDetailsDTO.getInsuranceType())
                    .log();
            return List.of(
                    CarrierAddOnKeyValue
                            .builder()
                            .key(INSURANCE_VALUE)
                            .value(String.valueOf(String.valueOf(protectionDetailsDTO.getShipmentProtectionAmount())))
                            .build());
        } else {
            log.atInfo().setMessage("Shipment protection is not required").log();
            return List.of();
        }
    }

    /**
     * This method determines insurance is required and the insurance amount
     * and return Carried add on to be sent in SendFlex request for Shipment Plan API
     *
     * @param shippingProfile     Carrier
     * @param isUserEnrolledInOSP Do user have access to OSP protection
     * @param accessorials        Accessorials DTO from Request body of Shipment Plan API
     * @return Insurance added in singleton List of Carrier Add ons
     */
    public static List<CarrierAddOnsDTO> getInsuranceForShipPlan(
            String shippingProfile, Boolean isUserEnrolledInOSP,
            com.cardinalhealth.adv.shipping.integration.api.model.shipplan.request.Accessorials accessorials) {

        ShipmentProtectionDetailsDTO protectionDetailsDTO = getInsurance(
                shippingProfile, isUserEnrolledInOSP != null && isUserEnrolledInOSP,
                accessorials.isDeclaredValue(),
                accessorials.getValueOfContent(),
                accessorials.getAddOnInsurance() != null && accessorials.getAddOnInsurance(),
                accessorials.getAddOnInsuranceValue()
        );

        if (protectionDetailsDTO.isInsuranceEnrolled()) {
            log.atInfo()
                    .setMessage("Shipment protection type is {}")
                    .addArgument(protectionDetailsDTO.getInsuranceType())
                    .addKeyValue("insuranceType", protectionDetailsDTO.getInsuranceType())
                    .log();
            return List.of(
                    CarrierAddOnsDTO
                            .builder()
                            .key(INSURANCE_VALUE)
                            .value(String.valueOf(protectionDetailsDTO.getShipmentProtectionAmount()))
                            .build());
        } else {
            log.atInfo().setMessage("Shipment protection is not required").log();
            return List.of();
        }
    }

    /**
     * Determine whether to enroll for Insurance in SendFlex and the Insurance amount
     *
     * @param valueOfContent      Declared value - FedEx
     * @param shippingProfile     Carrier details
     * @param isEnrolledInOSP     Does user has access to OSP
     * @param hasAddOnInsurance   User opted for Insurance for USPS
     * @param addOnInsuranceValue Insurance amount for USPS
     * @param isDeclaredValue     User opted for Declared insurance value - FedEx
     * @return Constructed CarrierAddOn DTO
     */
    private static ShipmentProtectionDetailsDTO getInsurance(
            String shippingProfile, boolean isEnrolledInOSP, boolean isDeclaredValue,
            Double valueOfContent, boolean hasAddOnInsurance, Double addOnInsuranceValue) {

        var minValue = 100.00;
        var maxValue = FEDEX.equalsIgnoreCase(shippingProfile) ? 50000.00 : 5000.00;

        // If profile is FedEx and not eligible for OSP and Declared value flag is true
        // then we need to send Declared value as shipment protection
        // If user is eligible for OSP then will not send anything
        var isInsuranceRequiredSendFlex = false;
        Double insuranceValue = null;
        String insuranceType = ServiceCommonConstants.INSURANCE_NOT_REQUIRED;

        if (isEnrolledInOSP && FEDEX.equalsIgnoreCase(shippingProfile)) {
            log.atInfo().setMessage("Insurance required to be enrolled in OSP").log();
            insuranceType = ServiceCommonConstants.INSURANCE_TYPE_OSP;
        } else if (FEDEX.equalsIgnoreCase(shippingProfile) && isDeclaredValue && valueOfContent != null) {
            log.atInfo().setMessage("Insurance type is going to be declared value for FedEx").log();
            insuranceType = ServiceCommonConstants.INSURANCE_TYPE_DECLARED_VALUE;
            isInsuranceRequiredSendFlex = true;
            insuranceValue = valueOfContent;
        } else if ((USPS.equalsIgnoreCase(shippingProfile))
                && hasAddOnInsurance && addOnInsuranceValue != null) {
            log.atInfo().setMessage("Insurance required for USPS as Additional Insurance").log();
            insuranceType = ServiceCommonConstants.INSURANCE_TYPE_ADDITIONAL_AMOUNT;
            isInsuranceRequiredSendFlex = true;
            insuranceValue = addOnInsuranceValue;
        } else {
            log.atInfo().setMessage("No condition satisfied, no insurance required").log();
        }

        if (isInsuranceRequiredSendFlex && (insuranceValue < minValue || insuranceValue > maxValue)) {
            throw new ValidationException("When insurance is required, insurance amount should be"
                    + " greater than $" + minValue + " and less than $" + maxValue);
        }

        return ShipmentProtectionDetailsDTO
                .builder()
                .insuranceType(insuranceType)
                .isInsuranceEnrolled(isInsuranceRequiredSendFlex)
                .shipmentProtectionAmount(insuranceValue)
                .build();
    }

    /**
     * Convert carrier add on type from Ship book to Ship plan for price quote requirement
     *
     * @param carrierAddOnsShipBook Ship book carrier add-ons
     * @return Ship plan carrier add-ons
     */
    public static List<CarrierAddOnsDTO> convertCarrierAddOnType(List<CarrierAddOnKeyValue> carrierAddOnsShipBook) {
        return carrierAddOnsShipBook.stream()
                .map(addOn -> CarrierAddOnsDTO.builder()
                        .key(addOn.getKey())
                        .value(addOn.getValue())
                        .build())
                .toList();
    }
}

