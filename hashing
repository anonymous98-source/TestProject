@Component
public class WeightRuleContextExtractor implements RuleContextExtractor<WeightRuleContext> {
    @Override
    public RuleType supports() {
        return RuleType.WEIGHT;
    }

    @Override
    public WeightRuleContext extract(Map<String, Object> rawContext) {

        if (rawContext.get(WEIGHT_VALUE) == null) {
            throw new ValidationException("weight is required");
        }

        BigDecimal weight = new BigDecimal(rawContext.get(WEIGHT_VALUE).toString());
        validateWeightValue(weight);

        return new WeightRuleContext(weight);
    }

    private void validateWeightValue(BigDecimal weight) {
        if (weight.compareTo(BigDecimal.ZERO) <= 0
                || weight.compareTo(new BigDecimal("150")) > 0
                || weight.scale() > 2) {
            throw new ValidationException("weight must be positive value upto 150 with max 2 decimal places");
        }

    }
}

