package com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.handler;

import com.cardinalhealth.adv.shipping.integration.api.database.entity.RuleDefinition;
import com.cardinalhealth.adv.shipping.integration.api.database.repository.RuleDefinitionRepository;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.RuleType;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.context.RuleContextExtractorRegistry;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.context.shipmentvalue.ShipmentValueContext;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.controller.model.RuleEvaluationRequestDto;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.controller.model.RuleEvaluationResult;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.facade.RuleEvaluator;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.resolver.ConflictResolver;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.resolver.ShipmentValueConflictResolver;
import com.fasterxml.jackson.databind.JsonNode;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.*;
import java.util.stream.Collectors;
import java.util.stream.Stream;

import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.RuleType.SHIPMENT_VALUE;

@Component
@Slf4j
public class ShipmentValueRuleStrategy implements RuleTypeStrategy {
    private final RuleDefinitionRepository ruleDefinitionRepository;
    private final RuleEvaluator evaluator;
    private final ConflictResolver resolver;
    private final RuleContextExtractorRegistry contextExtractorRegistry;

    public ShipmentValueRuleStrategy(
            RuleDefinitionRepository ruleDefinitionRepository,
            RuleEvaluator evaluator,
            ShipmentValueConflictResolver resolver,
            RuleContextExtractorRegistry contextExtractorRegistry) {
        this.ruleDefinitionRepository = ruleDefinitionRepository;
        this.evaluator = evaluator;
        this.resolver = resolver;
        this.contextExtractorRegistry = contextExtractorRegistry;
    }

    @Override
    public RuleType supports() {
        return SHIPMENT_VALUE;
    }

    @Override
    public RuleEvaluationResult evaluate(RuleEvaluationRequestDto request) {
        ShipmentValueContext context =
                contextExtractorRegistry.extract(SHIPMENT_VALUE, request.getContext());
        List<RuleDefinition> candidates =
                ruleDefinitionRepository.findAllByFacilityIdAndRuleTypeAndCarrierAndActiveTrue(
                        request.getFacilityId(), SHIPMENT_VALUE.toString(), request.getCarrier());

        if (candidates == null || candidates.isEmpty()) {
            return RuleEvaluationResult.builder().ruleType(SHIPMENT_VALUE).build();
        }


        // Assuming accessorial field is JSON object and contains exactly one field
        // if accessorial node value is null, rule is excluded from grouping
        Map<String, List<RuleDefinition>> groupedByAccessorial = candidates.stream()
                .flatMap(rule -> {
                    String key = extractAccessorialKey(rule);
                    return key == null ?
                            Stream.empty() :
                            Stream.of(new AbstractMap.SimpleEntry<>(key, rule));
                })
                .collect(Collectors.groupingBy(Map.Entry::getKey,
                        Collectors.mapping(Map.Entry::getValue, Collectors.toList())));


        groupedByAccessorial.forEach((key, value) ->
            log.info("rules fetched from db for SHIPMENT_VALUE key :  {} and value : {} ", key, value)
        );
        Map<String, RuleDefinition> winners = new HashMap<>();

        for (Map.Entry<String, List<RuleDefinition>> entry : groupedByAccessorial.entrySet()) {
           String accessorialKey = entry.getKey();
           List<RuleDefinition> rulesForKey = entry.getValue();

            RuleDefinition firstMatch = rulesForKey.stream().filter(
                    rule -> evaluator.evaluate(rule, context)).findFirst().orElse(null);
            if (firstMatch == null) {
                continue;
            }
            List<RuleDefinition> ties = rulesForKey.stream().filter(
                    r -> r.getValue().equals(firstMatch.getValue())).toList();

            List<RuleDefinition> trueMatchFromTies =
                    ties.stream().filter(r -> evaluator.evaluate(r, context)).toList();

            RuleDefinition winner = resolver.resolve(trueMatchFromTies);
            if (winner != null) {
                winners.put(accessorialKey, winner);
            }
        }
        if (winners.isEmpty()) {
            return RuleEvaluationResult.builder().ruleType(SHIPMENT_VALUE).build();
        }

        return RuleEvaluationResult.builder()
                .ruleType(SHIPMENT_VALUE)
                .primary(null) // no single winner, SHIPMENT_VALUE is multi winner
                .accessorials(winners)
                .build();
    }

    // apply logic to extract key here
    private String extractAccessorialKey(RuleDefinition rule) {
        if (rule.getAccessorial() != null) {
            JsonNode accessorialNode = rule.getAccessorial();
            Iterator<Map.Entry<String, JsonNode>> iterator = accessorialNode.fields();
            if (!iterator.hasNext()) {
                return null;
            }
            Map.Entry<String, JsonNode> first = iterator.next();
            String fieldName = first.getKey();
            JsonNode value = first.getValue();
            boolean enabled = value != null && !value.isNull() && value.isBoolean();


            return enabled ? fieldName : null;
        }
        return null;
    }
}

