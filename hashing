package com.cardinalhealth.adv.shipping.integration.api.service.impl;

import com.cardinalhealth.adv.shipping.integration.api.config.async.CustomAsyncConfigProvider;
import com.cardinalhealth.adv.shipping.integration.api.redis.dto.LegalDocumentContentCacheDto;
import com.cardinalhealth.adv.shipping.integration.api.redis.service.RedisRegionService;
import com.cardinalhealth.adv.shipping.integration.api.service.base.GCSService;
import com.google.cloud.storage.Storage;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.Base64;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;
import java.util.stream.Collectors;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.UNDERSCORE_DELIMITER;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.LEGAL_DOCUMENT_CONTENT_REGION;

@Service
@Slf4j
@RequiredArgsConstructor
public class GCSServiceImpl implements GCSService {

    private final Storage storage;
    private final RedisRegionService redisRegionService;
    private final CustomAsyncConfigProvider customExecutor;

    @Override
    public String getEncodedFileContents(String fileName, String bucketName) {
        return Base64.getEncoder().encodeToString(storage.readAllBytes(bucketName, fileName));
    }

    @Override
    public String getEncodedLegalDocFileContents(String fileName, String bucketName) {
        var key = bucketName + UNDERSCORE_DELIMITER + fileName;
        var cachedContent = redisRegionService.get(LEGAL_DOCUMENT_CONTENT_REGION, key, LegalDocumentContentCacheDto.class);
        if (cachedContent.isPresent()) {
            log.atInfo().setMessage("Cache hit")
                            .addKeyValue("region", LEGAL_DOCUMENT_CONTENT_REGION)
                            .addKeyValue("key", key)
                    .log();
            return cachedContent.get().getEncodedDocumentContent();
        }

        log.atInfo().setMessage("Legal document content not found in cache, fetching from GCS").log();
        var encodedContent = getEncodedFileContents(fileName, bucketName);
        redisRegionService.put(LEGAL_DOCUMENT_CONTENT_REGION, key, new LegalDocumentContentCacheDto(key, encodedContent));
        return encodedContent;
    }

    @Override
    public Map<String, String> getEncodedLegalDocFileContentsBulk(List<String> filePaths, String bucketName) {
        // Fetch all cached legal docs in one round trip
        Map<String, String> cached = redisRegionService
                .findAll(LEGAL_DOCUMENT_CONTENT_REGION, LegalDocumentContentCacheDto.class)
                .stream()
                .collect(Collectors.toMap(
                        dto -> dto.getDocumentPath().substring((bucketName + UNDERSCORE_DELIMITER).length()),
                        LegalDocumentContentCacheDto::getEncodedDocumentContent
                ));

        List<String> missedFilePaths = filePaths.stream()
                .filter(fp -> !cached.containsKey(fp))
                .collect(Collectors.toList());
        //using this Collectors.toList because sonarqube does not understand java 16+ :(
        log.atInfo()
                .setMessage("Bulk legal doc cache lookup")
                .addKeyValue("requested", String.valueOf(filePaths.size()))
                .addKeyValue("hits", String.valueOf(filePaths.size() - missedFilePaths.size()))
                .addKeyValue("misses", String.valueOf(missedFilePaths.size()))
                .log();

        // Fetch misses from GCS in parallel
        Map<String, String> gcsResults = new HashMap<>();
        if (!missedFilePaths.isEmpty()) {
            List<CompletableFuture<Map.Entry<String, String>>> gcsFutures = missedFilePaths.stream()
                    .map(fp -> CompletableFuture.supplyAsync(() -> {
                        log.atInfo()
                                .setMessage("Fetching legal document from GCS")
                                .addKeyValue("filePath", fp)
                                .log();
                        try {
                            String encoded = getEncodedFileContents(fp, bucketName);
                            String redisKey = bucketName + UNDERSCORE_DELIMITER + fp;
                            redisRegionService.put(LEGAL_DOCUMENT_CONTENT_REGION, redisKey,
                                    new LegalDocumentContentCacheDto(redisKey, encoded));
                            return Map.entry(fp, encoded);
                        } catch (Exception e) {
                            log.atError()
                                    .setMessage("Failed to fetch legal document from GCS")
                                    .addKeyValue("filePath", fp)
                                    .setCause(e)
                                    .log();
                            throw e;
                        }
                    }, customExecutor.getChildExecutor()))
                    .toList();

            CompletableFuture.allOf(gcsFutures.toArray(new CompletableFuture[0])).join();
            gcsFutures.stream()
                    .map(CompletableFuture::join)
                    .forEach(e -> gcsResults.put(e.getKey(), e.getValue()));
        }

        Map<String, String> result = new HashMap<>(cached);
        result.putAll(gcsResults);
        return result;
    }
}

