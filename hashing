  @Override
  public List<UserDefaultsResponse> getDefaultValues(
      OflUserPrincipal oflUserPrincipal, String facilityId)
      throws ResourceNotFoundException, ValidationException {

    // creating threads to perform parallel operation
    final ExecutorService baseExecutor = Executors.newFixedThreadPool(3);
    ExecutorService executor = new DelegatingSecurityContextExecutorService(baseExecutor);

    Boolean firstTime = Boolean.FALSE;
    OflUser user =
        oflUserPrincipal != null && oflUserPrincipal.getId() != null
            ? Optional.ofNullable(
                    userService.getUser(UserPrincipalUtils.getEmail(oflUserPrincipal)))
