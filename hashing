import com.cardinalhealth.adv.shipping.integration.api.service.webclient.ocm.OCMWebClientService;
import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.UUID;

@Slf4j
@Service
@AllArgsConstructor
public class ShipDateServiceImpl implements ShipDateService {


  private final OCMWebClientService ocmWebClientService;

  @Override
  public ShipDateResponse fetchShipDates(ShipDateRequest request) {

    // Check Data and Prepare Request
    prepareShipDateRequest(request);

    // Call OCM
    log.atInfo().setMessage("Calling OCM to fetch ship dates.").log();
    ShipDateResponseDto responseDto = ocmWebClientService.fetchShipDatesFromOCM(request);

    log.atInfo().setMessage("Ship Dates fetched").log();

    // Prepare and return the Response
    return prepareShipDatesResponse(responseDto);
  }

  private void prepareShipDateRequest(ShipDateRequest request) {
    // this check below should be removed once there is an actual use of facility ID where it being
    // a UUID is necessary and will be automatically validated
    checkFacilityId(request.getFacilityId());
    request.setServiceLevel(getOCMServiceLevel(request.getServiceLevel()));
  }

  private String getOCMServiceLevel(String serviceLevel) {
    switch (serviceLevel.trim().toLowerCase()) {
      case OCMCommonConstants.CMS_COURIER_NEXT_DAY ->
          serviceLevel = OCMCommonConstants.OCM_SHIPMENT_TYPE_NEXTDAY;
      case OCMCommonConstants.CMS_COURIER_SAME_DAY ->
          serviceLevel = OCMCommonConstants.OCM_SHIPMENT_TYPE_SAMEDAY;
      case OCMCommonConstants.CMS_COURIER_SAME_DAY_STATE ->
              serviceLevel = OCMCommonConstants.OCM_SHIPMENT_TYPE_SAMEDAYSTATE;
      default ->
          throw new ValidationException(
              "service level must be courier-same-day or courier-next-day");
    }
    return serviceLevel;
  }

  // Method to check if facility id is UUID
  private void checkFacilityId(String facilityId) {
    try {
      UUID.fromString(facilityId);
    } catch (Exception e) {
      throw new ValidationException("Invalid facility ID: " + facilityId);
    }
  }

  // Method to prepare response.
  private ShipDateResponse prepareShipDatesResponse(ShipDateResponseDto responseDto) {
    return ShipDateResponse.builder()
        .status(
            responseDto.getStatus().equalsIgnoreCase(ServiceCommonConstants.VOID_SUCCESS)
                ? ServiceCommonConstants.VOID_SUCCESS
                : ServiceCommonConstants.VOID_FAIL)
        .message(responseDto.getMessage())
        .availableShipDates(responseDto.getAvailableShipDates())
        .build();
  }
}

