import com.cardinalhealth.adv.shipping.integration.api.redis.dto.OflUserCacheDto;
import com.cardinalhealth.adv.shipping.integration.api.redis.service.RedisRegionService;
import com.cardinalhealth.adv.shipping.integration.api.utils.CommonUtil;
import com.cardinalhealth.ofl.next.http.server.library.model.OflEntity;
import com.cardinalhealth.ofl.next.http.server.library.model.OflUser;
import com.cardinalhealth.ofl.next.http.server.library.model.UserPermission;
import com.cardinalhealth.ofl.next.http.server.library.model.UserRole;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;
import java.util.Optional;
import java.util.UUID;

import static com.cardinalhealth.adv.shipping.integration.api.constants.RegionConstants.USER_REGION;

@Component
@RequiredArgsConstructor
@Slf4j
public class UserService {
  private final UserClient userClient;

  private final RedisRegionService redisRegionService;

  public OflUser getUser(String userName) {

    Optional<OflUserCacheDto> userOptional=redisRegionService.get(USER_REGION,userName, OflUserCacheDto.class);
    if (userOptional.isPresent()) {
      log.atInfo().setMessage("User found in cache").log();
      return getOflUserFromWrapper(userOptional.get().getOflUserWrapper());
    }
    log.atInfo().setMessage("User not found in cache").log();
    OflUser user = userClient.getUser(userName).orElse(null);
    if (user != null) {
      redisRegionService.put(USER_REGION,userName,new OflUserCacheDto(userName, getOflUserWrapperFromUser(user)));
    }
    return user;
  }

  private OflUser getOflUserFromWrapper(OflUserWrapper oflUserWrapper) {
    List<UserPermission> permissions = null;
    if (oflUserWrapper.getUserPermissionList() != null) {
      permissions =
          oflUserWrapper.getUserPermissionList().stream()
              .map(
                  upw ->
                      new UserPermission(
                          upw.getUserRole() == null
                              ? null
                              : new UserRole(
                                  CommonUtil.getUUIDFromString(upw.getUserRole().getId()),
                                  upw.getUserRole().getName(),
                                  upw.getUserRole().getPrivileges()),
                          upw.getEntityList() == null
                              ? null
                              : upw.getEntityList().stream()
                                  .map(
                                      e ->
                                          new OflEntity(
                                              CommonUtil.getUUIDFromString(e.getId()),
                                              e.getEntityType(),
                                              CommonUtil.getUUIDFromString(e.getEntityId())))
                                  .toList()))
              .toList();
    }
    return new OflUser(
        CommonUtil.getUUIDFromString(oflUserWrapper.getId()),
        oflUserWrapper.getUserName(),
        oflUserWrapper.getFirstName(),
        oflUserWrapper.getLastName(),
        oflUserWrapper.getEmail(),
        oflUserWrapper.getPhone(),
        oflUserWrapper.getTitle(),
        oflUserWrapper.getActive(),
        oflUserWrapper.getThumbnail(),
        permissions,
        oflUserWrapper.getDefaultShipFromAddress());
  }

  private OflUserWrapper getOflUserWrapperFromUser(OflUser oflUser) {
    List<UserPermissionsWrapper> permissions = null;
    if (oflUser.getUserPermissionList() != null) {
      permissions =
          oflUser.getUserPermissionList().stream()
              .map(
                  up ->
                      UserPermissionsWrapper.builder()
                          .userRole(
                              up.getUserRole() == null
                                  ? null
                                  : UserRoleWrapper.builder()
                                      .id(CommonUtil.getStringFromUUID(up.getUserRole().getId()))
                                      .name(up.getUserRole().getName())
                                      .privileges(up.getUserRole().getPrivileges())
                                      .build())
                          .entityList(
                              up.getEntityList() == null
                                  ? null
                                  : up.getEntityList().stream()
                                      .map(
                                          e ->
                                              OflEntityWrapper.builder()
                                                  .id(CommonUtil.getStringFromUUID(e.getId()))
                                                  .entityType(e.getEntityType())
                                                  .entityId(
                                                      CommonUtil.getStringFromUUID(e.getEntityId()))
                                                  .build())
                                      .toList())
                          .build())
              .toList();
    }
    return OflUserWrapper.builder()
        .id(CommonUtil.getStringFromUUID(oflUser.getId()))
        .userName(oflUser.getUserName())
        .firstName(oflUser.getFirstName())
        .lastName(oflUser.getLastName())
        .email(oflUser.getEmail())
        .phone(oflUser.getPhone())
        .title(oflUser.getTitle())
        .active(oflUser.getActive())
        .thumbnail(oflUser.getThumbnail())
        .userPermissionList(permissions)
        .defaultShipFromAddress(oflUser.getDefaultShipFromAddress())
        .build();
  }

  public UserWithPermissionsDTO authorizeUser(
      OktaUser oktaUser, EntityType entityType, String entityId, List<String> roles) {
    var userRolePermissions = new ArrayList<UserRolePermission>();
    roles.forEach(
        role ->
            userRolePermissions.add(
                getXrefForUserToAdvShipRoleAndUserGroup(oktaUser, entityType, entityId, role)));

    var userWithPermissionsDTO =
        new UserWithPermissionsDTO(
            null,
            oktaUser.getProfile().get("firstName"),
            oktaUser.getProfile().get("lastName"),
            oktaUser.getProfile().get("login"),
            oktaUser.getProfile().get("email"),
            oktaUser.getProfile().get("title"),
            true,
            null,
            null,
            userRolePermissions);

    var oflUserOptional = userClient.getUser(userWithPermissionsDTO.getUsername());

    oflUserOptional.ifPresent(oflUser -> userClient.deleteUser(oflUser.getId()));

    return userClient.postUser(userWithPermissionsDTO);
  }

  public UserWithPermissionsDTO makeUser(
      String firstName,
      String lastName,
      String email,
      String phone,
      String title,
      byte[] thumbnail) {
    var userWithPermissionsDTO =
        new UserWithPermissionsDTO(
            null, firstName, lastName, email, email, title, true, phone, thumbnail, null);

    return userClient.postUser(userWithPermissionsDTO);
  }

  private UserRolePermission getXrefForUserToAdvShipRoleAndUserGroup(
      OktaUser oktaUser, EntityType entityType, String entityId, String roleName) {
    return createXref(
        roleName, "asp-%s".formatted(oktaUser.getProfile().get("email")), entityType, entityId);
  }

  private static UserRolePermission createXref(
      String roleName, String userGroupName, EntityType entityType, String entityId) {
    var userRole = new UserRole(null, roleName, null);
    var userGroup = new UserGroup(null, userGroupName);
    EntityGroupWithEntities entityGroupWithEntities =
        new EntityGroupWithEntities(
            null,
            String.format("entity_%s_%s", entityType.name(), entityId),
            List.of(new OflEntity(null, entityType.name(), UUID.fromString(entityId))));
    return new UserRolePermission(userRole, userGroup, entityGroupWithEntities);
  }
