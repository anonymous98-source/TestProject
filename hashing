  private void validateRequestForDhl(ShipmentBookRequest request) {
    if (DHL.equalsIgnoreCase(request.getShippingProfile())) {
      validateLithiumBatteryCount(request.getPackagingDetails().get(0).getAccessorials());
      validateAddressParameters(request);
      boolean dryIce = request.getPackagingDetails().get(0).getAccessorials().isContainsDryIce();
      boolean coldChain = request.getPackagingDetails().get(0).getAccessorials().isColdChain();
      boolean saturdayPickup = request.getAdditionalAccessorial().isSaturdayPickup();
      boolean emailNotification = request.getAdditionalAccessorial().isSubscribeToEmailUpdate();
      String reference3 = request.getPackagingDetails().get(0).getReference().getReference3();
