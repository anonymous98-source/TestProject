public class ManifestServiceImpl implements ManifestService {

    private final ManifestRepository manifestRepository;
    private final OCMWebClientService ocmWebClientService;
    private final SendFlexWebClientService sendFlexWebClientService;
   
    private final TrackingResourceWebClientService trackingResourceWebClientService;

    @Override
    public ManifestDocumentResponse generateManifest(ManifestRequest request, HttpHeaders headers, OflUserPrincipal oflUserPrincipal) {
        String manifestId = null;
        int noOfPackages = 0;
        LocalDateTime manifestDate = null;
        String manifestDoc = null;

        String dhlProfileCode = getDhlProfileCode(request);
        LocalDateTime maxManifestDate = manifestRepository.fetchMaxManifestDateByFacilityId(request.getFacilityId().toString());
        if (maxManifestDate != null) {
            maxManifestDate = maxManifestDate.truncatedTo(ChronoUnit.MILLIS);
        }
        OffsetDateTime startDateTime = maxManifestDate != null ? maxManifestDate.atOffset(ZoneOffset.UTC) : null;
        ManifestRequestDto manifestRequestDto = prepareManifestRequest(request, dhlProfileCode, startDateTime);

        try {
            List<ManifestResponseDto> manifests = fetchManifestFromSendFlex(manifestRequestDto);

            if (manifests == null || manifests.isEmpty()) {
                //set mock manifest data until we receive actual manifest data from SendFlex
                manifestId = UUID.randomUUID().toString();
                noOfPackages = 1;
                manifestDate = LocalDateTime.now().truncatedTo(ChronoUnit.MILLIS);
            } else {
                manifestId = manifests.get(0).getId();
                noOfPackages = manifests.get(0).getTransmitItems().size();
                manifestDate = OffsetDateTime.parse(manifests.get(0).getManifestDate()).toLocalDateTime();
            }

            ManifestDocumentRequestDto manifestDocumentRequestDto = ManifestDocumentRequestDto.builder()
                    .manifestId(manifestId)
                    .build();

            List<ManifestDocumentResponseDto> responseDocuments = fetchManifestDocsFromSendFlex(manifestDocumentRequestDto);

            if (responseDocuments != null) {
                manifestDoc = responseDocuments.stream()
                        .filter(doc -> MANIFEST.equalsIgnoreCase(doc.getType())
                                && PDF.equalsIgnoreCase(doc.getFormat()))
                        .map(doc -> doc.getContents().get(0))
                        .findFirst()
                        .orElse(null);
            }
        } catch (ResourceNotFoundException e) {
            log.atError()
                    .setMessage("Manifest document not found for manifestId: {}")
                    .addArgument(manifestId)
                    .addKeyValue("manifestId", manifestId)
                    .setCause(e)
                    .log();
        } catch (Exception e) {
            log.atError()
                    .setMessage("An error occurred while generating manifest: {}")
                    .addArgument(e.getMessage())
                    .addKeyValue("error", e.getMessage())
                    .setCause(e)
                    .log();
        }

        Manifest manifestEntity = Manifest.builder()
                .customerId(request.getCustomerId().toString())
                .facilityId(request.getFacilityId().toString())
                .manifestId(manifestId)
                .userId(oflUserPrincipal.getId())
                .userFirstName(oflUserPrincipal.getFirstName())
                .userLastName(oflUserPrincipal.getLastName())
                .manifestDate(manifestDate)
                .numberOfPackages(noOfPackages)
                .bolNumber(MOCK_BOL_NUMBER)
                .manifestContent(manifestDoc != null ? manifestDoc : ManifestMockResponse.getMockContent())
                .manifestContentType("PDF")
                .startTime(maxManifestDate != null ? maxManifestDate : LocalDateTime.now().minusHours(24).truncatedTo(ChronoUnit.MILLIS))
                .endTime(LocalDateTime.now().truncatedTo(ChronoUnit.MILLIS))
                .build();

        log.atInfo().setMessage("saving manifest record to database").log();
        Manifest savedManifest = manifestRepository.save(manifestEntity);
        return ManifestDocumentResponse.builder()
                .manifestId(savedManifest.getManifestId())
                .contentType(savedManifest.getManifestContentType())
                .content(savedManifest.getManifestContent())
                .build();
    }

    /**
     * Retrieves all manifest history records created by the specified user within the last 24 hours,
     * excluding the manifest document content. Results are filtered by facility and customer IDs.
     *
     * @return a list of manifest history responses from the last 24 hours
     */
    @Override
    public ManifestHistoryResponse getAllManifests(UUID facilityId, UUID customerId) {
        log.atInfo().setMessage("Fetching manifest history logic started").log();

        validateRequest(facilityId, customerId);

        // Fetch manifests created in the last 24 hours
        List<Manifest> manifestList = fetchManifests(facilityId.toString(), customerId.toString());

        // Filter the non-scanned manifest and call tracking service
        ManifestStatusResponse manifestStatusResponsesFromTracking =
                callTrackingService(manifestList, facilityId.toString(), customerId.toString());

        // Map tracking responses by manifestId for quick lookup
        Map<String, ManifestStatus> statusMap = manifestStatusResponsesFromTracking.getManifestStatuses().stream()
                .collect(Collectors.toMap(ManifestStatus::getManifestId, resp -> resp));

        List<Manifest> manifestsToBeUpdated = new ArrayList<>();

        // Update non-scanned manifests with latest status and persist
        manifestList.forEach(manifest -> {
            if (!SCANNED.equalsIgnoreCase(manifest.getStatus())) {
                ManifestStatus statusResponse = statusMap.get(manifest.getManifestId());
                if (statusResponse != null && statusResponse.isAllPickedUp()) {
                    manifest.setStatus(SCANNED);
                    manifestsToBeUpdated.add(manifest);
                }
            }
        });
        if (!manifestsToBeUpdated.isEmpty()) {
            manifestRepository.saveAll(manifestsToBeUpdated);
        }

        return mapToResponseDto(
                manifestList,
                manifestStatusResponsesFromTracking.getShipmentsSinceLastManifest(),
                facilityId,
                customerId);
    }

    /**
     * Retrieves the manifest document for the specified manifest ID.
     * fetches document content when a user requests to print a manifest from the manifest history list.
     *
     * @return a ManifestDocumentResponse containing the manifest document details
