package com.cardinalhealth.adv.shipping.integration.api.enums;

import lombok.AllArgsConstructor;
import lombok.Getter;
import org.apache.commons.lang3.StringUtils;

/**
 * ShipViaCode is an enumeration that represents shipping methods or carriers. Each enum constant is
 * associated with a specific string value representing the carrier code. The ENUM name is what we
 * get from Front End and the ENUM Value is what we send to SendFlex. Future requirements to
 * accommodate more carries could be handled by adding new ENUM as per the above statements.
 */
@Getter
@AllArgsConstructor
public enum ShipViaCode {
  FEDEX("UPSG"),
  USPS("USPSVAL"),
  DHL("USPSVAL");

  private final String value;

  public static String getValueByName(String name) {
    if (!StringUtils.isBlank(name)) {
      name = name.trim();
      for (ShipViaCode shipViaCode : ShipViaCode.values()) {
        if (shipViaCode.name().equalsIgnoreCase(name)) {
          return shipViaCode.getValue();
        }
      }
    }
    return ShipViaCode.FEDEX.getValue();
  }
}

