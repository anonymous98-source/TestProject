package com.cardinalhealth.adv.shipping.integration.api.utils;

import org.springframework.web.util.UriComponentsBuilder;

import java.net.URI;
import java.util.Map;
/**
 * Utility class for building URIs with query parameters.
 */
public class UriBuilderUtil {

    private UriBuilderUtil() {
        // Private constructor to prevent instantiation of utility class

    }

    /**
     * Builds a URI from the given base URL, path, and query parameters.
     *
     * @param baseUrl    The base URL.
     * @param path       The path to append to the base URL.
     * @param queryParams A map of query parameters to include in the URI.
     * @return The constructed URI.
     */
    public static URI buildUri(String baseUrl, String path, Map<String, String> queryParams) {
        try {
            UriComponentsBuilder builder = UriComponentsBuilder.fromHttpUrl(baseUrl).path(path);

            if (queryParams != null) {
                queryParams.forEach(builder::queryParam);
            }

            return builder.build().encode().toUri();
        }catch (Exception e) {
            throw new IllegalArgumentException("Error building URI: " + e.getMessage(), e);
        }

    }
}

