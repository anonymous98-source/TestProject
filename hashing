    log.atInfo()
            .setMessage(
                "Request to delete existing address in the address book with addressId")
            .log();
    subscriptionAccessValidator.validatePremiumFeatureAccess(facilityId);

    // Calling service method to soft-delete existing address if exists
    SuccessResponse deleteResponse = addressBookService.deleteAddressIfExists(addressId);
    return ResponseEntity.ok(deleteResponse);
  }

  /**
