    /**
     * Link MFA Registration detail to Sendfelx ProfileCode
     * @param profileCode profileCode
     * @param meteringRequestId meteringRequestId
     * @param updatedRecord updatedRecord
     * @return SendFlexMfaResponse
     */
    MeteringResponse profileCodeLinkingProcess(String profileCode, String meteringRequestId, FedexMeteringRecord updatedRecord, UUID meteredBy) {
        boolean isProfileCodeAlreadyLinked=fedexMeteringRecordRepository.existsByProfileCodeAndStatus(profileCode, MeteringState.COMPLETED.name());
        if(isProfileCodeAlreadyLinked) {
            updatedRecord.setStatus(MeteringState.LINK_FAILED.name());
            updatedRecord.setErrorMessage(PROFILE_CODE_LINK_FAILED+profileCode);
            fedexMeteringRecordRepository.save(updatedRecord);
            return buildSendFlexMfaResponse(PROFILE_CODE_LINK_FAILED, ResponseStatus.FAILED.name());
        }else {
            SendFlexCarrierLinkResult sendFlexCarrierProfileDetail=mfaRegisterAndLinkWebClient.getSendFlexProfile(profileCode);
            if(sendFlexCarrierProfileDetail!=null && sendFlexCarrierProfileDetail.getSuccess()!=null) {
                SendFlexCarrierLinkResult sendFlexCarrierLinkResult=mfaRegisterAndLinkWebClient.linkMfaDetailsToSendFlexProfile(meteringDataMapper.buildCarrierLinkRequest(sendFlexCarrierProfileDetail.getSuccess(), meteringRequestId));
                if(sendFlexCarrierLinkResult!=null && sendFlexCarrierLinkResult.getSuccess()!=null) {
                    //update DB with success status
                    updatedRecord.setProfileLinkedAt(LocalDateTime.now(ZoneOffset.UTC));
                    updatedRecord.setMeteredBy(meteredBy);
                    updatedRecord.setStatus(MeteringState.COMPLETED.name());
                    updatedRecord.setErrorMessage(null);
                    updatedRecord.setProfileCode(profileCode);
                    fedexMeteringRecordRepository.save(updatedRecord);
                    return buildSendFlexMfaResponse(METERING_COMPLETED, ResponseStatus.SUCCESS.name());
                }else if(sendFlexCarrierLinkResult!=null && sendFlexCarrierLinkResult.getError()!=null) {
                    //update DB with link failed status
                    updatedRecord.setStatus(MeteringState.LINK_FAILED.name());
                    updatedRecord.setErrorMessage(sendFlexCarrierLinkResult.getError().getTitle()+ "-"+PROFILE_LINK_FAILED );
                    fedexMeteringRecordRepository.save(updatedRecord);
                    return buildSendFlexMfaResponse(METERING_SUCCESS_AND_LINKING_FAILED , ResponseStatus.FAILED.name());
                }else {
                    updatedRecord.setStatus(MeteringState.LINK_FAILED.name());
                    updatedRecord.setErrorMessage(PROFILE_LINK_FAILED);
                    fedexMeteringRecordRepository.save(updatedRecord);
                    return buildSendFlexMfaResponse(METERING_SUCCESS_AND_LINKING_FAILED , ResponseStatus.FAILED.name());
                }
            }else if(sendFlexCarrierProfileDetail!=null && sendFlexCarrierProfileDetail.getError()!=null) {
                //update DB with link failed status
                updatedRecord.setStatus(MeteringState.LINK_FAILED.name());
                updatedRecord.setErrorMessage(sendFlexCarrierProfileDetail.getError().getTitle()+ "-"+PROFILE_FETCH_FAILED );
                fedexMeteringRecordRepository.save(updatedRecord);
                return buildSendFlexMfaResponse(METERING_SUCCESS_AND_LINKING_FAILED, ResponseStatus.FAILED.name());
            }else {
                //update DB with link failed status
                updatedRecord.setStatus(MeteringState.LINK_FAILED.name());
                updatedRecord.setErrorMessage(PROFILE_FETCH_FAILED);
                fedexMeteringRecordRepository.save(updatedRecord);
                return buildSendFlexMfaResponse(METERING_SUCCESS_AND_LINKING_FAILED, ResponseStatus.FAILED.name());
            }
        }
    }

    /**
     * Build SendFlexMfaResponse
     * @param message message
     * @param status status
     * @return SendFlexMfaResponse
     */
    public MeteringResponse buildSendFlexMfaResponse(String message, String status) {
        return MeteringResponse.builder()
                .message(message)
                .status(status)
                .build();
    }

    /**
     * Check metered for shipperNumber/fedexAccountNumber
     * @param shipperNumber shipperNumber/fedexAccountNumber
     * @return true/false
     */
    public boolean isMetered(String shipperNumber){
        if(StringUtils.isBlank(shipperNumber))
            return false;
        FedexMeteringRecord fedexMeteringRecord=fedexMeteringRecordRepository.findByShipperAccountNumber(shipperNumber);
        String mfaState = fedexMeteringRecord != null ? fedexMeteringRecord.getStatus() : null;
        return MeteringState.COMPLETED.name().equalsIgnoreCase(mfaState);
    }

    @Override
    public Boolean meteringStatus(String facilityId) {
        if (facilityId == null || facilityId.isBlank()) {
            throw new ValidationException("facilityId must not be blank");
        }

        UserCustomerProfile userCustomerProfile = userDetailsService.getUserCustomerProfile(facilityId,null);
        if (userCustomerProfile == null || userCustomerProfile.getFacilities() == null) {
            throw new ResourceNotFoundException(NO_ASSOCIATED_FACILITIES);
        }
        Facility facility = userCustomerProfile.getFacilities().get(facilityId);
        if (facility == null) {
            throw new ResourceNotFoundException(NO_ASSOCIATED_FACILITIES);
        }
        return isMetered(facility.getShipperNumber());
    }
}

