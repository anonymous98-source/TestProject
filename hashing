   * @param file the CSV file to be uploaded
   * @param monarchFacilityId the ID of the monarch facility associated with the addresses
   * @param isAppend flag indicating whether to append to existing entries
   * @return ResponseEntity<AddressBookCsvResponse> containing the status and message of the upload
   *     operation
   */
  @PreAuthorize("isAuthenticated() && hasRole('ADVSHIP_CUSTOMER_ADMIN')")
  @PostMapping(value = "/upload-csv", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
  public ResponseEntity<AddressBookCsvResponse> uploadCsv(
      @RequestParam("file") MultipartFile file,
      @RequestHeader HttpHeaders httpHeaders,
      @RequestParam("monarchFacilityId") String monarchFacilityId,
      @RequestParam Boolean isAppend) {
    log.atInfo()
            .setMessage(
                "Received request to upload user configurations")
            .log();
    subscriptionAccessValidator.validatePremiumFeatureAccess(monarchFacilityId);
    if (file.isEmpty()) {
      log.atError()
              .setMessage("Uploaded file is empty.")
              .log();
      return ResponseEntity.badRequest()
          .body(
              AddressBookCsvResponse.builder()
                  .status("FAILED")
                  .message("Uploaded file is empty.")
                  .build());
    }
    AddressBookCsvResponse response =
        addressBookExportAndStore.processAddressBookAndStore(monarchFacilityId, file, isAppend);
    return ResponseEntity.ok(response);
  }

