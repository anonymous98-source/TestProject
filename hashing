      newShipmentDto.setAccessorialCost(
              rateQuoteInfo == null
                      ? 0d
                      : ((Number) rateQuoteInfo.getOrDefault(ACCESSORIAL_COST, 0d)).doubleValue());

      newShipmentDto.setTotalCost(
              newShipmentDto.getBaseCost() + newShipmentDto.getAccessorialCost());

    }

    newShipmentDto.setMasterTrackingNumber(Optional.of(shipmentBookResponseDto)
            .map(ShipmentBookResponseDto::getShippingUnits)
            .flatMap(list -> list.stream().findFirst())
            .map(ShippingUnitResponseDto::getTrackingNumber)
            .flatMap(list ->list.stream().findFirst())
            .map(TrackingNumberDto::getValue)
            .orElse(null));

    newShipmentDto.setSuggestedAddressUsage(shipmentBookRequest.getSuggestedAddressUsage());
    newShipmentDto.setSuggestedResidentialFlagUsage(shipmentBookRequest.getSuggestedResidentialFlagUsage());

    return newShipmentDto;
  }

  public void updateRateQuoteInfoInTrackingResource(
          UUID shipmentId,
          Map<String, Object> rateQuoteFedexInfo,
          ShipmentBookResponseDto shipmentBookResponseDto) {

    log.atInfo()
                    .setMessage("Persisting pricing to tracking resource")
                    .log();

    // Null check for shipmentBookResponseDto
    if (shipmentBookResponseDto == null) {
        log.atWarn().setMessage("shipmentBookResponseDto is null, skipping pricing persistence").log();
        return;
    }

    FedExRateQuote.FedExRateQuoteBuilder fedExRateQuote = FedExRateQuote.builder();

    // set aspectName field (required to call tracking resource)
    fedExRateQuote.shipmentId(shipmentId);
    fedExRateQuote.aspectName(ModelConstants.PRICING);

    // Save both price quotes
    if (Objects.nonNull(rateQuoteFedexInfo)) {

      log.atInfo().setMessage("Pricing details has been set to new shipment.").log();
      List<ShipmentPriceQuoteDto> shipmentPriceQuoteDtos = getPriceQuoteDtos(rateQuoteFedexInfo);
      fedExRateQuote.shipmentPriceQuoteDtos(shipmentPriceQuoteDtos);
    }
    fedExRateQuote.baseCost(shipmentBookResponseDto.getPriceBreakDown().getBaseCost());
    fedExRateQuote.accessorialCost(shipmentBookResponseDto.getPriceBreakDown().getAccessorialCost());

    //update rate quote table/columns
    log.atInfo().setMessage("tracking-resource api call to persist pricing.").log();
    Mono<FedExPricingDto> shipmentResourceDtoMono =
            trackingResourceWebClientService.trackingResourceRequest(
                    TRACKING_PRICING_URI,
                    HttpMethod.POST,
                    new HashMap<>(),
                    fedExRateQuote.build(),
                    FedExPricingDto.class,
                    ModelConstants.PRICING);

    try{
      FedExPricingDto fedExPricingDto = shipmentResourceDtoMono.timeout(
              Duration.ofSeconds(properties.getAsyncPricingProcessingThreadPool()
                      .getRetryTimeout())).block();
      log.atInfo().addKeyValue("Pricing details persisted:", String.valueOf(fedExPricingDto)).log();
    } catch(Exception e){
      log.atError().setMessage("Error while persisting pricing details to tracking resource").setCause(e).log();
    }
  }


  private List<ShipmentPriceQuoteDto> getPriceQuoteDtos(Map<String, Object> rateQuoteInfo) {
    ObjectMapper objectMapper = new ObjectMapper();
    List<ShipmentPriceQuoteDto> priceQuotes = new ArrayList<>();

    // Create the price quote entry
    ShipmentPriceQuoteDto priceQuote =
        ShipmentPriceQuoteDto.builder()
            .totalAmount((Double) rateQuoteInfo.get(TOTAL_AMT))
            .providerCode(rateQuoteInfo.get(CODE).toString())
            .requestJson(objectMapper.valueToTree(rateQuoteInfo.get(REQUEST)))
            .responseJson(objectMapper.valueToTree(rateQuoteInfo.get(RESPONSE)))
            .statusCode(ServiceCommonConstants.SUCCESS_STATUS_CODE)
            .errorMessage(BLANK)
            .build();
    priceQuotes.add(priceQuote);

    return priceQuotes;
  }
}

