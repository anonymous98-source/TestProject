package com.cardinalhealth.adv.shipping.integration.api.service.impl;

import com.cardinalhealth.adv.shipping.integration.api.config.AdvShippingIntegrationApiProperties;
import com.google.pubsub.v1.PubsubMessage;
import java.time.Instant;
import java.time.LocalDateTime;
import java.time.ZoneOffset;
import java.time.format.DateTimeFormatter;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

@Component
@RequiredArgsConstructor
@Slf4j
public class DlqMessagePersister {
  private final GCSFileWriter gcsFileWriter;
  private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;

  public void persistMessage(PubsubMessage pubsubMessage, String serviceName, String topic) {
    try {
      if (pubsubMessage == null) {
        return;
      }
      var data = pubsubMessage.getData().toByteArray();
      if (data.length == 0) {
        return;
      }
      var publishTime = pubsubMessage.getPublishTime();
      Instant instant = Instant.ofEpochSecond(publishTime.getSeconds(), publishTime.getNanos());
      var iso8601Format =
          LocalDateTime.ofInstant(instant, ZoneOffset.UTC)
              .format(DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS"));
      String filePath =
          String.format(
              "%s/%s/%s_%s", topic, serviceName, iso8601Format, pubsubMessage.getMessageId());

      writeWithRetry(filePath, data);
    } catch (Exception e) {
      if (e instanceof InterruptedException) {
        Thread.currentThread().interrupt();
      }
      // Log and eat this exception.  If we can't even process this message on the DLQ, then
      // something is REALLY
      // messed up.  All we can do is log this error.  Otherwise, this message will retry forever.
      log.atError()
          .setCause(e)
          .log("Error persisting message to GCS for service {} and topic {}", serviceName, topic);
    }
  }

  private void writeWithRetry(String filePath, byte[] data) throws InterruptedException {
    long backoffMillis = advShippingIntegrationApiProperties.getDlqMessagePersisterInitialBackoffMillis();

    for (int attempt = 1; attempt <= advShippingIntegrationApiProperties.getDlqMessagePersisterMaxWriteAttempts(); attempt++) {
      try {
        gcsFileWriter.writeFileToBucket(
            advShippingIntegrationApiProperties.getDlqMessageBucketName(), filePath, data);
        return;
      } catch (Exception e) {
        if (attempt == advShippingIntegrationApiProperties.getDlqMessagePersisterMaxWriteAttempts()) {
          if (e instanceof RuntimeException) {
            throw (RuntimeException) e;
          }
          throw new RuntimeException(e);
        }
        log.atInfo()
            .setCause(e)
            .log(
                "Attempt {} to write file {} failed. Retrying in {} ms.",
                attempt,
                filePath,
                backoffMillis);
        Thread.sleep(backoffMillis);
        backoffMillis *= advShippingIntegrationApiProperties.getDlqMessagePersisterRetryBackoffFactor();
      }
    }
  }
}

