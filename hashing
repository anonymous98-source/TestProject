  @Override
  public ShippingProfileResponse persistShippingProfile(ShippingProfileRequest request) {

    ShippingProfile shippingProfile;
    boolean saveShippingProfile = request.getShippingProfileId() == null;
    // validate fields
    validateShippingProfileRequest(request);
    if (saveShippingProfile) {
      // check if less than 15 custom profiles exists
      if (dataMapperUtil.canCreateShippingProfile(request.getFacilityId())) {
        shippingProfile = dataMapperUtil.createShippingProfile(request);
      } else {
        throw new ValidationException(
            "15 Custom Shipping Profiles already exist for Facility Id: "
                + request.getFacilityId());
      }
    }
    // else request is to update existing profile
    else {
      // fetch the existing profile from DB based on the ID
      ShippingProfile existingShippingProfile =
          dataMapperUtil.getShippingProfile(request.getShippingProfileId());
      if (!Objects.isNull(existingShippingProfile)) {
        // if exist check to not be default
        validateNotDefault(existingShippingProfile);
        // validate deleted notifications
        validateDeletedNotifications(request, existingShippingProfile);
        // else update the info in existing profile
        shippingProfile = dataMapperUtil.updateShippingProfile(request, existingShippingProfile);
      } else {
        // else then throw error
        throw new ResourceNotFoundException(
            "No shipping profile exist for Id: " + request.getShippingProfileId());
      }
    }
    // Save the prepared shipping profile if not null
    var isProfileSaved = false;
    if (shippingProfile != null) {
      dataMapperUtil.saveShippingProfile(shippingProfile, request);
      isProfileSaved = true;
    }

    return dataMapperUtil.getShippingProfileResponse(saveShippingProfile, isProfileSaved);
  }

  private void validateDeletedNotifications(
          ShippingProfileRequest request, ShippingProfile existingShippingProfile) {
    if ((Boolean.TRUE.equals(existingShippingProfile.getSenderEmailDeleted()) && !Boolean.TRUE.equals(request.isSenderEmailDeleted()))
            || (Boolean.TRUE.equals(existingShippingProfile.getReceiverEmailDeleted()) && !Boolean.TRUE.equals(request.isReceiverEmailDeleted()))
            || (Boolean.TRUE.equals(existingShippingProfile.getSenderSmsDeleted()) && !Boolean.TRUE.equals(request.isSenderSmsDeleted()))
            || (Boolean.TRUE.equals(existingShippingProfile.getReceiverSmsDeleted()) && !Boolean.TRUE.equals(request.isReceiverSmsDeleted()))) {
      throw new ValidationException("Once deleted notifications can't be restored.");
    }
  }

  private void validateNotDefault(ShippingProfile existingShippingProfile) {
    if (Objects.isNull(existingShippingProfile.getFacilityId())) {
      throw new ValidationException("Default Shipping Profile cannot be updated.");
    }
  }

  private void validateShippingProfileRequest(ShippingProfileRequest request) {
    PremiumFeatureResponse premiumFeature = subscriptionAccessValidator.validatePremiumFeatureAccess(request.getFacilityId());

    packageTypeService.validateUniqueTagNames(request.getTags(), SHIPPING);
    validateCarrierAccess(request);
    validateAndSetLithiumBatteryValues(request);
    if (Objects.nonNull(request.getSignature())) {
      validateSignatureForCarriers(request);
    }
    var reason = new StringBuilder("Please send appropriate Shipping Profile Request :");

    validateReturn(reason, request.getType(), request.isReturnLabel());
    validateReturnServiceLevel(request.getCarrierServiceLevel(), request.isReturnLabel());
    validatePackageType(
        reason,
        request.getSelectedPackages(),
        request.isPackageTypeSelected(),
        request.isMultiPackageRestriction());
    validateWeightIndicator(reason, request);
    // the values within the list are validated based on the carrier below
    validateEmailSubscriptions(reason, request);
    validateSmsSubscriptions(reason, request, premiumFeature);
    validateSaturdayPickup(
        reason,
        request.isSaturdayPickup(),
        request.getReadyTime(),
        request.getAvailableUntil(),
        request.getSpecialInstructions());

    if (Objects.nonNull(request.getCarrierServiceLevel()) ||
            request.isFastestServiceLevel() ||
            request.isNoDefaultService()) {
      validateService(
              reason,
              request.getCarrierServiceLevel(),
              request.isFastestServiceLevel(),
              request.isNoDefaultService());
    }

    validateTags(reason, request.getTags());

    if (!reason.toString().trim().endsWith(":")) {
      throw new ValidationException(reason.deleteCharAt(reason.length() - 1).toString());
    }

    validateWeight(request);
    validateWeightUOM(request);
    validateSmsSubscriptionValues(request);
    if (Objects.nonNull(request.getSignature()) && !request.getSignature().isEmpty()) {
      validateSignature(request);
    }
    if (request.isSaturdayPickup()) {
      validateReadyAndAvailableTimeDifference(request.getReadyTime(), request.getAvailableUntil());
    }

    // Return specific Validations
    validateIfReturn(request);

    // Fetch Carrier Service Level from OCM
    UserConfigResponseDTO ocmResponseDTO =
        ocmWebClientService.getUserConfigDataFromOCM(
            request.getFacilityId(), request.getCustomerId());

    // validate intervention service
    validateInterventionService(request.getInterventionService(), request.getCarrier(), premiumFeature);

    // Carrier Specific Validation
    carrierSpecificValidation(request, ocmResponseDTO);

    //if defaultshippingprofileflag is being updated/created to true
    validateDefaultShippingProfile(request);
  }

  private void validateReturnServiceLevel(String carrierServiceLevel, boolean returnLabel) {
    if (returnLabel && carrierServiceLevel != null && carrierServiceLevel.equalsIgnoreCase(FEDEX_EXPRESS_SAVER_CODE)) {
        throw new ValidationException("Return Service Level cannot be FedEx Express.");
    }
  }

  private void validateWeightUOM(ShippingProfileRequest request) {
      if(Objects.nonNull(request.getWeight())){
          if(Objects.isNull(request.getWeightUOM())){
              throw new ValidationException("Weight Dimension must be provided.");
          } else if(!request.getCarrier().equalsIgnoreCase(DHL)
                  && request.getWeightUOM().equalsIgnoreCase("oz")){
              throw new ValidationException("Weight Dimension can't be oz.");
          }
      }
    }

    private void carrierSpecificValidation(ShippingProfileRequest request, UserConfigResponseDTO ocmResponseDTO) {
        switch (request.getCarrier().toLowerCase()) {
          case FE_FEDEX_KEY -> {
            validateDryIceAndLithiumBattery(request);
            validateDryIceWeight(request);
            validateInsuranceOptionsFedEx(
                request.isIndividualShipmentProtection(),
                request.getCoverageAmount(),
                request.isDeclaredValue(),
                request.getValueOfContent(),
                request.isAddOnInsurance(),
                request.getAddOnInsuranceValue());
              validateEmailSubscriptionValues(
                  request.getEmailSubscribedForSender(),
                  request.getEmailSubscribedForReceiver(),
                  FOUR_EMAIL_NOTIFICATIONS);
            if (Objects.nonNull(request.getCarrierServiceLevel())) {
              validateCarrierServiceLevelValue(
                  request.getCarrierServiceLevel(),
                  ocmResponseDTO.getLocation().getFedexConfiguration().getFedexServiceLevels());
            }
          }
          case FE_USPS_KEY -> {
            validateDryIceAndLithiumBattery(request);
            validateDryIceWeight(request);
            validateLithiumBatteryCount(request.getLithiumBatteries(), request.getCarrier().toUpperCase(), ONE);
            validateWeightForUSPS(request.getWeight());
            validateInsuranceOptionsUSPS(
                request.isIndividualShipmentProtection(),
                request.getCoverageAmount(),
                request.isDeclaredValue(),
                request.getValueOfContent(),
                request.isAddOnInsurance(),
                request.getAddOnInsuranceValue());
              validateEmailSubscriptionValues(
                  request.getEmailSubscribedForSender(),
                  request.getEmailSubscribedForReceiver(),
                  SIX_EMAIL_NOTIFICATIONS);
            if (Objects.nonNull(request.getCarrierServiceLevel())) {
              validateCarrierServiceLevelValue(
                  request.getCarrierServiceLevel(),
                  ocmResponseDTO.getLocation().getUspsConfiguration().getUspsServiceLevels());
            }
          }
          case FE_ON_DEMAND_KEY, FE_SAME_DAY_KEY, FE_NEXT_DAY_KEY -> {
            validateSaturdayPickupForCMS(request);
            validateDryIceWeight(request);
            validateLithiumBatteryCMS(request.getLithiumBatteries());
            validateInsuranceOptionsCMS(
                request.isIndividualShipmentProtection(),
                request.getCoverageAmount(),
                request.isDeclaredValue(),
                request.getValueOfContent(),
                request.isAddOnInsurance(),
                request.getAddOnInsuranceValue());

              validateEmailSubscriptionValues(
                  request.getEmailSubscribedForSender(),
                  request.getEmailSubscribedForReceiver(),
                  FOUR_EMAIL_NOTIFICATIONS);
              Set<String> emailNotifications = new HashSet<>(request.getEmailSubscribedForSender());
              emailNotifications.addAll(request.getEmailSubscribedForReceiver());
              excludeExceptionNotificationCMS(new ArrayList<>(emailNotifications));

            if (Objects.nonNull(request.getCarrierServiceLevel())
                && !request.getCarrierServiceLevel().isEmpty()) {
              validateCarrierServiceLevelValueCms(request);
            }
          }
          case FE_DHL_KEY -> {
            validateWightAgainstUOM(request);
            //validateNoReturn - covered under validateIfReturn()->validateCarrierForReturn()
            validateNoDryIce(request);
            validateLithiumBatteryCount(request.getLithiumBatteries(), request.getCarrier().toUpperCase(), ONE);
            List<String> allowedServiceLevels = validateLithiumBatteryOptionsWithWeight(request);
            validateNoColdChain(request);
            validateNoSaturdayPickup(request.isSaturdayPickup(), request.getCarrier().toUpperCase());
            //validateSignatureValue - covered under validateSignatureForCarriers()
            validateNoEmail(request);
            //validateSmsNotificationValues - covered above under validateSmsSubscriptionValues()
            if (Objects.nonNull(request.getCarrierServiceLevel())) {
              validateCarrierServiceLevelValue(
                      request.getCarrierServiceLevel(),
                      (CollectionUtils.isEmpty(allowedServiceLevels))
                              ? ocmResponseDTO.getLocation().getDhlConfiguration().getDhlServiceLevels()
                              : allowedServiceLevels);
            }
            validateNoInsurance(request);
          }
          default -> throw new ValidationException("Invalid carrier: " + request.getCarrier());
        }
    }

