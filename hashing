  /** Below Code Validates if the packageType and associated flags are proper */
  private void validatePackageType(
      StringBuilder reason,
      List<String> selectedPackages,
      boolean packageTypeSelected,
      boolean multiPackageRestriction) {

    int countOfSelectedPackages =
        Objects.isNull(selectedPackages) ? 0 : selectedPackages.size();
    if (multiPackageRestriction) {
      //this is being done since narrow list selection will allow to have single value
      // but would also have packageTypeSelected false
      countOfSelectedPackages = 2;
    }
    reason.append(
        switch (countOfSelectedPackages) {
          case 0 -> packageTypeFlagsCheck(packageTypeSelected, multiPackageRestriction);
          case 1 -> packageTypeFlagsCheck(!packageTypeSelected, multiPackageRestriction);
          default -> packageTypeFlagsCheck(packageTypeSelected, !multiPackageRestriction);
        });
  }

  private String packageTypeFlagsCheck(
      boolean packageTypeSelected, boolean multiPackageRestriction) {
    return isPackageTypeSelected(packageTypeSelected)
        + isMultiPackageRestriction(multiPackageRestriction);
  }

  private String isPackageTypeSelected(boolean packageTypeSelected) {
    return packageTypeSelected ? " Package Type Selected Indicator/" : "";
  }

  private String isMultiPackageRestriction(boolean multiPackageRestriction) {
    return multiPackageRestriction ? " Multi Package Restriction Indicator/" : "";
  }

  /** Below Code Validates if the email subscription details are in order */
  private void validateEmailSubscriptions(
      StringBuilder reason,
      ShippingProfileRequest request) {
    List<String> emailSubscribedForSender = request.getEmailSubscribedForSender();
    boolean senderEmailDeleted = request.isSenderEmailDeleted();
    List<String> emailSubscribedForReceiver = request.getEmailSubscribedForReceiver();
    boolean receiverEmailDeleted = request.isReceiverEmailDeleted();
    if (Boolean.FALSE.equals(senderEmailDeleted) && Boolean.FALSE.equals(receiverEmailDeleted)) {
      reason.append(
              (checkList(emailSubscribedForSender) ^ checkList(emailSubscribedForReceiver))
                      ? " Email Subscribed Mismatch/"
                      : "");
    }
    if (Boolean.TRUE.equals(senderEmailDeleted) && isListPresent(emailSubscribedForSender)) {
      reason.append(" Sender Email Deleted Indicator Mismatch/");
    }
    if (Boolean.TRUE.equals(receiverEmailDeleted) && isListPresent(emailSubscribedForReceiver)) {
      reason.append(" Receiver Email Deleted Indicator Mismatch/");
    }
  }

  /** Below Code Validates if the sms subscription details are in order */
  private void validateSmsSubscriptions(
      StringBuilder reason,
      ShippingProfileRequest request,
      PremiumFeatureResponse premiumFeature) {
    List<String> smsSubscribedForSender = request.getSmsSubscribedForSender();
    boolean senderSmsDeleted = request.isSenderSmsDeleted();
    List<String> smsSubscribedForReceiver = request.getSmsSubscribedForReceiver();
    boolean receiverSmsDeleted = request.isReceiverSmsDeleted();
    if((isListPresent(smsSubscribedForSender) || isListPresent(smsSubscribedForReceiver)) &&
            Boolean.FALSE.equals(premiumFeature.getBeaconPlus())){
      throw new ValidationException("Beacon Plus access is required for SMS Notifications");
    }
    if (Boolean.FALSE.equals(senderSmsDeleted) && Boolean.FALSE.equals(receiverSmsDeleted)) {
      reason.append(
            (checkList(smsSubscribedForSender) ^ checkList(smsSubscribedForReceiver))
                    ? SMS_MISMATCH_ERROR
                    : "");
    }
    if (Boolean.TRUE.equals(senderSmsDeleted) && isListPresent(smsSubscribedForSender)) {
      reason.append(" Sender SMS Deleted Indicator Mismatch/");
    }
    if (Boolean.TRUE.equals(receiverSmsDeleted) && isListPresent(smsSubscribedForReceiver)) {
      reason.append(" Receiver SMS Deleted Indicator Mismatch/");
    }
  }

  private Boolean checkList(List<String> list) {
    return Objects.isNull(list) || list.isEmpty();
  }

  /** Below Code Validates saturday pickup and associated fields are in order */
  private void validateSaturdayPickup(
      StringBuilder reason,
      Boolean saturdayPickup,
      String readyTime,
      String availableUntil,
      String specialInstructions) {
    if (saturdayPickup.equals(Boolean.TRUE)) {
      appendReasonIf(
          reason,
          StringUtils.isBlank(readyTime),
          StringUtils.isBlank(availableUntil),
          " Ready Time/",
          " Available Until/");
      if (StringUtils.isNotBlank(readyTime) && StringUtils.isNotBlank(availableUntil)) {
        appendReasonIf(
            reason,
            isTimeNotValid(readyTime),
            isTimeNotValid(availableUntil),
            " Ready Time Format/",
            " Available Until Format/");
      }
    } else {
      appendReasonIf(
          reason,
          StringUtils.isNotBlank(readyTime),
          StringUtils.isNotBlank(availableUntil),
          " Ready Time/",
          " Available Until/");
      reason.append(!Objects.isNull(specialInstructions) ? " Special Instruction/" : "");
    }
  }

  private static void appendReasonIf(
      StringBuilder reason,
      boolean condition1,
      boolean condition2,
      String reason1,
      String reason2) {
      String res2 = condition2 ? reason2 : "";
      String res1 = condition1 ? reason1 : res2;
    reason.append(
        condition1 && condition2
            ? reason1 + reason2
            : res1);
  }

  private static boolean isTimeNotValid(String time) {
    try {
      var formatter = DateTimeFormatter.ofPattern("h:mm a", Locale.ENGLISH);
      LocalTime.parse(time, formatter);
      return false;
    } catch (DateTimeParseException | NullPointerException e) {
      return true;
    }
  }

