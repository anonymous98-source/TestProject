    private void validateAddRequestFacilityId(AddressBookRequest request, String userName) {
        // Check for valid UUID -> If not a valid UUID then method throws exception to be handled globally
        final UUID facilityId = validateAndConvertUUID(request.getFacilityId(),
                AddressBookConstants.OPERATION_TYPE_ADD, AddressBookConstants.FACILITY_ID);

