package com.cardinalhealth.adv.shipping.integration.api.utils;

import com.cardinalhealth.adv.shipping.integration.api.constants.HttpServletConstants;
import jakarta.servlet.http.HttpServletRequest;

public class HttpServletUtils {

    private HttpServletUtils() {
        throw new IllegalStateException("Utility class");
    }

    /**
     * Retrieves the client's IP address from the request, considering various headers
     * that may be set by proxies or load balancers.
     *
     * @param request the HttpServletRequest object
     * @return the client's IP address, or null if the request is null
     */
    public static String getClientIpAddress(HttpServletRequest request) {
        if (request == null) {
            return null;
        }

        var headers = new String[]{
                HttpServletConstants.HEADER_X_FORWARDED_FOR,
                HttpServletConstants.HEADER_PROXY_CLIENT_IP,
                HttpServletConstants.HEADER_WL_PROXY_CLIENT_IP,
                HttpServletConstants.HEADER_HTTP_CLIENT_IP,
                HttpServletConstants.HEADER_HTTP_X_FORWARDED_FOR
        };

        for (String header : headers) {
            String ip = request.getHeader(header);
            if (ip != null && !ip.isEmpty() && !HttpServletConstants.UNKNOWN.equalsIgnoreCase(ip)) {
                return ip.split(",")[0].trim(); // In case of multiple IPs
            }
        }

        String remoteAddr = request.getRemoteAddr();
        return (remoteAddr != null && !remoteAddr.isEmpty()) ? remoteAddr : null;
    }

    /**
     * Retrieves the browser's user agent string from the request.
     *
     * @param request the HttpServletRequest object
     * @return the User-Agent string, or null if not available
     */
    public static String getBrowserUserAgent(HttpServletRequest request) {
        if (request == null) {
            return null;
        }

        String userAgent = request.getHeader(HttpServletConstants.HEADER_USER_AGENT);
        return (userAgent != null && !userAgent.isEmpty()) ? userAgent : null;
    }
}


