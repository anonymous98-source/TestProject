package com.cardinalhealth.adv.shipping.integration.api.validation;

import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.Notifications;
import jakarta.validation.ConstraintValidator;
import jakarta.validation.ConstraintValidatorContext;

import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.RECEIVER;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.SENDER;

public class EmailNotificationsValidator implements ConstraintValidator<EmailNotificationsCriteria, List<Notifications>> {

    @Override
    public boolean isValid(List<Notifications> notifications, ConstraintValidatorContext context) {
        if (notifications == null || notifications.isEmpty()) {
            return true; // Valid if the list is null or empty
        }

        Map<String, Set<String>> emailsByType = Map.of(SENDER, new HashSet<>(), RECEIVER, new HashSet<>());
        for (Notifications notification : notifications) {
            String recipientType = notification.getRecipientType();
            if (!emailsByType.containsKey(recipientType)) {
                return false; // Unknown recipient type
            }
            if (notification.getEmail() != null &&
                    !emailsByType.get(recipientType).add(notification.getEmail())) {
                return false; // Duplicate email found
            }
        }
        return emailsByType.get(SENDER).size() <= 5 && emailsByType.get(RECEIVER).size() <= 5; // Can't have more than 5 emails per type
    }
}

