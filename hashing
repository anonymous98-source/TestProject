import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpMethod;
import org.springframework.security.concurrent.DelegatingSecurityContextExecutorService;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

import static com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants.FACILITY_ID;
import static com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants.RECENT_ADDRESS_COUNT_ENDPOINT;
import static com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants.USER_ID;

@Service
@RequiredArgsConstructor
@Slf4j
public class AddressBookRetrievalServiceImpl implements AddressBookRetrievalService {

    private final ShipToAddressFavouriteRepository shipToAddressFavouriteRepository;
    private final ShipToAddressFacilityMappingCustomRepository shipToAddressFacilityMappingCustomRepository;
    private final TrackingResourceWebClientService trackingResourceWebClientService;


    /**
     * This method fetches all the required address count in parallel using completable future
     * and combines the result and set the counts in provided DTO object
     *
     * @param userId     User UUID
     * @param facilityId Facility ID in string
     * @return Map containing favourite, recent, All address count
     */
    @Override
    public Map<String, Long> fetchAllAddressCount(UUID userId, String facilityId, UUID monarchId) {
        Map<String, Long> addressCountMap = new ConcurrentHashMap<>();
        final ExecutorService baseExecutor = Executors.newFixedThreadPool(3);
        ExecutorService executor = new DelegatingSecurityContextExecutorService(baseExecutor);


        // Fetch All address count and set it into Response DTO
        CompletableFuture<Object> favouriteAddressCountFuture = CompletableFuture
                .supplyAsync(
                        () -> shipToAddressFavouriteRepository.getFavouriteAddressCountByFacilityIdAndUserId(
                                userId, facilityId),
                        executor
                )
                .thenAccept(favouriteAddressCount ->
                        addressCountMap.put(AddressBookConstants.FAVOURITE_ADDRESS_COUNT, favouriteAddressCount))
                .handle((result, exception) -> {
                    if (exception != null) {
                        log.atError()
                                .setMessage("Exception occurred while fetching favourite address count "
                                        + "and details is : " + exception.getMessage())
                                .log();
                        return 0L;
                    }
                    return result;
                });

        // Fetch All address count
        CompletableFuture<Object> allAddressCountFuture = CompletableFuture
                .supplyAsync(
                        () -> shipToAddressFacilityMappingCustomRepository.findAllContactCount(facilityId),
                        executor
                )
                .thenAccept(allAddressCount ->
                        addressCountMap.put(AddressBookConstants.ALL_ADDRESS_COUNT, allAddressCount))
                .handle((result, exception) -> {
                    if (exception != null) {
                        log.atError()
                                .setMessage("Exception occurred while fetching all address count and details is : "
                                        + exception.getMessage())
                                .log();
                        return 0L;
                    }
                    return result;
                });

        // Fetch Recent address counts from recent Shipments
        CompletableFuture<Object> recentAddressCountFuture = CompletableFuture
                .supplyAsync(() -> getRecentAddressCount(monarchId, facilityId),
                        executor
                )
                .thenAccept(recentAddressCount ->
                        addressCountMap.put(AddressBookConstants.RECENT_ADDRESS_COUNT,
                                Long.valueOf(recentAddressCount)))
                .handle((result, exception) -> {
                    if (exception != null) {
                        log.atError()
                                .setMessage("Exception occurred while fetching recent address count,"
                                        + " and details is : " + exception.getMessage())
                                .log();
                        return 0;
                    }
                    return result;
                });

        // Wait for all to get completed and then return the address count map
        CompletableFuture.allOf(favouriteAddressCountFuture,
                        allAddressCountFuture, recentAddressCountFuture)
                .thenRun(() -> {
                    log.atInfo()
                            .setMessage("Address count retrieval completed, returning map, now shutting down executor")
                            .log();
                    executor.shutdown();
                })
                .join();
        return addressCountMap;
    }

    private int getRecentAddressCount(UUID userId, String facilityId) {
        HashMap<String, String> params = new HashMap<>();
        params.put(USER_ID, userId.toString());
        params.put(FACILITY_ID, facilityId);
        List<Integer> recentAddressCount =
        trackingResourceWebClientService.trackingResourceGetRequest(
                RECENT_ADDRESS_COUNT_ENDPOINT,
                HttpMethod.GET,
                new HashMap<>(),
                Integer.class,
                params
        ).block();

        return recentAddressCount != null && !recentAddressCount.isEmpty() ? recentAddressCount.get(0) : 0;
    }

    /**
     * This method fetches total number of address marked favourite by the user for the facility ID (location)
     *
     * @param userId     Provided User UUID
     * @param facilityId Provided Facility ID
     * @return Total Number of address marked favourite by the user for the facility ID (location)
     */
    @Override
    public Long fetchTotalFavouriteAddressCountForUserAndFacilityId(UUID userId, String facilityId) {
        log.atInfo()
                .setMessage("Method:: fetchTotalFavouriteAddressCountForUserAndFacilityId called of "
                        + "AddressBookRetrievalServiceImpl class for fetching All Favourite Addresses")
                .log();

        if (!StringUtils.hasText(facilityId) || userId == null) {
            throw new ValidationException("FacilityId and UserId should be non null or not empty");
        }

        // Fetch total number of favourite addresses for the user of the provided facility ID
        Long totalFavouriteAddresses = shipToAddressFavouriteRepository
                .getFavouriteAddressCountByFacilityIdAndUserId(userId, facilityId);

        log.atInfo()
                .setMessage("Total number of favourite addresses: {}")
                .addArgument(totalFavouriteAddresses)
                .log();
        return totalFavouriteAddresses;
    }
}

