    private void validateUserEnrolledInOSP(UserDefaultsData userDefaultsData, PackagingDetails packagingDetails) {
        Boolean isUserEnrolledInOSP = userDefaultsData.getIsOptifreightShipmentProtection() != null
                ? userDefaultsData.getIsOptifreightShipmentProtection() : Boolean.FALSE;
        if (Boolean.TRUE.equals(packagingDetails.getPackaging().getIsIndividualShipmentProtection())
                && Boolean.FALSE.equals(isUserEnrolledInOSP)) {
          throw new ValidationException("User is not eligible for Opti Freight shipment protection "
                  + "but in request it has been opted in, not expected behaviour");
        }
    }

