    @Test
    void saveOrUpdateShippingRules_positive_updateById_existingRule_savesAndReturnsSuccess() {
        String idStr = UUID.randomUUID().toString();
        UUID id = UUID.fromString(idStr);
        validReq.setId(idStr);

        RuleDefinition existing = new RuleDefinition();
        existing.setId(UUID.randomUUID());

        try (MockedStatic<ShippingRuleCommonUtils> utils = mockStatic(ShippingRuleCommonUtils.class);
             MockedStatic<CommonUtil> commonUtil = mockStatic(CommonUtil.class)) {

            // static validations / helpers
            utils.when(() -> ShippingRuleCommonUtils.validateRequestPayload(anyString(), anyString(), anyString()))
                    .thenAnswer(inv -> null);
            utils.when(() -> ShippingRuleCommonUtils.buildWeightExpression(validReq.getOperation(), validReq.getWeight()))
                    .thenReturn("WEIGHT_EXPR");

            commonUtil.when(() -> CommonUtil.getUUIDFromStringIfValid(idStr))
                    .thenReturn(id);

            when(ruleDefinitionRepository.findById(id)).thenReturn(Optional.of(existing));
            when(ruleDefinitionRepository.save(any(RuleDefinition.class))).thenReturn(existing);

            WeightRuleGenericResponseDto resp = (WeightRuleGenericResponseDto) shippingRuleWeightService.saveOrUpdateShippingRules(validReq);

            // response asserts
            assertEquals(UPDATED, resp.getMessage());

            // verify profile check
            verify(serviceUtil).isShippingProfileExists(validReq.getShippingProfileId(), validReq.getFacilityId());

            // capture saved entity and validate all setters executed as expected
            ArgumentCaptor<RuleDefinition> captor = ArgumentCaptor.forClass(RuleDefinition.class);
            verify(ruleDefinitionRepository).save(captor.capture());

            RuleDefinition saved = captor.getValue();
            assertEquals(validReq.getFacilityId(), saved.getFacilityId());
            assertEquals(validReq.getCustomerId(), saved.getCustomerId());
            assertEquals(RuleType.WEIGHT.toString(), saved.getRuleType());
            assertEquals("WEIGHT_EXPR", saved.getExpression());
            assertEquals(RuleEvalMethod.EXPRESSION.getMethod(), saved.getRuleEvalMethod());
            assertEquals(String.valueOf(validReq.getWeight()), saved.getValue());
            assertEquals(validReq.getOperation(), saved.getOperator());
            assertEquals(UUID.fromString(validReq.getShippingProfileId()), saved.getShippingProfileId());
            assertEquals(Boolean.TRUE, saved.getActive());

            verify(ruleDefinitionRepository).findById(id);
            verify(ruleDefinitionRepository, never()).findWeightRule(any(), any(), any(), any(), any());
        }
    }

