  private void validateCarrierAccess(ShippingProfileRequest request){
    //calling OCM service to fetch the user configuration data
    UserConfigResponseDTO ocmResponseDTO =
            ocmWebClientService.getUserConfigDataFromOCM(request.getFacilityId(), request.getCustomerId());

    //carrier
    boolean isFedex = ocmResponseDTO.getLocation().getFedexConfiguration().getFedexAccess();
    boolean isUsps = ocmResponseDTO.getLocation().getUspsConfiguration().getUspsAccess();
    boolean isDhl = ocmResponseDTO.getLocation().getDhlConfiguration().getDhlAccess();

    //courier
    boolean isCmsAccess = ocmResponseDTO.getLocation().getCmsConfiguration().getCmsAccess();
    var isCmsSameDay = false;
    var isCmsNextDay = false;
    var isCmsSameDayState = false;

    if(isCmsAccess) {
      List<String> cmsServiceLevels = ocmResponseDTO.getLocation().getCmsConfiguration().getCmsServiceLevels();
      isCmsSameDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAY));
      isCmsNextDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_NEXTDAY));
      isCmsSameDayState = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAYSTATE));
    }

    Map<String, Boolean> carrierAccess = Map.of(
            FE_FEDEX_KEY, isFedex,
            FE_USPS_KEY, isUsps,
            FE_DHL_KEY, isDhl,
            FE_SAME_DAY_KEY, isCmsSameDay,
            FE_NEXT_DAY_KEY, isCmsNextDay,
            FE_ON_DEMAND_KEY, isCmsSameDayState
    );
    String profileCarrier = request.getCarrier().toLowerCase();
    if(Boolean.FALSE.equals(carrierAccess.get(profileCarrier))) {
      throw new ValidationException("Invalid carrier selection: '" + request.getCarrier() +
              "' is not accessible for the specified location.");
    }

  }

  private void validateAndSetLithiumBatteryValues(ShippingProfileRequest request) {
    List<String> lithiumBatteries = new ArrayList<>();
    if (request.isLithiumBattery()) {
      boolean check = anyLithiumSelected(request);
      if (!check) {
        throw  new ValidationException("At least one Lithium battery accessorial must be selected");
      }
      if (Boolean.TRUE.equals(request.getIonContainedInEquipment())) {
        lithiumBatteries.add(LITHIUM_ION_CONTAINED_IN_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(request.getMetalContainedInEquipment())) {
        lithiumBatteries.add(LITHIUM_METAL_CONTAINED_IN_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(request.getIonPackedWithEquipment())) {
        lithiumBatteries.add(LITHIUM_ION_PACKED_WITH_EQUIPMENT);
      }
      if (Boolean.TRUE.equals(request.getMetalPackedWithEquipment())) {
        lithiumBatteries.add(LITHIUM_METAL_PACKED_WITH_EQUIPMENT);
      }
      if(request.getCarrier().equalsIgnoreCase(DHL)){
        dhlSpecificLithiumOptions(request, lithiumBatteries);
      }
    }
    request.setLithiumBatteries(lithiumBatteries);
  }

