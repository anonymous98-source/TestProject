   log.atInfo()
            .setMessage("Publishing shipment details to Epic.")
            .log();

    if (oflUserPrincipal != null && oflUserPrincipal.getId() !=null)
        setUserDetails(shipmentResourceDto, oflUserPrincipal);
    if(Objects.nonNull(premiumFeatureDetails)) {
      setPremiumFeatureDetails(shipmentResourceDto, premiumFeatureDetails);
    }

    ShipmentDto shipmentDto = shipmentAdapter.getShipmentDtoToPublishForEpic(shipmentResourceDto, shipmentBookRequest);

    return publish(shipmentDto);
  }

  public void setUserDetails(ShipmentResourceDto shipmentResourceDto, OflUserPrincipal oflUserPrincipal) {
    UserDto userDto = userDetailsService.buildUserDtoFromOflUserPrincipal(oflUserPrincipal);
    if (userDto != null) {
      shipmentResourceDto.setUserId(userDto.getMonarchUserId());
      shipmentResourceDto.setUserFirstName(userDto.getFirstName());
      shipmentResourceDto.setUserLastName(userDto.getLastName());
