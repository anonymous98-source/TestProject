    public List<ShipmentNotificationDto> buildNotifications(ShipmentBookRequest shipmentBookRequest) {

        List<ShipmentNotificationDto> shipmentNotificationDtoList = new ArrayList<>();

        if (Objects.nonNull(shipmentBookRequest.getAdditionalAccessorial())) {
            List<Notifications> notifications =
                    shipmentBookRequest.getAdditionalAccessorial().getNotification();
            if (Objects.nonNull(notifications) && !notifications.isEmpty()) {
                for (Notifications notification : notifications) {
                    ShipmentNotificationDto shipmentNotificationDto =
                            ShipmentNotificationDto.builder()
                                    .notificationCommunicationChannel(EMAIL)
                                    .notificationCommunicationValue(notification.getEmail())
                                    .notificationEventSubscription(notification.getNotify())
                                    .build();
                    shipmentNotificationDtoList.add(shipmentNotificationDto);
                }
            }
            List<SmsNotifications> smsNotifications =
                    shipmentBookRequest.getAdditionalAccessorial().getSmsNotification();
            if (Objects.nonNull(smsNotifications) && !smsNotifications.isEmpty()) {
                for (SmsNotifications smsNotification : smsNotifications) {
                    ShipmentNotificationDto shipmentNotificationDto =
                            ShipmentNotificationDto.builder()
                                    .notificationCommunicationChannel(PHONE)
                                    .notificationCommunicationValue(smsNotification.getPhoneNumber())
                                    .notificationEventSubscription(smsNotification.getNotify())
                                    .build();
                    shipmentNotificationDtoList.add(shipmentNotificationDto);
                }
            }
        }
        return shipmentNotificationDtoList.isEmpty() ? null : shipmentNotificationDtoList;
    }

