import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.LABEL_REFERENCE_3;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.INTERNAL_DESIGNATION_REFERENCE;

@Component
@RequiredArgsConstructor
public class ConditionValueValidator implements ConstraintValidator<ValidConditionValue, ConditionDTO> {
    private final CompoundValidationData compoundValidationData;
    private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;


    @Override
    public boolean isValid(ConditionDTO condition, ConstraintValidatorContext context) {
        String key = condition.getKey().trim().toLowerCase(Locale.ROOT);
        String operator = condition.getOperator() == null ? null : condition.getOperator().trim().toLowerCase(Locale.ROOT);
        Object rawValue = condition.getValue();

        if (isMultiValueOperator(operator)) {
            return validateListValue(key, operator, rawValue, context);
        }

        return validateSingleValue(key, operator, rawValue, context);
    }

    private boolean isMultiValueOperator(String operator) {
        return IS_ONE_OF.name().equalsIgnoreCase(operator) || IS_NOT_ONE_OF.name().equalsIgnoreCase(operator);
    }

    private boolean validateListValue(String key, String operator, Object rawValue, ConstraintValidatorContext context) {
        if (!(rawValue instanceof Collection<?> values)) {
            return buildViolationIfInvalid(
                    false,
                    context,
                    key,
                    "value must be a list for operator is_one_of or is_not_one_of"
            );
        }

        if (values.isEmpty()) {
            return buildViolationIfInvalid(
                    false,
                    context,
                    key,
                    "value list must not be empty"
            );
        }

        if (key.equalsIgnoreCase(SHIP_TO_STATE) && values.size() > 50) {
            return buildViolationIfInvalid(
                    false, context, key, "Number of states cannot be more than 50");
        }

        if (values.size() > advShippingIntegrationApiProperties.getCompoundRule().getInOperatorLimit()) {
            return buildViolationIfInvalid(
                    false,
                    context,
                    key,
                    "Compound rule Operator limit exceeded for IS_ONE_OF and IS_NOT_ONE_OF. Maximum limit is " + advShippingIntegrationApiProperties.getCompoundRule().getInOperatorLimit()
            );
        }

        for (Object item : values) {
            if (item == null || StringUtils.isBlank(String.valueOf(item)) || !isValueValidForKey(key, operator, item)) {
                return buildViolationIfInvalid(
                        false,
                        context,
                        key,
                        getValidationMessage(key, operator)
                );
            }
        }

        return true;
    }

    private boolean validateSingleValue(String key, String operator, Object rawValue, ConstraintValidatorContext context) {
        boolean valid = rawValue != null && !StringUtils.isBlank(String.valueOf(rawValue)) && isValueValidForKey(key, operator, rawValue);
        return buildViolationIfInvalid(valid, context, key, getValidationMessage(key, operator));
    }


    public boolean isValueValidForKey(String key, String operator, Object rawValue) {
        if (!validateType(key, rawValue)) {
            return false;
        }
        String value = String.valueOf(rawValue).trim();
        Map<String, String> regexMapping = compoundValidationData.getRegexMapping();
        if (!regexMapping.containsKey(key + HASH_DELIMITER + operator)) {
            return true;
        }
        boolean isValid = regexMapping.containsKey(key + HASH_DELIMITER + operator) && Pattern.compile(regexMapping.get(key + HASH_DELIMITER + operator)).matcher(value).matches();
        if (!isValid) {
            return false;
        }
        if (key.contains(WEIGHT)) {
            BigDecimal weight = new BigDecimal(value);
            return weight.compareTo(new BigDecimal("0.01")) > 0
                    && weight.compareTo(new BigDecimal("150.00")) <= 0;
        }
        return true;
    }

    private boolean validateType(String key, Object rawValue) {
        Map<String, String> fieldTypeMapping = compoundValidationData.getTypeMapping();
        String fieldType = fieldTypeMapping.get(key);
        switch (fieldType) {
            case STRING_TYPE:
                if ((rawValue instanceof String)) {
                    return true;
                }
                break;
            case BOOLEAN_TYPE:
                if ((rawValue instanceof Boolean)) {
                    return true;
                }
                break;
            case NUMBER_TYPE:
                if (rawValue instanceof Number) {
                    return true;
                }

                if (rawValue instanceof String) {
                    try {
                        new BigDecimal((String) rawValue);
                        return true;
                    } catch (NumberFormatException e) {
                        return false;
                    }
                }
                break;
            default:
                return false;
        }
        return false;
    }

    private String getValidationMessage(String key, String operator) {
        return switch (key) {
            case SHIP_VIA -> "shipVia max 35 alphanumeric characters allowed and should be String";
            case COLD_CHAIN -> "coldChain must be a boolean and either true or false";
            case ZIP_CODE -> {
                if (STARTS_WITH.name().equalsIgnoreCase(operator)) {
                    yield "zipcode must be 1 to 5 digits for startwith operator and of type String";
                }
                yield "zipcode must be 5 digits and of type String";
            }
            case WEIGHT -> "weight must be greater than 0.01 and less than or equal to 150.00 and of type number";
            case VALUE -> "value must be an integer with maximum 8 digits and of type number";
            case SHIP_DAY -> "shipDay must be any day of the week";
            case SHIP_TO_STATE ->
                    "shipToState must be a valid US state code of 2 characters and of type String";
            case LABEL_REFERENCE_1 -> "labelReference1 must be maximum 30 characters and of type String";
            case LABEL_REFERENCE_2 -> "labelReference2 must be maximum 30 characters and of type String";
            case LABEL_REFERENCE_3 -> "labelReference3 must be maximum 35 characters and of type String";
            case INTERNAL_DESIGNATION_REFERENCE -> "internalDesignationReference must be alphanumeric, maximum 35 characters and of type String";
            default -> "invalid value";

        };
    }

    private boolean buildViolationIfInvalid(boolean valid,
                                            ConstraintValidatorContext context,
                                            String fieldName,
                                            String message) {
        if (valid) {
            return true;
        }

        context.disableDefaultConstraintViolation();
        context.buildConstraintViolationWithTemplate(message)
                .addPropertyNode(fieldName)
                .addConstraintViolation();
        return false;
    }
}

