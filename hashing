    public Map<String, List<Object>> getAllPackagesByTypeFacilityIdAndCarrier(String packageType, UUID facilityId, String carrier, String searchQuery) {
        log.atInfo()
                .setMessage("Inside service class to fetch all standard and custom package profiles")
                .log();

        if(Objects.isNull(facilityId)) {
            throw new ValidationException("facilityId must be provided!");
        }

        Map<String, List<Object>> response = new HashMap<>();

        // check if the request is for search.
        if((Objects.nonNull(searchQuery) && !searchQuery.isEmpty())
                && packageType.equalsIgnoreCase(CUSTOM)) {
            log.atInfo()
                    .setMessage("Search request received to filter out the packageType").log();

            List<PackageType> filteredEntity = getCustomPackage(facilityId, searchQuery.toLowerCase());

            Map<UUID, List<TagDto>> packageIdtoTagsMap = getAllTags(filteredEntity);

            List<PackageTypeDto> filteredPackageType = mapToDtoCustom(filteredEntity, packageIdtoTagsMap);
            response.put(CUSTOM_PACKAGE, new ArrayList<>(filteredPackageType));
            return response;
        }

        //Standard Profiles
        if(packageType.equalsIgnoreCase(STANDARD) || packageType.equalsIgnoreCase(ALL_PACKAGE_PROFILE) ){

            List<PackageProfileEntity> entityList = getStandardPackage(carrier);
            List<PackageProfileDto> standardProfiles = mapToDtoStandard(entityList);
            response.put(STANDARD_PACKAGE, new ArrayList<>(standardProfiles));
        }

        //Custom Profiles
        if(packageType.equalsIgnoreCase(CUSTOM) || packageType.equalsIgnoreCase(ALL_PACKAGE_PROFILE) ){
            List<PackageType> entityList = getCustomPackage(facilityId, null);

            // map all tags
            Map<UUID, List<TagDto>> packageIdtoTagsMap = getAllTags(entityList);

            List<PackageTypeDto> customProfiles = mapToDtoCustom(entityList, packageIdtoTagsMap);

            response.put(CUSTOM_PACKAGE, new ArrayList<>(customProfiles));
        }
        return response;
    }


    private  List<PackageProfileEntity> getStandardPackage(String carrier){

        if (!StringUtils.hasText(carrier)) {
            log.atInfo()
                    .setMessage("Provided carrier is blank, falling back to existing 'All Package profile list'")
                    .log();

            return packageProfileRepository.findAll();
        }else{
            List<PackageProfileEntity> entityList = packageProfileRepository.findActivePackageProfilesByCarrier(carrier);
            if(Objects.isNull(entityList) || entityList.isEmpty()){
                log.atInfo()
                        .setMessage("No standard package profile found for carrier: {}")
                        .addArgument(carrier)
                        .addKeyValue("carrier", carrier)
                        .log();
                throw new ResourceNotFoundException("No standard package profile found for carrier: " + carrier);
            }

            log.atInfo()
                    .setMessage("Fetched package profiles with count : {}")
                    .addArgument(entityList.size())
                    .addKeyValue("packageProfileCount", entityList.size())
                    .log();

            return entityList;
        }
    }

    private List<PackageType> getCustomPackage(UUID facilityId, String searchQuery){

        List<PackageType> entityList;
        if(Objects.nonNull(searchQuery) && !searchQuery.isEmpty()){
            log.atInfo().setMessage("searching for packageType with searchQuery: "+ searchQuery).log();
            entityList  = packageTypeRepository.findFilteredPackageType(facilityId.toString(), searchQuery);
        }else{
            entityList = packageTypeRepository
                    .findAllByFacilityIdAndActiveIsTrueOrderByPackageTypeName(facilityId.toString());
            log.atInfo()
                    .setMessage("Fetched custom profile with count: {}")
                    .addArgument(entityList.size())
                    .log();        }
        return Objects.nonNull(entityList) ? entityList : Collections.emptyList();
    }

    private  Map<UUID, List<TagDto>> getAllTags( List<PackageType> entityList){
        if(Objects.isNull(entityList) || entityList.isEmpty()){
            return Collections.emptyMap();
        }
        log.atInfo()
                .setMessage("Getting all tags for package type count: {}")
                .addArgument(entityList.size())
                .log();
        List<UUID> packageIds = entityList.stream().map(PackageType::getId).toList();

        //Fetch all TagMapping and map packageId -> List<Tag>
        List<TagMapping> tagMapping = tagMappingRepository.findByEntityTypeAndEntityIdIn(PACKAGE, packageIds);
        return  tagMapping.stream()
                .filter(tm -> tm.getTag() != null && Boolean.TRUE.equals(tm.getTag().getActive()))
                .collect(Collectors.groupingBy(
                        TagMapping::getEntityId,
                        Collectors.mapping(tm-> new TagDto(
                                tm.getTag().getId(),
                                tm.getTag().getTagName(),
                                tm.getTag().getActive()
                        ), Collectors.toList())
                ));
    }
    // mapping methods
    private List<PackageProfileDto> mapToDtoStandard(List<PackageProfileEntity> entityList){
        return entityList.stream()
                .map(data -> {
                    PackageProfileDto dto = PackageProfileDto
                            .builder()
                            .id(data.getId())
                            .customerId(data.getCustomerId())
                            .packageProfileName(data.getPackageProfileName())
                            .packageProfileLength(data.getPackageProfileLength())
                            .packageProfileWidth(data.getPackageProfileWidth())
                            .packageProfileHeight(data.getPackageProfileHeight())
                            .packageProfileDimUnit(data.getPackageProfileDimUnit())
                            .packageProfileWeightUnit(data.getPackageProfileWeightUnit())
                            .packageProfileStatus(data.getPackageProfileStatus())
                            .build();
                    log.atInfo()
                            .setMessage("Fetched Standard Profile")
                            .log();
                    return dto;
                }).toList();
    }

    private List<PackageTypeDto> mapToDtoCustom(List<PackageType> entityList, Map<UUID, List<TagDto>> packageIdtoTagsMap){
        return entityList.stream()
                .map(e -> {
                    List<TagDto> tags = packageIdtoTagsMap.getOrDefault(e.getId(), Collections.emptyList());
                    PackageTypeDto dto = PackageTypeDto.builder()
                            .id(e.getId())
                            .packageProfileName(e.getPackageTypeName())
                            .facilityId(e.getFacilityId())
                            .isColdChain(e.getIsColdChain())
                            .ratedLength(e.getRatedLength())
                            .isDryIce(e.getIsDryIce())
                            .dryIceWeight(e.getDryIceWeight())
                            .packagingType(e.getPackagingType())
                            .packageBrand(e.getPackageBrand())
                            .packageProductName(e.getPackageProductName())
                            .packageDescription(e.getPackageDescription())
                            .packageModelIdentifier(e.getPackageModelIdentifier())
                            .packageProfileLength(e.getLength())
                            .packageProfileWidth(e.getWidth())
                            .packageProfileHeight(e.getHeight())
                            .innerLength(e.getInnerLength())
                            .innerWidth(e.getInnerWidth())
                            .innerHeight(e.getInnerHeight())
                            .active(e.getActive())
                            .tags(tags)
                            .packageProfileStatus((Boolean.TRUE.equals(e.getActive()) ? Status.ACTIVE : Status.INACTIVE).toString())
                            .isCustomPackage(true)
                            .build();
                    log.atInfo().setMessage("Fetched Custom Profile with all tags").log();
                    return dto;
                }).toList();
    }
}

