import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.VALIDATION_SUCCESS;

@RequiredArgsConstructor
@Component
@Slf4j
public class ServiceDecorator {


    private final UserDefaultsService userDefaultsService;

    public <T, R> R decorate(T request, ServiceInvoker<T, R> serviceMethod, OflUserPrincipal oflUserPrincipal) throws IOException {
        if (!isValidRequest(request, oflUserPrincipal)) {
            log.info(VALIDATION_MISMATCH);
            throw new ValidationException(VALIDATION_MISMATCH);
        }
        return serviceMethod.invoke(request);
    }

    private <T> boolean isValidRequest(T request, OflUserPrincipal oflUserPrincipal) {
        var result = false;

        String facilityId = extractFacilityId(request);
        DefaultValuesContext.enableRaws();
        List<UserDefaultsResponse> userDefaultsResponses = userDefaultsService.getDefaultValues(oflUserPrincipal, facilityId);
        DefaultValuesContext.disableRaws();

        UserDefaultsData userDefaultsData = userDefaultsResponses.get(0).getData();

        if (userDefaultsData == null) {
            throw new ResourceNotFoundException("User Defaults data not found");
        }

        if (userDefaultsData.getShipmentAddress().getFacilityId() == null ) {
            throw new ResourceNotFoundException("FacilityId not found in User Defaults");
        }

        boolean isPrescriptionEnabled = userDefaultsData.isPrescriptionEnabled();
        List<String> costCenters = userDefaultsData.getBillingInformation().getCostCenter();
        Set<String> uniqueCostCenters = new HashSet<>(costCenters);

        Set<String> optiFreightNumbers = new HashSet<>(userDefaultsData.getBillingInformation().getOptiFreightNumber());

        Boolean isOptifreightShippingProtection = userDefaultsData.getIsOptifreightShipmentProtection();
        List<String> codes;

        if (request instanceof ShipPlanRequest shipPlanRequest) {
            // Validate selected Shipment protection
            shipPlanRequest.getPackagingDetails().stream()
                    .filter(packagingDetails -> packagingDetails.getAccessorials() != null
                            && packagingDetails.getPackaging() != null)
                    .forEach(packageDetails -> {
                                validateSelectedShipmentInsurance(packageDetails.getAccessorials().isDeclaredValue(),
                                        packageDetails.getPackaging().getIsIndividualShipmentProtection(),
                                        packageDetails.getAccessorials().getAddOnInsurance());
                                validatePrescriptionNumberForShipPlan(packageDetails, isPrescriptionEnabled, shipPlanRequest.getSourceSystem());
                            }

                    );

            log.info("ShipPlan received for validation");
        } else if (request instanceof ShipmentBookRequest shipmentBookRequest) {
            // Validate selected Shipment protection
            shipmentBookRequest.getPackagingDetails().stream()
                    .filter(packagingDetails -> packagingDetails.getAccessorials() != null
                            && packagingDetails.getPackaging() != null)
                    .forEach(packageDetails -> {
                            validateSelectedShipmentInsurance(packageDetails.getAccessorials().isDeclaredValue(),
                                    packageDetails.getPackaging().getIsIndividualShipmentProtection(),
                                    packageDetails.getAccessorials().getAddOnInsurance());
                        validatePrescriptionNumberForShipBook(packageDetails, isPrescriptionEnabled, shipmentBookRequest.getSourceSystem());
                        }
                    );

            validateRuleId(shipmentBookRequest);
            log.info("ShipmentBookRequest received for validation");
        }


        List<String> fedexServiceCodes = userDefaultsResponses.get(0).getData().getFedEx().stream().map(FedexServiceLevelDTO::getServiceLevelCode).toList();
        List<String> uspsServiceCodes = userDefaultsResponses.get(0).getData().getUsps().stream().map(UspsServiceLevelDTO::getServiceLevelCode).toList();
        List<String> dhlServiceCodes = userDefaultsResponses.get(0).getData().getDhl().stream().map(DhlServiceLevelDTO::getServiceLevelCode).toList();

        List<String> cmsServiceLevels = new ArrayList<>();

        if (Boolean.TRUE.equals(userDefaultsData.getIsCmsSameDay()))
        {
            cmsServiceLevels.add(OCM_SHIPMENT_TYPE_SAMEDAY);
        }
        if(Boolean.TRUE.equals(userDefaultsData.getIsCmsNextDay()))
        {
            cmsServiceLevels.add(OCM_SHIPMENT_TYPE_NEXTDAY);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsCmsSameDayState())){
            cmsServiceLevels.add(OCM_SHIPMENT_TYPE_SAMEDAYSTATE);
        }
        if(cmsServiceLevels.isEmpty()){
            cmsServiceLevels = null;
        }

        codes = getCodesBasedOnShipmentProfile(fedexServiceCodes, cmsServiceLevels, uspsServiceCodes, dhlServiceCodes, request);
        result = check(uniqueCostCenters, optiFreightNumbers, isOptifreightShippingProtection,
                codes, request);
        if (request instanceof ShipPlanRequest shipPlanRequest) {
            shipPlanRequest.setUserDefaultsResponses(userDefaultsResponses);
        }
        if (request instanceof ShipmentBookRequest shipmentBookRequest) {
            shipmentBookRequest.setUserDefaultsResponses(userDefaultsResponses);
        }
        return result;
    }

    private static void validateRuleId(ShipmentBookRequest shipmentBookRequest) {
        if (shipmentBookRequest.getRuleId() != null) {
            boolean isInvalid = CommonUtil.isInvalidUUID(shipmentBookRequest.getRuleId());
            if (isInvalid) {
                throw new ValidationException("Invalid ruleId provided in the request");
            }
        }
        if (shipmentBookRequest.getRuleLogId() != null) {
            boolean isInvalid = CommonUtil.isInvalidUUID(shipmentBookRequest.getRuleLogId());
            if (isInvalid) {
                throw new ValidationException("Invalid ruleLogId provided in the request");
            }
        }
    }

    private void validatePrescriptionNumberForShipPlan(PackagingDetails packageDetails, boolean isPrescriptionEnabled, String source) {
        if (!isPrescriptionEnabled || SOURCE_NAVIGATOR_API.equalsIgnoreCase(source)) {
            return;
        }
        if (packageDetails.getReference() == null || StringUtils.isBlank(packageDetails.getReference().getPrescriptionNumber())) {
            throw new ValidationException("Prescription number is required when prescription is enabled.");
        }
        if (packageDetails.getReference().getPrescriptionNumber().equalsIgnoreCase(NOT_AVAILABLE)) {
            packageDetails.getReference().setPrescriptionNumber("");
        }
    }

    private void validatePrescriptionNumberForShipBook(com.cardinalhealth.adv.shipping.integration.api.model.shipbook.PackagingDetails packageDetails, boolean isPrescriptionEnabled, String source) {
        if (!isPrescriptionEnabled || SOURCE_NAVIGATOR_API.equalsIgnoreCase(source)){
            return;
        }
        if (packageDetails.getReference() == null || StringUtils.isBlank(packageDetails.getReference().getPrescriptionNumber())) {
            throw new ValidationException("Prescription number is required when prescription is enabled.");
        }
        if (packageDetails.getReference().getPrescriptionNumber().equalsIgnoreCase(NOT_AVAILABLE)) {
            packageDetails.getReference().setPrescriptionNumber("");
        }
    }


    private List<String> getCodesBasedOnShipmentProfile(List<String> fedexServiceCodes, List<String> cmsServiceLevels, List<String> uspsServiceCodes, List<String> dhlServiceCodes, Object request) {
        List<String> codes = new ArrayList<>();
        var shipmentProfile = "";
        if (request instanceof ShipPlanRequest shipPlanRequest) {
            shipmentProfile = shipPlanRequest.getShippingProfile();
        } else if (request instanceof ShipmentBookRequest shipmentBookRequest) {
            shipmentProfile = shipmentBookRequest.getShippingProfile();
        }
        //check based on shippingProfile

        if (cmsServiceLevels != null
                && (shipmentProfile.equalsIgnoreCase(CMS_COURIER_NEXT_DAY) || shipmentProfile.equalsIgnoreCase(CMS_COURIER_SAME_DAY) || shipmentProfile.equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE))) {
            codes.addAll(cmsServiceLevels);
        }
        codes.replaceAll(ShippingServiceType::getServiceDescriptionByCode);
        if (fedexServiceCodes != null && shipmentProfile.equalsIgnoreCase(FEDEX)) {
            codes.addAll(fedexServiceCodes);
        }
        if (uspsServiceCodes != null && shipmentProfile.equalsIgnoreCase(USPS)) {
            codes.addAll(uspsServiceCodes);
        }
        if(dhlServiceCodes != null && shipmentProfile.equalsIgnoreCase(DHL)) {
            codes.addAll(dhlServiceCodes);
        }
        return codes;
    }

    private String extractFacilityId(Object request) {
        if (request instanceof ShipPlanRequest shipPlanRequest) {
            return shipPlanRequest.getFacilityId();
        } else if (request instanceof ShipmentBookRequest shipmentBookRequest) {
            return shipmentBookRequest.getFacilityId();
        }
        throw new IllegalArgumentException("Unsupported request type");
    }

    private boolean check(Set<String> costCenter, Set<String> optiFreightNumbers, Boolean isOptifreightShippingProtection, List<String> shipViaOptions, Object request) {
        var validation = false;
        var aspValueForShipmentProtection = false;
        var shipmentProtection = false;
        var isBillingInformationNull = false;
        boolean shipViaOption;
        var shippingProfile = "";
        var combineCheck = false;

        if (request instanceof ShipmentBookRequest shipmentBookRequest) {
            aspValueForShipmentProtection = shipmentBookRequest.getPackagingDetails().get(0).getPackaging().getIsIndividualShipmentProtection();
            shipmentProtection = checkShipmentProtection(aspValueForShipmentProtection, isOptifreightShippingProtection);
            isBillingInformationNull = (shipmentBookRequest.getBillingInformation() == null);
            shippingProfile = shipmentBookRequest.getShippingProfile();
            shipViaOption = shipViaOptions.contains(shipmentBookRequest.getShipViaOptions().get(0).getCode());
            if(shipmentBookRequest.getSourceSystem()==null || !shipmentBookRequest.getSourceSystem().equalsIgnoreCase(SOURCE_NAVIGATOR_API)){
                combineCheck = ((!isBillingInformationNull) && shipViaOption
                        && optiFreightNumbers.contains(shipmentBookRequest.getBillingInformation().getOptiFreightNumber())
                        && costCenter.contains(shipmentBookRequest.getBillingInformation().getCostCenter()));
            }else{
                combineCheck = ((!isBillingInformationNull) && shipViaOption && optiFreightNumbers.contains(shipmentBookRequest.getBillingInformation().getOptiFreightNumber()));
            }

        }

        else if (request instanceof ShipPlanRequest shipPlanRequest) {
            aspValueForShipmentProtection = shipPlanRequest.getPackagingDetails().get(0).getPackaging().getIsIndividualShipmentProtection();
            shipmentProtection = checkShipmentProtection(aspValueForShipmentProtection, isOptifreightShippingProtection);
            isBillingInformationNull = (shipPlanRequest.getBillingInformation() == null);
            shippingProfile = shipPlanRequest.getShippingProfile();
            if(shipPlanRequest.getSourceSystem()==null ||  !shipPlanRequest.getSourceSystem().equalsIgnoreCase(SOURCE_NAVIGATOR_API)){
                combineCheck = (!isBillingInformationNull && costCenter.contains(shipPlanRequest.getBillingInformation().getCostCenter()));
            }else{
                combineCheck = !isBillingInformationNull;
            }

        }

        boolean isShipPlanRequest = request instanceof ShipPlanRequest;
        boolean isFedex = shippingProfile.equalsIgnoreCase(FEDEX);

        return validate(isFedex, combineCheck, shipmentProtection, isShipPlanRequest, isBillingInformationNull, validation);
    }

    private static boolean validate(boolean isFedex, boolean combineCheck, boolean shipmentProtection, boolean isShipPlanRequest, boolean isBillingInformationNull, boolean validation) {
        if ((isFedex && ((combineCheck && shipmentProtection) ||
                (isShipPlanRequest && isBillingInformationNull && shipmentProtection)))
        || (!isFedex && ((isShipPlanRequest && isBillingInformationNull) || combineCheck)))
        {
            validation = true;
        }

        if (validation) {
            log.info(VALIDATION_SUCCESS);
        }
        return validation;
    }


    private Boolean checkShipmentProtection(Boolean aspValue, Boolean ocmValue) {
        if (aspValue == Boolean.TRUE) {
            return ocmValue.equals(true);
        }
        return true;
    }

    /**
     * This method validates if Shipment protection selected then it should have only 1 option
     *
     * @param isDeclaredValue Is Declared value selected
     * @param isOSPProtectionSelected Is OSP Protection value selected
     * @param isAddOnInsuranceUSPS Is add on insurance value selected
     */
    private void validateSelectedShipmentInsurance(Boolean isDeclaredValue, Boolean isOSPProtectionSelected,
                                                      Boolean isAddOnInsuranceUSPS) {
        int shipmentProtectionFlagCount = Boolean.TRUE.equals(isDeclaredValue) ? 1 : 0;
        shipmentProtectionFlagCount += Boolean.TRUE.equals(isOSPProtectionSelected) ? 1 : 0;
        shipmentProtectionFlagCount += Boolean.TRUE.equals(isAddOnInsuranceUSPS) ? 1 : 0;

        if (shipmentProtectionFlagCount > 1) {
            throw new ValidationException("Only 1 type of shipment protection is allowed, selected "
                    + shipmentProtectionFlagCount + " type of shipment protections");
        }
    }
}

