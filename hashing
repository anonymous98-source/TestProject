      String className,
      ListenerFactory factory,
      String subscription,
      String serviceName,
      String topic) {
    assertNotNull(subscription);

    GenericDlqListener subject =
        factory.create(dlqListenerConfig, subscription, googlePubsubConfig, dlqMessagePersister);

    ReflectionTestUtils.invokeMethod(subject, "receiveMessage", pubsubMessage);

