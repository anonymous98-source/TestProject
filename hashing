    ShipPlanResponse fetchShippingServiceOptionsResponse = new ShipPlanResponse();
    fetchShippingServiceOptionsResponse.setShipmentTransactionId(sendFlexResponse.getId());
    fetchShippingServiceOptionsResponse.setStatusCode(sendFlexResponse.getResult().getStatusCode());
    List<DeliveryDateDto> deliveryDates = new ArrayList<>();
    for (ShipViaOptionDTO option : sendFlexResponse.getShipViaOptions()) {

      DeliveryDateDto deliveryDate = new DeliveryDateDto();

      List<DeliverySlot> availableSlots = new ArrayList<>();
      if (option.getRates() != null) {
        for (RateDTO rate : option.getRates()) {
            addAvailableSlots(option, rate, deliveryDate, availableSlots);
        }
      }
      if (!availableSlots.isEmpty()) {
        deliveryDate.setAvailableSlots(availableSlots);
      }
      deliveryDates.add(deliveryDate);
    }

    List<DeliveryDateDto> sortedDeliveryDates = groupAndSortDeliveryDates(deliveryDates);

    fetchShippingServiceOptionsResponse.setDeliveryDates(sortedDeliveryDates);
    if (fetchShippingServiceOptionsResponse.getDeliveryDates().isEmpty()) {
      fetchShippingServiceOptionsResponse.setError("No carrier options available.");
    }

    return fetchShippingServiceOptionsResponse;
  }

    private static void addAvailableSlots(ShipViaOptionDTO option, RateDTO rate, DeliveryDateDto deliveryDate, List<DeliverySlot> availableSlots) {
        if (Objects.equals(rate.getType(), "Customer")) {
          DeliverySlot slot = new DeliverySlot();

          slot.setDescription(option.getDescription());
          slot.setShipViaCode(option.getCode());
          slot.setCarrierName(option.getCarrier());
          String dateTimeString = rate.getDeliverByDate();
          if (dateTimeString != null) {
            var dateTime = LocalDateTime.parse(dateTimeString);
            var date = dateTime.toLocalDate().toString();
            var time = dateTime.toLocalTime().toString();

            slot.setDeliveryTime(time);
            deliveryDate.setDeliveryDate(date);
          }

          slot.setDefaultSignatureLevel(DEFAULT_SIGNATURE_LEVEL_VALUE);
          slot.setZone(option.getZone());
          availableSlots.add(slot);
        }
    }

    public List<DeliveryDateDto> groupAndSortDeliveryDates(List<DeliveryDateDto> deliveryDates) {
      DateTimeFormatter formatter = DateTimeFormatter.ISO_DATE_TIME;

      Map<String, List<DeliverySlot>> groupedByDate = new LinkedHashMap<>();
      deliveryDates.stream()
              .filter(d -> d.getAvailableSlots() != null)
              .forEach(
                      d -> groupedByDate
                              .computeIfAbsent(d.getDeliveryDate(), k -> new ArrayList<>())
                              .addAll(d.getAvailableSlots()));
    return sortDeliveryDatesByDateAndTime(groupedByDate, formatter);
  }

  public List<DeliveryDateDto> sortDeliveryDatesByDateAndTime(
          Map<String, List<DeliverySlot>> groupedByDate, DateTimeFormatter formatter) {
    return groupedByDate.entrySet().stream()
            .map(entry -> {
              DeliveryDateDto date = new DeliveryDateDto();
              date.setDeliveryDate(entry.getKey());

              List<DeliverySlot> sortedSlots = entry.getValue().stream()
                      .sorted(Comparator.comparing(
                              slot -> {
                                if (entry.getKey() == null || slot.getDeliveryTime() == null) {
                                  return LocalDateTime.MAX;
                                }
                                try {
                                  return LocalDateTime.parse(
                                          entry.getKey() + "T" + slot.getDeliveryTime(), formatter);
                                } catch (DateTimeParseException e) {
                                  return LocalDateTime.MAX;
                                }
                              }))
                      .toList();

              date.setAvailableSlots(sortedSlots);
              return date;
            })
            .sorted(Comparator.comparing(
                    DeliveryDateDto::getDeliveryDate,
                    Comparator.nullsLast(Comparator.naturalOrder())))
            .toList();
  }

