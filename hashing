    @Test
    void groupAndSortDeliveryDates_invalidTimeFormat_sortedCorrectly() {
        // Arrange: one date with an unparseable time slot mixed with valid ones
        List<DeliveryDateDto> deliveryDates = new ArrayList<>();

        DeliveryDateDto date1 = new DeliveryDateDto();
        date1.setDeliveryDate("2023-10-01");
        List<DeliverySlot> slots = new ArrayList<>();

        DeliverySlot slot1 = new DeliverySlot();
        slot1.setDeliveryTime("10:00:00");
        slots.add(slot1);

        DeliverySlot slot2 = new DeliverySlot();
        slot2.setDeliveryTime("invalid-time");
        slots.add(slot2);

        DeliverySlot slot3 = new DeliverySlot();
        slot3.setDeliveryTime("08:00:00");
        slots.add(slot3);

        date1.setAvailableSlots(slots);
        deliveryDates.add(date1);

        // Act
        List<DeliveryDateDto> result = shipPlanDataMapperService.groupAndSortDeliveryDates(deliveryDates);

        // Assert: date is preserved
        assertEquals(1, result.size());
        assertEquals("2023-10-01", result.get(0).getDeliveryDate());

        // Assert: invalid-time slot sorts last (DateTimeParseException -> LocalDateTime.MAX),
        // valid slots sort ascending before it
        List<DeliverySlot> sortedSlots = result.get(0).getAvailableSlots();
        assertEquals(3, sortedSlots.size());
        assertEquals("08:00:00", sortedSlots.get(0).getDeliveryTime());
        assertEquals("10:00:00", sortedSlots.get(1).getDeliveryTime());
        assertEquals("invalid-time", sortedSlots.get(2).getDeliveryTime());
    }

