    public LocalDateTime getLocalDateTimeFromForCmsDateTime(String dateString, String timeZone) {
        if (StringUtils.isBlank(dateString) || StringUtils.isBlank(timeZone)) {
            return null;
        }
        var dateTimeFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
        try {
            return DateTimeUtil.toUtcLocalDateTime(LocalDateTime.parse(dateString, dateTimeFormatter),timeZone);
        } catch (Exception parseException) {
            log.atError()
                    .setMessage(
                            "DateTimeParseException raised while parsing cms date time to fetch local date time.")
                    .setCause(parseException)
                    .log();
            return null;
        }
    }

    public String checkEpic(ShipmentBookRequest shipmentBookRequest, boolean epicCustomer, PremiumFeatureResponse premiumFeatureResponse) {
        if (!Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorPlus())) {
            return NOT_PREMIUM_BG;
        }
        String skipReason;
        if (!epicCustomer) {
            return NOT_EPIC_CUSTOMER;
        }

            skipReason = VALIDATION_FAILURE;
            skipReason +=
                    StringUtils.isNotBlank(shipmentBookRequest.getPatientInformation().getPatientGender())
                            ? EMPTY_STRING : GENDER;
            skipReason +=
                    StringUtils.isNotBlank(shipmentBookRequest.getPatientInformation().getPatientDateOfBirth())
                            ? EMPTY_STRING : DOB;

        Set<String> fields = getFields(shipmentBookRequest);
        skipReason += StringUtils.join(fields, FORWARD_SLASH);
            if (skipReason.endsWith(FORWARD_SLASH)) skipReason = skipReason.substring(0, skipReason.length() - 1);
            if (skipReason.trim().equalsIgnoreCase(VALIDATION_FAILURE.trim())) skipReason = null;
            return skipReason;
    }

    private Set<String> getFields(ShipmentBookRequest shipmentBookRequest) {
        Set<String> fields = new HashSet<>();
        for (PackagingDetails pkg : shipmentBookRequest.getPackagingDetails()) {
            Reference reference = pkg.getReference();
            if (reference == null) {
                fields.add(ServiceCommonConstants.PRESCRIPTION_NUMBER);
                fields.add(ServiceCommonConstants.FILL_ID);
                break;
            }
            String[] prescriptionNumbers =
                    Optional.ofNullable(reference.getPrescriptionNumber())
                            .orElse(EMPTY_STRING)
                            .split(COMMA, -1);
            String[] fillIds =
                    Optional.ofNullable(reference.getFillId()).orElse(EMPTY_STRING).split(COMMA, -1);
            int lengthDiff = Math.max(prescriptionNumbers.length, fillIds.length);
            for (var i = 0; i < lengthDiff; i++) {
                addFields(i, prescriptionNumbers, fillIds, fields);
                if (fields.size() == 2) {
                    return fields;
                }
            }
        }
        return fields;
    }

    private void addFields(int i, String[] prescriptionNumbers, String[] fillIds, Set<String> fields) {
        String prescriptionNumber =
                i < prescriptionNumbers.length ? prescriptionNumbers[i].trim() : EMPTY_STRING;
        String fillId = i < fillIds.length ? fillIds[i].trim() : EMPTY_STRING;
        if (!StringUtils.isNotBlank(prescriptionNumber))
            fields.add(ServiceCommonConstants.PRESCRIPTION_NUMBER);
        if (!StringUtils.isNotBlank(fillId)) fields.add(ServiceCommonConstants.FILL_ID);
    }

