        if (uuid != null && !uuid.isEmpty() && !packaging.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE) && !pkgTypeRepository.existsById(UUID.fromString(packaging.getPackagingId()))) {
          packagesInfo = fetchPackageInfo(uuid);
          shippingUnit = buildShippingUnit(packagesInfo.orElse(null), packaging);
