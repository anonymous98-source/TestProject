    @Test
    void mapToDtoWithOperatorHierarchy_returnsAllRulesSortedByOperatorPriority() {
        // Arrange
        WeightRuleProjection rule1 = mock(WeightRuleProjection.class);
        WeightRuleProjection rule2 = mock(WeightRuleProjection.class);
        WeightRuleProjection rule3 = mock(WeightRuleProjection.class);
        UUID id1 = UUID.randomUUID();
        UUID id2 = UUID.randomUUID();
        UUID id3 = UUID.randomUUID();
        UUID profileId = UUID.randomUUID();
        // All have same value, different operators
        when(rule1.getValue()).thenReturn(50.0);
        when(rule2.getValue()).thenReturn(50.0);
        when(rule3.getValue()).thenReturn(50.0);
        when(rule1.getOperator()).thenReturn("<");
        when(rule2.getOperator()).thenReturn("<=");
        when(rule3.getOperator()).thenReturn(">");
        when(rule1.getId()).thenReturn(id1);
        when(rule2.getId()).thenReturn(id2);
        when(rule3.getId()).thenReturn(id3);
        when(rule1.getShippingProfileId()).thenReturn(profileId);
        when(rule2.getShippingProfileId()).thenReturn(profileId);
        when(rule3.getShippingProfileId()).thenReturn(profileId);
        List<WeightRuleProjection> projections = List.of(rule3, rule2, rule1); // Out of order
        Page<WeightRuleProjection> page = new PageImpl<>(projections);
        // Mock operator priority
        when(operatorPriorityResolver.sortByPriority(anyList())).thenAnswer(invocation -> {
            List<RuleDefinition> defs = invocation.getArgument(0);
            // Sort manually for test: <, <=, >
            return defs.stream().sorted(Comparator.comparingInt(rd -> {
                if ("<".equals(rd.getOperator())) return 1;
                if ("<=".equals(rd.getOperator())) return 2;
                if (">".equals(rd.getOperator())) return 5;
                return 99;
            })).toList();
        });
        // Act
        Page<ShippingRuleWeightResponseDto> result =
                shippingRuleWeightService.mapToDtoWithOperatorHierarchy(page);
        // Assert
        assertEquals(3, result.getContent().size());
        assertEquals("<", result.getContent().get(0).getOperator());
        assertEquals("<=", result.getContent().get(1).getOperator());
        assertEquals(">", result.getContent().get(2).getOperator());
        assertEquals(50.0, result.getContent().get(0).getValue());
        assertEquals(50.0, result.getContent().get(1).getValue());
        assertEquals(50.0, result.getContent().get(2).getValue());
    }

    @Test
    void mapToDtoWithOperatorHierarchy_multipleValues_groupsAndSortsEach() {
        // Arrange
        WeightRuleProjection rule1 = mock(WeightRuleProjection.class);
        WeightRuleProjection rule2 = mock(WeightRuleProjection.class);
        WeightRuleProjection rule3 = mock(WeightRuleProjection.class);
        when(rule1.getValue()).thenReturn(10.0);
        when(rule2.getValue()).thenReturn(20.0);
        when(rule3.getValue()).thenReturn(10.0);
        when(rule1.getOperator()).thenReturn("<");
        when(rule2.getOperator()).thenReturn(">");
        when(rule3.getOperator()).thenReturn("<=");
        when(rule1.getId()).thenReturn(UUID.randomUUID());
        when(rule2.getId()).thenReturn(UUID.randomUUID());
        when(rule3.getId()).thenReturn(UUID.randomUUID());
        when(rule1.getShippingProfileId()).thenReturn(UUID.randomUUID());
        when(rule2.getShippingProfileId()).thenReturn(UUID.randomUUID());
        when(rule3.getShippingProfileId()).thenReturn(UUID.randomUUID());
        List<WeightRuleProjection> projections = List.of(rule1, rule2, rule3);
        Page<WeightRuleProjection> page = new PageImpl<>(projections);
        when(operatorPriorityResolver.sortByPriority(anyList())).thenAnswer(invocation -> {
            List<RuleDefinition> defs = invocation.getArgument(0);
            // Sort: <, <=, >
            return defs.stream().sorted(Comparator.comparingInt(rd -> {
                if ("<".equals(rd.getOperator())) return 1;
                if ("<=".equals(rd.getOperator())) return 2;
                if (">".equals(rd.getOperator())) return 5;
                return 99;
            })).toList();
        });
        // Act
        Page<ShippingRuleWeightResponseDto> result = shippingRuleWeightService.mapToDtoWithOperatorHierarchy(page);
        // Assert
        assertEquals(3, result.getContent().size());
        // 10.0 group: <, <=
        assertEquals(10.0, result.getContent().get(0).getValue());
        assertEquals("<", result.getContent().get(0).getOperator());
        assertEquals(10.0, result.getContent().get(1).getValue());
        assertEquals("<=", result.getContent().get(1).getOperator());
        // 20.0 group: >
        assertEquals(20.0, result.getContent().get(2).getValue());
        assertEquals(">", result.getContent().get(2).getOperator());
    }

