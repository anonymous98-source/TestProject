  String epicChecks(ShipmentBookRequest shipmentBookRequest, boolean isEpicCustomer, PremiumFeatureResponse premiumFeatureDetails) {
    if (!Boolean.TRUE.equals(premiumFeatureDetails.getNavigatorPlus())) {
      // If BG doesn't have navigator plus then add that as an epic skip reason
      return NOT_PREMIUM_BG;
    }
    String reason;
    if (isEpicCustomer) {
      reason = VALIDATION_FAILURE;
      reason +=
          StringUtils.isBlank(shipmentBookRequest.getPatientInformation().getPatientDateOfBirth())
              ? DOB
              : EMPTY_STRING;
      reason +=
          StringUtils.isBlank(shipmentBookRequest.getPatientInformation().getPatientGender())
              ? GENDER
              : EMPTY_STRING;

      Set<String> invalidFieldsSet = new HashSet<>();
      checkForMissingFills(shipmentBookRequest, invalidFieldsSet);
      reason += StringUtils.join(invalidFieldsSet, FORWARD_SLASH);
      if (reason.endsWith(FORWARD_SLASH)) reason = reason.substring(0, reason.length() - 1);
      if (reason.trim().equalsIgnoreCase(VALIDATION_FAILURE.trim())) reason = null;
    } else {
      reason = NOT_EPIC_CUSTOMER;
    }
    return reason;
  }

  private static void checkForMissingFills(
      ShipmentBookRequest shipmentBookRequest, Set<String> invalidFieldsSet) {
    shipmentBookRequest.getPackagingDetails().stream()
        .takeWhile(pd -> invalidFieldsSet.size() < 2)
        .map(PackagingDetails::getReference)
        .forEach(
            reference -> {
              if (Objects.isNull(reference)) {
                invalidFieldsSet.add(FILL_ID);
                invalidFieldsSet.add(PRESCRIPTION_NUMBER);
              } else {
                String[] prescriptionNumbers =
                    Optional.ofNullable(reference.getPrescriptionNumber())
                        .orElse(EMPTY_STRING)
                        .split(COMMA, -1);
                String[] fillIds =
                    Optional.ofNullable(reference.getFillId())
                        .orElse(EMPTY_STRING)
                        .split(COMMA, -1);
                int maxLength = Math.max(fillIds.length, prescriptionNumbers.length);
                checkIndividualFills(invalidFieldsSet, maxLength, fillIds, prescriptionNumbers);
              }
            });
  }

  private static void checkIndividualFills(
      Set<String> invalidFieldsSet, int maxLength, String[] fillIds, String[] prescriptionNumbers) {
    for (var i = 0; i < maxLength; i++) {
      String fillId = i < fillIds.length ? fillIds[i].trim() : EMPTY_STRING;
      String prescriptionNumber =
          i < prescriptionNumbers.length ? prescriptionNumbers[i].trim() : EMPTY_STRING;
      if (StringUtils.isBlank(prescriptionNumber)) invalidFieldsSet.add(PRESCRIPTION_NUMBER);
      if (StringUtils.isBlank(fillId)) invalidFieldsSet.add(FILL_ID);
      if (invalidFieldsSet.size() == 2) {
        break;
      }
    }
  }

