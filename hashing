     *
     * @param request - the payload containing the new address details
     * @param userName - the user's username
     * @return AddNewAddressSuccessResponse -  DTO containing the status and message of the operation
     */
    @Override
    public AddressAddSuccessResponse addNewAddress(AddressBookRequest request, String userName) {
        log.atInfo()
                        .setMessage("service method to add new address in the addressbook")
                        .log();
        validateAddRequestFacilityId(request,userName);
        ShipToAddressFacilityMapping shipToAddressFacilityMapping = createShipToAddressFacilityMappingEntity(request);
        ShipToAddressFacilityMapping savedMapping;

        savedMapping = shipToAddressFacilityMappingRepository.save(shipToAddressFacilityMapping);

        log.atInfo()
                        .setMessage("New address successfully added in the addressbook")
