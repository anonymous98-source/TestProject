     *
     * @param uuidToConvert the UUID string to be validated and converted
     * @return the validated and converted UUID object
     * @throws ValidationException if the input string is null, empty, or not in a valid UUID format
     */
    private UUID validateAndConvertUUID(final String uuidToConvert, String operationType, String fieldName) {
        // If UUID is not present in request then throw Validation Exception
        if (!StringUtils.hasText(uuidToConvert)) {
            throw new ValidationException("For " + operationType + " request, " + fieldName + " is mandatory");
        }

        // Check for valid UUID
        final UUID validatedUUID;
        try {
            validatedUUID = UUID.fromString(uuidToConvert);
        } catch (Exception e) {
            throw new ValidationException("Invalid " + fieldName + " format in " + operationType + " request");
        }
        return validatedUUID;
    }


    /**
     * Delete facility mapping record with provided ID
