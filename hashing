import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.HASH_DELIMITER;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.NUMBER_TYPE;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.SHIP_VIA;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.STRING_TYPE;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.VALUE;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.WEIGHT;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.ZIP_CODE;
