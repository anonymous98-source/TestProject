  public NewShipmentDto formShipmentDtoWhenCmsForTrackingApi(
      CmsBookResponse cmsBookResponse,
      ShipmentBookRequest shipmentBookRequest,
      UserDto userDto,
      Map<String, String> customerDetails,
      String customShipmentId,
      UserDefaultsResponse userDefaultsResponse,
      PremiumFeatureResponse premiumFeatureResponse) {

    NewShipmentDto.NewShipmentDtoBuilder newShipmentDtoBuilder = NewShipmentDto.builder();

    // set user details to Shipment
    if (userDto != null) {
      setUserDetailsToShipment(newShipmentDtoBuilder, userDto);
    }

    if (Objects.nonNull(cmsBookResponse.getDeliveryAddress()))
      buildShipToAddress(
              shipmentBookRequest.getShipToAddress(),
              cmsBookResponse.getDeliveryAddress(),
              newShipmentDtoBuilder);
    if (Objects.nonNull(cmsBookResponse.getPickupAddress()))
      buildShipFromAddress(
              shipmentBookRequest.getShipFromAddress(),
              cmsBookResponse.getPickupAddress(),
              newShipmentDtoBuilder);

    // IsEpicCustomer check and EPIC mandatory fields validation
    boolean epicCustomer = Boolean.TRUE.equals(userDefaultsResponse.getData().getIsEpicCustomer());
    String epicSkipReason =
            advShippingCommonDataPersistService.checkEpic(shipmentBookRequest, epicCustomer, premiumFeatureResponse);
    newShipmentDtoBuilder.isEpicCustomer(epicCustomer);

    newShipmentDtoBuilder.shipmentTransactionId(customShipmentId);

    newShipmentDtoBuilder.isDefaultShipFromAddress(shipmentBookRequest.isDefaultShipFromAddress());
    addShipmentSummaryDetailsForCMS(
            shipmentBookRequest, cmsBookResponse, newShipmentDtoBuilder, customerDetails);
    mapPhoneNumberExtension(shipmentBookRequest, newShipmentDtoBuilder); // map phone number extension for both ship to and ship from

    advShippingCommonDataPersistService.addBillingInformationToNewShipmentDto(
            shipmentBookRequest, newShipmentDtoBuilder);
    NewShipmentDto newShipmentDto = newShipmentDtoBuilder.build();

    // set List of Packages into Shipment
    setPackagesToShipment(cmsBookResponse, shipmentBookRequest, newShipmentDto, epicSkipReason);

    // ShippingProfile Details Setting
    setShippingProfileDetails(newShipmentDto, shipmentBookRequest);

    // set monarchUserId to shipment to store into shipment table in tracking-resource
    if (userDto != null){
      newShipmentDto.setUserId(userDto.getMonarchUserId());
      newShipmentDto.setUserEmail(userDto.getUserEmail());
      newShipmentDto.setUserFirstName(userDto.getFirstName());
      newShipmentDto.setUserLastName(userDto.getLastName());
    }
    if(shipmentBookRequest.getSourceSystem()!=null && shipmentBookRequest.getSourceSystem().equalsIgnoreCase(SOURCE_NAVIGATOR_API)) {
      newShipmentDto.setApplicationSource(SHIPMENT_APPLICATION_SOURCE_NAVIGATOR_API);
    }
    else{
      newShipmentDto.setApplicationSource(SHIPMENT_APPLICATION_SOURCE_NAVIGATOR_UI);
    }
    newShipmentDto.setAdditionalServiceShipmentDto(
        buildAdditionalServiceShipment(shipmentBookRequest,Boolean.FALSE));

    newShipmentDto.setShipViaCode(
            Optional.ofNullable(shipmentBookRequest.getPatientInformation())
                    .map(PatientInformation::getShipVia)
                    .orElse(null));
    newShipmentDto.setNeedsByDate(getNeedsByDate(shipmentBookRequest));

    newShipmentDto.setSuggestedAddressUsage(shipmentBookRequest.getSuggestedAddressUsage());
    newShipmentDto.setSuggestedResidentialFlagUsage(shipmentBookRequest.getSuggestedResidentialFlagUsage());
    newShipmentDto.setRuleId(shipmentBookRequest.getRuleId());
    newShipmentDto.setRuleLogId(shipmentBookRequest.getRuleLogId());

    return newShipmentDto;
  }

  private AdditionalServiceShipmentDto buildAdditionalServiceShipment(
      ShipmentBookRequest shipmentBookRequest,
      Boolean saturdaySchedulePossible) {
    Optional<AdditionalAccessorial> additionalAccessorial =
        Optional.ofNullable(shipmentBookRequest.getAdditionalAccessorial());

    return AdditionalServiceShipmentDto.builder()
        .saturdayPickup(saturdaySchedulePossible)
        .saturdayDelivery(
            additionalAccessorial.map(AdditionalAccessorial::isSaturdayDelivery).orElse(null))
        .readyTime(
            advShippingCommonDataPersistService.getReadyTime(
                shipmentBookRequest.getAdditionalAccessorial()))
        .latestTime(
            advShippingCommonDataPersistService.getLatestTime(
                shipmentBookRequest.getAdditionalAccessorial()))
        .signatureLevel(
            advShippingCommonDataPersistService.getSignatureLevelIfExist(shipmentBookRequest))
        .signatureRequired(
            additionalAccessorial.map(AdditionalAccessorial::isSignatureRequired).orElse(null))
        .interventionService(
            additionalAccessorial.map(AdditionalAccessorial::getInterventionService).orElse(null))
        .shippingProfileTags(
            additionalAccessorial.map(AdditionalAccessorial::getShippingProfileTags).orElse(null))
        .build();
  }

  private void setUserDetailsToShipment(
      NewShipmentDto.NewShipmentDtoBuilder newShipmentDtoBuilder, UserDto userDto) {
    newShipmentDtoBuilder
        .userId(userDto.getMonarchUserId())
        .userEmail(userDto.getUserEmail())
        .userFirstName(userDto.getFirstName())
        .userLastName(userDto.getLastName());
  }

  private void setPackagesToShipment(
      CmsBookResponse cmsBookResponse,
      ShipmentBookRequest shipmentBookRequest,
      NewShipmentDto newShipmentDto,
      String epicSkipReason) {

    List<OrderPackageItemResponse> orderPackageItemResponses =
        cmsBookResponse.getOrderPackageItems();
    List<PackagingDetails> packagingDetailsList = shipmentBookRequest.getPackagingDetails();

    List<ShipmentPackageDto> packageList =
        IntStream.range(0, orderPackageItemResponses.size())
            .mapToObj(
                index ->
                    buildPackage(
                        orderPackageItemResponses.get(index),
                        packagingDetailsList.get(index),
                        shipmentBookRequest,
                        cmsBookResponse,
                        epicSkipReason))
            .toList();

    newShipmentDto.setShipmentPackageDtos(packageList);
  }

  private ShipmentPackageDto buildPackage(
      OrderPackageItemResponse orderPackageItemResponse,
      PackagingDetails packagingDetails,
      ShipmentBookRequest shipmentBookRequest,
      CmsBookResponse cmsBookResponse,
      String epicSkipReason) {

    Reference reference =
        Objects.nonNull(packagingDetails.getReference())
            ? packagingDetails.getReference()
            : new Reference();
      String packageNickname = packagingDetails.getPackaging().getPackageNickname();
    ShipmentPackageDto pkg =
        ShipmentPackageDto.builder()
            .packageName(packagingDetails.getPackaging().getPackagingType())
            .packageProfileId(UUID.fromString(packagingDetails.getPackaging().getPackagingId()))
            .packageLength(orderPackageItemResponse.getLength())
            .packageWidth(orderPackageItemResponse.getWidth())
            .packageHeight(orderPackageItemResponse.getHeight())
            .packageWeight(orderPackageItemResponse.getWeight())
            .packageDimUnit(packagingDetails.getPackaging().getDimensionUOM())
            .packageWeightUnit(packagingDetails.getPackaging().getWeightUOM())
            .packageDryIceWeight(isDryIcePresent(packagingDetails))
            .cmsRefNo(orderPackageItemResponse.getRefNo())
            .packageLabelReference1(orderPackageItemResponse.getRefNo())
            .packageLabelReference2(orderPackageItemResponse.getRefNo2())
            .packageLabelReference3(orderPackageItemResponse.getRefNo3())
            .packageLabelReference4(orderPackageItemResponse.getRefNo4())
            .internalDesignationReference(reference.getInternalDesignationReference())
            .specialInstructions(
                Objects.nonNull(shipmentBookRequest.getAdditionalAccessorial())
                    ? shipmentBookRequest.getAdditionalAccessorial().getSpecialInstructions()
                    : null)
            .pharmacyOrderNumber(reference.getPharmacyOrderNumber())
            .packageNickName(packageNickname)
            .isCustomPackage(packagingDetails.getPackaging().isCustomPackage())
            .innerLength(packagingDetails.getPackaging().getInnerLength())
            .innerWidth(packagingDetails.getPackaging().getInnerWidth())
            .innerHeight(packagingDetails.getPackaging().getInnerHeight())
            .ratedLength(packagingDetails.getPackaging().getRatedLength())
            .packagePackagingType(packagingDetails.getPackaging().getPackagePackagingType())
            .packageBrand(packagingDetails.getPackaging().getPackageBrand())
            .packageProductName(packagingDetails.getPackaging().getPackageProductName())
            .packageDescription(packagingDetails.getPackaging().getPackageDescription())
            .packageModelIdentifier(packagingDetails.getPackaging().getPackageModelIdentifier())
            .build();

    // set additional service package details
    pkg.setPackageAdditionalDetails(
        buildAdditionalServicePackage(packagingDetails, shipmentBookRequest, true));

    // set external reference
    PackageExternalReferenceDto externalReferenceDto =
        getPackageExternalReference(
            packagingDetails.getReference(), shipmentBookRequest.getPatientInformation());
    pkg.setPackageExternalReferenceDto(externalReferenceDto);

    // set tracking details
    ShipmentPackageTracking tracking =
        buildShipmentPackageTracking(cmsBookResponse, shipmentBookRequest, epicSkipReason);
    pkg.setShipmentPackageTracking(tracking);
    return pkg;
  }

  private ShipmentPackageTracking buildShipmentPackageTracking(
      CmsBookResponse cmsBookResponse,
      ShipmentBookRequest shipmentBookRequest,
      String epicSkipReason) {

    var lastUpdatedAt = LocalDateTime.now(ZoneOffset.UTC);
    ShipmentPackageTracking tracking =
        ShipmentPackageTracking.builder()
            .trackingNumber(String.valueOf(cmsBookResponse.getOrderTrackingID()))
            .labelType(cmsBookResponse.getLabelType())
            .labelContent(cmsBookResponse.getLabelData())
            .shipDate(
                advShippingCommonDataPersistService.getLocalDateTimeFromForCmsDateTime(
                    cmsBookResponse.getPickupTargetTo(),
                    cmsBookResponse.getPickupAddress().getTimeZone()))
            .expectedDeliveryDate(
                advShippingCommonDataPersistService.getLocalDateTimeFromForCmsDateTime(
                    cmsBookResponse.getDeliveryTargetTo(),
                    cmsBookResponse.getDeliveryAddress().getTimeZone()))
            .trackingUrl(
                advShippingCommonDataPersistService.getTrackingUrl(
                    cmsBookResponse.getOrderTrackingID(), cmsBookResponse.getTrackingKey()))
            .trackingLastScanLocation(
                advShippingCommonDataPersistService.getScanLocation(cmsBookResponse))
            .trackingLastUpdatedAt(lastUpdatedAt)
            .trackingLastStatus(TrackingStatusCode.LABEL_CREATED.getStatus())
            .trackingLastMessage(LABEL_GENERATED)
            .epicSkipReason(epicSkipReason)
            .trackingDataSource(TRACKING_DATA_SOURCE_CMS)
            .applicationSource(APPLICATION_SOURCE_NAVIGATOR)
            .build();

    List<ShipmentTrackingEventDto> shipmentTrackingEventDtoList =
        getShipmentTrackingEventList(lastUpdatedAt, shipmentBookRequest, true, cmsBookResponse);

    tracking.setShipmentTrackingEventDtoList(shipmentTrackingEventDtoList);

    if (Objects.nonNull(shipmentBookRequest.getAdditionalAccessorial())
        && (shipmentBookRequest.getAdditionalAccessorial().isSubscribeToEmailUpdate()
            || Objects.nonNull(
                shipmentBookRequest.getAdditionalAccessorial().getSmsNotification()))) {

      tracking.setNotifications(
          advShippingCommonDataPersistService.buildNotifications(shipmentBookRequest));
    }
    return tracking;
  }

  private void addShipmentSummaryDetailsForCMS(
      ShipmentBookRequest shipmentBookRequest,
      CmsBookResponse cmsBookResponse,
      NewShipmentDto.NewShipmentDtoBuilder newShipmentDtoBuilder,
      Map<String, String> customerDetails) {

    newShipmentDtoBuilder.shipmentExpectedPickupDatetime(
        advShippingCommonDataPersistService.getLocalDateTimeFromForCmsDateTime(
            cmsBookResponse.getPickupTargetTo(), cmsBookResponse.getPickupAddress().getTimeZone()));
    newShipmentDtoBuilder.shipmentExpectedDeliveryDatetime(
        advShippingCommonDataPersistService.getLocalDateTimeFromForCmsDateTime(
            cmsBookResponse.getDeliveryTargetTo(),
            cmsBookResponse.getDeliveryAddress().getTimeZone()));

    newShipmentDtoBuilder.shipmentServiceLevel(
        advShippingCommonDataPersistService.getShipmentServiceLevel(shipmentBookRequest));
    newShipmentDtoBuilder.shipmentCarrierDetails(COURIER);
    newShipmentDtoBuilder.facilityId(getUuidFromString(shipmentBookRequest.getFacilityId()));
    newShipmentDtoBuilder.facilityName(customerDetails.get(FACILITY_NAME_STRING));
    newShipmentDtoBuilder.customerId(getUuidFromString(customerDetails.get(CUSTOMERID)));
