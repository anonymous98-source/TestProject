package com.cardinalhealth.adv.shipping.integration.api.customer.client;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.COST_CENTER_PATH_PARAM;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.FACILITY_ID_PATH_PARAM;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.FACILITY_ID_STRING;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.USER_EMAIL_QUERY_PARAM;
import static java.util.Collections.emptyList;

import com.cardinalhealth.adv.shipping.integration.api.config.AdvShippingIntegrationApiProperties;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.CostCenterDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.CustomerHierarchyDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.request.CustomerHierarchyRequestDto;
import java.net.URI;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import lombok.RequiredArgsConstructor;
import org.springframework.context.annotation.Primary;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.reactive.function.client.WebClientResponseException;
import org.springframework.web.util.DefaultUriBuilderFactory;
import reactor.core.publisher.Mono;

@Component
@Primary
@RequiredArgsConstructor
public class RestCustomerWebClientImpl implements CustomerWebClient {

  private final WebClient webClient;
  private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;

  @Override
  public CustomerHierarchyDto getCustomerHierarchy(
      CustomerHierarchyRequestDto customerHierarchyRequestDto) {
    return webClient
            .post()
            .uri(getCustomerHierarchyURI())
            .accept(MediaType.APPLICATION_JSON)
            .contentType(MediaType.APPLICATION_JSON)
            .bodyValue(customerHierarchyRequestDto)
            .retrieve()
            .bodyToMono(CustomerHierarchyDto.class)
            .block();
  }

  @Override
  public List<CostCenterDto> getCostCenters(UUID facilityId, String userEmail) {
    ParameterizedTypeReference<List<CostCenterDto>> typeRef =
            new ParameterizedTypeReference<List<CostCenterDto>>() {};
    return webClient
        .get()
        .uri(getCostCenterURI(facilityId, userEmail))
        .retrieve()
        .bodyToMono(typeRef)
        .onErrorResume(
            WebClientResponseException.class,
            e -> e.getStatusCode().value() == 404 ? Mono.just(emptyList()) : Mono.error(e))
        .block();
  }

  private URI getCostCenterURI(UUID facilityId, String userEmail) {
    return new DefaultUriBuilderFactory()
        .uriString(advShippingIntegrationApiProperties.getCustomerEdgeApiBaseUrl())
        .pathSegment("v2", COST_CENTER_PATH_PARAM, FACILITY_ID_PATH_PARAM)
        .path("/{facilityId}")
        .queryParam(USER_EMAIL_QUERY_PARAM, userEmail)
        .build(Map.of(FACILITY_ID_STRING, facilityId.toString()));
  }

  private URI getCustomerHierarchyURI() {
    return new DefaultUriBuilderFactory()
            .uriString(advShippingIntegrationApiProperties.getCustomerEdgeApiBaseUrl())
            .pathSegment("customer-hierarchy")
            .build();
  }
}

