  public NewShipmentDto formShipmentDtoForTrackingApi(
      ShipmentBookResponseDto shipmentBookResponseDto,
      ShipmentBookRequest shipmentBookRequest,
      UserDto userDto,
      Map<String, String> customerDetails,
      List<UserDefaultsResponse> data,
      AdditionalShipBookData additionalShipBookData) {

    NewShipmentDto.NewShipmentDtoBuilder newShipmentDtoBuilder = NewShipmentDto.builder();

    if(userDto !=null){
      setUserDetailsToShipment(newShipmentDtoBuilder, userDto);
    }
    // Check whether Epic Customer and EPIC mandatory fields validation
    boolean isEpicCustomer = Boolean.TRUE.equals(data.get(0).getData().getIsEpicCustomer());
    Boolean defaultAddress = data.get(0).getData().getShipmentAddress().getDefaultAddress();
    List<AddressResponseDto> addresses = shipmentBookResponseDto.getAddresses();

    newShipmentDtoBuilder.isEpicCustomer(isEpicCustomer);
    if (shipmentBookResponseDto.getResult().getActionType().equalsIgnoreCase(RETURN_VALUE)) {
        newShipmentDtoBuilder.returnType(shipmentBookRequest.getGenerateLabelReturnType());
    }

    //set profile code
    newShipmentDtoBuilder.profileCode(shipmentBookResponseDto.getProfileCode());

    String epicSkipReason = epicChecks(shipmentBookRequest, isEpicCustomer, additionalShipBookData.getPremiumFeatureResponse());
    ShipmentHalAddressDetailsDto shipToHalAddress = ShipmentHalAddressDetailsDto.builder().build();
    for (AddressResponseDto address : addresses) {

      String addressType = address.getType();
      if (addressType.equals(RECEIVER)) {
        buildShipToAddress(address, newShipmentDtoBuilder, shipToHalAddress);
      } else if (addressType.equals(SENDER)) {
        buildShipFromAddress(address, newShipmentDtoBuilder);
      }
      else if (addressType.equals(HOLDLOCATION)){
        buildHoldLocationAddress(address, newShipmentDtoBuilder, shipToHalAddress);
      }
    }

    addShipmentSummaryDetails(
        shipmentBookRequest, shipmentBookResponseDto, newShipmentDtoBuilder, customerDetails);
    mapPhoneNumberExtension(shipmentBookRequest, newShipmentDtoBuilder); // map phone number extension for both ship to and ship from

    // adding billing information
    addBillingInformation(shipmentBookRequest, newShipmentDtoBuilder);
    if (shipmentBookResponseDto.getResult().getActionType().equalsIgnoreCase(RETURN_VALUE)) {
      newShipmentDtoBuilder.referenceTrackingNumber(
          shipmentBookRequest.getBillingInformation().getOriginalShipmentTrackingNumber());
    }

    // build NewShipmentDto object and then will set rest of the nested dto
    NewShipmentDto newShipmentDto = newShipmentDtoBuilder.build();

    // set flag for whether this is defaultFromAddress
    newShipmentDto.setIsDefaultShipFromAddress(defaultAddress);
    newShipmentDto.setShipToAddressValidated(
        shipmentBookRequest.getShipToAddress().getAddressData().isAddressValidated());

    newShipmentDto.setShipmentSource(SHIPMENT_SOURCE_ASP_NAVIGATOR);
    // set List of Packages into Shipment
    setMultiPackagesToShipment(
        shipmentBookResponseDto, shipmentBookRequest, newShipmentDto, epicSkipReason);

    // ShippingProfile Details Setting
    setShippingProfileDetails(newShipmentDto, shipmentBookRequest);

    // set additional service shipment
    newShipmentDto.setAdditionalServiceShipmentDto(
        buildAdditionalServiceShipment(shipmentBookRequest, additionalShipBookData.getSaturdaySchedulePossible()));

    newShipmentDto.setShipViaCode(
            Optional.ofNullable(shipmentBookRequest.getPatientInformation())
                    .map(PatientInformation::getShipVia)
                    .orElse(null));
    newShipmentDto.setNeedsByDate(getNeedsByDate(shipmentBookRequest));
    newShipmentDto.setZone(shipmentBookRequest.getShipViaOptions().get(0).getZone());
    newShipmentDto.setRuleId(shipmentBookRequest.getRuleId());
    newShipmentDto.setRuleLogId(shipmentBookRequest.getRuleLogId());
    // end of forShipmentDto method
    return newShipmentDto;
  }

