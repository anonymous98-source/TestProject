  private void setPremiumFeatureDetails(ShipmentResourceDto shipmentResourceDto, PremiumFeatureResponse premiumFeatureDetails) {

    // Beacon Level
    if (Boolean.TRUE.equals(premiumFeatureDetails.getBeaconPlus())) {
      shipmentResourceDto.setBeaconLevel(ServiceCommonConstants.BEACON_PLUS);
    } else {
      shipmentResourceDto.setBeaconLevel(ServiceCommonConstants.BEACON);
    }

    // Navigator Level
    if (Boolean.TRUE.equals(premiumFeatureDetails.getNavigatorPlus())) {
      shipmentResourceDto.setNavigatorLevel(ServiceCommonConstants.NAVIGATOR_PLUS);
    } else {
      shipmentResourceDto.setNavigatorLevel(ServiceCommonConstants.NAVIGATOR);
    }

    // Set SMS notification configuration
    shipmentResourceDto.setSmsNotificationEnabledConfig(Boolean.TRUE.equals(premiumFeatureDetails.getSmsNotificationsEnabled()));
    shipmentResourceDto.setObtainConsentForSmsNotificationConfig(
            Boolean.TRUE.equals(premiumFeatureDetails.getObtainConsentForSMSNotification()));
  }


  public Boolean publish(ShipmentDto shipmentDto) throws JsonProcessingException {
   log.atInfo()
            .setMessage("Starting publish process to Epic")
            .log();

    var isSuccess = new AtomicBoolean(true);
    String message = objectMapper.writeValueAsString(shipmentDto);
    ApiFuture<String> publishFuture = messagingPublisher.publish(ADV_SHIPPING_TOPIC, message);
      log.atDebug().setMessage("ShipBookPublisherServiceImpl - Message published")
              .addKeyValue("topicName", ADV_SHIPPING_TOPIC)
              .addKeyValue("message", message)
              .log();

    publishFuture.addListener(
        () -> {
          try {
            log.atInfo()
                    .setMessage("Message Published Successfully")
                    .log();
          } catch (Exception e) {
            isSuccess.set(false);
            log.error("Failed to publish message", e);
          }
        },
        Executors.newSingleThreadExecutor());
      log.atInfo()
              .addKeyValue(PUBLISH_STATUS, isSuccess.get())
              .setMessage("Publish process finished with status")
              .log();
    return isSuccess.get();
  }

}

