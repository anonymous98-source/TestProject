import org.springframework.stereotype.Component;
import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Component
public class RuleContextExtractorRegistry {

    private final Map<RuleType, RuleContextExtractor<?>> extractors;

    public RuleContextExtractorRegistry(List<RuleContextExtractor<?>> listOfExtractors) {
        this.extractors = listOfExtractors.stream()
                .collect(Collectors.toMap(
                        RuleContextExtractor::supports, Function.identity()
                ));
    }

    @SuppressWarnings("unchecked")
    public <T extends RuleContext> T extract(RuleType ruleType, Map<String, Object> rawContext) {
        RuleContextExtractor<?> extractor = extractors.get(ruleType);
        if (extractor == null) {
            throw new IllegalArgumentException("No extractor found for rule type: " + ruleType);
        }
        return (T) extractor.extract(rawContext);
    }
}

