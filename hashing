                .requestObject(requestDto)
                .statusCode(SUCCESS)
                .responseObject(responseDto)
                .sendflexTxid(shipmentTransactionId)
                .apiCode(apiCode)
                .responseTime(responseTime)
                .build();

        return saveSendflexRecord(sendFlexRecordDto);
    }

    public <T> SendFlexRecordDto saveSendFlexRecordDtoForFailure(
            T requestDto,
            String shipmentTransactionId,
            String flowType,
            Exception e,
            Long responseTime) {

        ObjectMapper mapper = new ObjectMapper();
        JsonNode responseJson;
        String errorResponseBody = "";
        if (e instanceof ValidationException validationException) {
            errorResponseBody = validationException.getErrorResponseBody();
        } else if (e.getMessage() != null) {
            errorResponseBody = getExceptionMessage(e);
        } else {
            log.atError().setMessage("No error body found").log();
        }
        try {
            responseJson = mapper.readTree(errorResponseBody);
        } catch (Exception ex) {
            // Fallback: treat errorResponseBody as plain text and wrap in quotes to make it valid JSON
            responseJson = ObjectMapperUtils.convertStringToJsonNodeWithException("\"" + errorResponseBody.replace("\"", "\\\"") + "\"");
            log.atError().setMessage("An error occurred while parsing the error response: " + errorResponseBody).log();
        }

        String apiCode = getApiCode(flowType);

        SendFlexRecordDto sendFlexRecordDto = SendFlexRecordDto.builder()
                .requestObject(requestDto)
                .statusCode(FAILURE)
                .responseObject(responseJson)
                .sendflexTxid(shipmentTransactionId)
                .apiCode(getApiCode(flowType))
                .responseTime(responseTime)
                .build();
        return saveSendflexRecord(sendFlexRecordDto);
    }

    private  String getApiCode(String flowType){
       return switch (flowType) {
            case BOOK -> SHIPMENT_BOOK_API_CODE;
            case RETURN -> SHIPMENT_RETURN_SUB_URI;
            case PLAN -> SHIPMENT_PLAN_SUB_URI;
            case VOID -> SHIPMENT_VOID_SUB_URI;
            case POD -> TRACKING_POD_URI;
            case QUEUE_SCHEDULE -> QUEUE_SCHEDULE_SUB_URI;
           case HOLD_AT_LOCATION -> HOLD_AT_LOCATION_SUB_URI;
            default -> null;
       };
    }

    private String getExceptionMessage(Exception e) {
        String detailMessage = e.getMessage();
        Throwable cause = e.getCause();
        String causeMessage = (cause != null) ? cause.getMessage() : "";
        return detailMessage + causeMessage;
    }

