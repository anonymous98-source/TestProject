  private final ShippingProfileServiceImpl shippingProfileServiceImpl;
  private final ShippingProfileRepository shippingProfileRepository;
  private final PackageTypeRepository packageTypeRepository;
  private final TagMappingRepository tagMappingRepository;
  private final HcidRepository hcidRepository;

  public void validateShippingProfileDetails(
      @Valid ShipmentBookRequest shipmentBookRequest,
      PremiumFeatureResponse premiumFeatureResponse) {

    UUID shippingProfileId = UUID.fromString(shipmentBookRequest.getShippingProfileId());
    validateShippingProfileId(shippingProfileId);

    // Set EpicWillow
    setEpicWillow(shipmentBookRequest, premiumFeatureResponse);

    // Set Navigator
    setNavigator(shipmentBookRequest, premiumFeatureResponse);

    // Set Beacon
    setBeacon(shipmentBookRequest, premiumFeatureResponse);

    // Intervention
    validateIntervention(shipmentBookRequest, premiumFeatureResponse);

    // SmsNotificationValueValidation
    validateSmsValues(shipmentBookRequest, premiumFeatureResponse);

    if (Boolean.TRUE.equals(shipmentBookRequest.getIsCustomShippingProfile())) {
      validateRequiredFields(
          shipmentBookRequest.getShippingProfileName(), "Shipping profile name cannot be null");
      validateRequiredFields(
          shipmentBookRequest.getShippingProfileIcon(), "Shipping profile icon cannot be null");
      validateRequiredFields(
          shipmentBookRequest.getShippingProfileColor(), "Shipping profile color cannot be null");

      if (Objects.isNull(shipmentBookRequest.getAdditionalAccessorial())) {
        shipmentBookRequest.setAdditionalAccessorial(AdditionalAccessorial.builder().build());
      }

      // ShippingProfileTags
      setShippingTags(shipmentBookRequest, shippingProfileId);
    }

    // PackageTypeDetails
    List<UUID> packageIds = getPackageIds(shipmentBookRequest);
    Map<UUID, PackageType> packageTypesMap = prepareIdPackageTypeMap(packageIds);
    List<TagMapping> packagesTagMappings =
        tagMappingRepository.findAllByEntityTypeAndEntityIdIn(
            PACKAGE, new ArrayList<>(packageTypesMap.keySet()));

    List<HCIDCode> hcidCodes = new ArrayList<>();

    shipmentBookRequest
        .getPackagingDetails()
        .forEach(
            packagingDetails -> {
              Packaging packaging = packagingDetails.getPackaging();
              if (Boolean.TRUE.equals(packaging.isCustomPackage())) {
                UUID packageTypeId = UUID.fromString(packaging.getPackagingId());

                validateInnerDimensions(packaging);

                PackageType packageType = packageTypesMap.get(packageTypeId);

                setPackageTypeDetails(packaging, packageType);

                // PackageTags
                List<TagMapping> packageTagMapping =
                    packagesTagMappings.stream()
                        .filter(tagMapping -> packageTypeId.equals(tagMapping.getEntityId()))
                        .toList();
                packaging.setPackageTags(getTagNames(packageTagMapping));
              }

              // Add all HCIDs to a list
              if (neitherNullNorEmpty(packaging.getHcidCode()))
                hcidCodes.addAll(packaging.getHcidCode());
            });

    // if HCID list is neither null nor empty then validate its values
    if (neitherNullNorEmpty(hcidCodes)) {
      validateHcidCodes(hcidCodes, premiumFeatureResponse);
    }

    // HAL restricted services validation
    validateHalRestrictedServices(shipmentBookRequest);
  }

  private void validateHalRestrictedServices(ShipmentBookRequest shipmentBookRequest) {
    if (Objects.nonNull(shipmentBookRequest.getHoldLocationAddress())
        && Objects.nonNull(shipmentBookRequest.getHoldLocationAddress().getAddressData())
        && SERVICES_NOT_FOR_HAL.contains(
            shipmentBookRequest.getShipViaOptions().get(0).getCode())) {
      throw new ValidationException(
          "Hold at Location service is not allowed for the selected service level.");
    }
  }

  private void validateShippingProfileId(UUID shippingProfileId) {
    Optional<ShippingProfile> shippingProfile =
        shippingProfileRepository.findById(shippingProfileId);
    if (shippingProfile.isEmpty()) {
      throw new ValidationException("Shipping profile not found");
    }
    if (Boolean.FALSE.equals(shippingProfile.get().getActive())) {
      throw new ValidationException("Shipping profile inactive");
    }
  }

