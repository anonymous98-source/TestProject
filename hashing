  @Test
  @WithMockOflUser(role = "ADVSHIP_CUSTOMER_ADMIN")
  void testGetCarriersByLocation_shouldReturnCarrierData() throws Exception {
    String facilityId = "facility-123";

    // --- Build a FedEx shipping profile ---
    ShippingProfileResponseDTO fedexProfile = new ShippingProfileResponseDTO();
    fedexProfile.setId(UUID.fromString("4a65e507-6201-4c02-bace-0253d9b73e3c"));
    fedexProfile.setShippingProfileName("FedEx");
    fedexProfile.setCarrier("fedex");
    fedexProfile.setVisualIdentifierColor("#4D148C");
    fedexProfile.setVisualIdentifierIcon("fedex-logo-filled");

    // --- Create AvailableCarrierDTO for FedEx ---
    AvailableCarrierDTO fedexAvailable = new AvailableCarrierDTO();
    fedexAvailable.getDefaultCarrier().add(fedexProfile); // Add profile to defaultCarrier

    // --- Create empty AvailableCarrierDTOs for other carriers ---
    AvailableCarrierDTO emptyAvailable =
        new AvailableCarrierDTO(); // defaultCarrier and customCarrier are empty

    // --- Build CarrierDto ---
    CarrierDto carrierDto = new CarrierDto();
    Map<String , AvailableCarrierDTO> availableCarriers = new HashMap<>();
    availableCarriers.put("fedex", fedexAvailable);
    availableCarriers.put("usps", emptyAvailable);
    availableCarriers.put("sameday", emptyAvailable);
    availableCarriers.put("ondemand", emptyAvailable);
    availableCarriers.put("regionalnextday", emptyAvailable);

    // --- Build CarrierByLocationResDTO ---
    CarrierByLocationResDTO responseDTO = new CarrierByLocationResDTO();
    responseDTO.setCarrier(availableCarriers);
    responseDTO.setOrder(
        List.of(
            "OptiFreight ® On-demand",
            "OptiFreight ® Same Day",
            "OptiFreight ® Regional Next Day",
            "FedEx",
            "USPS"));

    // --- Stub service ---
    when(carrierByLocationService.getOrderCarriers(eq(facilityId), any(OflUserPrincipal.class)))
        .thenReturn(responseDTO);

    // --- Perform request and assert response ---
    mockMvc
        .perform(
            get("/v1/api/shipping_profile/carrierbylocation")
                .param("facilityId", facilityId)
                .with(csrf()))
        .andExpect(status().isOk())
        .andExpect(content().contentType(MediaType.APPLICATION_JSON))

        // FedEx defaultCarrier[0] assertions
        .andExpect(jsonPath("$.carrier.fedex.defaultCarrier[0].carrier").value("fedex"))
        .andExpect(jsonPath("$.carrier.fedex.defaultCarrier[0].shippingProfileName").value("FedEx"))
        .andExpect(
            jsonPath("$.carrier.fedex.defaultCarrier[0].visualIdentifierColor").value("#4D148C"))
        .andExpect(
            jsonPath("$.carrier.fedex.defaultCarrier[0].visualIdentifierIcon")
                .value("fedex-logo-filled"))

        // USPS defaultCarrier should be empty
        .andExpect(jsonPath("$.carrier.usps.defaultCarrier").isArray())
        .andExpect(jsonPath("$.carrier.usps.defaultCarrier").isEmpty())

        // Order list assertions
        .andExpect(jsonPath("$.order[0]").value("OptiFreight ® On-demand"))
        .andExpect(jsonPath("$.order[3]").value("FedEx"))
        .andExpect(jsonPath("$.order[4]").value("USPS"));

    // --- Verify service call ---
    verify(carrierByLocationService, times(1))
        .getOrderCarriers(eq(facilityId), any(OflUserPrincipal.class));
  }

