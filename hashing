package com.cardinalhealth.adv.shipping.integration.api.redis.config;

import java.io.File;
import java.io.IOException;
import java.time.Duration;

import com.cardinalhealth.adv.shipping.integration.api.redis.auth.GcpIamTokenProvider;
import io.lettuce.core.api.StatefulConnection;
import org.apache.commons.pool2.impl.GenericObjectPoolConfig;
import org.jspecify.annotations.NonNull;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.boot.autoconfigure.AutoConfiguration;
import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.boot.autoconfigure.data.redis.RedisAutoConfiguration;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.data.redis.connection.RedisClusterConfiguration;
import org.springframework.data.redis.connection.RedisConfiguration;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.data.redis.connection.RedisStandaloneConfiguration;
import org.springframework.data.redis.connection.lettuce.LettuceConnectionFactory;
import org.springframework.data.redis.connection.lettuce.LettucePoolingClientConfiguration;
import org.springframework.data.redis.connection.lettuce.RedisCredentialsProviderFactory;
import org.springframework.data.redis.core.RedisOperations;


import io.lettuce.core.ClientOptions;
import io.lettuce.core.RedisCredentials;
import io.lettuce.core.RedisCredentialsProvider;
import io.lettuce.core.SslOptions;
import io.lettuce.core.cluster.ClusterClientOptions;
import io.lettuce.core.cluster.ClusterTopologyRefreshOptions;

import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.COMMAND_TIMEOUT;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.MAX_IDLE;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.MAX_TOTAL;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.MAX_WAIT;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.MIN_EVICTABLE_IDLE_DURATION;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.MIN_IDLE;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.SECONDS_BTW_EVIC_RUN;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.SHUTDOWN_TIMEOUT;

/**
 * Auto-configuration for GCP Memorystore Redis with IAM authentication.
 *
 * Configures Spring Data Redis to connect to GCP Memorystore for Redis clusters
 * with IAM-based authentication and TLS encryption.
 *
 * This configuration is activated when: - The property
 * "gcp.memorystore.redis.enabled" is true (default) - RedisOperations is on the
 * classpath - No existing RedisConnectionFactory bean is defined
 *
 * @see GcpMemorystoreRedisProperties
 * @see GcpIamTokenProvider
 */
@AutoConfiguration(before = RedisAutoConfiguration.class)
@ConditionalOnClass(RedisOperations.class)
@ConditionalOnProperty(prefix = "gcp.memorystore.redis", name = "enabled", havingValue = "true", matchIfMissing = true)
@EnableConfigurationProperties(GcpMemorystoreRedisProperties.class)
public class GcpMemorystoreRedisAutoConfiguration {

    private static final Logger logger = LoggerFactory.getLogger(GcpMemorystoreRedisAutoConfiguration.class);

    private final GcpMemorystoreRedisProperties properties;

    public GcpMemorystoreRedisAutoConfiguration(GcpMemorystoreRedisProperties properties) {
        this.properties = properties;
        logger.info("Initializing GCP Memorystore Redis Auto-Configuration");
    }

    /**
     * Creates the GCP IAM token provider bean.
     *
     * @return configured GCP IAM token provider
     * @throws IOException if Application Default Credentials cannot be
     * initialized
     */
    @Bean
    @ConditionalOnMissingBean
    public GcpIamTokenProvider gcpIamTokenProvider() throws IOException {
        logger.info("Creating GCP IAM Token Provider");
        return new GcpIamTokenProvider();
    }

    /**
     * Creates the Redis connection factory with IAM authentication and TLS.
     *
     * @param tokenProvider the GCP IAM token provider
     * @return configured Redis connection factory
     * @throws Exception if connection factory cannot be created
     */
    @Bean
    @ConditionalOnMissingBean(RedisConnectionFactory.class)
    public RedisConnectionFactory redisConnectionFactory(GcpIamTokenProvider tokenProvider) throws Exception {
        logger.info("Creating Redis Connection Factory for GCP Memorystore");

        validateConfiguration();

        // Create SSL context with CA certificate
        SslOptions sslOptions = createSslOptions();

        GenericObjectPoolConfig<StatefulConnection<?, ?>> poolConfig = getStatefulConnectionGenericObjectPoolConfig();


        LettucePoolingClientConfiguration.LettucePoolingClientConfigurationBuilder clientConfig =
                LettucePoolingClientConfiguration.builder()
                        .poolConfig(poolConfig)
                        .commandTimeout(Duration.ofSeconds(COMMAND_TIMEOUT))
                        .shutdownTimeout(Duration.ofMillis(SHUTDOWN_TIMEOUT))
                        .redisCredentialsProviderFactory(createRedisCredentialsProviderFactory(tokenProvider));
        if (properties.getSsl().isEnabled()) {
            clientConfig.useSsl();
        }

        // Configure cluster topology refresh for cluster mode
        if (properties.isClusterMode()) {
            ClusterTopologyRefreshOptions topologyRefreshOptions = ClusterTopologyRefreshOptions.builder()
                    .enablePeriodicRefresh(Duration.ofSeconds(30))
                    .enableAllAdaptiveRefreshTriggers().dynamicRefreshSources(false)
                    .build();

            ClusterClientOptions clusterClientOptions = ClusterClientOptions.builder()
                    .topologyRefreshOptions(topologyRefreshOptions)
                    .sslOptions(sslOptions).validateClusterNodeMembership(false)
                    .build();

            clientConfig.clientOptions(clusterClientOptions);
        } else {
            ClientOptions standaloneClientOptions = ClientOptions.builder()
                    .sslOptions(sslOptions)
                    .build();
            clientConfig.clientOptions(standaloneClientOptions);
        }

        LettuceConnectionFactory factory;

        if (properties.isClusterMode()) {
            // Cluster configuration
            RedisClusterConfiguration clusterConfig = new RedisClusterConfiguration();
            clusterConfig.clusterNode(properties.getHost(), properties.getPort());

            factory = new LettuceConnectionFactory(clusterConfig, clientConfig.build());
            logger.info("Configured Redis cluster connection to {}:{}", properties.getHost(), properties.getPort());
        } else {
            // Standalone configuration
            RedisStandaloneConfiguration standaloneConfig = new RedisStandaloneConfiguration();
            standaloneConfig.setHostName(properties.getHost());
            standaloneConfig.setPort(properties.getPort());

            factory = new LettuceConnectionFactory(standaloneConfig, clientConfig.build());
            logger.info("Configured Redis standalone connection to {}:{}", properties.getHost(), properties.getPort());
        }

        factory.afterPropertiesSet();

        logger.info("Redis Connection Factory created successfully");
        return factory;
    }

    private static @NonNull GenericObjectPoolConfig<StatefulConnection<?, ?>> getStatefulConnectionGenericObjectPoolConfig() {
        GenericObjectPoolConfig<StatefulConnection<?, ?>> poolConfig = new GenericObjectPoolConfig<>();
        poolConfig.setMaxTotal(MAX_TOTAL);
        poolConfig.setMaxIdle(MAX_IDLE);
        poolConfig.setMinIdle(MIN_IDLE);
        poolConfig.setMaxWait(Duration.ofMillis(MAX_WAIT));
        poolConfig.setTestOnBorrow(true);
        poolConfig.setTestWhileIdle(true);
        poolConfig.setTimeBetweenEvictionRuns(Duration.ofSeconds(SECONDS_BTW_EVIC_RUN));
        poolConfig.setMinEvictableIdleDuration(Duration.ofSeconds(MIN_EVICTABLE_IDLE_DURATION));
        return poolConfig;
    }

    /**
     * Creates SSL options with the CA certificate for server validation.
     *
     * @return configured SSL options
     * @throws Exception if SSL configuration fails
     */
    private SslOptions createSslOptions() throws Exception {
        String caCertPath = properties.getSsl().getCaCertPath();

        if (caCertPath == null || caCertPath.isEmpty()) {
            throw new IllegalStateException("SSL CA certificate path must be configured: gcp.memorystore.redis.ssl.ca-cert-path");
        }

        logger.debug("Loading CA certificate from: {}", caCertPath);

        return SslOptions.builder()
                .trustManager(new File(caCertPath))
                .build();
    }

    /**
     * Validates the configuration properties.
     *
     * @throws IllegalStateException if required properties are missing
     */
    private void validateConfiguration() {
        if (properties.getHost() == null || properties.getHost().isEmpty()) {
            throw new IllegalStateException("Redis host must be configured: gcp.memorystore.redis.host");
        }

        if (properties.getPort() <= 0 || properties.getPort() > 65535) {
            throw new IllegalStateException("Redis port must be between 1 and 65535");
        }

        if (properties.getSsl().isEnabled()
                && (properties.getSsl().getCaCertPath() == null || properties.getSsl().getCaCertPath().isEmpty())) {
            throw new IllegalStateException("SSL CA certificate path must be configured when SSL is enabled");
        }

        logger.debug("Configuration validated successfully");
    }

    private RedisCredentialsProviderFactory createRedisCredentialsProviderFactory(GcpIamTokenProvider tokenProvider) {
        return new RedisCredentialsProviderFactory() {
            @Override
            public RedisCredentialsProvider createCredentialsProvider(RedisConfiguration redisConfiguration) {
                return RedisCredentialsProvider.from(() -> {
                    try {
                        return RedisCredentials.just(tokenProvider.getUsername(), tokenProvider.getToken());
                    } catch (IOException e) {
                        throw new IllegalStateException("Failed to refresh IAM access token for Redis", e);
                    }
                });
            }
        };
    }
}

