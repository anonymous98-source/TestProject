    private CompoundValidationData compoundValidationData;

    @Test
    void init_shouldSetEmptyMappings_whenRepositoryReturnsEmptyList() {
        when(ruleEngineFieldsRepository.findAll()).thenReturn(Collections.emptyList());

        compoundValidationData.init();

        assertTrue(compoundValidationData.getOperatorMapping().isEmpty());
        assertTrue(compoundValidationData.getRegexMapping().isEmpty());
    }

    @Test
    void init_shouldBuildOperatorAndRegexMappings_withFilteringAndLowerCasing() {
        RuleOperatorsCompatibility equalsCompatibility = new RuleOperatorsCompatibility();
        equalsCompatibility.setOperator("EQUALS");
        equalsCompatibility.setRegex("^\\d+$");

        RuleOperatorsCompatibility startsWithCompatibility = new RuleOperatorsCompatibility();
        startsWithCompatibility.setOperator("STARTS_WITH");
        startsWithCompatibility.setRegex("^ORD.*");

        RuleOperatorsCompatibility containsWithoutRegex = new RuleOperatorsCompatibility();
        containsWithoutRegex.setOperator("CONTAINS");
        containsWithoutRegex.setRegex(null);

        RuleOperatorsCompatibility nullOperatorCompatibility = new RuleOperatorsCompatibility();
        nullOperatorCompatibility.setOperator(null);
        nullOperatorCompatibility.setRegex("^ignored$");

        RuleEngineFields validField = new RuleEngineFields();
        validField.setKey("OrderType");
        validField.setRuleOperatorsCompatibilities(
                java.util.Arrays.asList(
                        equalsCompatibility,
                        startsWithCompatibility,
                        containsWithoutRegex,
                        null,
                        nullOperatorCompatibility
                )
        );

        RuleEngineFields nullCompatibilitiesField = new RuleEngineFields();
        nullCompatibilitiesField.setKey("Region");
        nullCompatibilitiesField.setRuleOperatorsCompatibilities(null);

        RuleEngineFields nullKeyField = new RuleEngineFields();
        nullKeyField.setKey(null);
        nullKeyField.setRuleOperatorsCompatibilities(List.of(equalsCompatibility));

        when(ruleEngineFieldsRepository.findAll()).thenReturn(java.util.Arrays.asList(
                validField,
                null,
                nullCompatibilitiesField,
                nullKeyField
        ));

        compoundValidationData.init();

        Map<String, List<String>> operatorMapping = compoundValidationData.getOperatorMapping();
        Map<String, String> regexMapping = compoundValidationData.getRegexMapping();

        assertEquals(List.of("EQUALS", "STARTS_WITH", "CONTAINS"), operatorMapping.get("ordertype"));
        assertEquals(Collections.emptyList(), operatorMapping.get("region"));
        assertEquals(2, operatorMapping.size());

        assertEquals("^\\d+$", regexMapping.get("ordertype#equals"));
        assertEquals("^ORD.*", regexMapping.get("ordertype#starts_with"));
        assertEquals(2, regexMapping.size());
    }

    @Test
    void init_shouldDeduplicateOperatorsInOperatorMapping() {
        RuleOperatorsCompatibility op1 = new RuleOperatorsCompatibility();
        op1.setOperator("EQUALS");
        op1.setRegex("^\\d+$");

        RuleOperatorsCompatibility op2 = new RuleOperatorsCompatibility();
        op2.setOperator("EQUALS");
        op2.setRegex(null); // avoids inclusion in regexMapping

        RuleEngineFields field = new RuleEngineFields();
        field.setKey("OrderType");
        field.setRuleOperatorsCompatibilities(java.util.Arrays.asList(op1, op2));

        when(ruleEngineFieldsRepository.findAll()).thenReturn(List.of(field));

        compoundValidationData.init();

        assertEquals(List.of("EQUALS"), compoundValidationData.getOperatorMapping().get("ordertype"));
        assertEquals(Map.of("ordertype#equals", "^\\d+$"), compoundValidationData.getRegexMapping());
    }
