package com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule;

import com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.dto.request.ConditionDTO;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Locale;
import java.util.stream.Collectors;

import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.compoundrule.constants.CompoundRuleConstants.LABEL_REFERENCE_KEYS;

@Slf4j
@Component
public class RuleExpressionBuilder {

    public String buildExpression(List<ConditionDTO> conditions) {

        if (conditions == null || conditions.isEmpty()) {
            throw new IllegalArgumentException("At least one condition is required");
        }
        log.atInfo().setMessage("Building expression for compound rule using input conditions").log();

        StringBuilder expression = new StringBuilder();

        expression.append(buildCondition(conditions.get(0)));

        for (int i = 1; i < conditions.size(); i++) {
            ConditionDTO condition = conditions.get(i);
            String joiningOperator = condition.getJoiningOperator();

            if ("OR".equalsIgnoreCase(joiningOperator)) {
                expression.append(" or ");
            } else {
                expression.append(" and ");
            }

            expression.append(buildCondition(condition));
        }
        return expression.toString();
    }

    private String buildCondition(ConditionDTO condition) {

        String field = "#" + condition.getKey();
        RuleOperator operator = RuleOperator.valueOf(condition.getOperator().toUpperCase(Locale.ROOT));
        Object value = condition.getValue();
        if (value instanceof String) {
            value = value.toString().trim();
        }

        value = sanitizeLabelReferenceValue(condition.getKey(), operator, value);

        return switch (operator) {
            case IS -> {
                if (value instanceof String) {
                    yield field + " != null and " + field + " == '" + value + "'";
                }
                yield field + " != null and " + field + " == " + value;
            }

            case IS_NOT -> {
                if (value instanceof String) {
                    yield field + " != null and " + field + " != '" + value + "'";
                }
                yield field + " != null and " + field + " != " + value;
            }

            case IS_ONE_OF -> field + " != null and "
                    + buildContainsCondition(field, (List<?>) value);

            case IS_NOT_ONE_OF -> field + " != null and !"
                    + buildContainsCondition(field, (List<?>) value);

            case STARTS_WITH -> field + " != null and "
                    + field
                    + ".startsWith('"
                    + value
                    + "')";

            case GREATER_THAN_EQUAL -> field + " != null and " + field + " >= " + value;
            case LESS_THAN_EQUAL -> field + " != null and " + field + " <= " + value;
            case GREATER_THAN -> field + " != null and " + field + " > " + value;
            case LESS_THAN -> field + " != null and " + field + " < " + value;
            default -> throw new IllegalArgumentException("Unsupported operator: " + operator);
        };
    }

    private String buildContainsCondition(
            String field,
            List<?> values) {

        String joined = values.stream()
                .map(v -> "'" + v.toString().trim() + "'")
                .collect(Collectors.joining(","));

        return "{"
                + joined
                + "}.contains("
                + field
                + ")";
    }

    private Object sanitizeLabelReferenceValue(String key, RuleOperator operator, Object value) {

        if (!shouldEncodeApostrophe(key, operator)) {
            return value;
        }

        if (value instanceof String str) {
            return encodeApostrophe(str);
        }

        if (value instanceof List<?> list) {
            return list.stream()
                    .map(item -> item instanceof String ? encodeApostrophe(item.toString()) : item)
                    .collect(Collectors.toList());
        }

        return value;
    }

    private boolean shouldEncodeApostrophe(String key, RuleOperator operator) {
        return LABEL_REFERENCE_KEYS.contains(key)
                && (operator == RuleOperator.IS || operator == RuleOperator.IS_ONE_OF);
    }

    /**
     * Encodes apostrophe characters in label reference values before constructing
     * the SpEL expression.
     * -
     * Label reference fields (labelReference1, labelReference2 and
     * labelReference3) are free-text fields and may contain apostrophes (').
     * When such values are directly embedded into a SpEL expression, the
     * apostrophe is interpreted as the end of the string literal, resulting in
     * an invalid expression.
     * -
     * To avoid this issue, apostrophes are replaced with their URL-encoded
     * representation (<code>%27</code>) before the SpEL expression is generated.
     * This ensures that values containing apostrophes can be safely incorporated
     * into the expression and evaluated correctly.
     */
    private String encodeApostrophe(String value) {
        return value.replace("'", "%27");
    }
}

