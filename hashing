    @Override
    @Transactional
    public SuccessResponse createOrUpdateRule(CompoundRuleDTO request, String userEmail) {

        validator.validateUserAuthorization(userEmail, request.getFacilityId(), request.getCustomerId());
        validator.validateCompoundRuleRequest(request);

        if (request.getId() != null) {
            RuleDefinition existingRule = repository.findByIdAndRuleTypeAndFacilityIdAndCustomerIdAndActive(
                    request.getId(), COMPOUND_RULE, request.getFacilityId(), request.getCustomerId(), true)
                    .orElseThrow(() -> new ResourceNotFoundException("Compound rule not found"));

            validatePriorityUniqueness(request, existingRule);
            log.atInfo().setMessage("Updating compound rule for facilityId ").addKeyValue("facilityId", request.getFacilityId())
                    .log();

            standardizedConditionValues(request.getConditions());
            String updatedExpression = expressionBuilder.buildExpression(request.getConditions());
            List<RuleCondition> updatedConditions = getRuleCondition(request.getConditions());

            // Clearing the existing rule conditions
            existingRule.getRuleConditions().clear();

            existingRule.setShippingProfileId(UUID.fromString(request.getShippingProfileId()));
            existingRule.setPriority(request.getPriority());
            existingRule.setExpression(updatedExpression);
            existingRule.getRuleConditions().addAll(updatedConditions);
            updatedConditions.forEach(condition -> condition.setRuleDefinition(existingRule));
            RuleDefinition updatedRule = repository.save(existingRule);

            log.atInfo().setMessage("Compound rule updated successfully for facilityId ").addKeyValue("facilityId", updatedRule.getFacilityId())
                    .addKeyValue("ID",  updatedRule.getId())
                    .log();

            return SuccessResponse.builder()
                    .status(SUCCESS)
                    .message(String.format(UPDATE_MESSAGE, updatedRule.getFacilityId(), updatedRule.getPriority()))
                    .build();

        } else {
            log.atInfo().setMessage("Creating compound rule for facilityId ").addKeyValue("facilityId", request.getFacilityId())
                    .log();
            standardizedConditionValues(request.getConditions());
            String expression = expressionBuilder.buildExpression(request.getConditions());
            List<RuleCondition> ruleConditions = getRuleCondition(request.getConditions());
            try {
                RuleDefinition ruleToSave = RuleDefinition.builder()
                        .facilityId(request.getFacilityId())
                        .customerId(request.getCustomerId())
                        .ruleType(COMPOUND_RULE)
                        .expression(expression)
                        .ruleEvalMethod(EXPRESSION)
                        .value(COMPOUND)
                        .shippingProfileId(UUID.fromString(request.getShippingProfileId()))
                        .active(true)
                        .priority(request.getPriority())
                        .source(NAVIGATOR)
                        .ruleConditions(ruleConditions)
                        .build();

                ruleConditions.forEach(condition -> condition.setRuleDefinition(ruleToSave));
                RuleDefinition savedRule = repository.save(ruleToSave);

                log.atInfo().setMessage("Compound rule created successfully for facilityId ").addKeyValue("facilityId", savedRule.getFacilityId())
                        .addKeyValue("ID",  savedRule.getId())
                        .log();
                return SuccessResponse.builder()
                        .status(SUCCESS)
                        .message(String.format(SUCCESS_MESSAGE, savedRule.getFacilityId(), savedRule.getPriority()))
                        .build();
            } catch (Exception e) {
                log.atError().setMessage("Error occurred while saving compound rule for facilityId: " + request.getFacilityId())
                        .setCause(e)
                        .log();
                currentTransactionStatus().setRollbackOnly();
                return SuccessResponse.builder()
                        .status(FAILURE)
                        .message(FAILURE_MESSAGE)
                        .build();
            }
        }
    }

  private void standardizedConditionValues(List<ConditionDTO> conditions) {

    for (ConditionDTO condition : conditions) {
      if (!UPPERCASE_KEYS.contains(condition.getKey())) {
        continue;
      }

      Object value = condition.getValue();

      if (value instanceof String strValue) {
        condition.setValue(strValue.toUpperCase());
      } else if (value instanceof List<?> list) {
        List<String> upperCaseValues =
                list.stream()
                        .filter(Objects::nonNull)
                        .map(Object::toString)
                        .map(String::toUpperCase)
                        .toList();

        condition.setValue(upperCaseValues);
      }
    }
  }

    private void validatePriorityUniqueness(CompoundRuleDTO request, RuleDefinition existingRule) {
        if (!existingRule.getPriority().equals(request.getPriority())) {
            Optional<RuleDefinition> ruleWithSamePriority = repository.findByFacilityIdAndCustomerIdAndRuleTypeAndPriorityAndActive(
                    request.getFacilityId(), request.getCustomerId(), COMPOUND_RULE, request.getPriority(), true);
            if (ruleWithSamePriority.isPresent()) {
                throw new ValidationException(String.format("A compound rule with priority %d already exists for facilityId: %s",
                        request.getPriority(), request.getFacilityId()));
            }
        }
    }

    private List<RuleCondition> getRuleCondition(List<ConditionDTO> conditions) {
        AtomicInteger count = new AtomicInteger(0);
        return conditions.stream()
                .map(condition -> RuleCondition.builder()
                        .fieldName(condition.getKey())
                        .operator(condition.getOperator())
                        .logicalOp(condition.getJoiningOperator() != null ? condition.getJoiningOperator() : null)
                        .conditionOrder(count.getAndIncrement())
                        .comparisonValue(String.valueOf(condition.getValue()).trim())
                        .build())
                .collect(Collectors.toList());
    }

