        when(rule1.getOperator()).thenReturn("A");
        when(rule2.getOperator()).thenReturn("B");
        when(rule3.getOperator()).thenReturn("C");
        when(operatorRegistry.getPriority("A")).thenReturn(1);
        when(operatorRegistry.getPriority("B")).thenReturn(1);
        when(operatorRegistry.getPriority("C")).thenReturn(2);

        List<RuleDefinition> rules = Arrays.asList(rule1, rule2, rule3);
