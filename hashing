/**
 * The type Notification webclient service.
 */
@Component
@Slf4j
@RequiredArgsConstructor
public class NotificationWebclientService {

    private final WebClient webClient;

    @Value("${notification.resource.base.url:#{null}}")
    private String notificationResourceBaseUrl;

    /**
     * Validate notification phone number phone status check response dto.
     *
     * @param phoneNumber the phone number
     * @return the phone status check response dto
     */
    public PhoneStatusCheckResponseDto validateNotificationPhoneNumber(String phoneNumber) {
        // Add + sign if not present and remove all spaces
        phoneNumber = phoneNumber.replaceAll("\\s+", "");
        if (!phoneNumber.startsWith("+")) {
            phoneNumber = "+" + phoneNumber;
        }

        String encodedPhoneNumber = URLEncoder.encode(phoneNumber, StandardCharsets.UTF_8);

        String correlationId = MDC.get(ServiceCommonConstants.CORRELATION_ID);
        MultiValueMap<String, String> headers = new LinkedMultiValueMap<>();
        if (!StringUtils.isBlank(correlationId)) {
            headers.add(ServiceCommonConstants.CORRELATION_ID, correlationId);
        }

        return webClient.get()
                .uri(validateNotificationPhoneNumberURI(encodedPhoneNumber))
                .headers(httpHeaders -> httpHeaders.addAll(headers))
                .retrieve()
                .bodyToMono(PhoneStatusCheckResponseDto.class)
                .block();
    }

    /**
     * Validate notification phone number uri uri.
     *
     * @param phoneNumber the phone number
     * @return the uri
     */
    private URI validateNotificationPhoneNumberURI(String phoneNumber) {
        return new DefaultUriBuilderFactory()
                .uriString(notificationResourceBaseUrl)
                .path(ServiceCommonConstants.NOTIFICATION_ELIGIBILITY_PATH_URI)
                .queryParam(ShippingProfileConstants.NOTIFICATION_PHONE_NUMBER, phoneNumber)
                .queryParam(ShippingProfileConstants.NOTIFICATION_CHANNEL, ServiceCommonConstants.NOTIFICATION_CHANNEL_TYPE_SMS)
                .build();
    }
}

