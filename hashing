                request.getContext());
        List<RuleDefinition> candidates = ruleDefinitionRepository.findWeightRulesOrderedAsc(
                request.getFacilityId(), RuleType.WEIGHT.toString());

        if (candidates == null || candidates.isEmpty()) {
            // return default shipping profile
            return null;
        }
        // Phase 1: stop on first match
        RuleDefinition firstMatch = candidates.stream().filter(
                rule -> evaluator.evaluate(rule, context)).findFirst().orElse(null);

        if (firstMatch == null) {
            return null;
        }
        // find ties if any
        List<RuleDefinition> ties = candidates.stream().filter(r -> r.getValue().equals(firstMatch.getValue())).toList();
        List<RuleDefinition> trueMatchFromTies = ties.stream().filter(r -> evaluator.evaluate(r, context)).toList();
        // check for other ties and evaluate -- filter
        RuleDefinition winner = resolver.resolve(trueMatchFromTies);

        return RuleEvaluationResult.builder()
                .ruleType(RuleType.WEIGHT)
                .primary(winner)
                .build();

    }
