  private void validateInsuranceOptionsFedEx(
      boolean individualShipmentProtection,
      Double coverageAmount,
      boolean declaredValue,
      Double valueOfContent,
      boolean addOnInsurance,
      Double addOnInsuranceValue) {
    if (addOnInsurance || Objects.nonNull(addOnInsuranceValue)) {
      throw new ValidationException("Invalid insurance option selected for FedEx.");
    }

    if (individualShipmentProtection && (Objects.isNull(coverageAmount) || (coverageAmount < 1))){
        throw new ValidationException("Coverage amount must be greater than equal to 1.00.");
    }
    if (individualShipmentProtection && (declaredValue || Objects.nonNull(valueOfContent))){
        throw new ValidationException("Invalid selection of insurance option declared value.");
    }

    if (!individualShipmentProtection && declaredValue && (Objects.isNull(valueOfContent) || (valueOfContent < 100))){
        throw new ValidationException("Value of Content must be greater than equal to 100.00.");
    }

    if (!individualShipmentProtection && declaredValue && Objects.nonNull(coverageAmount)){
        throw new ValidationException("Invalid value of insurance option Coverage Amount.");
