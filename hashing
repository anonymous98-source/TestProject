                    .deliveryTargetFrom(getCmsFormatDate(shipmentBookRequest.getDeliveryStartDate()))
                    .deliveryTargetTo(getCmsFormatDate(shipmentBookRequest.getDeliveryEndDate()))
                    .packagingDetails(getPackagingDetails(shipmentBookRequest.getPackagingDetails()))
                    .shipmentAccesorial(getShipmentAccesorial(shipmentBookRequest.getAdditionalAccessorial()))
                    .notifications(getUniqueNotifications(shipmentBookRequest.getAdditionalAccessorial()))
                    .labelType(shipmentBookRequest.getLabelType().equalsIgnoreCase(LabelType.ZPL.name()) ? LabelType.ZPL.name() : LabelType.PDF.name())
                    .facilityId(facilityId)
