package com.cardinalhealth.adv.shipping.integration.api.customer.service;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.UNDERSCORE_DELIMITER;
import static com.cardinalhealth.adv.shipping.integration.api.customer.adapter.CustomerAdapter.mapEntitiesToCustomerHierarchyRequest;
import static com.cardinalhealth.adv.shipping.integration.api.redis.RedisConstant.RedisConstants.COST_CENTER_REGION;
import static java.util.Collections.emptyList;

import com.cardinalhealth.adv.shipping.integration.api.customer.adapter.CustomerAdapter;
import com.cardinalhealth.adv.shipping.integration.api.customer.client.CustomerWebClient;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.CostCenter;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.Entity;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.UserCustomerProfile;
import java.util.List;
import java.util.Optional;
import java.util.UUID;


import com.cardinalhealth.adv.shipping.integration.api.redis.dto.CostCenterCacheDto;
import com.cardinalhealth.adv.shipping.integration.api.redis.service.RedisRegionService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

@Component
@RequiredArgsConstructor
@Slf4j
public class CustomerServiceImpl implements CustomerService {

  private final CustomerWebClient customerWebClient;
  private final RedisRegionService redisRegionService;

  @Override
  public UserCustomerProfile getCustomer(List<Entity> entities) {
    var request = mapEntitiesToCustomerHierarchyRequest(entities);
    var userCustomerProfile =
        CustomerAdapter.mapCustomerHierarchyDtoToCustomerProfile(
            customerWebClient.getCustomerHierarchy(request));
    CustomerAdapter.setFacilityCustomerIds(userCustomerProfile);
    return userCustomerProfile;
  }

  @Override
  public UserCustomerProfile getCustomerByFacilityId(UUID facilityId) {
    var request = mapEntitiesToCustomerHierarchyRequest(facilityId);
    var userCustomerProfile =
        CustomerAdapter.mapCustomerHierarchyDtoToCustomerProfile(
            customerWebClient.getCustomerHierarchy(request));
    CustomerAdapter.setFacilityCustomerIds(userCustomerProfile);
    return userCustomerProfile;
  }

  @Override
  public List<CostCenter> getCostCenters(UUID facilityID, String userEmail) {
    String cacheKey = facilityID + UNDERSCORE_DELIMITER + userEmail;
    Optional<CostCenterCacheDto> costCenterCacheData =  redisRegionService.get(COST_CENTER_REGION, cacheKey, CostCenterCacheDto.class);
    if (costCenterCacheData.isPresent()) {
      log.atInfo()
              .setMessage("Cost centers found in cache")
              .addKeyValue("FacilityID", facilityID.toString())
              .log();
      return costCenterCacheData.get().getCostCenters();
    }
    var costCenters = customerWebClient.getCostCenters(facilityID, userEmail);
    if (costCenters == null || costCenters.isEmpty()) {
      return emptyList();
    }
    var costCentersResponse =
        costCenters.stream()
            .map(CostCenter::fromCostCenterDto)
            .sorted(
                (a, b) ->
                    Boolean.compare(b.isDefaultFlag(), a.isDefaultFlag())) // put default at top of list
            .toList();
    redisRegionService.put(COST_CENTER_REGION, cacheKey, new CostCenterCacheDto(cacheKey, costCentersResponse));
    return costCentersResponse;
  }
}

