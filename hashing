            boolean isFirstChunk = true;

            try {
                while (true) {
                    Pageable pageable = PageRequest.of(page, pageSize);
                    Page<ShipToAddress> currentPage =
                            shipToAddressFacilityMappingRepository.findShipToAddressByMonarchFacilityId(monarchFacilityId, pageable);

                    if (currentPage.isEmpty()) break;

                    List<ShipToAddressCsvDto> dtos = currentPage.getContent().stream()
                            .map(s -> ShipToAddressCsvDto.builder()
                                    .company(s.getCompany())
