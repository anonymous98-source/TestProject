import org.springframework.util.StringUtils;
import org.springframework.web.reactive.function.BodyInserters;
import org.springframework.web.reactive.function.client.WebClient;

@Slf4j
@Service
public class TokenGenerationWebClientService {
    @Qualifier("webClientNoAuth")
    private final WebClient webClient;

    private final AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties;
    private static final String TOKEN_KEY = "price_quote_API_token";
    //private final LogbackMetrics logbackMetrics;

    @Autowired
    public TokenGenerationWebClientService(@Qualifier("webClientNoAuth") WebClient webClient,
                                           AdvShippingIntegrationApiProperties advShippingIntegrationApiProperties) {
        this.webClient = webClient;
        this.advShippingIntegrationApiProperties = advShippingIntegrationApiProperties;
        //this.logbackMetrics = logbackMetrics;
    }

    /**
     * Retrieves the access token using client credentials.
     *
     * @return the access token as a string.
     */
    public String getAccessToken() {
        String cachedToken = TokenCacheUtils.getCachedToken(TOKEN_KEY);
        if (StringUtils.hasText(cachedToken)) {
            log.atInfo().setMessage("Retrieved access token from Token Cache, returning back to caller")
                    .log();
            return cachedToken;
        }

        log.atInfo()
                .setMessage("Initiating request to retrieve access token")
                .log();

        String accessToken = webClient.post()
                .uri(advShippingIntegrationApiProperties.getRateQuoteAuthBaseUrl() + "/oauth2/v3/token/jwttoken")
                .contentType(MediaType.APPLICATION_FORM_URLENCODED)
                .body(BodyInserters
                        .fromFormData("grant_type", "client_credentials")
                        .with("client_id", advShippingIntegrationApiProperties.getRateQuoteAuthClientId())
                        .with("client_secret", advShippingIntegrationApiProperties.getRateQuoteAuthClientSecret()))
                .retrieve()
                .bodyToMono(TokenResponse.class)
                .map(TokenResponse::getAccessToken)
                .block();

        if (StringUtils.hasText(accessToken)) { // Add latest token in cache
            TokenCacheUtils.addNewTokenInCache(TOKEN_KEY, accessToken);
            log.atInfo()
                    .setMessage("Successfully retrieved access token from API and added in Token cache")
                    .log();
        } else {
            log.atWarn().setMessage("Failed to retrieve access token or retrieved token is null or empty")
                    .log();
        }

        return accessToken;
    }
}

