   static List<FillDto> getFillDtoForPackage(Reference reference) {

    // Fetch the PrescriptionNumbers and FillIds and turn them into list of Strings
    List<String> fillIdList = prepareList(reference.getFillId());
    List<String> prescriptionNumberList = prepareList(reference.getPrescriptionNumber());
    // Check if both lists have same count of elements, if not then adjust them
    adjustElementCount(fillIdList, prescriptionNumberList);
    return IntStream.range(0, fillIdList.size())
        .mapToObj(i -> new FillDto(fillIdList.get(i), prescriptionNumberList.get(i)))
        .toList();
  }

  private static List<String> prepareList(String comaSeparatedString) {
      List<String> strings = new ArrayList<>(
            StringUtils.isBlank(comaSeparatedString)
                    ? List.of("")
                    : Arrays.asList(comaSeparatedString.split(",")));
      return strings.stream()
              .map(String::trim)
              .collect(Collectors.toList());
  }

  private static void adjustElementCount(
      List<String> fillIdList, List<String> prescriptionNumberList) {
    if (fillIdList.size() != prescriptionNumberList.size()) {
      boolean moreFillIds = fillIdList.size() > prescriptionNumberList.size();
      int difference = Math.abs(fillIdList.size() - prescriptionNumberList.size());
      (moreFillIds ? prescriptionNumberList : fillIdList)
          .addAll(IntStream.range(0, difference).mapToObj(i -> "").toList());
    }
  }

  /**
   * Map phone number extensions from shipment book request for all carriers to shipment builder
   * so that it can be saved in Tracking resource DB.
   *
   * @param shipmentBookRequest the shipment book request containing address data
   * @param shipmentBuilder the shipment builder to populate with phone number extensions
   */
  public void mapPhoneNumberExtension(ShipmentBookRequest shipmentBookRequest, NewShipmentDto.NewShipmentDtoBuilder shipmentBuilder) {
    String shipFromPhoneNumberExtension = Optional.ofNullable(shipmentBookRequest)
            .map(ShipmentBookRequest::getShipFromAddress)
            .map(ShipFromAddress::getAddressData)
            .map(AddressData::getAddress)
            .map(Address::getPhoneExt)
            .orElse(null);

    String shipToPhoneNumberExtension = Optional.ofNullable(shipmentBookRequest)
            .map(ShipmentBookRequest::getShipToAddress)
            .map(ShipToAddress::getAddressData)
            .map(ShipToAddressData::getAddress)
            .map(ShipToAddressDetails::getPhoneExt)
            .orElse(null);

    // Parse and set Ship From Phone Number Extension
    if (StringUtils.isNotBlank(shipFromPhoneNumberExtension)) {
      try {
        shipmentBuilder.shipFromPhoneNumberExtension(Integer.parseInt(shipFromPhoneNumberExtension));
      } catch (NumberFormatException e) {
        log.atWarn()
                .setMessage("Invalid Ship From Phone Number Extension: {}")
                .addArgument(shipFromPhoneNumberExtension)
                .addKeyValue("shipFromPhoneNumberExtension", shipFromPhoneNumberExtension)
                .log();
      }
    }

    // Parse and set Ship To Phone Number Extension
    if (StringUtils.isNotBlank(shipToPhoneNumberExtension)) {
      try {
        shipmentBuilder.shipToPhoneNumberExtension(Integer.parseInt(shipToPhoneNumberExtension));
      } catch (NumberFormatException e) {
        log.atWarn()
                .setMessage("Invalid Ship To Phone Number Extension: {}")
                .addArgument(shipToPhoneNumberExtension)
                .addKeyValue("shipToPhoneNumberExtension", shipToPhoneNumberExtension)
                .log();
      }
    }
  }


