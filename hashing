import static com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants.RECENT_ADDRESS_ENDPOINT;
import static com.cardinalhealth.adv.shipping.integration.api.constants.AddressBookConstants.USER_ID;

/**
 * THIS CLASS RETURNS THE RECENTLY USED ADDRESSES OF THE USER
 *
 */

@Service
@RequiredArgsConstructor
@Slf4j
public class RecentAddressesServiceImpl implements RecentAddressesService {
    private final UserDetailsService userDetailsService;
    private final ShipToAddressFacilityMappingCustomRepository shipToAddressFacilityMappingCustomRepository;
    private final AddressBookRetrievalService addressBookRetrievalService;
    private final TrackingResourceWebClientService trackingResourceWebClientService;


    @Override
    public ShipmentLocationDto getRecentAddresses(OflUserPrincipal oflUserPrincipal, String facilityId) {
        UserDto userDto= userDetailsService.buildUserDtoFromOflUserPrincipal(oflUserPrincipal);
        UUID userId = userDto.getMonarchUserId();
        HashMap<String , String> paramVariables = new HashMap<>();
        paramVariables.put(USER_ID, userId.toString());
        paramVariables.put(FACILITY_ID, facilityId);
        List<ShipmentDto> shipments= trackingResourceWebClientService.trackingResourceGetRequest(
                RECENT_ADDRESS_ENDPOINT,
                HttpMethod.GET,
                new HashMap<>(),
                ShipmentDto.class,
                paramVariables
        ).block();


        if (shipments != null && !shipments.isEmpty()) {
            List<RecentAddressesDto> recentAddressesList = shipments.stream()
                    .map(this::mapToRecentAddressesDto)
                    .toList();
            return ShipmentLocationDto.builder()
                    .allContactsCount(shipToAddressFacilityMappingCustomRepository
                            .findAllContactCount(facilityId))
                    .favouriteAddressCount(addressBookRetrievalService
                            .fetchTotalFavouriteAddressCountForUserAndFacilityId(userId, facilityId))
                    .totalRecentAddresses(shipments.size())
                    .addresses(recentAddressesList)
                    .build();

        }
        return ShipmentLocationDto.builder().build();
    }

    /**
     * used for mapping recent address
     * @param shipment
     * @return RecentAddressesDto
     */

    public RecentAddressesDto mapToRecentAddressesDto(ShipmentDto shipment) {
        return RecentAddressesDto.builder()
                .id(shipment.getId().toString())
                .facilityId(shipment.getFacilityId().toString())
                .recipientName(shipment.getShipmentRecipientName())
                .company(shipment.getShipToCompany())
                .addressLine1(shipment.getShipToAddressLine1())
                .addressLine2(shipment.getShipToAddressLine2())
                .addressLine3(shipment.getShipToAddressLine3())
                .city(shipment.getShipToCity())
                .state(shipment.getShipToState())
                .zipCode(shipment.getShipToZip())
                .country(shipment.getShipToCountry())
                .addressType(shipment.getShipToAddressType())
                .phone(shipment.getShipToPhoneNumber())
                .extension(shipment.getShipToPhoneNumberExtension())
                .email(shipment.getShipToEmail())
                .createdAt(shipment.getCreatedAt())
                .build();
    }

}

