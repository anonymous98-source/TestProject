@Component
@Slf4j
@RequiredArgsConstructor
public class AsyncPersistFedExPricing {

  private final AdvShippingBookDataPersistService advShippingBookDataPersistService;
  private final PriceBreakDownServiceImpl priceBreakDownServiceImpl;
  private final RateQuoteWebClientService rateQuoteWebClientService;
  private final SendFlexRecordUtil sendFlexRecordUtil;

  @Async(BEAN_QUALIFIER)
  public void asyncPersistFedexPricingDetails(
      Map<String, String> customerDetails,
      NewShipmentResourceDto finalNewShipmentResourceDto,
      ShipmentBookRequest shipmentBookRequest,
      ShipmentBookResponseDto shipmentBookResponseDto,String correlationId) {

    log.info("Started asyncPersistFedexPricingDetails");
    if (correlationId != null) {
      MDC.put(CORRELATION_ID, correlationId);
    }
    try {
      PriceResult priceResult = PriceResult.builder().errors(new ArrayList<>()).build();
      FedExRateCallResponse rateQuoteInfo =
          getRates(shipmentBookRequest, customerDetails, priceResult);
      if (rateQuoteInfo != null && rateQuoteInfo.getRates() != null) {
        Map<String, Object> rateQuoteFedex =
            getFedExPricingDetails(
                shipmentBookRequest,
                shipmentBookResponseDto,
                rateQuoteInfo,
                rateQuoteInfo.getRates(),
                priceResult);
        if (rateQuoteFedex != null && !rateQuoteFedex.isEmpty()) {
          advShippingBookDataPersistService.updateRateQuoteInfoInTrackingResource(
                  finalNewShipmentResourceDto.getShipmentDto().getId(),
                  rateQuoteFedex,
                  shipmentBookResponseDto);
        }
        log.atInfo()
                .setMessage("price set in shipmentBookResponseDto after async processing:")
                .log();
        log.atInfo()
                .setMessage(String.valueOf(shipmentBookResponseDto.getPriceBreakDown()))
                .log();
      } else {
        log.atError()
                .setMessage("FedEx rate quote async persistence failed, getRates returned no response")
                .log();
      }

    } catch (Exception e) {
      log.atError()
          .setMessage("FedEx rate quote async persistence failed")
          .setCause(e)
          .log();
    }finally {
      MDC.remove(CORRELATION_ID);
    }
    log.atInfo()
        .setMessage("Completed asyncPersistFedexPricingDetails")
        .log();
  }

  public Map<String, Object> getFedExPricingDetails(
      ShipmentBookRequest shipmentBookRequest,
      ShipmentBookResponseDto shipmentBookResponseDto,
      FedExRateCallResponse fedExRateCallResponse,
      RatesDto rates,
      PriceResult priceResult) {

    Map<String, Object> toSaveRateInfo = new HashMap<>();

      PriceResult pr = priceBreakDownServiceImpl.getResult(rates, shipmentBookRequest);

      if(pr!=null) {
        priceResult.setLineItem(pr.getLineItem());
        priceResult.setTotal(pr.getTotal());

      List<LineItemDto> lineItems = priceResult.getLineItem();

      double baseCost =
              lineItems.stream()
                      .filter(item -> item.getDescription().equalsIgnoreCase(TOTAL_BASE_CHARGE_AMOUNT))
                      .mapToDouble(LineItemDto::getValue)
                      .findFirst()
                      .orElse(0);

      double accessorialCost =
              lineItems.stream()
                      .filter(item -> !item.getDescription().equalsIgnoreCase(TOTAL_BASE_CHARGE_AMOUNT))
                      .mapToDouble(LineItemDto::getValue)
                      .sum();

      priceResult.setBaseCost(pr.getBaseCost());
      priceResult.setAccessorialCost(pr.getAccessorialCost());

      toSaveRateInfo.put(REQUEST, shipmentBookRequest);
      toSaveRateInfo.put(RESPONSE, fedExRateCallResponse.getRates());
      toSaveRateInfo.put(CODE, FEDEX);
      toSaveRateInfo.put(TOTAL_AMT, baseCost + accessorialCost);
      toSaveRateInfo.put(STATUS, SUCCESS_STATUS_CODE);
      toSaveRateInfo.put(BASE_COST, baseCost);
      toSaveRateInfo.put(ACCESSORIAL_COST, accessorialCost);

      if (Boolean.TRUE.equals(fedExRateCallResponse.getRateQuoteSuccess())) {
        log.atInfo().addKeyValue("priceResult", String.valueOf(priceResult)).log();
        shipmentBookResponseDto.setPriceBreakDown(priceResult);

        } else {
          log.atInfo().setMessage("priceResult not set for: " + shipmentBookRequest.getShipmentTransactionId()).log();
          shipmentBookResponseDto.setPriceBreakDown(null);
        }
      }
    return toSaveRateInfo;
  }

  private FedExRateCallResponse getRates(
      ShipmentBookRequest shipmentBookRequest,
      Map<String, String> customerDetails,
      PriceResult priceResult) {
    log.atInfo().setMessage("Get rates from Price Break Down service").log();
    FedExRateCallResponse.FedExRateCallResponseBuilder rateCallResponse =
        FedExRateCallResponse.builder();
    rateCallResponse.rateQuoteSuccess(false);
    ShipmentRequestModel shipReq = null;
    try {
      // Fetch rate quote line items
     shipReq =
          priceBreakDownServiceImpl.maptoShipmentRequestModel(shipmentBookRequest, customerDetails);
      RatesDto rates = rateQuoteWebClientService.getRateQuote(shipReq);
      rateCallResponse.rates(rates);
      rateCallResponse.rateQuoteSuccess(true);
    } catch (Exception e) {
      log.error(RATE_QUOTE_FAILED, e.getMessage());
      priceResult.getErrors().add(FAILED_RATE_QUOTE_PRICE);
      // save failure record for rate quote to price_quote_logs
      if (shipReq != null) {
        sendFlexRecordUtil.savePriceRecordDtoForFailure(shipReq, e);
      }
    }
    return rateCallResponse.build();
  }
}

