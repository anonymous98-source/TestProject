package com.cardinalhealth.adv.shipping.integration.api.messaging.publisher;

import com.cardinalhealth.ofl.next.messaging.library.service.MessagingPublisher;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.google.api.core.ApiFuture;
import com.google.cloud.pubsub.v1.Publisher;
import lombok.SneakyThrows;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.util.Map;

@Slf4j
@Component
public class AspNoPhiPublisherRegistry {

    private final ObjectMapper objectMapper;
    private final MessagingPublisher messagingPublisher;

    @Autowired
    public AspNoPhiPublisherRegistry(Map<String, Publisher> noPhiPublisherBeans,
                                     ObjectMapper objectMapper) {
        this.objectMapper = objectMapper;
        this.messagingPublisher = new MessagingPublisher(noPhiPublisherBeans);
    }

    /**
     * This method publishes the No PHI Data in provide topic based on the publisher bean create
     *
     * @param topiKey   No PHI Topic Key
     * @param noPhiData Data to be published
     * @return True if Data successfully published else false
     */
    @SneakyThrows
    public Boolean publishNoPhiData(String topiKey, Object noPhiData) {
        log.atInfo()
                .setMessage("Inside Publisher method to publish No PHI related data in {} topic")
                .addArgument(topiKey)
                .addKeyValue("topicKey", topiKey)
                .log();

        var noPhiMessage = objectMapper.writeValueAsString(noPhiData);
        ApiFuture<String> publishStatus = messagingPublisher.publish(topiKey, noPhiMessage);
        log.atDebug().setMessage("No PHI Data successfully published ")
                .addKeyValue("topicName", topiKey)
                .addKeyValue("message", noPhiMessage)
                .log();
        return publishStatus != null;
    }
}

