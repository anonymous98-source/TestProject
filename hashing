  private static List<ShipViaOptionDto> buildShipViaOptions(List<ShipViaOption> shipViaOptions) {

    return shipViaOptions.stream()
        .map(option -> ShipViaOptionDto.builder().code(option.getCode()).zone(option.getZone()).build())
        .toList();
  }

  private static List<ShippingUnitDto> buildShippingUnits(
      List<PackagingDetails> packagingDetailsList,
      Map<String, PackageProfileEntity> packageProfileEntityMap,
      AdditionalAccessorial additionalAccessorial,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {

    var index = new AtomicInteger(0);
    return packagingDetailsList.stream()
        .map(
            pd -> {
              Packaging packaging = pd.getPackaging();

              ShippingUnitDto shippingUnitDto;
              if (packaging.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE)
                  || Objects.isNull(packageProfileEntityMap.get(packaging.getPackagingId()))) {

                shippingUnitDto = useUserInput(shippingProfile, packaging);

              } else {
                PackageProfileEntity packageProfileEntity =
                    packageProfileEntityMap.get(packaging.getPackagingId());

                shippingUnitDto = useDBValues(shippingProfile, packageProfileEntity, packaging);
              }

              shippingUnitDto.setPackageNumber(index.getAndIncrement());

              // set references to shipping unit
              setReferencesToShippingUnitDto(shippingUnitDto, pd, shippingProfile);

              // set carrierAddOns if accessorials not null
              setCarrierAddOnToShippingUnitDto(
                  shippingUnitDto,
                  pd,
                  additionalAccessorial,
                  shippingProfile,
                  shipmentBookRequest,
                  isUserEnrolledInOSP);

              return shippingUnitDto;
            })
        .sorted(
            (a, b) -> {
              boolean aHasInsurance =
                  Objects.nonNull(a.getCarrierAddOns())
                      && a.getCarrierAddOns().containsKey(INSURANCE);
              boolean bHasInsurance =
                  Objects.nonNull(b.getCarrierAddOns())
                      && b.getCarrierAddOns().containsKey(INSURANCE);
              return Boolean.compare(
                  !aHasInsurance, !bHasInsurance); // false (has insurance) comes before true
            })
        .toList();
  }

  private static ShippingUnitDto useUserInput(String shippingProfile, Packaging packaging) {
    ShippingUnitDto shippingUnitDto;
    shippingUnitDto =
        buildShippingUnitDto(
            isDetailsMeasurementValid(packaging.getLength()),
            isDetailsMeasurementValid(packaging.getWidth()),
            isDetailsMeasurementValid(packaging.getHeight()),
            Optional.ofNullable(packaging.getDimensionUOM()).orElse("in"),
            weightMeasurementValid(packaging.getWeight()),
            Optional.ofNullable(packaging.getWeightUOM()).orElse("lbs"),
            USPS.equalsIgnoreCase(shippingProfile) ? PACKAGING_TYPE : null);
    return shippingUnitDto;
  }

  private static ShippingUnitDto buildShippingUnitDto(
      float length,
      float width,
      float height,
      String dimensionUOM,
      float weight,
      String weightUOM,
      String packageType) {
    return ShippingUnitDto.builder()
        .type(PACKAGE)
        .length(length)
        .width(width)
        .height(height)
        .dimensionUOM(dimensionUOM)
        .weight(weight)
        .weightUOM(weightUOM)
        .boxTypeCode(packageType)
        .build();
  }

  private static float isDetailsMeasurementValid(float measuringField) {
    if (measuringField > 0.5) {
      return measuringField;
    }
    return 0.5f;
  }

  private static float weightMeasurementValid(float measuringField) {
    if (measuringField > 0) {
      return measuringField;
    }
    return 0.1f;
  }

  private static ShippingUnitDto useDBValues(
      String shippingProfile, PackageProfileEntity packageProfileEntity, Packaging packaging) {
    ShippingUnitDto shippingUnitDto;
    shippingUnitDto =
        buildShippingUnitDto(
            packageProfileEntity.getPackageProfileLength(),
            packageProfileEntity.getPackageProfileWidth(),
            getPackageHeight(packageProfileEntity),
            packageProfileEntity.getPackageProfileDimUnit(),
            packaging.getWeight(),
            packageProfileEntity.getPackageProfileWeightUnit(),
            USPS.equalsIgnoreCase(shippingProfile)
                ? packaging.getPackagingType().replace("®", BLANK)
                : null);
    return shippingUnitDto;
  }

  private static Float getPackageHeight(PackageProfileEntity packageProfileEntity) {
    return Optional.ofNullable(packageProfileEntity.getPackageProfileHeight()).orElse(0.5f);
  }

  private static void setReferencesToShippingUnitDto(
      ShippingUnitDto shippingUnitDto, PackagingDetails packagingDetails, String shippingProfile) {
    if (Objects.nonNull(packagingDetails.getReference())
        && (FEDEX.equalsIgnoreCase(shippingProfile) || USPS.equalsIgnoreCase(shippingProfile)
            || DHL.equalsIgnoreCase(shippingProfile)))
      shippingUnitDto.setReferences(
          getReferences(packagingDetails.getReference(), shippingProfile));
  }

  private static List<ReferencesDto> getReferences(Reference pkgReference, String shippingProfile) {
    return USPS.equalsIgnoreCase(shippingProfile) || DHL.equalsIgnoreCase(shippingProfile)
        ? prepareReferencesDtos(
            pkgReference.getReference1(),
            pkgReference.getReference2(),
            pkgReference.getReference3(),
            pkgReference.getReference4(),
            pkgReference.getInternalDesignationReference(),
            pkgReference.getPharmacyOrderNumber())
        :

        // Add references to the list for FedEx
        // ASP FIELD       | SENDFLEX REQUEST INDEX | Label mapping
        // LabelReference1 | 1                      | PO
        // LabelReference2 | 2                      | INV
        // LabelReference3 | 0                      | Ref
        prepareReferencesDtos(
            pkgReference.getReference3(),
            pkgReference.getReference1(),
            pkgReference.getReference2(),
            pkgReference.getReference4(),
            pkgReference.getInternalDesignationReference(),
            pkgReference.getPharmacyOrderNumber());
  }

  private static List<ReferencesDto> prepareReferencesDtos(
      String value1, String value2, String value3, String value4, String value5, String value6) {
    return List.of(
        ReferencesDto.builder().name(REFERENCE1).value(value1).build(),
        ReferencesDto.builder().name(REFERENCE2).value(value2).build(),
        ReferencesDto.builder().name(REFERENCE3).value(value3).build(),
        ReferencesDto.builder().name(REFERENCE4).value(value4).build(),
        ReferencesDto.builder().name(REFERENCE5).value(value5).build(),
        ReferencesDto.builder().name(REFERENCE6).value(value6).build());
  }

  private static void setCarrierAddOnToShippingUnitDto(
      ShippingUnitDto shippingUnitDto,
      PackagingDetails packagingDetails,
      AdditionalAccessorial additionalAccessorial,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    Map<String, List<CarrierAddOnKeyValue>> carrierAddOns = new HashMap<>();

    setHcid(packagingDetails, carrierAddOns);

    if (Objects.nonNull(packagingDetails.getAccessorials())
        && FEDEX.equalsIgnoreCase(shippingProfile)) {

      if (Boolean.TRUE.equals(packagingDetails.getPackaging().getIsIndividualShipmentProtection())
          && Boolean.FALSE.equals(isUserEnrolledInOSP)) {
        throw new ValidationException(
            "User is not eligible for Opti Freight shipment protection "
                + "but in request it has been opted in, not expected behaviour");
      }

      setCarrierAddOnsKeyValue(
          packagingDetails.getPackaging().getPackagingType(),
          packagingDetails.getAccessorials(),
          additionalAccessorial,
          carrierAddOns,
          shippingProfile,
          isUserEnrolledInOSP);
      shippingUnitDto.setCarrierAddOns(carrierAddOns);
    } else {
      setCarrierAddOnsKeyValueForUSPSAndDHL(
          packagingDetails.getAccessorials(),
          carrierAddOns,
          shippingProfile,
          shipmentBookRequest,
          isUserEnrolledInOSP);
      shippingUnitDto.setCarrierAddOns(carrierAddOns);
    }
  }

  private static void setHcid(
      PackagingDetails packagingDetails, Map<String, List<CarrierAddOnKeyValue>> carrierAddOnsMap) {
    if (!CollectionUtils.isEmpty(packagingDetails.getPackaging().getHcidCode())) {
      for (HCIDCode hcidCode : packagingDetails.getPackaging().getHcidCode()) {
        String apiValue = HcidService.getApiValue(hcidCode.getCode());
        if (StringUtils.isNotEmpty(apiValue)) {
          carrierAddOnsMap.put(apiValue, null);
        }
      }
    }
  }

  private static void setCarrierAddOnsKeyValue(
      String packagingType,
      Accessorials accessorials,
      AdditionalAccessorial additionalAccessorial,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      Boolean isUserEnrolledInOSP) {

    if (accessorials.isContainsDryIce() && shippingProfile.equalsIgnoreCase(FEDEX)) {
      carrierAddOns.put(DRY_ICE, getDryIce(accessorials.getWeight()));
    }

    List<CarrierAddOnKeyValue> insuranceAddOns =
        ShipmentProtectionMapperUtil.getInsuranceForShipBook(
            shippingProfile, isUserEnrolledInOSP, accessorials);
    if (!insuranceAddOns.isEmpty()) {
      carrierAddOns.put(INSURANCE, insuranceAddOns);
    }

    if (accessorials.isLithiumBattery()
        && PACKAGING_TYPE.equals(packagingType)
        && shippingProfile.equalsIgnoreCase(FEDEX)) {
      setLithiumBattery(accessorials, carrierAddOns);
    }

    if (canGetSignature(additionalAccessorial) && FEDEX.equalsIgnoreCase(shippingProfile)) {
      carrierAddOns.put(getSignature(additionalAccessorial.getSignatureLevel()), null);
    }
  }

  private static List<CarrierAddOnKeyValue> getDryIce(float dryIceWeight) {
    return List.of(
        CarrierAddOnKeyValue.builder()
            .key(DRY_ICE_WEIGHT)
            .value(String.valueOf(dryIceWeight))
            .build());
  }

  private static void setLithiumBattery(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns) {
    List<CarrierAddOnKeyValue> lithiumBatteryAddOns = new ArrayList<>();
    if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) {
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_METAL).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(PACKING).value(CONTAINED_IN_EQUIPMENT).build());
    }
    if (Boolean.TRUE.equals(accessorials.getMetalPackedWithEquipment())) {
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_METAL).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
    }
    if (Boolean.TRUE.equals(accessorials.getIonContainedInEquipment())) {
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_ION).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(PACKING).value(CONTAINED_IN_EQUIPMENT).build());
    }
    if (Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) {
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_ION).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
    }
    if (Boolean.TRUE.equals(accessorials.getIonStandalone())) {
      lithiumBatteryAddOns.add(
              CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_ION).build());
      lithiumBatteryAddOns.add(
              CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_STANDALONE).build());
    }
    if (Boolean.TRUE.equals(accessorials.getMetalStandalone())) {
      lithiumBatteryAddOns.add(
              CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_METAL).build());
      lithiumBatteryAddOns.add(
              CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_STANDALONE).build());
    }
    if (!lithiumBatteryAddOns.isEmpty()) carrierAddOns.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
  }

  private static boolean canGetSignature(AdditionalAccessorial additionalAccessorial) {
    return additionalAccessorial.isSignatureRequired()
        && !additionalAccessorial.getSignatureLevel().isBlank();
  }

  private static String getSignature(String signature) {
    switch (signature) {
      case INDIRECT_SIGNATURE_REQUIRED:
        signature = "DeliveryIndirectSignatureRequired";
        break;
      case SERVICE_DEFAULT:
        signature = DELIVERYNOSIGNATURERE;
        break;
      case ADULT_SIGNATURE_REQUIRED:
        signature = DELIVERYADULTSIGNATUREREQUIRED;
        break;
      case DIRECT_SIGNATURE_REQUIRED:
        signature = DELIVERYDIRECTSIGNATUREREQUIRED;
        break;
      default:
        signature = "";
        break;
    }
    return signature;
  }

  private static void setCarrierAddOnsKeyValueForUSPSAndDHL(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {

    switch (shipmentBookRequest.getShipViaOptions().get(0).getCode()) {
      case USPSPME, USPSPME_LIVE:
        validateAndAddUSPSPMEAccessorials(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      case USPSP, USPS_LIVE:
        validateAndAddUSPSPAccessorials(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      case USPSRG, USPSRG_LIVE:
        validateAndAddUSPSRGAccessorials(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      case DHLG, DHLE, DHLEM:
        validateAndAddDHLAccessorials(
            accessorials, carrierAddOns, shipmentBookRequest);
        break;

      default:
        break;
    }
  }

  private static void validateAndAddDHLAccessorials(Accessorials accessorials, Map<String, List<CarrierAddOnKeyValue>> carrierAddOns, ShipmentBookRequest shipmentBookRequest) {
    setLithiumBattery(accessorials, carrierAddOns);
    addSignature(shipmentBookRequest, carrierAddOns);
  }

  private static void validateAndAddUSPSPMEAccessorials(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    addInsurance(accessorials, carrierAddOns, shippingProfile, isUserEnrolledInOSP);
    addLithiumBattery(accessorials, carrierAddOns);
    addSignature(shipmentBookRequest, carrierAddOns);
    validateDryIceAndLithiumBattery(accessorials, USPSPME);
    addDryIce(accessorials, carrierAddOns);
  }

  private static void validateAndAddUSPSPAccessorials(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    addInsurance(accessorials, carrierAddOns, shippingProfile, isUserEnrolledInOSP);
    addLithiumBattery(accessorials, carrierAddOns);
    addSignature(shipmentBookRequest, carrierAddOns);
    validateDryIceAndLithiumBattery(accessorials, USPSP);
    addDryIce(accessorials, carrierAddOns);
    carrierAddOnsMustBeUnderTwo(carrierAddOns);
  }

  private static void validateAndAddUSPSRGAccessorials(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    if (Boolean.TRUE.equals(accessorials.getAddOnInsurance())
        && Objects.nonNull(accessorials.getAddOnInsuranceValue())) {
      if (shipmentBookRequest.getAdditionalAccessorial().isSignatureRequired()
          && accessorials.getAddOnInsuranceValue() > 500) {
        throw new ValidationException(
            "signature is not required for insurance "
                + "amount more than 500 for service level USPSRG");
      }
      List<CarrierAddOnKeyValue> insuranceAddOns =
          ShipmentProtectionMapperUtil.getInsuranceForShipBook(
              shippingProfile, isUserEnrolledInOSP, accessorials);
      carrierAddOns.put(INSURANCE, insuranceAddOns);
    }
    addLithiumBattery(accessorials, carrierAddOns);
    addSignature(shipmentBookRequest, carrierAddOns);
    validateDryIceAndLithiumBattery(accessorials, USPSRG);
    addDryIce(accessorials, carrierAddOns);
    carrierAddOnsMustBeUnderTwo(carrierAddOns);
  }

  private static void carrierAddOnsMustBeUnderTwo(
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns) {
    if (carrierAddOns.size() > 2) {
      throw new ValidationException(
          "Only 2 carrier add-ons may be selected from: "
              + "Lithium Battery, Insurance, Dry Ice and Delivery Signature");
    }
  }

  private static void addInsurance(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns,
      String shippingProfile,
      Boolean isUserEnrolledInOSP) {

    List<CarrierAddOnKeyValue> insuranceAddOns =
        ShipmentProtectionMapperUtil.getInsuranceForShipBook(
            shippingProfile, isUserEnrolledInOSP, accessorials);
    if (!insuranceAddOns.isEmpty()) {
      carrierAddOns.put(INSURANCE, insuranceAddOns);
    }
  }

  private static void addLithiumBattery(
      Accessorials accessorials, Map<String, List<CarrierAddOnKeyValue>> carrierAddOns) {
    if (accessorials.isLithiumBattery()) {
      List<CarrierAddOnKeyValue> lithiumBatteryAddOns = new ArrayList<>();
      addMetalContainedInEquipment(accessorials, lithiumBatteryAddOns);
      if (accessorials.getMetalPackedWithEquipment()
          || accessorials.getIonContainedInEquipment()
          || Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) {
        lithiumBatteryAddOns.add(
            CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_ION).build());
        lithiumBatteryAddOns.add(
            CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
      }
      if (!lithiumBatteryAddOns.isEmpty()) carrierAddOns.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
    }
  }

  private static void addMetalContainedInEquipment(
      Accessorials accessorials, List<CarrierAddOnKeyValue> lithiumBatteryAddOns) {
    if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) {
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(MATERIAL).value(LITHIUM_ION).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnKeyValue.builder().key(PACKING).value(PACKED_STANDALONE).build());
    }
  }

  private static void addSignature(
      ShipmentBookRequest shipmentBookRequest,
      Map<String, List<CarrierAddOnKeyValue>> carrierAddOns) {
    if (shipmentBookRequest.getAdditionalAccessorial().isSignatureRequired()) {
      carrierAddOns.put(DELIVERYSIGNATUREREQUIRED, null);
    }
  }

  private static void validateDryIceAndLithiumBattery(
      Accessorials accessorials, String serviceLevel) {
    if (accessorials.isLithiumBattery() && accessorials.isContainsDryIce()) {
      throw new ValidationException(
          "Dry Ice and Lithium Battery cannot be selected together as carrier add-ons for "
              + serviceLevel);
    }
  }

  private static void addDryIce(
      Accessorials accessorials, Map<String, List<CarrierAddOnKeyValue>> carrierAddOns) {
    if (accessorials.isContainsDryIce()) {
      carrierAddOns.put(DRY_ICE, getDryIce(accessorials.getWeight()));
    }
  }

  private static PickupOptionsDto buildPickupOptionsDto(ShipmentBookRequest shipmentBookRequest) {
    AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();
    OffsetDateTime shipByDate = OffsetDateTime.parse(shipmentBookRequest.getShipByDate());
    return getPickupOptionsDto(additionalAccessorial, shipmentBookRequest, shipByDate);
  }

  private static PickupOptionsDto getPickupOptionsDto(
      AdditionalAccessorial additionalAccessorial,
      ShipmentBookRequest shipmentBookRequest,
      OffsetDateTime shipByDate) {
    if (!shipByDate.toLocalDate().isBefore(LocalDate.now())) {
      return PickupOptionsDto.builder()
          .pickupInstructions(additionalAccessorial.getSpecialInstructions())
          .pickupAfter(additionalAccessorial.getReadyTime())
          .pickupBefore(shipmentBookRequest.getShipByDate())
          .build();
    } else throw new ValidationException("shipByDate cant be a past date");
  }

  private static Map<String, Object> getCarrierAddOns(ShipmentBookRequest shipmentBookRequest) {

    Map<String, Object> carrierAddOns = new HashMap<>();
    AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();
    if (Objects.nonNull(additionalAccessorial)) {
      addEmailNotifications(additionalAccessorial, carrierAddOns);
      addInterventionService(additionalAccessorial, carrierAddOns, shipmentBookRequest);
    }
    return carrierAddOns;
  }

  private static void addEmailNotifications(
      AdditionalAccessorial additionalAccessorial, Map<String, Object> carrierAddOns) {
    if (canGetEmailUpdates(additionalAccessorial)) {
      if (canGetNotifications(additionalAccessorial, 0)) {
        carrierAddOns.putAll(
            getNotifications(SENDER, additionalAccessorial.getNotification().get(0).getNotify()));
      }
      if (1 < additionalAccessorial.getNotification().size()
          && canGetNotifications(additionalAccessorial, 1)) {
        carrierAddOns.putAll(
            getNotifications(RECEIVER, additionalAccessorial.getNotification().get(1).getNotify()));
      }
    }
  }

  private static boolean canGetEmailUpdates(AdditionalAccessorial additionalAccessorial) {
    return additionalAccessorial.isSubscribeToEmailUpdate()
        && !CollectionUtils.isEmpty(additionalAccessorial.getNotification());
  }

  private static boolean canGetNotifications(
      AdditionalAccessorial additionalAccessorial, int index) {
    return !additionalAccessorial.getNotification().get(index).getEmail().isBlank()
        && !additionalAccessorial.getNotification().get(index).getNotify().isEmpty();
  }

  private static Map<String, Object> getNotifications(
      String emailType, List<String> notificationList) {

    Map<String, Object> notifications = new HashMap<>();

    for (String notification : notificationList) {
      switch (notification) {
        case NOTIFICATION_ON_DELIVERY:
          notifications.put(NOTIFICATION + emailType + DELIVERYEMAIL, null);
          break;
        case NOTIFICATION_ON_SHIPMENT:
          notifications.put(NOTIFICATION + emailType + SHIPMENTEMAIL, null);
          break;
        case NOTIFICATION_ON_PICKUP:
          notifications.put(NOTIFICATION + emailType + PICKUPSECUREDEMAIL, null);
          break;
        case NOTIFICATION_ON_EXCEPTION:
          notifications.put(NOTIFICATION + emailType + EXCEPTIONEMAIL, null);
          break;
        default:
          break;
      }
    }
    return notifications;
  }

  private static void addInterventionService(
      AdditionalAccessorial additionalAccessorial, Map<String, Object> carrierAddOns, ShipmentBookRequest shipmentBookRequest) {
    if (StringUtils.isNotBlank(additionalAccessorial.getInterventionService())) {
      String intervention = additionalAccessorial.getInterventionService();
      if (intervention.equalsIgnoreCase(FEDEX_SURROUND_PREFERRED)) {
        carrierAddOns.put("FedExSurroundPreferred", null);
      } else if (intervention.equalsIgnoreCase(FEDEX_SURROUND_PREMIUM)) {
        carrierAddOns.put("FedExSurroundPremium", null);
      }
    }
    else {
        setDefaultIfHcidIsPresent(carrierAddOns, shipmentBookRequest);
    }
  }

    private static void setDefaultIfHcidIsPresent(Map<String, Object> carrierAddOns, ShipmentBookRequest shipmentBookRequest) {
        for (PackagingDetails packagingDetails : shipmentBookRequest.getPackagingDetails()) {
            if (CollectionUtils.isEmpty(packagingDetails.getPackaging().getHcidCode())) {
                continue;
            }
            for (HCIDCode hcidCode : packagingDetails.getPackaging().getHcidCode()) {
                String apiValue = HcidService.getApiValue(hcidCode.getCode());
                if (StringUtils.isNotEmpty(apiValue)) {
                    carrierAddOns.put(FEDEX_SURROUND_SELECT_SENDFLEX, null);
                    return;
                }
            }
        }
    }

    private static PayorDto getPayorDto(ShipmentBookRequest shipmentBookRequest) {
    BillingInformation billingInformation =
        Optional.of(shipmentBookRequest)
            .map(ShipmentBookRequest::getBillingInformation)
            .orElse(BillingInformation.builder().build());
    String accountNumber =
        (StringUtils.isEmpty(billingInformation.getNonOptiFreightNumber()))
            ? billingInformation.getOptiFreightNumber()
            : billingInformation.getNonOptiFreightNumber();
    // non optifrieght number comes, consider non optifrieght, otherwise optifrieght
    return PayorDto.builder()
        .type("ThirdParty")
        .account(Optional.ofNullable(accountNumber).orElse(BLANK))
        .build();
  }

  @NotNull
  private static RequestedEmailNotification buildRequestedEmailNotification(
      ShipmentBookRequest shipmentBookRequest) {

    List<EmailRecipient> emailRecipients =
        shipmentBookRequest.getAdditionalAccessorial().getNotification().stream()
            .map(
                notification ->
                    EmailRecipient.builder()
                        .emailType("To")
                        .notificationRecipientType(notification.getRecipientType())
                        .notificationTriggerTypes(getNotifyTypes(notification))
                        .name(BLANK) // left blank, not currently able to retrieve this
                        .emailAddress(notification.getEmail())
                        .build())
            .toList();

    return RequestedEmailNotification.builder()
        .emailFormatType("HTML")
        .sender("")
        .emailRecipients(emailRecipients)
        .build();
  }

  @NotNull
  private static List<String> getNotifyTypes(Notifications notifications) {

    return notifications.getNotify().stream()
        .map(category -> REQUEST_EMAIL_NOTIFICATIONS_TRIGGER_TYPES.getOrDefault(category, "Error"))
        .toList();
  }

  /** Setting carrier add-ons key value for USPS for ship plan */
  public static void setCarrierAddOnsKeyValueForUSPSForShipPlan(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {

    String shipViaCode = shipmentBookRequest.getShipViaOptions().get(0).getCode();
    switch (shipViaCode) {
      case USPSPME, USPSPME_LIVE:
        validateAndAddUSPSPMEAccessorialsPlan(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      case USPSP, USPS_LIVE:
        validateAndAddUSPSPAccessorialsPlan(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      case USPSRG, USPSRG_LIVE:
        validateAndAddUSPSRGAccessorialsPlan(
            accessorials, carrierAddOns, shippingProfile, shipmentBookRequest, isUserEnrolledInOSP);
        break;

      default:
        break;
    }
  }

  private static void validateAndAddUSPSPMEAccessorialsPlan(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    addInsuranceForShipPlan(accessorials, carrierAddOns, shippingProfile, isUserEnrolledInOSP);
    addLithiumBatteryForShipPlan(accessorials, carrierAddOns);
    addSignatureForShipPlan(shipmentBookRequest, carrierAddOns);
    if (accessorials.isLithiumBattery() && accessorials.isContainsDryIce()) {
      throw new ValidationException(
          "Dry Ice and Lithium Battery cannot be selected together as carrier add-ons for USPSPME");
    }
    addDryIceForShipPlan(accessorials, carrierAddOns);
  }

  private static void validateAndAddUSPSPAccessorialsPlan(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    addInsuranceForShipPlan(accessorials, carrierAddOns, shippingProfile, isUserEnrolledInOSP);
    addLithiumBatteryForShipPlan(accessorials, carrierAddOns);
    addSignatureForShipPlan(shipmentBookRequest, carrierAddOns);
    validateDryIceAndLithiumBattery(accessorials, USPSP);
    addDryIceForShipPlan(accessorials, carrierAddOns);
    noMoreThanTwoCarrierAddOns(carrierAddOns);
  }

  private static void validateAndAddUSPSRGAccessorialsPlan(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns,
      String shippingProfile,
      ShipmentBookRequest shipmentBookRequest,
      Boolean isUserEnrolledInOSP) {
    if (Boolean.TRUE.equals(accessorials.getAddOnInsurance())
        && Objects.nonNull(accessorials.getAddOnInsuranceValue())) {
      if (shipmentBookRequest.getAdditionalAccessorial().isSignatureRequired()
          && accessorials.getAddOnInsuranceValue() > 500) {
        throw new ValidationException(
            "signature is not required for insurance "
                + "amount more than 500 for service level USPSRG");
      }
      List<CarrierAddOnsDTO> insuranceAddOns =
          getInsuranceForShipPlan(accessorials.getAddOnInsuranceValue(), shippingProfile, isUserEnrolledInOSP);
      carrierAddOns.put(INSURANCE, insuranceAddOns);
    }
    addLithiumBatteryForShipPlan(accessorials, carrierAddOns);
    addSignatureForShipPlan(shipmentBookRequest, carrierAddOns);
    validateDryIceAndLithiumBattery(accessorials, USPSRG);
    addDryIceForShipPlan(accessorials, carrierAddOns);
    noMoreThanTwoCarrierAddOns(carrierAddOns);
  }

  private static void noMoreThanTwoCarrierAddOns(
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns) {
    if (carrierAddOns.size() > 2) {
      throw new ValidationException(
          "Only 2 carrier add-ons may be selected from: "
              + "Lithium Battery, Insurance, Dry Ice and Delivery Signature");
    }
  }

  private static void addInsuranceForShipPlan(
      Accessorials accessorials,
      Map<String, List<CarrierAddOnsDTO>> carrierAddOns,
      String shippingProfile,
      Boolean isUserEnrolledInOSP) {
    if (Boolean.TRUE.equals(accessorials.getAddOnInsurance())
        && Objects.nonNull(accessorials.getAddOnInsuranceValue())) {
      List<CarrierAddOnKeyValue> insuranceAddOnShipBook =
          ShipmentProtectionMapperUtil.getInsuranceForShipBook(
              shippingProfile, isUserEnrolledInOSP, accessorials);

      List<CarrierAddOnsDTO> insuranceAddOns =
          ShipmentProtectionMapperUtil.convertCarrierAddOnType(insuranceAddOnShipBook);

      if (!insuranceAddOns.isEmpty()) {
        carrierAddOns.put(INSURANCE, insuranceAddOns);
      }
    }
  }

  private static void addLithiumBatteryForShipPlan(
      Accessorials accessorials, Map<String, List<CarrierAddOnsDTO>> carrierAddOns) {
    if (accessorials.isLithiumBattery()) {
      List<CarrierAddOnsDTO> lithiumBatteryAddOns = new ArrayList<>();
      addMetalContainedInEquipmentPlan(accessorials, lithiumBatteryAddOns);
      if (accessorials.getMetalPackedWithEquipment()
          || accessorials.getIonContainedInEquipment()
          || Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) {
        lithiumBatteryAddOns.add(
            CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
        lithiumBatteryAddOns.add(
            CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_WITH_EQUIPMENT).build());
      }
      if (!lithiumBatteryAddOns.isEmpty()) carrierAddOns.put(LITHIUM_BATTERY, lithiumBatteryAddOns);
    }
  }

  private static void addMetalContainedInEquipmentPlan(
      Accessorials accessorials, List<CarrierAddOnsDTO> lithiumBatteryAddOns) {
    if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) {
      lithiumBatteryAddOns.add(CarrierAddOnsDTO.builder().key(MATERIAL).value(LITHIUM_ION).build());
      lithiumBatteryAddOns.add(
          CarrierAddOnsDTO.builder().key(PACKING).value(PACKED_STANDALONE).build());
    }
  }

  private static void addSignatureForShipPlan(
      ShipmentBookRequest shipmentBookRequest, Map<String, List<CarrierAddOnsDTO>> carrierAddOns) {
    if (shipmentBookRequest.getAdditionalAccessorial().isSignatureRequired()) {
      carrierAddOns.put("DeliverySignatureRequired", null);
    }
  }

  private static void addDryIceForShipPlan(
      Accessorials accessorials, Map<String, List<CarrierAddOnsDTO>> carrierAddOns) {
    if (accessorials.isContainsDryIce()) {
      carrierAddOns.put(DRY_ICE, getDryIceForShipPlan(accessorials.getWeight()));
    }
  }

  private static List<CarrierAddOnsDTO> getDryIceForShipPlan(float dryIceWeight) {
    return List.of(
        CarrierAddOnsDTO.builder()
            .key(DRY_ICE_WEIGHT)
            .value(String.valueOf(dryIceWeight))
            .build());
  }

  private static List<CarrierAddOnsDTO> getInsuranceForShipPlan(
      Double valueOfContent, String shippingProfile, boolean isEnrolledInOSP) {

    var minValue = 100;
    int maxValue = FEDEX.equals(shippingProfile) ? 50000 : 5000;

    if (valueOfContent < minValue || valueOfContent > maxValue) {
      throw new IllegalArgumentException(
          "Value of content must be between " + minValue + " and " + maxValue + " USD.");
    }

    if (FEDEX.equals(shippingProfile) && isEnrolledInOSP) {
      // If enrolled in OSP, do not send declared value and insurance to Sendflex
      return List.of();
    } else {
      // For USPS or FedEx without OSP enrollment, send declared value and insurance
      return List.of(
          CarrierAddOnsDTO.builder()
              .key(INSURANCE_VALUE)
              .value(String.valueOf(valueOfContent))
              .build());
    }
  }
}

