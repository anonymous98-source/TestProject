    /**
     * Retrieves the details of documents accepted by the user.
     *
     * @param request          the request object containing version details needed to fetch the documents.
     * @param oflUserPrincipal the principal object containing user authentication and identity details
     * @return a response DTO containing the user details, accepted documents, all documents links, and the operation status
     */
    @Override
    public GetUserAcceptedDocsResponseDTO getUserAcceptedDocsDetails(GetUserAcceptedDocsRequestDTO request, OflUserPrincipal oflUserPrincipal) {
        log.atInfo().setMessage("Request received to fetch user accepted documents details").log();

        var executor = customExecutor.getExecutor();
        List<String> errorMessages = new ArrayList<>();
        Map<String, DocumentTypes> docTypeToEnumMap = DocumentTypes.getDocTypeToEnumMap();

        CompletableFuture<GetUserAcceptedDocsResponseDTO.GetUserAcceptedDocsResponseDTOBuilder> pipeline = CompletableFuture.supplyAsync(() -> {
            OflUser oflUser = getOflUserByUserName(oflUserPrincipal.getUserName());
            User userDetails = getOrCreateUserDetails(oflUserPrincipal, oflUser);
            return Map.entry(oflUser, userDetails);
        }, executor).thenComposeAsync(userDetailsEntry -> {
            OflUser oflUser = userDetailsEntry.getKey();
            User userDetails = userDetailsEntry.getValue();

            var documents = getDocuments(request, errorMessages);

            CompletableFuture<List<GetUserAcceptedDocsResponseDTO.Document>> legalDocumentsFuture =
                    CompletableFuture.supplyAsync(() -> getLegalDocumentsList(documents, docTypeToEnumMap), executor);
            CompletableFuture<List<GetUserAcceptedDocsResponseDTO.AcceptedDocument>> acceptedDocumentsListFuture =
                    CompletableFuture.supplyAsync(() -> getAcceptedDocumentsList(documents, userDetails.getId(), docTypeToEnumMap), executor);
            CompletableFuture<GetUserAcceptedDocsResponseDTO.User> userFuture =
                    CompletableFuture.supplyAsync(() -> getUserData(oflUser, userDetails), executor);

            return CompletableFuture.allOf(legalDocumentsFuture, acceptedDocumentsListFuture, userFuture)
                    .thenApply(v -> GetUserAcceptedDocsResponseDTO.builder()
                            .allDocuments(legalDocumentsFuture.join())
                            .user(userFuture.join())
                            .acceptedDocuments(acceptedDocumentsListFuture.join()));
        }, executor);

        return pipeline.join()
                .status(ServiceCommonConstants.SUCCESS)
                .errorMessages(errorMessages)
                .build();
    }

    /**
     * Saves the details of user-accepted documents. This method validates the existence of the documents and
     * ensures that the user has not already accepted them before saving the acceptance details.
     *
     * @param requestDTO         the request object containing the list of document IDs to be accepted by the user
     * @param oflUserPrincipal   the principal object containing user context and authentication details
     * @param httpServletRequest the HTTP request object for retrieving client details such as IP address and browser type
     * @return an instance of SaveUserAcceptedDocsResponseDTO containing the status and any relevant error messages
     */
    @Override
    public SaveUserAcceptedDocsResponseDTO saveUserAcceptedDocsDetails(SaveUserAcceptedDocsRequestDTO requestDTO, OflUserPrincipal oflUserPrincipal, HttpServletRequest httpServletRequest) {
        log.atInfo()
                .setMessage("Request received to save user accepted documents details")
                .log();

        OflUser oflUser = getOflUserByUserName(oflUserPrincipal.getUserName());
        User userDetails = getUserDetailsByMonarchId(oflUser.getId());

        log.atInfo()
                .setMessage("Fetching documents using their IDs")
                .log();
        var documents = documentsRepository.findByIdIn(requestDTO.getDocuments());

        Set<UUID> foundIds = documents.stream()
                .map(Documents::getId)
                .collect(Collectors.toSet());

        validateDocumentsExist(foundIds, requestDTO);
        validateDocumentTypes(documents);

        log.atInfo()
                .setMessage("Fetching user document acceptance")
                .log();
        List<UserDocumentsAcceptance> userDocumentsAcceptances = userDocumentsAcceptanceRepository.findByDocumentsIdInAndUserId(foundIds.stream().toList(), userDetails.getId());

        if (!userDocumentsAcceptances.isEmpty()) {
            Set<UUID> alreadyAcceptedDocIds = userDocumentsAcceptances.stream()
                    .map(userDocumentsAcceptance -> userDocumentsAcceptance.getDocuments().getId())
                    .collect(Collectors.toSet());
            throw new ValidationException(ServiceCommonConstants.USER_ALREADY_ACCEPTED_DOCS + ": " + alreadyAcceptedDocIds);
        }

        Map<UUID, Documents> documentsMap = documents.stream()
                .collect(Collectors.toMap(Documents::getId, doc -> doc));

        List<UserDocumentsAcceptance> newAcceptances = foundIds.stream()
                .<UserDocumentsAcceptance>map(docId -> UserDocumentsAcceptance.builder()
                        .acceptedTime(LocalDateTime.now(ZoneOffset.UTC))
                        .sourceIpAddress(HttpServletUtils.getClientIpAddress(httpServletRequest))
                        .browserType(HttpServletUtils.getBrowserUserAgent(httpServletRequest))
                        .user(userDetails)
                        .documents(documentsMap.get(docId))
                        .build())
                .toList();

        saveUserDocumentsAcceptance(newAcceptances);

        log.atInfo()
                .setMessage("Saved User Accepted Documents successfully.")
                .log();
        return SaveUserAcceptedDocsResponseDTO.builder()
                .status(ServiceCommonConstants.SUCCESS)
                .errorMessages(List.of())
                .build();
    }

    private User getOrCreateUserDetails(OflUserPrincipal oflUserPrincipal, OflUser oflUser) {
        User userDetails = userDetailsService.findOrUpdateUser(oflUser.getId(), oflUser.getEmail());
        return userDetails != null ? userDetails :
                userDefaultsService.saveUserDetails(oflUserPrincipal, oflUser);
    }

    private void checkIfVersionExist(Map<String, String> docTypeToVersionMap, List<Documents> documents, List<String> errorMessages) {
        docTypeToVersionMap.forEach((docType, version) -> {
            if (version != null && documents.stream()
                    .noneMatch(doc -> doc.getType().equals(docType))) {
                errorMessages.add(String.format(ServiceCommonConstants.DOC_VERSION_NOT_FOUND, docType, version));
            }
        });
    }

    private void validateDocumentsExist(Set<UUID> foundIds, SaveUserAcceptedDocsRequestDTO requestDTO) {

        List<UUID> missingIds = requestDTO.getDocuments().stream()
                .filter((UUID id) -> !foundIds.contains(id))
                .toList();

        if (!missingIds.isEmpty()) {
            throw new ResourceNotFoundException(ServiceCommonConstants.DOCUMENTS_NOT_FOUND + ": " + missingIds);
        }
    }

    private void validateDocumentTypes(List<Documents> documents) {
        Set<String> validTypes = DocumentTypes.getIncludedInTermsAndConditionsDocumentTypes()
                .stream()
                .map(DocumentTypes::getType)
                .collect(Collectors.toSet());

        List<String> invalidTypes = documents.stream()
                .map(Documents::getType)
                .filter(type -> !validTypes.contains(type))
                .toList();

        if (!invalidTypes.isEmpty()) {
            throw new ValidationException(ServiceCommonConstants.INVALID_DOC_TYPE_FOUND + ": " + invalidTypes);
        }
    }

    private void saveUserDocumentsAcceptance(List<UserDocumentsAcceptance> newAcceptances) {
        try {
            userDocumentsAcceptanceRepository.saveAll(newAcceptances);
        } catch (Exception e) {
            throw new DatabaseException(ServiceCommonConstants.USER_ACCEPTANCE_SAVE_FAILED,e);
        }
    }

    private OflUser getOflUserByUserName(String userName) {
        return Optional.ofNullable(userService.getUser(userName))
                .orElseThrow(() -> new ResourceNotFoundException(ServiceCommonConstants.USER_DATA_NOT_FOUND));
    }

    private User getUserDetailsByMonarchId(UUID monarchUserId) {
        return userRepository.findByMonarchUserId(monarchUserId)
                .orElseThrow(() -> new ResourceNotFoundException(ServiceCommonConstants.USER_DATA_NOT_FOUND));
    }

    private List<Documents> getDocuments(GetUserAcceptedDocsRequestDTO request, List<String> errorMessages) {
        Map<String, String> docTypeToVersionMap = getDocumentTypeToVersionMap(request);
        log.atInfo().setMessage("Retrieving data from documents table").log();
        var documents = documentsCustomRepository.findDocumentsByTypeAndVersion(docTypeToVersionMap);
        checkIfVersionExist(docTypeToVersionMap, documents, errorMessages);
        return documents;
    }

    private List<GetUserAcceptedDocsResponseDTO.AcceptedDocument> getAcceptedDocumentsList(
            List<Documents> documents,
            UUID userId,
            Map<String, DocumentTypes> docTypeToEnumMap
    ) {
        log.atInfo().setMessage("Retrieving user documents acceptance data").log();
        List<UserDocumentsAcceptance> userDocumentsAcceptances =
                userDocumentsAcceptanceRepository.findByDocumentsIdInAndUserId(documents.stream().map(Documents::getId).toList(), userId);

        List<GetUserAcceptedDocsResponseDTO.AcceptedDocument> acceptedDocuments = new ArrayList<>();
        for (UserDocumentsAcceptance acceptance : userDocumentsAcceptances) {
            acceptedDocuments.add(GetUserAcceptedDocsResponseDTO.AcceptedDocument.builder()
                    .docId(acceptance.getDocuments().getId())
                    .version(acceptance.getDocuments().getVersion())
                    .name(docTypeToEnumMap.get(acceptance.getDocuments().getType()).getName())
                    .acceptedAt(acceptance.getAcceptedTime().toString())
                    .build()
            );
        }
        return acceptedDocuments;
    }

    private List<GetUserAcceptedDocsResponseDTO.Document> getLegalDocumentsList(
            List<Documents> documents,
            Map<String, DocumentTypes> docTypeToEnumMap
    ) {
        log.atInfo().setMessage("Retrieving legal documents list with encoded content").log();

        List<String> filePaths = documents.stream().map(Documents::getFilePath).toList();
        String bucketName = advShippingIntegrationApiProperties.getFileStorageBucketName();

        Map<String, String> encodedContentByFilePath =
                gcsService.getEncodedLegalDocFileContentsBulk(filePaths, bucketName);

        return documents.stream()
                .map(doc -> {
                    String encoded = encodedContentByFilePath.get(doc.getFilePath());
                    if (encoded == null) {log.atError()
                            .setMessage("No encoded content found for doc type: {}")
                            .addArgument(doc.getType())
                            .addKeyValue("docType", doc.getType())
                            .log();
                        throw new DatabaseException(String.format(ServiceCommonConstants.DOC_ENCODE_FAIL, doc.getType()));
                    }
                    return GetUserAcceptedDocsResponseDTO.Document.builder()
                            .docId(doc.getId())
                            .name(docTypeToEnumMap.get(doc.getType()).getName())
                            .version(doc.getVersion())
                            .fileName(doc.getFilePath().substring(doc.getFilePath().lastIndexOf('/') + 1))
                            .content(encoded)
                            .build();
                })
                .toList();
    }

    private Map<String, String> getDocumentTypeToVersionMap(GetUserAcceptedDocsRequestDTO request) {
        Map<String, String> docTypeToVersionMap = new HashMap<>();

        docTypeToVersionMap.put(DocumentTypes.END_USER_LICENSE_AGREEMENT.getType(), request.getEndUserLicenseAgreement());
        docTypeToVersionMap.put(DocumentTypes.TERMS_OF_SERVICE.getType(), request.getTermsOfService());
        docTypeToVersionMap.put(DocumentTypes.CARRIER_VENDOR_TERMS.getType(), request.getCarrierVendorTerms());
        docTypeToVersionMap.put(DocumentTypes.PRIVACY_POLICY.getType(), request.getPrivacyPolicy());
        docTypeToVersionMap.put(DocumentTypes.OSP_TERMS_AND_CONDITIONS.getType(), request.getOspTermsAndConditions());
        docTypeToVersionMap.put(DocumentTypes.PRICING_DISCLAIMER.getType(), request.getPricingDisclaimer());

        return docTypeToVersionMap;
    }

    /**
     * Constructs and returns a User object with user information and the status of
     * their document acceptance.
     *
     * @param oflUser     the user for whom the information is being retrieved
     * @param userDetails Details about the user
     * @return a GetUserAcceptedDocsResponseDTO.User object containing the user's ID, roles,
     * and a boolean indicating whether the user has approved all terms and conditions
     */
    private GetUserAcceptedDocsResponseDTO.User getUserData(OflUser oflUser, User userDetails) {
        // Refer to the source control history to understand how the hasApprovedTermsAndConditions flag is derived from the acceptedDocumentsList.
        boolean hasApprovedTermsAndConditions = userDocumentsAcceptanceRepository.findFirstByUserId(userDetails.getId()).isPresent();

        return GetUserAcceptedDocsResponseDTO.User.builder()
                .userId(oflUser.getId())
                .roles(oflUser.getUserPermissionList().stream().map(permission -> permission.getUserRole().getName()).collect(Collectors.toSet()))
                .hasApprovedTermsAndConditions(hasApprovedTermsAndConditions)
                .build();
    }
}

