  /** Below Code Validates tags are in order */
  private void validateTags(StringBuilder reason, List<String> tags) {
    reason.append(
        tags != null
                && (tags.size() > 15
                    || tags.stream()
                        .anyMatch(tag -> !tag.matches("^(?=.*[a-zA-Z0-9])[a-zA-Z0-9\\s]{1,15}$")))
            ? " Tags must not exceed 15 in count and 15 character length each/"
            : "");
  }

