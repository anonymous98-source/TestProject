      float weight = request.getPackagingDetails().get(0).getPackaging().getWeight();
      String weightUOM = request.getPackagingDetails().get(0).getPackaging().getWeightUOM();
      if (Boolean.TRUE.equals(dryIce) || Boolean.TRUE.equals(coldChain)) {
        throw new ValidationException("Dry Ice or Cold Chain is not supported for DHL shipments.");
      }
      if (StringUtils.isNotBlank(reference3)  || StringUtils.isNotBlank(reference4)) {
        throw new ValidationException(
