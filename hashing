  @Test
  void validateAddress_success_whenResultHasStatusCode_isPersisted() throws JsonProcessingException {

    AddressValidationResponseDTO resultDTO = new AddressValidationResponseDTO();

    resultDTO.setAddressValid(true);

    resultDTO.setResult(ValidationResult.builder().statusCode("VALIDATED").build());

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(userConfigResponseDTO);

    when(sendFlexWebClientService.sendFlexRequest(anyString(), any(), anyMap(), any(), eq(AddressValidationResponseDTO.class))).thenReturn(Mono.just(resultDTO));

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenReturn(SendFlexRecordDto.builder().build());

    AddressValidationResponseDTO result = addressValidationService.validateAddress(validRequest);

    assertEquals(resultDTO, result);

    verify(sendFlexRecordUtil).saveSendflexRecord(argThat(record -> "VALIDATED".equals(record.getStatusCode())));
  }

  @Test
  void validateAddress_validationException_isPersistedAndNotPropagated() throws JsonProcessingException {

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(userConfigResponseDTO);

    ValidationException exception = new ValidationException("Data is not valid: [Invalid address]", "[Invalid address]");

    when(sendFlexWebClientService.sendFlexRequest(anyString(), any(), anyMap(), any(), eq(AddressValidationResponseDTO.class))).thenReturn(Mono.error(exception));

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenReturn(SendFlexRecordDto.builder().build());

    AddressValidationResponseDTO result = addressValidationService.validateAddress(validRequest);

    assertNotNull(result);
    assertFalse(result.isAddressValid());

    verify(sendFlexRecordUtil, times(1))
            .saveSendflexRecord(argThat(record ->
                    FAILURE.equals(record.getStatusCode())
                            && ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT.equals(record.getApiCode())
                            && record.getResponseObject() != null
                            && record.getResponseObject()
                            .toString()
                            .contains("Invalid address")
            ));
  }

  @Test
  void validateAddress_genericException_isPersistedAndWrapped() {

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(userConfigResponseDTO);

    when(sendFlexWebClientService.sendFlexRequest(anyString(), any(), anyMap(), any(), eq(AddressValidationResponseDTO.class))).thenReturn(Mono.error(new RuntimeException("SendFlex technical failure")));

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenReturn(SendFlexRecordDto.builder().build());

    ShippingIntegrationException exception = assertThrows(ShippingIntegrationException.class, () -> addressValidationService.validateAddress(validRequest));

    assertThat(exception.getMessage()).contains("An unexpected error occurred");

    verify(sendFlexRecordUtil).saveSendflexRecord(argThat(record -> FAILURE.equals(record.getStatusCode())));
  }

  @Test
  void validateAddress_dataIntegrityViolation_isWrapped() {

    when(ocmWebClientService.getUserConfigDataFromOCM(any(), any())).thenReturn(userConfigResponseDTO);

    when(sendFlexWebClientService.sendFlexRequest(anyString(), any(), anyMap(), any(), eq(AddressValidationResponseDTO.class))).thenReturn(Mono.just(responseDTO));

    when(sendFlexRecordUtil.saveSendflexRecord(any(SendFlexRecordDto.class))).thenThrow(new DataIntegrityViolationException("data integrity exception raised"));

    RuntimeException exception = assertThrows(RuntimeException.class, () -> addressValidationService.validateAddress(validRequest));

    assertThat(exception.getMessage()).contains("data integrity exception raised");
  }

