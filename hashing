import java.util.stream.Collectors;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.COLD_CHAIN_SUCCESS;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.SUCCESS;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.COLD_CHAIN_VALUE;

@Service
@RequiredArgsConstructor
public class ColdChainRuleService implements ShippingRuleService<ColdChainRuleResponse> {

    private final RuleDefinitionRepository ruleDefinitionRepository;

    /**
     * Saves or updates a Cold Chain shipping rule based on the provided request DTO.
     * <p>
     * If a rule with the same facility ID and shipping profile ID exists, it updates the rule.
     * Otherwise, it creates a new rule.
     *
     * @param shippingRuleRequestDto the request DTO containing rule details
     * @return a response indicating the status of the save or update operation
     * @throws IllegalArgumentException if the provided DTO is not a ColdChainRuleRequestDto
     */
    @Override
    public ColdChainGenericResponse saveOrUpdateShippingRules(ShippingRuleRequestDto shippingRuleRequestDto) {

        if (!(shippingRuleRequestDto instanceof ColdChainRuleRequestDto coldChainRuleRequestDto)) {
            throw new IllegalArgumentException("Invalid request dto for ColdChainRule: expected ColdChainRuleRequestDto");
        }

        // Check if rule exists
        RuleDefinition rule = ruleDefinitionRepository.findAll().stream()
                .filter(r -> RuleType.COLD_CHAIN.toString().equals(r.getRuleType())
                        && coldChainRuleRequestDto.getFacilityId().equals(r.getFacilityId()))
                .findFirst()
                .orElse(null);

        if (rule != null) {
            // Update existing rule fields as needed
            rule.setShippingProfileId(
                StringUtils.isBlank(coldChainRuleRequestDto.getShippingProfileId())
                    ? null
                    : UUID.fromString(coldChainRuleRequestDto.getShippingProfileId())
            );
            rule.setCustomerId(coldChainRuleRequestDto.getCustomerId());
            ruleDefinitionRepository.save(rule);
        } else {
            //Save new rule
            RuleDefinition newRule = RuleDefinition.builder()
                    .facilityId(coldChainRuleRequestDto.getFacilityId())
                    .shippingProfileId(
                            StringUtils.isBlank(coldChainRuleRequestDto.getShippingProfileId())
                                    ? null
                                    : UUID.fromString(coldChainRuleRequestDto.getShippingProfileId())
                    ).ruleType(RuleType.COLD_CHAIN.toString())
                    .customerId(coldChainRuleRequestDto.getCustomerId())
                    .value(COLD_CHAIN_VALUE)
                    .active(true)
                    .build();
            ruleDefinitionRepository.save(newRule);
        }

        return ColdChainGenericResponse.builder()
                .status(SUCCESS)
                .message(COLD_CHAIN_SUCCESS)
                .build();
    }

    /**
     * Fetches cold chain shipping rules for a given facility.
     *
     * @param facilityId the facility identifier
     * @param customerId
     * @param search     the search string to filter rules (optional)
     * @param pageable   the pagination information
     * @return a ShippingRuleResult containing a page of ColdChainRuleResponse objects
     */
    @Override
    public ShippingRuleResult<ColdChainRuleResponse> fetchShippingRules(String facilityId, String customerId, String search, Pageable pageable) {
        if (StringUtils.isBlank(search)) {
            var responsePage = ruleDefinitionRepository
                    .findAllByRuleTypeAndFacilityIdAndActiveTrue(RuleType.COLD_CHAIN.toString(),facilityId, pageable);
            return new ShippingRuleResult<>(mapToResponseDto(responsePage));
        }
        var responsePage = ruleDefinitionRepository
                .searchColdChainRules(RuleType.COLD_CHAIN.toString(), facilityId, search.trim(), pageable);
        return new ShippingRuleResult<>(mapToResponseDto(responsePage));
    }

    @Override
    public ColdChainGenericResponse deleteShippingRules(String ruleType, String ruleId) {
        throw new ValidationException("Delete operation is not allowed for Cold Chain rules."); // throw the message
    }

    public static Page<ColdChainRuleResponse> mapToResponseDto(Page<ColdChainRuleProjection> page) {
        List<ColdChainRuleResponse> responses =
                page.getContent().stream()
                        .map(
                                projection ->
                                     ColdChainRuleResponse.builder()
                                            .id(projection.getId())
                                            .ruleType(projection.getRuleType())
                                            .value(projection.getValue())
                                            .isActive(projection.isActive())
                                            .shippingProfileId(projection.getShippingProfileId())
                                            .build()
                                )
                        .collect(Collectors.toList());
        Pageable pageable = page.getPageable();
        return new PageImpl<>(responses, pageable, page.getTotalElements());
    }


