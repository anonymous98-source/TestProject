    private List<ManifestResponseDto> fetchManifestFromSendFlex(ManifestRequestDto manifestRequestDto) {
        log.atInfo().setMessage("calling SendFlex to fetch manifest data")
                .log();
        return sendFlexWebClientService.sendFlexListRequest(
                GET_MANIFEST_ENDPOINT,
                HttpMethod.GET,
                Map.of(),
                manifestRequestDto,
                new ParameterizedTypeReference<List<ManifestResponseDto>>() {
                }
