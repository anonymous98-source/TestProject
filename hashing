                USPS.equalsIgnoreCase(shipPlanRequest.getShippingProfile()) ||
                DHL.equalsIgnoreCase(shipPlanRequest.getShippingProfile())) {

            validateShipByDate(shipPlanRequest);

            if (shipPlanRequest.getNeedsByDate() != null) {
                String needsByDateStr = shipPlanRequest.getNeedsByDate();
                LocalDate needsByDate = parseFlexibleDate(needsByDateStr);
                LocalDate shipByDate = OffsetDateTime.parse(shipPlanRequest.getShipByDate()).toLocalDate();
                validateNeedsByDate(needsByDate, shipByDate);
            }

            response = executeSendFlexFlow(shipPlanRequest);
        }

        if (response != null) {
            response.setCarrierId(String.valueOf(fetchCarrierId(shipPlanRequest.getShippingProfile())));
        }
        return response;
    }

    private void validateDhlRequest(ShipPlanRequest request) {
        if (DHL.equalsIgnoreCase(request.getShippingProfile())) {
            validateDhlEmailAndCompanyName(request);
            String senderName = request.getShipFromAddress().getAddressData().getAddress().getName();
            String recipientName = request.getShipToAddress().getAddressData().getAddress().getName();
            if (senderName.length() > 30 || recipientName.length() > 30) {
                throw new ValidationException("Sender or recipient name must not exceed 30 characters for DHL shipments");
            }
            if (LBS.equalsIgnoreCase(request.getPackagingDetails().get(0).getPackaging().getWeightUOM()) &&
                    request.getPackagingDetails().get(0).getPackaging().getWeight() >= 25) {
                throw new ValidationException("Maximum weight for DHL shipments in lbs is 24.99 lbs.");
            }
        }
    }

    private void validateDhlEmailAndCompanyName(ShipPlanRequest request) {
        String senderCompanyName = request.getShipFromAddress().getAddressData().getAddress().getCompany();
        String recipientCompanyName = request.getShipToAddress().getAddressData().getAddress().getCompany();
        String senderEmail = request.getShipFromAddress().getAddressData().getAddress().getEmailAddress();
        String recipientEmail = request.getShipToAddress().getAddressData().getAddress().getEmailAddress();
        if ((Objects.nonNull(senderEmail) && senderEmail.length() > 50)
                || (Objects.nonNull(recipientEmail) && recipientEmail.length() > 50)) {
            throw new ValidationException("Sender or recipient email must not exceed 50 characters for DHL shipments");
        }
        if ((Objects.nonNull(senderCompanyName) && senderCompanyName.length() > 30)
                || (Objects.nonNull(recipientCompanyName) && recipientCompanyName.length() > 30)) {
            throw new ValidationException("Sender or recipient company name must not exceed 30 characters for DHL shipments");
        }
    }

    void validateDryIceWeight(ShipPlanRequest shipPlanRequest) {
        for (PackagingDetails details : shipPlanRequest.getPackagingDetails()) {
            Packaging packaging = details.getPackaging();
            Accessorials accessorials = details.getAccessorials();
            if (packaging != null && accessorials != null && Boolean.TRUE.equals(accessorials.getContainsDryIce())) {
                float dryIceWeight = accessorials.getWeight();
                float totalPackageWeight = packaging.getWeight();
                if (dryIceWeight > totalPackageWeight) {
                    throw new ValidationException(
                            "Your dry ice weight cannot exceed the total weight of the package."
                    );
                }
            }
        }
    }

    void validateDryIceLithiumBatteryCombination(ShipPlanRequest shipPlanRequest) {
        for (PackagingDetails details : shipPlanRequest.getPackagingDetails()) {
            Accessorials accessorials = details.getAccessorials();
            boolean dryIceAndLithium = accessorials != null && accessorials.getContainsDryIce() &&
                    accessorials.getLithiumBattery();
            if (dryIceAndLithium
                    && (FEDEX.equalsIgnoreCase(shipPlanRequest.getShippingProfile())
                    || USPS.equalsIgnoreCase(shipPlanRequest.getShippingProfile())
                    || DHL.equalsIgnoreCase(shipPlanRequest.getShippingProfile()))) {
                throw new ValidationException(
                        "Unsupported combination of services. Dry ice cannot be selected with Lithium Battery.");
            }
        }

    }

    public void validatePackageDimensionsForPlan(ShipPlanRequest shipPlanRequest) {
        List<PackagingDetails> packagingDetails = shipPlanRequest.getPackagingDetails();
        var i = 1;

        for (PackagingDetails pkgDetl : packagingDetails) {
            if (isCustomPackagingType(pkgDetl)) {
                Float len = pkgDetl.getPackaging().getLength();
                Float wid = pkgDetl.getPackaging().getWidth();
                Float hei = pkgDetl.getPackaging().getHeight();

                int validCount = countValidDimensions(len, wid, hei);

                if (validCount == 1 || validCount == 2) {
                    throw new ValidationException(
                            "All values of Length, Width, Height in Package No- " + i + " should be null or none should be null."
                    );
                }
            }
            i++;
        }
    }

    private boolean isCustomPackagingType(PackagingDetails pkgDetl) {
        return (pkgDetl.getPackaging().getPackagingType()
                .equalsIgnoreCase(ServiceCommonConstants.PACKAGING_TYPE)
                || packageTypeRepository.existsById(UUID.fromString(pkgDetl.getPackaging().getPackagingId())));
    }

    private int countValidDimensions(Float len, Float wid, Float hei) {
        var count = 0;
        if (len != null && len >= 1) count++;
        if (wid != null && wid >= 1) count++;
        if (hei != null && hei >= 1) count++;
        return count;
    }

    private UUID fetchCarrierId(String shippingProfile) {
        return carrierRepository
                .findCarrierIdByCarrierName(getOriginalShippingProfileName(shippingProfile))
                .orElse(null);
    }

    private ShipPlanResponse executeSendFlexFlow(ShipPlanRequest shipPlanRequest) {
        log.atInfo().setMessage("shipment plan request received.").log();

        List<UserDefaultsResponse> userDefaultsResponses = shipPlanRequest.getUserDefaultsResponses();

        log.atInfo().setMessage("Mapper called for mapping ShipPlan request to SendFlex request").log();
        ShipmentRequestDTO shipmentRequestDTO = shipPlanDataMapperService.mapToSendFlexRequest(shipPlanRequest, userDefaultsResponses.get(0).getData());
        ShipmentResponseDTO shipmentResponseDTO = callPlan(shipmentRequestDTO);

        if (shipmentResponseDTO == null) {
            log.atInfo().setMessage("Returned sendflex ship plan response is null").log();
            throw new ShippingIntegrationException("Generated DTO from ship plan send flex call is null");
        }
        log.atInfo().setMessage("Received ship plan response from sendflex").log();

        removeOneRateFromDescriptions(shipmentResponseDTO);

        processShipViaOptions(shipPlanRequest, shipmentRequestDTO, shipmentResponseDTO);

        ShipPlanResponse finalResponse = shipPlanDataMapperService.mapToFetchShippingServiceOptionResponse(shipmentResponseDTO);

        if (shipPlanRequest.getNeedsByDate() != null && !shipPlanRequest.getNeedsByDate().isBlank()) {
            updateDeliverySlotsAsPerNeedsByDate(shipPlanRequest.getNeedsByDate(), finalResponse);
        }

        if (shouldProcessReturnOptions(shipPlanRequest)) {
            processReturnOptions(shipPlanRequest, userDefaultsResponses, finalResponse);
        }

        return finalResponse;
    }


    private void filterServiceLevelForReturn(ShipPlanRequest shipPlanRequest, ShipPlanResponse finalResponse) {
        if (shipPlanRequest.getGenerateLabelReturnType().equalsIgnoreCase(STANDALONE)) {
            List<DeliveryDateDto> deliveryDates = finalResponse.getDeliveryDates();
            for (DeliveryDateDto date : deliveryDates) {
                List<DeliverySlot> slots = date.getAvailableSlots().stream()
                        .filter(slot -> !(slot.getDescription().equalsIgnoreCase(FEDEX_EXPRESS_SAVER)
                        || slot.getDescription().equalsIgnoreCase(FEDEX_HOME_DELIVERY)))
                        .toList();
                date.setAvailableSlots(slots);
            }
            deliveryDates = deliveryDates.stream().filter(date -> !date.getAvailableSlots().isEmpty()).toList();

            finalResponse.setDeliveryDates(deliveryDates);
        }
        if (shipPlanRequest.getGenerateLabelReturnType().equalsIgnoreCase(FORWARD)) {
            finalResponse.getServiceOptionsForReturnShipment().remove(FEDEX_EXPRESS_SAVER);
        }
    }

    @Nullable
    private ShipmentResponseDTO callPlan(
            ShipmentRequestDTO shipmentRequestDTO) {
        ShipmentResponseDTO shipmentResponseDTO;
        long startTime = ApiResponseTimeUtil.startTime();
        try {
            Mono<ShipmentResponseDTO> shipmentResponseDTOMono =
                    sendFlexWebClientService.sendFlexRequest(
                            SHIPMENT_PLAN_SUB_URI,
                            HttpMethod.POST,
                            Map.of(),
                            shipmentRequestDTO,
                            ShipmentResponseDTO.class);
            shipmentResponseDTO = shipmentResponseDTOMono.block();
            long responseTime = ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);
            sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
                    shipmentRequestDTO,
                    shipmentResponseDTO,
                    null,
                    PLAN,
                    responseTime);
        } catch (Exception e) {
            long responseTime = ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);
            sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
                    shipmentRequestDTO,
                    null,
                    PLAN,
                    e,
                    responseTime);
            throw e;
        }
        return shipmentResponseDTO;
    }

    private List<String> getAllowedShipViaCodes(String shippingProfile, String packagingType, String profileCode, String lithiumBatteryConfig) {
        if (FEDEX.equalsIgnoreCase(shippingProfile) && !PACKAGING_TYPE.equalsIgnoreCase(packagingType)) {
            return serviceLevelService.getFedexPackagingServiceLevels().stream()
                    .map(ServiceLevel::getSendflexShipVia)
                    .filter(Objects::nonNull)
                    .toList();
        } else if (USPS.equalsIgnoreCase(shippingProfile) && profileCode.equalsIgnoreCase(USPSCARDINAL_LIVE)) {
            return serviceLevelService.getUspsLivePackagingServiceLevels(packagingType).stream()
                    .filter(Objects::nonNull)
                    .toList();
        } else if (DHL.equalsIgnoreCase(shippingProfile)) {
            return serviceLevelService.getDhlPackagingServiceLevels(lithiumBatteryConfig);
        } else {
            return serviceLevelService.getUspsPackagingServiceLevels(packagingType).stream()
                    .filter(Objects::nonNull)
                    .toList();
        }
    }

    private void removeOneRateFromDescriptions(ShipmentResponseDTO shipmentResponseDTO) {
        Optional.ofNullable(shipmentResponseDTO)
                .map(ShipmentResponseDTO::getShipViaOptions)
                .ifPresent(shipViaOptionDTOS ->
                        shipViaOptionDTOS.forEach(shipViaOptionDTO -> {
                            String description = shipViaOptionDTO.getDescription();
                            if (description != null && description.contains(ONE_RATE_DESCRIPTION)) {
                                shipViaOptionDTO.setDescription(description.replace(ONE_RATE_DESCRIPTION, BLANK));
                            }
                        }));
    }

    private boolean isReturn(ShipPlanRequest shipPlanRequest) {
        return (!org.apache.commons.lang3.StringUtils.isBlank(
                shipPlanRequest.getGenerateLabelReturnType())
                && (shipPlanRequest
                .getGenerateLabelReturnType()
                .equalsIgnoreCase(FORWARD)
                || shipPlanRequest
                .getGenerateLabelReturnType()
                .equalsIgnoreCase(STANDALONE)));
    }

    private void processShipViaOptions(ShipPlanRequest shipPlanRequest, ShipmentRequestDTO shipmentRequestDTO, ShipmentResponseDTO shipmentResponseDTO) {
        String shippingProfile = shipPlanRequest.getShippingProfile();
        List<ShipViaOptionDTO> shipViaOptions = shipmentResponseDTO.getShipViaOptions();

        for (PackagingDetails packagingDetails : shipPlanRequest.getPackagingDetails()) {
            String packagingType = Optional.ofNullable(packagingDetails)
                    .map(PackagingDetails::getPackaging)
                    .map(Packaging::getPackagingType)
                    .map(String::trim)
                    .orElse(BLANK);

            // filter the selected lithium battery secondary configuration for DHL eligible ship via codes
            String lithiumBatteryConfig = DHL.equalsIgnoreCase(shippingProfile) && Objects.nonNull(packagingDetails)
                    ? getTrueLithiumBatteryConfigs(packagingDetails.getAccessorials()) : BLANK;

            List<String> allowedShipViaCodes = getAllowedShipViaCodes(shippingProfile, packagingType, shipmentRequestDTO.getProfileCode(), lithiumBatteryConfig);

            if (shouldFilterShipViaOptions(shippingProfile, packagingType)) {
                shipViaOptions.removeIf(shipViaOption -> {
                    String code = shipViaOption.getCode();
                    return code == null || !allowedShipViaCodes.contains(code);
                });
            }
        }

        if (shouldRemoveSaturdayDelivery(shipPlanRequest, shippingProfile, shipmentResponseDTO)) {
            shipmentResponseDTO.getShipViaOptions().removeIf(
                    shipVia -> shipVia.getCode() != null &&
                            serviceLevelService.getFedexSaturdayDeliveryServiceLevelShipViaCodes().contains(shipVia.getCode()));
        }
    }

    private boolean shouldFilterShipViaOptions(String shippingProfile, String packagingType) {
        return (FEDEX.equalsIgnoreCase(shippingProfile) && !PACKAGING_TYPE.equalsIgnoreCase(packagingType)) ||
                (USPS.equalsIgnoreCase(shippingProfile) && !PACKAGING_TYPE.equalsIgnoreCase(packagingType)) ||
                (DHL.equalsIgnoreCase(shippingProfile));
    }

    private String getTrueLithiumBatteryConfigs(Accessorials accessorials) {
        if (Boolean.TRUE.equals(accessorials.getLithiumBattery())) {
            if (Boolean.TRUE.equals(accessorials.getMetalContainedInEquipment())) return LITHIUM_METAL_CONTAINED_IN_EQUIPMENT;
            if (Boolean.TRUE.equals(accessorials.getMetalPackedWithEquipment())) return LITHIUM_METAL_PACKED_WITH_EQUIPMENT;
            if (Boolean.TRUE.equals(accessorials.getIonContainedInEquipment())) return LITHIUM_ION_CONTAINED_IN_EQUIPMENT;
            if (Boolean.TRUE.equals(accessorials.getIonPackedWithEquipment())) return LITHIUM_ION_PACKED_WITH_EQUIPMENT;
            if (Boolean.TRUE.equals(accessorials.getMetalStandalone())) return LITHIUM_METAL_STANDALONE;
            if (Boolean.TRUE.equals(accessorials.getIonStandalone())) return LITHIUM_ION_STANDALONE;
        }
        return BLANK;
    }

    private boolean shouldRemoveSaturdayDelivery(ShipPlanRequest shipPlanRequest, String shippingProfile, ShipmentResponseDTO shipmentResponseDTO) {
        return shipmentResponseDTO.getShipViaOptions() != null &&
                !shipPlanRequest.isSaturdayDelivery() &&
                FEDEX.equalsIgnoreCase(shippingProfile);
    }

    private boolean shouldProcessReturnOptions(ShipPlanRequest shipPlanRequest) {
        return FEDEX.equalsIgnoreCase(shipPlanRequest.getShippingProfile()) &&
                isReturn(shipPlanRequest) &&
                shipPlanRequest.getPackagingDetails().size() == 1;
    }

    private void processReturnOptions(ShipPlanRequest shipPlanRequest, List<UserDefaultsResponse> userDefaultsResponses, ShipPlanResponse finalResponse) {
        finalResponse.setServiceOptionsForReturnShipment(
                getServiceOptionsForReturnShipment(
                        userDefaultsResponses,
                        getOriginalShippingProfileName(shipPlanRequest.getShippingProfile()),
                        shipPlanRequest.getFacilityId(),
                        shipPlanRequest.getPackagingDetails().get(0),
                        shipPlanRequest.getGenerateLabelReturnType()));
        filterServiceLevelForReturn(shipPlanRequest, finalResponse);
    }

    private ShipPlanResponse executeCmsFlow(ShipPlanRequest request) {
        log.atInfo()
                .setMessage("Starting CMS flow execution")
                .log();

        if (request.getNeedsByDate() != null) {
            String needsByDateStr = request.getNeedsByDate();
            LocalDate needsByDate = parseFlexibleDate(needsByDateStr);
            LocalDate shipByDate = OffsetDateTime.parse(request.getShipByDate()).toLocalDate();
            validateNeedsByDate(needsByDate, shipByDate);
        }

        String facilityId = request.getFacilityId();
        OffsetDateTime shipByDate = OffsetDateTime.parse(request.getShipByDate());
        var shipByDateStr = shipByDate.toLocalDate().toString();
        String profile = request.getShippingProfile();
        String serviceLevel = determineServiceLevel(profile);
        String shipToZipCode = Optional.ofNullable(request.getShipToAddress())
                .map(ShipToAddress::getAddressData)
                .map(ShipToAddressData::getAddress)
                .map(ShipToAddressDetails::getZipCode)
                .map(zip -> zip.split("-")[0])
                .orElse("");

        OcmShipmentResponseDTO ocmResponse = ocmWebClientService.getSchedules(
                facilityId, shipByDateStr, serviceLevel, shipToZipCode
        );
        log.atInfo()
                .addKeyValue(OCMCommonConstants.OCM_SHIP_DATE_QUERY_PARAM, shipByDateStr)
                .setMessage("Received OCM response").log();

        ShipPlanResponse response = shipPlanDataMapperService.mapToShipPlanResponse(ocmResponse);

        if (request.getNeedsByDate() != null && !request.getNeedsByDate().isBlank()) {
           updateDeliverySlotsAsPerNeedsByDate(request.getNeedsByDate(), response);
        }

        log.atInfo()
                .setMessage("Mapped OCM response to ShipPlanResponse")
                .log();
        return response;
    }
    public LocalDate parseFlexibleDate(String dateStr) {
        DateTimeFormatter[] formatters = new DateTimeFormatter[] {
                DateTimeFormatter.ofPattern(ServiceCommonConstants.DATE_FORMAT_MM_DD_YYYY),
                DateTimeFormatter.ofPattern(ServiceCommonConstants.DATE_FORMAT_MM_DD_YYYY_DASH)
        };
        for (DateTimeFormatter formatter : formatters) {
            try {
                return LocalDate.parse(dateStr, formatter);
            } catch (DateTimeParseException ignored) {
                // Intentionally ignore and try next format
            }
        }
        throw new ValidationException("Invalid date format for needsByDate: " + dateStr + ". Supported formats: MM/dd/yyyy, MM-dd-yyyy");

    }

    private void updateDeliverySlotsAsPerNeedsByDate(String date, ShipPlanResponse response) {

        if (response.getDeliveryDates() != null) {
            List<DeliveryDateDto> dates = new ArrayList<>(response.getDeliveryDates());
            LocalDate needsByDate = parseFlexibleDate(date);
            dates.removeIf(deliveryDate -> {
                if (deliveryDate != null && deliveryDate.getDeliveryDate() == null) {
                    return true;
                }
                if (deliveryDate != null) {
                    LocalDate deliveryLocalDate = LocalDate.parse(deliveryDate.getDeliveryDate());
                    return deliveryLocalDate.isAfter(needsByDate);
                }
                return false;
            });
            response.setDeliveryDates(dates);
        }
    }

    /**
     * Determines the service level based on the shipping profile.
     *
     * @param profile the shipping profile
     * @return the corresponding service level
     */
    private String determineServiceLevel(String profile) {
        if (CMS_COURIER_SAME_DAY.equalsIgnoreCase(profile)) {
            return OCM_SHIPMENT_TYPE_SAMEDAY;
        } else if (CMS_COURIER_NEXT_DAY.equalsIgnoreCase(profile)) {
            return OCM_SHIPMENT_TYPE_NEXTDAY;
        } else if (CMS_COURIER_SAME_DAY_STATE.equalsIgnoreCase(profile)) {
            return OCM_SHIPMENT_TYPE_SAMEDAYSTATE;
        } else {
            log.warn("Unknown shipping profile in request. Defaulting to empty service level.");
            return "";
        }
    }

    private void validatePackageCountLimit(ShipPlanRequest request) {
        var maxAllowedPackages = 10;
        int packageCount = request.getPackagingDetails().size();

        if (DHL.equalsIgnoreCase(request.getShippingProfile()) && packageCount>1){
            throw new ValidationException("DHL carrier supports only single package shipment");
        }
        if (packageCount > maxAllowedPackages) {
            throw new ValidationException("Maximum number of package shipments allowed is " + maxAllowedPackages);
        }
    }

    private void validateReturnEligibility(ShipPlanRequest request) {
        boolean isReturn = isReturn(request);
        boolean isNotFedEx = !FEDEX.equalsIgnoreCase(request.getShippingProfile());
        boolean hasMultiplePackages = request.getPackagingDetails().size() > 1;

        if (isReturn && (hasMultiplePackages || isNotFedEx)) {
            throw new ValidationException("Return is only eligible for FedEx with a single package shipment");
        }
    }

    private void validateAccessorialsDryIce(ShipPlanRequest request) {
        //Check if it is CMS Request
        if (request.getShippingProfile() != null && (request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY) || request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_NEXT_DAY) || request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE))) {
            return;
        }
        for (PackagingDetails packagingDetails : request.getPackagingDetails()) {
            if (packagingDetails.getAccessorials() != null && packagingDetails.getAccessorials().getContainsDryIce() && packagingDetails.getAccessorials().getWeight() <= 0) {
                throw new ValidationException("Dry Ice weight must be greater than zero");
            }
        }
    }

    private void validateLithiumBatterySecondaryConfiguration(ShipPlanRequest request) {
        for (PackagingDetails packagingDetail : request.getPackagingDetails()) {
            if (packagingDetail.getAccessorials() == null)
                continue;
            if (Boolean.TRUE.equals(packagingDetail.getAccessorials().getLithiumBattery())
                    && !hasValidLithiumBatteryConfig(packagingDetail.getAccessorials())) {
                    throw new ValidationException("lithium battery configuration is  required");
            }
        }
    }

    private boolean hasValidLithiumBatteryConfig(Accessorials accessorials) {
        return accessorials.getMetalPackedWithEquipment()
                || accessorials.getIonContainedInEquipment()
                || accessorials.getIonPackedWithEquipment()
                || accessorials.getMetalContainedInEquipment()
                || accessorials.getMetalStandalone()
                || accessorials.getIonStandalone();
    }

    private void validateOSPCoverage(ShipPlanRequest request) {
        for (PackagingDetails packagingDetail : request.getPackagingDetails()) {
            if (packagingDetail.getPackaging().getIsIndividualShipmentProtection() != null
                    && packagingDetail.getPackaging().getIsIndividualShipmentProtection()
                    && (packagingDetail.getPackaging().getCoverageAmount() == null
                    || packagingDetail.getPackaging().getCoverageAmount() <= 0)) {
                throw new ValidationException("OSP enrollment is selected, some Coverage amount value is required");
            }
        }
    }

    private void validateShippingProfile(@NotBlank(message = "shipping profile  can not be blank") String shippingProfile) {

        List<String> supportedProfiles = List.of(
                FEDEX,
                USPS,
                CMS_COURIER_SAME_DAY,
                CMS_COURIER_NEXT_DAY,
                CMS_COURIER_SAME_DAY_STATE,
                DHL
        );

        if (supportedProfiles.stream().noneMatch(p -> p.equalsIgnoreCase(shippingProfile))) {
            throw new ValidationException("Implementation missing for selected carrier");
        }
    }

    public void validateShipByDate(ShipPlanRequest shipPlanRequest) {
        OffsetDateTime shipByDate = OffsetDateTime.parse(shipPlanRequest.getShipByDate());
        if (shipByDate.toLocalDate().isBefore(LocalDate.now())) {
            throw new ValidationException("shipByDate cant be a past date");
        }
    }

    public void validateNeedsByDate(LocalDate needsByDate, LocalDate shipByDate) {

        if (needsByDate == null) {
            return;
        }
        if (needsByDate.isBefore(shipByDate)) {
            throw new ValidationException("needsByDate can't be prior to shipByDate");
        }
    }

    private  String getOriginalShippingProfileName(String shippingProfile) {
        if (Objects.equals(shippingProfile, FEDEX.toLowerCase())) {
            return FEDEX;
        } else if (Objects.equals(shippingProfile, USPS.toLowerCase())) {
            return USPS;
        } else if(Objects.equals(shippingProfile, DHL.toLowerCase())){
            return DHL;
        } else if (Objects.equals(shippingProfile, CMS_COURIER_SAME_DAY.toLowerCase())) {
            return OCM_SHIPMENT_TYPE_SAMEDAY;
        } else if (Objects.equals(shippingProfile, CMS_COURIER_NEXT_DAY.toLowerCase())) {
            return OCM_SHIPMENT_TYPE_NEXTDAY;
        } else if (Objects.equals(shippingProfile, CMS_COURIER_SAME_DAY_STATE.toLowerCase())) {
            return OCM_SHIPMENT_TYPE_SAMEDAYSTATE;
        }
        return shippingProfile;
    }

    private Map<String, String> getServiceOptionsForReturnShipment(
            List<UserDefaultsResponse> userDefaultsResponses,
            String shippingProfile,
            String facilityId,
            PackagingDetails packagingDetails,
            String returnType) {

        List<String> filteredOptions = new ArrayList<>();

        log.atInfo()
                .setMessage("facilityId: {}")
                .addArgument(facilityId)
                .addKeyValue("facilityId", facilityId)
                .log();
        if (userDefaultsResponses.isEmpty()) {
            log.atInfo()
                    .setMessage("User defaults responses are empty.")
                    .log();
            return Collections.emptyMap();
        }


        if (Objects.equals(shippingProfile.toLowerCase(), FEDEX.toLowerCase())
                && returnType.equalsIgnoreCase(FORWARD)) {
            List<String> fedexOptions = fetchFedExOptionsFromMapper(userDefaultsResponses.get(0).getData().getFedEx());

            if (packagingDetails
                    .getPackaging()
                    .getPackagingType()
                    .equals(PACKAGING_TYPE)) {
                // Append complete list
                filteredOptions = fedexOptions;
            } else {
                // Take intersection of FEDEX_PACKAGING_ALLOWED_OPTIONS and userDefaultsResponses
                List<String> allowedOptions = serviceLevelService.getFedexPackagingServiceLevels()
                        .stream()
                        .map(ServiceLevel::getDescription)
                        .toList();
                filteredOptions = getCommonStrings(fedexOptions, allowedOptions);
            }
        }
        List<CarrierServiceLevel> serviceLevels =
                carrierServiceLevelRepository.findByServiceLevelNameIn(filteredOptions);

        return serviceLevels.stream()
                .collect(Collectors.toMap(CarrierServiceLevel::getServiceLevelName, CarrierServiceLevel::getServiceLevelCode));
    }

    private List<String> fetchFedExOptionsFromMapper(List<FedexServiceLevelDTO> fedExOptionsFromUserDefaults) {
        return fedExOptionsFromUserDefaults.stream()
                .map(FedexServiceLevelDTO::getServiceLevelName)
                .filter(Objects::nonNull)
                .filter(serviceLevelName ->
                        !(serviceLevelName.toLowerCase().contains(SATURDAY)
                                || serviceLevelName.equalsIgnoreCase(HOME_DELIVERY)))
                .toList();
    }

    // Method to find common strings between two lists
    private List<String> getCommonStrings(List<String> list1, List<String> list2) {
        List<String> commonStrings = new ArrayList<>();
        for (String str : list1) {
            if (list2.contains(str)
                    && !str.equals(FEDEX_GROUND_ECONOMY)
                    && !str.equals(FREIGHT)
                    && !str.equals(ONE_RATE)) {
                commonStrings.add(str);
            }
        }
        return commonStrings;
    }

    /**
     * Validate the Return Option sent in the request body for return shipment
     *
     * @param shipPlanRequest Ship Plan Request body
     */
    private void validateReturnOptionRequest(ShipPlanRequest shipPlanRequest) {
        if (!shipPlanRequest.isStandaloneReturn()) {
            log.atInfo()
                    .setMessage(
                            "Not a Standalone return request, returning from validateReturnOptionRequest")
                    .log();
            return;
        }

        if (!FEDEX.equalsIgnoreCase(shipPlanRequest.getShippingProfile())
                && shipPlanRequest.getReturnOption() != null) {
            throw new ValidationException("Request is marked as standalone return with valid return option, but" +
                    "Standalone return is not allowed for any shipping profile other than FedEx");
        }

        if (shipPlanRequest.getReturnOption() == null) {
            log.atInfo().setMessage("Provided Return option is null for Return shipment")
                            .log();
            throw new ValidationException("Provided Return option is null for Return shipment");
        }

        ReturnOptionRequest returnOptionRequest = shipPlanRequest.getReturnOption();
        // Check if return option is of valid type which SendFlex accepts
        if (!StringUtils.hasText(returnOptionRequest.getReturnType())
                || !isValidReturnType(returnOptionRequest.getReturnType())) {
            log.atInfo()
                    .setMessage("Return option: {}, is not valid")
                    .addArgument(returnOptionRequest.getReturnType())
                    .addKeyValue("returnType", returnOptionRequest.getReturnType())
                    .log();
            throw new ValidationException(
                    String.format("Invalid return option type %s", returnOptionRequest.getReturnType()));
        }

        if (!StringUtils.hasText(returnOptionRequest.getRma())) {
            log.atInfo().log("RMA is null for Return option");
            throw new ValidationException("RMA is null for Return option");
        }

        if (!StringUtils.hasText(returnOptionRequest.getAssociatedTrackingNumber())) {
            log.atInfo()
                            .setMessage("Associated tracking number is null for Return option")
                            .log();
            throw new ValidationException("Associated tracking number is null for Return option");
        }
    }

    /**
     * Check if provided Return type is acceptable by SendFlex or not
     *
     * @param returnType Provided return type
     * @return true if Valid else false
     */
    public boolean isValidReturnType(String returnType) {
        try {
            ReturnTypeEnum.fromValue(returnType);
            return true;
        } catch (Exception e) {
            return false;
        }
    }


