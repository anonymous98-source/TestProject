import org.springframework.stereotype.Component;

import java.nio.charset.StandardCharsets;

@Slf4j
@Component
public class RedisKeyExpiredListener implements MessageListener {
    private final RedisRegionService redisRegionService;

    public RedisKeyExpiredListener(RedisRegionService redisRegionService) {
        this.redisRegionService = redisRegionService;
    }

    @Override
    public void onMessage(Message message, byte[] pattern) {
        String channel = new String(message.getChannel(), StandardCharsets.UTF_8);
        String key = new String(message.getBody(), StandardCharsets.UTF_8);
        String[] parts = key.split(":");
        if (channel.contains("expired") || channel.contains("evicted")) {
            if (parts.length >= 2) {
                String region = parts[0];
                try {
                    redisRegionService.removeIdx(region, key);
                    log.debug("IDX cleaned for removed key={} from {}", key, region);
                } catch (Exception ex) {
                    log.error("IDX cleanup failed for key={}", key, ex);
                }

            }
        }

    }
}

