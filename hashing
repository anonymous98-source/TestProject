        return responseDto;
    }

    private RuleDetails buildRuleDetails(
            String ruleType,
            String reason,
            Boolean isMatched,
            JsonNode accessorials,
            JsonNode secondaryConfigs) {

        return RuleDetails.builder()
                .ruleType(ruleType != null ? RuleType.valueOf(ruleType) : null)
                .reason(reason)
                .isMatched(isMatched)
                .accessorials(accessorials)
                .secondaryConfigs(secondaryConfigs)
                .build();
    }

    private CompoundRuleEvaluationResponseDto buildRuleEvaluationResponse(
            RuleDetails ruleDetails,
            AssignedShippingProfile assignedShippingProfile,
            RuleDefinition ruleDefinition,
            OCMResponse ocmResponse) {

        return CompoundRuleEvaluationResponseDto.builder()
                .ruleDetails(ruleDetails)
                .assignedShippingProfile(assignedShippingProfile)
                .carrierAccessibility(ocmResponse != null ? ocmResponse.getCarrierAccessibilityMap() : null)
                .city(ocmResponse != null ? ocmResponse.getCity() : null)
                .state(ocmResponse != null ? ocmResponse.getState() : null)
                .ruleId(ruleDefinition != null ? ruleDefinition.getId().toString() : null)
                .build();
    }

    public boolean isPreferredRule(CompoundRuleEvaluationRequestDto ruleEvaluationRequest) {
        // logic to check whether the request ruleTYpe matches the preferred rule type for the facility
        PreferredRuleType preferredRuleType =
                preferredRuleTypeRepository.findByFacilityId(ruleEvaluationRequest.getFacilityId());

        String preferredRuleTypeValue = Objects.nonNull(preferredRuleType)
                ? preferredRuleType.getPreferredRuleTypeValue()
                : DEFAULT_SHIPPING_RULE;
        String normalisedRuleType = PREFERRED_RULE_TYPE_MAPPING.get(preferredRuleTypeValue);
        log.info("Preferred rule type for facility {} is {}", ruleEvaluationRequest.getFacilityId(), normalisedRuleType);
        return ruleEvaluationRequest
                .getRuleType()
                .name()
                .equalsIgnoreCase(normalisedRuleType);
    }

