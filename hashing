  private static boolean isOverWeightLimit(ShippingProfileRequest request, int weightLbs, int weightOz) {
    return (request.getWeight() > weightLbs && request.getWeightUOM().equalsIgnoreCase(LBS))
            || (request.getWeight() > weightOz && request.getWeightUOM().equalsIgnoreCase(OZ));
  }

