        AspToCmsDataMapperUtil mapperUtil = new AspToCmsDataMapperUtil();
        MultiPackageShipmentBookResponse mockResponse = mapperUtil.mapToMultiPackageShipmentBookResponse(request,
                CmsObjectFactory.getCmsBookResponse(), true, null, null, false);

        when(serviceDecorator.decorate(any(), any(), any())).thenAnswer(invocation -> {
            ShipmentBookRequest req = invocation.getArgument(0);
            Function<ShipmentBookRequest, MultiPackageShipmentBookResponse> lambda = invocation.getArgument(1);
            return lambda.apply(req); // This executes the lambda
        });

        when(cmsShipmentBookService.bookShipmentGenerateLabel(any(), any(), any(), any(), any()))
                .thenReturn(mockResponse);

        // Act
        MultiPackageShipmentBookResponse result;
        var premiumFeatureDetails = getPremiumFeatureResponse();
        try {
            if (request.getShippingProfile() != null &&
                    (request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY) ||
                            request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_NEXT_DAY) || request.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE))) {
                result = cmsShipmentBookService.bookShipmentGenerateLabel(request, premiumFeatureDetails, mockPrincipal, headers, requestId);
            } else {
                ShipmentBookResponseDto dto = shipmentBookService.bookShipmentGenerateLabel(request, premiumFeatureDetails, mockPrincipal);
                result = shipmentBookResponseUtil.getMultiPackageShipmentBookResponse(dto, request);
            }
        } catch (IOException e) {
            throw new RuntimeException("Error while booking shipment", e);
        }

        // Assert
        assertThat(result).isNotNull();
        verify(cmsShipmentBookService).bookShipmentGenerateLabel(any(), any(), any(), any(), any());
