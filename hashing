    private CmsPackaging getPackaging(Packaging packaging) {
        if(packaging == null) {
            return null;
        }
        if(!packaging.getPackagingType().equalsIgnoreCase(PACKAGING_TYPE) && !packaging.isCustomPackage()) {
            throw new ValidationException("Invalid packaging type: " + packaging.getPackagingType() + ". For non-custom packages, the packaging type must be " + PACKAGING_TYPE + ". Custom packages can have any packaging type.");
        }
        return CmsPackaging.builder()
                .height(packaging.getHeight())
                .length(packaging.getLength())
                .width(packaging.getWidth())
                .weight(packaging.getWeight())
                .build();

