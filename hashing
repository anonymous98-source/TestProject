import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@Slf4j
@RestController
@RequiredArgsConstructor
@PreAuthorize("isAuthenticated()")
@RequestMapping("/v1/api")
public class FacilityResidentialFlagController {

  private final FacilityResidentialFlagSettingsRepository facilityResidentialFlagSettingsRepository;

  @PutMapping("/facilities/{facilityId}/settings/residential-flags")
  public ResponseEntity<Void> putFacilityResidentialFlagSettings(
      @RequestHeader HttpHeaders httpHeaders,
      @PathVariable UUID facilityId,
      @RequestBody FacilityResidentialFlagSettingsPutRequest requestBody) {
    // only 1 of the flag values is allowed to be true
    if (requestBody.isAutomaticallyAccept() && requestBody.isRequireAcknowledgement()) {
      return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
    }

    var existingSettings = facilityResidentialFlagSettingsRepository.findById(facilityId);
    if (existingSettings.isPresent()) {
      var settings = existingSettings.get();
      settings.setRequireAcknowledgement(requestBody.isRequireAcknowledgement());
      settings.setAutomaticallyAccept(requestBody.isAutomaticallyAccept());
      facilityResidentialFlagSettingsRepository.save(settings);
    } else {
      var newSettings =
          FacilityResidentialFlagSettingsEntity.builder()
              .facilityId(facilityId)
              .requireAcknowledgement(requestBody.isRequireAcknowledgement())
              .automaticallyAccept(requestBody.isAutomaticallyAccept())
              .build();
      facilityResidentialFlagSettingsRepository.save(newSettings);
    }

    return new ResponseEntity<>(HttpStatus.ACCEPTED);
  }

  @GetMapping("/facilities/{facilityId}/settings/residential-flags")
  public ResponseEntity<FacilityResidentialFlagSettingsResponse> getFacilityResidentialFlagSettings(
      @RequestHeader HttpHeaders httpHeaders, @PathVariable UUID facilityId) {
    return facilityResidentialFlagSettingsRepository
        .findById(facilityId)
        .map(
            facilityResidentialFlagSettingsEntity ->
                ResponseEntity.ok(
                    FacilityResidentialFlagSettingsResponse.fromEntity(
                        facilityResidentialFlagSettingsEntity)))
        .orElseGet(() -> new ResponseEntity<>(HttpStatus.NOT_FOUND));
  }
}

