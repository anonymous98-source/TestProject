import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.SUCCESS;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.DEFAULT_ORDER;
import static com.cardinalhealth.adv.shipping.integration.api.constants.ShippingProfileConstants.VALID_CARRIERS;

@Service
@RequiredArgsConstructor
@Slf4j
public class CarrierOrderingServiceImpl implements CarrierOrderingService {


    private final CarrierOrderingRepository carrierOrderingRepository;
    private final CarrierOrderHelper carrierOrderHelper;

    @Override
    public SuccessResponse saveCarrierOrder(CarrierOrderingRequestDTO carrierOrderingRequestDTO) {

        log.atInfo()
                .setMessage("Service save carrier order operation for given facilityId")
                .log();

        validateFacilityId(carrierOrderingRequestDTO);
        CarrierOrderingEntity existingCarrierOrder = null;
        SuccessResponse response;

        if(Objects.nonNull(carrierOrderingRequestDTO.getFacilityId())) {
            existingCarrierOrder = carrierOrderingRepository.getReferenceByFacilityId(carrierOrderingRequestDTO.getFacilityId());
        }

        if (Objects.nonNull(existingCarrierOrder) && Objects.nonNull(carrierOrderingRequestDTO.getCarrierOrder())) {
            // Update existing entity
            checkCarrier(carrierOrderingRequestDTO.getCarrierOrder());
            existingCarrierOrder.setCarrierOrder(carrierOrderingRequestDTO.getCarrierOrder());
            carrierOrderingRepository.save(existingCarrierOrder);
            response= SuccessResponse.builder()
                    .status(SUCCESS)
                    .message("Carrier ordering added successfully")
                    .build();
        } else if(Objects.nonNull(carrierOrderingRequestDTO.getFacilityId())
                && (Objects.nonNull(carrierOrderingRequestDTO.getCarrierOrder())
                && !carrierOrderingRequestDTO.getCarrierOrder().isEmpty())) {

            checkCarrier(carrierOrderingRequestDTO.getCarrierOrder());
            // Create new entity
            CarrierOrderingEntity carrierOrderingEntity = CarrierOrderingEntity.builder()
                    .facilityId(carrierOrderingRequestDTO.getFacilityId())
                    .carrierOrder(carrierOrderingRequestDTO.getCarrierOrder())
                    .build();
            carrierOrderingRepository.save(carrierOrderingEntity);
            response= SuccessResponse.builder()
                    .status(SUCCESS)
                    .message("Carrier ordering added successfully")
                    .build();
        } else {
            throw new ValidationException("FacilityId and CarrierOrder cannot be empty.");
        }

        return response;
    }

    @Override
    public CarrierOrderingResponseDTO getCarrierOrdering(String facilityId, OflUserPrincipal oflUserPrincipal){

        log.atInfo()
                .setMessage("Service get carrier order for given facilityId")
                .log();

        CarrierOrderingEntity carrierOrderingEntity = carrierOrderingRepository.getReferenceByFacilityId(facilityId);
        List<String> defaultOrder = DEFAULT_ORDER;

        Map<String, Boolean> ocmResponseMap = carrierOrderHelper.getOcmResponse(oflUserPrincipal, facilityId);
        Set<String> allowedCarrierCodes = carrierOrderHelper.getDefaultShippingProfiles(ocmResponseMap, facilityId)
                .stream()
                .map(ShippingProfile::getCarrier)
                .collect(Collectors.toSet());

        defaultOrder = defaultOrder.stream()
                .filter(allowedCarrierCodes::contains)
                .toList();

        if(Objects.isNull(carrierOrderingEntity) || carrierOrderingEntity.getCarrierOrder().isEmpty()) {
            return CarrierOrderingResponseDTO.builder()
                    .carrierOrdering(new ArrayList<>())
                    .defaultOrder(defaultOrder)
                    .build();
        }

        List<String> finalCarrierOrdering = carrierOrderingEntity.getCarrierOrder().stream()
                .filter(carrier -> allowedCarrierCodes.contains(carrier)
                        && Boolean.TRUE.equals(ocmResponseMap.get(carrier)))
                .toList();

        defaultOrder = defaultOrder.stream()
                .filter(carrier -> !finalCarrierOrdering.contains(carrier))
                .toList();
        
        return CarrierOrderingResponseDTO.builder()
                    .facilityId(carrierOrderingEntity.getFacilityId())
                    .carrierOrdering(finalCarrierOrdering)
                    .defaultOrder(defaultOrder)
                    .build();
    }

    private void checkCarrier(List<String> carrierOrdering) {

        List<String> invalidCarriers = carrierOrdering.stream().filter(
               carrier-> VALID_CARRIERS.stream().noneMatch(valid->valid.equalsIgnoreCase(carrier))
       ).toList();

       if(!invalidCarriers.isEmpty()) {
           throw new ValidationException("Invalid carriers found: "+invalidCarriers);
       }
    }

    private void validateFacilityId(CarrierOrderingRequestDTO carrierOrderingRequestDTO) {

        UUID facilityId = null;
        if(Objects.nonNull(carrierOrderingRequestDTO.getFacilityId())) {
            facilityId = UUID.fromString(carrierOrderingRequestDTO.getFacilityId());
        }

        if(Objects.isNull(facilityId)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "FacilityId is incorrect or empty.");
        }
    }
}

