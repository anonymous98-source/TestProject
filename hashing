    private List<ManifestDocumentResponseDto> fetchManifestDocsFromSendFlex(ManifestDocumentRequestDto manifestDocumentRequestDto) {
        log.atInfo()
                .setMessage("Calling SendFlex to fetch manifest document with manifestId: {}")
                .addArgument(manifestDocumentRequestDto.getManifestId())
                .addKeyValue("manifestId", manifestDocumentRequestDto.getManifestId())
