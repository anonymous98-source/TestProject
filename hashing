    @Override
    public ManifestDocumentResponse getManifestDocumentById(String manifestId) {
        log.atInfo().setMessage("Fetching manifest document logic started").log();

        if (manifestId == null || manifestId.isEmpty()) {
            log.atError().setMessage("Manifest ID is null or empty").log();
            throw new ValidationException("Manifest ID cannot be null or empty");
        }

        Manifest manifest = manifestRepository.findByManifestId(manifestId).orElseThrow(() -> {
            log.atError()
                    .setMessage("Manifest not found for ID: {}")
                    .addArgument(manifestId)
                    .addKeyValue("manifestId", manifestId)
                    .log();

            return new ResourceNotFoundException("Manifest not found for ID: " + manifestId);
        });

        return ManifestDocumentResponse.builder()
                .manifestId(manifest.getManifestId())
                .contentType(manifest.getManifestContentType())
                .content(manifest.getManifestContent())
                .build();
    }

    // Private Helper Methods starts here

    private String getDhlProfileCode(ManifestRequest request) {
        log.atInfo().setMessage("fetching DHL profile code from OCM").log();
        UserConfigResponseDTO ocmResponseDTO = ocmWebClientService.getUserConfigDataFromOCM(request.getFacilityId().toString(), request.getCustomerId().toString());
        return ocmResponseDTO.getLocation().getDhlConfiguration().getDhlProfileCode();
