              .isIndividualShipmentProtection(packagingDetails.getPackaging().getIsIndividualShipmentProtection())
              .packageNickname(packageNickname)
              .build();
      String uuid = packaging.getPackagingId();

      ShippingUnitDTO shippingUnit = getShippingUnitDTO(uuid, packaging);

      // Map Accessorials to CarrierAddOns inside ShippingUnitDTO
      Map<String, List<CarrierAddOnsDTO>> carrierAddOnsMap = new HashMap<>();

      List<UserDefaultsResponse> userDefaultsResponses =
              userDefaultsService.getDefaultValues(oflUserPrincipal, shipmentBookRequest.getFacilityId());
      Boolean isUserEnroledInOSP = userDefaultsResponses.get(0).getData().getIsShipmentProtection();
      AspToSendFlexDataMapperUtil.setCarrierAddOnsKeyValueForUSPSForShipPlan(packagingDetails.getAccessorials(),carrierAddOnsMap
              ,shipmentBookRequest.getShippingProfile(),shipmentBookRequest,isUserEnroledInOSP);

      shippingUnit.setCarrierAddOns(carrierAddOnsMap);

      shippingUnit.setReferences(getReferences(packagingDetails.getReference()));

      shippingUnits.add(shippingUnit);

    }

    sendFlexRequest.setShippingUnits(shippingUnits);

    // Map PickupOptions
    PickupOptionsDTO pickupOptions = new PickupOptionsDTO();
    pickupOptions.setPickupBefore(shipmentBookRequest.getShipByDate());
    sendFlexRequest.setPickupOptions(pickupOptions);


    BillingInformationDTO billingInformation = new BillingInformationDTO();

    if (shipmentBookRequest.getBillingInformation() != null) {
      billingInformation.setCostCenter(shipmentBookRequest.getBillingInformation().getCostCenter());
      billingInformation.setOptiFreightNumber(
              shipmentBookRequest.getBillingInformation().getOptiFreightNumber());
      sendFlexRequest.setBillingInformation(billingInformation);
    }

    //mapping shipViaOptions
    List<ShipViaOptionRequestDTO> shipViaOptions = new ArrayList<>();
    ShipViaOptionRequestDTO shipViaOptionRequestDTO = ShipViaOptionRequestDTO.builder().code(shipmentBookRequest.getShipViaOptions().get(0).getCode()).build();
    shipViaOptions.add(shipViaOptionRequestDTO);
    sendFlexRequest.setShipViaOptions(shipViaOptions);

    sendFlexRequest.setTransactionIdentifier(getTransactionIdentifier());

    return sendFlexRequest;
  }

  private String getTransactionIdentifier() {
    return Optional.ofNullable(MDC.get(ServiceCommonConstants.CORRELATION_ID))
            .filter(correlationId -> !correlationId.isBlank())
            .orElse(null);
  }


