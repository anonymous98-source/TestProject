  private List<ShippingProfilePackageType> getAssociatedPackagesList(
      ShippingProfileRequest request, ShippingProfile existingShippingProfile) {

    // Validate if the IDs in request are of type UUID
    List<UUID> validIds =
        request.getSelectedPackages().stream()
            .map(
                packageId -> {
                  try {
                    return UUID.fromString(packageId);
                  } catch (IllegalArgumentException e) {
                    throw new ValidationException("Invalid Package ID : " + packageId);
                  }
                })
            .toList();

    // Fetch existing entity IDs from DB
    Set<PackageProfileEntity> packageProfiles =
            repositoryCallsUtil.findAllPackageProfileByIdIn(validIds);
    Set<UUID> packageProfileIds = packageProfiles.stream()
            .map(PackageProfileEntity::getId)
            .collect(Collectors.toSet());


    Set<UUID> packageTypeIds =
        repositoryCallsUtil.findAllPackageTypeByIdIn(validIds).stream()
            .map(PackageType::getId)
            .collect(Collectors.toSet());

    // Validate if all IDs were found
    for (UUID id : validIds) {
      if (!packageProfileIds.contains(id) && !packageTypeIds.contains(id)) {
        throw new ResourceNotFoundException("Package not found for ID : " + id);
      }
    }

    // Prepare list of mapping base on the IDs
    List<ShippingProfilePackageType> newMappingList =
        validIds.stream()
            .map(
                id ->
                    prepareShippingProfilePackageType(
                        id, packageProfileIds.contains(id) ? "Package Profile" : "Package Type"))
            .toList();

    // Check if request is to update shipping profile
    if (existingShippingProfile != null) {
      // Get Existing Mapping List
      List<ShippingProfilePackageType> existingMappingList =
          existingShippingProfile.getShippingProfilePackageTypes();
      // Get list of package ID's in request
      Set<UUID> newIdSet = new HashSet<>(packageProfileIds);
      newIdSet.addAll(packageTypeIds);

      Set<UUID> existingIdSet =
          existingMappingList.stream()
              .map(ShippingProfilePackageType::getEntityId)
              .collect(Collectors.toSet());

      // Remove the IDs present in existing mapping but not in new mapping
      existingMappingList.removeIf(mapping -> !newIdSet.contains(mapping.getEntityId()));
      // Adding the IDs present in new mapping but not in old mapping
      for (ShippingProfilePackageType newMapping : newMappingList) {
        if (!existingIdSet.contains(newMapping.getEntityId())) {
          existingMappingList.add(newMapping);
        }
      }
      // Replacing the list of mapping objects before returning
      newMappingList = existingMappingList;
    }
    return newMappingList;
  }

    private ShippingProfilePackageType prepareShippingProfilePackageType(
      UUID entityId, String entityType) {
    return ShippingProfilePackageType.builder().entityId(entityId).entityType(entityType).build();
  }

