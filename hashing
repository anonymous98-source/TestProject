    newShipmentDtoBuilder.totalPackages(shipmentBookRequest.getTotalPackageCount());
  }

  private void buildShipToAddress(
      ShipToAddress shipToAddress,
      AddressResponse deliveryAddress,
      NewShipmentDto.NewShipmentDtoBuilder shipmentBuilder) {

    shipmentBuilder
        .shipmentRecipientName(deliveryAddress.getName())
        .shipToCompany(deliveryAddress.getContact())
        .shipToCity(deliveryAddress.getCity())
        .shipToZip(deliveryAddress.getZip())
        .shipToState(deliveryAddress.getState())
