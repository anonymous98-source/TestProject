/** ZipCode Validation Controller to validate zipcode details against OCM. */
@Slf4j
@RestController
@RequiredArgsConstructor
@PreAuthorize("isAuthenticated() && (hasRole('ADVSHIP_SHIPPER') || hasRole('ADVSHIP_CUSTOMER_ADMIN'))")
@Validated
@RequestMapping("v1/api/zipcode")
public class ZipCodeValidationController {

  private final ZipCodeValidationService zipCodeValidationService;
  private final SubscriptionAccessValidator subscriptionAccessValidator;

  /** Get call to validate Ship_To zipcode details */
  @GetMapping("/validation")
  public ResponseEntity<ZipCodeValidationResponse> validateZipCode(
      @RequestHeader HttpHeaders headers,
      @RequestParam @NotBlank(message = "Facility Id must be provided.") String facilityId,
      @RequestParam
          @NotBlank(message = "Zip-Code must be provided.")
          @Size(max = 10, message = "Zip-Code can't have more than 10 characters.")
          @Pattern(
              regexp = "\\d{5}-\\d{4}|\\d{5}",
              message = "Zip-Code must be in XXXXX-XXXX or XXXXX format.")
          String zipCode) {

      log.atInfo()
              .setMessage("Request received for ZipCode validation")
              .log();
    subscriptionAccessValidator.validatePremiumFeatureAccess(facilityId);
    ZipCodeValidationResponse response =
        zipCodeValidationService.validateZipCode(
            ZipCodeValidationRequest.builder().facilityId(facilityId).zipCode(zipCode).build(),
            headers.getFirst(HttpHeaders.AUTHORIZATION));


    return ResponseEntity.ok(response);
  }
}

