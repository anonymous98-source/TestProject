class WeightRuleContextExtractorTest {
    private final WeightRuleContextExtractor extractor = new WeightRuleContextExtractor();

    @Test
    void extract_weightValidation_variousCases() {
        // Valid weights
        Map<String, Object> ctx = new HashMap<>();
        ctx.put("weight", "1.00");
        WeightRuleContext result1 = extractor.extract(ctx);
        assertEquals(new BigDecimal("1.00"), result1.weight());

        ctx.put("weight", "150.00");
        WeightRuleContext result2 = extractor.extract(ctx);
        assertEquals(new BigDecimal("150.00"), result2.weight());

        ctx.put("weight", "0.01");
        WeightRuleContext result3 = extractor.extract(ctx);
        assertEquals(new BigDecimal("0.01"), result3.weight());

        // Invalid weights
        String[] invalidWeights = {"0.00", "-1.00", "151.00", "150.001", "1.001"};
        for (String w : invalidWeights) {
            ctx.put("weight", w);
            ValidationException ex = assertThrows(ValidationException.class, () -> extractor.extract(ctx));
            assertTrue(ex.getMessage().contains("weight must be positive value upto 150 with max 2 decimal places") || ex.getMessage().contains("weight is required"));
        }

        // Missing weight
        ctx.remove("weight");
        ValidationException ex = assertThrows(ValidationException.class, () -> extractor.extract(ctx));
        assertTrue(ex.getMessage().contains("weight is required"));
    }
}

