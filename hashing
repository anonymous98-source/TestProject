    public void addBillingInformationToNewShipmentDto(
            ShipmentBookRequest shipmentBookRequest,  NewShipmentDto.NewShipmentDtoBuilder newShipmentDtoBuilder) {

        if (shipmentBookRequest.getBillingInformation() != null) {
            newShipmentDtoBuilder.shipmentCostCenter(
                    shipmentBookRequest.getBillingInformation().getCostCenter());

            if (shipmentBookRequest.getBillingInformation().getCostCenter() != null) {
                newShipmentDtoBuilder.costCenterNumber(extractCostCenterNumber(
                        shipmentBookRequest.getBillingInformation().getCostCenter()));

                newShipmentDtoBuilder.costCenterName(extractCostCenterName(
                        shipmentBookRequest.getBillingInformation().getCostCenter()));
            }

            newShipmentDtoBuilder.shipmentCarrierAccountNumber(
                    shipmentBookRequest.getBillingInformation().getCarrierAccountNumber());

            newShipmentDtoBuilder.shipmentOptiFreightNumber(
                    shipmentBookRequest.getBillingInformation().getOptiFreightNumber());

            newShipmentDtoBuilder.shipmentNonOptiFreightNumber(
                    shipmentBookRequest.getBillingInformation().getNonOptiFreightNumber());
        }
    }


    public String extractCostCenterNumber(String costCenter) {
        int startIndex = costCenter.indexOf('(');
        int endIndex = costCenter.indexOf(')');
        if (startIndex != -1 && endIndex != -1) {
            return costCenter.substring(startIndex + 1, endIndex).trim();
        } else {
            return costCenter;
        }
    }

    public String extractCostCenterName(String costCenter) {
