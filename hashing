        final UUID addressFacilityMappingUUID = validateAndConvertUUID(addressFacilityMappingID,
                AddressBookConstants.OPERATION_TYPE_DELETE,AddressBookConstants.ADDRESS_ID);

        log.atInfo()
                .setMessage("Inside service method to delete an existing address in the address book")
                .log();

        // Check if provided Address ID is present in address facility mapping table
        List<ShipToAddressFacilityMapping> allFacilityMappingWithAssociatedShipToAddress =
                shipToAddressFacilityMappingRepository
                        .findAllFacilityMappingAssociatedWithSameShipToAddress(addressFacilityMappingUUID);

        if (allFacilityMappingWithAssociatedShipToAddress == null
                || allFacilityMappingWithAssociatedShipToAddress.isEmpty()) {
            log.atInfo()
                    .setMessage("No Facility mapping found with provided Facility mapping address ID")
                    .log();
            throw new ResourceNotFoundException("Address not found in address facility mapping table for " +
                    "address ID: " + addressFacilityMappingUUID.toString());
        }

        // Delete address records from applicable tables
        deleteAddressRecordFromRequiredTables(allFacilityMappingWithAssociatedShipToAddress,
                addressFacilityMappingUUID);

        return SuccessResponse.builder()
                .status(AddressBookConstants.SUCCESS_STATUS)
                .message(AddressBookConstants.DELETE_ADDRESS_SUCCESS_MESSAGE)
                .build();
    }

    /**
     * Deletes entries from the database tables based on the provided ship-to address
     * and facility mapping. If a ship-to address is associated with only one facility
     * mapping, both the facility mapping and the ship-to address will be deleted.
     * If ship to address is associated with multiple facility mappings, only
     * specified facility mapping is deleted.
     *
     * @param allFacilityMappings        all the facility mappings associated with the same
     *                                   ship-to address as the facility mapping with provided ID
     * @param addressFacilityMappingUUID the unique identifier of the specific facility
     *                                   mapping to be deleted
     */
    private void deleteAddressRecordFromRequiredTables(List<ShipToAddressFacilityMapping> allFacilityMappings,
                                                       UUID addressFacilityMappingUUID) {
        // Delete only the facility mapping if ShipToAddress is associated with more than one facility mapping
        // else delete both facility mapping and ship to address entry in case it is associated with only one
        allFacilityMappings.stream()
                .filter(facilityMapping ->
                        facilityMapping.getId().equals(addressFacilityMappingUUID))
                .findFirst()
                .ifPresent(facilityMapping -> {
                    // Delete Facility Mapping entity from DB
                    shipToAddressFacilityMappingRepository.deleteById(addressFacilityMappingUUID);
                    log.atInfo()
                            .setMessage("Deleting Ship To Address facility mapping record")
                            .log();
                });

        // Delete the Ship to address if only one Facility mapping is mapped to corresponding ShipToAddress
        if (allFacilityMappings.size() == 1) {
            UUID shipToAddressId = null;
            shipToAddressId = allFacilityMappings.get(0).getShipToAddress().getId();
            shipToAddressRepository.deleteById(shipToAddressId);
            log.atInfo()
                    .setMessage("Deleting Ship To Address record as well")
                    .log();
        }
    }

    /**
     * Updates the favorite status of an address for a user.
     *
     * @param addressId        the UUID of the address mapping
     * @param oflUserPrincipal the authenticated user principal
     * @param isFavorite       the flag indicating whether the address should be marked as favorite or unfavorite
     * @return SuccessResponse DTO with the status and message of the update operation
     */

    @Override
    public SuccessResponse updateFavorite(UUID addressId, OflUserPrincipal oflUserPrincipal, boolean isFavorite) {
        log.atInfo()
                        .setMessage("service method to update favorite status of an address")
                        .log();

        final UUID facilityMappingUUID = validateAndConvertUUID(addressId.toString(),
                AddressBookConstants.OPERATION_TYPE_UPDATE,AddressBookConstants.ADDRESS_ID);

        log.atInfo()
                .setMessage("Inside service method to update favorite status of an address")
                .log();

        UserDto user = userDetailsService.buildUserDtoFromOflUserPrincipal(oflUserPrincipal);
        Optional<User> userOptional = Optional.ofNullable(userDetailsService.findOrUpdateUser(user.getMonarchUserId(),user.getUserEmail()));
        UUID userId = userOptional.map(User::getId).orElse(null);

        if (userId == null) {
            log.atInfo()
                    .setMessage("User not found for the provided user principal")
                    .log();
            throw new DatabaseException("An error occurred while processing your request. Please try again later.");
        }


        if (isFavorite) {
            if (shipToAddressFavoriteRepository.findByUserIdAndShipToAddressFacilityMappingId(userId, facilityMappingUUID) == null) {
                ShipToAddressFavorite favorite = ShipToAddressFavorite.builder()
                        .user(userOptional.get())
                        .shipToAddressFacilityMapping(shipToAddressFacilityMappingRepository.findById(facilityMappingUUID).orElseThrow(() -> new ResourceNotFoundException("Facility mapping not found for ID: " + facilityMappingUUID.toString())))
                        .build();
                shipToAddressFavoriteRepository.save(favorite);
            }
            log.atInfo()
                    .setMessage("Address marked as favorite successfully")
                    .log();
            return SuccessResponse.builder()
                    .status(AddressBookConstants.SUCCESS_STATUS)
                    .message("Address marked as favorite successfully")
                    .build();
        } else {
            shipToAddressFavoriteRepository.deleteByUserIdAndMappingId(userId, facilityMappingUUID);
            log.atInfo()
                    .setMessage("Address marked as UnFavorite successfully")
                    .log();
            return SuccessResponse.builder()
                    .status(AddressBookConstants.SUCCESS_STATUS)
                    .message("Address marked as UnFavorite successfully")
                    .build();
        }

    }

}

