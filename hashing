    private String getStreet2(List<String> addressLines) {
        if (addressLines == null || addressLines.size() <= 1) {
            return "";
        }
        return addressLines.stream()
                .skip(1) // Skip the first element (index 0)
                .collect(Collectors.joining(" "));
