            saveTags(request, packageType.getId());
        }
       log.atInfo().setMessage("Package updated successfully").log();

        return getResponseEntity(HttpStatus.OK, SUCCESS, PACKAGE_UPDATED, request.getPackageTypeId());
    }

    private void validateDimensions(PackageTypeRequestDTO request) {
        log.atInfo().setMessage("validating dimensions").log();

        PackageTypeRequestDTO.Dimension outer = request.getOuterDimension();
        PackageTypeRequestDTO.Dimension inner = request.getInnerDimension();
        if(Objects.isNull(outer)
                || validateDimValueNull(outer.getLength())
                || validateDimValueNull(outer.getWidth())
                || validateDimValueNull(outer.getHeight())){
            throw new ValidationException("All Outer Dimensions must be greater than 0");
        }
        if( Objects.nonNull(inner) &&
                (validateDimValueNotNull(inner.getLength())
                || validateDimValueNotNull(inner.getWidth())
                || validateDimValueNotNull(inner.getHeight())) &&
                (validateDimValueNull(inner.getLength())
                || validateDimValueNull(inner.getWidth())
                || validateDimValueNull(inner.getHeight())) ){

                throw new ValidationException("All or none of the Inner Dimensions must be provided");


        }
    }

    private boolean validateDimValueNotNull(Double dimValue) {
        return Objects.nonNull(dimValue) && dimValue > 0;
    }

    private boolean validateDimValueNull(Double dimValue) {
        return Objects.isNull(dimValue) || dimValue <= 0;
    }

    private PackageType createPackageType(PackageTypeRequestDTO request) {

        log.atInfo().setMessage("Preparing package type to persist").log();

        // set fields
        PackageType.PackageTypeBuilder packageTypeBuilder = PackageType.builder()
                .packageTypeName(request.getPackageTypeName())
                .facilityId(request.getFacilityId())
                .isColdChain(request.getIsColdChain())
                .ratedLength(request.getIsColdChain().equals(Boolean.TRUE) ? request.getRatedLength() : null)
                .isDryIce(request.getIsDryIce() != null ? request.getIsDryIce() : null)
                .dryIceWeight( request.getIsDryIce().equals(Boolean.TRUE) ? request.getDryIceWeight() : null)
                .packagingType(request.getPackagingType())
                .packageBrand(request.getPackageBrand())
                .packageTypeName(request.getPackageTypeName())
                .packageProductName(request.getPackageProductName())
                .packageDescription(request.getPackageDescription())
                .packageModelIdentifier(request.getPackageModelIdentifier())
                .active(request.getActive());

        //set dimensions fields
        if(Objects.nonNull(request.getOuterDimension())
                && Objects.nonNull(request.getOuterDimension().getHeight())
                && Objects.nonNull(request.getOuterDimension().getLength())
                && Objects.nonNull(request.getOuterDimension().getWidth())) {
                    packageTypeBuilder.length(request.getOuterDimension().getLength());
                    packageTypeBuilder.width(request.getOuterDimension().getWidth());
                    packageTypeBuilder.height(request.getOuterDimension().getHeight());
        }

        if(Objects.nonNull(request.getInnerDimension())
                && Objects.nonNull(request.getInnerDimension().getHeight())
                && Objects.nonNull(request.getInnerDimension().getLength())
                && Objects.nonNull(request.getInnerDimension().getWidth())) {
            packageTypeBuilder.innerLength(request.getInnerDimension().getLength());
            packageTypeBuilder.innerWidth(request.getInnerDimension().getWidth());
            packageTypeBuilder.innerHeight(request.getInnerDimension().getHeight());
        }

        PackageType entity = packageTypeBuilder.build();

        return packageTypeRepository.save(entity);
    }

    private void saveTags(PackageTypeRequestDTO request, UUID entityId) {
        String customerId = request.getCustomerId().toString();

        if(Objects.nonNull(entityId)) {
            tagMappingRepository.deleteByEntityIdAndEntityType(entityId, PACKAGE);
        }

        List<String> tags = request.getTags().stream()
                .filter(TagDto::getActive)
                .map(TagDto::getTagName)
                .toList();

        //  Get existing tags for the customer
        List<Tag> existingTags = repositoryCallsUtil.getTagIds(tags, customerId);
        Map<String, Tag> tagNametoTagMap =
                existingTags.stream().collect(Collectors.toMap(Tag::getTagName, Function.identity()));

        // Create and save new tags if they don't exist
        List<Tag> newTags =
                tags.stream()
                        .filter(tagName -> !tagNametoTagMap.containsKey(tagName))
                        .map(
                                tagName ->
                                        Tag.builder()
                                                .tagName(tagName)
                                                .customerId(UUID.fromString(customerId))
                                                .active(true)
                                                .build())
                        .collect(Collectors.toList());
        if (!newTags.isEmpty()) {
            newTags = repositoryCallsUtil.saveTags(newTags);
            newTags.forEach(tag -> tagNametoTagMap.put(tag.getTagName(), tag));
        }

        // Collect all tag IDs to be mapped
        Set<UUID> newTagIds =
                tags.stream()
                        .map(tagName -> tagNametoTagMap.get(tagName).getId())
                        .collect(Collectors.toSet());

        // Need to update existing mapping if update request
        if (entityId != null) {
            List<TagMapping> existingMap =
                    repositoryCallsUtil.getExistingTagMapping(entityId, PACKAGE);

            Set<UUID> existingTagIdsSet =
                    existingMap.stream().map(TagMapping::getId).collect(Collectors.toSet());

            Set<UUID> tagsToRemove = new HashSet<>(existingTagIdsSet);
            tagsToRemove.removeAll(newTagIds);

            Set<UUID> tagsToAdd = new HashSet<>(newTagIds);
            tagsToAdd.removeAll(existingTagIdsSet);

            if (!tagsToRemove.isEmpty()) {
                List<TagMapping> toDelete =
                        existingMap.stream()
                                .filter(tagMapping -> tagsToRemove.contains(tagMapping.getTag().getId()))
                                .toList();
                repositoryCallsUtil.removeTagMapping(toDelete);
            }

            List<TagMapping> tagMappingToAdd =
                    tagsToAdd.stream()
                            .map(tagId -> {
                                Tag tag =
                                        tagNametoTagMap.values().stream()
                                                .filter(e -> e.getId().equals(tagId))
                                                .findFirst()
                                                .orElseThrow(
                                                        () -> new DatabaseException("Tag not found for Tag ID: " + tagId));
                                return TagMapping.builder()
                                        .entityId(entityId)
                                        .entityType(PACKAGE)
                                        .tag(tag)
                                        .build();
                            })
                            .collect(Collectors.toList());
            repositoryCallsUtil.saveTagMapping(tagMappingToAdd);
        } else {
            // Just add mapping as create scenario
            List<TagMapping> newMappings =
                    tags.stream()
                            .map(
                                    tagName ->
                                            TagMapping.builder()
                                                    .entityId(entityId)
                                                    .entityType(PACKAGE)
                                                    .tag(tagNametoTagMap.get(tagName))
                                                    .build())
                            .collect(Collectors.toList());
            repositoryCallsUtil.saveTagMapping(newMappings);
        }
    }

