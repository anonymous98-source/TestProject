  @Test
  void test_validateShippingProfileDetails_success() {
    // Arrange
    UUID packageTypeId = UUID.fromString(request.getPackagingDetails().get(0).getPackaging().getPackagingId());

    Tag mockTag = Tag.builder()
            .id(UUID.randomUUID())
            .tagName("Fragile")
            .active(true)
            .build();

    TagMapping tagMapping = TagMapping.builder()
            .entityId(packageTypeId)
            .entityType("PACKAGE")
            .tag(mockTag)
            .build();

    PackageType mockPackageType = PackageType.builder()
            .id(packageTypeId)
            .packageTypeName("Box")
            .ratedLength(2.0)
            .active(true)
            .innerHeight(2.0)
            .innerLength(2.0)
            .innerWidth(2.0)
            .build();

    request.setShippingProfileId(String.valueOf(shippingProfileId));
    PremiumFeatureResponse feature = getMockPremiumFeatureResponse(false, false, false, false);
    when(shippingProfileRepository.findById(any()))
        .thenReturn(Optional.ofNullable(ShippingProfile.builder().id(shippingProfileId).build()));
    when(tagMappingRepository.findAllByEntityTypeAndEntityIdIn(eq("Package"), any()))
            .thenReturn(List.of(tagMapping));
    when(packageTypeRepository.findAllById(any())).thenReturn(List.of(mockPackageType));

    // Act
    validator.validateShippingProfileDetails(request, feature);
    // Assert & Verify
    verify(shippingProfileRepository, times(1)).findById(any());
    assertFalse(request.isEpicWillowAmbulatoryIntegration());
    assertEquals("Navigator", request.getNavigatorLevel());
    assertEquals("Beacon", request.getBeaconLevel());
  }

