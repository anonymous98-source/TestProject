  private void validateReadyAndAvailableTimeDifference(String readyTime, String availableUntil) {
    var formatter = DateTimeFormatter.ofPattern("h:mm a", Locale.ENGLISH);
    var ready = LocalTime.parse(readyTime, formatter);
    var available = LocalTime.parse(availableUntil, formatter);
    isValidInterval(ready, "Ready Time");
    isValidInterval(available, "Available Until");
    if (!ready.isBefore(available)) {
      throw new ValidationException("Ready Time must be before Available Until.");
    }
  }

  private void isValidInterval(LocalTime time, String timeType) {
    int min = time.getMinute();
    if (min != 0 && min != 30) {
      throw new ValidationException(timeType + " must have minutes 00 or 30.");
    }
  }

  private void validateSignature(ShippingProfileRequest request) {
    switch (request.getSignature()) {
      case INDIRECT_SIGNATURE_REQUIRED:
        request.setSignature(DELIVERYSIGNATUREREQUIRED);
        break;
      case SERVICE_DEFAULT:
        request.setSignature(DELIVERYNOSIGNATURERE);
        break;
      case ADULT_SIGNATURE_REQUIRED:
        request.setSignature(DELIVERYADULTSIGNATUREREQUIRED);
        break;
      case DIRECT_SIGNATURE_REQUIRED:
        request.setSignature(DELIVERYDIRECTSIGNATUREREQUIRED);
        break;
      case SIGNATURE_CONFIRMATION:
        request.setSignature(request.getCarrier().equalsIgnoreCase(FE_DHL_KEY)
                ? DHL_SIGNATURE_CONFIRMATION : USPS_SIGNATURE_CONFIRMATION);
        break;
      case ADULT_SIGNATURE_OLDER_REQUIRED:
        request.setSignature(request.getCarrier().equalsIgnoreCase(FE_DHL_KEY)
                ? DHL_ADULT_SIGNATURE_REQUIRED : USPS_ADULT_SIGNATURE_REQUIRED);
        break;
      case ADULT_SIGNATURE_RESTRICTED_DELIVERY:
        request.setSignature(request.getCarrier().equalsIgnoreCase(FE_DHL_KEY)
                ? DHL_ADULT_SIGNATURE_RESTRICTED : USPS_ADULT_SIGNATURE_RESTRICTED);
        break;
      default:
        throw new ValidationException("Invalid signature: " + request.getSignature());
    }
  }

  private void validateCarrierServiceLevelValue(
          String carrierServiceLevel, List<String> serviceLevels) {
    List<CarrierServiceLevel> carriersServiceLevels = carrierServiceLevelRepository.findByAdminServiceLevelNameIn(serviceLevels);
    if (carriersServiceLevels == null || carriersServiceLevels.isEmpty()) {
      throw new ValidationException("No carrier service level found in DB for given levels.");
    }
    Set<String> dbServiceLevelCodes = carriersServiceLevels.stream()
                    .filter(Objects::nonNull)
                            .map(CarrierServiceLevel::getServiceLevelCode)
                                    .filter(Objects::nonNull)
                                            .collect(Collectors.toSet());

    if (!dbServiceLevelCodes.contains(carrierServiceLevel)) {
      throw new ValidationException("Invalid carrier service level: " + carrierServiceLevel);
    }
  }
