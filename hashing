  public UserDto getUserDto(OflUserPrincipal oflUserPrincipal, String customerId) {
    Object originalPrincipal = oflUserPrincipal.getOriginalPrincipal();
    // Check if originalPrincipal is an instance of DefaultOAuth2AuthenticatedPrincipal
    if (originalPrincipal instanceof DefaultOAuth2AuthenticatedPrincipal attributes) {
      String oktaId = attributes.getAttribute("uid");
      if (oflUserPrincipal.getId() != null && oktaId != null) {
        return UserDto.builder()
            .monarchUserId(oflUserPrincipal.getId())
            .userOktaUserId(oktaId)
            .userEmail(oflUserPrincipal.getEmail())
            .lastName(oflUserPrincipal.getLastName())
            .firstName(oflUserPrincipal.getFirstName())
            .customerId(customerId)
            .build();
      } else {
        throw new ResourceNotFoundException("User is not authenticated");
      }
    } else {
      throw new ResourceNotFoundException("Original principal is not of the expected type");
    }
  }

  public List<FedexServiceLevelDTO> defaultFedex(UserConfigResponseDTO responseDTO) {
    List<String> adminLevelServiceLevels =
        responseDTO.getLocation().getFedexConfiguration().getFedexServiceLevels();
    if (adminLevelServiceLevels == null || adminLevelServiceLevels.isEmpty()) {
      return new ArrayList<>();
    }
    List<CarrierServiceLevel> carrierServiceLevels =
        carrierServiceLevelRepository.findByAdminServiceLevelNameIn(adminLevelServiceLevels);
    if (carrierServiceLevels == null || carrierServiceLevels.isEmpty()) {
      throw new ValidationException(CARRIER_SERVICE_LEVEL_NOT_FOUND_MSG);
    }
    return carrierServiceLevels.stream()
        .map(
            serviceLevel ->
                FedexServiceLevelDTO.builder()
                    .serviceLevelCode(serviceLevel.getServiceLevelCode())
                    .serviceLevelName(serviceLevel.getServiceLevelName())
                    .build())
        .toList();
  }

