package com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.facade;

import com.cardinalhealth.adv.shipping.integration.api.database.entity.RuleDefinition;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.common.RuleEvalMethod;
import com.cardinalhealth.adv.shipping.integration.api.shippingrule.evaluation.context.RuleContext;
import org.springframework.expression.ExpressionParser;
import org.springframework.expression.spel.standard.SpelExpressionParser;
import org.springframework.expression.spel.support.StandardEvaluationContext;
import org.springframework.stereotype.Component;

/**
 * Evaluates a given rule definition against the provided context. It supports both value-based and expression-based evaluations.
 * For value-based rules, it checks if the context's relevant field matches the rule's defined value.
 * For expression-based rules, it uses Spring Expression Language (SpEL) to evaluate the rule's expression against the context.
 */

@Component
public class RuleEvaluator {

    private final ExpressionParser expressionParser = new SpelExpressionParser();

    public boolean evaluate(RuleDefinition ruleDefinition, RuleContext ruleContext) {
        if (ruleDefinition.getRuleEvalMethod().equals(RuleEvalMethod.EXPRESSION.getMethod())) {
            return evaluateExpression(ruleDefinition, ruleContext);
        }
        return false;
    }

    private boolean evaluateExpression(RuleDefinition ruleDefinition, RuleContext context) {
        StandardEvaluationContext evaluationContext = new StandardEvaluationContext(context);
        return Boolean.TRUE.equals(
                expressionParser
                        .parseExpression(ruleDefinition.getExpression())
                        .getValue(evaluationContext, Boolean.class));
    }
}

