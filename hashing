  private ShippingUnitDTO buildShippingUnit(PackageProfileEntity packagesInfo, Packaging packaging) {
    return ShippingUnitDTO.builder()
            .packageNumber(1)
            .length(validateMeasurement(packagesInfo != null ? packagesInfo.getPackageProfileLength() : packaging.getLength()))
            .weight(validateWeight(packaging.getWeight()))
            .height(validateMeasurement(packagesInfo != null && packagesInfo.getPackageProfileHeight() != null ? packagesInfo.getPackageProfileHeight() : 0.5f))
            .width(validateMeasurement(packagesInfo != null ? packagesInfo.getPackageProfileWidth() : packaging.getWidth()))
            .dimensionUOM(packagesInfo != null ? packagesInfo.getPackageProfileDimUnit() : packaging.getDimensionUOM())
            .weightUOM(packagesInfo != null ? packagesInfo.getPackageProfileWeightUnit() : packaging.getWeightUOM())
            .type(ServiceCommonConstants.PACKAGE)
            .build();
  }

  private static float validateMeasurement(float measuringField) {
    return Math.max(measuringField, MIN_MEASUREMENT_VALUE);
  }

  private static float validateWeight(float measuringField) {
    return measuringField > 0 ? measuringField : 0.1f;
  }


