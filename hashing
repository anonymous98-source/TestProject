  @Test
  void testGetAddressByFacilityId_success() {
    DefaultOAuth2AuthenticatedPrincipal originalPrincipal =
        new DefaultOAuth2AuthenticatedPrincipal(
            "username",
            Collections.singletonMap("uid", "okta123"),
            Collections.singletonList(new SimpleGrantedAuthority("ROLE_USER")));

    OflUserPrincipal oflUserPrincipal =
        new OflUserPrincipal(
            originalPrincipal,
            UUID.randomUUID(),
            "username",
            "firstName",
            "lastName",
            "email@example.com",
            "phone",
            "title",
            true,
            new byte[0],
            new ArrayList<UserPermission>(),
            null);

    String facilityId = "facility123";
    String sortingColumn = "name";
    String sortingDirection = "ASC";
    String search = "Delhi";
    int pageNo = 0;
    int pageSize = 100;
    Pageable pageable = PageRequest.of(pageNo, pageSize);

    ShipToAddress shipToAddress1 = new ShipToAddress();
    shipToAddress1.setId(UUID.randomUUID());
    ShipToAddressFacilityMapping mapping1 = new ShipToAddressFacilityMapping();
    mapping1.setId(UUID.randomUUID());
    mapping1.setShipToAddress(shipToAddress1);
    mapping1.setShipToAddressFavorite(new ArrayList<>());
    ShipToAddressFacilityMappingWithFavorite shipToAddressFacilityMappingWithFavorite1 =
        new ShipToAddressFacilityMappingWithFavorite(mapping1, false);

    ShipToAddress shipToAddress2 = new ShipToAddress();
    shipToAddress2.setId(UUID.randomUUID());
    ShipToAddressFacilityMapping mapping2 = new ShipToAddressFacilityMapping();
    mapping2.setId(UUID.randomUUID());
    mapping2.setShipToAddress(shipToAddress2);
    mapping2.setShipToAddressFavorite(new ArrayList<>());
    ShipToAddressFacilityMappingWithFavorite shipToAddressFacilityMappingWithFavorite2 =
        new ShipToAddressFacilityMappingWithFavorite(mapping2, true);

    Page<ShipToAddressFacilityMappingWithFavorite> mappings =
        new PageImpl<>(
            Arrays.asList(
                shipToAddressFacilityMappingWithFavorite1,
                shipToAddressFacilityMappingWithFavorite2),
            pageable,
            2);

    UUID mockUserId = UUID.randomUUID();
    when(userDetailsService.getUserIdFromUserPrincipal(oflUserPrincipal)).thenReturn(mockUserId);

    when(userDetailsService.buildUserDtoFromOflUserPrincipal(any())).thenReturn(userDto);

    when(shipToAddressFacilityMappingCustomRepository.findByFacilityId(
            facilityId, mockUserId, sortingColumn, sortingDirection, search, pageable))
        .thenReturn(mappings);

    when(shipToAddressFacilityMappingCustomRepository.findAllContactCount(facilityId))
        .thenReturn(1L);
    // Address counts mock
    Map<String, Long> mockedAddressCount = new HashMap<>();
    mockedAddressCount.put(AddressBookConstants.RECENT_ADDRESS_COUNT, 3L);
    mockedAddressCount.put(AddressBookConstants.ALL_ADDRESS_COUNT, 36L);
    mockedAddressCount.put(AddressBookConstants.FAVOURITE_ADDRESS_COUNT, 5L);
    when(addressBookCountRetrievalService.fetchAllAddressCount(any(), any(), any()))
        .thenReturn(mockedAddressCount);

    AllContactsResponseDTO result =
        addressBookServiceImpl.getAddressByFacilityId(
            facilityId,
            sortingColumn,
            sortingDirection,
            search,
            pageNo,
            pageSize,
            oflUserPrincipal);

    assertNotNull(result);
    assertEquals(2, mappings.getTotalElements());
    assertEquals(5, result.getFavouriteAddressCount());
    assertEquals(36, result.getAllContactsCount());
    assertEquals(3, result.getTotalRecentAddresses());
    verify(shipToAddressFacilityMappingCustomRepository, times(1))
        .findByFacilityId(
            facilityId, mockUserId, sortingColumn, sortingDirection, search, pageable);
  }

