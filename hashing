import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.DEFAULT_SHIPPING_RULE;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.PREFERRED_RULE_TYPE_MAPPING;
import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.UNKNOWN_RULE;

@Slf4j
@Component
@RequiredArgsConstructor
public class RuleEvaluationLogUtil {
    private final RuleEvaluationLogRepository ruleEvaluationLogRepository;
    private final PreferredRuleTypeRepository preferredRuleTypeRepository;
    private final JsonMapper mapper = new JsonMapper();

    /**
     * fire-and-forget strategy for async logging
     */
    @Async
    public void saveEvaluationLogAsync(
            RuleEvaluationRequestDto request,
            RuleEvaluationResponseDto response,
            RuleEvaluationResult result,
            String reason,
            String correlationId
    ) {

        log.atInfo()
                .setMessage("Logging the rule evaluation result asynchronously for ruleType: " + request.getRuleType())
                .addKeyValue( "Correlation-id: ", correlationId)
                .log();

        PreferredRuleType preferredRuleType = preferredRuleTypeRepository
                .findByFacilityId(request.getFacilityId());
        String preferredRuleTypeValue = Objects.nonNull(preferredRuleType)
                ? preferredRuleType.getPreferredRuleTypeValue()
                : DEFAULT_SHIPPING_RULE;
        String normalisedRuleType = PREFERRED_RULE_TYPE_MAPPING.getOrDefault(preferredRuleTypeValue, UNKNOWN_RULE);


        // extract the ruleDefinition(single rule or list or rule in case of shipment value) as JSONB from the result
        JsonNode ruleState = null;
        if (result != null) {
            if (result.getRuleType() == RuleType.SHIPMENT_VALUE) {
                ruleState = result.getAccessorials() != null
                        ? mapper.valueToTree(result.getAccessorials().values())
                        : mapper.createArrayNode(); // empty list if null
            } else {
                ruleState = result.getPrimary() != null
                        ? mapper.valueToTree(result.getPrimary())
                        : mapper.nullNode();
            }
        }

        saveEvaluationLog(request, response, ruleState, normalisedRuleType, reason, correlationId);
    }

    private void saveEvaluationLog(
            RuleEvaluationRequestDto request,
            RuleEvaluationResponseDto response,
            JsonNode ruleState,
            String preferredRuleTypeValue,
            String message,
            String correlationId
    ) {
        RuleEvaluationLog log = RuleEvaluationLog.builder()
                .correlationId(correlationId)
                .facilityId(request.getFacilityId())
                .ruleEvalRequest(mapper.valueToTree(request))
                .ruleEvalResponse(mapper.valueToTree(response))
                .requestedRuleType(request.getRuleType().toString())
                .preferredRuleType(preferredRuleTypeValue)
                .resolved(response != null && response.getRuleDetails().getIsMatched() != null
                        && response.getRuleDetails().getIsMatched())
                .message(message)
                .selectedProfileId(response != null && response.getAssignedShippingProfile() != null
                        ? response.getAssignedShippingProfile().getShippingProfileId() : null)
                .selectedProfileName(response != null && response.getAssignedShippingProfile() != null
                        ? response.getAssignedShippingProfile().getShippingProfileName() : null)
                .qualifiedRuleState(ruleState)
                .evaluatedAt(OffsetDateTime.now())
                .conflict(false)
                .build();

        ruleEvaluationLogRepository.save(log);
    }

}

