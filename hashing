  public ShipPlanResponse mapToShipPlanResponse(OcmShipmentResponseDTO ocmResponse) {
    Map<String, List<OcmShipmentResponseDTO.Schedule>> schedulesByDeliveryDate =
            ocmResponse.getSchedules().stream()
                    .collect(
                            Collectors.groupingBy(
                                    schedule -> schedule.getDelivery().getDate(),
                                    LinkedHashMap::new,
                                    Collectors.toList()));

    List<DeliveryDateDto> deliveryDates = new ArrayList<>();

    for (Map.Entry<String, List<OcmShipmentResponseDTO.Schedule>> entry : schedulesByDeliveryDate.entrySet()) {
      String deliveryDateStr = entry.getKey();
      List<DeliverySlot> slots = entry.getValue().stream().map(schedule -> {
        String scheduleId = schedule.getId();
        OcmShipmentResponseDTO.TimeWindow pickup = schedule.getPickup();
        OcmShipmentResponseDTO.TimeWindow delivery = schedule.getDelivery();

        return DeliverySlot.builder()
                .scheduleId(scheduleId)
                .pickupStartTime(pickup.getStartTime())
                .pickupEndTime(pickup.getEndTime())
                .pickupDate(pickup.getDate())
                .deliveryStartTime(delivery.getStartTime())
                .deliveryEndTime(delivery.getEndTime())
                .deliveryDate(delivery.getDate())
                .description(getDescription(ocmResponse.getServiceLevel(), schedule.getPickDelDiff()))
                .shipViaCode(ocmResponse.getServiceLevel())
                .carrierName("")
                .defaultSignatureLevel(String.valueOf(ocmResponse.getFacility().isRequiresSignature()))
                .build();
      }).toList();

      deliveryDates.add(DeliveryDateDto.builder()
              .deliveryDate(deliveryDateStr)
              .availableSlots(slots)
              .build());
    }

    return ShipPlanResponse.builder()
            .shipmentTransactionId("")
            .carrierId("")
            .serviceOptionsForReturnShipment(Collections.emptyMap())
            .deliveryDates(deliveryDates)
            .statusCode("SUCCESS")
            .build();
  }


  private String getDescription(String serviceLevel, Duration pickDelDiff) {
    if (serviceLevel == null) return "";

    return switch (serviceLevel) {
      case OCM_SHIPMENT_TYPE_SAMEDAY -> OCM_SERVICE_LEVEL_SAMEDAY_RESPONSE_DESC;
      case OCM_SHIPMENT_TYPE_NEXTDAY -> OCM_SERVICE_LEVEL_NEXTDAY_RESPONSE_DESC;
      case OCM_SHIPMENT_TYPE_SAMEDAYSTATE -> getPickUpDeliveryDifference(pickDelDiff);
      default -> "";
    };
  }

  private String getPickUpDeliveryDifference(Duration pickDelDiff) {
    return OCM_SERVICE_LEVEL_SAMEDAYSTATE_RESPONSE_DESC + " " + pickDelDiff.toHours() + "-hour";
  }

