     MeteringResponse meteringInvoiceForExistingRecord(FedexMeteringRecord fedexMeteringRecord, Facility facilityDetail, String fedexAccountNumber, String profileCode, CarrierSettings carrierSettings,UUID meteredBy) {
        if(fedexMeteringRecord.getStatus().equalsIgnoreCase(MeteringState.LINK_FAILED.name())) {
            //profile linking failed earlier, so try profile linking again
            return profileCodeLinkingProcess(profileCode, fedexMeteringRecord.getRequestId(), fedexMeteringRecord,meteredBy);
        }else {
            //status: Pending/Failed scenario handle --> User initiate metering by MFA
            CarrierRegisterRequest carrierRegisterRequest= meteringDataMapper.buildCarrierRegisterRequest(fedexMeteringRecord.getRequestId(),facilityDetail, fedexAccountNumber, profileCode, carrierSettings);
            CarrierRegisterResult carrierRegisterResult=mfaRegisterAndLinkWebClient.mfaRegistration(carrierRegisterRequest);
            if(carrierRegisterResult!=null && carrierRegisterResult.getSuccess()!=null) {
                //profile code entry when profile linking is done.
                fedexMeteringRecord.setMeteredBy(meteredBy);
                fedexMeteringRecord.setStatus(MeteringState.COMPLETED.name());
                fedexMeteringRecord.setMeteredAt(LocalDateTime.now(ZoneOffset.UTC));
                fedexMeteringRecord.setErrorMessage(null);
                fedexMeteringRecord.setMeteringMethod(INVOICE);
                FedexMeteringRecord savedRecord=fedexMeteringRecordRepository.save(fedexMeteringRecord);
                return profileCodeLinkingProcess(profileCode, carrierRegisterResult.getSuccess().getId(), savedRecord,meteredBy);
            }else if(carrierRegisterResult!=null && carrierRegisterResult.getError()!=null) {
                fedexMeteringRecord.setStatus(MeteringState.FAILED.name());
                fedexMeteringRecord.setErrorMessage(ERROR_OCCURRED_METERING_REGISTERATION + carrierRegisterResult.getError().getDetail());
                fedexMeteringRecord.setMeteringMethod(INVOICE);
                fedexMeteringRecordRepository.save(fedexMeteringRecord);
                log.atError().addKeyValue(SHIPPER_NUMBER, fedexAccountNumber).setMessage(ERROR_OCCURRED_METERING_REGISTERATION + carrierRegisterResult.getError().getDetail()).log();
                return buildSendFlexMfaResponse(capturePreRegistrationErrorMessage(carrierRegisterResult.getError().getDetail()), ResponseStatus.FAILED.name());
            }else {
                fedexMeteringRecord.setStatus(MeteringState.FAILED.name());
                fedexMeteringRecord.setErrorMessage(ERROR_OCCURRED_METERING_REGISTERATION);
                fedexMeteringRecord.setMeteringMethod(INVOICE);
                fedexMeteringRecordRepository.save(fedexMeteringRecord);
                return buildSendFlexMfaResponse(ERROR_OCCURRED_METERING_REGISTERATION, ResponseStatus.FAILED.name());
            }
        }
