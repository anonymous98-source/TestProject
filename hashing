    /**  Save or Update packageType profile. */
    @Override
    @Transactional
    public ResponseEntity<PackageTypeResponseDTO> saveOrUpdatePackageType(PackageTypeRequestDTO request) {

        log.atInfo().setMessage("Request received to save/update a packageType").log();

        // validate dimensions
        validateDimensions(request);

        //validate tags are not duplicate
        if(Objects.nonNull(request.getTags()) && !request.getTags().isEmpty()) {
            validateUniqueTagNames(request.getTags().stream().map(TagDto::getTagName).toList(), PACKAGE);
        }

        // validate tags count <= 4
        long count  = Objects.nonNull(request.getTags()) ? request.getTags().stream().filter(TagDto::getActive).count() : 0;
        if( count > ALLOWED_TAG_TYPE){
            return getResponseEntity(HttpStatus.OK, FAILURE, MAX_TAG_ALLOWED, null);
        }

        // Update package
        if(Objects.nonNull(request.getPackageTypeId())){
            // update if package already exists, otherwise throw error
            return  updatePackageType(request);
        }
        // else save package
        return  savePackageType(request);
    }

    public void validateUniqueTagNames(List<String> tags, String typeName) {
        Set<String> seen = new HashSet<>();
        Set<String> duplicates = new HashSet<>();

        for (String tag : tags) {
            if (!seen.add(tag)) {
                duplicates.add(tag);
            }
        }

        if (!duplicates.isEmpty()) {
            if(typeName.equalsIgnoreCase(PACKAGE))
                throw new ValidationException("Exact duplicate tags within the profile are not allowed");
            if(typeName.equalsIgnoreCase(SHIPPING))
                throw new ValidationException("Exact duplicate tags within the shipping profile are not allowed");
        }
    }


    // Create and Save new PackageType
    private ResponseEntity<PackageTypeResponseDTO> savePackageType(PackageTypeRequestDTO request){
        log.atInfo().setMessage("Request received to SAVE a packageType").log();

        //validate package count <= 20
        Long packageCount = packageTypeRepository.countByFacilityIdAndActiveTrue(request.getFacilityId());
        if(packageCount >= ALLOWED_PACKAGE_TYPE){
            return getResponseEntity(HttpStatus.OK, FAILURE,MAX_PACKAGE_ALLOWED, null);
        }

        // create package to persist
        PackageType packageEntity = createPackageType(request);

        if (Objects.isNull(packageEntity.getId())) {
            return getResponseEntity(HttpStatus.INTERNAL_SERVER_ERROR, FAILURE, PACKAGE_SAVING_FAILED, null);
        }

        // save tags
        if(Objects.nonNull(request.getTags())){
            log.atInfo().setMessage("Initiating tags SAVE of total tags: "+ request.getTags().size()).log();
            saveTags(request, packageEntity.getId());
        }
        log.atInfo().setMessage("Package saved successfully").log();
        return getResponseEntity(HttpStatus.OK, SUCCESS, PACKAGE_SAVED, packageEntity.getId());
    }

    /** Update packageType */
    private ResponseEntity<PackageTypeResponseDTO> updatePackageType(PackageTypeRequestDTO request){

        PackageType packageType = packageTypeRepository.findByIdAndActiveTrue(request.getPackageTypeId())
