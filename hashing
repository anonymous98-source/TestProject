                total = charges.stream().filter(t -> PRICE_TOTAL.equalsIgnoreCase(t.getType())).findFirst().map(ChargeDTO::getValue).orElse(null);
                totalBaseChargeAmount = charges.stream().filter(t -> PRICE_FREIGHT.equalsIgnoreCase(t.getType())).findFirst().map(ChargeDTO::getValue).orElse(null);
                totalSurchargeAmount = charges.stream().filter(t -> PRICE_ACCESSORIAL.equalsIgnoreCase(t.getType())).findFirst().map(ChargeDTO::getValue).orElse(null);
                return PriceResult.builder()
