        when(operatorRegistry.getPriority("B")).thenReturn(3);

        List<RuleDefinition> rules = Arrays.asList(rule1, rule2);
        RuleDefinition result = resolver.resolve(rules);
        assertTrue(result == rule1 || result == rule2);
    }

    @Test
    void resolve_throwsExceptionWhenListIsEmpty() {
