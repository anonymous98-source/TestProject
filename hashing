    MeteringResponse meteringInvoiceRecord(MeteringRequest request, FedexMeteringRecord fedexMeteringRecord, Facility facilityDetail, String fedexAccountNumber, String profileCode, CarrierSettings carrierSettings, UUID meteredBy) {
