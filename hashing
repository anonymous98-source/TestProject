  /**
   * Adds new address to the addressbook
   *
   * @param request - the payload containing the new address details
   * @return AddNewAddressSuccessResponse - DTO containing the status and message of the operation
   */
  @PreAuthorize("isAuthenticated() && (hasRole('ADVSHIP_SHIPPER') || hasRole('ADVSHIP_CUSTOMER_ADMIN'))")
  @PostMapping("/add")
  public ResponseEntity<AddressAddSuccessResponse> addNewAddress(
      @Valid @RequestBody AddressBookRequest request,
      @RequestHeader HttpHeaders httpHeaders,
      @AuthenticationPrincipal OflUserPrincipal oflUserPrincipal) {
    log.atInfo()
            .setMessage("Request to add new address in the addressbook")
            .log();
    subscriptionAccessValidator.validatePremiumFeatureAccess(request.getFacilityId());

    AddressAddSuccessResponse response =
        addressBookService.addNewAddress(request, oflUserPrincipal.getUserName());
    return ResponseEntity.ok(response);
  }

  /**
   * This is common API of favourite address view, all contacts view
   *
   * @param pageNo Page number
   * @param pageSize Number of elements in each page
   * @param allContactRequest Request body
   * @param oflUserPrincipal OflUserPrincipal
   * @return AllContactsResponseDTO object with address details & counts
   */
  @PreAuthorize(
      "isAuthenticated() && (hasRole('ADVSHIP_SHIPPER') || hasRole('ADVSHIP_CUSTOMER_ADMIN'))")
  @PostMapping("/contact")
  public ResponseEntity<AllContactsResponseDTO> getShipToAddressesByFacilityId(
      @RequestParam(defaultValue = "0") int pageNo,
      @RequestParam(defaultValue = "100") int pageSize,
      @Valid @RequestBody AllContactRequest allContactRequest,
      @RequestHeader HttpHeaders httpHeaders,
      @AuthenticationPrincipal OflUserPrincipal oflUserPrincipal) {

    log.atInfo()
            .setMessage("Request to fetch addresses from the address book")
            .log();

    subscriptionAccessValidator.validatePremiumFeatureAccess(allContactRequest.getFacilityId());
    AllContactsResponseDTO results; // Result
    if (allContactRequest.isFavouriteAddressView()) {
      log.atInfo()
              .setMessage(
                  "Request to view Favourite addresses for facilityId with page number: "
                      + pageNo
                      + " and page size: "
                      + pageSize)
              .log();

      // Get all address associated with the provided facilityID which is marked favourite by the
      // logged-in user
      results =
          addressBookFavouriteService.fetchAllFavouriteAddressDetails(
              allContactRequest.getFacilityId(), oflUserPrincipal, pageNo, pageSize);
    } else {
      results =
          addressBookService.getAddressByFacilityId(
              allContactRequest.getFacilityId(),
              allContactRequest.getSortingColumn(),
              allContactRequest.getSortingDirection(),
              allContactRequest.getSearch(),
              pageNo,
              pageSize,
              oflUserPrincipal);
    }

    return ResponseEntity.ok(results);
  }

  /**
   * Updates an existing address in the address book.
   *
   * @param httpHeaders the HTTP headers containing additional metadata for the request
   * @param request the payload containing the updated address details
   * @return ResponseEntity<SuccessResponse> DTO with the status and message of the update operation
   */
  @PreAuthorize(
      "isAuthenticated() && (hasRole('ADVSHIP_SHIPPER') || hasRole('ADVSHIP_CUSTOMER_ADMIN'))")
  @PostMapping("/update")
  public ResponseEntity<SuccessResponse> updateAddress(
      @RequestHeader HttpHeaders httpHeaders, @Valid @RequestBody AddressBookRequest request) {
    // Logging Request body
    log.atInfo()
            .setMessage("Request to update existing address in the address book")
            .log();

    subscriptionAccessValidator.validatePremiumFeatureAccess(request.getFacilityId());

    // Calling service method to do update operation
    SuccessResponse updateResponse = addressBookService.updateAddressIfExists(request);

    log.atInfo()
            .setMessage(
                "Update address in the address book response is "
                    + updateResponse.getMessage()
                    + " and status code is "
                    + updateResponse.getStatus())
            .log();
    return ResponseEntity.ok(updateResponse);
  }

  /**
   * Deletes an existing address from the address book based on the provided address ID.
   *
   * @param httpHeaders the HTTP headers containing additional metadata for the request
   * @param addressId the identifier of the address to be deleted
   * @return ResponseEntity containing a SuccessResponse DTO with the status and message of the
   *     delete operation
   */
  @PreAuthorize(
      "isAuthenticated() && (hasRole('ADVSHIP_SHIPPER') || hasRole('ADVSHIP_CUSTOMER_ADMIN'))")
  @DeleteMapping("/delete/{addressId}")
  public ResponseEntity<SuccessResponse> deleteAddress(
      @RequestHeader HttpHeaders httpHeaders,
      @PathVariable("addressId") final String addressId,
