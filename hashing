            return ocmResponseMap;
        }

        var isCmsSameDay = false;
        var isCmsNextDay = false;
        var isCmsSameDayState = false;

        if (Objects.nonNull(ocmResponse.getLocation().getDhlConfiguration())
                && Objects.nonNull(ocmResponse.getLocation().getDhlConfiguration().getDhlAccess())) {
            ocmResponseMap.put(DHL, ocmResponse.getLocation().getDhlConfiguration().getDhlAccess());
        }

        if (Objects.nonNull(ocmResponse.getLocation().getUspsConfiguration())
                && Objects.nonNull(ocmResponse.getLocation().getUspsConfiguration().getUspsAccess())) {
            ocmResponseMap.put(USPS, ocmResponse.getLocation().getUspsConfiguration().getUspsAccess());
        }

        if (Objects.nonNull(ocmResponse.getLocation().getFedexConfiguration())
                && Objects.nonNull(ocmResponse.getLocation().getFedexConfiguration().getFedexAccess())) {
            ocmResponseMap.put(FEDEX, ocmResponse.getLocation().getFedexConfiguration().getFedexAccess());
        }

        if (Objects.nonNull(ocmResponse.getLocation().getCmsConfiguration())
                && Objects.nonNull(ocmResponse.getLocation().getCmsConfiguration().getCmsAccess())
                && Boolean.TRUE.equals(ocmResponse.getLocation().getCmsConfiguration().getCmsAccess())) {
                List<String> cmsServiceLevels = ocmResponse.getLocation().getCmsConfiguration().getCmsServiceLevels();
                isCmsSameDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAY));
                isCmsNextDay = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_NEXTDAY));
                isCmsSameDayState = cmsServiceLevels.stream().anyMatch(level -> level.equalsIgnoreCase(OCM_SHIPMENT_TYPE_SAMEDAYSTATE));
        }
        ocmResponseMap.put(FE_NEXT_DAY_KEY, isCmsNextDay);
        ocmResponseMap.put(FE_SAME_DAY_KEY, isCmsSameDay);
        ocmResponseMap.put(FE_ON_DEMAND_KEY, isCmsSameDayState);

        return ocmResponseMap;
    }

    public List<ShippingProfile> getDefaultShippingProfiles(Map<String, Boolean> ocmResponseMap, String facilityId) {
        //get Default profiles and carrier order from DB
        log.atInfo()
                .setMessage("fetch standard shipping profiles")
                .log();
        List<ShippingProfile> standardProfiles = shippingProfileRepository.getStandardShippingProfiles();
        List<ShippingProfile> currentDefaultProfiles = shippingProfileRepository.findAllDefaultShippingProfile(facilityId);

        List<ShippingProfile> defaultProfiles = updateStandardDefault(currentDefaultProfiles, standardProfiles);

        return defaultProfiles.stream()
                .filter(profile -> {
                    String carrier = profile.getCarrier();
                    return !(ocmResponseMap.containsKey(carrier) && Boolean.FALSE.equals(ocmResponseMap.get(carrier)));
                })
                .toList();
    }

    public static List<ShippingProfile> updateStandardDefault(List<ShippingProfile> defaultProfiles, List<ShippingProfile> standardProfiles) {

        Set<String> carriersAccountedFor = defaultProfiles.stream().map(ShippingProfile::getCarrier).collect(Collectors.toSet());

        standardProfiles.stream()
                .filter(p -> !carriersAccountedFor.contains(p.getCarrier()))
                .forEach(p ->
                    p.setDefaultShippingProfile(true)
                );

        return new ArrayList<>(standardProfiles);
    }
}

