    @Override
    public PlanPrices planPriceBreakDown(ShipmentBookRequest shipmentBookRequest, OflUserPrincipal oflUserPrincipal) {
        List<PlanPriceResult> prices ;
        try {
            prices = new ArrayList<>();
            if (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(ServiceCommonConstants.FEDEX)) {
                prices= fedexPrices(shipmentBookRequest ,prices);
            }
            else if (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(ServiceCommonConstants.USPS)) {
                prices= uspsPrices(shipmentBookRequest,oflUserPrincipal);
            }
            if(prices.isEmpty()){
               return PlanPrices.builder()
                        .planPriceResults(new ArrayList<>())
                        .errorMsg(PLAN_PRICES_ERROR)
                        .build();
            }
            return PlanPrices.builder()
                    .planPriceResults(prices)
                    .build();

        } catch (Exception e) {
            log.error(e.getMessage());
            return PlanPrices.builder()
                    .planPriceResults(new ArrayList<>())
                    .errorMsg(e.getMessage())
                    .build();
        }
    }

    public List<PlanPriceResult> uspsPrices(ShipmentBookRequest shipmentBookRequest, OflUserPrincipal oflUserPrincipal) {
        List<UserDefaultsResponse> userDefaultsResponses =
                userDefaultsService.getDefaultValues(oflUserPrincipal, shipmentBookRequest.getFacilityId());
        ShipmentRequestDTO shipmentRequestDTO =
                shipPlanDataMapperService.mapToSendFlexRequest(shipmentBookRequest, oflUserPrincipal, userDefaultsResponses.get(0).getData());

        List<ShipViaOptionRequestDTO> shipViaOptionRequestDTOList = shipmentBookRequest.getShipViaOptionList().stream()
                .map(shipViaOption -> ShipViaOptionRequestDTO.builder()
                        .code(shipViaOption.getCode())
                        .build())
                .toList();
        shipmentRequestDTO.setShipViaOptions(shipViaOptionRequestDTOList);

        Mono<ShipmentResponseDTO> shipmentResponseDTOMono =
                sendFlexWebClientService.sendFlexRequest(
                        ServiceCommonConstants.SHIPMENT_PLAN_SUB_URI,
                        HttpMethod.POST,
                        Map.of(),
                        shipmentRequestDTO,
                        ShipmentResponseDTO.class);

        ShipmentResponseDTO shipmentResponseDTO = shipmentResponseDTOMono.block();
        if(shipmentResponseDTO != null) {
       return mapToUspsPrices(shipmentResponseDTO);
        }
        return Collections.emptyList();

    }
    List<PlanPriceResult> mapToUspsPrices(ShipmentResponseDTO shipmentResponseDTO) {
        return shipmentResponseDTO.getShipViaOptions().stream()
                .map(shipViaOptionDTO -> PlanPriceResult.builder()
                        .shipViaCode(shipViaOptionDTO.getCode())
                        .serviceType(shipViaOptionDTO.getDescription())
                        .basePrice(shipViaOptionDTO.getRates().stream()
                                .filter(r -> PRICE_CUSTOMER.equalsIgnoreCase(r.getType()))
                                .findFirst()
                                .flatMap(r -> r.getCharges().stream()
                                        .filter(c -> PRICE_FREIGHT.equalsIgnoreCase(c.getType()))
                                        .findFirst()
                                        .map(ChargeDTO::getValue)).orElse(null))
                        .error(null)
                        .build()).toList();
    }




    public List<PlanPriceResult> fedexPrices(ShipmentBookRequest shipmentBookRequest, List<PlanPriceResult> prices) {
        List<ShipViaOption> shipViaOptionList = shipmentBookRequest.getShipViaOptionList();

        List<CompletableFuture<PlanPriceResult>> futures = shipViaOptionList.stream()
                .map(option -> getFedexPriceAsync(shipmentBookRequest, option))
                .toList();


        List<PlanPriceResult> results = futures.stream()
                .map(CompletableFuture::join)
                .filter(Objects::nonNull)
                .toList();

        prices.addAll(results);
        return prices;
    }

    public CompletableFuture<PlanPriceResult> getFedexPriceAsync(
            ShipmentBookRequest originalRequest,
            ShipViaOption shipViaOption) {

        String correlationId = MDC.get(CORRELATION_ID);
        return CompletableFuture.supplyAsync(() -> {
            ShipmentRequestModel shipReq=null;
            try {
                MDC.put(CORRELATION_ID, correlationId);
                // Create a new request with only the required data

                ObjectMapper mapper = new ObjectMapper();
                ShipmentBookRequest requestForOption = mapper.convertValue(originalRequest, ShipmentBookRequest.class);

                requestForOption.setShipViaOptions(Collections.singletonList(shipViaOption));

                shipReq = priceBreakDownService.maptoShipmentRequestModel(requestForOption, null);
                shipReq.setCarrierCodes(priceBreakDownService.getCarrierCodes(requestForOption));
                shipReq.getRequestedShipment().setServiceType(priceBreakDownService.getServiceType(requestForOption));

                RatesDto rates = rateQuoteWebClientService.getRateQuote(shipReq);

                log.atInfo().setMessage("Successfully returned Rates from rate quote").log();
                sendFlexRecordUtil.savePriceRecordDtoForSuccess(shipReq, rates);

                return mapToFedexPriceResult(shipReq, rates, shipViaOption.getCode());
            } catch (Exception e) {
                log.atError().setMessage("Error fetching FedEx price for option:").setCause(e).log();
                if (shipReq != null) {
                    sendFlexRecordUtil.savePriceRecordDtoForFailure(shipReq, e);
                }
                return null;
            }finally {
                MDC.remove(CORRELATION_ID);
            }
        });
    }
    PlanPriceResult mapToFedexPriceResult(ShipmentRequestModel shipReq,RatesDto rates,String shipViaOptionCode) {
        return  PlanPriceResult.builder()
                .shipViaCode(shipViaOptionCode)
                .serviceType(shipReq.getRequestedShipment().getServiceType().replaceAll(UNDERSCORE_DELIMITER,SPACE_DELIMITER))
                .basePrice(rates!= null
                                ? rates.getResult().getRateReplyDetails().get(0).getRatedShipmentDetails().get(0).getTotalBaseCharge()
                                : null)
                .error(rates== null
                        ?"rate not available for these service type."
                        :null)
                .build();
    }
