  private void setNavigator(
      @Valid ShipmentBookRequest shipmentBookRequest,
      PremiumFeatureResponse premiumFeatureResponse) {
    shipmentBookRequest.setNavigatorLevel(
        Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorNone())
            ? NONE
            : getNavigatorPlusValue(premiumFeatureResponse));
  }

  private String getNavigatorPlusValue(PremiumFeatureResponse premiumFeatureResponse) {
    return Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorPlus())
        ? NAVIGATOR_PLUS
        : NAVIGATOR;
  }

  private void setBeacon(
      @Valid ShipmentBookRequest shipmentBookRequest,
      PremiumFeatureResponse premiumFeatureResponse) {
    shipmentBookRequest.setBeaconLevel(
        Boolean.TRUE.equals(premiumFeatureResponse.getBeaconPlus()) ? BEACON_PLUS : BEACON);
  }

  private void validateRequiredFields(String field, String error) {
    if (Objects.isNull(field)) throw new ValidationException(error);
