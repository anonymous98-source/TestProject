      @Valid ShipmentBookRequest shipmentBookRequest,
      PremiumFeatureResponse premiumFeatureResponse) {
    shipmentBookRequest.setEpicWillowAmbulatoryIntegration(
        Boolean.TRUE.equals(premiumFeatureResponse.getNavigatorPlus()));
