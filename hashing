  // GenerateLabel START
  private ShipmentBookResponseDto generateLabel(
      ShipmentBookRequest shipmentBookRequest,
      OflUserPrincipal oflUserPrincipal,
      boolean isReturn,
      PremiumFeatureResponse premiumFeatureDetails,
      Map<String, Object> dependentData) {

    @SuppressWarnings("unchecked")
    Map<String, PackageProfileEntity> packageProfileEntityMap =
        (Map<String, PackageProfileEntity>) dependentData.get("PackageProfileEntityMap");
    @SuppressWarnings("unchecked")
    List<UserDefaultsResponse> userDefaultsResponses =
        (List<UserDefaultsResponse>) dependentData.get("UserDefaultsResponses");
    @SuppressWarnings("unchecked")
    Map<String, String> customerDetails =
        (Map<String, String>) dependentData.get("CustomerDetails");

    boolean isUserEnrolledInOSP = (boolean) dependentData.get("IsUserEnrolledInOSP");
    UserDto userDto = (UserDto) dependentData.get("UserDto");
    @SuppressWarnings("unchecked")
    Map<String, String> headers = (Map<String, String>) dependentData.get("Headers");

    QueueScheduleDto queueScheduleDto = null;

    ShipmentBookResponseDto shipmentBookResponseDto;

    ShipmentBookDto shipmentBookDto =
        AspToSendFlexDataMapperUtil.buildShipmentBookDto(
            shipmentBookRequest, packageProfileEntityMap, isUserEnrolledInOSP, isReturn);

    if (isReturn) {
      prepareReturnRequestDto(shipmentBookRequest, shipmentBookDto);
      shipmentBookResponseDto = callReturn(shipmentBookDto, shipmentBookRequest, headers);
      if (Objects.isNull(shipmentBookResponseDto)) {
        return null;
      }
      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
              shipmentBookDto,
              shipmentBookResponseDto,
              shipmentBookResponseDto.getId(),
              RETURN);
    } else {
      queueScheduleDto =
          shipmentBookRequest.getAdditionalAccessorial().isSaturdayPickup()
              ? checkPickup(shipmentBookRequest)
              : null;
      shipmentBookResponseDto = callBook(shipmentBookDto, headers);
    }

    // SaturdayPickupSchedule
    if (Objects.nonNull(queueScheduleDto)) {
      callQueueSchedule(Objects.requireNonNull(shipmentBookResponseDto), queueScheduleDto);
    }

    // get usps pricing details
    Map<String, Object> rateQuoteUspsInfo = new HashMap<>();
    if (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(USPS)) {
      rateQuoteUspsInfo = getUspsPricingDetails(shipmentBookRequest, shipmentBookResponseDto);
    }

    var additionalShipBookData =
        AdditionalShipBookData.builder()
            .saturdaySchedulePossible(Boolean.TRUE.equals(shipmentBookResponseDto.getSaturdayPickupScheduled()))
            .premiumFeatureResponse(premiumFeatureDetails)
            .build();
    try {
      NewShipmentResourceDto newShipmentResourceDto;
      // calling tracking resource to persist new shipment data
      if (!shipmentBookRequest.getShippingProfile().equalsIgnoreCase(FEDEX)) {
        newShipmentResourceDto =
            advShippingBookDataPersistService.persistShipmentBookDataToTrackingResource(
                shipmentBookResponseDto,
                shipmentBookRequest,
                userDto,
                customerDetails,
                rateQuoteUspsInfo,
                userDefaultsResponses,
                additionalShipBookData);
      } else {
        // saving shipment info, in case of FedEx price quote will be saved separately once
        // available
        newShipmentResourceDto =
            advShippingBookDataPersistService.persistShipmentBookDataToTrackingResource(
                shipmentBookResponseDto,
                shipmentBookRequest,
                userDto,
                customerDetails,
                null,
                userDefaultsResponses,
                additionalShipBookData);
          var correlationId = MDC.get(CORRELATION_ID);
          asyncPersistFedExPricing.asyncPersistFedexPricingDetails(
                  customerDetails,
                  newShipmentResourceDto,
                  shipmentBookRequest,
                  shipmentBookResponseDto,correlationId);
      }
      log.atInfo().setMessage("Shipment book details persisted into DB.").log();

      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
              shipmentBookDto,
              shipmentBookResponseDto,
              Objects.requireNonNull(shipmentBookResponseDto).getId(),
              BOOK);

      boolean publishStatus =
          publishData(
              newShipmentResourceDto, oflUserPrincipal, premiumFeatureDetails, shipmentBookRequest);

      Objects.requireNonNull(shipmentBookResponseDto).setPublishStatus(publishStatus);
      shipmentBookResponseDto.setEpicSkipped(
          !ShipmentTraversalUtils.publishToEpic(newShipmentResourceDto.getShipmentDto()));

    } catch (DataIntegrityViolationException dix) {
      throw new DatabaseException(
          "database error : "
              + "Data integrity violation exception raised while persisting shipment book details "
              + dix.getMessage()
              + Arrays.toString(dix.getStackTrace()));
    } catch (Exception ex) {
      throw new ShippingIntegrationException(
          "An unexpected error occurred while saving shipment book response "
              + ex.getMessage()
              + Arrays.toString(ex.getStackTrace()));
    }
    return shipmentBookResponseDto;
  }

  private void prepareReturnRequestDto(
      ShipmentBookRequest shipmentBookRequest, ShipmentBookDto shipmentBookDto) {
    DropOffOptions dropOffOptions =
        DropOffOptions.builder()
            .allowLateDropoff(false)
            .dropoffInstructions(REGULAR_PICKUP)
            .build();

    ReturnOptionsDto returnOptionsDto =
        ReturnOptionsDto.builder()
            .returnType(SHIPPER_PRINT_LABEL)
            .rma(shipmentBookRequest.getBillingInformation().getRma())
            .rmaReason(null)
            .associatedTrackingNumber(
                shipmentBookRequest.getGenerateLabelReturnType().equalsIgnoreCase(STANDALONE)
                    ? null
                    : shipmentBookRequest
                        .getBillingInformation()
                        .getOriginalShipmentTrackingNumber())
            .customsReturnReason(null)
            .count(null)
            .build();

    shipmentBookDto.setReturnOptions(returnOptionsDto);
    shipmentBookDto.setDropOffOptions(dropOffOptions);
  }

  private ShipmentBookResponseDto callReturn(
          ShipmentBookDto shipmentBookDto) {

    long startTime = ApiResponseTimeUtil.startTime();

    try {
      log.atInfo().setMessage("calling sendflex for return").log();
      Mono<ShipmentBookResponseDto> monoShipBookResponse =
              sendFlexWebClientService.sendFlexRequest(
                      SHIPMENT_RETURN_SUB_URI,
                      HttpMethod.POST,
                      Map.of(),
                      shipmentBookDto,
                      ShipmentBookResponseDto.class);

      ShipmentBookResponseDto response = monoShipBookResponse.block();

      long responseTime =
              ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
              shipmentBookDto,
              response,
              null,
              RETURN,
              responseTime);

      return response;

    } catch (Exception e) {
      long responseTime =
              ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
              shipmentBookDto,
              null,
              RETURN,
              e,
              responseTime);

      throw e;
    }
  }

  private QueueScheduleDto checkPickup(ShipmentBookRequest shipmentBookRequest) {
    OffsetDateTime pickupBefore =
        OffsetDateTime.parse(shipmentBookRequest.getAdditionalAccessorial().getAvailableUntil());
    OffsetDateTime pickupAfter =
        OffsetDateTime.parse(shipmentBookRequest.getAdditionalAccessorial().getReadyTime());

    if (!pickupBefore.toLocalDate().isBefore(LocalDate.now())
        && !pickupAfter.toLocalDate().isBefore(LocalDate.now())) {
      if (pickupAfter.isBefore(pickupBefore)) {
        return QueueScheduleDto.builder()
            .shipmentFilter(
                ShipmentFilter.builder()
                    .carrierServiceGroups(Collections.singletonList(null))
                    .build())
            .pickupBefore(shipmentBookRequest.getAdditionalAccessorial().getAvailableUntil())
            .pickupAfter(shipmentBookRequest.getAdditionalAccessorial().getReadyTime())
            .build();
      } else {
        throw new ValidationException("Ready Time must be before Available Until");
      }
    } else throw new ValidationException("Can't have past dates");
  }

  private ShipmentBookResponseDto callBook(
          ShipmentBookDto shipmentBookDto) {

    long startTime = ApiResponseTimeUtil.startTime();

    try {
      Mono<ShipmentBookResponseDto> monoShipBookResponse =
              sendFlexWebClientService.sendFlexRequest(
                      SHIPMENT_BOOK_SUB_URI,
                      HttpMethod.POST,
                      Map.of(),
                      shipmentBookDto,
                      ShipmentBookResponseDto.class);

      ShipmentBookResponseDto response = monoShipBookResponse.block();

      long responseTime =
              ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
              shipmentBookDto,
              response,
              response != null ? response.getTransactionIdentifier() : null,
              BOOK,
              responseTime);

      return response;

    } catch (Exception e) {
      long responseTime =
              ApiResponseTimeUtil.calculateResponseTimeInMillis(startTime);

      sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
              shipmentBookDto,
              null,
              BOOK,
              e,
              responseTime);

      throw e;
    }
  }

  private void callQueueSchedule(
      ShipmentBookResponseDto shipmentBookResponseDto, QueueScheduleDto queueScheduleDto) {
    shipmentBookResponseDto.setSaturdayPickupScheduled(false);
    try {
      queueScheduleDto.setShipmentIds(List.of(shipmentBookResponseDto.getId()));
      queueScheduleDto
          .getShipmentFilter()
          .setTrackingNumbers(
              shipmentBookResponseDto.getShippingUnits().stream()
                  .filter(Objects::nonNull)
                  .flatMap(shippingUnits -> shippingUnits.getTrackingNumber().stream())
                  .filter(Objects::nonNull)
                  .map(TrackingNumberDto::getValue)
                  .toList());
      QueueScheduleRespDto queueScheduleRespDto = satPickupScheduleResponse(queueScheduleDto);

      // save sendflex record to sendflex_log
      sendFlexRecordUtil.saveSendFlexRecordDtoForSuccess(
          queueScheduleDto,
          shipmentBookResponseDto,
          Objects.requireNonNull(shipmentBookResponseDto).getId(),
          QUEUE_SCHEDULE);

      if (!queueScheduleRespDto.getResult().getStatusCode().equals(VOID_FAIL)) {
        shipmentBookResponseDto.setSaturdayPickupScheduled(true);
      }
    } catch (Exception e) {
      log.atError()
              .addKeyValue("Error while scheduling saturday pickup : ", e.getMessage())
              .log();
    }
  }

  protected QueueScheduleRespDto satPickupScheduleResponse(QueueScheduleDto queueScheduleDto) {
    String shipmentTransactionId =
        Optional.ofNullable(queueScheduleDto.getShipmentIds())
            .flatMap(ids -> ids.stream().findFirst())
            .map(Object::toString)
            .orElse(null); // Getting first shipmentTransactionId for logging purpose

    if (queueScheduleDto.getShipmentFilter() != null
        && !CollectionUtils.isEmpty(queueScheduleDto.getShipmentFilter().getTrackingNumbers())) {
      // setting of shipment IDs is commented / removed against ASP-4717
      // we need to send only the tracking numbers not the shipment TXN IDs since sendflex API is
      // throwing validation
      queueScheduleDto.setShipmentIds(
          null); // Setting shipment IDs to null as per ASP-4717 since we are sending tracking
      // numbers
    }

    try {
      // calling sendflex queueSchedule api
      log.atInfo().setMessage("calling sendflex for saturday pickup").log();
      Mono<QueueScheduleRespDto> queueScheduleRespDtoMono =
          sendFlexWebClientService.sendFlexRequest(
              QUEUE_SCHEDULE_SUB_URI,
              HttpMethod.POST,
              Map.of(),
              queueScheduleDto,
              QueueScheduleRespDto.class);
      return queueScheduleRespDtoMono.block();
    } catch (Exception e) {
      // save failure record for saturday pickup to sendflex_log
      sendFlexRecordUtil.saveSendFlexRecordDtoForFailure(
          queueScheduleDto, shipmentTransactionId, QUEUE_SCHEDULE, e);
      throw new ValidationException("availableUntil must be greater than readyTime");
    }
  }

  public Map<String, Object> getUspsPricingDetails(
      ShipmentBookRequest shipmentBookRequest, ShipmentBookResponseDto shipmentBookResponseDto) {

    // Here I need to hit the two APIs with the required data and try to store it into the db.
    PriceResult priceResult = PriceResult.builder().errors(new ArrayList<>()).build();
    var rateQuoteSuccess = false;

    Map<String, Object> toSaveRateInfo = new HashMap<>();

    try {
      if (shipmentBookRequest.getShippingProfile().equalsIgnoreCase(USPS)) {
        UserConfigResponseDTO ocmResponseDTO =
            ocmWebClientService.getUserConfigDataFromOCM(
                shipmentBookRequest.getFacilityId(), shipmentBookRequest.getCustomerId());
        List<RateDto> rates = shipmentBookResponseDto.getShipViaOptions().get(0).getRates();
        List<ChargeDto> charges =
            rates.stream()
                .filter(rate -> rate.getType().equalsIgnoreCase(CUSTOMER))
                .map(RateDto::getCharges)
                .findFirst()
                .orElse(Collections.emptyList());

        Double baseCost =
            charges.stream()
                .filter(item -> item.getType().equalsIgnoreCase(PRICE_FREIGHT))
                .mapToDouble(ChargeDto::getValue)
                .findFirst()
                .orElse(0.0);

        Double accessorialCost =
            charges.stream()
                .filter(item -> item.getType().equalsIgnoreCase(PRICE_ACCESSORIAL))
                .mapToDouble(ChargeDto::getValue)
                .findFirst()
                .orElse(0.0);

        double total = baseCost + accessorialCost;
        if (ocmResponseDTO != null
            && ocmResponseDTO.getCustomer() != null
            && ocmResponseDTO
                .getCustomer()
                .getUspsPricingVisibility()
                .equalsIgnoreCase(SHOW_LINE_ITEM_PRICING)) {
          priceResult.setLineItem(
              charges.stream()
                  .map(
                      charge ->
                          LineItemDto.builder()
                              .description(charge.getDescription())
                              .value(charge.getValue())
                              .build())
                  .toList());
          priceResult.setTotal(total);
          priceResult.setBaseCost(baseCost);
          priceResult.setAccessorialCost(accessorialCost);
          rateQuoteSuccess = true;
        } else if (ocmResponseDTO != null
            && ocmResponseDTO.getCustomer() != null
            && ocmResponseDTO
                .getCustomer()
                .getUspsPricingVisibility()
                .equalsIgnoreCase(SHOW_TOTAL_PRICING_ONLY)) {
          priceResult.setLineItem(Collections.emptyList());
          priceResult.setTotal(total);
          priceResult.setBaseCost(null);
          priceResult.setAccessorialCost(null);
          rateQuoteSuccess = true;
        }

        toSaveRateInfo.put(REQUEST, shipmentBookRequest);
        toSaveRateInfo.put(RESPONSE, shipmentBookResponseDto);
        toSaveRateInfo.put(CODE, USPS);
        toSaveRateInfo.put(TOTAL_AMT, total);
        toSaveRateInfo.put(STATUS, SUCCESS_STATUS_CODE);
        toSaveRateInfo.put(BASE_COST, baseCost);
        toSaveRateInfo.put(ACCESSORIAL_COST, accessorialCost);
      }

    } catch (Exception e) {
      log.error(RATE_QUOTE_FAILED, e.getMessage());
      priceResult.getErrors().add(FAILED_RATE_QUOTE_PRICE);
    }

    if (rateQuoteSuccess) {
      shipmentBookResponseDto.setPriceBreakDown(priceResult);
    } else {
      shipmentBookResponseDto.setPriceBreakDown(null);
    }
    return toSaveRateInfo;
  }

