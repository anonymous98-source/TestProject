package com.cardinalhealth.adv.shipping.integration.api.utils;

import com.cardinalhealth.adv.shipping.integration.api.exception.ValidationException;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.AdditionalAccessorial;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.Notifications;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.ShipmentBookRequest;
import com.cardinalhealth.adv.shipping.integration.api.model.shipbook.SmsNotifications;
import lombok.extern.slf4j.Slf4j;

@Slf4j
public class NotificationGeneralizationUtils {

    private NotificationGeneralizationUtils() {
        throw new IllegalArgumentException("This is a utility class and cannot be instantiated");
    }

    /**
     * Validates the subscribed notification details in the given ShipmentBookRequest.
     *
     * @param shipmentBookRequest The ShipmentBookRequest containing notification details to be validated.
     * @throws ValidationException if there are duplicate email addresses or phone numbers in the notifications.
     */
    public static void validateSubscribedNotificationDetails(ShipmentBookRequest shipmentBookRequest) {
        boolean isDuplicateValidationRequired = isDuplicateValidationRequired(shipmentBookRequest);
        if (!isDuplicateValidationRequired) {
            return;
        }
        AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();

        // Validate duplicate email addresses in notifications
        if (additionalAccessorial.getNotification() != null && !additionalAccessorial.getNotification().isEmpty()) {
            long distinctEmailCount = additionalAccessorial.getNotification()
                    .stream().map(Notifications::getEmail)
                    .distinct().count();
            if (additionalAccessorial.getNotification().size() != distinctEmailCount) {
                throw new ValidationException("One or more email address is already subscribed to notifications");
            }
        }

        // Validate duplicate phone numbers in SMS notifications
        if (additionalAccessorial.getSmsNotification() != null && !additionalAccessorial.getSmsNotification().isEmpty()) {
            long distinctPhoneCount = additionalAccessorial.getSmsNotification()
                    .stream().map(SmsNotifications::getPhoneNumber)
                    .distinct().count();
            if (additionalAccessorial.getSmsNotification().size() != distinctPhoneCount) {
                throw new ValidationException("One or more phone number is already subscribed to notifications");
            }
        }
    }

    /**
     * Checks if validation is required for the given ShipmentBookRequest based on its AdditionalAccessorial details.
     *
     * @param shipmentBookRequest The ShipmentBookRequest to be checked.
     * @return true if validation is required; false otherwise.
     */
    private static boolean isDuplicateValidationRequired(ShipmentBookRequest shipmentBookRequest) {
        if (shipmentBookRequest == null || shipmentBookRequest.getAdditionalAccessorial() == null) {
            return false;
        }
        AdditionalAccessorial additionalAccessorial = shipmentBookRequest.getAdditionalAccessorial();

        // Validate if Email notification not subscribed but subscription details are provided
        if (!additionalAccessorial.isSubscribeToEmailUpdate() && additionalAccessorial.getNotification() != null
                && !additionalAccessorial.getNotification().isEmpty()) {
            throw new ValidationException("Cannot provide Email notifications when not subscribed to Email updates");
        }

        // Validate Email notification subscribed but no subscription details provided
        if (additionalAccessorial.isSubscribeToEmailUpdate()
                && (additionalAccessorial.getNotification() == null || additionalAccessorial.getNotification().isEmpty())) {
            throw new ValidationException("Email notifications must be provided when subscribed to Email updates");
        }

        // Validate if SMS notification not subscribed but subscription details are provided
        if (!additionalAccessorial.isSubscribeToSmsUpdate() && additionalAccessorial.getSmsNotification() != null
                && !additionalAccessorial.getSmsNotification().isEmpty()) {
            throw new ValidationException("Cannot provide SMS notifications when not subscribed to SMS updates");
        }

        // Validate SMS notification subscribed but no subscription details provided
        if (additionalAccessorial.isSubscribeToSmsUpdate()
                && (additionalAccessorial.getSmsNotification() == null || additionalAccessorial.getSmsNotification().isEmpty())) {
            throw new ValidationException("SMS notifications must be provided when subscribed to SMS updates");
        }

        // Return true if subscribed to either SMS or Email updates
        return additionalAccessorial.isSubscribeToSmsUpdate() || additionalAccessorial.isSubscribeToEmailUpdate();
    }
}

