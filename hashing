            .uri(userEdgeGetUsersUri(userName))
            .accept(MediaType.APPLICATION_JSON)
            .retrieve()
            .bodyToMono(OflUser.class)
            .onErrorResume(
                WebClientResponseException.class,
                e -> e.getRawStatusCode() == 404 ? Mono.empty() : Mono.error(e))
            .block());
  }

  public void deleteUser(UUID userId) {
    webClient.delete().uri(deleteEdgeUserUri(userId)).retrieve().toBodilessEntity().block();
  }

  @Nullable
  public UserWithPermissionsDTO postUser(UserWithPermissionsDTO userWithPermissionsDTO) {
    return webClient
        .post()
        .uri(userEdgePostUsersUri())
        .accept(MediaType.APPLICATION_JSON)
        .contentType(MediaType.APPLICATION_JSON)
        .bodyValue(userWithPermissionsDTO)
        .retrieve()
        .bodyToMono(UserWithPermissionsDTO.class)
        .block();
  }

  private URI userEdgePostUsersUri() {
    var factory = new DefaultUriBuilderFactory();
    return factory
        .uriString(advShippingIntegrationApiProperties.getUserEdgeBaseUrl())
