            : null;

    UserCustomerProfile userCustomerProfile =
        userDetailsService.getUserCustomerProfile(facilityId, user);

    Facility defaultFacility =
        userCustomerProfile.getFacilityList().stream()
            .filter(facility -> facility.getShipperNumber() != null)
            .findFirst()
            .orElseThrow(() -> new ResourceNotFoundException("User passed invalid facility id."));
    BillingGroup billingGroup =
        userCustomerProfile.getBillingGroups().get(defaultFacility.getBillingGroupId());
    Customer customer = userCustomerProfile.getCustomers().get(defaultFacility.getCustomerId());

    log.atInfo()
        .setMessage("Customer and default facility successfully fetched from customer service.")
        .log();

    List<CostCenter> costCenters = List.of();
    List<String> labelTypes = List.of();
    boolean isSortByDate = Boolean.FALSE;
    if (user != null) {
      CompletableFuture<List<CostCenter>> costCentresFuture =
          CompletableFuture.supplyAsync(
              () ->
                  customerService.getCostCenters(
                      CommonUtil.getUUIDFromString(defaultFacility.getId()), user.getEmail()),
              executor);

      CompletableFuture<UserData> userDataCompletableFuture =
          CompletableFuture.supplyAsync(() -> getUserData(user.getId()), executor);
      costCenters = costCentresFuture.join();
      UserData userData = userDataCompletableFuture.join();
      labelTypes = userData.labelTypes();
      isSortByDate = userData.isSortByDate();
    }

    // calling OCM service to fetch the user configuration data
    CompletableFuture<UserConfigResponseDTO> ocmResponseDtoFuture =
        CompletableFuture.supplyAsync(
            () ->
                ocmWebClientService.getUserConfigDataFromOCM(
                    defaultFacility.getId(), customer.getId()),
            executor);

    UserConfigResponseDTO ocmResponseDTO = ocmResponseDtoFuture.join();

    CompletableFuture<FacilityResidentialFlagSettingsResponse>
        facilityResidentialFlagSettingsFuture =
            CompletableFuture.supplyAsync(
                () ->
                    getFacilityResidentialFlagSettings(
                        CommonUtil.getUUIDFromString(defaultFacility.getId())),
                executor);
    FacilityResidentialFlagSettingsResponse facilityResidentialFlagSettings =
        facilityResidentialFlagSettingsFuture.join();
    executor.shutdown();

    // build request params for getUserDefaultsResponse method
    UserDefaultProcessRequest requestDto =
        UserDefaultProcessRequest.builder()
            .defaultFacility(defaultFacility)
            .billingGroup(billingGroup)
            .costCenters(costCenters)
            .customer(customer)
            .labelTypes(labelTypes)
            .firstTime(firstTime)
            .responseDTO(ocmResponseDTO)
            .facilityResidentialFlagSettings(facilityResidentialFlagSettings)
            .isSortByDate(isSortByDate)
            .userEmail(UserPrincipalUtils.getEmail(oflUserPrincipal))
            .build();

    // calling method get userDefaultsResponse
    UserDefaultsResponse response = getUserDefaultsResponse(requestDto);

    if (DefaultValuesContext.shouldIncludeRaws()) {
      Map<String, Object> raws = new HashMap<>();
      raws.put("Facility", defaultFacility);
      raws.put("BillingGroup", billingGroup);
      raws.put("CostCenters", costCenters);
      raws.put("Customer", customer);
      raws.put("LabelTypes", labelTypes);
      raws.put("FirstTime", firstTime);
      raws.put("UserConfigResponseDTO", ocmResponseDTO);
      if (user != null) {
        raws.put("OflUser", user);
      }
      raws.put("UserCustomerProfile", userCustomerProfile);
      response.setRaws(raws);
    }

    List<UserDefaultsResponse> responseList = List.of(response);

    if (oflUserPrincipal != null && oflUserPrincipal.getId() != null) {
      // save user if the user is not present in the db
      UserDto userToSave =
          getUserDto(
              oflUserPrincipal, response.getData().getShipmentAddress().getCustomerId().toString());
      Optional<User> userOptional =
          Optional.ofNullable(
              userDetailsService.findOrUpdateUser(
                  userToSave.getMonarchUserId(), userToSave.getUserEmail()));

      // Logic for UserEntity save / update is as below ->
      // 1. If user is present
      //  -> then check if the User's Default Facility ID is same as Facility ID sent in request
      //  -> if not same, then update the default facilityID value with the facilityID sent in
      // request
      //  -> if both facility ID found to be same do nothing
      // 2. If User is present but facilityID sent in request is null / blank then no update will
      // take place
      // 3. If user is not present then Save the current user and store the default facility ID
      if (userOptional.isPresent()) {
        User existingUser = userOptional.get();
        boolean isUpdateRequired =
            StringUtils.isNotBlank(facilityId)
                && existingUser.getDefaultFacilityId() != null
                && StringUtils.isNotBlank(existingUser.getDefaultFacilityId().toString())
                && !facilityId.equals(existingUser.getDefaultFacilityId().toString()); // Not equals

        if (isUpdateRequired) {
          existingUser.setDefaultFacilityId(UUID.fromString(facilityId));
          userRepository.save(existingUser);
          log.atInfo().setMessage("Updated default facility ID for existing user").log();
        }
      } else {
        User userEntity = userToSave.mapToEntity();
        userEntity.setDefaultFacilityId(CommonUtil.getUUIDFromString(defaultFacility.getId()));
        userRepository.save(userEntity);
        firstTime = Boolean.TRUE;
        responseList.get(0).getData().setFirstTime(firstTime);
        log.atInfo().setMessage("New user is saved in DB with default facility ID").log();
      }
    }

    return responseList;
  }

