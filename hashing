  public void addBillingInformation(
      ShipmentBookRequest shipmentBookRequest,
      NewShipmentDto.NewShipmentDtoBuilder shipmentBuilder) {

    if (Objects.nonNull(shipmentBookRequest.getBillingInformation())) {
      shipmentBuilder.shipmentCostCenter(
          shipmentBookRequest.getBillingInformation().getCostCenter());

      if (Objects.nonNull(shipmentBookRequest.getBillingInformation().getCostCenter())) {
        shipmentBuilder.costCenterName(
            extractCostCenterName(shipmentBookRequest.getBillingInformation().getCostCenter()));
        shipmentBuilder.costCenterNumber(
            extractCostCenterNumber(shipmentBookRequest.getBillingInformation().getCostCenter()));
      }

      shipmentBuilder.shipmentCarrierAccountNumber(
          shipmentBookRequest.getBillingInformation().getCarrierAccountNumber());

     if (shouldIncludeOptiFreightNumbers(shipmentBookRequest.getShippingProfile())) {
         shipmentBuilder.shipmentOptiFreightNumber(
                 shipmentBookRequest.getBillingInformation().getOptiFreightNumber());
         shipmentBuilder.shipmentNonOptiFreightNumber(
                 shipmentBookRequest.getBillingInformation().getNonOptiFreightNumber());
     }
      shipmentBuilder.rmaNumber(shipmentBookRequest.getBillingInformation().getRma());
    }
  }

  private boolean shouldIncludeOptiFreightNumbers(String profile){
    return !(profile.equalsIgnoreCase(DHL) || profile.equalsIgnoreCase(USPS));
  }

  public String extractCostCenterName(String costCenter) {
    return costCenter.split("\\(")[0].trim();
  }

  public String extractCostCenterNumber(String costCenter) {
    int endIndex = costCenter.indexOf(')');
    int startIndex = costCenter.indexOf('(');
    if (startIndex != -1 && endIndex != -1) {
      return costCenter.substring(startIndex + 1, endIndex).trim();
    } else {
      return costCenter;
    }
  }

