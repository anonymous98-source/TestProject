    public void saveEvaluationLogAsync(
            CompoundRuleEvaluationRequestDto request,
            CompoundRuleEvaluationResponseDto response,
            RuleDefinition ruleDefinition,
            String reason,
            String correlationId,
            RuleEvaluationTraceDto ruleEvaluationTraceDto,
            Long evaluationTimeTaken

    ) {

        log.atInfo().setMessage("Logging the rule evaluation ruleDefinition asynchronously for ruleType: " + request.getRuleType())
                .addKeyValue("Correlation-id: ", correlationId)
                .log();

        PreferredRuleType preferredRuleType = preferredRuleTypeRepository
                .findByFacilityId(request.getFacilityId());
        String preferredRuleTypeValue = Objects.nonNull(preferredRuleType)
                ? preferredRuleType.getPreferredRuleTypeValue()
                : DEFAULT_SHIPPING_RULE;
        String normalisedRuleType = PREFERRED_RULE_TYPE_MAPPING.getOrDefault(preferredRuleTypeValue, UNKNOWN_RULE);


        // extract the ruleDefinition as JSON from the ruleDefinition
        JsonNode ruleState = ruleDefinition != null
                ? mapper.valueToTree(ruleDefinition)
                : mapper.nullNode();

        saveEvaluationLog(request, response, ruleState, normalisedRuleType, reason,
                correlationId, ruleDefinition, ruleEvaluationTraceDto, evaluationTimeTaken);
    }

    private void saveEvaluationLog(
            CompoundRuleEvaluationRequestDto request,
            CompoundRuleEvaluationResponseDto response,
            JsonNode ruleState,
            String preferredRuleTypeValue,
            String message,
            String correlationId,
            RuleDefinition ruleDefinition,
            RuleEvaluationTraceDto ruleEvaluationTraceDto,
            Long evaluationTimeTaken
    ) {
        RuleEvaluationLog log = RuleEvaluationLog.builder()
                .correlationId(correlationId)
                .facilityId(request.getFacilityId())
                .ruleEvalRequest(mapper.valueToTree(request))
                .ruleEvalResponse(mapper.valueToTree(response))
                .requestedRuleType(request.getRuleType().toString())
                .preferredRuleType(preferredRuleTypeValue)
                .resolved(response != null && response.getRuleDetails() != null
                        && Boolean.TRUE.equals(response.getRuleDetails().getIsMatched()))
                .message(message)
                .selectedProfileId(response != null && response.getAssignedShippingProfile() != null
                        ? response.getAssignedShippingProfile().getShippingProfileId() : null)
                .selectedProfileName(response != null && response.getAssignedShippingProfile() != null
                        ? response.getAssignedShippingProfile().getShippingProfileName() : null)
                .qualifiedRuleState(ruleState)
                .evaluatedAt(OffsetDateTime.now())
                .conflict(false)
                .ruleEvaluationTrace(mapper.valueToTree(ruleEvaluationTraceDto))
                .selectedRulePriority(ruleDefinition != null ? ruleDefinition.getPriority() : null)
                .selectedRuleId(ruleDefinition != null ? ruleDefinition.getId().toString() : null)
                .ruleEvaluationTimeTaken(evaluationTimeTaken)
                .build();

        RuleEvaluationLog savedLog = ruleEvaluationLogRepository.save(log);
        if (response != null && savedLog.getId() != null) {
            response.setRuleLogId(savedLog.getId().toString());
        }

    }

}

