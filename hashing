    /**
     * This method fetches the premium feature details based on the facility ID and user principal.
     *
     * @param facilityId       The ID of the facility (nullable).
     * @param isShipment       Flag indicating if the request is related to shipment.
     * @param oflUserPrincipal The authenticated user's principal.
     * @return PremiumFeatureResponse containing the details of the premium features.
     */
    @Override
    public PremiumFeatureResponse getPremiumFeatureDetails(String facilityId, Boolean isShipment, OflUserPrincipal oflUserPrincipal) {
        validateData(facilityId, isShipment);
        log.atInfo().setMessage("fetching premium feature details started").log();

        OflUser user = null;
        if (oflUserPrincipal != null && oflUserPrincipal.getId() !=null) {
            user = !Boolean.TRUE.equals(isShipment) ?
                    Optional.ofNullable(userService.getUser(oflUserPrincipal.getUserName()))
                            .orElseThrow(() -> new ResourceNotFoundException("Could not find user data")) : null;
        }
        UserCustomerProfile userCustomerProfile = userDetailsService.getUserCustomerProfile(facilityId, user);
        List<Facility> facilities = userCustomerProfile.getFacilityList();
        if (facilities.isEmpty()) {
            throw new ResourceNotFoundException("Invalid facility ID or no facilities associated with the user");
        }

        BillingGroupListDto billingGroupListDto = BillingGroupListDto.builder()
                .billingGroupIds(extractBillingGroupIds(facilities))
                .facilityId(facilityId)
                .customerId(userCustomerProfile.getCustomers().keySet().stream().findFirst()
                        .orElse(null))
                .fetchDataStreamIntegration(true)
                .build();

        log.atInfo().setMessage("fetching premium feature details completed").log();
        return ocmWebClientService.fetchPremiumFeature(billingGroupListDto);
    }

    @SuppressWarnings("ConstantConditions")
    private List<String> extractBillingGroupIds(List<Facility> facilities) {
        Set<String> billingGroupIds = new HashSet<>();
        for (Facility facility : facilities) {
            if (facility.getBillingGroupId() != null) {
                billingGroupIds.add(facility.getBillingGroupId());
            }
        }
        if (billingGroupIds.isEmpty()) {
            throw new ResourceNotFoundException("No billing group found");
        }
        return new ArrayList<>(billingGroupIds);
    }

    /**
     * Validates the facility ID and shipment flag.
     *
     * @param facilityId The ID of the facility.
     * @param isShipment Flag indicating if the request is related to shipment.
     * @throws ResourceNotFoundException if validation fails.
     */
    private void validateData(String facilityId, Boolean isShipment) {
        if (Boolean.TRUE.equals(isShipment)) {
            if (facilityId == null || facilityId.isBlank()) {
                throw new ResourceNotFoundException("Facility ID is required for shipment related requests");
            } else {
                if (!isValidUUID(facilityId)) {
                    throw new ResourceNotFoundException("Invalid Facility ID format");
                }
            }
        } else {
            if (facilityId != null && !facilityId.isBlank()) {
                throw new ResourceNotFoundException("Facility ID should not be provided for non-shipment related requests");
            }
        }
    }

    /**
     * Validates if the provided string is a valid UUID format.
     *
     * @param uuid The string to validate.
     * @return true if the string is a valid UUID, false otherwise.
     */
    private boolean isValidUUID(String uuid) {
        try {
            UUID.fromString(uuid);
            return true;
        } catch (IllegalArgumentException e) {
            return false;
        }
    }

    /**
     * This method fetches the premium feature details based on the monarch user ID.
     *
     * @param monarchUserId The monarch user ID.
     * @return PremiumFeatureResponse containing the details of the premium features.
     */
    @Override
    public PremiumFeatureResponse getPremiumFeatureByMonarchUserId(UUID monarchUserId) {
        String userEmail = userRepository.findByMonarchUserId(monarchUserId)
                .map(User::getUserEmail)
                .orElseThrow(() -> new ResourceNotFoundException("User not found for monarchUserId: " + monarchUserId));
        OflUser user = Optional.ofNullable(userService.getUser(userEmail))
                            .orElseThrow(() -> new ResourceNotFoundException("Could not find user data")) ;
        UserCustomerProfile userCustomerProfile = userDetailsService.getUserCustomerProfile(null, user);
        List<Facility> facilities = userCustomerProfile.getFacilityList();
