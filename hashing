import static com.cardinalhealth.adv.shipping.integration.api.shippingrule.base.ShippingRuleConstants.WEIGHT_RULE_DESCRIPTION;


@Slf4j
@RequiredArgsConstructor
@Service
public class ShippingRuleWeightService implements ShippingRuleService<ShippingRuleWeightResponseDto> {


    private final RuleDefinitionRepository ruleDefinitionRepository;
    private final ServiceUtil serviceUtil;
    private final OperatorPriorityResolver operatorPriorityResolver;

    @Override
    @Transactional
    public ShippingRuleResponseDto saveOrUpdateShippingRules(
            ShippingRuleRequestDto shippingRuleRequestDto) {

        if (!(shippingRuleRequestDto instanceof ShippingRuleWeightRequestDto shippingRuleWeightRequestDto)) {
            throw new ValidationException("Invalid request dto for ShipViaRule");
        }

        ShippingRuleCommonUtils.validateRequestPayload(
                shippingRuleWeightRequestDto.getFacilityId(),
                shippingRuleWeightRequestDto.getCustomerId(),
                shippingRuleWeightRequestDto.getShippingProfileId());

        WeightRuleGenericResponseDto response = WeightRuleGenericResponseDto.builder()
                .status(SUCCESS)
                .build();

        RuleDefinition ruleDefinition;

        if (shippingRuleWeightRequestDto.getId() != null) {
            // Update by id
            log.atInfo().setMessage("Weight rule updating by ID: " + shippingRuleWeightRequestDto.getId()).log();
            ruleDefinition = ruleDefinitionRepository.findById(CommonUtil.getUUIDFromStringIfValid(shippingRuleWeightRequestDto.getId()))
                    .orElseThrow(() -> new ValidationException("Rule with given ID not found"));
            response.setMessage(UPDATED);
        } else {
            // update by value and operator if exists, otherwise create new
            ruleDefinition = ruleDefinitionRepository
                    .findWeightRule(shippingRuleWeightRequestDto.getFacilityId(),
                            RuleType.WEIGHT.toString(), String.valueOf(shippingRuleWeightRequestDto.getWeight()),
                            shippingRuleWeightRequestDto.getOperation(), Boolean.TRUE)
                    .orElse(null);

            if (ruleDefinition != null) {
                log.atInfo().setMessage("Weight rule updating by value and operator with ID: " + ruleDefinition.getId()).log();
                response.setMessage(UPDATED);
            } else {
                log.atInfo().setMessage("creating new WeightRule").log();
                response.setMessage(CREATED);
            }
        }

        // check if shipping profile id exists if it's provided in the request
        if (shippingRuleWeightRequestDto.getShippingProfileId() != null) {
            serviceUtil.isShippingProfileExists(
                    shippingRuleWeightRequestDto.getShippingProfileId(), shippingRuleWeightRequestDto.getFacilityId());
        }

        RuleDefinition entityToBeSaved = mapToEntity(shippingRuleWeightRequestDto, ruleDefinition);
        // save or update rule condition
        serviceUtil.saveWeightRuleCondition(shippingRuleWeightRequestDto, entityToBeSaved);

        RuleDefinition savedEntity = ruleDefinitionRepository.save(entityToBeSaved);
        if (savedEntity.getId() == null) {
            throw new InternalServerException(ERROR_OCCURRED_WHILE + " saving weight rule");
        }
        response.setId(savedEntity.getId());

        return response;
    }

    /**
     * Retrieves a paginated list of weight-based shipping rules for a given facility.
     *
     * @param facilityId the unique identifier of the facility (must not be null or blank)
     * @param customerId the unique identifier of the customer
     * @param search     optional search keyword to filter shipping rules
     * @param pageable   pagination and sorting information
     * @return a paginated result containing shipping rule DTOs
     * @throws ValidationException if the facilityId is null or blank
     */

    @Override
    public ShippingRuleResult<ShippingRuleWeightResponseDto> fetchShippingRules(String facilityId, String customerId, String search, Pageable pageable) {
        if (facilityId == null || facilityId.isBlank()) {
            throw new ValidationException(FACILITY_ID_MUST_NOT_BE_NULL_OR_EMPTY);
        }
        Page<WeightRuleProjection> responsePage;
        if (!StringUtils.isBlank(search)) {
            responsePage = ruleDefinitionRepository.searchWeightRule(
                    RuleType.WEIGHT.toString(),
                    facilityId,
                    search,
                    pageable
            );
            return new ShippingRuleResult<>(mapToDtoWithOperatorHierarchy(responsePage));
        }
        responsePage = ruleDefinitionRepository.findAllByFacilityIdAndRuleTypeAndActiveTrue(
                facilityId,
                RuleType.WEIGHT.toString(),
                pageable
        );

        return new ShippingRuleResult<>(mapToDtoWithOperatorHierarchy(responsePage));
    }

    /**
     * Deletes weight-based shipping rules based on the provided rule ID after validating the rule type and existence.
     *
     * @param ruleType The type of the shipping rule to be deleted. Must be "WEIGHT_RULE".
     * @param ruleId   The unique identifier of the weight rule to be deleted.
     * @return A DeleteShippingRuleResponseDto indicating the result of the deletion operation.
     * @throws ValidationException if the provided rule type is invalid or if the rule ID format is incorrect.
     */
    @Override
    @Transactional
    public WeightRuleGenericResponseDto deleteShippingRules(String ruleType, String ruleId) {
        if (!WEIGHT_RULE.equalsIgnoreCase(ruleType)) {
            throw new ValidationException(String.format("Provided rule type: %s is invalid for %s deletion for id: %s",
                    ruleType, ShippingRuleConstants.WEIGHT_RULE_DESCRIPTION, ruleId));
        }

        UUID weightRuleUUID = CommonUtil.getUUIDFromStringIfValid(ruleId); // Validate weight ruleId format
        boolean weightRuleExists = ruleDefinitionRepository.existsByRuleTypeAndId(RuleType.WEIGHT.toString(), weightRuleUUID); // Check existence

        if (!weightRuleExists) { // If weight rule does not exist, return NOT_FOUND response
            return WeightRuleGenericResponseDto.builder()
                    .status(FAILURE)
                    .message(WEIGHT_RULE_DESCRIPTION.concat(NOT_FOUND).concat(ruleId))
                    .build();
        }

        ruleDefinitionRepository.deleteById(weightRuleUUID);
        return WeightRuleGenericResponseDto.builder()
                .status(SUCCESS)
                .message(WEIGHT_RULE_DESCRIPTION.concat(RULE_DELETION_SUCCESSFUL))
                .build();
    }

    /**
     * Applies operator hierarchy to rules with the same weight value.
     * Hierarchy: <, <=, =, >=, >
     * Applies operator hierarchy to a page of weight-based rules.
     * <p>
     * Rules are first grouped by their weight value, and then, within each weight group,
     * they are ordered according to operator priority.
     * Hierarchy within a given weight value: {@code <}, {@code <=}, {@code =}, {@code >=}, {@code >}.
     */
    public Page<ShippingRuleWeightResponseDto> mapToDtoWithOperatorHierarchy(Page<WeightRuleProjection> projectionPage) {
        // Group rules by value (use Double as key if that's the type)
        Map<Double, List<WeightRuleProjection>> groupedByValue = new LinkedHashMap<>();
        projectionPage.forEach(projection ->
                groupedByValue.computeIfAbsent(projection.getValue(), k -> new ArrayList<>()).add(projection)
        );
        List<ShippingRuleWeightResponseDto> resultList = new ArrayList<>();
        for (var entry : groupedByValue.entrySet()) {
            List<RuleDefinition> ruleDefinitions = entry.getValue().stream()
                    .map(p -> {
                        RuleDefinition rd = new RuleDefinition();
                        rd.setOperator(p.getOperator());
                        rd.setValue(String.valueOf(p.getValue()));
                        rd.setId(p.getId());
                        rd.setShippingProfileId(p.getShippingProfileId());
                        return rd;
                    })
                    .toList();
            // Sort all rules in this group by operator hierarchy
            List<RuleDefinition> sortedByPriority = operatorPriorityResolver.sortByPriority(ruleDefinitions);
            for (RuleDefinition rule : sortedByPriority) {
                resultList.add(ShippingRuleWeightResponseDto.builder()
                        .id(rule.getId())
                        .value(Double.valueOf(rule.getValue()))
                        .operator(rule.getOperator())
                        .shippingProfileId(rule.getShippingProfileId())
                        .build());
            }
        }
        return new PageImpl<>(resultList, projectionPage.getPageable(), projectionPage.getTotalElements());
    }


    private RuleDefinition mapToEntity(ShippingRuleWeightRequestDto request, RuleDefinition existingRule) {

        RuleDefinition ruleDefinition = existingRule != null ? existingRule : new RuleDefinition();

        ruleDefinition.setFacilityId(request.getFacilityId());
        ruleDefinition.setCustomerId(request.getCustomerId());
        ruleDefinition.setRuleType(RuleType.WEIGHT.toString());
        ruleDefinition.setExpression(ShippingRuleCommonUtils.buildWeightExpression(
                request.getOperation(),
                request.getWeight()
        ));
        ruleDefinition.setRuleEvalMethod(RuleEvalMethod.EXPRESSION.getMethod());
        ruleDefinition.setValue(String.valueOf(request.getWeight()));
        ruleDefinition.setOperator(request.getOperation());
        ruleDefinition.setSource(ShippingRuleConstants.NAVIGATOR);
        ruleDefinition.setShippingProfileId(
                request.getShippingProfileId() != null
                        ? UUID.fromString(request.getShippingProfileId())
                        : null);

        ruleDefinition.setActive(Boolean.TRUE);
        return ruleDefinition;
    }
}

