public class UserDetailsService {

  private final UserRepository userRepository;
  private final CustomerService customerService;
  private final UserService userService;

  private final RedisRegionService redisRegionService;

  /**
   * Fetches the UserID based on UserPrincipal object -> Extract UserId from JWT token details
   *
   * @param oflUserPrincipal User Principal (JWT token details)
   * @return The logged-in userId, if user not found then throw ResourceNotFound exception
   */
  public UUID getUserIdFromUserPrincipal(OflUserPrincipal oflUserPrincipal) {
   log.atInfo()
            .setMessage(
                "Inside getUserIdFromUserPrincipal of UserDetailsExtractionService class"
                    + " to fetch User ID from OflUserPrincipal")
            .log();

    // Finding the logged-in UserDto (oktaId) from User Principal (JWT Token)
    UserDto user = buildUserDtoFromOflUserPrincipal(oflUserPrincipal);

    // Find User ID based on user's Okta User ID, if not found return empty UUID
    User foundUser = findOrUpdateUser(user.getMonarchUserId(), user.getUserEmail());
    return foundUser != null ? foundUser.getId() : UUID.fromString(EMPTY_UUID_STRING);
  }

  /**
   * Extract Okta UserID from JWT token and build the UserDto with logged-in user details
   *
   * @param oflUserPrincipal User Principal object from JWT Token
   * @return UserDto with logged-in user details
   */
  public UserDto buildUserDtoFromOflUserPrincipal(OflUserPrincipal oflUserPrincipal) {
    Object originalPrincipal = oflUserPrincipal.getOriginalPrincipal();

    // Check if originalPrincipal is an instance of DefaultOAuth2AuthenticatedPrincipal
    if (originalPrincipal instanceof DefaultOAuth2AuthenticatedPrincipal attributes) {
      String oktaId = attributes.getAttribute("uid");
      if (oktaId != null) {
        return UserDto.builder()
            .monarchUserId(oflUserPrincipal.getId())
            .userOktaUserId(oktaId)
            .userEmail(oflUserPrincipal.getEmail())
            .lastName(oflUserPrincipal.getLastName())
            .firstName(oflUserPrincipal.getFirstName())
            .build();
      } else {
        throw new ResourceNotFoundException("User is not authenticated");
      }
    } else {
      throw new ResourceNotFoundException("Original principal is not of the expected type");
    }
  }

  /**
   * Get User Customer Profile based on customer on user email Id
   *
   * @param userName user email id
   * @return UserCustomerProfile
   * @throws ResourceNotFoundException if email id not found
   */
  public UserCustomerProfile getUserCustomerProfile(String userName) {


    var cacheResult= redisRegionService.get(USER_CUSTOMER_PROFILE_REGION,userName, UserCustomerProfileCacheDto.class);

    if (cacheResult.isPresent()) {
    log.atInfo()
                      .setMessage("User customer profile found in cache for userName" + userName)
                      .log();
      return cacheResult.get().getUserCustomerProfile();
    }
    UserCustomerProfile userCustomerProfile;
    OflUser currentUser = getUser(userName);

    userCustomerProfile =
            Optional.ofNullable(customerService.getCustomer(getUserEntities(currentUser)))
                    .orElseThrow(() -> new ResourceNotFoundException("Could not find customer data for user"));
   log.atInfo()
                    .setMessage("Fetched customer profile, returning from getUserCustomerProfile method")
                    .log();

    redisRegionService.put(USER_CUSTOMER_PROFILE_REGION,userName,new UserCustomerProfileCacheDto(userName, userCustomerProfile));

    return userCustomerProfile;
  }


  /**
   * Get Okta user
   *
   * @param userName user email id
   * @return OflUser
   * @throws ResourceNotFoundException if email id not found
   */
  public OflUser getUser(String userName) {
    return Optional.ofNullable(userService.getUser(userName))
        .orElseThrow(() -> new ResourceNotFoundException("Could not find user data"));
  }

  /**
   * Get User entities based on provided okta user details
   *
   * @param user okta user
   * @return list of entity customer ,billing group ,facilities
   */
  public List<Entity> getUserEntities(OflUser user) {
    if (user==null ||user.getUserPermissionList() == null || user.getUserPermissionList().isEmpty()) {
      return emptyList();
    }
    return user.getUserPermissionList().stream()
        .filter(userPermission -> hasAdvshipRole(userPermission.getUserRole().getName()))
        .flatMap(userPermission -> userPermission.getEntityList().stream())
        .map(
            oflEntity ->
                Entity.builder()
                    .type(EntityType.fromName(oflEntity.getEntityType()))
                    .id(oflEntity.getEntityId())
                    .build())
        .toList();
  }

  /**
   * Updates the user default label type if the user has no shipments and no default label type set.
   *
   * @param userDto The UserDto object containing user details.
   * @param labelType The label type to be set as default.
   */
  public void updateUserDefaultLabelTypeAndSortByDate(UserDto userDto, String labelType, Boolean isSortByDate) {
    Optional<User> userOptional = userDto !=null ? Optional.ofNullable(findOrUpdateUser(userDto.getMonarchUserId(),userDto.getUserEmail())) : Optional.empty();
    // Logic to update default label type and sort by date for user for first time only
    if (userOptional.isPresent()) {
      User existingUser = userOptional.get();
      boolean updated = false;

      // Update sort by date if provided and changed
      if (isSortByDate != null && !Objects.equals(existingUser.getIsSortByDate(), isSortByDate)) {
        existingUser.setIsSortByDate(isSortByDate);
        updated = true;
       log.atInfo().setMessage("Updated sort by date preference for existing user").log();
      }

      // Update label type if not set and provided
      if (StringUtils.isNotBlank(labelType)
              && !StringUtils.equals(
              existingUser.getUserDefaultLabelType(),
              labelType)) {
        existingUser.setUserDefaultLabelType(labelType);
        updated = true;
       log.atInfo().setMessage("Updated default label type for existing user").log();
      }

      if (updated) {
        userRepository.save(existingUser);
      }
    }

  }

  /**
   * Checks if the provided role name is one of the ADVSHIP roles.
   *
   * @param roleName The name of the role to check.
   * @return true if the role name is one of the ADVSHIP roles, false otherwise.
   */
  public boolean hasAdvshipRole(String roleName) {
    if (StringUtils.isBlank(roleName)) return false;
