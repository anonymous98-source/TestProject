package com.cardinalhealth.adv.shipping.integration.api.redis.auth;

import com.google.auth.oauth2.AccessToken;
import com.google.auth.oauth2.GoogleCredentials;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneOffset;
import java.util.Date;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.atomic.AtomicInteger;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class GcpIamTokenProviderTest {
    private GoogleCredentials credentials;

    @BeforeEach
    void setup() {
        credentials = mock(GoogleCredentials.class);
    }

    // --------------------------------------------------
    // constructor + getToken success
    // --------------------------------------------------
    @Test
    void shouldInitializeAndReturnToken() throws Exception {
        AccessToken token =
                new AccessToken("token123",
                        Date.from(Instant.now().plusSeconds(3600)));

        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        doNothing().when(credentials).refresh();

        when(credentials.getAccessToken()).thenReturn(token);

        GcpIamTokenProvider provider =
                new GcpIamTokenProvider(credentials);

        String result = provider.getToken();

        assertEquals("token123", result);

        assertNotNull(provider.getTokenExpiry());
    }

    // --------------------------------------------------
    // username test
    // --------------------------------------------------
    @Test
    void shouldReturnDefaultUsername() throws Exception {
        AccessToken token =
                new AccessToken("abc",
                        Date.from(Instant.now().plusSeconds(3600)));

        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        when(credentials.getAccessToken()).thenReturn(token);

        GcpIamTokenProvider provider =
                new GcpIamTokenProvider(credentials);

        assertEquals("default", provider.getUsername());
    }

    // --------------------------------------------------
    // token refresh when expired
    // --------------------------------------------------
    @Test
    void shouldRefreshTokenWhenExpired() throws Exception {
        AccessToken firstToken =
                new AccessToken("old",
                        Date.from(Instant.now().minusSeconds(10)));

        AccessToken newToken =
                new AccessToken("new",
                        Date.from(Instant.now().plusSeconds(3600)));

        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        when(credentials.getAccessToken())
                .thenReturn(firstToken)
                .thenReturn(newToken);

        GcpIamTokenProvider provider =
                new GcpIamTokenProvider(credentials);

        String token = provider.getToken();

        assertEquals("new", token);

        verify(credentials, atLeast(2)).refresh();
    }

    // --------------------------------------------------
    // token NOT refreshed if still valid
    // --------------------------------------------------
    @Test
    void shouldNotRefreshIfTokenStillValid() throws Exception {
        AccessToken token =
                new AccessToken("valid",
                        Date.from(Instant.now().plusSeconds(3600)));

        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        when(credentials.getAccessToken()).thenReturn(token);

        GcpIamTokenProvider provider =
                new GcpIamTokenProvider(credentials);

        provider.getToken();
        provider.getToken();

        // refresh called only once (constructor)
        verify(credentials, times(1)).refresh();
    }

    // --------------------------------------------------
    // expiry fallback when expiration null
    // --------------------------------------------------
    @Test
    void shouldUseDefaultExpiryWhenMissing() throws Exception {
        AccessToken token =
                new AccessToken("fallback", null);

        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        when(credentials.getAccessToken()).thenReturn(token);

        GcpIamTokenProvider provider =
                new GcpIamTokenProvider(credentials);

        assertNotNull(provider.getTokenExpiry());

        assertTrue(provider.getTokenExpiry()
                .isAfter(Instant.now()));
    }

    // --------------------------------------------------
    // exception when access token null
    // --------------------------------------------------
    @Test
    void shouldThrowExceptionWhenAccessTokenNull() {
        when(credentials.createScoped(anyCollection()))
                .thenReturn(credentials);

        when(credentials.getAccessToken()).thenReturn(null);

        assertThrows(IOException.class,
                () -> new GcpIamTokenProvider(credentials));
    }

    // --------------------------------------------------
    // package-private constructor with Clock
    // --------------------------------------------------
    @Test
    void shouldUseCustomClock() throws Exception {
        AccessToken token = new AccessToken("clocktoken", Date.from(Instant.now().plusSeconds(3600)));
        when(credentials.createScoped(anyCollection())).thenReturn(credentials);
        when(credentials.getAccessToken()).thenReturn(token);
        Clock fixedClock = Clock.fixed(Instant.now(), ZoneOffset.UTC);
        GcpIamTokenProvider provider = new GcpIamTokenProvider(credentials, fixedClock);
        assertEquals("clocktoken", provider.getToken());
        assertNotNull(provider.getTokenExpiry());
    }

    // --------------------------------------------------
    // token refresh when within buffer
    // --------------------------------------------------
    @Test
    void shouldRefreshTokenWhenWithinBuffer() throws Exception {
        Instant now = Instant.now();
        // Token expires in 4 minutes (less than 5 min buffer)
        AccessToken soonExpiring = new AccessToken("soon", Date.from(now.plus(Duration.ofMinutes(4))));
        AccessToken refreshed = new AccessToken("refreshed", Date.from(now.plus(Duration.ofHours(1))));
        when(credentials.createScoped(anyCollection())).thenReturn(credentials);
        when(credentials.getAccessToken()).thenReturn(soonExpiring).thenReturn(refreshed);
        Clock fixedClock = Clock.fixed(now, ZoneOffset.UTC);
        GcpIamTokenProvider provider = new GcpIamTokenProvider(credentials, fixedClock);
        String token = provider.getToken();
        assertEquals("refreshed", token);
        verify(credentials, atLeast(2)).refresh();
    }

    // --------------------------------------------------
    // thread safety: concurrent getToken calls
    // --------------------------------------------------
    @Test
    void shouldBeThreadSafeForGetToken() throws Exception {
        AccessToken token = new AccessToken("threadsafe", Date.from(Instant.now().plusSeconds(3600)));
        when(credentials.createScoped(anyCollection())).thenReturn(credentials);
        doNothing().when(credentials).refresh();
        when(credentials.getAccessToken()).thenReturn(token);
        GcpIamTokenProvider provider = new GcpIamTokenProvider(credentials);
        int threads = 10;
        CountDownLatch latch = new CountDownLatch(threads);
        AtomicInteger successCount = new AtomicInteger();
        Runnable task = () -> {
            try {
                if (provider.getToken().equals("threadsafe")) {
                    successCount.incrementAndGet();
                }
            } catch (Exception ignored) {}
            latch.countDown();
        };
        for (int i = 0; i < threads; i++) {
            new Thread(task).start();
        }
        latch.await();
        assertEquals(threads, successCount.get());
    }
}

