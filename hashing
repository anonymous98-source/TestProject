            Pattern resolvedSearchTerm = Pattern.compile(Pattern.quote(trimmedSearch), Pattern.CASE_INSENSITIVE);

            // Find all UI labels that contain the search term
            List<String> uiLabeledKeys = ALL_UI_LABELED_KEYS.stream()
                    .filter(signatureKey -> resolvedSearchTerm.matcher(signatureKey).find())
                    .toList();

            // Extract all corresponding DB keywords for those UI labels
            List<String> dbDefinedKeys = uiLabeledKeys.stream()
                    .flatMap(uiKey -> UI_LABEL_TO_DB_KEYS.getOrDefault(uiKey, List.of()).stream())
                    .distinct()
                    .toList();
            // avoids SQL IN () empty list error
            List<String> dbKeysToSearch = dbDefinedKeys.isEmpty() ? List.of(NO_MATCH) : dbDefinedKeys;

            responsePage = ruleDefinitionRepository.searchShipmentValue(
                    RuleType.SHIPMENT_VALUE.toString(),
                    facilityId,
                    trimmedSearch,
                    dbKeysToSearch,
                    enabledCarriers,
                    pageable
            );
            return new ShippingRuleResult<>(mapToResponseDto(responsePage));
        }

        log.atInfo().setMessage("Fetching all shipment value rules").log();
        responsePage = ruleDefinitionRepository.findAllByRuleTypeAndFacilityIdAndActiveTrueAndCarrierInOrderByValueAsc(
                RuleType.SHIPMENT_VALUE.toString(),
                facilityId,
                enabledCarriers,
                ShipmentValueRuleProjection.class,
                pageable
        );
        return new ShippingRuleResult<>(mapToResponseDto(responsePage));
    }

    public List<String> getEnabledCarrierList(UserDefaultsData userDefaultsData) {
        List<String> enabledCarriers = new ArrayList<>();
        if (Boolean.TRUE.equals(userDefaultsData.getIsFedex())) {
            enabledCarriers.add(FEDEX);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsDhl())) {
            enabledCarriers.add(DHL);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsUsps())) {
            enabledCarriers.add(USPS);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsCmsSameDay())) {
            enabledCarriers.add(CMS_COURIER_SAME_DAY);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsCmsNextDay())) {
            enabledCarriers.add(CMS_COURIER_NEXT_DAY);
        }
        if (Boolean.TRUE.equals(userDefaultsData.getIsCmsSameDayState())) {
            enabledCarriers.add(CMS_COURIER_SAME_DAY_STATE);
        }
        return enabledCarriers;
    }

    /**
     * Deletes a shipment value shipping rule based on the provided rule ID after validating the rule type and existence.
     *
     * @param ruleType The type of the shipping rule to be deleted.
     * @param ruleId   The unique identifier of the shipping rule to be deleted.
     * @return A response DTO indicating the result of the deletion operation.
     * @throws ValidationException if the provided rule type is invalid or if the rule ID format is incorrect.
     */
    @Override
    @Transactional
    public ShipmentValueGenericResDto deleteShippingRules(String ruleType, String ruleId) {
        if (!SHIPMENT_VALUE_RULE.equalsIgnoreCase(ruleType)) {
            throw new ValidationException(String.format("Provided rule type: %s is invalid for %s deletion for id: %s",
                    ruleType, ShippingRuleConstants.SHIPMENT_VALUE_RULE_DESCRIPTION, ruleId));
        }

        UUID shipmentValueRuleUUID = CommonUtil.getUUIDFromStringIfValid(ruleId); // Validate shipment value ruleId format
        boolean ruleExists = ruleDefinitionRepository.existsByRuleTypeAndId(RuleType.SHIPMENT_VALUE.toString(), shipmentValueRuleUUID); // Check existence

        if (!ruleExists) { // If shipment value rule does not exist, return NOT_FOUND response
            return ShipmentValueGenericResDto.builder()
                    .status(FAILURE)
                    .message(SHIPMENT_VALUE_RULE_DESCRIPTION.concat(NOT_FOUND).concat(ruleId))
                    .build();
        }

        ruleDefinitionRepository.deleteById(shipmentValueRuleUUID);
        return ShipmentValueGenericResDto.builder()
                .status(SUCCESS)
                .message(SHIPMENT_VALUE_RULE_DESCRIPTION.concat(RULE_DELETION_SUCCESSFUL))
                .build();
    }

    /**
     * Private helper methods starts here
     */
    private void validateRequestDto(ShipmentValueRuleReqDto request) {
        // validate common fields
        ShippingRuleCommonUtils.validateRequestPayload(
                request.getFacilityId(),
                request.getCustomerId(),
                null
        );
        ShippingRuleCommonUtils.validateOperator(request.getOperation());
        ShippingRuleCommonUtils.validateCarrier(request.getCarrier());

        // validate specific fields to shipment value rule
        if (request.getValue() == null ||
                !request.getValue().matches(SHIPMENT_VALUE_REGEX) ||
                Long.parseLong(request.getValue()) <= ZERO) {
            throw new ValidationException("Enter a valid integer value greater than 0 up to 8 digits.");
        }

        // Validate accessorial and secondary config
        validateAccessorials(request);
    }

    private void validateAccessorials(ShipmentValueRuleReqDto request) {

        String carrier = request.getCarrier();
        JsonNode accessorial = request.getAccessorial();
        JsonNode valueNode = accessorial.elements().next();

        if (accessorial.size() != ONE || !valueNode.isBoolean() || !valueNode.asBoolean()) {
            throw new ValidationException("Accessorial must contain a single field with boolean value true.");
        }

        String selectedAccessorial = accessorial.fieldNames().next();

        Map<String, List<String>> allowedAccessorials = CARRIER_ACCESSORIALS.get(carrier);
        if (allowedAccessorials == null || !allowedAccessorials.containsKey(selectedAccessorial)) {
            throw new ValidationException("Invalid accessorial for carrier: " + carrier);
        }

        validateSecondaryConfig(request, allowedAccessorials.get(selectedAccessorial));
    }

    private void validateSecondaryConfig(ShipmentValueRuleReqDto request, List<String> allowedValues) {
        JsonNode secondaryConfig = request.getSecondaryConfig();
        if (secondaryConfig == null || secondaryConfig.isNull() || secondaryConfig.size() != ONE) {
            throw new ValidationException("Secondary configuration must contain a single field.");
        }
        String accessorialKey = request.getAccessorial().fieldNames().next();
        switch (accessorialKey) {
            case SIGNATURE_REQUIRED -> {
                checkFieldPresence(secondaryConfig, SIGNATURE);
                String signatureType = secondaryConfig.get(SIGNATURE).asText();
                if (!allowedValues.contains(signatureType)) {
                    throw new ValidationException("Invalid signature type for carrier.");
                }
                // If validation passes, replace the signature type with backend define keywords.
                replaceSignature(request);
            }
            case INTERVENTION_SERVICE -> {
                checkFieldPresence(secondaryConfig, INTERVENTION);
                String interventionType = secondaryConfig.get(INTERVENTION).asText();
                if (!allowedValues.contains(interventionType)) {
                    throw new ValidationException("Invalid intervention type for carrier.");
                }
            }
            case ADDITIONAL_LIABILITY, SHIPMENT_PROTECTION, ADDITIONAL_INSURANCE -> {
                String amountKey = ACCESSORIAL_TO_AMOUNT_KEY.get(accessorialKey);

                checkFieldPresence(secondaryConfig, amountKey);
                String amount = secondaryConfig.get(amountKey).asText();
                if (!amount.matches(AMOUNT_REGEX.get(amountKey))) {
                    String message = AMOUNT_ERROR_MESSAGE.getOrDefault(amountKey, "Invalid amount!");
                    throw new ValidationException(message);
                }
            }
            default -> throw new ValidationException("Unknown accessorial for secondary config validation.");
        }
    }

    private void checkFieldPresence(JsonNode secondaryConfig, String fieldName) {
        if (!secondaryConfig.has(fieldName)) {
            throw new ValidationException(fieldName + " is required for secondary configuration.");
        }
    }

    private void replaceSignature(ShipmentValueRuleReqDto request) {

        switch (request.getCarrier().toLowerCase()) {
            case FEDEX, CMS_COURIER_SAME_DAY, CMS_COURIER_NEXT_DAY, CMS_COURIER_SAME_DAY_STATE ->
                    ((ObjectNode) request.getSecondaryConfig()).put(SIGNATURE,
                            FEDEX_SIGNATURE_TYPE_MAP.get(request.getSecondaryConfig().get(SIGNATURE).asText()));

            case USPS -> ((ObjectNode) request.getSecondaryConfig()).put(SIGNATURE,
                    USPS_SIGNATURE_TYPE_MAP.get(request.getSecondaryConfig().get(SIGNATURE).asText()));

            case DHL -> ((ObjectNode) request.getSecondaryConfig()).put(SIGNATURE,
                    DHL_SIGNATURE_TYPE_MAP.get(request.getSecondaryConfig().get(SIGNATURE).asText()));

            default -> throw new ValidationException("Invalid carrier for signature type mapping.");
        }
    }

    private RuleDefinition mapToEntity(ShipmentValueRuleReqDto request, RuleDefinition existingRule) {
        RuleDefinition ruleDefinition = existingRule != null ? existingRule : new RuleDefinition();

        ruleDefinition.setFacilityId(request.getFacilityId());
        ruleDefinition.setCustomerId(request.getCustomerId());
        ruleDefinition.setCarrier(request.getCarrier());
        ruleDefinition.setRuleType(RuleType.SHIPMENT_VALUE.toString());
        ruleDefinition.setName(SHIPMENT_VALUE_RULE_DESCRIPTION);
        ruleDefinition.setExpression(ShippingRuleCommonUtils.buildValueExpression(
                request.getOperation(),
                Integer.valueOf(request.getValue())));
        ruleDefinition.setValue(request.getValue());
        ruleDefinition.setOperator(request.getOperation());
        ruleDefinition.setAction(ACTION); // TODO check the requirement, might be "APPLY_PROFILE", "UPDATE_ACCESSORIALS", "NO_ACTION)
        ruleDefinition.setRuleEvalMethod(RuleEvalMethod.EXPRESSION.getMethod());
        ruleDefinition.setAccessorial(request.getAccessorial());
        ruleDefinition.setSecondaryConfig(request.getSecondaryConfig());
        ruleDefinition.setSource(NAVIGATOR);
        ruleDefinition.setActive(Boolean.TRUE);
        return ruleDefinition;
    }

    public static Page<ShipmentValueRuleResponse> mapToResponseDto(Page<ShipmentValueRuleProjection> page) {
        ObjectMapper objectMapper = new ObjectMapper();
        List<ShipmentValueRuleResponse> responses =
                page.getContent().stream()
                        .map(
                                projection -> {
                                    JsonNode accessorial = null;
                                    JsonNode secondaryConfig = null;
                                    if (projection.getAccessorial() instanceof String acc) {
                                        try {
                                            accessorial = objectMapper.readTree(acc);
                                        } catch (JsonProcessingException e) {
                                            throw new InternalServerException(e);
                                        }
                                    } else {
                                        accessorial = (JsonNode) projection.getAccessorial();
                                    }
                                    if (projection.getSecondaryConfig() instanceof String sc) {
                                        try {
                                            secondaryConfig = objectMapper.readTree(sc);
                                        } catch (JsonProcessingException e) {
                                            throw new InternalServerException(e);
                                        }
                                    } else {
                                        secondaryConfig = (JsonNode) projection.getSecondaryConfig();
                                    }
                                    return ShipmentValueRuleResponse.builder()
                                            .id(projection.getId())
                                            .carrier(projection.getCarrier())
                                            .ruleType(projection.getRuleType())
                                            .expression(projection.getExpression())
                                            .value(projection.getValue())
                                            .operator(projection.getOperator())
                                            .action(projection.getAction())
                                            .accessorial(accessorial)
                                            .secondaryConfig(secondaryConfig)
                                            .isActive(projection.isActive())
                                            .build();
                                })
                        .collect(Collectors.toList());
        Pageable pageable = page.getPageable();
        return new PageImpl<>(responses, pageable, page.getTotalElements());
    }
