package com.cardinalhealth.adv.shipping.integration.api.customer.adapter;

import com.cardinalhealth.adv.shipping.integration.api.customer.dto.ActiveBillingGroupDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.CustomerEntityDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.CustomerHierarchyDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.FacilityDetailsDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.dto.request.CustomerHierarchyRequestDto;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.BillingGroup;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.Customer;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.Entity;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.EntityType;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.Facility;
import com.cardinalhealth.adv.shipping.integration.api.customer.model.UserCustomerProfile;
import com.cardinalhealth.adv.shipping.integration.api.utils.CommonUtil;

import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

import static com.cardinalhealth.adv.shipping.integration.api.customer.model.EntityType.BILLING_GROUP;
import static com.cardinalhealth.adv.shipping.integration.api.customer.model.EntityType.CUSTOMER;
import static com.cardinalhealth.adv.shipping.integration.api.customer.model.EntityType.FACILITY;

public class CustomerAdapter {

  private CustomerAdapter()
  {
    //no code
  }
  public static UserCustomerProfile mapCustomerHierarchyDtoToCustomerProfile(
      CustomerHierarchyDto dto) {
    return UserCustomerProfile.builder()
        .customers(
            dto.getCustomers().stream()
                .collect(Collectors.toMap(dto1 -> dto1.getId().toString(),
                        CustomerAdapter::mapCustomerFromCustomerEntityDto)))
        .billingGroups(
            dto.getBillingGroups().entrySet().stream()
                    .map(entry -> {
                      entry.getValue().setId(entry.getKey());
                      return CustomerAdapter.mapBillingGroupFromActiveBillingGroupDto(entry.getValue());
                    })
                    .collect(Collectors.toMap(BillingGroup::getId, billingGroup -> billingGroup)))
        .facilities(
                dto.getFacilities().entrySet().stream()
                    .map(entry -> {
                      entry.getValue().setId(entry.getKey());
                      return CustomerAdapter.mapFacilityFromFacilityDetailsDto(entry.getValue());
                    })
                    .collect(Collectors.toMap(Facility::getId, facility -> facility)))
        .build();
  }

  public static void setFacilityCustomerIds(UserCustomerProfile userCustomerProfile) {
    userCustomerProfile.getFacilityList().forEach(facility -> facility.setCustomerId(
            userCustomerProfile.getBillingGroups().get(facility.getBillingGroupId()).getCustomerId()));
  }

  public static CustomerHierarchyRequestDto mapEntitiesToCustomerHierarchyRequest(
      List<Entity> entities) {
    return CustomerHierarchyRequestDto.builder()
        .customers(getIdsByEntityType(entities, CUSTOMER))
        .billingGroups(getIdsByEntityType(entities, BILLING_GROUP))
        .facilities(getIdsByEntityType(entities, FACILITY))
        .build();
  }

  public static CustomerHierarchyRequestDto mapEntitiesToCustomerHierarchyRequest(
          UUID facilityId) {
    List<UUID> id =List.of(facilityId);
    return CustomerHierarchyRequestDto.builder()
            .customers(null)
            .billingGroups(null)
            .facilities( id)
            .build();
  }

  private static Customer mapCustomerFromCustomerEntityDto(CustomerEntityDto dto) {
    return Customer.builder().id(dto.getId().toString()).name(dto.getName()).build();
  }

  private static BillingGroup mapBillingGroupFromActiveBillingGroupDto(ActiveBillingGroupDto dto) {
    return BillingGroup.builder()
        .id(CommonUtil.getStringFromUUID(dto.getId()))
        .billToName(dto.getBillToName())
        .email(dto.getEmail())
        .customerId(CommonUtil.getStringFromUUID(dto.getCustomerId()))
        .primaryCarrierAccountNumber(dto.getPrimaryCarrierAccountNumber())
        .secondaryCarrierAccountNumber(dto.getSecondaryCarrierAccountNumbers())
        .sustainId(CommonUtil.getStringFromUUID(dto.getSustainId()))
        .build();
  }

  private static Facility mapFacilityFromFacilityDetailsDto(FacilityDetailsDto dto) {
    return Facility.builder()
        .id(CommonUtil.getStringFromUUID(dto.getId()))
        .facilityName(dto.getFacilityName())
        .address1(dto.getAddress1())
        .address2(dto.getAddress2())
        .address3("")
        .city(dto.getCity())
        .state(dto.getState())
        .country("United States")
        .zip(dto.getZip())
        .phone(dto.getPhone())
        .shipperNumber(dto.getShipperNumber())
        .billingGroupId(CommonUtil.getStringFromUUID(dto.getBillingGroupId()))
        .customerId(CommonUtil.getStringFromUUID(dto.getCustomerId()))
        .build();
  }

  private static List<UUID> getIdsByEntityType(List<Entity> entities, EntityType entityType) {
    return entities.stream()
        .filter(entity -> entityType.equals(entity.getType()))
        .map(Entity::getId)
        .toList();
  }
}

