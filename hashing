    public MultiPackageShipmentBookResponse mapToMultiPackageShipmentBookResponse(ShipmentBookRequest shipmentBookRequest, CmsBookResponse cmsBookResponse,boolean publishStatus,String shipmentId,String requestId, boolean epicSkipped) {
        try {
            List<ShipmentBookResponse> shipmentBookResponses = new ArrayList<>();
            String packageNickname =
                    shipmentBookRequest.getPackagingDetails() != null
                            ? shipmentBookRequest
                            .getPackagingDetails()
                            .get(0)
                            .getPackaging()
                            .getPackageNickname()
                            : null;
            ShipmentBookResponse shipmentBookResponse =
                    ShipmentBookResponse.builder()
                            .trackingNumber(String.valueOf(cmsBookResponse.getOrderTrackingID()))
                            .trackingKey(cmsBookResponse.getTrackingKey())
                            .labelType(cmsBookResponse.getLabelType())
                            .labelContent(cmsBookResponse.getLabelData())
                            .packageNickname(packageNickname)
                            .fileName(getFileName("." + shipmentBookRequest.getLabelType(), String.valueOf(cmsBookResponse.getOrderTrackingID())))
                            .build();
            shipmentBookResponses.add(shipmentBookResponse);

            MultiPackageShipmentBookResponse.MultiPackageShipmentBookResponseBuilder responseBuilder=MultiPackageShipmentBookResponse.builder()
                    .shipmentTransactionId(shipmentId)
                    .status(cmsBookResponse.getStatus())
                    .shipmentBookResponses(shipmentBookResponses)
                    .priceBreakDown(null)
                    .allLabelType(cmsBookResponse.getLabelType());

            MultiPackageShipmentBookResponse shipBookResponseMultiPackage ;
            if(shipmentBookRequest.getShippingProfile().equalsIgnoreCase(CMS_COURIER_SAME_DAY_STATE)){
                responseBuilder
                        .pickupStartTime(shipmentBookRequest.getPickupStartDate())
                        .pickupEndTime(shipmentBookRequest.getPickupEndDate())
                        .deliveredByTime(shipmentBookRequest.getDeliveryStartDate());
            }
            shipBookResponseMultiPackage=responseBuilder.build();


            if (!publishStatus) {
                shipBookResponseMultiPackage.setShipmentBookPubErrorMsg(PUB_ERR_MSG);
            }
            shipBookResponseMultiPackage.setEpicSkipped(epicSkipped);
            return shipBookResponseMultiPackage;
        }catch (Exception e){
            throw new ShippingIntegrationException("Error while mapping CmsBookResponse to MultiPackageShipmentBookResponse"
            + REQUEST_ID + requestId + e.getMessage() + Arrays.toString(e.getStackTrace()));
        }

    }

    /**
     * This method is used to get the file name for the label.
     *
     * @param extensionType The extension type of the file.
     * @param trackingNumber The tracking number of the shipment.
     * @return The file name as a string.
     */
    private String getFileName(String extensionType, String trackingNumber) {
        return trackingNumber
                + ServiceCommonConstants.FILE_NAME_MID_CONSTANT
                + LocalDate.now()
                + extensionType;
    }

