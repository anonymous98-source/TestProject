  @Override
  public ShippingProfileResponseDTO fetchShippingProfileById(UUID shippingProfileId, String facilityId) {

    log.atInfo()
            .setMessage("calling db to fetch the shipping profile data")
            .log();

    ShippingProfile shippingProfile = shippingProfileRepository.findById(shippingProfileId)
            .orElseThrow(() -> new ResourceNotFoundException("shipping profile not found"));

    // Separate package types and profiles in a single pass
    List<ShippingProfilePackageType> packageTypes = new ArrayList<>();
    List<ShippingProfilePackageType> packageProfiles = new ArrayList<>();

    for (ShippingProfilePackageType pt : shippingProfile.getShippingProfilePackageTypes()) {
      if (PACKAGE_TYPE.equalsIgnoreCase(pt.getEntityType())) {
        packageTypes.add(pt);
      } else if (PACKAGE_PROFILE.equalsIgnoreCase(pt.getEntityType())) {
        packageProfiles.add(pt);
      }
    }

    List<TagMapping> tagMappings =
            tagMappingRepository.findActiveTagMappingIdsByPackageIdAndEntityType(
                    shippingProfile.getId(), SHIPPING);

    List<ShippingProfileResponseDTO.TagDTO> tagList = tagMappings.stream()
            .map(tag -> ShippingProfileResponseDTO.TagDTO.builder()
                    .id(tag.getTag().getId())
                    .tagName(tag.getTag().getTagName())
                    .build())
            .toList();

    List<UUID> packageTypeIds = packageTypes.stream()
            .map(ShippingProfilePackageType::getEntityId)
            .toList();

    List<UUID> packageProfileIds = packageProfiles.stream()
            .map(ShippingProfilePackageType::getEntityId)
            .toList();

    Map<UUID, PackageType> packageTypeMap = packageTypeRepository.findAllById(packageTypeIds).stream()
            .collect(Collectors.toMap(PackageType::getId, Function.identity()));

    Map<UUID, PackageProfileEntity> packageProfileMap = packageProfileRepository.findAllById(packageProfileIds).stream()
            .collect(Collectors.toMap(PackageProfileEntity::getId, Function.identity()));

    List<PackageTypeDto> customPackages = packageTypes.stream()
            .map(type -> {
              PackageType pt = packageTypeMap.get(type.getEntityId());
              return toPackageTypeDto(pt);
            })
            .toList();

    List<PackageProfileDto> standardPackages = packageProfiles.stream()
            .map(profile -> {
              PackageProfileEntity pp = packageProfileMap.get(profile.getEntityId());
              return toPackageProfileDto(pp);
            })
            .toList();

    return mapToShippingProfileDto(shippingProfile, customPackages, standardPackages, tagList);
  }

