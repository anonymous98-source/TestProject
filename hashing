        List<RuleDefinition> sorted =
                ruleDefinitions.stream()
                        .sorted(Comparator.comparing(rule -> new BigDecimal(rule.getValue())))
                        .toList();
        BigDecimal winningValue = new BigDecimal(sorted.get(0).getValue());
        List<RuleDefinition> ties = sorted.stream()
                .filter(r -> new BigDecimal(r.getValue()).compareTo(winningValue) == 0)
                .toList();
        log.atInfo().addKeyValue("winningValue", String.valueOf(winningValue))
                .addKeyValue("tiesCount", ties.size())
                .setMessage("Shipment value conflict resolution details").log();

        if (ties.size() == 1) {
            return ties.get(0);
        }

        return operatorPriorityResolver.resolve(sorted);
    }
}

