     */
    private ShipToAddressFacilityMapping createShipToAddressFacilityMappingEntity(AddressBookRequest request) {
        log.atInfo()
                        .setMessage("Creating ship to address facility mapping entity")
                        .log();
        ShipToAddress shipToAddress = ShipToAddress.builder()
                .company(request.getCompany())
                .addressName(request.getRecipientName())
                .addressLine1(request.getAddresses().get(0))
                .addressLine2((request.getAddresses().size() > 1 && request.getAddresses().get(1) != null) ? request.getAddresses().get(1) : null)
                .addressLine3((request.getAddresses().size() > 2 && request.getAddresses().get(2) != null) ? request.getAddresses().get(2) : null)
                .zipCode(request.getZipCode())
                .city(request.getCity())
                .state(request.getState())
                .country(request.getCountry())
                .phoneNumber(request.getPhone())
                .email(request.getEmail())
                .deliveryNotes(request.getDeliveryNotes())
                .addressType(request.isResidential() ? AddressBookConstants.ADDRESS_TYPE_RESIDENTIAL : AddressBookConstants.ADDRESS_TYPE_REGULAR)
                .extension(request.getExtension())
                .isResidentialAddress(request.isResidential())
                .build();

        return ShipToAddressFacilityMapping.builder()
                .shipToAddress(shipToAddress)
                .monarchShipFromFacilityId(request.getFacilityId())
                .build();
    }

