import com.fasterxml.jackson.databind.JsonNode;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClientResponseException;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;

import static com.cardinalhealth.adv.shipping.integration.api.constants.ServiceCommonConstants.REQUEST_ID;


/**
 * Utility class to handle errors from WebClient responses.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class WebClientErrorHandler {

    private final SendFlexRecordUtil sendFlexRecordUtil;

    /**
     * Handles errors from WebClient responses and maps them to appropriate exceptions.
     *
     * @param throwable the throwable error from WebClient response
     * @param requestUrl the URL of the request that caused the error
     * @return an Exception representing the error
     */
    public Exception handleErrorMap(Throwable throwable, String requestUrl,String requestId,Object requestBody) {
        failureResponseStoreLogTable(throwable, requestUrl, requestBody);
        if (throwable instanceof WebClientResponseException ex) {
            log.atError()
                    .setCause(ex)
                    .setMessage("API request failed error for URL: " + requestUrl)
                    .log();
            List<String> errorMessages = extractErrorMessages(ex.getResponseBodyAsString(),requestId);
            return switch (ex.getStatusCode().value()) {
                case SendFlexErrorConstants.BAD_REQUEST ->
                        new ValidationException("Data is not valid: " + errorMessages);
                case SendFlexErrorConstants.UNAUTHORIZED ->
                        new UnAuthorizedException("Not authorized request" + errorMessages);
                case SendFlexErrorConstants.NOT_FOUND -> new ResourceNotFoundException(
                        "Resource is not found: " + errorMessages);
                default -> new RuntimeException(
                        "Unknown HTTP error occurred: "
                                + ex.getStatusCode()
                                + " - "
                                + errorMessages);
            };
        } else {
            return new RuntimeException("API request failed and it's not WebClientResponseException " +
                    REQUEST_ID + requestId + " Reason: Unexpected error occurred " +  throwable.getMessage() + Arrays.toString(throwable.getStackTrace()));
        }
    }

    public void failureResponseStoreLogTable(Throwable throwable, String requestUrl, Object requestBody) {
        if (requestUrl != null && requestUrl.contains("/v1/api/cms/shipment/generatelabel")
                && throwable instanceof WebClientResponseException) return;
        Exception ex;
        if (throwable instanceof Exception exception) {
            ex = exception;
        } else {
            ex = new Exception(throwable);
        }
        sendFlexRecordUtil.saveWebClientErrorHandlerForFailure(requestBody, requestUrl, ex);
    }

    /**
     * Recursively finds and collects error messages from a JSON node.
     *
     * @param root the root JSON node
     * @param errors the set to collect error messages
     */
    public void findErrors(JsonNode root, Set<String> errors) {
        if(root.isArray()) {
            root.elements().forEachRemaining(element ->
                findErrors(element, errors)
            );
        } else if(root.isObject()) {
            root.fieldNames().forEachRemaining(fieldName -> {
                JsonNode value = root.get(fieldName);
                if(fieldName.equals("contents") || fieldName.equals("errorMessage") || fieldName.equals("fieldErrors")) {
                    errors.add(value.toString());
                }
                findErrors(value, errors);
            });
        }
    }
    /**
     * Extracts error messages from the response body.
     *
     * @param responseBody the response body as a string
     * @return a list of error messages
     */
    public List<String> extractErrorMessages(String responseBody, String requestId) {
        LinkedHashSet<String> errorMessages = new LinkedHashSet<>();
        try {
            JsonNode root = ObjectMapperUtils.convertStringToJsonNode(responseBody);
            findErrors(root, errorMessages);
        } catch (Exception e) {
            log.atError()
                            .addKeyValue(REQUEST_ID, requestId)
                            .setCause(e)
                            .setMessage("Failed to parse error messages from response body")
                            .log();
        }
        return new ArrayList<>(errorMessages);
    }
}

