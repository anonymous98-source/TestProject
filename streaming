package com.cardinalhealth.advship.tracking.resource.controller;

import com.cardinalhealth.advship.tracking.resource.database.projection.gridapi.AtRiskTrackingProjection;
import com.cardinalhealth.advship.tracking.resource.database.repository.TrackingRepository;
import com.cardinalhealth.advship.tracking.resource.model.dto.TrackingDTO;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.web.PageableDefault;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;
import java.util.stream.Collectors;

@Slf4j
@RestController
@RequestMapping("/v1/api")
@PreAuthorize("isAuthenticated()")
public class AtRiskTrackingController {

    private final int atRiskScoreThreshold;
    private final int maxTrackingNumbersPerBatch;
    private final TrackingRepository trackingRepository;

    public AtRiskTrackingController(
            TrackingRepository trackingRepository,
            @Value("${at-risk.score-threshold:20}") int atRiskScoreThreshold,
            @Value("${at-risk.max-tracking-numbers-per-batch:500}") int maxTrackingNumbersPerBatch) {
        this.trackingRepository = trackingRepository;
        this.atRiskScoreThreshold = atRiskScoreThreshold;
        this.maxTrackingNumbersPerBatch = maxTrackingNumbersPerBatch;
    }

    @GetMapping("/tracking/at-risk")
    public ResponseEntity<Page<TrackingDTO>> getAtRiskShipments(@PageableDefault(size = 50) Pageable pageable) {
        Page<TrackingDTO> atRiskTrackingDTOs = trackingRepository
                .findByRiskScore(atRiskScoreThreshold, pageable)
                .map(this::toTrackingDTO);
        return ResponseEntity.ok(atRiskTrackingDTOs);
    }

    /**
     * Filters the given tracking numbers to return only those with risk_score = AT_RISK_SCORE_THRESHOLD.
     * Accepts a list of tracking numbers in the request body, returns matching at-risk tracking details.
     */
    @PostMapping("/tracking/at-risk/filter")
    public ResponseEntity<List<TrackingDTO>> filterAtRiskByTrackingNumbers(@RequestBody List<String> trackingNumbers) {
        if (trackingNumbers == null || trackingNumbers.isEmpty()) {
            log.info("Empty tracking numbers list received for at-risk filter");
            return ResponseEntity.ok(List.of());
        }

        // Dedupe
        List<String> uniqueTrackingNumbers = trackingNumbers.stream().distinct().collect(Collectors.toUnmodifiableList());
        log.info("Filtering {} tracking numbers ({} unique) for at-risk status",
                trackingNumbers.size(), uniqueTrackingNumbers.size());

        List<TrackingDTO> results = new java.util.ArrayList<>();
        for (int i = 0; i < uniqueTrackingNumbers.size(); i += maxTrackingNumbersPerBatch) {
            List<String> batch = uniqueTrackingNumbers.subList(i,
                    Math.min(i + maxTrackingNumbersPerBatch, uniqueTrackingNumbers.size()));
            trackingRepository.findByRiskScoreAndTrackingNumbers(atRiskScoreThreshold, batch)
                    .stream()
                    .map(this::toTrackingDTO)
                    .forEach(results::add);
        }

        log.info("Found {} at-risk shipments from {} tracking numbers", results.size(), trackingNumbers.size());
        return ResponseEntity.ok(results);
    }

    private TrackingDTO toTrackingDTO(AtRiskTrackingProjection p) {
        return TrackingDTO.builder()
                .id(p.getId())
                .trkTrackingNumber(p.getTrackingNumber())
                .carrier(p.getCarrier())
                .trkCarrierCode(p.getCarrierCode())
                .trkShipDate(p.getShipDate())
                .riskScore(String.valueOf(p.getRiskScore()))
                .trkExpectedDeliveryDate(p.getExpectedDeliveryDate())
                .delayReason(p.getDelayReason())
                .trkTrackingLastStatus(p.getTrackingLastStatus())
                .billingGroupId(p.getBillingGroupId())
                .facilityId(p.getFacilityId())
                .build();
    }
}

