package com.cardinalhealth.advship.tracking.resource.utils;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.JsonNode;
import org.junit.jupiter.api.Test;

import java.util.Arrays;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

class ObjectMapperUtilsTest {

    static class TestUser {
        public String name;
        public int age;

        public TestUser() {}

        public TestUser(String name, int age) {
            this.name = name;
            this.age = age;
        }
    }

    @Test
    void toJson_serializesObject() throws JsonProcessingException {
        TestUser user = new TestUser("Alice", 25);
        String json = ObjectMapperUtils.toJson(user);
        assertTrue(json.contains("\"name\":\"Alice\""));
        assertTrue(json.contains("\"age\":25"));
    }

    @Test
    void fromJson_deserializesObject() throws JsonProcessingException {
        String json = "{\"name\":\"Bob\",\"age\":44}";
        TestUser user = ObjectMapperUtils.fromJson(json, TestUser.class);
        assertEquals("Bob", user.name);
        assertEquals(44, user.age);
    }

    @Test
    void fromJsonToList_deserializesList() throws JsonProcessingException {
        List<TestUser> users = Arrays.asList(new TestUser("A", 1), new TestUser("B", 2));
        String listJson = ObjectMapperUtils.toJson(users);

        List<TestUser> deserialized = ObjectMapperUtils.fromJsonToList(listJson, new TypeReference<List<TestUser>>() {});
        assertEquals(2, deserialized.size());
        assertEquals("A", deserialized.get(0).name);
        assertEquals("B", deserialized.get(1).name);
    }

    @Test
    void convertStringToJsonNode_validJson_returnsJsonNode() throws JsonProcessingException {
        String json = "{\"foo\":\"bar\"}";
        JsonNode node = ObjectMapperUtils.convertStringToJsonNode(json);
        assertEquals("bar", node.get("foo").asText());
    }

    @Test
    void convertStringToJsonNode_invalidJson_throwsException() {
        String invalid = "{foo:bar"; // malformed
        assertThrows(JsonProcessingException.class, () -> ObjectMapperUtils.convertStringToJsonNode(invalid));
    }

// Java

    @Test
    void toPrettyJson_serializesObjectWithIndentation() throws JsonProcessingException {
        ObjectMapperUtilsTest.TestUser user = new ObjectMapperUtilsTest.TestUser("Charlie", 30);
        String prettyJson = ObjectMapperUtils.toPrettyJson(user);

        assertTrue(prettyJson.contains("\n")); // Should be multi-line
        assertTrue(prettyJson.contains("  \"name\"")); // Indented field
        assertTrue(prettyJson.contains("\"Charlie\""));
        assertTrue(prettyJson.contains("\"age\""));
        assertTrue(prettyJson.contains("30"));
    }


    @Test
    void testUtilityClassConstructor_private() throws Exception {
        var ctor = ObjectMapperUtils.class.getDeclaredConstructor();
        ctor.setAccessible(true);
        ObjectMapperUtils instance = ctor.newInstance();
        assertNotNull(instance);
    }
}

