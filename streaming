  private TrackingFedexDTO createCompleteFedexDto() {

    TrackingFedexDTO fedex =
        mock(TrackingFedexDTO.class);

    TrackResultDTO trackResult =
        mock(TrackResultDTO.class, RETURNS_DEEP_STUBS);

    TrackingInfoDTO trackingInfo =
        mock(TrackingInfoDTO.class, RETURNS_DEEP_STUBS);

    CurrentTrackingInfoDTO currentTrackingInfo =
        mock(CurrentTrackingInfoDTO.class);

    when(fedex.getTrackResult())
        .thenReturn(trackResult);

    when(trackResult.getTrackingInfo())
        .thenReturn(trackingInfo);

    when(trackingInfo.getCurrentTrackingInfo())
        .thenReturn(currentTrackingInfo);

    when(currentTrackingInfo.getTrackingNumber())
        .thenReturn("123456789");

    when(currentTrackingInfo.getTrackingNumberUniqueId())
        .thenReturn("UNIQUE-ID-123");

    when(
        trackResult
            .getBillToParties()
            .get(0)
            .getBillToParty()
            .getAccountNumber())
        .thenReturn("987654321");

    // Origin
    AddressDTO originAddress =
        mock(AddressDTO.class);

    when(originAddress.getCity())
        .thenReturn("Pune");

    when(originAddress.getPostalCode())
        .thenReturn("411001");

    when(originAddress.getStateOrProvinceCode())
        .thenReturn("MH");

