This is responsible for recursively scanning your microservice directories.

package com.dto.comparator.scanner;

import com.dto.comparator.model.DtoModel;
import com.dto.comparator.model.FieldModel;
import com.github.javaparser.JavaParser;
import com.github.javaparser.ParseResult;
import com.github.javaparser.ast.CompilationUnit;
import com.github.javaparser.ast.body.ClassOrInterfaceDeclaration;
import com.github.javaparser.ast.body.FieldDeclaration;
import com.github.javaparser.ast.body.VariableDeclarator;
import com.github.javaparser.ast.type.Type;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ForkJoinPool;
import java.util.stream.Collectors;
import java.util.stream.Stream;

public class JavaSourceScanner {

    private final JavaParser javaParser;

    public JavaSourceScanner() {
        this.javaParser = new JavaParser();
    }

    public List<DtoModel> scan(Path rootDirectory)
            throws IOException {

        try (Stream<Path> paths = Files.walk(rootDirectory)) {

            List<Path> javaFiles = paths
                    .filter(Files::isRegularFile)
                    .filter(path ->
                            path.toString()
                                    .endsWith(".java"))
                    .collect(Collectors.toList());

            /*
             * Parsing files is CPU intensive and each file
             * can be processed independently.
             */
            return javaFiles
                    .parallelStream()
                    .flatMap(path ->
                            parseFile(path).stream())
                    .filter(this::isDto)
                    .collect(Collectors.toList());
        }
    }

    private List<DtoModel> parseFile(Path file) {

        try {

            ParseResult<CompilationUnit> result =
                    javaParser.parse(file);

            if (result.getResult().isEmpty()) {

                System.err.println(
                        "Unable to parse: " + file
                );

                return List.of();
            }

            CompilationUnit unit =
                    result.getResult().get();

            String packageName =
                    unit.getPackageDeclaration()
                            .map(p ->
                                    p.getNameAsString())
                            .orElse("");

            List<DtoModel> resultList =
                    new ArrayList<>();

            for (ClassOrInterfaceDeclaration clazz :
                    unit.findAll(
                            ClassOrInterfaceDeclaration.class)) {

                List<FieldModel> fields =
                        extractFields(clazz);

                resultList.add(
                        new DtoModel(
                                clazz.getNameAsString(),
                                packageName,
                                file,
                                fields
                        )
                );
            }

            return resultList;

        } catch (Exception e) {

            System.err.println(
                    "Error parsing " +
                            file +
                            ": " +
                            e.getMessage()
            );

            return List.of();
        }
    }

    private List<FieldModel> extractFields(
            ClassOrInterfaceDeclaration clazz) {

        List<FieldModel> fields =
                new ArrayList<>();

        for (FieldDeclaration declaration :
                clazz.getFields()) {

            String type =
                    normalizeType(
                            declaration.getElementType()
                    );

            for (VariableDeclarator variable :
                    declaration.getVariables()) {

                fields.add(
                        new FieldModel(
                                variable.getNameAsString(),
                                type
                        )
                );
            }
        }

        return fields.stream()
                .sorted()
                .toList();
    }

    private String normalizeType(Type type) {

        return type.asString()
                .replaceAll("\\s+", "")
                .replace("java.lang.", "")
                .replace("java.util.", "");
    }

    /**
     * Configure DTO identification here.
     */
    private boolean isDto(DtoModel dto) {

        String name =
                dto.className().toLowerCase();

        return name.endsWith("dto")
                || name.endsWith("request")
                || name.endsWith("response")
                || name.endsWith("model");
    }
}

