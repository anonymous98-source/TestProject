import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.http.HttpStatus;
import org.springframework.web.reactive.function.client.WebClientResponseException;
import reactor.core.publisher.Mono;
import reactor.util.retry.Retry;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.atomic.AtomicInteger;

import static org.junit.jupiter.api.Assertions.*;

class RetryConfigTest {

    private RetryConfig retryConfig;

    @BeforeEach
    void setUp() {
        retryConfig = new RetryConfig();
    }

    /*
     * Tests for isRetryable()
     */

    @Test
    void shouldReturnTrueFor500StatusCode() {
        WebClientResponseException exception =
                createWebClientResponseException(
                        HttpStatus.INTERNAL_SERVER_ERROR.value(),
                        HttpStatus.INTERNAL_SERVER_ERROR.getReasonPhrase()
                );

        boolean result = retryConfig.isRetryable(exception);

        assertTrue(result);
    }

    @Test
    void shouldReturnTrueFor599StatusCode() {
        WebClientResponseException exception =
                createWebClientResponseException(
                        599,
                        "Server Error"
                );

        boolean result = retryConfig.isRetryable(exception);

        assertTrue(result);
    }

    @Test
    void shouldReturnFalseFor400StatusCode() {
        WebClientResponseException exception =
                createWebClientResponseException(
                        HttpStatus.BAD_REQUEST.value(),
                        HttpStatus.BAD_REQUEST.getReasonPhrase()
                );

        boolean result = retryConfig.isRetryable(exception);

        assertFalse(result);
    }

    @Test
    void shouldReturnFalseFor499StatusCode() {
        WebClientResponseException exception =
                createWebClientResponseException(
                        499,
                        "Client Error"
                );

        boolean result = retryConfig.isRetryable(exception);

        assertFalse(result);
    }

    @Test
    void shouldReturnFalseFor600StatusCode() {
        WebClientResponseException exception =
                createWebClientResponseException(
                        600,
                        "Unknown Status"
                );

        boolean result = retryConfig.isRetryable(exception);

        assertFalse(result);
    }

    @Test
    void shouldReturnTrueForRuntimeException() {
        RuntimeException exception =
                new RuntimeException("Unexpected runtime error");

        boolean result = retryConfig.isRetryable(exception);

        assertTrue(result);
    }

    @Test
    void shouldReturnTrueForCheckedException() {
        IOException exception =
                new IOException("Network connection error");

        boolean result = retryConfig.isRetryable(exception);

        assertTrue(result);
    }

    /*
     * Test basic Retry object creation
     */

    @Test
    void shouldCreateRetryConfiguration() {
        Retry retry = retryConfig.createRetry(2, 0);

        assertNotNull(retry);
    }

    /*
     * Non-retryable scenarios
     */

    @Test
    void shouldNotRetryFor400Error() {
        AtomicInteger executionCount = new AtomicInteger();

        WebClientResponseException exception =
                createWebClientResponseException(
                        HttpStatus.BAD_REQUEST.value(),
                        HttpStatus.BAD_REQUEST.getReasonPhrase()
                );

        WebClientResponseException actualException = assertThrows(
                WebClientResponseException.class,
                () -> Mono.defer(() -> {
                            executionCount.incrementAndGet();
                            return Mono.<String>error(exception);
                        })
                        .retryWhen(retryConfig.createRetry(2, 0))
                        .block()
        );

        assertSame(exception, actualException);

        // Initial execution only. No retry for 4xx.
        assertEquals(1, executionCount.get());
    }

    @Test
    void shouldNotRetryFor600StatusCode() {
        AtomicInteger executionCount = new AtomicInteger();

        WebClientResponseException exception =
                createWebClientResponseException(
                        600,
                        "Unknown Status"
                );

        WebClientResponseException actualException = assertThrows(
                WebClientResponseException.class,
                () -> Mono.defer(() -> {
                            executionCount.incrementAndGet();
                            return Mono.<String>error(exception);
                        })
                        .retryWhen(retryConfig.createRetry(2, 0))
                        .block()
        );

        assertSame(exception, actualException);
        assertEquals(1, executionCount.get());
    }

    /*
     * Successful retry scenarios
     */

    @Test
    void shouldRetryRuntimeExceptionAndThenSucceed() {
        AtomicInteger executionCount = new AtomicInteger();

        String result = Mono.defer(() -> {
                    int currentExecution = executionCount.incrementAndGet();

                    if (currentExecution == 1) {
                        return Mono.<String>error(
                                new RuntimeException("Temporary failure")
                        );
                    }

                    return Mono.just("Success");
                })
                .retryWhen(retryConfig.createRetry(1, 0))
                .block();

        assertEquals("Success", result);
        assertEquals(2, executionCount.get());
    }

    @Test
    void shouldRetry5xxExceptionAndThenSucceed() {
        AtomicInteger executionCount = new AtomicInteger();

        WebClientResponseException exception =
                createWebClientResponseException(
                        HttpStatus.SERVICE_UNAVAILABLE.value(),
                        HttpStatus.SERVICE_UNAVAILABLE.getReasonPhrase()
                );

        String result = Mono.defer(() -> {
                    int currentExecution = executionCount.incrementAndGet();

                    if (currentExecution == 1) {
                        return Mono.<String>error(exception);
                    }

                    return Mono.just("Success");
                })
                .retryWhen(retryConfig.createRetry(1, 0))
                .block();

        assertEquals("Success", result);
        assertEquals(2, executionCount.get());
    }

    /*
     * Retry-exhaustion scenarios
     */

    @Test
    void shouldRetry5xxExceptionAndThrowSameExceptionWhenExhausted() {
        AtomicInteger executionCount = new AtomicInteger();

        WebClientResponseException exception =
                createWebClientResponseException(
                        HttpStatus.INTERNAL_SERVER_ERROR.value(),
                        HttpStatus.INTERNAL_SERVER_ERROR.getReasonPhrase()
                );

        WebClientResponseException actualException = assertThrows(
                WebClientResponseException.class,
                () -> Mono.defer(() -> {
                            executionCount.incrementAndGet();
                            return Mono.<String>error(exception);
                        })
                        .retryWhen(retryConfig.createRetry(1, 0))
                        .block()
        );

        /*
         * WebClientResponseException extends RuntimeException.
         * RetryConfig therefore returns the original exception.
         */
        assertSame(exception, actualException);

        // One initial execution and one retry.
        assertEquals(2, executionCount.get());
    }

    @Test
    void shouldRetryRuntimeExceptionAndThrowSameExceptionWhenExhausted() {
        AtomicInteger executionCount = new AtomicInteger();

        RuntimeException exception =
                new RuntimeException("Temporary runtime failure");

        RuntimeException actualException = assertThrows(
                RuntimeException.class,
                () -> Mono.defer(() -> {
                            executionCount.incrementAndGet();
                            return Mono.<String>error(exception);
                        })
                        .retryWhen(retryConfig.createRetry(1, 0))
                        .block()
        );

        /*
         * Covers:
         * if (lastError instanceof RuntimeException)
         */
        assertSame(exception, actualException);
        assertEquals(2, executionCount.get());
    }

    @Test
    void shouldWrapCheckedExceptionWhenRetriesAreExhausted() {
        AtomicInteger executionCount = new AtomicInteger();

        IOException exception =
                new IOException("Temporary connection failure");

        RuntimeException actualException = assertThrows(
                RuntimeException.class,
                () -> Mono.defer(() -> {
                            executionCount.incrementAndGet();
                            return Mono.<String>error(exception);
                        })
                        .retryWhen(retryConfig.createRetry(1, 0))
                        .block()
        );

        /*
         * Covers the false branch of:
         * if (lastError instanceof RuntimeException)
         */
        assertEquals(
                "Retries exhausted for the request",
                actualException.getMessage()
        );
        assertSame(exception, actualException.getCause());
        assertEquals(2, executionCount.get());
    }

    /*
     * Helper method
     */

    private WebClientResponseException createWebClientResponseException(
            int statusCode,
            String statusText
    ) {
        return WebClientResponseException.create(
                statusCode,
                statusText,
                null,
                new byte[0],
                StandardCharsets.UTF_8
        );
    }
}

