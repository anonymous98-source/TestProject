                        .addKeyValue("shipmentID", createdShipmentEntity.getId().toString())
                        .addKeyValue("shipmentTransactionId", createdShipmentEntity.getShipmentTransactionId())
                        .log();
            }
            if (newShipmentDto.getGenerateLabelReturnType() != null
                    && newShipmentDto.getOriginalShipmentTrackingNumber() != null && ServiceCommonConstants.FORWARD.equalsIgnoreCase(newShipmentDto.getGenerateLabelReturnType())
