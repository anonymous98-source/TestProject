import org.jetbrains.annotations.NotNull;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.DefaultUriBuilderFactory;
import reactor.core.publisher.Mono;

import java.net.URI;
import java.nio.charset.StandardCharsets;
import java.util.Base64;
import java.util.function.Consumer;

import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.BASIC;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.BEARER;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.GO_ANYWHERE_HEADER;

/**
 * Component for interacting with the GoAnywhere API to manage configurations. Provides methods to
 * retrieve and save configurations using HTTP requests.
 */
@Component
public class GoAnywhereWebClient {
  private final WebClient webClient; // WebClient instance for making HTTP requests
  private final AdvshipTrackingResourceProperties
      advshipTrackingResourceProperties; // Configuration properties for GoAnywhere
  private final DefaultUriBuilderFactory
      defaultUriBuilderFactory; // URI builder factory for constructing API URIs
  private final SftpTokenGenerationService sftpTokenGenerationService;

  /**
   * Constructs a GoAnywhereWebClient with the specified WebClient and configuration properties.
   *
   * @param webClient the WebClient instance to use for HTTP requests
   * @param advshipTrackingResourceProperties the configuration properties for GoAnywhere
   */
  public GoAnywhereWebClient(
      @Qualifier("goAnywhereSslWebClient") WebClient webClient,
      AdvshipTrackingResourceProperties advshipTrackingResourceProperties,
      SftpTokenGenerationService sftpTokenGenerationService) {
    this.webClient = webClient;
    this.advshipTrackingResourceProperties = advshipTrackingResourceProperties;
    this.defaultUriBuilderFactory = new DefaultUriBuilderFactory();
    this.sftpTokenGenerationService = sftpTokenGenerationService;
  }

  /**
   * Retrieves the GoAnywhere configurations as a Mono of String.
   *
   * @return a Mono containing the configurations as a String
   */
  public Mono<String> getConfigurations() {
    return webClient
        .post()
        .uri(getGoAConfigurationUri())
        .headers(addHttpBasicAuthHeaders())
        .contentType(MediaType.APPLICATION_JSON)
        .accept(MediaType.APPLICATION_XML)
        .bodyValue(getExportRequest())
        .retrieve()
        .bodyToMono(String.class);
  }

  /**
   * Saves the provided GoAnywhere configurations.
   *
   * @param configurationXml the configuration XML to save
   * @return a Mono containing the response entity
   */
  public Mono<ResponseEntity<Void>> saveConfigurations(String configurationXml) {
    return webClient
        .post()
        .uri(getGoAConfigurationUri())
        .headers(addHttpBasicAuthHeaders())
        .contentType(MediaType.APPLICATION_JSON)
        .bodyValue(getImportRequest(configurationXml))
        .retrieve()
        .toBodilessEntity();
  }

  /**
   * Adds HTTP Basic Authentication headers to the request.
   *
   * @return a Consumer that sets the Basic Auth headers
   */
  @NotNull
  private Consumer<HttpHeaders> addHttpBasicAuthHeaders() {
    return httpHeaders -> {
      httpHeaders.set(GO_ANYWHERE_HEADER,
              BASIC + Base64.getEncoder().encodeToString((advshipTrackingResourceProperties.getGoAnywhereUserName() +
                      ":" + advshipTrackingResourceProperties.getGoAnywherePassword()).getBytes(StandardCharsets.UTF_8)));
      httpHeaders.set(HttpHeaders.AUTHORIZATION, BEARER + sftpTokenGenerationService.getAccessToken());
    };
  }

  /**
   * Creates an ExportRequest object for retrieving configurations.
   *
   * @return the ExportRequest object
   */
  @NotNull
  private ExportRequest getExportRequest() {
    return ExportRequest.builder()
        .exportParameters(
            ExportParameters.builder()
                .domain(advshipTrackingResourceProperties.getGoAnywhereDomain())
                .project(
                    advshipTrackingResourceProperties.getGoAnywhereFolder()
                        + "/"
                        + advshipTrackingResourceProperties.getGoAnywhereProject())
                .build())
        .build();
  }

  /**
   * Creates an ImportRequest object for saving configurations.
   *
   * @param configurationXml the configuration XML to save
   * @return the ImportRequest object
   */
  @NotNull
  private ImportRequest getImportRequest(String configurationXml) {
    return ImportRequest.builder()
        .importParameters(
            ImportParameters.builder()
                .domain(advshipTrackingResourceProperties.getGoAnywhereDomain())
                .file(
                    Base64.getEncoder()
                        .encodeToString(configurationXml.getBytes(StandardCharsets.UTF_8)))
                .targetFolder(advshipTrackingResourceProperties.getGoAnywhereFolder())
                .build())
        .build();
  }

  /**
   * Constructs the URI for the GoAnywhere configuration API.
   *
   * @return the constructed URI
   */
  private URI getGoAConfigurationUri() {
    return defaultUriBuilderFactory
        .uriString(advshipTrackingResourceProperties.getGoAnywhereApiBaseUrl())
        .path("pace/mft/v1/projects")
        .build();
  }
}

