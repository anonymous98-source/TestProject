package com.cardinalhealth.advship.tracking.resource.service.impl;

import com.cardinalhealth.advship.tracking.resource.service.base.GcsService;
import com.google.cloud.WriteChannel;
import com.google.cloud.storage.BlobInfo;
import com.google.cloud.storage.Storage;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.stereotype.Service;
import org.springframework.web.servlet.mvc.method.annotation.StreamingResponseBody;

import java.io.IOException;
import java.io.OutputStream;
import java.nio.ByteBuffer;

@Service
@Slf4j
public class GcsServiceImpl implements GcsService {

    private final Storage bucketStorage;

    public GcsServiceImpl(@Qualifier("BucketStorage") Storage bucketStorage) {
        this.bucketStorage = bucketStorage;
    }

    @Override
    public void publish(String bucketName, String filePath, StreamingResponseBody responseBody) {
        var blobInfo = BlobInfo.newBuilder(bucketName, filePath).build();
        try (WriteChannel writer = bucketStorage.writer(blobInfo)) {
            OutputStream gcsOutputStream = new OutputStream() {
                @Override
                public void write(int b) throws IOException {
                    write(new byte[]{(byte) b}, 0, 1);
                }

                @Override
                public void write(byte[] b, int off, int len) throws IOException {
                    writer.write(ByteBuffer.wrap(b, off, len));
                }
            };
            responseBody.writeTo(gcsOutputStream);
            gcsOutputStream.close();
        } catch (Exception e) {
            log.error("Error uploading StreamingResponseBody to GCS bucket: {} at path: {}", bucketName, filePath, e);
        }
        log.info("Successfully published to GCS bucket: {} and filepath: {}", bucketName, filePath);
    }

}

