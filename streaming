        || manifestRequest.getManifestRequests().isEmpty()) {
      return ManifestStatusResponse.builder()
          .shipmentsSinceLastManifest(shipmentsSinceLastManifest)
          .manifestStatuses(new ArrayList<>())
          .build();
    }

    // Fetch and Prepare manifest statuses
    List<ManifestStatus> manifestStatuses =
        manifestRequest.getManifestRequests().stream()
            .map(
                request -> {
                  validateDateString(request.getStartTime());
                  validateDateString(request.getEndTime());

                  Date startDate =
                      Date.from(
                          LocalDateTime.parse(request.getStartTime())
                              .atZone(ZoneId.systemDefault())
                              .toInstant());
                  Date endDate =
                      Date.from(
                          LocalDateTime.parse(request.getEndTime())
                              .atZone(ZoneId.systemDefault())
                              .toInstant());
                  Long pkgCount =
                      Objects.requireNonNullElse(
                          shipmentRepository.countPackageWithinTimeInterval(
                              manifestRequest.getFacilityId(),
                              manifestRequest.getCustomerId(),
                              startDate,
                              endDate,
                              CARRIER_DHL,
                              STATUS_LABEL_CREATED,
                              STATUS_VOID),
                          0L);

                  return ManifestStatus.builder()
                      .manifestId(request.getManifestId())
                      .totalPackages(pkgCount)
                      .allPickedUp(
                          pkgCount
                              >= request
                                  .getPackageCount()) // Ideally should be equal but to avoid any
                      // data inconsistency we are using ">="
                      .build();
                })
            .collect(Collectors.toList());

    return ManifestStatusResponse.builder()
        .shipmentsSinceLastManifest(shipmentsSinceLastManifest)
        .manifestStatuses(manifestStatuses)
        .build();
  }

  @Override
  public LabelGenerationSummaryDto getLabelGenerationSummary(String source) {
    List<HourlyLabelCountDto> hourlyLabelCountDtoList =
        shipmentRepository.getHourlyLabelCount(source);
    List<DailyLabelCountDto> dailyLabelCountDtos = shipmentRepository.getWeeklyLabelCount(source);
    List<CustomerWiseLabelCountDto> customerWiseLabelCountDtos =
        shipmentRepository.getCustomerWiseLabelCount(source);

    Map<String, List<CustomerWiseLabelCountDto>> customerIdWiseLabelCountDtoMap =
        customerWiseLabelCountDtos.stream()
            .collect(
                Collectors.groupingBy(
                    CustomerWiseLabelCountDto::getCustomerId, Collectors.toList()));

    List<CustomerWisePivotCountDto> customerWisePivotCountDtos =
        customerIdWiseLabelCountDtoMap.entrySet().stream()
            .map(
                entry -> {
                  Long total =
                      entry.getValue().stream()
                          .mapToLong(CustomerWiseLabelCountDto::getTotal)
                          .sum();
                  String customerName = entry.getValue().get(0).getCustomerName();
                  return new CustomerWisePivotCountDto(entry.getKey(), customerName, total);
                })
            .toList();

    return LabelGenerationSummaryDto.builder()
        .hourlyLabelCountDtos(hourlyLabelCountDtoList)
        .dailyLabelCountDtos(dailyLabelCountDtos)
        .customerWiseLabelCountDtos(customerWiseLabelCountDtos)
        .customerWisePivotCountDtos(customerWisePivotCountDtos)
        .build();
  }

  @Override
  public List<YesterdayCustomerLabelCountDto> getYesterdayCustomerLabelCount(String source) {
    return shipmentRepository.getYesterdayCustomerTotalLabelCount(source);
  }

  @Override
  public byte[] getCustomerWeeklyLabelCountCsv(String source) {
    List<CustomerWeeklyLabelCountDto> rows = shipmentRepository.getCustomerWeeklyLabelCount(source)
            .stream()
            .filter(dto->dto.getTotal()>0)
            .toList();

    if(rows.isEmpty()) {
      return new byte[0];
    }

    CsvGenerator<CustomerWeeklyLabelCountDto> generator =
        new CsvGenerator<>(
            CustomerWeeklyLabelCountDto.class,
            CustomerWeeklyLabelCountCsvHeaderConstants.class.getDeclaredFields());
    try (java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
        java.io.Writer writer =
            new java.io.BufferedWriter(
                new java.io.OutputStreamWriter(out, java.nio.charset.StandardCharsets.UTF_8));
        org.apache.commons.csv.CSVPrinter printer = generator.createPrinter(writer)) {
      generator.writeHeader(printer);
      generator.writeRows(rows, printer);
      writer.flush();
      return out.toByteArray();
    } catch (java.io.IOException e) {
      throw new RuntimeException("Failed to generate customer weekly label count CSV", e);
    }
  }

  private void validateDateString(String date) {
    try {
      LocalDateTime.parse(date);
    } catch (Exception e) {
      throw new IllegalArgumentException(
          "Invalid date format. Expected format: yyyy-MM-ddTHH:mm:ss", e);
    }
  }

  private SurroundInsightsEntity mapToSurroundInsightsEntity(
      SurroundInsightsDTO surroundInsightsDto, UUID trackingId) {
    if (surroundInsightsDto == null) return null;
    SurroundInsightsEntity entity =
        SurroundInsightsEntity.builder()
            .trackingId(trackingId)
            .surroundSubscriptionTier(surroundInsightsDto.getSurroundSubscriptionTier())
            .senseawareMobile(surroundInsightsDto.getSenseAwareMobile())
            .weatherImpacted(surroundInsightsDto.getWeatherImpacted())
            .surroundDeliveryPrediction(surroundInsightsDto.getSurroundDeliveryPrediction())
            .arrivalStatusCode(surroundInsightsDto.getArrivalStatusCode())
            .surroundHcid(surroundInsightUtils.formatHealthcareIdentifier(surroundInsightsDto))
            .subStatus(surroundInsightsDto.getSubStatus())
            .build();
    mapInterventionSupportUpdateHistory(entity, surroundInsightsDto);
    return entity;
  }
