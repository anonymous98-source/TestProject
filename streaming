@Slf4j
@Service
@RequiredArgsConstructor
public class TrackingEventDeliveryLogService {

    private final TrackingEventDeliveryLogRepository trackingEventDeliveryLogRepository;

    public GenericResponse saveDeliveryLogs(TrackingEventDeliveryLogDto trackingEventDeliveryLogDto) {
        /*Adding try catch for save method to prevent it from throwing exception when there is an entry already present*/
        try{
            trackingEventDeliveryLogRepository.save(trackingEventDeliveryLogDto.toEntity());
            return GenericResponse.builder().status("200").message("saved").build();

        } catch (DataIntegrityViolationException ex) {
            log.atWarn().setMessage(String.format(
                    "Duplicate delivery log ignored. trackingNumber=%s, uniqueId=%s, topicName=%s, message=%s",
                    trackingEventDeliveryLogDto.getTrackingNumber(),
                    trackingEventDeliveryLogDto.getTrackingNumberUniqueId(),
                    trackingEventDeliveryLogDto.getTopicName(),
                    ex.getMessage())).log();

            return GenericResponse.builder()
                    .status("200")
                    .message("duplicate ignored.")
                    .build();
        }

    }

    @Transactional
    public boolean checkDeliveryLogs(String trackingNumber, String trackingNumberUniqueId, String topicName) {
        log.atInfo()
                .setMessage(String.format("Checking tracking event delivery logs for trackingNumber: %s and topicName: %s"
                        ,trackingNumber, topicName)).log();
        return trackingEventDeliveryLogRepository.existsByTrackingNumberAndTrackingNumberUniqueIdAndTopicName(
                trackingNumber, trackingNumberUniqueId, topicName);
    }
