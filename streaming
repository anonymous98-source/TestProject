import java.util.UUID;

@Repository
public interface TrackingPodRepository extends JpaRepository<TrackingPodEntity, UUID>,
        JpaSpecificationExecutor<TrackingPodEntity> {

  List<TrackingPodEntity> findAllByTrackingId(UUID trackingId);

  @Query(
      """
                    SELECT
                        tp.id AS podId,
                        tp.podContent AS podContent,
                        tp.podContentType AS podContentType,
                        tp.podType AS podType,
                        tp.trackingNumber AS trackingNumber
                    FROM TrackingPodEntity tp
                    WHERE tp.trackingNumber = :trackingNumber
            """)
  List<TrackingDataStreamPodProjection> findAllPodDetailsByTrackingNumber(String trackingNumber);

    @Query(value = """
            SELECT new com.cardinalhealth.advship.tracking.resource.model.dto.BulkExportPodDto(
            tp.podContent, t.shipDate, t.deliveryDate, t.trackingNumber,tp.podContentType,tp.podType)
            FROM TrackingPodEntity tp
                JOIN TrackingEntity t on t.id = tp.trackingId
                JOIN PackageEntity p on p.id = t.packageId
                JOIN ShipmentEntity s on s.id = p.shipmentId
            WHERE t.trackingLastStatus = 'Delivered'
            AND t.shipDate BETWEEN :shipStartDate AND :shipEndDate
            AND s.customerId = :customerId
            AND (:billingGroupIds IS NULL OR s.billingGroupId in :billingGroupIds )
            AND (:facilityIds IS NULL OR s.facilityId in :facilityIds )
            ORDER BY t.shipDate DESC, t.trackingNumber""",
            countQuery = """
                    SELECT count(t.trackingNumber)
                    FROM TrackingPodEntity tp
                        JOIN TrackingEntity t on t.id = tp.trackingId
                        JOIN PackageEntity p on p.id = t.packageId
                        JOIN ShipmentEntity s on s.id = p.shipmentId
                    WHERE t.trackingLastStatus = 'Delivered'
                    AND t.shipDate BETWEEN :shipStartDate AND :shipEndDate
                    AND s.customerId = :customerId
                    AND (:billingGroupIds IS NULL OR s.billingGroupId in :billingGroupIds )
                    AND (:facilityIds IS NULL OR s.facilityId in :facilityIds)""")
    Page<BulkExportPodDto> getFilteredBulkExportPodDTOByTrackingId(
                                                                    @Param("customerId") String customerId,
                                                                    @Param("billingGroupIds") List<String> billingGroupIds,
                                                                    @Param("facilityIds") List<String> facilityIds,
                                                                    @Param("shipStartDate") LocalDateTime shipStartDate,
                                                                    @Param("shipEndDate") LocalDateTime shipEndDate,
                                                                    Pageable pageable
    );
}

