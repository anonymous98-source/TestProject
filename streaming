        server = new MockWebServer();

        // Bind to localhost to avoid kubernetes.docker.internal
        // resolution/connection delays.
        server.start();

        objectMapper = new ObjectMapper();

        properties =
                new AdvShippingIntegrationApiProperties();

        AdvShippingIntegrationApiProperties.ApiConfig apiConfig =
                new AdvShippingIntegrationApiProperties.ApiConfig();

        apiConfig.setUrl(server.url("/").toString());
        apiConfig.setPerfTestUrl(server.url("/perf/").toString());
        apiConfig.setKey("key");

        AdvShippingIntegrationApiProperties.SendFlex sendflex =
                new AdvShippingIntegrationApiProperties.SendFlex();

        sendflex.setApi(apiConfig);

        properties.setSendflex(sendflex);

        retryConfig = new RetryConfig();

        WebClient webClient =
                WebClient.builder().build();

        subject =
                new SendFlexWebClientService(
                        retryConfig,
                        webClient,
                        properties,
                        perfTestDeterminer);

        when(perfTestDeterminer.usePerfTestUrl())
                .thenReturn(false);
    }

