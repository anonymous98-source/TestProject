      Set<PriceQuoteEntity> priceQuoteEntities =
          newShipmentDto.getShipmentPriceQuoteDtos().stream()
              .map(
                  priceQuoteDto ->
                      PriceQuoteEntity.builder()
                          .shipmentId(shipmentEntity.getId())
                          .totalAmount(priceQuoteDto.getTotalAmount())
                          .providerCode(priceQuoteDto.getProviderCode())
                          .requestJson(priceQuoteDto.getRequestJson())
                          .responseJson(priceQuoteDto.getResponseJson())
                          .statusCode(priceQuoteDto.getStatusCode())
                          .errorMessage(priceQuoteDto.getErrorMessage())
                          .build())
              .collect(Collectors.toSet());

      priceQuoteRepository.saveAll(priceQuoteEntities);
    }
  }

