                      .cmsRefNo(shipmentPackageDto.getCmsRefNo())
                      .packageLabelReference1(shipmentPackageDto.getPackageLabelReference1())
                      .packageLabelReference2(shipmentPackageDto.getPackageLabelReference2())
                      .packageLabelReference3(shipmentPackageDto.getPackageLabelReference3())
                      .packageLabelReference4(shipmentPackageDto.getPackageLabelReference4())
                      .packageNickName(shipmentPackageDto.getPackageNickName())
                      .internalDesignationReference(
                          shipmentPackageDto.getInternalDesignationReference())
                      .pharmacyOrderNumber(shipmentPackageDto.getPharmacyOrderNumber())
                      .includeReturnLabel(shipmentPackageDto.getIncludeReturnLabel())
                      .destinationCity(newShipmentDto.getShipToCity()) // shipToCity
                      .destinationState(newShipmentDto.getShipToState()) // shipToState
                      .destinationCountry(newShipmentDto.getShipToCountry()) // shipToCountry
                      // NEW FIELDS SETTING
                      .innerLength(shipmentPackageDto.getInnerLength())
                      .innerWidth(shipmentPackageDto.getInnerWidth())
                      .innerHeight(shipmentPackageDto.getInnerHeight())
                      .ratedLength(shipmentPackageDto.getRatedLength())
                      .packagingType(shipmentPackageDto.getPackagePackagingType())
                      .packageBrand(shipmentPackageDto.getPackageBrand())
                      .packageProductName(shipmentPackageDto.getPackageProductName())
                      .packageDescription(shipmentPackageDto.getPackageDescription())
                      .packageModelIdentifier(shipmentPackageDto.getPackageModelIdentifier())
                      .isCustomPackage(shipmentPackageDto.isCustomPackage())
                      .build();

              pkg = packageRepository.save(pkg);
              saveExternalReference(shipmentPackageDto, pkg);

              createTracking(shipmentPackageDto.getShipmentPackageTracking(), pkg, newShipmentDto);
              createAdditionalServicePackage(shipmentPackageDto, pkg);

              return pkg;
            })
        .collect(Collectors.toSet());
