import org.apache.commons.lang3.StringUtils;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Optional;


import static com.cardinalhealth.advship.tracking.resource.service.facility.constants.UserConstants.*;
import static java.util.Collections.emptyList;

@Component
@RequiredArgsConstructor
@Slf4j
public class CommonUtilsService {

    private final UserClient userClient;
    private final CustomerService customerService;
    

    public UserCustomerProfile getUserCustomerProfile(String userName) {
        OflUser currentUser = getUser(userName);
        log.atInfo().setMessage(
                                "fetching from customer service.")
                        .log();
        UserCustomerProfile userCustomerProfile = customerService.getCustomer(getUserEntities(currentUser));
        log.atInfo().setMessage("customer profile data has been saved.").log();
        return Optional.ofNullable(userCustomerProfile)
                .orElseThrow(() -> new RuntimeException("Could not find customer data for user"));

    }

    public OflUser getUser(String userName) {
        return userClient.getUser(userName)
                .orElseThrow(() -> new RuntimeException("Could not find user data"));
    }

    public List<Entity> getUserEntities(OflUser user) {
        if (user.getUserPermissionList() == null || user.getUserPermissionList().isEmpty()) {
            return emptyList();
        }
        return user.getUserPermissionList().stream()
                .filter(userPermission -> hasAdvshipRole(userPermission.getUserRole().getName()))
                .flatMap(userPermission -> userPermission.getEntityList().stream())
                .map(oflEntity -> Entity.builder()
                                .type(EntityType.fromName(oflEntity.getEntityType()))
                                .id(oflEntity.getEntityId()).build())
                .toList();
    }

    public boolean hasAdvshipRole(String roleName) {
        if (StringUtils.isBlank(roleName)) return false;
        return roleName.equalsIgnoreCase(ADVSHIP_USER)
                || roleName.equalsIgnoreCase(ADVSHIP_SHIPPER)
                || roleName.equalsIgnoreCase(ADVSHIP_VIEWER)
                || roleName.equalsIgnoreCase(ADVSHIP_ADMIN)
                || roleName.equalsIgnoreCase(ADVSHIP_CUSTOMER_ADMIN);
    }

}

