  @Override
  public LabelDTO getLabelByIdAndType(String shipmentTxnId, String format, String trackingNumber) {
    log.atInfo()
            .setMessage(
                    "id from API request: "
                            + shipmentTxnId
                            + ", format from API request: "
                            + format
                            + ", trackingNumber from API request: "
                            + trackingNumber)
            .log();
    log.atInfo()
            .addKeyValue(ServiceCommonConstants.SHIPMENT_ID, shipmentTxnId)
            .setMessage("Fetching label by ID and format")
            .log();

    ShipmentEntity shipmentEntity =
        Optional.ofNullable(shipmentRepository.findByShipmentTransactionId(shipmentTxnId))
            .orElseThrow(
                () ->
                    new ResourceNotFoundException(
                        "No shipmentEntity found for given id: " + shipmentTxnId));

    var trackingEntity =
        trackingRepository.findAllByShipmentId(shipmentEntity.getId()).stream()
            .filter(te -> te != null && te.getTrackingNumber().equals(trackingNumber))
            .findFirst()
            .orElseThrow(
                () ->
                    new ResourceNotFoundException(
                        "No tracking found for given id: " + shipmentTxnId));

    String labelContent = trackingEntity.getLabelContent();
    String labelFormat = trackingEntity.getLabelType();

    if (labelFormat.equalsIgnoreCase(format)) {
      return buildLabelDTO(labelContent, labelFormat);
    } else {
      throw new ResourceNotFoundException("Label not found for the given format");
    }
  }

  private LabelDTO buildLabelDTO(String content, String format) {
    return LabelDTO.builder().contentUrl(content).labelType(format).build();
  }
