    private static void mapLocationsAndShipperAccountNumber(CriteriaBuilder cb, Root<ShipmentEntity> s, Root<TrackingEntity> t,
                                                            List<Predicate> predicates, DynamicFilterRequest dynamicFilterRequest) {
        if (dynamicFilterRequest.getShippingLocation() != null && !dynamicFilterRequest.getShippingLocation().isEmpty()) {

            Predicate shipFromAndNavigator = cb.and(
                    s.get(FACILITY_ID).in(dynamicFilterRequest.getShippingLocation()),
                    cb.notEqual(t.get(APPLICATION_SOURCE), NON_NAVIGATOR)
            );

            if (dynamicFilterRequest.getShipperAccountNumbers() != null && !dynamicFilterRequest.getShipperAccountNumbers().isEmpty() &&
                    !dynamicFilterRequest.isMyShipment() && dynamicFilterRequest.isNonNavigator()) {

                Predicate accountAndIsNonNavigator = cb.and(
                        s.get(SURROUND_BILL_TO_NUMBER).in(dynamicFilterRequest.getShipperAccountNumbers()),
                        cb.equal(t.get(APPLICATION_SOURCE), NON_NAVIGATOR)
                );

                predicates.add(cb.or(shipFromAndNavigator, accountAndIsNonNavigator));
            } else {
                Predicate facilityPredicate = s.get(FACILITY_ID).in(dynamicFilterRequest.getShippingLocation());
                predicates.add(facilityPredicate);
            }
        } else if (dynamicFilterRequest.getShipperAccountNumbers() != null && !dynamicFilterRequest.getShipperAccountNumbers().isEmpty() &&
                !dynamicFilterRequest.isMyShipment() && dynamicFilterRequest.isNonNavigator()) {
            Predicate accountCondition = cb.or(
                    cb.isNull(s.get(SURROUND_BILL_TO_NUMBER)),
                    s.get(SURROUND_BILL_TO_NUMBER).in(dynamicFilterRequest.getShipperAccountNumbers())
            );

            predicates.add(accountCondition);
        }
    }


    void validateDateRange(Map<String, String> filters) {
        String start = filters.get(START_DATE);
        String end = filters.get(END_DATE);
        if (start != null && end != null) {
            try {
                LocalDate filterStart = LocalDate.parse(start);
                LocalDate filterEnd = LocalDate.parse(end).plusDays(1); // inclusive
                Period period = Period.between(filterStart, filterEnd);
                if (isDateRangeExceedingOneYear(period)) {
                    throw new ValidationException("Dates differ by more than one year.");
                }
            } catch (DateTimeParseException e) {
                throw new ValidationException(String.format("Invalid date format in filters start: %s and end date: %s", start, end));
            }
        }
    }

    /**
     * Returns true if the period exceeds one year.
     */
    private static boolean isDateRangeExceedingOneYear(Period p) {
        return Math.abs(p.getYears()) > 1 || (p.getYears() == 1 && (p.getMonths() > 0 || p.getDays() > 1));
    }

    private static void mapStartDateAndEndDate(CriteriaBuilder cb, Root<TrackingEntity> t, String timezone, LocalDateTime startDateTime,
                                               LocalDateTime endDateTime, List<Predicate> predicates, DynamicFilterRequest dynamicFilterRequest) {
        if (dynamicFilterRequest.getFilters().containsKey(START_DATE) && dynamicFilterRequest.getFilters().containsKey(END_DATE)) {

            LocalDate filterStart = LocalDate.parse(dynamicFilterRequest.getFilters().get(START_DATE));
            LocalDate filterEnd = LocalDate.parse(dynamicFilterRequest.getFilters().get(END_DATE)).plusDays(1);


            LocalDateTime parsedStart = DateTimeUtil.buildLocalDateTimeFromTimeZone(filterStart.atStartOfDay(), timezone);
            LocalDateTime parsedEnd = DateTimeUtil.buildLocalDateTimeFromTimeZone(
                    filterEnd.atStartOfDay().minusDays(1).withHour(23).withMinute(59).withSecond(59),
                    timezone
            );

            if (Boolean.TRUE.equals(dynamicFilterRequest.getIsShipmentPageWanted())) {
                parsedStart = parsedStart.isBefore(startDateTime) ? startDateTime : parsedStart;
                parsedEnd = parsedEnd.isAfter(endDateTime) ? endDateTime : parsedEnd;
            }


            startDateTime = parsedStart;
            endDateTime = parsedEnd;

            Timestamp startTimestamp = Timestamp.valueOf(startDateTime);
            Timestamp endTimestamp = Timestamp.valueOf(endDateTime);

            predicates.add(
                    cb.or(
                            cb.between(t.get(TRACKING_CREATED_AT), startTimestamp, endTimestamp),
                            cb.between(t.get(TRACKING_LAST_MODIFIED_AT), startTimestamp, endTimestamp)
                    )
            );
        }
    }

