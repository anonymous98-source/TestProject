  @BeforeEach
  void setUp() {

    trackingWebhookFedexPublisher =
        new TrackingWebhookFedexPublisher(
            publisher,
            trackingDataService,
            trackingSave,
            saveFedexJsonService,
            trackingNoPhiDataPublisher);

    mapperMock = Mockito.mockStatic(FedexToTrackingInputMapper.class);

    /*
     * mapFedexToTrackingInput() returns ShipmentDTO.
     * This was one of the main completion/type problems in the previous test.
     */
    mapperMock
        .when(
            () ->
                FedexToTrackingInputMapper.mapFedexToTrackingInput(
                    any(TrackingFedexDTO.class), any()))
        .thenReturn(mock(ShipmentDTO.class));

    /*
     * Stub mapper helper methods used by generalizeData().
     */
    mapperMock
        .when(() -> FedexToTrackingInputMapper.getBeginDateByType(any(), anyList()))
        .thenReturn("");

    mapperMock
        .when(
            () ->
                FedexToTrackingInputMapper.convertToCompatibleFormatWithOffset(any()))
        .thenReturn("2026-09-10T10:00:00+05:30");

    mapperMock
        .when(
            () ->
                FedexToTrackingInputMapper.convertToCompatibleFormatWithoutOffset(any()))
        .thenReturn("2026-09-10T10:00:00");

    mapperMock
        .when(
            () ->
                FedexToTrackingInputMapper.mapEventTypeFromEventDescriptionStatus(
                    anyString()))
        .thenReturn("DELIVERED");
  }

  @AfterEach
  void tearDown() {
    if (mapperMock != null) {
      mapperMock.close();
    }
  }

