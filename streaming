@Repository
public interface ReasonCodeOccurrenceRepository
    extends JpaRepository<ReasonCodeOccurrenceMVEntity, UUID> {

  @Query(
      value =
          """
                WITH all_reason_code_occurrence AS (
                  SELECT
                        vw.package_id,
                        vw.reason_code_description,
                        vw.tracking_event_timestamp,
                        vw.tracking_event_id
                    FROM advship_tracking_resource.mv_package_reason_code_occurrence vw
                    WHERE vw.facility_id in :facilityIds
                        AND vw.tracking_event_timestamp >= CURRENT_DATE - INTERVAL '1 day' * :periodInDays
                ),
                distinct_shipment_reason_code_occurrence AS (
                    SELECT COUNT(DISTINCT r.package_id) AS distinct_shipment_count
                    FROM all_reason_code_occurrence r
                )
                SELECT
                    t.reason_code_description AS reasonCode,
                    COUNT(t.*) AS occurrenceCount,
                    dsc.distinct_shipment_count AS totalDistinctShipmentCount -- just to get distinct shipment count and keep both in single query to avoid multiple hits to db, this will be same for all reason codes
                FROM all_reason_code_occurrence t
                CROSS JOIN distinct_shipment_reason_code_occurrence dsc
                GROUP BY t.reason_code_description, dsc.distinct_shipment_count
                ORDER BY occurrenceCount DESC, reasonCode
            """,
      nativeQuery = true)
  List<ReasonCodeOccurrenceProjection> findReasonCodeOccurrences(
      @Param("facilityIds") List<String> facilityIds, @Param("periodInDays") Long periodInDays);

  @Query(
      value =
          """
                WITH date_series AS (
                      SELECT
                          CASE
                              WHEN :periodInDays <= 30
                                  THEN (CURRENT_DATE - INTERVAL '1 day' * gs.n)::date
                              ELSE (date_trunc('week', CURRENT_DATE) - INTERVAL '1 week' * gs.n)::date
                          END AS groupedPeriod
                      FROM generate_series(
                          0,
                          CASE
                              WHEN :periodInDays <= 30 THEN :periodInDays
                              ELSE (
                                  EXTRACT(EPOCH FROM (date_trunc('week', CURRENT_DATE) - date_trunc('week', CURRENT_DATE - INTERVAL '1 day' * (:periodInDays)))) / (7 * 24 * 60 * 60)
                              )::int
                          END
                      ) AS gs(n)
                   ),
                   shipment_counts AS (
                       SELECT
                           CASE WHEN :periodInDays <= 30
                               THEN shipment_created_at::date
                               ELSE DATE_TRUNC('week', shipment_created_at)::date
                           END AS group_date,
                           COUNT(DISTINCT v.package_id) AS totalShipmentCount
                       FROM advship_tracking_resource.VISUALIZATION_DASHBOARD_PARENT_MV v
                       WHERE v.carrier = 'Courier'
                           AND v.shipment_created_at >= CURRENT_DATE - INTERVAL '1 day' * :periodInDays
                           AND v.facility_id IN :facilityIds
                       GROUP BY group_date
                  ),
                  reason_code_distinct_date_wise_counts AS (
                      SELECT
                          rco.reason_code_occurrence_date,
                          rco.reason_code_occurrence_week_start_date,
                          COUNT(DISTINCT rco.package_id) AS reasonCodeCount
                        FROM advship_tracking_resource.mv_package_reason_code_occurrence rco
                        WHERE rco.tracking_event_timestamp >= CURRENT_DATE - INTERVAL '1 day' * :periodInDays
                           AND rco.facility_id IN :facilityIds
                      GROUP by rco.reason_code_occurrence_date, reason_code_occurrence_week_start_date
                  ),
                  reason_code_grouped_counts AS (
                      SELECT
                          CASE WHEN :periodInDays <= 30
                              THEN rcddwc.reason_code_occurrence_date
                              ELSE rcddwc.reason_code_occurrence_week_start_date
                          END AS reason_code_occurrence_period,
                          COALESCE(SUM(rcddwc.reasonCodeCount), 0) AS totalReasonCodeCountOfPeriod
                      FROM reason_code_distinct_date_wise_counts rcddwc
                      GROUP BY reason_code_occurrence_period
                  )
                  SELECT
                      COALESCE(ds.groupedPeriod, COALESCE(s.group_date, r.reason_code_occurrence_period)) as countPeriodDate,
                      INITCAP(TRIM(TO_CHAR(COALESCE(ds.groupedPeriod, COALESCE(s.group_date, r.reason_code_occurrence_period)), 'Day'))) as periodDay,
                      COALESCE(s.totalShipmentCount, 0) AS totalShipmentCount,
                      COALESCE(r.totalReasonCodeCountOfPeriod, 0) AS reasonCodeCount
                  FROM date_series ds
                      LEFT JOIN shipment_counts s
                              ON ds.groupedPeriod = s.group_date
                      FULL OUTER JOIN reason_code_grouped_counts r
                              ON s.group_date = r.reason_code_occurrence_period
                  ORDER BY countPeriodDate
            """,
      nativeQuery = true)
  List<ShipmentAndReasonCodeStatsProjection> getShipmentAndReasonCodeStatsWithoutPeriod(
      @Param("facilityIds") List<String> facilityIds, @Param("periodInDays") Long periodInDays);
}

