package com.cardinalhealth.advship.tracking.resource.service.impl;

import com.cardinalhealth.advship.tracking.resource.model.request.MonitoringQueryDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Map;
import java.util.Objects;

@Slf4j
@Service
@RequiredArgsConstructor
public class MonitoringQueryExecutionService {

    private static final String SELECT_PREFIX = "select";
    private static final String WITH_PREFIX = "with";
    private static final List<String> BLOCKED_SYMBOLS = List.of(";", "--", "/*", "*/");
    private static final List<String> BLOCKED_KEYWORDS = List.of(
            "pg_catalog", "information_schema", "pg_read_file", "pg_ls_dir",
            "lo_import", "copy", "\\copy", "dblink", "pg_sleep"
    );

    private final JdbcTemplate jdbcTemplate;

    public List<MonitoringQueryDto> executeAll(List<MonitoringQueryDto> requests) {
        log.info("[MonitoringQueryExecution] Executing {} queries.", requests.size());
        return requests.stream().filter(Objects::nonNull).map(this::execute).toList();
    }

    private MonitoringQueryDto execute(MonitoringQueryDto request) {
        try {
            String validatedQuery = validateQuery(request.query());
            List<Map<String, Object>> rows = jdbcTemplate.queryForList(validatedQuery);
            Map<String, Object> result = rows.isEmpty() ? Map.of() : Map.of("count", rows.size());
            log.info("[MonitoringQueryExecution] query_name='{}' executed successfully.", request.queryName());
            return new MonitoringQueryDto(request.id(), request.queryName(), request.query(), result, null);
        } catch (Exception e) {
            log.error("[MonitoringQueryExecution] query_name='{}' failed: {}.", request.queryName(), e.getMessage());
            return new MonitoringQueryDto(request.id(), request.queryName(), request.query(), null, e.getMessage());
        }
    }

    private String validateQuery(String query) {
        String trimmed = query.trim();
        String lower = trimmed.toLowerCase();

        if (!(lower.startsWith(SELECT_PREFIX) || lower.startsWith(WITH_PREFIX))) {
            throw new IllegalArgumentException("Only SELECT and WITH statements are allowed.");
        }
        for (String symbol : BLOCKED_SYMBOLS) {
            if (trimmed.contains(symbol)) {
                throw new IllegalArgumentException("Query contains disallowed symbol: " + symbol);
            }
        }
        for (String keyword : BLOCKED_KEYWORDS) {
            if (lower.contains(keyword.toLowerCase())) {
                throw new IllegalArgumentException("Query contains disallowed keyword: " + keyword);
            }
        }
        return trimmed;
    }
}

