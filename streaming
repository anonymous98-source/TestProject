                                )
                        )
                                + ","
                                + csv(
                                formatFields(
                                        match.onlyInDto2()
                                )
                        )
                                + ","
                                + csv(
                                String.join(
                                        " | ",
                                        match.differentTypes()
                                )
                        )
                );

                writer.newLine();
            }
        }
    }

    private String formatFields(
            Set<?> fields) {

        return fields.stream()
                .map(Object::toString)
                .sorted()
                .collect(
                        Collectors.joining(
                                " | "
                        )
                );
    }

    private String csv(
            String value) {

        if (value == null) {
            return "";
        }

        return "\""
                + value.replace(
                "\"",
                "\"\""
        )
                + "\"";
    }
