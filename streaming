  private void updateTrackingFromShipmentDetails(ShipmentDetails shipmentDetailsDTO) {
    if (!shouldUpdateTracking(shipmentDetailsDTO)) {
      return;
    }
    String trackingNumber = shipmentDetailsDTO.getTrackingNumber();
    if (trackingNumber == null || trackingNumber.isEmpty()) {
      return;
    }
    TrackingEntity trackingEntity = trackingRepository.findByTrackingNumber(trackingNumber);
    if (trackingEntity == null) {
      return;
    }

    if (shipmentDetailsDTO.getSurroundConfidenceScore() != null) {
      trackingEntity.setSurroundConfidenceScore(shipmentDetailsDTO.getSurroundConfidenceScore());
    }
    if (shipmentDetailsDTO.getPviCaseCount() != null) {
      trackingEntity.setPviCaseCount(shipmentDetailsDTO.getPviCaseCount());
    }
    if (shipmentDetailsDTO.getPviCaseLastStatus() != null) {
      trackingEntity.setPviCaseLastStatus(shipmentDetailsDTO.getPviCaseLastStatus());
    }

    SurroundInsightsDTO surroundInsightsDTO = shipmentDetailsDTO.getSurroundInsights();
    setLatestInterventionAndCaseFields(trackingEntity, surroundInsightsDTO);
    trackingRepository.save(trackingEntity);
    if (surroundInsightsDTO != null) {
      upsertSurroundInsights(trackingEntity.getId(), surroundInsightsDTO);
      surroundInsightUtils.upsertTrackingPviCasesEntities(
          surroundInsightsDTO.getCaseList(), trackingEntity.getId());
    }
    if (!ObjectUtils.isEmpty(shipmentDetailsDTO.getShipmentSource())
            && shipmentDetailsDTO.getShipmentSource().equalsIgnoreCase(ServiceCommonConstants.NON_NAVIGATOR)
            && !CollectionUtils.isEmpty(shipmentDetailsDTO.getShipmentLinkedEntitiesList())) {
      if (CollectionUtils.isEmpty(shipmentLinkedEntitiesRepository.findBillingGroupEntitiesByShipmentId(shipmentDetailsDTO.getShipmentID()))) {
        try {
          shipmentAdapter.createShipmentLinkedEntities(
                  shipmentDetailsDTO.getShipmentLinkedEntitiesList(), shipmentDetailsDTO.getShipmentID());
        } catch (DataIntegrityViolationException e) {
          log.info("Shipment linked entities already exist for shipment: {}", shipmentDetailsDTO.getShipmentID());
        }
      }
    }
  }

  private boolean shouldUpdateTracking(ShipmentDetails dto) {
    return dto.getSurroundConfidenceScore() != null
        || dto.getPviCaseCount() != null
        || dto.getPviCaseLastStatus() != null
        || dto.getSurroundInsights() != null
        || !CollectionUtils.isEmpty(dto.getShipmentLinkedEntitiesList());
  }

  public SurroundInsightsEntity upsertSurroundInsights(
      UUID trackingId, SurroundInsightsDTO surroundInsightsDTO) {
    var surroundInsightsEntity = surroundInsightsRepository.findByTrackingId(trackingId);

    if (surroundInsightsEntity == null) {
      surroundInsightsEntity = mapToSurroundInsightsEntity(surroundInsightsDTO, trackingId);
    } else {
      updateSurroundInsightsFields(surroundInsightsEntity, surroundInsightsDTO);
    }

    return surroundInsightsRepository.save(surroundInsightsEntity);
  }

  private void updateSurroundInsightsFields(
      SurroundInsightsEntity existing, SurroundInsightsDTO surroundInsightsDto) {
    existing.setSurroundSubscriptionTier(surroundInsightsDto.getSurroundSubscriptionTier());
    existing.setSenseawareMobile(surroundInsightsDto.getSenseAwareMobile());
    existing.setWeatherImpacted(surroundInsightsDto.getWeatherImpacted());
    existing.setSurroundDeliveryPrediction(surroundInsightsDto.getSurroundDeliveryPrediction());
    existing.setSubStatus(surroundInsightsDto.getSubStatus());
    existing.setArrivalStatusCode(surroundInsightsDto.getArrivalStatusCode());
    existing.setSurroundHcid(surroundInsightUtils.formatHealthcareIdentifier(surroundInsightsDto));
    mapInterventionSupportUpdateHistory(existing, surroundInsightsDto);
  }

  private void mapInterventionSupportUpdateHistory(
      SurroundInsightsEntity existing, SurroundInsightsDTO surroundInsightsDto) {
    try {
      if (surroundInsightsDto.getInterventionHistory() != null) {
        existing.setInterventionHistory(
            objectMapper.valueToTree(surroundInsightsDto.getInterventionHistory()));
      }
      if (surroundInsightsDto.getSupportUpdateHistory() != null) {
        existing.setSupportUpdateHistory(
            objectMapper.valueToTree(surroundInsightsDto.getSupportUpdateHistory()));
      }
    } catch (Exception e) {
      throw new ValidationException(
          "Failed to serialize Support update history / Intervention history fields", e);
    }
  }

  public void setLatestInterventionAndCaseFields(
