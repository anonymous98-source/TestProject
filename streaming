import org.springframework.web.server.ResponseStatusException;

@Slf4j
@Service
@RequiredArgsConstructor
public class CsvReportAlertDetailsService {

    private final SavedViewsReportsRepository savedViewsReportsRepository;
    private final UserFacilitiesService userFacilitiesService;
    private final ObjectMapper objectMapper;
    private final CsvReportShipmentDetailsService csvReportShipmentDetailsService;


    public ShipmentTrackExportReq buildTrackingRequest(UUID viewId, String userName, String timeZone) {


        Optional<SavedViewsReportsEntity> savedViewsReportsOptional =
                savedViewsReportsRepository.findById(viewId);
        if (savedViewsReportsOptional.isEmpty()) {
            throw new ResourceNotFoundException(viewId.toString());
        }
        SavedViewsReportsEntity savedViewsReportsEntity = savedViewsReportsOptional.get();
        log.atInfo().log("saved view details, viewId : {} , viewType : {}, viewName : {} "
                ,savedViewsReportsEntity.getId(), savedViewsReportsEntity.getViewType(), savedViewsReportsEntity.getViewName());

        // fetch user customer profile details and reuse the same if required any details from customer profile
        UserCustomerProfile userCustomerProfile = userFacilitiesService.getUserCustomerProfile(userName);

        ShipmentTrackExportReq shipmentTrackExportReq = buildRequest(savedViewsReportsEntity, userName, userCustomerProfile, timeZone);

        // shipper account number as surround_bill_to_no in shipmentEntity table
        shipmentTrackExportReq.setShipperAccountNumbers(userFacilitiesService.getShipperAccountNumbers(userCustomerProfile));

        log.atInfo().addKeyValue("user", userName)
                .setMessage("Shipper account numbers: " + shipmentTrackExportReq.getShipperAccountNumbers()).log();
        return shipmentTrackExportReq;
    }

    private ShipmentTrackExportReq buildRequest(SavedViewsReportsEntity savedViewsReportsEntity,
                                                String userName, UserCustomerProfile userCustomerProfile, String timeZone) {
        var viewFilterJson = savedViewsReportsEntity.getViewFilterJson();
        var request = new ShipmentTrackExportReq();

        request.setTimezone(timeZone);
        if (viewFilterJson != null && !viewFilterJson.isNull()
                && savedViewsReportsEntity.getViewType().equalsIgnoreCase(ServiceCommonConstants.CUSTOM)) {
            log.atInfo().setMessage("view filter json is not null, fetching filters").log();
            Map<String, String> filters = ViewFilterJsonConverter.convert(viewFilterJson);
            request.setFilters(filters);

            List<String> shippingLocations = ViewFilterJsonConverter.extractShippingLocations(viewFilterJson);
            if (!shippingLocations.isEmpty()) {
                List<String> userLocations = userFacilitiesService.getUserFacilities(userCustomerProfile);
                if (!(new HashSet<>(userLocations).containsAll(shippingLocations))) {
                    throw new ResponseStatusException(
                            HttpStatus.BAD_REQUEST, "Invalid Shipping location passed by the user");
                }
                request.setShippingLocation(shippingLocations);
            } else {
                setLocations(request, userName, userCustomerProfile);
            }

            request.setMyShipment(ViewFilterJsonConverter.extractMyShipment(viewFilterJson));
            request.setNonNavigator(ViewFilterJsonConverter.extractNonNavigator(viewFilterJson));


            ViewFilterJsonConverter.extractSortingInfo(viewFilterJson).ifPresentOrElse(
                    sort -> {
                        request.setSortingColumn(sort.column());
                        request.setSortingDirection(sort.direction());
                    },
                    () -> {
                        request.setSortingColumn("lastScanned");
                        request.setSortingDirection("desc");
                    }
            );
        } else {
            // standard view
            log.atInfo().setMessage("view filter json is  null, considering as standard views.").log();
            request.setMyShipment(false);
            setLocations(request, userName, userCustomerProfile);
            request.setSortingColumn("lastScanned");
            request.setSortingDirection("desc");
            if (savedViewsReportsEntity.getViewType().equalsIgnoreCase("standard")) {
                Map<String, String> filters = buildStandardViewFilters(savedViewsReportsEntity.getViewName(), timeZone);
                log.atInfo().log("filters for standard view : {}", filters);
                request.setFilters(filters);
            }
        }

        request.setIsShipmentPageWanted(true);

        return request;
    }

    private void setLocations(ShipmentTrackExportReq request, String userName, UserCustomerProfile userCustomerProfile) {
        List<String> allLocations = userFacilitiesService.getUserFacilities(userCustomerProfile);
        log.atInfo().log("Username : {}, Locations : {}", userName, allLocations);
        request.setShippingLocation(allLocations);
    }

    public void exportCsvInAlert(UUID viewId, OutputStream outputStream, String timezone, Boolean isBeaconPlus,
                                 OflUserDetailsDTO oflUserDetailsDTO) throws CsvReportException {

        Optional<SavedViewsReportsEntity> savedViewsReports= savedViewsReportsRepository.findById(viewId);

        if (savedViewsReports.isPresent()) {
            SavedViewsReportsEntity savedView = savedViewsReports.get();
            if (!ServiceCommonConstants.STANDARD.equalsIgnoreCase(savedView.getViewType())
                    && (savedView.getUserId() == null
                    || !savedView.getUserId().toString().equals(oflUserDetailsDTO.getUserId()))) {
                throw new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "The view does not belong to the user so it can't be accessed for export");
            }
        }


        ShipmentTrackExportReq shipmentTrackExportReq = buildTrackingRequest(viewId, oflUserDetailsDTO.getEmail(), timezone);

        // Use provided timezone or default to UTC if null/empty
        String effectiveTimezone = (timezone == null || timezone.isEmpty()) ? ServiceCommonConstants.DEFAULT_TIMEZONE : timezone;
        shipmentTrackExportReq.setTimezone(effectiveTimezone);
        shipmentTrackExportReq.setIsBeaconPlus(isBeaconPlus);

        // the below try-catch is required to debug whether correct request payload is formed or not
        try {
            log.atInfo().log("CSV export request of view details : {}", objectMapper.writeValueAsString(shipmentTrackExportReq));
        } catch (Exception e) {
            log.atError().log("CSV export request of view details: {}", shipmentTrackExportReq);
        }
        csvReportShipmentDetailsService.writeCsvReport(shipmentTrackExportReq, outputStream, oflUserDetailsDTO.getUserId());
    }
}

