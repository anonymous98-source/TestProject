  private TrackingEntity createTracking(
      ShipmentPackageTracking shipmentPackageTracking,
      PackageEntity newPackageEntity,
      NewShipmentDto newShipmentDto) {

    ObjectMapper objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    objectMapper.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);

    SurroundInsightsDTO surroundInsights = shipmentPackageTracking.getSurroundInsights();
    List<InterventionHistoryDTO> interventionHistoryList = null;
    JsonNode interventionHistoryJson = null;
    InterventionHistoryDTO interventionHistoryDTO = null;
    CaseListDTO caseDTO = null;
    if (surroundInsights != null) {
        interventionHistoryList = surroundInsights.getInterventionHistory();
        if (interventionHistoryList != null) {
            interventionHistoryJson = objectMapper.valueToTree(interventionHistoryList);
        }
        interventionHistoryDTO = surroundInsightUtils.getInterventionDetailsFromJson(interventionHistoryJson);
        if (surroundInsights.getCaseList() != null) {
            caseDTO = surroundInsightUtils.getLatestCaseNode(objectMapper.valueToTree(surroundInsights.getCaseList()));
        }
    }

    TrackingEntity newTrackingEntity =
        TrackingEntity.builder()
            .packageId(newPackageEntity.getId())
            .trackingNumber(shipmentPackageTracking.getTrackingNumber())
            .trackingUrl(shipmentPackageTracking.getTrackingUrl())
            .shipDate(shipmentPackageTracking.getShipDate())
            .labelContent(shipmentPackageTracking.getLabelContent())
            .labelType(shipmentPackageTracking.getLabelType())
            .expectedDeliveryDate(shipmentPackageTracking.getExpectedDeliveryDate())
            .trackingNumberUpdatedOnEpic(shipmentPackageTracking.getTrackingNumberUpdatedOnEpic())
            .podUpdatedOnEpic(shipmentPackageTracking.getPodUpdatedOnEpic())
            .trackingLastScanLocation(shipmentPackageTracking.getTrackingLastScanLocation())
            .trackingLastUpdatedAt(shipmentPackageTracking.getTrackingLastUpdatedAt())
            .trackingLastStatus(shipmentPackageTracking.getTrackingLastStatus())
            .trackingLastMessage(shipmentPackageTracking.getTrackingLastMessage())
            .epicSkipReason(shipmentPackageTracking.getEpicSkipReason())
            .returnLabelContent(shipmentPackageTracking.getReturnLabelContent())
            .returnLabelType(shipmentPackageTracking.getReturnLabelType())
            .trackingDataSource(
                shipmentPackageTracking.getTrackingDataSource() != null
                    ? shipmentPackageTracking.getTrackingDataSource()
                    : null)
            .applicationSource(
                shipmentPackageTracking.getApplicationSource()) // ASK FOR: need to check
            .carrierCode(shipmentPackageTracking.getCarrierCode()) // FEDEX, USPS, CMS
            .carrierScacCode(shipmentPackageTracking.getCarrierScacCode())
            .smsSubscribed(
                shipmentPackageTracking.getNotifications() != null
                    && shipmentPackageTracking.getNotifications().stream()
                        .filter(Objects::nonNull)
                        .filter(
                            notification ->
                                ServiceCommonConstants.PHONE.equals(
                                    notification.getNotificationCommunicationChannel()))
                        .map(ShipmentNotificationDto::getNotificationCommunicationValue)
                        .filter(Objects::nonNull)
                        .anyMatch(s -> !s.isEmpty()))
            .userFirstName(newShipmentDto.getUserFirstName()) //
            .userLastName(newShipmentDto.getUserLastName())
            .userEmail(newShipmentDto.getUserEmail())
            .delayReason(shipmentPackageTracking.getDelayReason())
            .specialHandling(shipmentPackageTracking.getSpecialHandling())
            .surroundConfidenceScore(shipmentPackageTracking.getSurroundConfidenceScore())
            .latestInterventionDate(interventionHistoryDTO != null ?
                    interventionHistoryDTO.getInterventionDateTime() : null)
            .latestInterventionRequested(interventionHistoryDTO != null ?
                    interventionHistoryDTO.getInterventionRequested() : null)
            .latestInterventionStatus(interventionHistoryDTO != null ?
                    interventionHistoryDTO.getInterventionStatus() : null)
            .pviCaseSubcategory(caseDTO != null ? caseDTO.getCaseSubCategory() : null)
            .pviCaseType(caseDTO != null ? caseDTO.getCaseType() : null)
            .pviCaseCount(shipmentPackageTracking.getPviCaseCount())
            .pviCaseLastStatus(shipmentPackageTracking.getPviCaseLastStatus())
            .build();

    newTrackingEntity = trackingRepository.save(newTrackingEntity);

    createTrackingEvent(shipmentPackageTracking, newTrackingEntity);
    createNotifications(shipmentPackageTracking, newTrackingEntity);

    trackingPviCasesRepository.saveAll(createTrackingPviCases(shipmentPackageTracking, newTrackingEntity.getId()));

    var surroundInsightsEntity = createSurroundInsights(shipmentPackageTracking, newTrackingEntity.getId());
    if (surroundInsightsEntity != null) surroundInsightsRepository.save(surroundInsightsEntity);

    return newTrackingEntity;
  }

  private SurroundInsightsEntity createSurroundInsights(ShipmentPackageTracking shipmentPackageTracking, UUID trackingId) {
    SurroundInsightsDTO dto = shipmentPackageTracking.getSurroundInsights();
    if (dto == null) return null;

    ObjectMapper objectMapper = new ObjectMapper();
    JsonNode interventionHistoryJson = null;
    JsonNode supportUpdateHistoryJson = null;
    try {
        if (dto.getInterventionHistory() != null) {
            interventionHistoryJson = objectMapper.valueToTree(dto.getInterventionHistory());
        }
        if (dto.getSupportUpdateHistory() != null) {
            supportUpdateHistoryJson = objectMapper.valueToTree(dto.getSupportUpdateHistory());
        }
    } catch (Exception e) {
        throw new ValidationException("Failed to serialize Support update history / Intervention history fields", e);
    }

    return SurroundInsightsEntity.builder()
            .trackingId(trackingId)
            .surroundSubscriptionTier(dto.getSurroundSubscriptionTier())
            .senseawareMobile(dto.getSenseAwareMobile())
            .weatherImpacted(dto.getWeatherImpacted())
            .surroundDeliveryPrediction(dto.getSurroundDeliveryPrediction())
            .subStatus(dto.getSubStatus())
            .arrivalStatusCode(dto.getArrivalStatusCode())
            .surroundHcid(surroundInsightUtils.formatHealthcareIdentifier(dto))
            .interventionHistory(interventionHistoryJson)
            .supportUpdateHistory(supportUpdateHistoryJson)
            .build();
  }

  // Method to create TrackingPviCase entities
  private List<TrackingPviCasesEntity> createTrackingPviCases(ShipmentPackageTracking shipmentPackageTracking, UUID trackingId) {
    SurroundInsightsDTO surroundInsights = shipmentPackageTracking.getSurroundInsights();
    if (surroundInsights == null || surroundInsights.getCaseList() == null) {
      return List.of();
    }
    return surroundInsights.getCaseList().stream()
            .map(caseDto -> TrackingPviCasesEntity.builder()
                    .trackingId(trackingId)
                    .caseNumber(caseDto.getCaseNumber())
                    .caseType(caseDto.getCaseType())
                    .caseSubCategory(caseDto.getCaseSubCategory())
                    .caseStatus(caseDto.getCaseStatus())
                    .caseCreateTime(caseDto.getCaseCreateTime() != null && !caseDto.getCaseCreateTime().isEmpty() ?
                            OffsetDateTime.parse(caseDto.getCaseCreateTime(), DateTimeFormatter.ISO_OFFSET_DATE_TIME).toLocalDateTime() : null)
                    .caseCloseTime(caseDto.getCaseCloseTime() != null && !caseDto.getCaseCloseTime().isEmpty() ?
                            OffsetDateTime.parse(caseDto.getCaseCloseTime(), DateTimeFormatter.ISO_OFFSET_DATE_TIME).toLocalDateTime() : null)
                    .build())
            .collect(Collectors.toList());
  }

  private void createTrackingEvent(
            ShipmentPackageTracking shipmentPackageTracking, TrackingEntity newTrackingEntity) {

    shipmentPackageTracking
        .getShipmentTrackingEventDtoList()
        .forEach(
            shipmentTrackingEventDto ->
                trackingEventRepository.save(
                    TrackingEventEntity.builder()
