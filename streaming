import com.cardinalhealth.advship.tracking.resource.database.repository.TrackingPodRepository;
import com.cardinalhealth.advship.tracking.resource.model.dto.common.TrackingPodDto;
import java.util.List;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.web.PageableDefault;
import org.springframework.http.HttpHeaders;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.util.CollectionUtils;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@PreAuthorize("isAuthenticated()")
@RequestMapping("/v1/api/tracking-pods")
@RequiredArgsConstructor
public class TrackingPodController {

  private final SpecificationBuilder specificationBuilder;
  private final TrackingPodRepository trackingPodRepository;

  @PostMapping("/customer/{customer-id}")
  public ResponseEntity<Page<TrackingPodDto>> search(
      @RequestHeader HttpHeaders httpHeaders,
      @PathVariable("customer-id") String customerId,
      @RequestBody List<TrackingPodDto> trackingPods,
      @PageableDefault(sort = "id") Pageable pageable) {
    if (CollectionUtils.isEmpty(trackingPods)) return ResponseEntity.ok(Page.empty());

    for (var trackingPod : trackingPods) {
      if (trackingPod == null || trackingPod.contentsAreNull()) {
        return ResponseEntity.badRequest().body(Page.empty());
      }
    }

    var specification =
        specificationBuilder
            .build(trackingPods.stream().map(TrackingPodDto::toEntity).toList())
            .and(
                (trackingPodRoot, query, cb) -> {
                  var trackingRoot = query.from(TrackingEntity.class);
                  var packageRoot = query.from(PackageEntity.class);
                  var shipmentRoot = query.from(ShipmentEntity.class);
                  return cb.and(
                      cb.equal(trackingPodRoot.get("trackingId"), trackingRoot.get("id")),
                      cb.equal(trackingRoot.get("packageId"), packageRoot.get("id")),
                      cb.equal(packageRoot.get("shipmentId"), shipmentRoot.get("id")),
                      cb.equal(shipmentRoot.get("customerId"), customerId));
                });

    return ResponseEntity.ok()
        .body(
            trackingPodRepository.findAll(specification, pageable).map(TrackingPodDto::fromEntity));
  }
}

