                    (w.created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/New_York') AS created_at_est
                FROM advship_tracking_resource.shipment w, weekly_range r
                WHERE (w.created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/New_York') >= r.start_ts
                  AND (w.created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/New_York') < r.end_ts
                  AND w.shipment_source = :source
            ),
            
            customers AS (
                SELECT DISTINCT customer_id, customer_name, carrier
                FROM weekly_data
            ),
            
            hours AS (
                SELECT generate_series(
                    (SELECT start_ts FROM weekly_range),
                    (SELECT end_ts FROM weekly_range) - interval '1 hour',
                    interval '1 hour'
                ) AS hour_ts
            ),
            
            base AS (
                SELECT
                    c.customer_id,
                    c.customer_name,
                    c.carrier,
                    h.hour_ts
                FROM customers c
                CROSS JOIN hours h
            ),
            
            actual AS (
                SELECT
                    customer_id,
                    carrier,
                    date_trunc('hour', created_at_est) AS hour_ts,
                    COUNT(*) AS cnt
                FROM weekly_data
                GROUP BY customer_id, carrier, date_trunc('hour', created_at_est)
            )
            
            SELECT
                b.customer_id,
                b.customer_name,
                to_char(b.hour_ts, 'YYYY-MM-DD') AS date,
                to_char(b.hour_ts, 'HH12:MI AM') AS time,
                COALESCE(a.cnt, 0) AS total,
                b.carrier as shipment_carrier_details
            FROM base b
            LEFT JOIN actual a
                ON b.customer_id = a.customer_id
               AND b.carrier = a.carrier
               AND b.hour_ts = a.hour_ts
            ORDER BY b.customer_id,b.hour_ts
            """;
