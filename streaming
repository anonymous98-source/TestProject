package com.cardinalhealth.advship.tracking.resource.service.facility.adapter;


import com.cardinalhealth.advship.tracking.resource.service.facility.dto.ActiveBillingGroupDto;
import com.cardinalhealth.advship.tracking.resource.service.facility.dto.CustomerEntityDto;
import com.cardinalhealth.advship.tracking.resource.service.facility.dto.CustomerHierarchyDto;
import com.cardinalhealth.advship.tracking.resource.service.facility.dto.FacilityDetailsDto;
import com.cardinalhealth.advship.tracking.resource.service.facility.dto.request.CustomerHierarchyRequestDto;
import com.cardinalhealth.advship.tracking.resource.service.facility.model.*;


import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

import static com.cardinalhealth.advship.tracking.resource.service.facility.model.EntityType.*;


public class CustomerAdapter {

  private CustomerAdapter()
  {
    //no code
  }
  public static UserCustomerProfile mapCustomerHierarchyDtoToCustomerProfile(
      CustomerHierarchyDto dto) {
    return UserCustomerProfile.builder()
        .customers(
            dto.getCustomers().stream()
                .collect(Collectors.toMap(CustomerEntityDto::getId,
                        CustomerAdapter::mapCustomerFromCustomerEntityDto)))
        .billingGroups(
            dto.getBillingGroups().entrySet().stream()
                    .map(entry -> {
                      entry.getValue().setId(entry.getKey());
                      return CustomerAdapter.mapBillingGroupFromActiveBillingGroupDto(entry.getValue());
                    })
                    .collect(Collectors.toMap(BillingGroup::getId, billingGroup -> billingGroup)))
        .facilities(
                dto.getFacilities().entrySet().stream()
                    .map(entry -> {
                      entry.getValue().setId(entry.getKey());
                      return CustomerAdapter.mapFacilityFromFacilityDetailsDto(entry.getValue());
                    })
                    .collect(Collectors.toMap(Facility::getId, facility -> facility)))
        .build();
  }

  public static void setFacilityCustomerIds(UserCustomerProfile userCustomerProfile) {
    userCustomerProfile.getFacilityList().forEach(facility -> facility.setCustomerId(
            userCustomerProfile.getBillingGroups().get(facility.getBillingGroupId()).getCustomerId()));
  }

  public static CustomerHierarchyRequestDto mapEntitiesToCustomerHierarchyRequest(
      List<Entity> entities) {
    return CustomerHierarchyRequestDto.builder()
        .customers(getIdsByEntityType(entities, CUSTOMER))
        .billingGroups(getIdsByEntityType(entities, BILLING_GROUP))
        .facilities(getIdsByEntityType(entities, FACILITY))
        .build();
  }


  private static Customer mapCustomerFromCustomerEntityDto(CustomerEntityDto dto) {
    return Customer.builder().id(dto.getId()).name(dto.getName()).build();
  }

  private static BillingGroup mapBillingGroupFromActiveBillingGroupDto(ActiveBillingGroupDto dto) {
    return BillingGroup.builder()
        .id(dto.getId())
        .billToName(dto.getBillToName())
        .email(dto.getEmail())
        .customerId(dto.getCustomerId())
        .primaryCarrierAccountNumber(dto.getPrimaryCarrierAccountNumber())
        .secondaryCarrierAccountNumber(dto.getSecondaryCarrierAccountNumbers())
        .sustainId(dto.getSustainId())
        .build();
  }

  private static Facility mapFacilityFromFacilityDetailsDto(FacilityDetailsDto dto) {
    return Facility.builder()
        .id(dto.getId())
        .facilityName(dto.getFacilityName())
        .address1(dto.getAddress1())
        .address2(dto.getAddress2())
        .address3("")
        .city(dto.getCity())
        .state(dto.getState())
        .country("United States")
        .zip(dto.getZip())
        .phone(dto.getPhone())
        .shipperNumber(dto.getShipperNumber())
        .billingGroupId(dto.getBillingGroupId())
        .customerId(dto.getCustomerId())
        .build();
  }

  private static List<UUID> getIdsByEntityType(List<Entity> entities, EntityType entityType) {
    return entities.stream()
        .filter(entity -> entityType.equals(entity.getType()))
        .map(Entity::getId)
        .toList();
  }
}

