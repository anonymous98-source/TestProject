    when(destinationAddress.getCity())
        .thenReturn("Mumbai");

    when(destinationAddress.getPostalCode())
        .thenReturn("400001");

    when(destinationAddress.getStateOrProvinceCode())
        .thenReturn("MH");

    when(destinationAddress.getCountryCode())
        .thenReturn("IN");

    // -------------------------------------------------------------------------
    // Estimated Delivery
    // -------------------------------------------------------------------------

    EstimatedDeliveryDateDTO estimatedDeliveryDate =
        mock(EstimatedDeliveryDateDTO.class, RETURNS_DEEP_STUBS);

    when(trackResult.getEstimatedDeliveryDate())
        .thenReturn(estimatedDeliveryDate);

    when(estimatedDeliveryDate.getRiskScore())
        .thenReturn("LOW");

    when(estimatedDeliveryDate.getConfidenceScore())
