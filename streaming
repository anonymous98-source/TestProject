    public TrackingPviCaseDto getPviCasesOrderByMostRecent(List<TrackingPviCaseProjection> pviCaseProjections,
                                                           Integer pviCaseCount, String timezone) {
        if (CollectionUtils.isEmpty(pviCaseProjections)) {
            return TrackingPviCaseDto.builder()
                    .pviCaseCount(pviCaseCount)
                    .caseNumber(List.of())
                    .caseStatuses(List.of())
                    .caseSubCategory(List.of())
                    .caseType(List.of())
                    .caseCreateTime(List.of())
                    .caseCloseTime(List.of())
                    .build();
        }
        // Sort projections by caseCreateTime DESC (most recent first)
        List<TrackingPviCaseProjection> sortedProjections = pviCaseProjections.stream()
                .filter(p -> p != null && p.getCaseCreateTime() != null)
                .sorted((p1, p2) -> p2.getCaseCreateTime().compareTo(p1.getCaseCreateTime()))
                .collect(Collectors.toList());

        List<String> caseNumbers = new ArrayList<>();
        List<String> caseStatuses = new ArrayList<>();
        List<String> caseSubCategories = new ArrayList<>();
        List<String> caseTypes = new ArrayList<>();
        List<LocalDateTime> caseCreateTimes = new ArrayList<>();
        List<LocalDateTime> caseCloseTimes = new ArrayList<>();

        sortedProjections.forEach( caseProjection -> {
                    if (caseProjection.getCaseNumber() != null) {
                        caseNumbers.add(caseProjection.getCaseNumber());
                    }

                    // Collect case statuses
                    if (caseProjection.getCaseStatus() != null ) {
                        caseStatuses.add(caseProjection.getCaseStatus());
                    }

                    // Collect case sub categories
                    if (caseProjection.getCaseSubCategory() != null ) {
                        caseSubCategories.add(caseProjection.getCaseSubCategory());
                    }

                    // Collect case types
                    if (caseProjection.getCaseType() != null ) {
                        caseTypes.add(caseProjection.getCaseType());
                    }
                    // Collect case create times with timezone conversion
                    if (caseProjection.getCaseCreateTime() != null) {
                        caseCreateTimes.add(
                                DateTimeUtil.convertUtcToUserTime(caseProjection.getCaseCreateTime(), timezone)
                        );
                    }

                    // Collect case close times with timezone conversion
                    if (caseProjection.getCaseCloseTime() != null) {
                        caseCloseTimes.add(
                                DateTimeUtil.convertUtcToUserTime(caseProjection.getCaseCloseTime(), timezone)
                        );
                    } else {
                        caseCloseTimes.add(null);
                    }

                }

        );

        return TrackingPviCaseDto.builder()
                .pviCaseCount(pviCaseCount)
                .caseNumber(caseNumbers)
                .caseStatuses(caseStatuses)
                .caseSubCategory(caseSubCategories)
                .caseType(caseTypes)
                .caseCreateTime(caseCreateTimes)
                .caseCloseTime(caseCloseTimes)
                .build();
    }

