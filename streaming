import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Slf4j
@Service
@RequiredArgsConstructor
public class SavedViewsReportsService {

  private final SavedViewsReportsRepository savedViewsReportsRepository;
  private final ReportScheduleRepository reportScheduleRepository;
  private final SavedViewsReportsCountGetter savedViewsReportsCountGetter;
  private final UserViewXrefService userViewXrefService;
  private final SpecificationBuilder specificationBuilder;

  @Transactional
  public SavedViewsReportsDto create(SavedViewsReportsDto dto) {
    var savedViewEntity = savedViewsReportsRepository.save(dto.toEntity());

    var xref = UserViewXrefDto.fromSavedViewsReports(savedViewEntity, dto);
    var savedXref = userViewXrefService.upsertUserViewXref(xref);

    return SavedViewsReportsDto.fromEntity(savedViewEntity, savedXref);
  }

  public List<SavedViewsReportsDto> get(SavedViewsReportsFilter viewFilter) {
    var entityFilter = viewFilter.toEntity();
    var view =
        savedViewsReportsRepository.findAll(
            specificationBuilder.build(viewFilter.includeNullFields(), entityFilter));

    /* Right now, we're always having the views return their reports and xrefs. This should probably be refactored
     * to having people call separate endpoints. Or have a new endpoint with a better name that joins them all together.
     * But for now, we're running up against the release, so this is what goes.
     */
    return view.stream()
        .map(
            e -> {
              /*
               * Reports and xrefs must be queried by userId in order to find a match. For custom views, the view has a
               * userId, so we can just use that.
               *
               * For standard views, the view has no userId. So we need to grab the userId from the filter.
               */
              var userId =
                  "standard".equalsIgnoreCase(e.getViewType())
                      ? viewFilter.userId()
                      : e.getUserId();
              var reports = reportScheduleRepository.findAllByViewIdAndUserId(e.getId(), userId);
              var xref = userViewXrefService.get(e.getId(), userId);
              return SavedViewsReportsDto.fromEntity(e, reports, xref);
            })
        .toList();
  }

  public List<SavedViewsReportsDto> get(
      SavedViewsReportsFilter viewFilter, CountCriteria countCriteria) {
    var views = get(viewFilter);

    var userId = viewFilter.userId();

    if (userId == null) {
      var distinctUserIds =
          views.stream()
              .map(SavedViewsReportsDto::getUserId)
              .filter(Objects::nonNull)
              .distinct()
              .toList();

      if (distinctUserIds.isEmpty()) {
        throw new ValidationException("UserId is required for count criteria");
      } else if (distinctUserIds.size() > 1) {
        throw new ValidationException("Multiple userIds found for views. UserId must be specified");
      }
      userId = distinctUserIds.get(0);
    }

    return savedViewsReportsCountGetter.addRecordCounts(views, countCriteria, userId);
  }

  @Transactional
  public SavedViewsReportsDto update(SavedViewsReportsDto dto) {
    var existing =
        savedViewsReportsRepository
            .findById(dto.getId())
            .orElseThrow(
                () ->
                    new ResourceNotFoundException(
                        "SavedViewReport not found for id: " + dto.getId()));

    return update(dto, existing);
  }

  @Transactional
  public SavedViewsReportsDto upsert(SavedViewsReportsDto dto) {
    if (dto.getId() == null) return create(dto);

    var viewExisting = savedViewsReportsRepository.findById(dto.getId());

    return viewExisting.isPresent() ? update(dto, viewExisting.get()) : create(dto);
  }

  /**
   * The main point of this method versus calling upsert(dto) over a list is to keep everything in
   * one @Transactional. That way everything rolls back if something fails.
   */
  @Transactional
  public List<SavedViewsReportsDto> upsert(List<SavedViewsReportsDto> dtos) {
    return dtos.stream().map(this::upsert).toList();
  }

  @Transactional
  public void deleteById(UUID id) {
    if (!savedViewsReportsRepository.existsById(id)) {
      throw new ResourceNotFoundException(SAVED_VIEW_REPORT_NOT_FOUND_FOR_ID + id);
    }
    log.info(DELETE_SAVED_VIEW_REPORT_FOR_ID, id);
    savedViewsReportsRepository.deleteById(id);
  }

  public SavedViewReportResponse getCurrentHourSchedules(int currentPage, int pageSize) {
    var pageable = Pageable.ofSize(pageSize).withPage(currentPage);
    Page<String> scheduleIdsPage = savedViewsReportsRepository.findMatchingScheduleIds(pageable);
    if (scheduleIdsPage.isEmpty()) {
      var empty = new SavedViewReportResponse();
      empty.setContent(List.of());
      empty.setLast(scheduleIdsPage.isLast());
      empty.setTotalElements(scheduleIdsPage.getTotalElements());
      empty.setTotalPages(scheduleIdsPage.getTotalPages());
      empty.setPageNumber(scheduleIdsPage.getNumber());
      empty.setPageSize(scheduleIdsPage.getSize());
      return empty;
    }

    List<UUID> scheduleIds =
        scheduleIdsPage.getContent().stream()
            .map(
                id -> {
                  if (id == null)
                    throw new IllegalStateException("Received null schedule ID from repository");
                  return UUID.fromString(id);
                })
            .toList();

    var matchingSchedules = reportScheduleRepository.findAllById(scheduleIds);
    var schedulesById =
        matchingSchedules.stream()
            .collect(Collectors.toMap(ReportScheduleEntity::getId, Function.identity()));

    var views = savedViewsReportsRepository.findViewsByScheduleIds(scheduleIds);
    var viewsById =
        views.stream()
            .collect(Collectors.toMap(SavedViewsReportsEntity::getId, Function.identity()));

    var content =
        scheduleIds.stream()
            .map(
                id -> {
                  var schedule = schedulesById.get(id);
                  if (schedule == null) return null;
                  var view = viewsById.get(schedule.getViewId());
                  if (view == null) return null;
                  return SavedViewsReportsDto.fromEntity(view, List.of(schedule), null);
                })
            .filter(Objects::nonNull)
            .toList();

    var response = new SavedViewReportResponse();
    response.setContent(content);
    response.setLast(scheduleIdsPage.isLast());
    response.setTotalElements(scheduleIdsPage.getTotalElements());
    response.setTotalPages(scheduleIdsPage.getTotalPages());
    response.setPageNumber(scheduleIdsPage.getNumber());
    response.setPageSize(scheduleIdsPage.getSize());
    return response;
  }

  private SavedViewsReportsDto update(SavedViewsReportsDto dto, SavedViewsReportsEntity existing) {
    var savedView = existing;

    // nobody is allowed to update standard views...
    if (!"standard".equalsIgnoreCase(dto.getViewType())) {
      existing.updateFromDto(dto);
      savedView = savedViewsReportsRepository.save(existing);
    }

    // ...but users can have xrefs pointing to any view, including standard views
    var xref = UserViewXrefDto.fromSavedViewsReports(savedView, dto);
    var savedXref = userViewXrefService.upsertUserViewXref(xref);

    // we're returning the report_schedule info with the view. so we need to get it
    var reports =
        reportScheduleRepository.findAllByViewIdAndUserId(savedView.getId(), savedView.getUserId());

    return SavedViewsReportsDto.fromEntity(savedView, reports, savedXref);
  }
}

