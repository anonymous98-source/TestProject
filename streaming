import org.springframework.stereotype.Service;

@Slf4j
@Service
@RequiredArgsConstructor
public class MessagingService {
  private static final Logger LOGGER = LoggerFactory.getLogger(MessagingService.class);
  private final TemplateEngineService templateEngineService;
  private final DataPublisherService dataPublisherService;

  @Value("${sftp-credentials-alert.subject}")
  private String subject;

  @Value("${sftp-credentials-alert.from}")
  private String optiFromAddress;

  @Value("${sftp-credentials-alert.to}")
  private String optiToAddress;

  public ResponseEntity<Void> sendNotification(
      MessageInfo messageInfo, SftpCredentialsAlertDTO sftpCredentialsAlertDTO) {
    Map<String, Object> context = buildSftpCredentialsAlertEmailContext(sftpCredentialsAlertDTO);
    String body = templateEngineService.processTemplate("sftp-credentials-alert", context);
    var message =
        new MessageInfo(
            MessageType.EMAIL,
            MessageFormat.format(subject, sftpCredentialsAlertDTO.getAction()),
            optiFromAddress,
            optiToAddress,
            body,
            null);
    dataPublisherService.sendEmail(message);
    LOGGER.info("Notification email sent to: {}", messageInfo.getTo());
    return ResponseEntity.ok().build();
  }

  public Map<String, Object> buildSftpCredentialsAlertEmailContext(
      SftpCredentialsAlertDTO sftpCredentialsAlertDTO) {
    Map<String, Object> context = new HashMap<>();
    context.put("environment", sftpCredentialsAlertDTO.getEnvironment());
    context.put("action", sftpCredentialsAlertDTO.getAction());
    context.put("customerId", sftpCredentialsAlertDTO.getCustomerId());
    context.put("sftpUserName", sftpCredentialsAlertDTO.getSftpUserName());
    context.put("path", sftpCredentialsAlertDTO.getPath());
    context.put("sftpHost", sftpCredentialsAlertDTO.getSftpHost());
    context.put("sftpPort", sftpCredentialsAlertDTO.getSftpPort());
    return context;
  }
}

