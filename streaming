package com.cardinalhealth.advship.tracking.resource.service.wrapper;

import com.cardinalhealth.advship.tracking.resource.exception.ValidationException;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.csv.CSVFormat;
import org.apache.commons.csv.CSVPrinter;
import org.apache.commons.csv.QuoteMode;

import java.io.IOException;
import java.io.Writer;
import java.lang.reflect.Field;
import java.lang.reflect.Modifier;
import java.util.ArrayList;
import java.util.List;


@Slf4j
public class CsvGenerator<T> {

    private final Class<T> dtoClass;
    private final List<String> headers;

    public CsvGenerator(Class<T> dtoClass, Field[] values) {
        this.dtoClass = dtoClass;
        this.headers = extractHeaders(values);
    }

    public void writeHeader(CSVPrinter printer) throws IOException {
        printer.printRecord(headers);
        printer.flush();
    }


    public void writeRows(List<T> dtoList, CSVPrinter printer) throws IOException {

        for (T dto : dtoList) {
            printer.printRecord(extractValues(dto));
        }
        printer.flush();
    }

    public CSVPrinter createPrinter(Writer writer) throws IOException {

        return new CSVPrinter(writer, getCsvFormat());
    }

    private CSVFormat getCsvFormat() {
        return CSVFormat.Builder.create()
                .setQuoteMode(QuoteMode.MINIMAL)
                .setRecordSeparator("\r\n")
                //.setHeader(headers.toArray(new String[0]))
                .build();
    }

    private List<String> extractHeaders(Field[] values) {
        return getAllHeaders(values);
    }

    private List<Object> extractValues(T dto) {
        List<Object> values = new ArrayList<>();
        for (Field field : dtoClass.getDeclaredFields()) {
            field.setAccessible(true);
            try{
                Object value = field.get(dto);
                values.add(value == null ? "" : value.toString());
            } catch (IllegalAccessException iae) {
                throw new ValidationException("Failed to access field name : " + field.getName() + iae);
            }
        }
        return values;
    }
    public List<String> getAllHeaders(Field[] values) {
        List<String> finalHeaders = new ArrayList<>();
        Field[] fields = values;

        for (Field field : fields) {
            int modifiers = field.getModifiers();
            if (Modifier.isPublic(modifiers) &&
                    Modifier.isStatic(modifiers) &&
                    Modifier.isFinal(modifiers) &&
                    field.getType().equals(String.class)) {
                try {
                    finalHeaders.add((String) field.get(null)); // Get the value of the constant of static type
                } catch (IllegalAccessException e) {
                    log.error("Failed to access field name : {}", field.getName(), e);
                }
            }
        }

        return finalHeaders;
    }
}

