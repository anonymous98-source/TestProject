@RestController
@RequestMapping("/v1/visualization")
@PreAuthorize("isAuthenticated()")
@Slf4j
@RequiredArgsConstructor
@Validated
public class VisualizationController {

  private final GraphVisualizationService graphVisualizationService;
  private final VisualizationDropDownService visualizationDropDownService;
  private final MaterializedViewRefreshService materializedViewRefreshService;

  @PostMapping("/graph-data")
  public ResponseEntity<DashboardGenericResponseDto> getGraphData(
      @RequestBody @Valid GraphDataRequestDto graphDataRequestDto,
      @RequestHeader HttpHeaders httpHeaders) {
    log.atInfo(
        )
            .setMessage(
                "Received request to fetch graph data with parameters: " + graphDataRequestDto)
            .log();

    return ResponseEntity.ok(graphVisualizationService.fetchGraphData(graphDataRequestDto));
  }

  @PostMapping("/dropdown")
  public ResponseEntity<DropDownDataResponseDto> getProductivityData(
      @RequestBody @Valid DropDownDataRequestDto dropDownDataRequestDto) {
    log.atInfo(
        )
            .setMessage(
                "Received request to fetch Visualization DropDown data with parameters: "
                    + dropDownDataRequestDto)
            .log();

    return ResponseEntity.ok(
        visualizationDropDownService.fetchShipmentServiceData(dropDownDataRequestDto));
  }

  @PostMapping("/materialized-view/refresh")
  public ResponseEntity<MVRefreshResponseDto> refreshMaterializedViews(
      @RequestParam(name = "viewName", required = false) List<@NotBlank String> viewNames,
      @RequestHeader HttpHeaders httpHeaders) {

    log.atInfo(
        )
            .setMessage("Received request to refresh materialized views: " + viewNames)
            .log();
    var response = materializedViewRefreshService.refreshMaterializedViews(viewNames);
    return new ResponseEntity<>(response, response.getHttpStatus());
  }
}

