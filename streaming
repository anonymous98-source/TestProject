public class AlterTrackingServiceImpl implements AlterTrackingService {
    private final TrackingRepository trackingRepository;

    public AlterTrackingServiceImpl(TrackingRepository trackingRepository) {
        this.trackingRepository = trackingRepository;
    }

    @Override
    public TrackingResourceResponse saveTrackingResourceData(TrackingResourceRequest trackingResourceRequest, OflUserDetailsDTO oflUserDetailsDTO) throws TrackingResourceException {
       try{
        SaveShipmentRequest saveShipmentRequest = (SaveShipmentRequest) trackingResourceRequest;
        ShipmentDto shipmentDto = saveShipmentRequest.getShipmentDto();
        List<TrackingDto> trackingDtos=shipmentDto.getPackages().stream().map(PackageDto::getTracking).toList();
        updateTracking(trackingDtos);

           return GenericResponse.builder()
                   .aspectName(UPDATE_TRACKING)
                   .message("saved")
                   .status("200")
                   .build();

       } catch (Exception e) {
           throw new ResourceNotFoundException(e.getMessage(),e);
       }
    }
    public void updateTracking(List<TrackingDto> trackingDtos)
    {   List<TrackingEntity> trackingEntities = new ArrayList<>();
        for(TrackingDto trackingDto:trackingDtos){
            TrackingEntity trackingEntity =trackingRepository.findTrackingById(trackingDto.getId());
            trackingEntity.setTrackingNumberUpdatedOnEpic(trackingDto.getTrackingNumberUpdatedOnEpic());
            trackingEntities.add(trackingEntity);
        }
        if(!trackingEntities.isEmpty()){
            trackingRepository.saveAll(trackingEntities);
        }
    }
}

