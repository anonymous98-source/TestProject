package com.dto.comparator.matcher;

import com.dto.comparator.model.DtoMatch;
import com.dto.comparator.model.DtoModel;
import com.dto.comparator.model.FieldModel;
import com.dto.comparator.model.MatchStatus;

import java.util.*;
import java.util.concurrent.*;
import java.util.stream.Collectors;

public class DtoMatcher {

    private static final double HIGH_THRESHOLD = 0.90;

    private static final double POSSIBLE_THRESHOLD = 0.80;

    private final ExecutorService executor;

    public DtoMatcher() {

        int processors =
                Runtime.getRuntime().availableProcessors();

        int threadCount =
                Math.max(2, processors);

        executor =
                Executors.newFixedThreadPool(
                        threadCount
                );
    }

    /**
     * Compare DTOs belonging to two applications.
     */
    public List<DtoMatch> compare(
            String app1,
            List<DtoModel> dtos1,
            String app2,
            List<DtoModel> dtos2) {

        /*
         * Index application 2 DTOs by field count.
         *
         * This avoids comparing every DTO against
         * completely unrelated DTOs.
         */
        Map<Integer, List<DtoModel>> index =
                dtos2.stream()
                        .collect(
                                Collectors.groupingBy(
                                        DtoModel::fieldCount
                                )
                        );

        List<CompletableFuture<DtoMatch>> futures =
                dtos1.stream()
                        .map(dto ->
                                CompletableFuture.supplyAsync(
                                        () ->
                                                findBestMatch(
                                                        app1,
                                                        dto,
                                                        app2,
                                                        index
                                                ),
                                        executor
                                )
                        )
                        .toList();

        return futures.stream()
                .map(CompletableFuture::join)
                .filter(Objects::nonNull)
                .sorted(
                        Comparator.comparing(
                                DtoMatch::similarity
                        ).reversed()
                )
                .toList();
    }

    private DtoMatch findBestMatch(
            String app1,
            DtoModel source,
            String app2,
            Map<Integer, List<DtoModel>> index) {

        List<DtoModel> candidates =
                new ArrayList<>();

        /*
         * If source has 5 fields, consider DTOs
         * with 4, 5 or 6 fields.
         *
         * This significantly reduces comparisons.
         */
        int minFields =
                Math.max(
                        0,
                        source.fieldCount() - 1
                );

        int maxFields =
                source.fieldCount() + 1;

        for (int count = minFields;
             count <= maxFields;
             count++) {

            candidates.addAll(
                    index.getOrDefault(
                            count,
                            List.of()
                    )
            );
        }

        if (candidates.isEmpty()) {
            return null;
        }

        return candidates.stream()
                .map(candidate ->
                        calculateSimilarity(
                                app1,
                                source,
                                app2,
                                candidate
                        )
                )
                .filter(match ->
                        match.similarity()
                                >= POSSIBLE_THRESHOLD
                )
                .max(
                        Comparator.comparing(
                                DtoMatch::similarity
                        )
                )
                .orElse(null);
    }

    private DtoMatch calculateSimilarity(
            String app1,
            DtoModel dto1,
            String app2,
            DtoModel dto2) {

        Map<String, String> fields1 =
                toFieldMap(dto1);

        Map<String, String> fields2 =
                toFieldMap(dto2);

        Set<String> names1 =
                fields1.keySet();

        Set<String> names2 =
                fields2.keySet();

        Set<String> commonNames =
                new HashSet<>(names1);

        commonNames.retainAll(names2);

        Set<String> union =
                new HashSet<>(names1);

        union.addAll(names2);

        double fieldScore =
                union.isEmpty()
                        ? 1.0
                        : (double) commonNames.size()
                        / union.size();

        int matchingTypes = 0;

        Set<String> differentTypes =
                new TreeSet<>();

        for (String fieldName :
                commonNames) {

            String type1 =
                    fields1.get(fieldName);

            String type2 =
                    fields2.get(fieldName);

            if (Objects.equals(type1, type2)) {

                matchingTypes++;

            } else {

                differentTypes.add(
                        fieldName
                                + ": "
                                + type1
                                + " vs "
                                + type2
                );
            }
        }

        double typeScore =
                commonNames.isEmpty()
                        ? 0
                        : (double) matchingTypes
                        / commonNames.size();

        /*
         * Class name has only 10% weight.
         *
         * Fields are much more important.
         */
        double nameScore =
                calculateNameSimilarity(
                        dto1.className(),
                        dto2.className()
                );

        double finalScore =
                (fieldScore * 0.60)
                        +
                        (typeScore * 0.30)
                        +
                        (nameScore * 0.10);

        Set<FieldModel> commonFields =
                new TreeSet<>(
                        Comparator
                                .comparing(FieldModel::name)
                );

        Set<FieldModel> onlyInDto1 =
                new TreeSet<>(
                        Comparator
                                .comparing(FieldModel::name)
                );

        Set<FieldModel> onlyInDto2 =
                new TreeSet<>(
                        Comparator
                                .comparing(FieldModel::name)
                );

        for (FieldModel field :
                dto1.fields()) {

            if (fields2.containsKey(field.name())
                    && Objects.equals(
                    field.type(),
                    fields2.get(field.name()))) {

                commonFields.add(field);

            } else {

                onlyInDto1.add(field);
            }
        }

        for (FieldModel field :
                dto2.fields()) {

            if (!fields1.containsKey(field.name())
                    || !Objects.equals(
                    field.type(),
                    fields1.get(field.name()))) {

                onlyInDto2.add(field);
            }
        }

        MatchStatus status =
                determineStatus(finalScore);

        return new DtoMatch(
                app1,
                app2,
                dto1,
                dto2,
                finalScore,
                status,
                commonFields,
                onlyInDto1,
                onlyInDto2,
                differentTypes
        );
    }

    private MatchStatus determineStatus(
            double score) {

        if (score >= 0.999999) {
            return MatchStatus.EXACT_MATCH;
        }

        if (score >= HIGH_THRESHOLD) {
            return MatchStatus.HIGH_SIMILARITY;
        }

        return MatchStatus.POSSIBLE_MATCH;
    }

    private Map<String, String> toFieldMap(
            DtoModel dto) {

        return dto.fields()
                .stream()
                .collect(
                        Collectors.toMap(
                                FieldModel::name,
                                FieldModel::type
                        )
                );
    }

    private double calculateNameSimilarity(
            String name1,
            String name2) {

        String a =
                normalizeClassName(name1);

        String b =
                normalizeClassName(name2);

        if (a.equals(b)) {
            return 1.0;
        }

        int distance =
                levenshtein(a, b);

        int max =
                Math.max(
                        a.length(),
                        b.length()
                );

        if (max == 0) {
            return 1.0;
        }

        return 1.0 -
                ((double) distance / max);
    }

    private String normalizeClassName(
            String name) {

        return name
                .toLowerCase()
                .replace("dto", "")
                .replace("request", "")
                .replace("response", "")
                .replace("model", "");
    }

    private int levenshtein(
            String a,
            String b) {

        int[][] dp =
                new int[a.length() + 1]
                        [b.length() + 1];

        for (int i = 0;
             i <= a.length();
             i++) {

            dp[i][0] = i;
        }

        for (int j = 0;
             j <= b.length();
             j++) {

            dp[0][j] = j;
        }

        for (int i = 1;
             i <= a.length();
             i++) {

            for (int j = 1;
                 j <= b.length();
                 j++) {

                int cost =
                        a.charAt(i - 1)
                                == b.charAt(j - 1)
                                ? 0
                                : 1;

                dp[i][j] =
                        Math.min(
                                Math.min(
                                        dp[i - 1][j] + 1,
                                        dp[i][j - 1] + 1
                                ),
                                dp[i - 1][j - 1]
                                        + cost
                        );
            }
        }

        return dp[a.length()][b.length()];
    }

    public void shutdown() {

        executor.shutdown();

        try {

            if (!executor.awaitTermination(
                    10,
                    TimeUnit.SECONDS)) {

                executor.shutdownNow();
            }

        } catch (InterruptedException e) {

            executor.shutdownNow();

            Thread.currentThread().interrupt();
        }
    }
}


