    public void write(
            Path outputFile,
            List<DtoMatch> matches,
            List<DtoModel> dtos1,
            List<DtoModel> dtos2)
            throws IOException {

        try (Workbook workbook =
                     new XSSFWorkbook()) {

            createSummarySheet(
                    workbook,
                    matches,
                    dtos1,
                    dtos2
            );

            createMatchesSheet(
                    workbook,
                    matches
            );

            createUnmatchedSheet(
                    workbook,
                    "Only Directory 1",
                    dtos1,
                    matches,
                    true
            );

            createUnmatchedSheet(
                    workbook,
                    "Only Directory 2",
                    dtos2,
                    matches,
                    false
            );

            try (FileOutputStream output =
                         new FileOutputStream(
                                 outputFile.toFile()
                         )) {

                workbook.write(output);
            }
        }
