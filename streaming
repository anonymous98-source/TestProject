2. search-autocomplete.component.ts

You need 3 changes here.

Change 1 — Add isOptionDisabled()

Put this method near isSelected():

isOptionDisabled(option: any): boolean {
  return (
    this.searchPlaceholder() === AddPanelType.Location &&
    option?.active === false
  );
}

This means:

Customer → never disabled based on active

Billing Group → never disabled based on active

Location + active: true → enabled

Location + active: false → disabled



---

Change 2 — Protect onOptionSelected()

Replace your current:

onOptionSelected(event: MatAutocompleteSelectedEvent): void {
  const selectedEntry = event.option.value;
  const current = this.control.value || [];
  if (!current.some((item) => item.id === selectedEntry.id)) {
    this.control.setValue([...current, selectedEntry]);
  }
  this.searchInputControl.setValue('');
}

with:

onOptionSelected(event: MatAutocompleteSelectedEvent): void {
  const selectedEntry = event.option.value;

  if (this.isOptionDisabled(selectedEntry)) {
    return;
  }

  const current = this.control.value || [];

  if (!current.some((item) => item.id === selectedEntry.id)) {
    this.control.setValue([...current, selectedEntry]);
  }

  this.searchInputControl.setValue('');
}


---

Change 3 — Protect toggleSelection()

Replace:

toggleSelection(option: any) {
  const current = this.control.value || [];
  if (this.isSelected(option)) {
    this.control.setValue(current.filter((item) => item.id !== option.id));
  } else {
    this.control.setValue([...current, option]);
  }
}

with:

toggleSelection(option: any): void {
  if (this.isOptionDisabled(option)) {
    return;
  }

  const current = this.control.value || [];

  if (this.isSelected(option)) {
    this.control.setValue(
      current.filter((item) => item.id !== option.id)
    );
  } else {
    this.control.setValue([...current, option]);
  }
}


