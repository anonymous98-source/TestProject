  /**
   * Calls the private mapCustomerBillingGroupData method.
   *
   * Reflection is intentionally kept here because this private method has
   * several independent branches which are easiest to cover directly.
   */
  private void invokeMapCustomerBillingGroupData(
      TrackingEventDTO event,
      List<CustomerBillingGroupDetailsDTO> billingGroups) {

    try {
      var method =
          TrackingWebhookFedexPublisher.class.getDeclaredMethod(
              "mapCustomerBillingGroupData",
              TrackingEventDTO.class,
              List.class);

      method.setAccessible(true);
      method.invoke(subject, event, billingGroups);

    } catch (Exception e) {
      throw new AssertionError(
          "Unable to invoke mapCustomerBillingGroupData", e);
    }
  }
