                .map(entity -> {
                    log.atInfo().setMessage("Reason code found: " + code).log();
                    return mapToResponse(entity);
                })
                .orElseGet(() -> {
                    log.atInfo().setMessage("Reason code not found: " + code).log();
                    CmsReasonCodeDtoResponse response = new CmsReasonCodeDtoResponse();
