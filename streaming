  private TrackingFedexDTO createCompleteFedexDto() {

    /*
     * RETURNS_DEEP_STUBS is intentional here.
     *
     * It allows:
     *
     * trackResult.getBillToParties()
     *     .get(0)
     *     .getBillToParty()
     *     .getAccountNumber()
     *
     * without having to manually construct the BillToParty hierarchy.
