package com.dto.comparator.report;

import com.dto.comparator.model.DtoMatch;
import com.dto.comparator.model.DtoModel;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.FileOutputStream;
import java.io.IOException;
import java.nio.file.Path;
import java.util.*;
import java.util.stream.Collectors;

public class ExcelReportWriter {

    public void write(
            Path outputFile,
            List<DtoMatch> matches,
            List<DtoModel> allDtos)
            throws IOException {

        try (Workbook workbook =
                     new XSSFWorkbook()) {

            createSummarySheet(
                    workbook,
                    matches,
                    allDtos
            );

            createMatchesSheet(
                    workbook,
                    matches
            );

            try (FileOutputStream output =
                         new FileOutputStream(
                                 outputFile.toFile()
                         )) {

                workbook.write(output);
            }
        }
    }

    private void createSummarySheet(
            Workbook workbook,
            List<DtoMatch> matches,
            List<DtoModel> allDtos) {

        Sheet sheet =
                workbook.createSheet("Summary");

        Row header =
                sheet.createRow(0);

        header.createCell(0)
                .setCellValue("Metric");

        header.createCell(1)
                .setCellValue("Value");

        int row = 1;

        row(sheet, row++,
                "Total DTOs",
                allDtos.size());

        row(sheet, row++,
                "Total Matches",
                matches.size());

        long exact =
                matches.stream()
                        .filter(m ->
                                m.status().name()
                                        .equals(
                                                "EXACT_MATCH"
                                        ))
                        .count();

        long high =
                matches.stream()
                        .filter(m ->
                                m.status().name()
                                        .equals(
                                                "HIGH_SIMILARITY"
                                        ))
                        .count();

        long possible =
                matches.stream()
                        .filter(m ->
                                m.status().name()
                                        .equals(
                                                "POSSIBLE_MATCH"
                                        ))
                        .count();

        row(sheet, row++,
                "Exact Matches",
                exact);

        row(sheet, row++,
                "High Similarity",
                high);

        row(sheet, row++,
                "Possible Matches",
                possible);

        autoSize(
                sheet,
                2
        );
    }

    private void createMatchesSheet(
            Workbook workbook,
            List<DtoMatch> matches) {

        Sheet sheet =
                workbook.createSheet("DTO Matches");

        String[] headers = {

                "APP 1",
                "APP 2",

                "STATUS",

                "DTO 1",
                "DTO 2",

                "SIMILARITY",

                "DTO 1 FILE",
                "DTO 2 FILE",

                "COMMON FIELDS",

                "ONLY IN APP 1",

                "ONLY IN APP 2",

                "DIFFERENT TYPES"
        };

        createHeader(
                sheet,
                headers
        );

        int rowIndex = 1;

        for (DtoMatch match :
                matches) {

            Row row =
                    sheet.createRow(
                            rowIndex++
                    );

            /*
             * IMPORTANT:
             *
             * App names are the FIRST columns.
             */
            row.createCell(0)
                    .setCellValue(
                            match.app1()
                    );

            row.createCell(1)
                    .setCellValue(
                            match.app2()
                    );

            row.createCell(2)
                    .setCellValue(
                            match.status().name()
                    );

            row.createCell(3)
                    .setCellValue(
                            match.dto1()
                                    .className()
                    );

            row.createCell(4)
                    .setCellValue(
                            match.dto2()
                                    .className()
                    );

            row.createCell(5)
                    .setCellValue(
                            match.similarity()
                    );

            row.createCell(6)
                    .setCellValue(
                            match.dto1()
                                    .sourceFile()
                                    .toString()
                    );

            row.createCell(7)
                    .setCellValue(
                            match.dto2()
                                    .sourceFile()
                                    .toString()
                    );

            row.createCell(8)
                    .setCellValue(
                            formatFields(
                                    match.commonFields()
                            )
                    );

            row.createCell(9)
                    .setCellValue(
                            formatFields(
                                    match.onlyInDto1()
                            )
                    );

            row.createCell(10)
                    .setCellValue(
                            formatFields(
                                    match.onlyInDto2()
                            )
                    );

            row.createCell(11)
                    .setCellValue(
                            String.join(
                                    " | ",
                                    match.differentTypes()
                            )
                    );

            CellStyle percentageStyle =
                    workbook.createCellStyle();

            percentageStyle.setDataFormat(
                    workbook
                            .getCreationHelper()
                            .createDataFormat()
                            .getFormat(
                                    "0.00%"
                            )
            );

            row.getCell(5)
                    .setCellStyle(
                            percentageStyle
                    );
        }

        sheet.createFreezePane(
                0,
                1
        );

        sheet.setAutoFilter(
                new org.apache.poi.ss.util.CellRangeAddress(
                        0,
                        Math.max(
                                0,
                                matches.size()
                        ),
                        0,
                        headers.length - 1
                )
        );

        autoSize(
                sheet,
                headers.length
        );
    }

    private void createHeader(
            Sheet sheet,
            String[] headers) {

        Row row =
                sheet.createRow(0);

        for (int i = 0;
             i < headers.length;
             i++) {

            row.createCell(i)
                    .setCellValue(
                            headers[i]
                    );
        }
    }

    private void row(
            Sheet sheet,
            int rowNumber,
            String metric,
            Object value) {

        Row row =
                sheet.createRow(
                        rowNumber
                );

        row.createCell(0)
                .setCellValue(
                        metric
                );

        row.createCell(1)
                .setCellValue(
                        String.valueOf(value)
                );
    }

    private String formatFields(
            Set<?> fields) {

        return fields.stream()
                .map(Object::toString)
                .sorted()
                .collect(
                        Collectors.joining(
                                " | "
                        )
                );
    }

    private void autoSize(
            Sheet sheet,
            int columns) {

        for (int i = 0;
             i < columns;
             i++) {

            try {

                sheet.autoSizeColumn(i);

            } catch (Exception ignored) {
                // Ignore column sizing issues
            }
        }
    }
}


