        OflUserDetailsDTO oflUserDetailsDTO = buildUserDetailsForTrackingDetails(trackingResourceRequest, httpHeaders);
        TrackingDetailsResponsePage trackingResourceResponse = (TrackingDetailsResponsePage)
                dataServiceFactory.getGenericService(ModelConstants.TRACKING_DETAILS).saveTrackingResourceData(trackingResourceRequest, oflUserDetailsDTO);
        return TrackingDetailsListResponsePage.builder()
                .pageNumber(trackingResourceResponse.getPageNumber())
                .pageSize(trackingResourceResponse.getPageSize())
                .last(trackingResourceResponse.getResult().isLast())
                .totalElements(trackingResourceResponse.getResult().getTotalElements())
                .result(trackingResourceResponse.getResult().stream().toList())
                .build();
    }



    @PostMapping("/pricing")
    public TrackingResourceResponse persistPricing(@RequestParam(value = "aspectName")
                                                           String aspectName,
                                                           @RequestBody TrackingResourceRequest trackingResourceRequest,
                                                           @RequestHeader HttpHeaders httpHeaders) throws TrackingResourceException {

        log.atInfo()
                .setMessage("Request arrived with aspectName : " + aspectName)
                .log();
        checkNull(aspectName);
        OflUserDetailsDTO oflUserDetailsDTO = commonService.getUserDetailsFromHeader(httpHeaders);
        TrackingResourceResponse trackingResourceResponse = dataServiceFactory.getGenericService(aspectName).saveTrackingResourceData(trackingResourceRequest, oflUserDetailsDTO);
        log.atInfo()
                .setMessage(DATA_TRACKING_LOG + aspectName)
                .log();

        return trackingResourceResponse;
    }


    @GetMapping("/entities")
    public TrackingResourceResponse getTrackingResource(@RequestParam(value = "aspectName")
                                                        String aspectName,
                                                        @RequestHeader HttpHeaders httpHeaders) throws TrackingResourceException {

        log.atInfo()
                .setMessage("Request arrived for get all filters.")
                .log();
        checkNull(aspectName);
        OflUserDetailsDTO oflUserDetailsDTO = commonService.getUserDetailsFromHeader(httpHeaders);
        TrackingResourceResponse filters = dataServiceFactory.getGettableService(aspectName).getTrackingResourceData(aspectName, oflUserDetailsDTO);

        log.atInfo()
                .setMessage("Get all filters response: " + filters)
                .log();
        return filters;

    }

    @PutMapping("/entities")
    public TrackingResourceResponse updateTrackingResource(@RequestParam(value = "aspectName") String aspectName,
                                                           @RequestBody TrackingResourceRequest trackingResourceRequest,
                                                           @RequestHeader HttpHeaders httpHeaders) throws TrackingResourceException {

        log.atInfo()
                .setMessage("Update request arrived with aspectName : " + aspectName)
                .log();

        checkNull(aspectName);
        OflUserDetailsDTO oflUserDetailsDTO = commonService.getUserDetailsFromHeader(httpHeaders);
        TrackingResourceResponse trackingResourceResponse = dataServiceFactory
                .getUpdateService(aspectName)
                .updateTrackingResource(trackingResourceRequest, oflUserDetailsDTO);

        log.atInfo()
                .setMessage(DATA_TRACKING_LOG + aspectName)
                .log();

        return trackingResourceResponse;
    }

    @DeleteMapping("/entities")
    public TrackingResourceResponse deleteTrackingResource(@RequestParam(value = "aspectName") String aspectName,
                                                           @RequestBody TrackingResourceRequest trackingResourceRequest,
                                                           @RequestHeader HttpHeaders httpHeaders) throws TrackingResourceException {

        log.atInfo()
                .setMessage("Delete request arrived with aspectName : " + aspectName)
                .log();

        checkNull(aspectName);
        OflUserDetailsDTO oflUserDetailsDTO = commonService.getUserDetailsFromHeader(httpHeaders);
        TrackingResourceResponse trackingResourceResponse = dataServiceFactory
                .getDeleteService(aspectName)
                .deleteTrackingResource(trackingResourceRequest, oflUserDetailsDTO);

        log.atInfo()
                .setMessage(DATA_TRACKING_LOG + aspectName)
                .log();

        return trackingResourceResponse;
    }

    private void checkNull(String aspectName) {
        if (aspectName == null) {
            throw new IllegalArgumentException("Aspect must not be null");
        }
    }

    private OflUserDetailsDTO buildUserDetailsForTrackingDetails(TrackingDetailsRequest request,
                                                                  HttpHeaders httpHeaders) {
        String userId = request.getUserId();
        String email  = request.getEmail();
        if (userId != null && email != null) {
            return new OflUserDetailsDTO(userId.trim(), email.trim());
        }
        return commonService.getUserDetailsFromHeader(httpHeaders);
    }
}

