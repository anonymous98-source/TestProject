    @Override
    public FetchColumnFiltersResponse getAvailableFilters(List<Map<String, Object>> locationsWithFacilityID,
                                                          boolean fetchAll,
                                                          String monarchId,
                                                          String tagSearchQuery,
                                                          List<String> shipperAccountNumbers,
                                                          boolean isShipmentPageWanted) {
        // if fetchAll is false, there will be data inside locations
        Map<String, List<String>> filters = new HashMap<>();
        Map<String, List<FilterAddressDTO>> addressFilters = new HashMap<>();
        Map<String, List<String>> uniqueHcidCodes;
        long startTime = System.currentTimeMillis();
        if (!fetchAll) {
            uniqueHcidCodes = getFilterListDetails(locationsWithFacilityID, tagSearchQuery, shipperAccountNumbers,
                    filters, addressFilters, isShipmentPageWanted);

            long endTime = System.currentTimeMillis();
            long duration = endTime - startTime;

            log.atInfo(
                    )
                            .setMessage("FetchAll=false: Filters fetched in " + duration + " ms")
                            .log();


        } else {
            try {
                UUID userId = monarchId == null ? null : UUID.fromString(monarchId);

                Date dateRangeStart = Date.from(LocalDateTime.now().minusYears(advshipTrackingResourceProperties.getHistoryPageYears()).atZone(ZoneId.systemDefault()).toInstant());// no limit during history page
                Date dateRangeEnd =  Date.from(LocalDateTime.now().atZone(ZoneId.systemDefault()).toInstant());
                if(isShipmentPageWanted){ // shipmentEntity page is wanted
                    dateRangeStart= Date.from(LocalDateTime.now().minusDays(advshipTrackingResourceProperties.getShipmentPageDays()).atZone(ZoneId.systemDefault()).toInstant());
                }


                uniqueHcidCodes = getHcidFilterMapForFetchallTruebyAsync(userId, dateRangeStart, dateRangeEnd);

                CompletableFuture<List<String>> carriersFuture = fetchCarriersAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> serviceLinesFuture = fetchServiceLinesAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> statusFuture = fetchStatusWithNativeAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> detailedStatusFuture = fetchDetailedStatusWithNativeAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> shippingProfileFuture = fetchShippingProfileNamesAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> tagsFuture = fetchTagsAsync(userId, tagSearchQuery, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<String>> packageProfileFuture = fetchPackageProfileNamesWithNativeAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<FilterAddressDTO>> shipFromFuture = fetchShipFromAddressesAsync(userId, dateRangeStart, dateRangeEnd);
                CompletableFuture<List<FilterAddressDTO>> shipToFuture = fetchShipToAddressesAsync(userId, dateRangeStart, dateRangeEnd);

                CompletableFuture.allOf(
                        carriersFuture, serviceLinesFuture, statusFuture, detailedStatusFuture,
                        shippingProfileFuture, tagsFuture, packageProfileFuture, shipFromFuture, shipToFuture
                ).join();

                FilterRequest request = FilterRequest.builder()
                        .filters(filters)
                        .addressFilters(addressFilters)
                        .carriersFuture(carriersFuture)
                        .serviceLinesFuture(serviceLinesFuture)
                        .statusFuture(statusFuture)
                        .detailedStatusFuture(detailedStatusFuture)
                        .shippingProfileFuture(shippingProfileFuture)
                        .tagsFuture(tagsFuture)
                        .packageProfileFuture(packageProfileFuture)
                        .shipFromFuture(shipFromFuture)
                        .shipToFuture(shipToFuture)
                        .build();

                addAllFilters(request);
            }
            catch (InterruptedException | ExecutionException e) {
                Thread.currentThread().interrupt();
                log.atError().setMessage("Error while fetching filters in case of fetchAll true: " + e.getMessage()).setCause(e).log();
                throw new TrackingResourceException("Error while fetching filter in fetchAll: true", e);
            } catch (Exception e) {
                log.atError()
                        .setMessage("Unexpected error while fetching filters in case of fetchAll true: " + e.getMessage())
                        .setCause(e)
                        .log();
                throw new TrackingResourceException("Unexpected error while fetching filters in case of fetchAll true: " + e.getMessage());
            }
            long endTime = System.currentTimeMillis();
            long duration = endTime - startTime;
            log.atInfo()
                    .setMessage("FetchAll=true: Filters fetched in " + duration + " ms")
                    .log();
        }


        FetchColumnFiltersResponse colResponse = buildFilterResponseDTO(filters);
        colResponse.setLocationWithFacilityId(locationsWithFacilityID);
        colResponse.setAddressFilters(addressFilters);
        colResponse.setHcidFilters(uniqueHcidCodes);
        return colResponse;
    }


    public void addAllFilters(FilterRequest request) throws InterruptedException, ExecutionException {
        CompletableFuture<List<String>> cleanedTagsFuture = request.getTagsFuture().thenApply(tags ->
                tags.stream()
                        .filter(Objects::nonNull)
                        .flatMap(tag -> Stream.of(tag.split(",")))
                        .map(String::trim)
                        .filter(tag -> !tag.isBlank())
                        .distinct()
                        .sorted(String.CASE_INSENSITIVE_ORDER)
                        .limit(50)
                        .toList()
        );

        request.getFilters().put(CARRIER, request.getCarriersFuture().get());
        request.getFilters().put(SERVICE_LINE, request.getServiceLinesFuture().get());
        request.getFilters().put(STATUS, request.getStatusFuture().get());
        request.getFilters().put(DETAILED_STATUS, request.getDetailedStatusFuture().get());
        request.getFilters().put(SHIPPING_PROFILE_FILTER, request.getShippingProfileFuture().get());
        request.getFilters().put(SHIPPING_PROFILE_TAGS_FILTER, cleanedTagsFuture.get());
        request.getFilters().put(PACKAGE_PROFILE_FILTER, request.getPackageProfileFuture().get());
        request.getAddressFilters().put(SHIP_FROM_ADDRESS, request.getShipFromFuture().get());
        request.getAddressFilters().put(SHIP_TO_ADDRESS, request.getShipToFuture().get());
    }


    public Map<String, List<String>> getFilterListDetails(List<Map<String, Object>> locationsWithFacilityID,
                                                          String tagSearchQuery,
                                                          List<String> shipperAccountNumbers,
                                                          Map<String, List<String>> filters,
                                                          Map<String, List<FilterAddressDTO>> addressFilters,
                                                          boolean isShipmentPageWanted) {
        Map<String, List<String>> hcidDetails;
        try {
