  @Test
  void shouldProcessNonNavigatorShipmentSuccessfully()
      throws IOException, ExecutionException, InterruptedException {

    TrackingFedexDTO fedex = createCompleteFedexDto();

    ShipmentDetailsDTO shipment = new ShipmentDetailsDTO();
    shipment.setShipmentID(null);

    when(trackingDataService.findShipmentDetailsByTrackingNumber(
            any(TrackingNumberRequest.class)))
        .thenReturn(shipment);

    when(trackingDataService.findBillingGroupIDAndCustomerIdByAccountNumber("123456"))
        .thenReturn(Collections.emptyList());

    ShipmentCreatedResponse response = new ShipmentCreatedResponse();
    response.setStatus(SUCCESS);

    when(trackingDataService.saveTrackingDetailsForNonNavigator(any(ShipmentDTO.class)))
        .thenReturn(response);

    when(trackingNoPhiDataPublisher.publishNoPhiData(anyString(), any(ShipmentDTO.class)))
        .thenReturn(true);

    when(publisher.publish(any(TrackingEventDTO.class), eq(ADVSHIP_TRACKING)))
        .thenReturn(true);

    subject.trackingFedexPublisher(
        fedex,
        "{\"tracking\":\"123456789\"}");

    verify(saveFedexJsonService)
        .saveFedexJson("{\"tracking\":\"123456789\"}");

    verify(trackingDataService)
        .saveTrackingDetailsForNonNavigator(any(ShipmentDTO.class));

    verify(trackingNoPhiDataPublisher)
        .publishNoPhiData(anyString(), any(ShipmentDTO.class));

    verify(publisher)
        .publish(any(TrackingEventDTO.class), eq(ADVSHIP_TRACKING));
  }

