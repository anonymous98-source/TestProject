  public String getSegregatedFillId(NewShipmentDto newShipmentDto) {
    return newShipmentDto.getShipmentPackageDtos().stream()
        .filter(Objects::nonNull)
        .flatMap(
            packageDto -> {
              if (packageDto.getFills() == null) return Stream.empty();
              return packageDto.getFills().stream().filter(Objects::nonNull);
            })
        .map(FillDto::getFillId)
        .filter(Objects::nonNull)
        .collect(Collectors.joining(ServiceCommonConstants.COMMA));
  }

  private void getCostCenterDetails(
      NewShipmentDto newShipmentDto, ShipmentEntity newShipmentEntity) {
    String costCenterName = null;
    String costCenterNumber = null;
    if (!StringUtils.isEmpty(newShipmentDto.getShipmentCostCenter())) {
      Matcher matcher = commonService.getMatcher(newShipmentDto.getShipmentCostCenter());
      if (matcher.find()) {
        costCenterName = matcher.group(1).trim();
        costCenterNumber = matcher.group(2).trim();
      } else {
        costCenterNumber = newShipmentDto.getShipmentCostCenter();
      }
    }
    newShipmentEntity.setCostCenterName(costCenterName);
    newShipmentEntity.setCostCenterNumber(costCenterNumber);
  }
