            ErrorConstant.INTERNAL_SERVER_ERROR,
            HttpStatus.INTERNAL_SERVER_ERROR.value()),
        HttpStatus.INTERNAL_SERVER_ERROR);
  }

  @ExceptionHandler(UnAuthorizedException.class)
  public ResponseEntity<ErrorResponse> handleUnAuthorizedException(
      Exception ex, WebRequest request) {

    log.error("UnAuthorized request : ", ex);
    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            "Unauthorized request",
            ErrorConstant.UNAUTHORIZED_REQUEST,
            HttpStatus.UNAUTHORIZED.value()),
        HttpStatus.UNAUTHORIZED);
  }

  @ExceptionHandler(MethodArgumentNotValidException.class)
  public ResponseEntity<FieldValidationErrorResponse> handleFieldValidationError(
      MethodArgumentNotValidException ex, WebRequest request) {

    Map<String, String> fieldErrors = new HashMap<>();
    ex.getBindingResult()
        .getAllErrors()
        .forEach(
            error -> {
              String fieldName = ((FieldError) error).getField();
              String errorMessage = error.getDefaultMessage();
              fieldErrors.put(fieldName, errorMessage);
            });

    FieldValidationErrorResponse fieldValidationErrorResponse =
        new FieldValidationErrorResponse(
            "field validation error",
            fieldErrors,
            getPathFromWebRequest(request),
            HttpStatus.BAD_REQUEST.value());
    return new ResponseEntity<>(fieldValidationErrorResponse, HttpStatus.BAD_REQUEST);
  }

  @ExceptionHandler(TrackingUspsEventException.class)
  public ResponseEntity<ErrorResponse> trackingUspsEventException(
      Exception ex, WebRequest request) {
    log.error("Data missing: ", ex);
    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            "Data missing : " + ex.getMessage(),
            ErrorConstant.INTERNAL_SERVER_ERROR,
            HttpStatus.INTERNAL_SERVER_ERROR.value()),
        HttpStatus.INTERNAL_SERVER_ERROR);
  }

  @ExceptionHandler(MethodArgumentTypeMismatchException.class)
  public ResponseEntity<ErrorResponse> handleMethodArgumentTypeMismatchException(
      MethodArgumentTypeMismatchException ex, WebRequest request) {

    String message =
        String.format(
            "Invalid value '%s' for parameter '%s'. Expected type is '%s'.",
            ex.getValue(),
            ex.getPropertyName(),
            ex.getRequiredType() != null ? ex.getRequiredType().getSimpleName() : "unknown");

    log.error("Type mismatch error: ", ex);

    return new ResponseEntity<>(
        buildErrorResponse(
            request, message, ErrorConstant.VALIDATION_ERROR, HttpStatus.BAD_REQUEST.value()),
        HttpStatus.BAD_REQUEST);
  }

  private String getPathFromWebRequest(WebRequest request) {
    return (request != null)
        ? request.getDescription(false).replace("uri=", "")
        : "Path not available";
  }

  /**
   * Build ErrorResponse
   *
   * @param request request send by user
   * @param message error message
   * @param httpStatusType status type
   * @param httpStatusCode status code
   * @return ErrorResponse
   */
  private ErrorResponse buildErrorResponse(
      WebRequest request, String message, String httpStatusType, int httpStatusCode) {
    return new ErrorResponse(
        httpStatusType, message, getPathFromWebRequest(request), httpStatusCode);
  }

  @ExceptionHandler(ResponseStatusException.class)
  public ResponseEntity<ErrorResponse> handleResponseStatusException(
      ResponseStatusException ex, WebRequest request) {

    log.error("ResponseStatusException occurred: ", ex);

    ErrorResponse errorResponse =
        buildErrorResponse(
            request,
            ex.getReason() != null ? ex.getReason() : "Unexpected error",
            "Bad Request",
            ex.getStatusCode().value());
    return new ResponseEntity<>(errorResponse, ex.getStatusCode());
  }
