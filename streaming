                    .status("failure")
                    .aspectName("")
                    .build();
        } catch (DataIntegrityViolationException e) {
            log.info("Data integrity violation occurred for Tracking number: {} ", newShipmentDto.getReferenceTrackingNumber());
            return ShipmentCreatedResponse.builder()
                    .status("failure")
                    .aspectName("")
                    .build();
        }
    }
