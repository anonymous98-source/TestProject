public interface SavedViewsReportsRepository
    extends JpaRepository<SavedViewsReportsEntity, UUID>,
    JpaSpecificationExecutor<SavedViewsReportsEntity> {

    int countDistinctByUserId(UUID userId);


    Optional<List<SavedViewsReportsEntity>> findByUserIdOrderByViewNameAsc(UUID userId);

    Optional<SavedViewsReportsEntity> findByIdOrderByViewNameAsc(UUID id);

    @Query(value = """
       SELECT
           v.id,                 -- 0 View Id
           v.user_id,            -- 1 User Id
           v.view_name,          -- 2 View Name
           v.view_filter,        -- 3 View Filters (json)
           v.customer_id,        -- 4 Customer Id
           s.is_active,          -- 5 Schedule Active (boolean)
           s.report_type,        -- 6 Report Type (enum)
           s.emails,             -- 7 Emails (text[] / array)
           s.user_timezone,      -- 8 User Timezone
           s.days_of_week,       -- 9 Days Of Week
           s.hours_of_day      
       FROM advship_tracking_resource.saved_views_reports v
       LEFT JOIN advship_tracking_resource.report_schedule s
           ON s.view_id = v.id
       WHERE v.id = :viewId
       """, nativeQuery = true)
    List<Object[]> fetchViewReport(@Param("viewId") UUID viewId);

    @Query(
            value = """
            SELECT rs.id::text
            FROM advship_tracking_resource.report_schedule rs
            WHERE rs.is_active = true
              AND substring(rs.hours_of_day,
                           extract(hour from (now() at time zone rs.user_timezone))::int + 1, 1) = '1'
              AND substring(rs.days_of_week,
                           extract(dow from (now() at time zone rs.user_timezone))::int + 1, 1) = '1'
            """,
            countQuery = """
            SELECT count(*)
            FROM advship_tracking_resource.report_schedule rs
            WHERE rs.is_active = true
              AND substring(rs.hours_of_day,
                           extract(hour from (now() at time zone rs.user_timezone))::int + 1, 1) = '1'
              AND substring(rs.days_of_week,
                           extract(dow from (now() at time zone rs.user_timezone))::int + 1, 1) = '1'
            """,
            nativeQuery = true
    )
    Page<String> findMatchingScheduleIds(Pageable pageable);

    @Query("SELECT sv FROM SavedViewsReportsEntity sv WHERE sv.id IN " +
           "(SELECT rs.viewId FROM ReportScheduleEntity rs WHERE rs.id IN :scheduleIds)")
    List<SavedViewsReportsEntity> findViewsByScheduleIds(@Param("scheduleIds") List<UUID> scheduleIds);

}

