  public void updateParentShipment(NewShipmentDto newShipmentDto, ShipmentEntity shipmentEntity) {
    try {
      var parentShipmentEntity =
          shipmentRepository.findShipmentByTrackingNumber(
              newShipmentDto.getOriginalShipmentTrackingNumber());

      var labelContent =
          newShipmentDto
              .getShipmentPackageDtos()
              .get(0)
              .getShipmentPackageTracking()
              .getLabelContent();

      var trackingEntities = trackingRepository.findAllByShipmentId(parentShipmentEntity.getId());
      trackingEntities.stream()
          .forEach(
              te -> {
                te.setReturnLabelType(newShipmentDto.getLabelType());
                te.setReturnLabelContent(labelContent);
              });

      shipmentEntity.setParentShipmentId(
          UUID.fromString(parentShipmentEntity.getShipmentTransactionId()));
      shipmentEntity.setReferenceTrackingNumber(newShipmentDto.getOriginalShipmentTrackingNumber());
      shipmentEntity.setMasterTrackingNumber(newShipmentDto.getMasterTrackingNumber());
      shipmentRepository.saveAll(List.of(parentShipmentEntity, shipmentEntity));
      log.atInfo()
              .setMessage("Parent Shipment has been updated")
              .addKeyValue("parentShipmentId", parentShipmentEntity.getShipmentTransactionId())
              .addKeyValue("referenceTrackingNumber", shipmentEntity.getReferenceTrackingNumber())
              .log();
    } catch (Exception e) {
      log.atError()
              .setMessage("Error updating parent shipmentEntity")
              .setCause(e)
              .log();
    }
  }

