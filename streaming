                .id(billingGroupId)
                .customerId(UUID.randomUUID())
                .build();

        Facility facility = Facility.builder()
                .id(UUID.randomUUID())
                .billingGroupId(billingGroupId)
                .build();

        UserCustomerProfile userCustomerProfile = UserCustomerProfile.builder()
                .billingGroups(Map.of(billingGroupId, billingGroup))
                .facilities(Map.of(facility.getId(), facility))
                .build();

        CustomerAdapter.setFacilityCustomerIds(userCustomerProfile);

        assertEquals(billingGroup.getCustomerId(), facility.getCustomerId());
    }

    @Test
    void testMapEntitiesToCustomerHierarchyRequest() {
        UUID customerId = UUID.randomUUID();
        UUID billingGroupId = UUID.randomUUID();
        UUID facilityId = UUID.randomUUID();

        List<Entity> entityList = List.of(
                createEntityWithReflection(customerId, EntityType.CUSTOMER),
                createEntityWithReflection(billingGroupId, EntityType.BILLING_GROUP),
                createEntityWithReflection(facilityId, EntityType.FACILITY)
        );

        CustomerHierarchyRequestDto customerHierarchyRequestDto =
                CustomerAdapter.mapEntitiesToCustomerHierarchyRequest(entityList);

        assertEquals(List.of(customerId), customerHierarchyRequestDto.getCustomers());
        assertEquals(List.of(billingGroupId), customerHierarchyRequestDto.getBillingGroups());
        assertEquals(List.of(facilityId), customerHierarchyRequestDto.getFacilities());
    }

    // Helper method to instantiate Entity via reflection since constructor is not public
    private static Entity createEntityWithReflection(UUID id, EntityType type) {
        try {
            java.lang.reflect.Constructor<Entity> constructor = Entity.class.getDeclaredConstructor(UUID.class, EntityType.class);
            constructor.setAccessible(true);
            return constructor.newInstance(id, type);
        } catch (Exception exception) {
            throw new RuntimeException(exception);
        }
    }
