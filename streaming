    private String getPackageInnerDimension(TrackingDetailsProjection pkg) {

        String innerLength = pkg.getInnerLength() != null ? pkg.getInnerLength() : "";
        String innerWidth = pkg.getInnerWidth() != null ? pkg.getInnerWidth() : "";
        String innerHeight = pkg.getInnerHeight() != null ? pkg.getInnerHeight() : "";

        // If all are null, return empty string
        if (innerLength.isEmpty() && innerWidth.isEmpty() && innerHeight.isEmpty()) {
            return "";
        }
        return Stream.of(innerLength, innerWidth, innerHeight)
                .map(s -> "[" + s + "]")
                .collect(Collectors.joining("x"));
    }



