    public SupportUpdateHistoryDto getSupportUpdateHistoryFromJson(JsonNode supportUpdateHistory) {
        if (supportUpdateHistory != null && supportUpdateHistory.isArray() && supportUpdateHistory.size() > 0) {

            List<String> supportUpdates = new ArrayList<>();
            List<LocalDateTime> supportUpdateTimes = new ArrayList<>();

            List<SupportUpdateEntry> supportUpdateEntries = new ArrayList<>();

            for (JsonNode supportUpdate : supportUpdateHistory) {
                LocalDateTime supportUpdateDateTime = parseSupportUpdateDateTime(supportUpdate);

                String supportUpdateText = supportUpdate.has(ServiceCommonConstants.SUPPORT_UPDATE) && !supportUpdate.get(ServiceCommonConstants.SUPPORT_UPDATE).isNull()
                        ? supportUpdate.get(ServiceCommonConstants.SUPPORT_UPDATE).asText()
                        : null;
                supportUpdateEntries.add(new SupportUpdateEntry(supportUpdateText, supportUpdateDateTime));
            }
            // Sort by datetime DESC (most recent first)
            supportUpdateEntries.sort((a, b) -> {
                if (a.getSupportUpdateDateTime() != null && b.getSupportUpdateDateTime() != null) {
                    return b.getSupportUpdateDateTime().compareTo(a.getSupportUpdateDateTime());
                }
                return 0;
            });
            // Populate the lists in sorted order
            for (SupportUpdateEntry entry : supportUpdateEntries) {
                supportUpdates.add(entry.getSupportUpdate());
                supportUpdateTimes.add(entry.getSupportUpdateDateTime());
            }

            SupportUpdateHistoryDto.builder()
                    .interventionNotesSupportUpdate(supportUpdates)
                    .interventionNotesSupportUpdatedAt(supportUpdateTimes)
                    .build();
            return buildSupportUpdateHistoryDto(supportUpdates, supportUpdateTimes);

        }
        return buildSupportUpdateHistoryDto(Collections.emptyList(), Collections.emptyList());
    }

