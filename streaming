@Component
@Slf4j
@RequiredArgsConstructor
public class PackageDtoPubSubMapper {

  private final ObjectMapper objectMapper;
  private final ExternalReferenceRepository externalReferenceRepository;
  private final AdditionalServicePackageRepository additionalServicePackageRepository;
  private final TrackingRepository trackingRepository;
  private final NotificationRepository notificationRepository;

  /* Two things for all of this:
   * 1. I doubt we need all of this info for whatever is calling this. More refactoring should be done to make our
   *    endpoints normal, restful endpoints for specific sets of data. Then the front end just pulls what it needs.
   * 2. If somehow we really need to get all of this data in one go, we should grab as much as we can in a few
   *    queries, preferably just 1.
   *
   * This card is refactoring so much already and has a hard deadline, so I'm leaving these as separate queries like
   * what was happening before with JPA joins anyway. At least it's explicit in how many queries are running and how
   * much mapping is happening now lol.
   *
   * It would be good to fix this in the future.
   */
  public PackageDto fromEntityWithJoins(PackageEntity packageEntity, String carrierDetails) {
    var packageId = packageEntity.getId();

    var packageDto = fromEntity(packageEntity);
    addTrackingSource(packageDto, carrierDetails);
    addExternalReferenceEntity(packageDto, externalReferenceRepository.findByPackageId(packageId));
    addAdditionalServicePackageEntity(
        packageDto, additionalServicePackageRepository.findByPackageId(packageId));
    addTrackingEntity(packageDto, trackingRepository.findByPackageId(packageId));
    addNotifications(
        packageDto, notificationRepository.findAllByTrackingId(packageDto.getTrackingId()));

    return packageDto;
  }

  public PackageDto fromEntity(PackageEntity entity) {
    if (entity == null) return PackageDto.builder().build();

    return PackageDto.builder()
        .id(entity.getId())
        .packageName(entity.getPackageProfileName())
        .packageLength(entity.getPackageLength())
        .packageWidth(entity.getPackageWidth())
        .packageHeight(entity.getPackageHeight())
        .packageWeight(entity.getPackageWeight())
        .packageWeightUnit(entity.getPackageWeightUnit())
        .packageDimUnit(entity.getPackageDimUnit())
        .packageDryIceWeight(entity.getPackageDryIceWeight())
        .packageLabelReference1(entity.getPackageLabelReference1())
        .packageLabelReference2(entity.getPackageLabelReference2())
        .packageLabelReference3(entity.getPackageLabelReference3())
        .packageLabelReference4(entity.getPackageLabelReference4())
        .specialInstructions(entity.getSpecialInstructions())
        .internalDesignationReference(entity.getInternalDesignationReference())
        .packageNickName(entity.getPackageNickName())
        .pharmacyOrderNumber(entity.getPharmacyOrderNumber())
        .includeReturnLabel(entity.getIncludeReturnLabel())
        .build();
  }

  public void addTrackingEntity(PackageDto dto, TrackingEntity entity) {
    if (entity == null) return;

    dto.setTrackingId(entity.getId());
    dto.setTrackingUrl(entity.getTrackingUrl());
    dto.setDeliveryDate(entity.getDeliveryDate());
    dto.setLabelType(entity.getLabelType());
    dto.setLabelContent(entity.getLabelContent());
    dto.setShipDate(entity.getShipDate());
    dto.setExpectedDeliveryDate(entity.getExpectedDeliveryDate());
    dto.setTrackingNumberUpdatedOnEpic(entity.getTrackingNumberUpdatedOnEpic());
    dto.setPodUpdatedOnEpic(entity.getPodUpdatedOnEpic());
    dto.setTrackingLastScanLocation(entity.getTrackingLastScanLocation());
    dto.setTrackingLastStatus(entity.getTrackingLastStatus());
    dto.setTrackingLastMessage(entity.getTrackingLastMessage());
    dto.setReturnLabelContent(entity.getReturnLabelContent());
    dto.setReturnLabelType(entity.getReturnLabelType());
    dto.setEpicSkipReason(entity.getEpicSkipReason());
    dto.setTrackingNumber(entity.getTrackingNumber());
  }

  public void addTrackingSource(PackageDto dto, String carrier) {
    if (carrier == null) return;

    dto.setTrackingSource(TrackingSource.fromString(carrier));
  }

  public void addAdditionalServicePackageEntity(
      PackageDto dto, AdditionalServicePackageEntity entity) {
    if (entity == null) return;

    dto.setAdditionalServicePackageId(entity.getId());
    dto.setDeclaredValue(entity.getDeclaredValue());
    dto.setValueOfContent(entity.getValueOfContent());
    dto.setIsShipmentProtection(entity.getIsShipmentProtection());
    dto.setLithiumBattery(entity.getLithiumBattery());
    dto.setIsColdChain(entity.getIsColdChain());
    dto.setAdditionalInsurance(entity.getAdditionalInsurance());
  }

  public void addExternalReferenceEntity(
      PackageDto dto, ExternalReferenceEntity externalReferenceEntity) {
    if (externalReferenceEntity == null) return;

    Reference reference;
    try {
      reference =
          objectMapper.convertValue(
              externalReferenceEntity.getExternalReferenceValueJson(), Reference.class);
    } catch (Exception e) {
      log.info("Error parsing package reference information", e);
      reference = new Reference();
    }

    var prescriptionNumberList = getCommaDeliminatedList(reference.getPrescriptionNumber());
    var fillIdList = getCommaDeliminatedList(reference.getFillId());
    adjustElementCount(fillIdList, prescriptionNumberList);

    dto.setFills(
        IntStream.range(0, fillIdList.size())
            .mapToObj(i -> new FillDto(fillIdList.get(i), prescriptionNumberList.get(i)))
            .toList());
  }

  public void addNotifications(PackageDto dto, List<NotificationEntity> notificationEntities) {
    dto.setNotifications(
        notificationEntities.stream()
            .map(
                n ->
                    NotificationDto.builder()
                        .notificationId(n.getId())
                        .notificationCommunicationChannel(n.getNotificationCommunicationChannel())
                        .notificationCommunicationValue(n.getNotificationCommunicationValue())
                        .notificationEventSubscription(n.getNotificationEventSubscription())
                        .build())
            .toList());
  }

  private List<String> getCommaDeliminatedList(String commaSeparatedString) {
    return new ArrayList<>(
        StringUtils.isBlank(commaSeparatedString)
            ? List.of(ServiceCommonConstants.EMPTY_STRING)
            : Arrays.asList(commaSeparatedString.split(",")));
  }

  private void adjustElementCount(List<String> fillIdList, List<String> prescriptionNumberList) {
    if (fillIdList.size() != prescriptionNumberList.size()) {
      boolean moreFillIds = fillIdList.size() > prescriptionNumberList.size();
      int difference = Math.abs(fillIdList.size() - prescriptionNumberList.size());
      (moreFillIds ? prescriptionNumberList : fillIdList)
          .addAll(IntStream.range(0, difference).mapToObj(i -> "").toList());
    }
  }
}

