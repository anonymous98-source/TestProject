package com.cardinalhealth.advship.tracking.resource.service.utils;


import com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants;
import com.cardinalhealth.advship.tracking.resource.constants.TrackingFilterConstants;
import com.cardinalhealth.advship.tracking.resource.database.entity.SavedViewsReportsEntity;
import com.cardinalhealth.advship.tracking.resource.exception.ResourceNotFoundException;
import com.cardinalhealth.advship.tracking.resource.exception.TrackingResourceException;
import com.cardinalhealth.advship.tracking.resource.model.response.filters.TrackingDateFiltersResponse;
import com.cardinalhealth.advship.tracking.resource.model.response.filters.TrackingFilterCriteriaResponse;
import com.cardinalhealth.advship.tracking.resource.model.response.filters.TrackingFilterResponseDto;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.Objects;

@Slf4j
@Component
public class TrackingFilterMapper {

    
    private final ObjectMapper objectMapper = new ObjectMapper();

    public TrackingFilterResponseDto trackingFilterEntityToResponseDTO(SavedViewsReportsEntity savedFilter) {
        if (savedFilter == null || (Objects.equals(savedFilter.getViewType(), ServiceCommonConstants.CUSTOM) && savedFilter.getViewFilterJson() == null)) {
            log.atDebug()
                    .setMessage("Either saved filter fetched from DB or filter criteria in saved filter is null")
                   .log();
            throw new ResourceNotFoundException("Either Filter or filter criteria saved in DB is null");
        }

        TrackingFilterCriteriaResponse filter;

        if (savedFilter.getViewType() == null || savedFilter.getViewType().equals(ServiceCommonConstants.CUSTOM)) {
            try {
                filter = objectMapper.treeToValue(savedFilter.getViewFilterJson(), TrackingFilterCriteriaResponse.class);
            } catch (JsonProcessingException e) {
                log.atError()
                        .setMessage(String.format("Error parsing filter json tracking filter: %s "
                                + "and detailed error is %s", savedFilter.getViewFilterJson().toString(), e.getMessage()))
                        .log();
                throw new TrackingResourceException(
                        String.format("Failed to parse saved TrackingFilter JSON for saved filter ID: %s"
                                + " inside TrackingFilterMapper", savedFilter.getId()), e);
            }
            // Transform some date related filters and current dates
            TrackingFilterCriteriaResponse updatedFilter = mapCurrentDateToSaveFilters(filter);

            // Convert dates to current date in case of
            return TrackingFilterResponseDto.builder()
                    .filterId(savedFilter.getId())
                    .viewName(savedFilter.getViewName())
                    .isBaseView(false)  //this means the view is a custom view
                    .filterCriteria(updatedFilter)
                    .build();
        }

        else return TrackingFilterResponseDto.builder()
                .filterId(savedFilter.getId())
                .viewName(savedFilter.getViewName())
                .isBaseView(true)  //this means the view is a standard view
                .build();

    }

    /**
     * Transform if any date filter is required to be updated with latest  required date before sending to UI
     *
     * @param filterCriteria Filter Criteria from DB
     * @return Filter criteria updated with required date (different from what saved in DB)
     */
    private TrackingFilterCriteriaResponse mapCurrentDateToSaveFilters(
            TrackingFilterCriteriaResponse filterCriteria) {

        if (filterCriteria!=null && filterCriteria.getArrivingToday() != null) {
            TrackingDateFiltersResponse arrivingTodayToUpdate = filterCriteria.getArrivingToday();
            String currentDate = getCurrentDateAtTheStartOfDay(true, 0);
            arrivingTodayToUpdate.setDateFrom(currentDate);
            filterCriteria.setArrivingToday(arrivingTodayToUpdate);
            log.atInfo().setMessage("Updated arriving today filter criteria dateFrom field to " + currentDate)
                   .log();
        }

        if (filterCriteria!=null && filterCriteria.getDelayed() != null) {
            TrackingDateFiltersResponse delayedFilterToUpdate = filterCriteria.getDelayed();
            String currentDate = getCurrentDateAtTheStartOfDay(false, -1);
            delayedFilterToUpdate.setDateFrom(currentDate);
            filterCriteria.setDelayed(delayedFilterToUpdate);
            log.atInfo().setMessage("Updated delayed filter criteria dateFrom field to " + currentDate)
                   .log();
        }

        return filterCriteria;
    }

    /**
     * Construct required date in required format
     *
     * @param isCurrentDate Flag indication is today's date required
     * @param daysToAdd     Days to add/ subtract from today's date
     * @return Date with provided format in String
     */
    private String getCurrentDateAtTheStartOfDay(boolean isCurrentDate, int daysToAdd) {
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern(TrackingFilterConstants.FILTER_DATE_FORMAT);
        String requiredDateAtStartOfDay =
                isCurrentDate
                        ? LocalDate.now().atStartOfDay().format(formatter)
                        : LocalDate.now().plusDays(daysToAdd).atStartOfDay().format(formatter);
        log.atInfo()
                .setMessage("Transformed required date at the start of day is " + requiredDateAtStartOfDay)
               .log();
        return requiredDateAtStartOfDay;
    }
}

