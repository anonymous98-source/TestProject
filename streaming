<form>
  <div
    matAutocompleteOrigin
    #origin="matAutocompleteOrigin"
    class="opti-form-field-origin"
  >
    <opti-form-field
      [label]="''"
      [forAttribute]="''"
      [fieldName]="control"
      [showInlineFields]="true"
    >
      <mat-icon matPrefix class="input-mat-icon">search</mat-icon>
      <input
        type="text"
        matInput
        [formControl]="searchInputControl"
        [matAutocomplete]="auto"
        [matAutocompleteConnectedTo]="origin"
        class="custom-input"
        [placeholder]="modifiedPlaceHolder()"
        [maxlength]="inputMaxCharacters"
        (focus)="onFocus()"
        (blur)="onBlur()"
      />
      <div
        matSuffix
        mat-icon-button
        *ngIf="searchInputControl.value"
        (click)="clearInput()"
        class="input-mat-icon"
      >
        <mat-icon>close</mat-icon>
      </div>

      <mat-autocomplete
        #auto="matAutocomplete"
        (optionSelected)="onOptionSelected($event)"
        class="search-box"
      >
        <mat-option *ngIf="isLoading">
          <div class="spinner-option">
            <mat-spinner diameter="18" class="custom-spinner"></mat-spinner>
            <span style="margin-left: 10px">
              {{ loadingPlaceholder() }}
            </span>
          </div>
        </mat-option>

        <mat-option *ngIf="noResults" class="no-result">
          No results found
        </mat-option>

        <ng-container *ngIf="filteredOptions | async as options">
          <mat-option
            *ngFor="let option of options"
            [value]="option"
            class="custom-option"
          >
            <opti-checkbox
              [checked]="isSelected(option)"
              (click)="$event.stopPropagation()"
              (checkboxChange)="toggleSelection(option)"
              [noFormGroup]="true"
              [title]="
                searchPlaceholder() === AddPanelType.BillingGroup
                  ? option.name + ' (' + option.id + ')'
                  : option.name
              "
            >
            </opti-checkbox>
          </mat-option>
        </ng-container>
      </mat-autocomplete>
    </opti-form-field>
  </div>
</form>






import { AsyncPipe, CommonModule } from '@angular/common';
import {
  Component,
  computed,
  DestroyRef,
  EventEmitter,
  input,
  Input,
  OnInit,
  Output,
  ViewChild,
} from '@angular/core';
import { takeUntilDestroyed, toObservable } from '@angular/core/rxjs-interop';
import { FormControl, ReactiveFormsModule } from '@angular/forms';
import {
  MatAutocompleteModule,
  MatAutocompleteSelectedEvent,
  MatAutocompleteTrigger,
} from '@angular/material/autocomplete';
import { MatDividerModule } from '@angular/material/divider';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatIconModule } from '@angular/material/icon';
import { MatInputModule } from '@angular/material/input';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
import { merge, Observable, of } from 'rxjs';
import {
  catchError,
  debounceTime,
  distinctUntilChanged,
  map,
  startWith,
  switchMap,
  tap,
} from 'rxjs/operators';
import { BillingGroupService } from '../../../services/billing-group/billing-group.service';
import { CustomerService } from '../../../services/customer/customer.service';
import { LocationService } from '../../../services/location/location.service';
import { UtilityService } from '../../../services/utility.service';
import { AddPanelType } from '../../enums/search-autocomplete.enum';
import {
  OptiFormFieldComponent,
  OptiCheckboxComponent,
} from '@ofl-next/advship-core-components';

@Component({
  selector: 'cah-search-autocomplete',
  imports: [
    CommonModule,
    ReactiveFormsModule,
    MatFormFieldModule,
    MatInputModule,
    MatAutocompleteModule,
    AsyncPipe,
    MatIconModule,
    OptiFormFieldComponent,
    MatDividerModule,
    MatProgressSpinnerModule,
    OptiCheckboxComponent,
  ],

  templateUrl: './search-autocomplete.component.html',
  styleUrls: ['./search-autocomplete.component.scss'],
})
export class SearchAutocompleteComponent implements OnInit {
  readonly searchPlaceholder = input.required<string>();
  @Input({ required: true }) control!: FormControl<
    { id: string; name: string }[] | null
  >;
  @Output() focusEvent = new EventEmitter<void>();
  @Output() blurEvent = new EventEmitter<void>();
  @ViewChild(MatAutocompleteTrigger)
  autocompleteTrigger!: MatAutocompleteTrigger;
  searchInputControl = new FormControl<string | null>('');
  isLoading = false;
  hasError = false;
  noResults = false;
  filteredOptions: Observable<any[]> | undefined;
  filteredOptionsArray: any[] = [];
  AddPanelType = AddPanelType;

  private readonly lowerCasePlaceholder = computed(() =>
    this.searchPlaceholder().toLowerCase()
  );

  readonly modifiedPlaceHolder = computed(
    () => `Enter ${this.lowerCasePlaceholder()} name`
  );
  readonly loadingPlaceholder = computed(
    () => `Searching ${this.lowerCasePlaceholder()}`
  );

  searchValue = '';
  inputMaxCharacters = 100;

  private readonly placeholderInput$ = toObservable(this.searchPlaceholder);

  constructor(
    private readonly customerService: CustomerService,
    private readonly billingGroupService: BillingGroupService,
    private readonly locationService: LocationService,
    private readonly utilService: UtilityService,
    private readonly destroyRef: DestroyRef
  ) {}

  ngOnInit() {
    merge(this.placeholderInput$, this.utilService.selectedContext$)
      .pipe(takeUntilDestroyed(this.destroyRef))
      .subscribe(() => this.initializeSearch());
  }

  initializeSearch() {
    this.setupFilteredOptions();
    this.control.reset();
  }

  setupFilteredOptions() {
    this.filteredOptions = this.searchInputControl.valueChanges.pipe(
      startWith(''),
      debounceTime(300),
      distinctUntilChanged(),
      tap(() => {
        this.filteredOptionsArray = [];
        this.isLoading = true;
        this.hasError = false;
        this.noResults = false;
      }),
      switchMap((value: any) => this.getSearchObservable(value)),
      tap((options: any[]) => (this.filteredOptionsArray = options))
    );
  }

  onFocus() {
    this.focusEvent.emit();
  }

  onBlur() {
    this.blurEvent.emit();
  }

  onOptionSelected(event: MatAutocompleteSelectedEvent): void {
    const selectedEntry = event.option.value;
    const current = this.control.value || [];
    if (!current.some((item) => item.id === selectedEntry.id)) {
      this.control.setValue([...current, selectedEntry]);
    }
    this.searchInputControl.setValue('');
  }

  clearInput() {
    this.searchInputControl.setValue('');
  }

  hasMoreThanTenOptions(): boolean {
    return this.filteredOptionsArray.length > 10;
  }

  isSelected(option: any): boolean {
    const current = this.control.value || [];
    return current.some((item) => item.id === option.id);
  }

  toggleSelection(option: any) {
    const current = this.control.value || [];
    if (this.isSelected(option)) {
      this.control.setValue(current.filter((item) => item.id !== option.id));
    } else {
      this.control.setValue([...current, option]);
    }
  }

  private getSearchObservable(value: string): Observable<any[]> {
    if (typeof value !== 'string') {
      this.isLoading = false;
      return of([]);
    }

    this.searchValue = value.toLowerCase();
    this.isLoading = true;
    this.hasError = false;

    switch (this.searchPlaceholder()) {
      case AddPanelType.Customer:
        return this.customerService.search(this.searchValue).pipe(
          map((res) =>
            (res?.customers || []).map((val: any) => ({
              id: val.customerId,
              name: val.name,
              active: val.active,
            }))
          ),
          switchMap((transformed) => this.handleSearch(of(transformed)))
        );
      case AddPanelType.BillingGroup:
        return this.billingGroupService.search(this.searchValue).pipe(
          map((res) =>
            (res?.customerBillingGroups || []).map((bg: any) => ({
              id: bg.id,
              name: bg.billingGroupName,
              active: bg.active,
            }))
          ),
          switchMap((transformed) => this.handleSearch(of(transformed)))
        );
      case AddPanelType.Location:
        return this.locationService.search(this.searchValue).pipe(
          map((res) =>
            (res?.customerLocations || []).map((loc: any) => ({
              id: loc.id,
              name: loc.name,
              active: loc.active,
            }))
          ),
          switchMap((transformed) => this.handleSearch(of(transformed)))
        );
      default:
        this.isLoading = false;
        return of([]);
    }
  }

  private handleSearch(search$: Observable<any[]>): Observable<any[]> {
    return search$.pipe(
      map((options) =>
        options.filter((item) =>
          item?.name?.toLowerCase().includes(this.searchValue)
        )
      ),
      tap((filtered) => {
        this.noResults = filtered.length === 0;
        this.isLoading = false;
      }),
      catchError(() => {
        this.isLoading = false;
        this.hasError = true;
        return of([]);
      })
    );
  }
}
