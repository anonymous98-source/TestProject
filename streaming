  @Test
  void shouldProcessNewNonNavigatorShipmentSuccessfully()
      throws IOException, ExecutionException, InterruptedException {

    TrackingFedexDTO fedex = createFedexDto("123456789", "987654321");

    ShipmentDetailsDTO shipment = ShipmentDetailsDTO.builder()
        .shipmentID(null)
        .build();

    ShipmentCreatedResponse response =
        ShipmentCreatedResponse.builder()
            .status(SUCCESS)
            .build();

    when(trackingDataService.findShipmentDetailsByTrackingNumber(any()))
        .thenReturn(shipment);

    when(
        trackingDataService.findBillingGroupIDAndCustomerIdByAccountNumber(
            "987654321"))
        .thenReturn(Collections.emptyList());

    when(trackingDataService.saveTrackingDetailsForNonNavigator(any(ShipmentDTO.class)))
        .thenReturn(response);

    when(trackingNoPhiDataPublisher.publishNoPhiData(anyString(), any(ShipmentDTO.class)))
        .thenReturn(true);

    when(publisher.publish(any(TrackingEventDTO.class), eq(ADVSHIP_TRACKING)))
        .thenReturn(true);

    trackingWebhookFedexPublisher.trackingFedexPublisher(
        fedex, "{\"trackingNumber\":\"123456789\"}");

    verify(saveFedexJsonService).saveFedexJson(
        "{\"trackingNumber\":\"123456789\"}");

    verify(trackingDataService)
        .saveTrackingDetailsForNonNavigator(any(ShipmentDTO.class));

    verify(trackingNoPhiDataPublisher)
        .publishNoPhiData(anyString(), any(ShipmentDTO.class));

    verify(publisher)
        .publish(any(TrackingEventDTO.class), eq(ADVSHIP_TRACKING));
  }

