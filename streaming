    private static void mapShippingProfileTags(Map<String, String> filters, CriteriaBuilder cb, Root<ShipmentEntity> s, CriteriaQuery<?> cq, List<Predicate> predicates) {
        if (filters.containsKey(SHIPPING_PROFILE_TAGS) && !filters.get(SHIPPING_PROFILE_TAGS).isBlank()) {
            String[] tags = Arrays.stream(filters.get(SHIPPING_PROFILE_TAGS).split(","))
                    .filter(str -> !str.isEmpty())
                    .map(String::trim)
                    .toArray(String[]::new);

            if (tags.length > 0) {
                Subquery<Long> tagSubquery = cq.subquery(Long.class);
                Root<AdditionalServiceShipmentEntity> a = tagSubquery.from(AdditionalServiceShipmentEntity.class);

                Expression<String> flat = cb.function(
                        ARRAY_TO_STRING,
                        String.class,
                        a.get(ServiceCommonConstants.SHIPPING_PROFILE_TAGS),
                        cb.literal(COMMA)
                );
                Expression<String> flatSafe = cb.coalesce(flat, "");
                Expression<String> haystack = cb.concat(
                        cb.concat(cb.literal(COMMA), flatSafe),
                        cb.literal(COMMA)
                );
                Predicate tagPredicate = cb.or(
                        Arrays.stream(tags)
                                .map(tag -> cb.like(
                                        cb.lower(haystack),
                                        MODULUS_PREFIX_LIKE + tag.toLowerCase(Locale.ROOT) + MODULUS_SUFIX_LIKE
                                ))
                                .toArray(Predicate[]::new));

                tagSubquery.select(cb.literal(1L)).where(
                        cb.equal(a.get(TrackingFilterConstants.SHIPMENT_ID), s.get("id")),
                        tagPredicate
                );
                predicates.add(cb.exists(tagSubquery));
            }
        }
    }

