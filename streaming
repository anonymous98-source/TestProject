public class TrackingDtoCommonMapper {

  private final NotificationRepository notificationRepository;
  private final TrackingPodRepository trackingPodRepository;
  private final TrackingEventRepository trackingEventRepository;
  private final TrackingSignatoryRepository trackingSignatoryRepository;

  public TrackingDto fromEntityWithJoins(TrackingEntity trackingEntity) {
    var trackingId = trackingEntity.getId();
    var trackingDto = fromEntity(trackingEntity);

    var notificationEntities = notificationRepository.findAllByTrackingId(trackingId);
    trackingDto.setNotifications(new ArrayList<>());
    if (CollectionUtils.isNotEmpty(notificationEntities)) {
      for (var notificationEntity : notificationEntities) {
        trackingDto.getNotifications().add(toNotificationDto(notificationEntity));
      }
    }

    var trackingPodEntities = trackingPodRepository.findAllByTrackingId(trackingId);
    trackingDto.setTrackingPods(new ArrayList<>());
    if (CollectionUtils.isNotEmpty(trackingPodEntities)) {
      for (var trackingPodEntity : trackingPodEntities) {
        trackingDto.getTrackingPods().add(toTrackingPodDto(trackingPodEntity));
      }
    }

    var trackingEventEntities = trackingEventRepository.findAllByTrackingId(trackingId);
    trackingDto.setTrackingEvents(new ArrayList<>());
    if (CollectionUtils.isNotEmpty(trackingEventEntities)) {
      for (var trackingEventEntity : trackingEventEntities) {
        trackingDto.getTrackingEvents().add(toTrackingEventDto(trackingEventEntity));
      }
    }

    var trackingSignatoryEntities = trackingSignatoryRepository.findAllByTrackingId(trackingId);
    trackingDto.setTrackingSignatories(new ArrayList<>());
    if (CollectionUtils.isNotEmpty(trackingSignatoryEntities)) {
      for (var trackingSignatoryEntity : trackingSignatoryEntities) {
        trackingDto.getTrackingSignatories().add(toTrackingSignatoryDto(trackingSignatoryEntity));
      }
    }

    return trackingDto;
  }

  public TrackingDto fromEntity(TrackingEntity entity) {
    if (entity == null) return TrackingDto.builder().build();

    return TrackingDto.builder()
        .id(entity.getId())
        .trackingNumber(entity.getTrackingNumber())
        .trackingUrl(entity.getTrackingUrl())
        .deliveryDate(entity.getDeliveryDate())
        .labelContent(entity.getLabelContent())
        .labelType(entity.getLabelType())
        .shipDate(entity.getShipDate())
        .expectedDeliveryDate(entity.getExpectedDeliveryDate())
        .trackingNumberUpdatedOnEpic(entity.getTrackingNumberUpdatedOnEpic())
        .podUpdatedOnEpic(entity.getPodUpdatedOnEpic())
        .trackingLastUpdatedAt(entity.getTrackingLastUpdatedAt())
        .trackingLastStatus(entity.getTrackingLastStatus())
        .trackingLastMessage(entity.getTrackingLastMessage())
        .trackingLastScanLocation(entity.getTrackingLastScanLocation())
        .trackingTimezoneOffset(entity.getTrackingTimezoneOffset())
        .returnLabelContent(entity.getReturnLabelContent())
        .returnLabelType(entity.getReturnLabelType())
        .trackingDataSource(entity.getTrackingDataSource())
        .applicationSource(entity.getApplicationSource())
        .podAvailable(entity.getPodAvailable())
        .signatoryName(entity.getSignatoryName())
        .carrierCode(entity.getCarrierCode())
        .carrierScacCode(entity.getCarrierScacCode())
        .userFirstName(entity.getUserFirstName())
