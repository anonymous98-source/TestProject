        .trackingEventReason(entity.getTrackingEventReason())
        .build();
  }

  private TrackingSignatoryDto toTrackingSignatoryDto(TrackingSignatoryEntity entity) {
    return TrackingSignatoryDto.builder()
        .id(entity.getId())
        .signatoryName(entity.getSignatoryName())
