import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;
import java.util.List;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.junit.jupiter.MockitoExtension;

@ExtendWith(MockitoExtension.class)
class SpecificationBuilderTest {

  private SpecificationBuilder specificationBuilder;
  private CriteriaMocks mocks;

  @BeforeEach
  void setUp() {
    specificationBuilder = new SpecificationBuilder();
    mocks = buildMocks();
  }

  // this sucks, but it's faster to do than setting up h2 or something right now.
  private record CriteriaMocks(
      Root<TestFilter> root,
      CriteriaQuery<?> query,
      CriteriaBuilder cb,
      Path<Object> path,
      Predicate equalPredicate,
      Predicate isNullPredicate,
      Predicate orPredicate,
      Predicate andPredicate) {}

  private CriteriaMocks buildMocks() {
    Root<TestFilter> root = mock(Root.class);
    CriteriaQuery<?> query = mock(CriteriaQuery.class);
    CriteriaBuilder cb = mock(CriteriaBuilder.class);
    Path<Object> path = mock(Path.class);
    Predicate equalPredicate = mock(Predicate.class);
    Predicate isNullPredicate = mock(Predicate.class);
    Predicate orPredicate = mock(Predicate.class);
    Predicate andPredicate = mock(Predicate.class);

    lenient().when(root.get(anyString())).thenReturn(path);
    lenient().when(cb.equal(any(), any())).thenReturn(equalPredicate);
    lenient().when(cb.isNull(any())).thenReturn(isNullPredicate);
    lenient().when(cb.or(any(Predicate.class), any(Predicate.class))).thenReturn(orPredicate);
    lenient().when(cb.or(any(Predicate[].class))).thenReturn(orPredicate);
    lenient().when(cb.and(any(Predicate[].class))).thenReturn(andPredicate);

    return new CriteriaMocks(
        root, query, cb, path, equalPredicate, isNullPredicate, orPredicate, andPredicate);
  }

  @Test
  void build_noNullableList() {
    var filter = new TestFilter("John", null);

    var spec = specificationBuilder.build(filter);
    Predicate result = spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    assertThat(result).isNotNull();
    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).and(any(Predicate[].class));
  }

  @Test
  void build_singleField() {
    var filter = new TestFilter("John", null);

    var spec = specificationBuilder.build(List.of(), filter);
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb()).equal(mocks.path(), "John");
  }

  @Test
  void build_multipleFields() {
    var filter = new TestFilter("John", "Smith");

    var spec = specificationBuilder.build(List.of(), filter);
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).equal(mocks.path(), "Smith");
  }

  @Test
  void build_nullableField_camelCase() {
    var filter = new TestFilter("John", null);

    var spec = specificationBuilder.build(List.of("firstName"), filter);
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).isNull(mocks.path());
  }

  @Test
  void build_nullableField_kebabCase() {
    var filter = new TestFilter("John", null);

    var spec = specificationBuilder.build(List.of("first-name"), filter);
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).isNull(mocks.path());
  }

  @Test
  void buildList_singleFilter_delegatesToBuildWithNoNullables() {
    var filters = List.of(new TestFilter("John", null));

    var spec = specificationBuilder.build(filters);
    Predicate result = spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    assertThat(result).isNotNull();
    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).or(any(Predicate[].class));
  }

  @Test
  void buildList_multipleFilters_eachFilterIsORed() {
    var filter1 = new TestFilter("John", "Smith");
    var filter2 = new TestFilter("Jane", "Doe");

    var spec = specificationBuilder.build(List.of(), List.of(filter1, filter2));
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb()).equal(mocks.path(), "John");
    verify(mocks.cb()).equal(mocks.path(), "Smith");
    verify(mocks.cb()).equal(mocks.path(), "Jane");
    verify(mocks.cb()).equal(mocks.path(), "Doe");
    verify(mocks.cb()).or(any(Predicate[].class));
  }

  @Test
  void buildList_nullableFields_appliedToEachFilter() {
    var filter1 = new TestFilter("John", null);
    var filter2 = new TestFilter("Jane", null);

    var spec = specificationBuilder.build(List.of("firstName"), List.of(filter1, filter2));
    spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    verify(mocks.cb(), times(2)).isNull(mocks.path());
    verify(mocks.cb()).or(any(Predicate[].class));
  }

  @Test
  void buildList_emptyFilterList_returnsEmptyOrPredicate() {
    var spec = specificationBuilder.build(List.of(), List.<TestFilter>of());
    var result = spec.toPredicate(mocks.root(), mocks.query(), mocks.cb());

    assertThat(result).isNotNull();
    verify(mocks.cb()).or(any(Predicate[].class));
  }
