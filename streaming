          Map.entry(SaveTrackingServiceImpl.class, ModelConstants.SAVE_TRACKING_WEBHOOK),
          Map.entry(ShipmentServiceImpl.class, ModelConstants.GET_SHIPMENT_ID),
          Map.entry(ShipmentBookDataPersistService.class, ModelConstants.SHIPMENT_BOOK_DATA),
          Map.entry(SftpAccountService.class, ModelConstants.SFTP_FEATURES),
          Map.entry(GetShipmentServiceImpl.class, ModelConstants.GET_SHIPMENT),
          Map.entry(GetShipmentByParentImpl.class, ModelConstants.GET_SHIPMENT_PARENT_ID),
          Map.entry(SaveShipmentService.class, ModelConstants.SAVE_SHIPMENT),
          Map.entry(AlterTrackingServiceImpl.class, ModelConstants.UPDATE_TRACKING),
          Map.entry(FetchColumnFilterServiceImpl.class, ModelConstants.FETCH_COLUMN_FILTERS),
          Map.entry(SendFlexRecordServiceImpl.class, ModelConstants.SENDFLEX_LOGS),
          Map.entry(DeleteTrackingResourceImpl.class, ModelConstants.DELETE_FILTER),
          Map.entry(OspEnrollmentEligibilityService.class, ModelConstants.OSP_ENROLLMENT),
