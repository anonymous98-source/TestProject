    public void writeCsvReport(ShipmentTrackExportReq shipmentTrackExportReq,
                               OutputStream outputStream, String userId,

                               boolean bypassRowLimit) throws CsvReportException {


       try {
           TrackingCsvGenerator<CsvReportDto> csvGenerator =
                   new TrackingCsvGenerator<>(
                           CsvReportDto.class, CsvReportColumns.forRequest(Boolean.TRUE.equals(shipmentTrackExportReq.getIsBeaconPlus()))
                   );
           TrackingDetailsDbResult result;
           int pageNo = 0;

           // set isFirstChunk as true to print header
           boolean isFirstChunk = true;
           do {
               Stopwatch stopwatchFetchDBRecord = Stopwatch.createStarted();
               result = csvReportAdapterImpl.fetchShipmentData(
                       shipmentTrackExportReq, userId, pageNo, pageSize, bypassRowLimit);
               log.atInfo().setMessage("Time taken to fetch data from DB for page: " + pageNo + ServiceCommonConstants.PAGE_SIZE +pageSize).addKeyValue(ServiceCommonConstants.TIME_TAKEN_IN_SECONDS, stopwatchFetchDBRecord.stop().elapsed().toMillis() + "ms").log();
               Stopwatch stopwatchBuildDTO = Stopwatch.createStarted();
               List<CsvReportDto> csvReportDtoList = buildCsvReportDTOs(result, shipmentTrackExportReq);
               log.atInfo().setMessage("Time taken to build CSV report DTO for page: " + pageNo + ServiceCommonConstants.PAGE_SIZE +pageSize).addKeyValue(ServiceCommonConstants.TIME_TAKEN_IN_SECONDS, stopwatchBuildDTO.stop().elapsed().toMillis() + "ms").log();
               Stopwatch stopwatchWriteCSV = Stopwatch.createStarted();
               writeCsvRows(csvReportDtoList, isFirstChunk, outputStream, csvGenerator);
               log.atInfo().setMessage("Time taken to write CSV rows for page: " + pageNo + ServiceCommonConstants.PAGE_SIZE +pageSize).addKeyValue(ServiceCommonConstants.TIME_TAKEN_IN_SECONDS, stopwatchWriteCSV.stop().elapsed().toMillis() + "ms").log();
               // set isFirstChunk as false after first fetch to avoid printing header
               isFirstChunk = false;

               pageNo++;
           } while (result.trackingIdsPage().hasNext());
       }
       catch (ResponseStatusException e) {
           log.atError().setMessage("CSV Report generation failed with ResponseStatusException: ")
                   .addKeyValue("errorType", "ResponseStatusException")
                   .addKeyValue("exceptionClass", e.getClass().getName())
                   .addKeyValue("message", e.getMessage())
                   .addKeyValue("stackTrace", Arrays.toString(e.getStackTrace()))
                   .addKeyValue("timestamp", Instant.now().toString())
                   .addKeyValue("component", "CsvReportShipmentDetailsService").log();
           throw e;
       } catch (Exception e) {
           log.atError().setMessage("CSV Report generation failed: ")
                   .addKeyValue("errorType", "CSVReportException")
                   .addKeyValue("exceptionClass", e.getClass().getName())
                   .addKeyValue("message", e.getMessage())
                   .addKeyValue("stackTrace", Arrays.toString(e.getStackTrace()))
                   .addKeyValue("timestamp", Instant.now().toString())
                   .addKeyValue("component", "CsvReportShipmentDetailsService").log();

           throw new CsvReportException("Not able to process the request.");
       }
    }

    public void writeCsvRows(List<CsvReportDto> dataRows, boolean isFirstChunk,
                             OutputStream outputStream, TrackingCsvGenerator<CsvReportDto> csvGenerator) throws IOException {

        Writer writer = new BufferedWriter(new OutputStreamWriter(outputStream));
        CSVPrinter printer = csvGenerator.createPrinter(writer);

        if (isFirstChunk) {
            log.atInfo().setMessage("this is the first chunk of data, so writing header").log();
            csvGenerator.writeHeader(printer);
        }
        csvGenerator.writeRows(dataRows, printer);

    }

