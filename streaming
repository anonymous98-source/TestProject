import com.cardinalhealth.advship.tracking.resource.proxy.AdvShipProxyWebclient;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.web.util.UriComponentsBuilder;

import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.IS_SHIPMENT;
import static com.cardinalhealth.advship.tracking.resource.constants.TrackingFilterConstants.FACILITY_ID;

@Service
@Slf4j
@RequiredArgsConstructor
public class CommonUtils {

    private final AdvshipTrackingResourceProperties advshipTrackingResourceProperties;
    private final AdvShipProxyWebclient advShipProxyWebclient;
    private final ObjectMapper objectMapper;

    public PremiumFeatureResponse getPremiumAccessLevel() {
        return getPremiumAccessLevelInternal("", false);
    }

    private PremiumFeatureResponse getPremiumAccessLevelInternal(String facilityId, boolean isShipment) {
        log.atInfo().setMessage("Fetching premium subscription details").log();

        // Construct the premium feature URI
        var baseUrl = advshipTrackingResourceProperties.getAdvancedShippingIntegrationBaseUrl();
        var premiumFeaturePath = ServiceCommonConstants.PREMIUM_FEATURE_PATH_URI;
        var premiumFeatureUri = UriComponentsBuilder.fromUriString(baseUrl)
                .path(premiumFeaturePath)
                .queryParam(FACILITY_ID, facilityId)
                .queryParam(IS_SHIPMENT, isShipment)
                .toUriString();

        var responseEntity = advShipProxyWebclient.getApiCall(premiumFeatureUri);

        // Check if the response is successful, if so, parse the body, otherwise throw an exception
        if (responseEntity != null && responseEntity.getStatusCode().is2xxSuccessful()) {
            return objectMapper.convertValue(responseEntity.getBody(), PremiumFeatureResponse.class);
        } else {
            log.atWarn().setMessage("Failed to fetch premium subscription details").log();
            throw new ResourceNotFoundException("Unable to fetch premium subscription details");
        }
    }
}

