   * @throws ValidationException if the tracking number is blank
   */
  @Override
  public TrackingDataStreamResponseDto fetchDataStreamDetails(DataStreamRequest dataStreamRequest) {

    log.atInfo()
            .setMessage("Received request to fetch data stream details")
            .addKeyValue("request", dataStreamRequest)
            .log();
    CompletableFuture<List<TrackingDataStreamPodProjection>> podsFuture;
    if (dataStreamRequest.isFetchingPodRequired()) {
      podsFuture =
          CompletableFuture.supplyAsync(
              () ->
                  trackingPodRepository.findAllPodDetailsByTrackingNumber(
                      dataStreamRequest.getTrackingNumber()),
              defaultAsyncExecutor);
    } else {
      log.atInfo()
              .setMessage("POD fetch not required")
              .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
              .log();
      podsFuture = CompletableFuture.completedFuture(Collections.emptyList());
    }

    var shipmentSource =
        ServiceCommonConstants.NAVIGATION_LEVEL_BOTH.equalsIgnoreCase(
                dataStreamRequest.getNavigationLevel())
            ? List.of(
                ServiceCommonConstants.NAVIGATOR_KEY, ServiceCommonConstants.NON_NAVIGATOR_KEY)
            : List.of(dataStreamRequest.getNavigationLevel());

    CompletableFuture<TrackingDataStreamProjection> trackingDataFuture =
        CompletableFuture.supplyAsync(
            () ->
                trackingRepository.findExternalDataStreamDetails(
                    dataStreamRequest.getTrackingNumber(), shipmentSource),
            defaultAsyncExecutor);

    CompletableFuture<List<TrackingPviCaseProjection>> pviCasesFuture =
        CompletableFuture.supplyAsync(
            () ->
                trackingPviCasesRepository.findAllPviCasesByTrackingNumber(
                    dataStreamRequest.getTrackingNumber()),
            defaultAsyncExecutor);

    CompletableFuture<Optional<SurroundInsightsProjection>> surroundInsightsFuture =
        CompletableFuture.supplyAsync(
            () ->
                surroundInsightsRepository.findAllSurroundInsightsByTrackingNumber(
                    dataStreamRequest.getTrackingNumber()),
            defaultAsyncExecutor);
    CompletableFuture.allOf(trackingDataFuture, podsFuture, pviCasesFuture, surroundInsightsFuture).join();
    TrackingDataStreamProjection trackingData = trackingDataFuture.join();
    List<TrackingDataStreamPodProjection> podList = podsFuture.join();
    List<TrackingPviCaseProjection> pviCaseList = pviCasesFuture.join();
    Optional<SurroundInsightsProjection> surroundInsights = surroundInsightsFuture.join();

    log.atInfo()
            .setMessage("Fetching data stream details from DB")
            .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
            .log();
    trackingData = getTrackingDataStreamProjection(dataStreamRequest, trackingData);
    log.atInfo()
            .setMessage("Data stream details fetch completed")
            .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
            .addKeyValue(
                    "status", trackingData == null ? "not found" : "fetched successfully")
            .log();

    return Optional.ofNullable(trackingData)
            .map(tracking -> mapToResponseDto(tracking, podList, pviCaseList, surroundInsights))
            .orElse(null);
