        .totalPackages(entity.getTotalPackages())
        .uspsAccountNumber(
            "USPS".equalsIgnoreCase(entity.getShipmentCarrierDetails())
                ? entity.getSurroundBillToNumber()
                : null)
        .navigatorLevel(entity.getNavigatorLevel())
        .beaconLevel(entity.getBeaconLevel())
        .accessLevel(AccessLevel.builder().build())
        .createdAt(entity.getShipmentCreatedAt())
        .packages(new ArrayList<>())
        .build();
  }

  public void addExternalReferenceEntity(ShipmentDto dto, ExternalReferenceEntity entity) {
    if (entity == null) return;

    var patientInfo = getPatientInformation(entity);

    dto.setCsn(patientInfo.getPatientCsn());
    dto.setMrn(patientInfo.getPatientMrn());
    dto.setPatientFirstName(patientInfo.getPatientFirstName());
    dto.setPatientLastName(patientInfo.getPatientLastName());
    dto.setPatientMiddleNameOrInitial(patientInfo.getPatientMiddleName());
    dto.setPatientDateOfBirth(
        StringUtils.isBlank(patientInfo.getPatientDateOfBirth())
            ? null
            : LocalDate.parse(
                patientInfo.getPatientDateOfBirth(),
                DateTimeFormatter.ofPattern(PATIENT_DOB_FORMAT)));
    dto.setPatientGender(
        StringUtils.isBlank(patientInfo.getPatientGender())
            ? null
            : switch (Character.toUpperCase(patientInfo.getPatientGender().charAt(0))) {
              case 'M' -> Gender.MALE;
              case 'F' -> Gender.FEMALE;
              default -> null;
            });
  }

  public void addAdditionalServiceShipmentEntity(
      ShipmentDto dto, AdditionalServiceShipmentEntity entity) {
    if (entity == null) return;

    dto.setAdditionalServiceShipmentId(entity.getId());
    dto.setSaturdayPickUp(entity.getSaturdayPickup());
    dto.setSaturdayDelivery(entity.getSaturdayDelivery());
    dto.setReadyTime(entity.getReadyTime());
    dto.setLatestTime(entity.getLatestTime());
    dto.setSignatureRequired(entity.getSignatureRequired());
    dto.setSignatureLevel(entity.getSignatureLevel());
  }

  private PatientInformationDto getPatientInformation(
      ExternalReferenceEntity externalReferenceEntity) {
    if (externalReferenceEntity == null || externalReferenceEntity.getPatientRecord() == null) {
      return new PatientInformationDto();
    }
    try {
      return objectMapper.convertValue(
          externalReferenceEntity.getPatientRecord(), PatientInformationDto.class);
    } catch (Exception e) {
      log.error("Error parsing patient information.", e);
      return new PatientInformationDto();
    }
  }
