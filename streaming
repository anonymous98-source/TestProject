   * @param customerIdList the list of customer IDs to filter by (can be null)
   * @return the trend percentage as a string with 2 decimal places, or null if not applicable
   */
  private String fetchShipmentTrends(
      GraphDataRequestDto graphDataRequestDto, List<String> customerIdList) {
    if (!VisualizationConstant.TAB_NAME_OVERVIEW.equalsIgnoreCase(
        graphDataRequestDto.getVisualizationTabName())) {
      return null; // trend is only applicable for Overview tab
    }

    // fetch trend percentage from materialized view for Overview tab
    String trendResult =
        materializedViewRepository.getTrendPercent(
            graphDataRequestDto.getPeriodInDays(),
            graphDataRequestDto.isIncludeUnverifiedData(),
            List.of(VisualizationConstant.SHIPMENT_SOURCE_NON_NAVIGATOR),
            customerIdList,
            graphDataRequestDto.getFacilityIdList());

    if (StringUtils.isNoneBlank(trendResult)
        && trendResult.contains(VisualizationConstant.DECIMAL_DOT)) {
      // if the result contains a decimal point, return the result formatted to 2 decimal places
      int dotIndex = trendResult.indexOf(VisualizationConstant.DECIMAL_DOT);
      int endIndex = Math.min(trendResult.length(), dotIndex + 3);
      return trendResult.substring(0, endIndex);
