1. search-autocomplete.component.html

Change this

<mat-option
  *ngFor="let option of options"
  [value]="option"
  class="custom-option"
>

To this

<mat-option
  *ngFor="let option of options"
  [value]="option"
  [disabled]="isOptionDisabled(option)"
  class="custom-option"
>

Then your checkbox currently is:

<opti-checkbox
  [checked]="isSelected(option)"
  (click)="$event.stopPropagation()"
  (checkboxChange)="toggleSelection(option)"
  [noFormGroup]="true"
  [title]="
    searchPlaceholder() === AddPanelType.BillingGroup
      ? option.name + ' (' + option.id + ')'
