<div class="configuration-manager">
  <div class="header flex-column">
    <div class="flex flex-space-between">
      <div class="title">{{ config.TITLE }}</div>
      <div
        (click)="onOverviewTabOpened()"
        class="flex flex-align-items-center overview-link"
      >
        {{ config.BROWSE_CONFIGURATION_OVERVIEW }}
      </div>
    </div>
    <div class="subtitle">
      {{ config.SUBTITLE }}
    </div>
  </div>
  <div class="footer flex">
    <div class="box flex-column">
      <div class="box-top flex flex-align-items-center">
        <div class="box-header flex flex-align-items-center">
          {{ config.CUSTOMER }}
        </div>
        <div class="button-wrapper">
          <opti-button
            prefixIcon="add"
            (buttonClick)="openAdditionPanel(AddPanelType.Customer)"
            [buttonTitle]="'Add'"
            buttonType="secondary"
            buttonSize="small"
          ></opti-button>
        </div>
      </div>
      <opti-dropdown
        class="flex flex-align-items-center flex-space-between config-mgmt"
        fieldControlName="customer"
        placeholder="{{ config.CUSTOMER_PLACEHOLDER }}"
        [options]="availableCustomers"
        [form]="contextSelectionForm"
        [useSingleSelect]="true"
      ></opti-dropdown>
    </div>
    <div class="box flex-column">
      <div class="box-top flex flex-align-items-center">
        <div class="box-header flex flex-align-items-center">
          {{ config.BILLING_GROUP }}
        </div>
        <div class="button-wrapper">
          <opti-button
            [isButtonDisabled]="!isCustomerNameSelected"
            (buttonClick)="openAdditionPanel(AddPanelType.BillingGroup)"
            [buttonTitle]="'Add'"
            buttonType="secondary"
            prefixIcon="add"
            buttonSize="small"
          ></opti-button>
        </div>
      </div>
      <opti-dropdown
        [class]="
          'flex flex-align-items-center flex-space-between config-mgmt ' +
          (isBillingGroupsDropdownDisabled ? 'disabled' : '')
        "
        fieldControlName="billingGroup"
        [placeholder]="
          isFechingBillingGroups
            ? config.LOADING
            : config.BILLING_GROUP_PLACEHOLDER
        "
        [options]="availableBillingGroups"
        [form]="contextSelectionForm"
        [disableDropdown]="isBillingGroupsDropdownDisabled"
        [isDropdownDisabled]="isBillingGroupsDropdownDisabled"
        [useSingleSelect]="true"
      ></opti-dropdown>
    </div>
    <div class="box flex-column">
      <div class="box-top flex flex-align-items-center">
        <div class="box-header flex flex-align-items-center">
          {{ config.LOCATION }}
        </div>
        <div class="button-wrapper">
          <opti-button
            [isButtonDisabled]="!isBillingGroupNameSelected"
            (buttonClick)="openAdditionPanel(AddPanelType.Location)"
            [buttonTitle]="'Add'"
            prefixIcon="add"
            buttonType="secondary"
            buttonSize="small"
          ></opti-button>
        </div>
      </div>
      <opti-dropdown
        [class]="
          'flex flex-align-items-center flex-space-between config-mgmt ' +
          (isLocationsDropdownDisabled ? 'disabled' : '')
        "
        fieldControlName="location"
        [placeholder]="
          isFechingLocations ? config.LOADING : config.LOCATION_PLACEHOLDER
        "
        [options]="availableLocations"
        [form]="contextSelectionForm"
        [disableDropdown]="isLocationsDropdownDisabled"
        [isDropdownDisabled]="isLocationsDropdownDisabled"
        [useSingleSelect]="true"
        [showTooltip]="true"
      ></opti-dropdown>
    </div>
  </div>
</div>
<div class="addition-panel" *ngIf="showAdditionPanel">
  <app-addition-panel
    [panelType]="addPanelType"
    (close)="onCloseAdditionPanel()"
    (saved)="updateDropdown($event)"
  ></app-addition-panel>
</div>
import { BillingGroup } from './../../models/billing-group';
import { CommonModule } from '@angular/common';
import { Component, input, OnInit, output } from '@angular/core';
import { NonNullableFormBuilder } from '@angular/forms';
import {
  debounceTime,
  filter,
  map,
  mergeMap,
  switchMap,
  take,
  tap,
} from 'rxjs';
import { AdditionPanelComponent } from '../addition-panel/addition-panel.component';
import { ConfigurationContext } from '../../models/configuration-context';
import { DropdownType } from '../../models/dropdown-type';
import { BillingGroupService } from '../../services/billing-group/billing-group.service';
import { CustomerService } from '../../services/customer/customer.service';
import { DataShareService } from '../../services/data-share.service';
import { LocationService } from '../../services/location/location.service';
import { UtilityService } from '../../services/utility.service';
import { CONFIGURATION_MANAGEMENT } from '../../constants/component.constant';
import { ContextEntity } from '../../types/context-entity';
import { AddPanelType } from '../../enums/component.enum';
import {
  OptiButtonComponent,
  OptiDropdownComponent,
} from '@ofl-next/advship-core-components';

@Component({
  selector: 'app-configuration-management',
  imports: [
    OptiButtonComponent,
    OptiDropdownComponent,
    AdditionPanelComponent,
    CommonModule,
  ],
  templateUrl: './configuration-management.component.html',
  styleUrl: './configuration-management.component.scss',
})
export class ConfigurationManagementComponent implements OnInit {
  protected readonly config = CONFIGURATION_MANAGEMENT;

  protected availableCustomers: DropdownType[] = [];
  protected availableBillingGroups: DropdownType[] = [];
  protected availableLocations: DropdownType[] = [];

  protected readonly contextSelectionForm = this.fb.group<ConfigurationContext>(
    {
      customer: null,
      billingGroup: null,
      location: null,
    }
  );

  protected isFechingBillingGroups = false;
  protected isFechingLocations = false;

  // Addition panel state
  protected addPanelType: AddPanelType = AddPanelType.None;
  protected showAdditionPanel = false;

  prefillCustomerId = input<string | null>();
  prefillBillingGroupId = input<string | null>();
  prefillLocationId = input<string | null>();
  isOverviewTabOpened = output<boolean>();

  protected readonly AddPanelType = AddPanelType;

  constructor(
    private readonly fb: NonNullableFormBuilder,
    private readonly utilService: UtilityService,
    private readonly customerService: CustomerService,
    private readonly billingGroupService: BillingGroupService,
    private readonly locationService: LocationService,
    private readonly dataShareService: DataShareService
  ) {}

  ngOnInit() {
    this.dataShareService.isTermsAccepted$
      .pipe(
        filter((isAccepted) => isAccepted),
        mergeMap(() => this.customerService.list()),
        map((customers) =>
          this.generateDropdownOptions(customers, AddPanelType.Customer)
        ),
        take(1)
      )
      .subscribe((customers) => {
        this.availableCustomers = customers;
        if (this.prefillCustomerId()) {
          const found = this.availableCustomers.find(
            (customer) => customer.value.customerId === this.prefillCustomerId()
          );
          if (found) {
            this.customerControl.setValue(found.value);
          }
        }
      });

    // Debounce prevents rapid successive emissions caused by multiple dropdown changes.
    // For example, changing customer may emit 3 times, billing 2 times, and location once.
    // This ensures only the final stabilized value after 100ms is processed
    this.contextSelectionForm.valueChanges
      .pipe(
        debounceTime(CONFIGURATION_MANAGEMENT.DEBOUNCE_TIME_MS),
        map((value) => ({
          customer: value.customer ?? null,
          billingGroup: value.billingGroup ?? null,
          location: value.location ?? null,
        }))
      )
      .subscribe((value) => this.utilService.selectedContext$.next(value));

    this.customerControl.valueChanges
      .pipe(
        tap(() => {
          this.billingGroupControl.reset();
          this.isFechingBillingGroups = true;
        }),
        filter((customer) => !!customer),
        switchMap((customer) =>
          this.billingGroupService.list(customer.customerId)
        ),
        map((billingGroups) =>
          this.generateDropdownOptions(billingGroups, AddPanelType.BillingGroup)
        ),
        tap(() => (this.isFechingBillingGroups = false))
      )
      .subscribe((billingGroups) => {
        this.availableBillingGroups = billingGroups;
        if (this.prefillBillingGroupId()) {
          const foundBilling = this.availableBillingGroups.find(
            (billingGroup) =>
              billingGroup.value.billingGroupId === this.prefillBillingGroupId()
          );
          if (foundBilling) {
            this.billingGroupControl.setValue(foundBilling.value);
          }
        }
      });

    this.billingGroupControl.valueChanges
      .pipe(
        tap(() => this.locationControl.reset()),
        filter((billingGroup) => billingGroup !== null),
        tap(() => (this.isFechingLocations = true)),
        switchMap((billingGroup) =>
          this.locationService.list(
            this.customerControl.value!.customerId,
            billingGroup.billingGroupId
          )
        ),
        map((locations) =>
          this.generateDropdownOptions(locations, AddPanelType.Location)
        ),
        tap(() => (this.isFechingLocations = false))
      )
      .subscribe((locations) => {
        this.availableLocations = locations;
        if (this.prefillLocationId()) {
          const foundLocation = this.availableLocations.find(
            (location) => location.value.facilityId === this.prefillLocationId()
          );
          if (foundLocation) {
            this.locationControl.setValue(foundLocation.value);
          }
        }
      });
  }

  get customerControl() {
    return this.contextSelectionForm.get('customer')!;
  }

  get billingGroupControl() {
    return this.contextSelectionForm.get('billingGroup')!;
  }

  get locationControl() {
    return this.contextSelectionForm.get('location')!;
  }

  get isCustomerNameSelected() {
    return !!this.customerControl.value;
  }

  get isBillingGroupNameSelected() {
    return !!this.billingGroupControl.value;
  }

  get isBillingGroupsDropdownDisabled() {
    return !this.isCustomerNameSelected || this.isFechingBillingGroups;
  }

  get isLocationsDropdownDisabled() {
    return !this.isBillingGroupNameSelected || this.isFechingLocations;
  }

  private generateDropdownOptions(
    entites: ContextEntity[],
    type: AddPanelType
  ) {
    console.log('code reached here', type);
    return entites.map((entity: any) => ({
      value: entity,
      viewValue:
        type === AddPanelType.BillingGroup
          ? `${entity.name} (${(entity as BillingGroup).billingGroupId})`
          : entity.name,
      disabled: !entity.active,

      // Only for Location dropdown
      tooltip:
        type === AddPanelType.Location
          ? entity.facilityId
          : undefined,
    }));
  }

  openAdditionPanel(type: AddPanelType) {
    this.addPanelType = type;
    this.showAdditionPanel = true;
  }

  // Handle close event from child
  onCloseAdditionPanel() {
    this.showAdditionPanel = false;
    // Reset parameters to no-op functions
    this.addPanelType = AddPanelType.None;
  }

  onOverviewTabOpened() {
    this.isOverviewTabOpened.emit(true);
  }

  updateDropdown(addedEntities: ContextEntity[]) {
    switch (this.addPanelType) {
      case AddPanelType.Customer: {
        const addedCustomers = this.generateDropdownOptions(
          addedEntities,
          AddPanelType.Customer
        );

        this.availableCustomers.push(...addedCustomers);
        this.availableCustomers.sort((a, b) =>
          a.viewValue.localeCompare(b.viewValue)
        );
        break;
      }

      case AddPanelType.BillingGroup: {
        const addedBillingGroup = this.generateDropdownOptions(
          addedEntities,
          AddPanelType.BillingGroup
        );

        this.availableBillingGroups.push(...addedBillingGroup);
        this.availableBillingGroups.sort((a, b) =>
          a.viewValue.localeCompare(b.viewValue)
        );
        break;
      }

      case AddPanelType.Location: {
        const addedLocations = this.generateDropdownOptions(
          addedEntities,
          AddPanelType.Location
        );

        this.availableLocations.push(...addedLocations);
        this.availableLocations.sort((a, b) =>
          a.viewValue.localeCompare(b.viewValue)
        );
        break;
      }
    }
  }
}
