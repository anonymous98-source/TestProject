package com.cardinalhealth.advship.tracking.resource.visualization.db.repo;

import com.cardinalhealth.advship.tracking.resource.visualization.db.entity.AddressAdherenceMaterializedViewEntity;
import com.cardinalhealth.advship.tracking.resource.visualization.db.projection.AddressAdherenceUsageProjection;
import java.util.List;
import java.util.UUID;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

@Repository
public interface AddressAdherenceMVRepository
    extends JpaRepository<AddressAdherenceMaterializedViewEntity, UUID> {

  @Query(
      value =
          """
            WITH date_series AS (
                SELECT
                    CASE
                        WHEN :periodInDays <= 30
                            THEN (CURRENT_DATE - INTERVAL '1 day' * gs.n)::date
                        ELSE (date_trunc('week', CURRENT_DATE) - INTERVAL '1 week' * gs.n)::date
                    END AS groupedPeriod
                FROM generate_series(
                    0,
                    CASE
                        WHEN :periodInDays <= 30 THEN :periodInDays
                        ELSE (
                            EXTRACT(EPOCH FROM (date_trunc('week', CURRENT_DATE) - date_trunc('week', CURRENT_DATE - INTERVAL '1 day' * (:periodInDays)))) / (7 * 24 * 60 * 60)
                        )::int
                    END
                ) AS gs(n)
            ),
            filtered_data AS (
                SELECT
                    CASE
                        WHEN :periodInDays > 30 THEN TO_CHAR(vw.shipment_created_at_week_start, 'YYYY-MM-DD')::date
                        ELSE TO_CHAR(vw.shipment_created_at, 'YYYY-MM-DD')::date
                    END AS groupedPeriod,
