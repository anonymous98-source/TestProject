  public List<HcidDto> mapToHcidDtos(List<String> hcidCodes, List<String> hcidTemperatureCodes) {
    List<String> hcids =
        Optional.ofNullable(hcidCodes).orElse(Collections.emptyList()).stream()
            .filter(Objects::nonNull)
            .filter(code -> !code.equalsIgnoreCase(ServiceCommonConstants.NULL) && !code.isBlank())
            .distinct()
            .toList();

    List<String> hcidTemp =
        Optional.ofNullable(hcidTemperatureCodes).orElse(Collections.emptyList()).stream()
            .filter(Objects::nonNull)
            .filter(code -> !code.equalsIgnoreCase(ServiceCommonConstants.NULL) && !code.isBlank())
            .distinct()
            .toList();

    List<HcidDto> result = new ArrayList<>();

    for (String hcid : hcids) {
      if (ServiceCommonConstants.HCT.equalsIgnoreCase(extractCode(hcid))) {
        getHcidsTempData(hcid, hcidTemp, result);
      } else {
        String code = extractCode(hcid);
        String name = extractName(hcid);

        if (code != null && name != null && !code.isBlank() && !name.isBlank()) {
          result.add(HcidDto.builder().code(code).name(name).tempCode(null).tempName(null).build());
        }
      }
    }

    return result;
  }

  private static void getHcidsTempData(String hcid, List<String> hcidTemp, List<HcidDto> result) {
    for (String temp : hcidTemp) {
      String tempCode = extractCode(temp);
      String tempName = extractName(temp);

      if (tempCode != null && tempName != null && !tempCode.isBlank() && !tempName.isBlank()) {
        result.add(
            HcidDto.builder()
                .code(extractCode(hcid))
                .name(extractName(hcid))
                .tempCode(tempCode)
                .tempName(tempName)
                .build());
      }
    }
  }

  private static String extractCode(String value) {
    if (value == null || !value.contains(":")) return "";
    return value.split(":")[0];
  }

  private static String extractName(String value) {
    if (value == null || !value.contains(":")) return "";
    String[] parts = value.split(":", 2);
    return parts.length > 1 ? parts[1] : "";
  }

  /**
   * Get OptiFreight Shipment Protection (OSP) details for the given package.
   *
   * @return A string representing the OSP protection amount or failure message, or null if not
   *     applicable.
   */
  private String getOSPProtectionDetails(
      TrackingDetailsProjection trackingDetailsProjection,
      List<ShipmentProtectionEnrollmentProjection> shipmentProtectionEnrollments) {
    String trackingNumber = trackingDetailsProjection.getTrackingNumber();
    if (StringUtils.isBlank(trackingNumber)) {
      log.atInfo()
              .setMessage(
                      "Empty additionalServicePackage or trackingNumber is not present for packge")
              .addKeyValue("packageId", trackingDetailsProjection.getPackageId())
              .log();
      return null;
    }

    // Check if OptiFreight shipmentEntity protection (OSP) is enrolled via Save Election API
    ShipmentProtectionEnrollmentProjection shipmentProtectionEnrollmentProjection =
        Optional.ofNullable(shipmentProtectionEnrollments).orElse(Collections.emptyList()).stream()
            .filter(
                enrollment ->
                    Objects.equals(
                        trackingNumber, enrollment.getShipmentProtectionTrackingNumber()))
            .findFirst()
            .orElse(null);

    // If enrollment failed after Max retries, show failure message
    if (shipmentProtectionEnrollmentProjection != null
        && !String.valueOf(HttpStatus.OK.value())
            .equalsIgnoreCase(
                shipmentProtectionEnrollmentProjection.getShipmentProtectionEnrollmentStatusCode())
        && shipmentProtectionEnrollmentProjection.getShipmentProtectionEnrollmentRetrySequence()
            >= ServiceCommonConstants.OSP_ENROLLMENT_MAX_RETRY) {

      log.atInfo()
              .setMessage("OSP enrollment failed")
              .addKeyValue("trackingNumber", trackingNumber)
              .addKeyValue(
                      "statusCode",
                      shipmentProtectionEnrollmentProjection
                              .getShipmentProtectionEnrollmentStatusCode())
              .addKeyValue(
                      "errorMessage",
                      shipmentProtectionEnrollmentProjection
                              .getShipmentProtectionEnrollmentErrorMessage())
              .log();
      return ServiceCommonConstants.OSP_ENROLLMENT_FAILED_TRACKING_SCREEN_MESSAGE;
    }

    // If enrolled successfully or not yet enrolled, then show the protection amount
    return ServiceCommonConstants.DOLLAR_SYMBOL
        + trackingDetailsProjection.getShipmentProtectionAmount()
        + " "
        + ServiceCommonConstants.OPTIFREIGHT_SHIPMENT_PROTECTION;
  }

  private String calculateAtRiskIndicator(
      TrackingDetailsProjection projection, String latestTrackingStatus) {
    // Void shipments do not show an at-risk indicator.
    if (latestTrackingStatus != null && latestTrackingStatus.trim().equalsIgnoreCase("void")) {
      return "NONE";
    }
    // Delivered shipments do not show an at-risk indicator.
    if (latestTrackingStatus != null && latestTrackingStatus.trim().equalsIgnoreCase("delivered")) {
      return "NONE";
    }
    Integer score = projection.getAtRiskScore();
    if (score == null) score = 0;
    if (score >= 40) return "RED"; // delayed
    if (score >= 20) return "YELLOW"; // at risk
    return "GREEN";
  }
