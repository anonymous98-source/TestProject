@Override
public AddressValidationResponseDTO validateAddress(
    AddressValidationRequest addressValidationRequest) throws JsonProcessingException {

  AddressValidationRequestDTO addressValidationRequestDTO =
      buildAddressValidationRequestDTO(addressValidationRequest);

  Mono<AddressValidationResponseDTO> monoAddressValidationResponse =
      sendFlexWebClientService.sendFlexRequest(
          ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT,
          HttpMethod.POST,
          Map.of(),
          addressValidationRequestDTO,
          AddressValidationResponseDTO.class);

  try {

    AddressValidationResponseDTO addressValidationResponseDTO =
        monoAddressValidationResponse.block();

    persistAddressValidationResponse(
        addressValidationRequestDTO,
        addressValidationResponseDTO);

    return addressValidationResponseDTO;

  } catch (ValidationException exception) {

    log.warn(
        new LogBuilder()
            .withReason(exception.getMessage())
            .withMessage("SendFlex address validation failed")
            .toString());

    persistAddressValidationValidationFailure(
        addressValidationRequestDTO,
        exception);

    return buildAddressValidationErrorResponse(addressValidationRequest);
    
  } catch (Exception exception) {

    persistAddressValidationFailure(
        addressValidationRequestDTO,
        exception);

    throw new ShippingIntegrationException(
        "An unexpected error occurred while saving address validation response "
            + exception.getMessage(),
        exception);
  }
}


