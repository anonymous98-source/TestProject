public enum TrackingSource {
  FEDEX (PubSubConstants.FEDEX),
  USPS (PubSubConstants.USPS),
  OPTI_FREIGHT_LOGISTICS (PubSubConstants.OPTIFREIGHT_LOGISTICS);

  private final String symbol;
  TrackingSource(String s) {
    this.symbol = s;
  }

  @Override
  public String toString() {
    return symbol;
  }
  public static TrackingSource fromString(String source) {
    source = StringUtils.isBlank(source) ? "" : source;
    for (TrackingSource s : values()) {
      if (s.symbol.equalsIgnoreCase(source)) return s;
    }
    return null;

  }
}

