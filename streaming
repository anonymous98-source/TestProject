Absolutely. You can replace the existing RetryConfig completely with this version. It keeps the existing retry behavior/configuration and adds logging for every actual retry attempt.

package com.cardinalhealth.advship.webhook.outbound.data.processor.config;

import com.cardinalhealth.advship.webhook.outbound.data.processor.constant.WebhookOutboundDataProcessorConstants;
import com.cardinalhealth.ofl.next.logging.library.LogBuilder;
import java.time.Duration;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.reactive.function.client.WebClientResponseException;
import reactor.util.retry.Retry;
import reactor.util.retry.Retry.RetrySignal;

@Slf4j
@Configuration
@RequiredArgsConstructor
public class RetryConfig {

    private final WebhookOutboundDataProcessorProperties properties;

    /**
     * Creates a Retry object with config driven maximum number of attempts
     * and an initial delay for internal API calls.
     *
     * @return a Retry object configured with the specified parameters
     */
    public Retry createRetry() {
        return Retry.backoff(
                        properties.getInternal().getMaxRetries(),
                        Duration.ofSeconds(
                                properties.getInternal().getInitialRetryDelay()))
                .maxBackoff(
                        Duration.ofSeconds(
                                properties.getInternal().getMaxBackoff()))
                .jitter(
                        properties.getInternal().getJitterFactor())
                .filter(this::isRetryable)
                .doBeforeRetry(this::logRetry);
    }

    /**
     * Determines if a request is retryable based on the exception type and status code.
     * Retry will happen for 5XX errors and also for network issues and unknown exceptions.
     *
     * @param throwable the exception thrown during the request
     * @return true if the request is retryable, false otherwise
     */
    public boolean isRetryable(Throwable throwable) {

        if (throwable instanceof WebClientResponseException ex) {
            int statusCode = ex.getStatusCode().value();

            return statusCode >= WebhookOutboundDataProcessorConstants.API_HTTP_STATUS_CODE_500
                    && statusCode < WebhookOutboundDataProcessorConstants.API_HTTP_STATUS_CODE_600;
        }

        return true;
    }

    /**
     * Logs details for every retry attempt.
     */
    private void logRetry(RetrySignal retrySignal) {

        Throwable failure = retrySignal.failure();

        LogBuilder logBuilder = new LogBuilder()
                .withMessage("Retrying internal API request")
                .withField(
                        "retryAttempt",
                        retrySignal.totalRetries() + 1)
                .withField(
                        "exceptionClass",
                        failure.getClass().getName())
                .withField(
                        "message",
                        failure.getMessage())
                .withCause(failure);

        if (failure instanceof WebClientResponseException ex) {
            logBuilder.withField(
                    "statusCode",
                    ex.getStatusCode().value());
        }

        log.warn(logBuilder.toString());
    }
}

What this gives you

For a 500/503:

Retrying internal API request
retryAttempt=1
exceptionClass=WebClientResponseException
message=503 Service Unavailable
statusCode=503

Then:

Retrying internal API request
retryAttempt=2
...

And so on for every actual retry.

The existing:

maxRetries

initialRetryDelay

maxBackoff

jitter

5xx retry behavior

network/unknown exception retry behavior


are all preserved.

The only functional addition is:

.doBeforeRetry(this::logRetry)

So this is safe to use as a direct replacement for the current class.