        String bucketName = "bucket";
        String filePath = "file.csv";
        byte[] data = "test-data".getBytes();

        when(storage.writer(any(BlobInfo.class))).thenReturn(writeChannel);
        when(writeChannel.write(any(ByteBuffer.class))).thenReturn(0);
        doNothing().when(writeChannel).close();

        StreamingResponseBody responseBody = outputStream -> outputStream.write(data);

        gcsService.publish(bucketName, filePath, responseBody);

        ArgumentCaptor<ByteBuffer> captor = ArgumentCaptor.forClass(ByteBuffer.class);
        verify(writeChannel, atLeastOnce()).write(captor.capture());
        ByteBuffer writtenBuffer = captor.getValue();
        byte[] writtenBytes = new byte[writtenBuffer.remaining()];
        writtenBuffer.get(writtenBytes);
        assertArrayEquals(data, writtenBytes);
        verify(writeChannel, times(1)).close();
    }

