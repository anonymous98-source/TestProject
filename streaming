  private void addShipmentLevelServices(
      TrackingDetailsProjection trackingDetailsProjection, List<String> services) {
    if (Boolean.TRUE.equals(trackingDetailsProjection.getSaturdayPickup())) {
      services.add(ServiceCommonConstants.SATURDAY_PICKUP);
    }
    if (Boolean.TRUE.equals(trackingDetailsProjection.getSignatureRequired())) {
      services.add(trackingDetailsProjection.getSignatureLevel());
    }
  }

  private void addPackageLevelServices(
      TrackingDetailsProjection trackingDetailsProjection, List<String> services) {
    if (Boolean.TRUE.equals(trackingDetailsProjection.getIsColdChain())) {
      services.add(ServiceCommonConstants.COLD_CHAIN);
    }
    if (trackingDetailsProjection.getLithiumBattery() != null
        && !trackingDetailsProjection.getLithiumBattery().isEmpty()) {
      services.add(ServiceCommonConstants.LITHIUM_BATTERIES);
    }
  }

  private void addInsuranceAndNotification(
      TrackingDetailsProjection trackingDetailsProjection,
      List<ShipmentProtectionEnrollmentProjection> shipmentProtectionEnrollments,
      List<NotificationProjection> notifications,
      List<String> services) {
    String insuranceDetails =
        getInsuranceDetails(trackingDetailsProjection, shipmentProtectionEnrollments);
    if (insuranceDetails != null) {
      services.add(insuranceDetails);
    }
    String firstEmail = getNotificationDetails(notifications);
    if (firstEmail != null) {
      services.add("Subscribe to email updates");
