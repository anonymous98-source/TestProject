  public void saveExternalReference(ShipmentPackageDto shipmentPackageDto, PackageEntity pkg) {
    var packageExternalReferenceDto = shipmentPackageDto.getPackageExternalReferenceDto();
    if (packageExternalReferenceDto != null) {
      var externalReferenceEntity =
          ExternalReferenceEntity.builder()
              .externalOrderId(
                  packageExternalReferenceDto.getExternalOrderId() != null
                      ? packageExternalReferenceDto.getExternalOrderId().toString()
                      : null)
              .packageId(pkg.getId())
              .externalReferenceName(ServiceCommonConstants.EPIC)
              .externalReferenceValueJson(packageExternalReferenceDto.getExternalReferenceValue())
              .patientRecord(packageExternalReferenceDto.getPatientRecord())
              .build();
      externalReferenceRepository.save(externalReferenceEntity);
    }
  }

