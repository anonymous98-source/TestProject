import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
@RequiredArgsConstructor
class SftpAccountDetailsWriter {
  private final GoAnywhereWebClient goAnywhereWebClient;
  private final JAXBContext jaxbContext;

  public Mono<ResponseEntity<Void>> saveSftpAccountDetails(
      List<SftpAccountDetailsDTO> sftpAccountDetailsDTOS) {
    var configXml = toXml(mapSftpAccountDetailsDTOsToProject(sftpAccountDetailsDTOS));

    return goAnywhereWebClient.saveConfigurations(configXml);
  }

  private GoAProject mapSftpAccountDetailsDTOsToProject(List<SftpAccountDetailsDTO> dtos) {
    List<GoACallProject> goACallProjects =
        dtos == null
            ? List.of()
            : dtos.stream()
                .sorted((a, b) -> a.getCustomerId().compareTo(b.getCustomerId()))
                .map(
                    dto -> {
                      List<GoAVariable> goAVariables =
                          List.of(
                              new GoAVariable("customerId", dto.getCustomerId().toString()),
                              new GoAVariable("sftpHost", dto.getSftpHost()),
                              new GoAVariable(
                                  "sftpPort",
                                  ObjectUtils.isEmpty(dto.getSftpPort())
                                      ? "22"
                                      : dto.getSftpPort()),
                              new GoAVariable("sftpUserName", dto.getSftpUserName()),
                              new GoAVariable("sftpUserPassword", dto.getSftpUserPassword()),
                              new GoAVariable(
                                  "accountStatus",
                                  ObjectUtils.isEmpty(dto.getAccountStatus())
                                      ? "active"
                                      : dto.getAccountStatus().toLowerCase()),
                              new GoAVariable(
                                  "sftpFolder",
                                  trimLeadingAndTrailingSlashesFromPath(dto.getPath())));
                      return new GoACallProject(
                          dto.getCustomerId().toString(),
                          "/advship/Advship",
                          true,
                          "1.0",
                          "continue",
                          goAVariables);
                    })
                .toList();

    var module = new GoAModule("Main", goACallProjects);

    return new GoAProject(
        "Customer Configs",
        "Main",
        "2.0",
        "verbose",
        true,
        module,
        List.of(new GoAVariable("environment", "")));
  }

  @NotNull
  private static String trimLeadingAndTrailingSlashesFromPath(String path) {
    if (ObjectUtils.isEmpty(path)) {
      return "";
    }
    return path.replaceAll("(^/+)|(/+$)", "");
  }

  @SneakyThrows
  private String toXml(GoAProject goAProject) {
    Marshaller marshaller = jaxbContext.createMarshaller();
    marshaller.setProperty(Marshaller.JAXB_FORMATTED_OUTPUT, Boolean.TRUE);
    StringWriter writer = new StringWriter();
    marshaller.marshal(goAProject, writer);
    return writer.toString();
  }
}

