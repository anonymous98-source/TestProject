package com.cardinalhealth.advship.tracking.resource.utils;

import com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants;
import com.fasterxml.jackson.databind.JsonNode;
import lombok.extern.slf4j.Slf4j;

import java.time.LocalDate;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.stream.Collectors;
import java.util.stream.StreamSupport;

@Slf4j
public final class ViewFilterJsonConverter {

    private static final DateTimeFormatter API_DATE_FMT = DateTimeFormatter.ofPattern("yyyy-MM-dd");
    private static final String LAST_SCAN_COLID = "last_scan";
    private static final String CARRIER = "carrier";

    private static final Map<String, String> COLID_TO_SORT_COLUMN = Map.ofEntries(
            Map.entry("tracking_number",  "trackingNumber"),
            Map.entry(CARRIER, CARRIER),
            Map.entry("service_line",     "shipmentServiceLevel"),
            Map.entry("status",           "trackingStatus"),
            Map.entry("arriving",         "deliveryDate"),
            Map.entry("ship_date",        "shipDate"),
            Map.entry(LAST_SCAN_COLID,        "lastScanned")
    );

    private ViewFilterJsonConverter() { }

    public  static Map<String,String> buildStandardViewFilters(String viewName, String timeZone)
    {
        Map<String,String> filterMap = new HashMap<>();
        var today = LocalDate.now();
        String startDate;
        String filterValues = viewName;
        if (viewName.equalsIgnoreCase("At risk") || viewName.equalsIgnoreCase("Delayed")) {
            if (viewName.equalsIgnoreCase("At risk")) {
                filterValues = "At risk of delay";
            } else if (viewName.equalsIgnoreCase("Delayed")) {
                filterValues = "Delayed, At risk of further delay";
            }
             filterMap.put(ServiceCommonConstants.STATUS_CONDITION, filterValues);
        } else {

             addRequiredKeyInFilters(viewName, filterMap, timeZone);
        }

        startDate = today.minusDays(31).format(API_DATE_FMT);
        String endDate= today.format(API_DATE_FMT);
        filterMap.put("startDate", startDate);
        filterMap.put("endDate", endDate);
        return filterMap;
    }

    public static void addRequiredKeyInFilters(String viewName, Map<String,String> filterMap, String timeZone) {
       LocalDate today = LocalDate.now(ZoneId.of(timeZone));
       String todayFormatted = today.format(API_DATE_FMT);

        if (viewName.equalsIgnoreCase(ServiceCommonConstants.ARRIVING_TODAY)) {
            filterMap.put(ServiceCommonConstants.ARRIVING_DATE, todayFormatted);
        } else if (viewName.equalsIgnoreCase(ServiceCommonConstants.CREATED_TODAY)) {
            filterMap.put(ServiceCommonConstants.CREATED_DATE, todayFormatted);
        } else if (viewName.equalsIgnoreCase(ServiceCommonConstants.DELIVERED_TODAY_STATUS)) {
            filterMap.put(ServiceCommonConstants.DELIVERED_DATE, todayFormatted);
        }

    }

    public static Map<String, String> convert(JsonNode viewFilterJson) {
        Map<String, String> filters = new HashMap<>();

        if (viewFilterJson == null || viewFilterJson.isNull() || !viewFilterJson.isObject()) {
            return filters;
        }

        mapSetFilter(viewFilterJson, CARRIER,         "carriers",     filters);
        mapSetFilter(viewFilterJson, "service_line",    "serviceLines", filters);
        mapSetFilter(viewFilterJson, "status",          "statuses",     filters);
        // case status filter
        mapSetFilter(viewFilterJson, "caseStatus",          "caseStatus",     filters);
        // caseSubCategory filter
        mapSetFilter(viewFilterJson, "caseSubCategory",          "caseSubCategory",     filters);
        // caseType filter
        mapSetFilter(viewFilterJson, "caseType",          "caseType",     filters);

        // caseCount filter
        mapSetFilter(viewFilterJson, "caseCount",          "caseCount",     filters);
        // surroundDeliveryPrediction filter
        mapSetFilter(viewFilterJson, "surroundDeliveryPrediction",          "surroundDeliveryPrediction",     filters);

        // senseawareMobile filter
        mapSetFilter(viewFilterJson, "senseawareMobile",          "senseawareMobile",     filters);

        // surroundHcid filter
        mapSetFilter(viewFilterJson, "surroundHcid",          "surroundHcid",     filters);

        // interventionRequested filter
        mapSetFilter(viewFilterJson, "interventionRequested",          "interventionRequested",     filters);

        // interventionStatus filter
        mapSetFilter(viewFilterJson, "interventionStatus",          "interventionStatus",     filters);


        mapSingleDateFilter(viewFilterJson, "arriving",  "arrivingDate", filters);
        mapDateRangeFilter (viewFilterJson, "ship_date", "shipDateStart", "shipDateEnd", filters);

        JsonNode activeShipmentsNode = viewFilterJson.get("activeShipments");
        if (activeShipmentsNode != null && !activeShipmentsNode.isNull()) {
            resolveActiveShipmentsDateRange(activeShipmentsNode.asText(), filters);
        }

        JsonNode buttonFilterNode = viewFilterJson.get("statusCondition");
        if (buttonFilterNode != null && !buttonFilterNode.isNull()) {
            String buttonFilter = buttonFilterNode.asText("").strip();
            if (!buttonFilter.isEmpty()) {
                filters.put("buttonFilter", buttonFilter);
            }
        }

        return filters;
    }

    public static List<String> extractShippingLocations(JsonNode viewFilterJson) {
        if (viewFilterJson == null || viewFilterJson.isNull()) return List.of();
        JsonNode node = viewFilterJson.get("shippingLocations");
        if (node == null || node.isNull()) return List.of();
        JsonNode values = node.get("values");
        if (values == null || !values.isArray()) return List.of();
        return StreamSupport.stream(values.spliterator(), false)
                .map(JsonNode::asText)
                .filter(s -> !s.isBlank())
                .collect(Collectors.toList());
    }

    public static boolean extractMyShipment(JsonNode viewFilterJson) {
        if (viewFilterJson == null || viewFilterJson.isNull()) return true;
        JsonNode node = viewFilterJson.get("myShipment");
        if (node == null || node.isNull()) return true;
        return node.asBoolean(true);
    }


    public static boolean extractNonNavigator(JsonNode viewFilterJson) {
        if (viewFilterJson == null || viewFilterJson.isNull()) return false;
        JsonNode node = viewFilterJson.get("nonNavigator");
        if (node == null || node.isNull()) return false;
        return node.asBoolean(false);
    }

    public static Optional<SortInfo> extractSortingInfo(JsonNode viewFilterJson) {
        if (viewFilterJson == null || viewFilterJson.isNull()) return Optional.empty();

        JsonNode columnsNode = viewFilterJson.get("columns");
        if (columnsNode == null || !columnsNode.isArray()) return Optional.empty();

        JsonNode sortedColumn = null;
        int lowestSortIndex = Integer.MAX_VALUE;

        for (JsonNode col : columnsNode) {
            JsonNode sortNode = col.get("sort");
            if (sortNode == null || sortNode.isNull() || sortNode.asText("").isBlank()) continue;

            JsonNode sortIndexNode = col.get("sortIndex");
            int sortIndex = (sortIndexNode == null || sortIndexNode.isNull())
                    ? 0
                    : sortIndexNode.asInt(0);

            if (sortIndex < lowestSortIndex) {
                lowestSortIndex = sortIndex;
                sortedColumn = col;
            }
        }

        if (sortedColumn == null) return Optional.empty();

        JsonNode colIdNode = sortedColumn.get("colId");
        if (colIdNode == null || colIdNode.isNull()) {
            log.warn("Sorted column is missing 'colId' – skipping sort");
            return Optional.empty();
        }

        String colId     = colIdNode.asText("");
        String direction = sortedColumn.get("sort").asText("").toLowerCase();

        String backendColumn = COLID_TO_SORT_COLUMN.getOrDefault(colId, "");
        if (backendColumn.isEmpty()) {
            log.warn("No backend sort-column mapping found for colId '{}' – skipping sort", colId);
            return Optional.empty();
        }

        if (LAST_SCAN_COLID.equals(colId)) {
            direction = "asc".equals(direction) ? "desc" : "asc";
        }

        return Optional.of(new SortInfo(backendColumn, direction));
    }

    public static boolean extractIsShipmentPageWanted(String viewType) {
        return !"history".equalsIgnoreCase(viewType);
    }

    public record SortInfo(String column, String direction) {
        // direction is expected to be "asc" or "desc"
    }

    private static void mapSetFilter(JsonNode root, String jsonKey, String apiKey,
                                     Map<String, String> filters) {
        JsonNode filterNode = root.get(jsonKey);
        if (filterNode == null || filterNode.isNull()) return;

        JsonNode valuesNode = filterNode.get("values");
        if (valuesNode == null || !valuesNode.isArray() || valuesNode.isEmpty()) return;

        String joined = StreamSupport.stream(valuesNode.spliterator(), false)
                .map(JsonNode::asText)
                .filter(s -> s != null && !s.isBlank())
                .collect(Collectors.joining(","));

        if (!joined.isBlank()) {
            filters.put(apiKey, joined);
        }
    }

    private static void mapSingleDateFilter(JsonNode root, String jsonKey, String apiKey,
                                            Map<String, String> filters) {
        JsonNode filterNode = root.get(jsonKey);
        if (filterNode == null || filterNode.isNull()) return;

        JsonNode dateFromNode = filterNode.get("dateFrom");
        if (dateFromNode == null || dateFromNode.isNull()) return;

        String dateStr = parseDateOnly(dateFromNode.asText());
        if (dateStr != null) {
            filters.put(apiKey, dateStr);
        }
    }

    private static void mapDateRangeFilter(JsonNode root, String jsonKey,
                                           String startApiKey, String endApiKey,
                                           Map<String, String> filters) {
        JsonNode filterNode = root.get(jsonKey);
        if (filterNode == null || filterNode.isNull()) return;

        JsonNode dateFromNode = filterNode.get("dateFrom");
        JsonNode dateToNode = filterNode.get("dateTo");

        if (dateFromNode != null && !dateFromNode.isNull()) {
            String start = parseDateOnly(dateFromNode.asText());
            if (start != null) filters.put(startApiKey, start);
        }
        if (dateToNode != null && !dateToNode.isNull()) {
            String end = parseDateOnly(dateToNode.asText());
            if (end != null) filters.put(endApiKey, end);
        }
    }

    private static void resolveActiveShipmentsDateRange(String activeShipments,
                                                        Map<String, String> filters) {
        LocalDate today = LocalDate.now();
        String endDate = today.format(API_DATE_FMT);
        String startDate;

        switch (activeShipments) {
            case "Today":
                startDate = endDate;
                break;
            case "Prior 7 days":
                startDate = today.minusDays(7).format(API_DATE_FMT);
                break;
            case "Prior 14 days":
                startDate = today.minusDays(14).format(API_DATE_FMT);
                break;
            case "Prior 30 days":
                startDate = today.minusDays(30).format(API_DATE_FMT);
                break;
            case "Prior 45 days":
                startDate = today.minusDays(45).format(API_DATE_FMT);
                break;
            case "Prior 60 days":
                startDate = today.minusDays(60).format(API_DATE_FMT);
                break;
            case "Prior 3 months":
                startDate = today.minusDays(90).format(API_DATE_FMT);
                break;
            default:
                if (activeShipments.startsWith("Month (") && activeShipments.endsWith(") to Date")) {
                    startDate = today.withDayOfMonth(1).format(API_DATE_FMT);
                }
                else if (activeShipments.startsWith("Year (") && activeShipments.endsWith(") to Date")) {
                    startDate = today.withDayOfYear(1).format(API_DATE_FMT);
                } else {
                    log.warn("Unrecognised activeShipments value: '{}' – skipping date range resolution",
                            activeShipments);
                    return;
                }
        }

        filters.put("startDate", startDate);
        filters.put("endDate", endDate);
    }

    private static String parseDateOnly(String rawDate) {
        if (rawDate == null || rawDate.isBlank()) return null;
        String[] parts = rawDate.split(" ");
        String datePart = parts[0].trim();
        try {
            LocalDate.parse(datePart, API_DATE_FMT);
            return datePart;
        } catch (Exception e) {
            log.warn("Could not parse date '{}' from view filter JSON", rawDate);
            return null;
        }
    }
}


