DtoComparatorApplication.java

package com.dto.comparator;

import com.dto.comparator.matcher.DtoMatcher;
import com.dto.comparator.model.DtoMatch;
import com.dto.comparator.model.DtoModel;
import com.dto.comparator.report.CsvReportWriter;
import com.dto.comparator.report.ExcelReportWriter;
import com.dto.comparator.scanner.JavaSourceScanner;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.List;

public class DtoComparatorApplication {

    public static void main(String[] args) {

        if (args.length < 2) {

            System.out.println();
            System.out.println(
                    "DTO Comparator"
            );
            System.out.println();
            System.out.println(
                    "Usage:"
            );
            System.out.println(
                    "java -jar dto-comparator.jar " +
                            "<directory1> <directory2>"
            );
            System.out.println();
            System.out.println(
                    "Example:"
            );
            System.out.println(
                    "java -jar dto-comparator.jar " +
                            "/project/service-a " +
                            "/project/service-b"
            );

            System.exit(1);
        }

        Path directory1 =
                Paths.get(args[0]);

        Path directory2 =
                Paths.get(args[1]);

        validateDirectory(directory1);
        validateDirectory(directory2);

        long start =
                System.currentTimeMillis();

        System.out.println();
        System.out.println(
                "======================================"
        );
        System.out.println(
                "        DTO COMPARATOR"
        );
        System.out.println(
                "======================================"
        );

        System.out.println(
                "Directory 1: " +
                        directory1.toAbsolutePath()
        );

        System.out.println(
                "Directory 2: " +
                        directory2.toAbsolutePath()
        );

        System.out.println();

        try {

            JavaSourceScanner scanner =
                    new JavaSourceScanner();

            System.out.println(
                    "Scanning Directory 1..."
            );

            List<DtoModel> dtos1 =
                    scanner.scan(directory1);

            System.out.println(
                    "Found " +
                            dtos1.size() +
                            " DTOs"
            );

            System.out.println();

            System.out.println(
                    "Scanning Directory 2..."
            );

            List<DtoModel> dtos2 =
                    scanner.scan(directory2);

            System.out.println(
                    "Found " +
                            dtos2.size() +
                            " DTOs"
            );

            System.out.println();

            System.out.println(
                    "Comparing DTOs..."
            );

            DtoMatcher matcher =
                    new DtoMatcher();

            List<DtoMatch> matches =
                    matcher.compare(
                            dtos1,
                            dtos2
                    );

            matcher.shutdown();

            Path outputDirectory =
                    Paths.get("output");

            Files.createDirectories(
                    outputDirectory
            );

            String timestamp =
                    LocalDateTime.now()
                            .format(
                                    DateTimeFormatter
                                            .ofPattern(
                                                    "yyyy-MM-dd-HHmmss"
                                            )
                            );

            Path csvFile =
                    outputDirectory.resolve(
                            "dto-comparison-" +
                                    timestamp +
                                    ".csv"
                    );

            Path excelFile =
                    outputDirectory.resolve(
                            "dto-comparison-" +
                                    timestamp +
                                    ".xlsx"
                    );

            System.out.println(
                    "Generating CSV..."
            );

            new CsvReportWriter()
                    .write(
                            csvFile,
                            matches,
                            dtos1,
                            dtos2
                    );

            System.out.println(
                    "Generating Excel..."
            );

            new ExcelReportWriter()
                    .write(
                            excelFile,
                            matches,
                            dtos1,
                            dtos2
                    );

            long executionTime =
                    System.currentTimeMillis()
                            - start;

            System.out.println();
            System.out.println(
                    "======================================"
            );

            System.out.println(
                    "COMPLETED"
            );

            System.out.println(
                    "======================================"
            );

            System.out.println(
                    "Matches : " +
                            matches.size()
            );

            System.out.println(
                    "CSV     : " +
                            csvFile.toAbsolutePath()
            );

            System.out.println(
                    "Excel   : " +
                            excelFile.toAbsolutePath()
            );

            System.out.println(
                    "Time    : " +
                            executionTime +
                            " ms"
            );

            System.out.println(
                    "======================================"
            );

        } catch (Exception e) {

            System.err.println();
            System.err.println(
                    "DTO comparison failed."
            );

            e.printStackTrace();

            System.exit(2);
        }
    }

    private static void validateDirectory(
            Path directory) {

        if (!Files.exists(directory)) {

            throw new IllegalArgumentException(
                    "Directory does not exist: " +
                            directory
            );
        }

        if (!Files.isDirectory(directory)) {

            throw new IllegalArgumentException(
                    "Not a directory: " +
                            directory
            );
        }
    }
}


