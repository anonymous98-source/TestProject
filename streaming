        .podContentType(entity.getPodContentType())
        .podType(entity.getPodType())
        .trackingNumber(entity.getTrackingNumber())
        .documentId(entity.getDocumentId())
        .scanEventId(entity.getScanEventId())
        .trackingNumberUniqueId(entity.getTrackingNumber())
        .build();
  }

  private TrackingEventDto toTrackingEventDto(TrackingEventEntity entity) {
    return TrackingEventDto.builder()
        .id(entity.getId())
