package com.cardinalhealth.advship.tracking.resource.service.impl;

import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.FAILURE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SUCCESS;

import com.cardinalhealth.advship.tracking.resource.database.entity.PriceQuoteEntity;
import com.cardinalhealth.advship.tracking.resource.database.repository.PriceQuoteRepository;
import com.cardinalhealth.advship.tracking.resource.database.repository.ShipmentRepository;
import com.cardinalhealth.advship.tracking.resource.exception.ResourceNotFoundException;
import com.cardinalhealth.advship.tracking.resource.model.datahub.TrackingResourceRequest;
import com.cardinalhealth.advship.tracking.resource.model.datahub.TrackingResourceResponse;
import com.cardinalhealth.advship.tracking.resource.model.request.FedExPricingRequest;
import com.cardinalhealth.advship.tracking.resource.model.request.shipbook.ShipmentPriceQuoteDto;
import com.cardinalhealth.advship.tracking.resource.model.response.FedExPricingResponse;
import com.fasterxml.jackson.databind.JsonNode;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;
import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

/**
 * Ok this class is weird. The way that all this aspect stuff works, is we have a bunch of service classes that get
 * sent through TrackingDataServiceFactory, which maps aspect strings to certain services. This is done via looping
 * over all the classes that implement specific interfaces, and then calling service.getClass() to figure out which
 * service gets mapped to each aspect. This is fine sometimes.
 *
 * However, if you want to do any sort of runtime management such as @Transactional, @Async, or @Cacheable, you run
 * into problems. When you do this, Spring proxies your service bean so that it can have intercept methods to handle
 * what you're doing. This is fine normally, but now service.getClass() returns the proxy class name instead of the
 * real class name. And the way the mapping is done, it cannot find the service and map it.
 *
 * We want to have @Transactional around the save for SaveFedExPricingService. So the quick fix is to create this
 * *Transaction class that does the transactions. This makes the *Transaction class proxied by Spring, so the original
 * service class is left alone, and all the mapping in TrackingDataServiceFactory works again.
 *
 * Typicaly I'd like to take a closer look at TrackingDataServiceFactory and fix it, but we're on a time crunch. And
 * eventually we want to get rid of this aspect stuff all together. So this is a quick fix for that.
 */
@Slf4j
@Service
@AllArgsConstructor
public class SaveFedExPricingServiceTransaction {

    private final ShipmentRepository shipmentRepository;
    private final PriceQuoteRepository priceQuoteRepository;

    @Transactional
    public TrackingResourceResponse saveTrackingResourceData(TrackingResourceRequest trackingResourceRequest) {
        var response = new FedExPricingResponse();
        if (!(trackingResourceRequest instanceof FedExPricingRequest fedExPricingRequest)) {
            throw new IllegalArgumentException("Invalid request type: Expected FedExPricingRequest");
        }
        try {
            log.info("Persisting FedEx pricing information for shipmentEntity ID: {}", fedExPricingRequest.getShipmentId());
            var shipmentEntity = shipmentRepository.findById(fedExPricingRequest.getShipmentId())
                    .orElseThrow(() -> new ResourceNotFoundException("Shipment not found with ID: " + fedExPricingRequest.getShipmentId()));
            var newQuotes = mapToPriceQuotes(fedExPricingRequest.getShipmentPriceQuoteDtos(), shipmentEntity.getId());

            var accessorialCost = newQuotes.stream()
                    .findFirst()
                    .map(PriceQuoteEntity::getResponseJson)
                    .map(json -> extractJsonDouble(json, "/result/rateReplyDetails/0/ratedShipmentDetails/0/shipmentRateDetail/totalSurcharges"))
                    .orElse(Double.NaN);

            var baseCost = newQuotes.stream()
                    .findFirst()
                    .map(PriceQuoteEntity::getResponseJson)
                    .map(json -> extractJsonDouble(json, "/result/rateReplyDetails/0/ratedShipmentDetails/0/totalBaseCharge"))
                    .orElse(Double.NaN);


            shipmentEntity.setAccessorialCost(Double.isNaN(accessorialCost) ? 0.0 : accessorialCost);
            shipmentEntity.setBaseCost(Double.isNaN(baseCost) ? 0.0 : baseCost);
            shipmentEntity.setTotalCost(shipmentEntity.getBaseCost()+ shipmentEntity.getAccessorialCost());

            shipmentRepository.save(shipmentEntity);
            priceQuoteRepository.deleteAllByShipmentId(shipmentEntity.getId());
            priceQuoteRepository.saveAll(newQuotes);
            response.setStatus(SUCCESS);
        } catch (Exception e) {
            response.setStatus(FAILURE);
            log.error("Error saving FedEx pricing information",e);
        }
        return response;
    }

    private List<PriceQuoteEntity> mapToPriceQuotes(List<ShipmentPriceQuoteDto> dtos, UUID shipmentId) {
        return dtos.stream()
                .map(dto -> PriceQuoteEntity.builder()
                        .shipmentId(shipmentId)
                        .totalAmount(
                                dto.getResponseJson() != null
                                        ? extractJsonDouble(dto.getResponseJson(), "/result/rateReplyDetails/0/ratedShipmentDetails/0/shipmentRateDetail/totalSurcharges")
                                        + extractJsonDouble(dto.getResponseJson(), "/result/rateReplyDetails/0/ratedShipmentDetails/0/totalBaseCharge")
                                        : 0d)
                        .providerCode(dto.getProviderCode())
                        .requestJson(dto.getRequestJson())
                        .responseJson(dto.getResponseJson())
                        .statusCode(dto.getStatusCode())
                        .errorMessage(dto.getErrorMessage())
                        .build())
                .collect(Collectors.toList());
    }

    public  double extractJsonDouble(JsonNode json, String pointer) {
        if (json == null) return Double.NaN;
        JsonNode node = json.at(pointer);
        if (node.isMissingNode() || node.isNull()) return Double.NaN;
        if (node.isNumber()) return node.doubleValue();
        if (node.isTextual()) {
            try { return Double.parseDouble(node.textValue()); } catch (NumberFormatException e) { return Double.NaN; }
        }
        return Double.NaN;
    }
}

