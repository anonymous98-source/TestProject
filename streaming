package com.cardinalhealth.advship.tracking.resource.visualization.service.impl;

import com.cardinalhealth.advship.tracking.resource.exception.ResourceNotFoundException;
import com.cardinalhealth.advship.tracking.resource.visualization.constant.VisualizationConstant;
import com.cardinalhealth.advship.tracking.resource.visualization.db.projection.CountQueryProjection;
import com.cardinalhealth.advship.tracking.resource.visualization.db.repo.GenericMaterializedViewRepository;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.DropDownDataRequestDto;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.DropDownDataResponseDto;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.UsersResponseDto;
import com.cardinalhealth.advship.tracking.resource.visualization.service.VisualizationDropDownService;
import com.cardinalhealth.advship.tracking.resource.visualization.util.RequestValidationAndMapperUtils;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

@Slf4j
@Service
@RequiredArgsConstructor
public class VisualizationDropDownServiceImpl implements VisualizationDropDownService {

    private final GenericMaterializedViewRepository materializedViewRepository;

    @Override
    public DropDownDataResponseDto fetchShipmentServiceData(DropDownDataRequestDto dropDownDataRequestDto) {

        RequestValidationAndMapperUtils.validateAndUpdateRequestForProductivityTab(dropDownDataRequestDto);


        DropDownDataResponseDto.DropDownDataResponseDtoBuilder dropDownDataResponseDto =
                DropDownDataResponseDto.builder();
        switch (dropDownDataRequestDto.getDropDownData()) {
            case VisualizationConstant.USERS_DROPDOWN_DATA ->
                    dropDownDataResponseDto.users(getUsers(dropDownDataRequestDto));
            case VisualizationConstant.CARRIERS_DROPDOWN_DATA -> {
                DropDownDataResponseDto carrierServiceLevelDto = getCarriersAndServiceLevels(dropDownDataRequestDto);
                dropDownDataResponseDto.carriers(carrierServiceLevelDto.getCarriers());
                dropDownDataResponseDto.serviceLevels(carrierServiceLevelDto.getServiceLevels());
            }

            default -> throw new ResourceNotFoundException(
                    "No matching found for dropDownData: "
                            + dropDownDataRequestDto.getDropDownData());
        }
        return dropDownDataResponseDto.build();
    }

    private List<UsersResponseDto> getUsers(DropDownDataRequestDto dropDownDataRequestDto) {
        List<String> users = materializedViewRepository.fetchUsersByFacilityList(
                dropDownDataRequestDto.getSelectedCarriers(),
                dropDownDataRequestDto.getFacilityIdList(),
                dropDownDataRequestDto.getCustomerIds(),
                List.of(VisualizationConstant.SHIPMENT_SOURCE_NAVIGATOR),
                true,
                dropDownDataRequestDto.getPeriodInDays());

        return users.stream()
                .filter(user -> user != null && !user.isBlank())
                .distinct()
                .map(user -> {
                    String email = user.toLowerCase().trim();
                    String userName = email;
                    int atIndex = email.indexOf('@');
                    if (atIndex != -1) {
                        userName = email.substring(0, atIndex);
                    }
                    return UsersResponseDto.builder()
                            .userEmail(email)
                            .userName(userName)
                            .build();
                })
                .toList();
    }

    private DropDownDataResponseDto getCarriersAndServiceLevels(DropDownDataRequestDto dropDownDataRequestDto) {
        List<CountQueryProjection> carriersAndServiceLevels = materializedViewRepository.fetchCarrierAndServiceLevelByUsers(
                dropDownDataRequestDto.getSelectedCarriers(),
                dropDownDataRequestDto.getFacilityIdList(),
                dropDownDataRequestDto.getCustomerIds(),
                List.of(VisualizationConstant.SHIPMENT_SOURCE_NAVIGATOR),
                true,
                dropDownDataRequestDto.getPeriodInDays(),
                dropDownDataRequestDto.getUserEmailIds());

        Set<String> carriers = new HashSet<>();
        Set<String> serviceLevels = new HashSet<>();
        for (CountQueryProjection projection : carriersAndServiceLevels) {
            carriers.add(projection.getCarrier());
            serviceLevels.add(projection.getServiceLevel());
        }

        return DropDownDataResponseDto.builder()
                .carriers(new ArrayList<>(carriers))
                .serviceLevels(new ArrayList<>(serviceLevels))
                .build();
    }
}

