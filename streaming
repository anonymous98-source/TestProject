    when(userViewXrefService.upsertUserViewXref(
            UserViewXrefDto.fromSavedViewsReports(viewSavedCreate, dtoCreate)))
        .thenReturn(xrefSavedCreate);

    // update
    var viewIdUpdate = UUID.randomUUID();
    var dtoUpdate = SavedViewsReportsDto.builder().id(viewIdUpdate).viewName("update").build();

    var viewExisting =
        SavedViewsReportsEntity.builder().id(viewIdUpdate).viewName("update").build();
    var viewSavedUpdate =
        SavedViewsReportsEntity.builder().id(viewIdUpdate).viewName("update").build();
    var xrefSavedUpdate = UserViewXrefDto.builder().build();
    var reportSchedules = fixture.create(ReportScheduleEntity.class);

    when(savedViewsReportsRepository.findById(viewIdUpdate)).thenReturn(Optional.of(viewExisting));
    when(savedViewsReportsRepository.save(viewExisting.updateFromDto(dtoUpdate)))
        .thenReturn(viewSavedUpdate);
    when(userViewXrefService.upsertUserViewXref(
            UserViewXrefDto.fromSavedViewsReports(viewSavedUpdate, dtoUpdate)))
        .thenReturn(xrefSavedUpdate);
    when(reportScheduleRepository.findAllByViewIdAndUserId(viewIdUpdate, null))
        .thenReturn(List.of(reportSchedules));

    var result = service.upsert(List.of(dtoCreate, dtoUpdate));

    assertThat(result).hasSize(2);

    var resultCreate =
        result.stream().filter(r -> r.getId().equals(viewIdCreate)).findFirst().orElseThrow();
    assertThat(resultCreate.getViewName()).isEqualTo(dtoCreate.getViewName());
    assertThat(resultCreate.getReportsSchedules()).isNull();

    var resultUpdate =
        result.stream().filter(r -> r.getId().equals(viewIdUpdate)).findFirst().orElseThrow();
    assertThat(resultUpdate.getViewName()).isEqualTo(dtoUpdate.getViewName());
    assertThat(resultUpdate.getReportsSchedules().get(0).getId())
        .isEqualTo(reportSchedules.getId());
  }

