                            .addKeyValue("errorMessage", e.getMessage())
                            .setCause(e)
                            .log();
                }
            }
        }

        return supportUpdateHistoryList.isEmpty() ? null : supportUpdateHistoryList;
    }

    public List<TrackingPviCasesEntity> upsertTrackingPviCasesEntities(List<CaseListDTO> caseList, UUID trackingId) {
        Map<String, TrackingPviCasesEntity> existingCases = new HashMap<>();
        var resultEntities = new ArrayList<TrackingPviCasesEntity>();

        var trackingPviCaseEntities = trackingPviCasesRepository.findAllByTrackingId(trackingId);
        if (caseList == null || caseList.isEmpty()) return trackingPviCaseEntities;
        for (TrackingPviCasesEntity entity : trackingPviCaseEntities) {
            String caseNumber = entity.getCaseNumber();
            if (caseNumber != null) existingCases.put(caseNumber, entity);
        }

        for (CaseListDTO dto : caseList) {
            String caseNumber = dto.getCaseNumber();
            if (caseNumber == null) continue;

            TrackingPviCasesEntity entity = existingCases.get(caseNumber);
            if (entity == null) {
                entity = new TrackingPviCasesEntity();
                entity.setTrackingId(trackingId);
                entity.setCaseNumber(caseNumber);
            }
            updateTrackingPviCaseFields(entity, dto);
            resultEntities.add(entity);
        }
        return trackingPviCasesRepository.saveAll(resultEntities);
    }

    private void updateTrackingPviCaseFields(TrackingPviCasesEntity entity, CaseListDTO dto) {
        entity.setCaseType(dto.getCaseType());
        entity.setCaseSubCategory(dto.getCaseSubCategory());
        entity.setCaseStatus(dto.getCaseStatus());
        try {
            entity.setCaseCreateTime((dto.getCaseCreateTime() != null && !dto.getCaseCreateTime().isBlank()) ?
                    parseDateTime(dto.getCaseCreateTime()) : null);
            entity.setCaseCloseTime((dto.getCaseCloseTime() != null && !dto.getCaseCloseTime().isBlank()) ?
                    parseDateTime(dto.getCaseCloseTime()) : null);
        } catch (ValidationException e) {
            throw new ValidationException("Invalid date format for case create/close time", e);
        }
    }

    public String serializeSupportUpdateHistory(List<SupportUpdateHistoryDTO> supportUpdateHistory) {
