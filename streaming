  @Override
  public ManifestStatusResponse getManifestShipmentStatus(ManifestStatusRequest manifestRequest) {
    log.atInfo()
            .setMessage("Fetching manifest shipment status and preparing response")
            .log();

    // Fetch shipments since last manifest date
    validateDateString(manifestRequest.getLastManifestDate());
    Date lastManifestDate =
        Date.from(
            LocalDateTime.parse(manifestRequest.getLastManifestDate())
                .atZone(ZoneId.systemDefault())
                .toInstant());
    Long shipmentsSinceLastManifest =
