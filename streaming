package com.cardinalhealth.advship.tracking.resource.proxy;


import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.ClientResponse;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

@Service
@RequiredArgsConstructor
public class AdvShipProxyWebclient {
    private final WebClient webClientUaa;


    /**
     * Applies the response from the WebClient to create a ResponseEntity.
     *
     * @param response the ClientResponse from the WebClient
     * @return a Mono containing the ResponseEntity with the parsed JSON body
     */
    private static Mono<ResponseEntity<JsonNode>> apply(ClientResponse response) {

        return response.bodyToMono(String.class)
                .map(body -> {
                    try {
                        ObjectMapper objectMapper = new ObjectMapper();
                        JsonNode jsonBody = objectMapper.readTree(body);
                        return ResponseEntity.status(response.statusCode()).body(jsonBody);
                    } catch (Exception e) {
                        return ResponseEntity.status(response.statusCode()).body(null);
                    }
                });
    }

    /**
     * Saves user accepted legal documents details by making a POST request to the specified URL.
     * Authorization is handled automatically by the WebClient OAuth2 filter.
     *
     * @param requestBody the request body containing user accepted documents details
     * @param url the target URL
     * @return ResponseEntity containing the response from the API
     */
    public ResponseEntity<JsonNode> postApiCall(String requestBody, String url) {
        return webClientUaa.post()
                .uri(url)
                .header(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                .bodyValue(requestBody)
                .exchangeToMono(AdvShipProxyWebclient::apply)
                .block();
    }

    /**
     * Retrieves user accepted legal documents details by making a GET request to the specified URL.
     * Authorization is handled automatically by the WebClient OAuth2 filter.
     *
     * @param url the target URL
     * @return ResponseEntity containing the response from the API
     */
    public ResponseEntity<JsonNode> getApiCall(String url) {
        return webClientUaa.get()
                .uri(url)
                .header(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                .exchangeToMono(AdvShipProxyWebclient::apply)
                .block();

    }


}


