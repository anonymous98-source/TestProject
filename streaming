  private void createShipmentHalAddressDetails(
      NewShipmentDto newShipmentDto, ShipmentEntity newShipmentEntity) {
    List<ShipmentHalAddressDetailsDto> shipmentHalAddressDetailsDtos =
        Optional.ofNullable(newShipmentDto.getShipmentHalAddressDetailsDtos()).orElse(List.of());

    List<ShipmentHalAddressDetailsEntity> shipmentHalAddressDetailsEntityList = new ArrayList<>();

    for (ShipmentHalAddressDetailsDto dto : shipmentHalAddressDetailsDtos) {
      ShipmentHalAddressDetailsEntity hal =
          ShipmentHalAddressDetailsEntity.builder()
              .shipmentId(newShipmentEntity.getId())
              .addressType(dto.getAddressType())
              .name(dto.getName())
              .company(dto.getCompany())
              .addressLine1(dto.getAddressLine1())
              .addressLine2(dto.getAddressLine2())
              .addressLine3(dto.getAddressLine3())
              .city(dto.getCity())
              .state(dto.getState())
              .zipCode(dto.getZipCode())
              .country(dto.getCountry())
              .phoneNumber(dto.getPhoneNumber())
              .email(dto.getEmail())
              .build();
      shipmentHalAddressDetailsEntityList.add(hal);
    }

    shipmentHalAddressDetailsRepository.saveAll(shipmentHalAddressDetailsEntityList);
  }

