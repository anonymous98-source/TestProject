  @Test
  void getReference_shouldHandleNullAndValidJson() throws Exception {

    adapter =
        new TrackingDetailsAdapterImpl(
            mock(TrackingRepository.class),
            mock(TrackingSearchSpecification.class),
            mock(TrackingSpecification.class),
            Runnable::run,
            mock(TrackingDetailsDbUtils.class));

    TrackingDetailsProjection projection = mock(TrackingDetailsProjection.class);

    // Use your correct Reference class here
    Class<?> referenceClass =
        Class.forName("com.cardinalhealth.advship.tracking.resource.model.dto.common.Reference");

    // Use reflection to access private getReference
    var method =
        TrackingDetailsAdapterImpl.class.getDeclaredMethod(
            "getReference", TrackingDetailsProjection.class);
    method.setAccessible(true);

    // Case 1: null JsonNode
    when(projection.getExternalReferenceValueJson()).thenReturn(null);
    Object ref1 = method.invoke(adapter, projection);
    assertNotNull(ref1);

    // Case 2: isNull() == true
    JsonNode nullNode = mock(JsonNode.class);
    when(nullNode.isNull()).thenReturn(true);
    when(projection.getExternalReferenceValueJson()).thenReturn(nullNode);
    Object ref2 = method.invoke(adapter, projection);
    assertNotNull(ref2);

    // Case 3: valid JSON
    ObjectMapper mapper = new ObjectMapper();
    JsonNode validNode = mapper.readTree("{\"prescriptionNumber\":\"RX123\",\"fillId\":\"F456\"}");
    when(projection.getExternalReferenceValueJson()).thenReturn(validNode);
    Object ref3 = method.invoke(adapter, projection);
    assertEquals("RX123", referenceClass.getMethod("getPrescriptionNumber").invoke(ref3));
    assertEquals("F456", referenceClass.getMethod("getFillId").invoke(ref3));

    // Case 4: invalid JSON (simulate exception)
    JsonNode badNode = mock(JsonNode.class);
    when(badNode.isNull()).thenReturn(false);
    when(projection.getExternalReferenceValueJson()).thenReturn(badNode);
    Object ref4 = method.invoke(adapter, projection);
    assertNotNull(ref4);
  }

