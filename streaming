package com.cardinalhealth.advship.tracking.resource.service.impl.sftpaccountdetails;


import com.cardinalhealth.advship.tracking.resource.config.AdvshipTrackingResourceProperties;
import com.cardinalhealth.advship.tracking.resource.config.RetryConfig;
import com.cardinalhealth.advship.tracking.resource.utils.TokenCacheUtils;
import com.google.api.client.auth.oauth2.TokenResponse;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;
import org.springframework.web.reactive.function.BodyInserters;
import org.springframework.web.reactive.function.client.WebClient;

import static com.cardinalhealth.advship.tracking.resource.constants.OAuthConstants.CLIENT_CREDENTIALS;
import static com.cardinalhealth.advship.tracking.resource.constants.OAuthConstants.CLIENT_ID;
import static com.cardinalhealth.advship.tracking.resource.constants.OAuthConstants.CLIENT_SECRET_PARAM_NAME;
import static com.cardinalhealth.advship.tracking.resource.constants.OAuthConstants.GRANT_TYPE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SFTP_TOKEN_KEY;


@Slf4j
@Service
public class SftpTokenGenerationService {
    @Qualifier("webClientNoAuth")
    private final WebClient webClient;

    private final AdvshipTrackingResourceProperties properties;
    private final RetryConfig retryConfig;

    @Autowired
    public SftpTokenGenerationService(@Qualifier("goAnywhereSslWebClient") WebClient webClient, AdvshipTrackingResourceProperties advshipTrackingResourceProperties, RetryConfig retryConfig) {
        this.webClient = webClient;
        this.retryConfig = retryConfig;
        this.properties = advshipTrackingResourceProperties;
    }

    /**
     * Retrieves the access token using client credentials.
     *
     * @return the access token as a string.
     */
    public String getAccessToken() {
        String cachedToken = TokenCacheUtils.getCachedToken(SFTP_TOKEN_KEY);
        if (StringUtils.hasText(cachedToken)) {
            log.atInfo().setMessage("Retrieved access token from Token Cache, returning back to caller")
                    .log();
            return cachedToken;
        }

        log.atInfo()
                .setMessage("Initiating request to retrieve access token")
                .log();

        String accessToken = webClient.post()
                .uri(properties.getGoAnywhereOAuth2TokenUrl())
                .contentType(MediaType.APPLICATION_FORM_URLENCODED)
                .body(BodyInserters
                        .fromFormData(GRANT_TYPE, CLIENT_CREDENTIALS)
                        .with(CLIENT_ID, properties.getGoAnywhereClientId())
                        .with(CLIENT_SECRET_PARAM_NAME, properties.getGoAnywhereClientSecret()))
                .retrieve()
                .bodyToMono(TokenResponse.class)
                .map(TokenResponse::getAccessToken)
                .retryWhen(retryConfig.createRetry(3, 2))
                .block();

        if (StringUtils.hasText(accessToken)) { // Add latest token in cache
            TokenCacheUtils.addNewTokenInCache(SFTP_TOKEN_KEY, accessToken);
            log.atInfo()
                    .setMessage("Successfully retrieved access token from API and added in Token cache")
                    .log();
        } else {
            log.atWarn().setMessage("Failed to retrieve access token or retrieved token is null or empty")
                    .log();
        }

        return accessToken;
    }
}

