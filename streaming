@Service
@Slf4j
public class UpdateTrackingServiceImpl {
  private final TrackingRepository trackingRepository;

  UpdateTrackingServiceImpl(TrackingRepository trackingRepository)
          throws TrackingResourceException {
    this.trackingRepository = trackingRepository;
  }

  @Transactional
  public GenericResponse updateTracking(TrackingDTO requestDto, String trackingNumber) {
    log.atInfo()
            .setMessage("Updating Tracking Entity for trackingNumber")
            .addKeyValue("trackingNumber", trackingNumber)
            .log();

    try {
      var trackingEntity = trackingRepository.findByTrackingNumber(trackingNumber);
      if (trackingEntity == null) {
        log.atInfo()
                .setMessage("No tracking details found for tracking number")
                .addKeyValue("trackingNumber", trackingNumber)
                .log();
        return GenericResponse.builder().message("not_found").status("404").build();
      }
      trackingEntity.setSmsSubscribed(requestDto.getSmsSubscribed());

      log.atInfo()
              .setMessage("Updated Tracking Entity successfully for trackingNumber")
              .addKeyValue("trackingNumber", trackingNumber)
              .log();
      return GenericResponse.builder().message("updated").status("200").build();
    } catch (Exception e) {
      throw new ResourceNotFoundException(e.getMessage(), e);
    }
  }
}

