    if (surroundInsightsDTO == null) return;
    List<InterventionHistoryDTO> interventionHistoryList =
        surroundInsightsDTO.getInterventionHistory();
    JsonNode interventionHistoryJson = null;
    if (interventionHistoryList != null) {
      interventionHistoryJson = objectMapper.valueToTree(interventionHistoryList);
    }
    InterventionHistoryDTO interventionHistoryDTO =
        surroundInsightUtils.getInterventionDetailsFromJson(interventionHistoryJson);
    List<CaseListDTO> caseList = surroundInsightsDTO.getCaseList();
    CaseListDTO caseDTO = null;
    if (caseList != null) {
      caseDTO = surroundInsightUtils.getLatestCaseNode(objectMapper.valueToTree(caseList));
    }
    if (interventionHistoryDTO != null) {
      trackingEntity.setLatestInterventionDate(interventionHistoryDTO.getInterventionDateTime());
      trackingEntity.setLatestInterventionStatus(interventionHistoryDTO.getInterventionStatus());
      trackingEntity.setLatestInterventionRequested(
