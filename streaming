package com.dto.comparator.report;

import com.dto.comparator.model.DtoMatch;
import com.dto.comparator.model.DtoModel;

import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

public class CsvReportWriter {

    public void write(
            Path outputFile,
            List<DtoMatch> matches,
            List<DtoModel> dtos1,
            List<DtoModel> dtos2)
            throws IOException {

        Set<String> matched1 =
                matches.stream()
                        .map(match ->
                                match.dto1().sourceFile()
                                        .toAbsolutePath()
                                        .toString())
                        .collect(Collectors.toSet());

        Set<String> matched2 =
                matches.stream()
                        .map(match ->
                                match.dto2().sourceFile()
                                        .toAbsolutePath()
                                        .toString())
                        .collect(Collectors.toSet());

        try (BufferedWriter writer =
                     Files.newBufferedWriter(outputFile)) {

            writer.write(
                    "Status,DTO 1,DTO 2,Similarity,Directory 1 File,Directory 2 File,Common Fields,Only In DTO 1,Only In DTO 2,Different Types"
            );

            writer.newLine();

            for (DtoMatch match : matches) {

                writer.write(
                        csv(match.status().name())
                                + ","
                                + csv(match.dto1().className())
                                + ","
                                + csv(match.dto2().className())
                                + ","
                                + csv(
                                String.format(
                                        "%.2f%%",
                                        match.similarity() * 100
                                )
                        )
                                + ","
                                + csv(
                                match.dto1()
                                        .sourceFile()
                                        .toString()
                        )
                                + ","
                                + csv(
                                match.dto2()
                                        .sourceFile()
                                        .toString()
                        )
                                + ","
                                + csv(
                                fields(match.commonFields())
                        )
                                + ","
                                + csv(
                                fields(match.onlyInDto1())
                        )
                                + ","
                                + csv(
                                fields(match.onlyInDto2())
                        )
                                + ","
                                + csv(
                                String.join(
                                        " | ",
                                        match.differentTypes()
                                )
                        )
                );

                writer.newLine();
            }

            writer.newLine();

            writer.write("UNMATCHED DTOs - DIRECTORY 1");
            writer.newLine();

            for (DtoModel dto : dtos1) {

                if (!matched1.contains(
                        dto.sourceFile()
                                .toAbsolutePath()
                                .toString())) {

                    writer.write(
                            csv(dto.className())
                                    + ","
                                    + csv(
                                    dto.sourceFile()
                                            .toString()
                            )
                    );

                    writer.newLine();
                }
            }

            writer.newLine();

            writer.write("UNMATCHED DTOs - DIRECTORY 2");
            writer.newLine();

            for (DtoModel dto : dtos2) {

                if (!matched2.contains(
                        dto.sourceFile()
                                .toAbsolutePath()
                                .toString())) {

                    writer.write(
                            csv(dto.className())
                                    + ","
                                    + csv(
                                    dto.sourceFile()
                                            .toString()
                            )
                    );

                    writer.newLine();
                }
            }
        }
    }

    private String fields(
            Set<?> fields) {

        return fields.stream()
                .map(Object::toString)
                .collect(
                        Collectors.joining(" | ")
                );
    }

    private String csv(String value) {

        if (value == null) {
            return "";
        }

        return "\"" +
                value.replace(
                        "\"",
                        "\"\""
                )
                +
                "\"";
    }
}


