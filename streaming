                .stream()
                .flatMap(additionalServiceShipmentEntity -> additionalServiceShipmentEntity.getShippingProfileTags() != null ?
                        additionalServiceShipmentEntity.getShippingProfileTags().stream() : Stream.empty())
                .filter(Objects::nonNull)
                .filter(tag -> tag.toLowerCase().contains(tagSearchQuery.toLowerCase()))
                .collect(Collectors.toMap(
                        String::toLowerCase, tag -> tag, (existing, replacement) -> existing,
                        LinkedHashMap::new
                ))
                .values().stream()
                .sorted()
                .toList();
    }

    public List<String> getUniqueTags(List<ShipmentEntity> shipmentEntities) {
        return additionalServiceShipmentRepository.findAllByShipmentIdIn(shipmentEntities.stream().map(ShipmentEntity::getId).toList())
                .stream()
                .flatMap(additionalServiceShipmentEntity -> additionalServiceShipmentEntity.getShippingProfileTags() != null ?
                        additionalServiceShipmentEntity.getShippingProfileTags().stream() : Stream.empty())
                .filter(Objects::nonNull)
                .collect(Collectors.toMap(
                        String::toLowerCase, // key: lowercase version
                        tag -> tag,               // value: original tag
                        (existing, replacement) -> existing, // keep first occurrence
                        LinkedHashMap::new
                ))
                .values().stream()
                .sorted(Comparator.comparing(String::toLowerCase))
                .limit(50)
                .toList();
    }

