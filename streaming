            trackingSave,
            saveFedexJsonService,
            trackingNoPhiDataPublisher);

    mapperMock = org.mockito.Mockito.mockStatic(FedexToTrackingInputMapper.class);

    mapperMock
        .when(() -> FedexToTrackingInputMapper.convertToCompatibleFormatWithOffset(any()))
        .thenReturn("2026-09-09T10:00:00+05:30");

    mapperMock
        .when(() -> FedexToTrackingInputMapper.convertToCompatibleFormatWithoutOffset(any()))
        .thenReturn("2026-09-09T10:00:00");

    mapperMock
        .when(() -> FedexToTrackingInputMapper.mapEventTypeFromEventDescriptionStatus(anyString()))
        .thenReturn("DELIVERED");

    mapperMock
        .when(() -> FedexToTrackingInputMapper.getBeginDateByType(any(), any()))
        .thenReturn("2026-09-01");

    mapperMock
        .when(() -> FedexToTrackingInputMapper.mapFedexToTrackingInput(any(), any()))
        .thenReturn(mock(Object.class));
  }

