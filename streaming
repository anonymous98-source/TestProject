    private Throwable findCause(
            Throwable throwable,
            Class<? extends Throwable> expectedType) {

        Throwable current = throwable;

        while (current != null) {

            if (expectedType.isInstance(current)) {
                return current;
            }

            current = current.getCause();
        }

        return throwable;
    }
