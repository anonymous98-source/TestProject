import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.PVI_CASE_COUNT;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.RISK_SCORE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SENSEAWARE_MOBILE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SENSEAWARE_MOBILE_COLUMN;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SHIPPING_PROFILE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SHIPPING_PROFILE_NAME;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SHIPPING_PROFILE_TAGS;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SHIP_VIA_CODE;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.STATUS_CONDITION;
