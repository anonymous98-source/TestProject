     * Verifies the applicable carriers for time-based risk calculation
     */
    @Test
    void verifySql_applicableCarriers() throws Exception {
        Method method = TrackingRepository.class.getMethod("recomputeRiskScoreForActiveNonLatched");
        Query query = method.getAnnotation(Query.class);
        String sql = query.value();

        // Per acceptance criteria: Applicable: FedEx, USPS, DHL, Courier
        assertTrue(sql.contains("'fedex'"), "FedEx should be included");
        assertTrue(sql.contains("'usps'"), "USPS should be included");
        assertTrue(sql.contains("'dhl'"), "DHL should be included");
        assertTrue(sql.contains("'courier'"), "Courier should be included");
    }

    /**
     * Verifies score values match expected risk levels
     * Green = 0, Yellow = 20, Red = 40
     */
    @Test
    void verifySql_scoreValues() throws Exception {
        Method method = TrackingRepository.class.getMethod("recomputeRiskScoreForActiveNonLatched");
        Query query = method.getAnnotation(Query.class);
        String sql = query.value();

        // Yellow cases should return 20
        // FedEx has 1 branch (medium risk), Courier has 1 branch (delay_reason)
        int yellowCount = countOccurrences(sql, "THEN 20");
        assertTrue(yellowCount >= 2, "Should have at least 2 Yellow (score 20) branches: FedEx medium risk and Courier delay_reason");

        // Red cases should return 40
        // FedEx has 2 branches (DELAYED status and combined condition), USPS/DHL/Courier each have 1 branch
        int redCount = countOccurrences(sql, "THEN 40");
        assertTrue(redCount >= 3, "Should have at least 3 Red (score 40) branches: FedEx DELAYED, USPS/DHL past deadline, Courier past deadline");

        // Early detection (FedEx) should return -20
        int earlyCount = countOccurrences(sql, "THEN -20");
        assertTrue(earlyCount >= 1, "Should have at least 1 Early (score -20) branch for FedEx");

        // On-time (FedEx) should return 0
        int ontimeCount = countOccurrences(sql, "THEN 0");
        assertTrue(ontimeCount >= 1, "Should have at least 1 On-time (score 0) branch for FedEx");

        // Default should be 0 (Green)
        assertTrue(sql.contains("ELSE NULL"), "Default ELSE NULL should exist for fallback cases");
    }

    /**
     * Example scenario from conversation:
     * A package has tracking_last_status = "Label Created" with tracking_last_updated_at = before expected delivery time.
     * The expected delivery time has now passed with no new status update from the carrier.
     *
     * Expected result: YELLOW (score 20) - At Risk
     * Reason: The carrier has NOT sent any status update AFTER the expected delivery time elapsed.
     *         The "Label Created" status was set BEFORE the deadline, so no new information since deadline.
     *
     * This test verifies the SQL uses tracking_last_updated_at to determine
     * whether a status update was received after the deadline.
     */
    @Test
    void verifySql_exampleScenario_labelCreatedBeforeDeadline_shouldBeRed() throws Exception {
        Method method = TrackingRepository.class.getMethod("recomputeRiskScoreForActiveNonLatched");
        Query query = method.getAnnotation(Query.class);
        String sql = query.value();
        String normalized = sql.replaceAll("\\s+", " ").toLowerCase();

        // Verify the WHERE clause excludes delivered/void statuses
        assertTrue(normalized.contains("coalesce(lower(t2.tracking_last_status), '') not in ('delivered', 'void')"),
                "Should exclude delivered and void statuses from risk calculation");

        // Verify courier Red condition: tracking expected delivery datetime (check components separately)
        assertTrue(normalized.contains("t2.expected_delivery_date > s.shipment_expected_delivery_datetime"),
                "Should check if tracking expected delivery date is greater than shipment expected delivery datetime");

        // Verify courier carrier uses courier_reason_mapping instead of delay_reason
        assertTrue(normalized.contains("courier_reason_mapping crm"),
                "Courier should reference courier_reason_mapping table");
        assertTrue(normalized.contains("lower(crm.description) = lower(t2.tracking_last_message)"),
                "Courier should compare reason mapping description with tracking_last_message");
        assertTrue(normalized.contains("then 20"),
                "Courier with matching reason mapping should return Yellow (score 20)");

        // Verify USPS/DHL returns Red (40) when past expected delivery time - split into components
        assertTrue(normalized.contains("when lower(s.shipment_carrier_details) in ('usps', 'dhl')"),
                "Should check for USPS and DHL carriers");
        // Verify courier Red condition: tracking expected delivery datetime (check components separately)
        assertTrue(normalized.contains("t2.expected_delivery_date > s.shipment_expected_delivery_datetime"),
                "Should check if tracking expected delivery date is greater than shipment expected delivery datetime");
        assertTrue(normalized.contains("then 40"),
                "Should return Red (40) when past expected delivery time");
    }

    /**
     * Verifies clear query properly removes risk score upon delivery
     * Per acceptance criteria: "The at-risk and delayed status should be removed upon delivered status"
     */
    @Test
    void verifySql_clearOnDelivered_matchesAcceptanceCriteria() throws Exception {
        Method method = TrackingRepository.class.getMethod("clearRiskScoreForDeliveredOrVoid");
        Query query = method.getAnnotation(Query.class);
        String sql = query.value();

        assertTrue(sql.contains("SET risk_score = NULL"),
            "Should clear risk score to null");
        assertTrue(sql.contains("LOWER(tracking_last_status) IN ('delivered', 'void')"),
            "Should target delivered and void statuses");
        assertTrue(sql.contains("AND risk_score IS NOT NULL"),
            "Should only update records that have a non-zero risk score");
    }

    private int countOccurrences(String str, String sub) {
        int count = 0;
        int idx = 0;
        while ((idx = str.indexOf(sub, idx)) != -1) {
            count++;
            idx += sub.length();
        }
        return count;
    }
}

