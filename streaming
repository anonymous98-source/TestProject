            totalRowsCount,
            trackingDetailsDbResult.shipmentMap(),
            trackingDetailsDbResult.pviCaseProjectionsByTrackingId(), timezone);
    dbEnd = System.currentTimeMillis();
    log.atInfo()
            .setMessage(
                    "Dto build execution time for getting tracking details projections in grid api")
            .addKeyValue("executionTimeMs", dbEnd - dbStart)
            .log();
    return new PageImpl<>(trackingResponseDTOs, pageable, trackingDetailsDbResult.totalElements());
