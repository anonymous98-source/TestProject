  @Override
  public TrackingDtoResponse findAllTracking(
      int pageNumber, int pageSize, boolean isLastRecord, boolean isNonNavigator) {

    Pageable pageable = PageRequest.of(pageNumber, pageSize);

    Page<TrackingPodProjection> page =
        getTrackingByDeliveredStatusAndNullPod(pageable, isNonNavigator);

    List<TrackingDTO> trackingDtos = mapToTrackingDtos(page);

    Page<TrackingDTO> forLast = new PageImpl<>(trackingDtos, pageable, page.getTotalElements());

    Map<String, String> trackingIdWithShipmentTransactionId =
        getTrackingIdToShipmentTransactionIdMap(trackingDtos);

    return TrackingDtoResponse.builder()
        .pageNumber(pageNumber)
        .pageSize(pageSize)
        .isLastRecord(forLast.isLast())
        .tracking(trackingDtos)
        .trackingIdWithShipmentTransactionId(trackingIdWithShipmentTransactionId)
        .aspectName(ModelConstants.GET_TRACKING)
        .build();
  }

  @Override
  public void saveUpdatedTrackingWithPod(
      boolean isPodPublished, String id, List<TrackingPodDto> trackingPods) {
    TrackingEntity trackingEntityFetched = trackingRepository.findById(UUID.fromString(id)).orElse(null);

    if (trackingEntityFetched != null) {
      var trackingPodEntities =
          trackingPods.stream()
              .map(
                  trackingPodDto ->
                      TrackingPodEntity.builder()
                          .podType(trackingPodDto.getPodType())
                          .podContent(trackingPodDto.getPodContent())
                          .podContentType(trackingPodDto.getPodContentType())
                          .trackingId(trackingEntityFetched.getId())
                          .trackingNumber(trackingEntityFetched.getTrackingNumber())
                          .scanEventId(trackingPodDto.getScanEventId())
                          .documentId(trackingPodDto.getDocumentId())
                          .build())
              .collect(Collectors.toList());

      if (!trackingPods.isEmpty()) {
        trackingEntityFetched.setPodAvailable(true);
      }
      if (isPodPublished) {
        trackingEntityFetched.setPodUpdatedOnEpic(LocalDateTime.now());
      }

      try {
        trackingRepository.save(trackingEntityFetched);
        trackingPodRepository.saveAll(trackingPodEntities);
      } catch (Exception e) {
        throw new ResourceNotFoundException(e.getMessage(),e);
      }
    }
  }

