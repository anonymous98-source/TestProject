package com.cardinalhealth.advship.tracking.resource.visualization.util;

import com.cardinalhealth.advship.tracking.resource.visualization.constant.VisualizationConstant;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.PickUpTimeLineResponseDto;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;

@Slf4j
public class VisualizationUtils {

  private VisualizationUtils() {
    throw new IllegalStateException("Utility class");
  }

  /**
   * If there are scans available but average pick up duration could not be calculated (due to only
   * one scan in a day for all days), then defaulting average pick up duration to "0" as per UC, to
   * avoid confusion. And if there are no scans available at all, then setting average pick up
   * duration to null in response.
   *
   * @param pickUpTimeLineDto the PickUpTimeLineResponseDto containing the average pickup duration
   *     and other scan data
   */
  public static void adjustAvgPickUpDurationBasedOnData(
      PickUpTimeLineResponseDto pickUpTimeLineDto) {
    boolean hasAnyPickUpDataOtherThanAvgPickUpDuration =
        StringUtils.isNotBlank(pickUpTimeLineDto.getAverageEarliestScan())
            || StringUtils.isNotBlank(pickUpTimeLineDto.getAverageLastScan())
            || StringUtils.isNotBlank(pickUpTimeLineDto.getAveragePickUpScanTime())
            || StringUtils.isNotBlank(pickUpTimeLineDto.getAbsoluteEarliestScan())
            || StringUtils.isNotBlank(pickUpTimeLineDto.getAbsoluteLastScan());

    // If any pick up data is available and averagePickUpDuration is null/blank, set to "0"
    if (hasAnyPickUpDataOtherThanAvgPickUpDuration
        && StringUtils.isBlank(pickUpTimeLineDto.getAveragePickUpDuration())) {
      log.atInfo()
              .setMessage(
                  "Scan data is available but average pick up duration could not be calculated, setting it to 0 in response")
              .log();
      pickUpTimeLineDto.setAveragePickUpDuration(VisualizationConstant.PICK_UP_AVG_DURATION_0);
      return; // returning, since average pickup duration is set to 0 based on available data
    }

    // If averagePickUpDuration is not null/blank, but all other pick up data is null/blank
    // then set averagePickUpDuration to null to avoid confusion for users
    if (!hasAnyPickUpDataOtherThanAvgPickUpDuration
        && StringUtils.isNotBlank(pickUpTimeLineDto.getAveragePickUpDuration())) {
      log.atInfo()
              .setMessage(
                  "No other scan data is available, setting average pick up duration to null in response")
              .log();
      pickUpTimeLineDto.setAveragePickUpDuration(null);
    }
  }
}

