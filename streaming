  private final Map<String, TrackingResourceGetService> capabilityServices = new HashMap<>();
  private final Map<String, UpdateTrackingService> updateGenericServices = new HashMap<>();
  private final Map<String, DeleteTrackingService> deleteGenericServices = new HashMap<>();

  @Autowired
  public TrackingDataServiceFactory(
      List<TrackingGenericService> genericList,
      List<TrackingResourceGetService> gettables,
      List<UpdateTrackingService> updateList,
      List<DeleteTrackingService> deleteList) {

    // Register generic services
    for (TrackingGenericService service : genericList) {
      genericServices.put(resolveKey(service), service);
    }

    // Register capabilities
    for (TrackingResourceGetService gettable : gettables) {
      capabilityServices.put(resolveKey(gettable), gettable);
    }
    for (UpdateTrackingService updateService : updateList) {
      updateGenericServices.put(resolveKey(updateService), updateService);
    }
    for (DeleteTrackingService deleteService : deleteList) {
      deleteGenericServices.put(resolveKey(deleteService), deleteService);
    }
  }

  public TrackingGenericService getGenericService(String aspectName) {
    TrackingGenericService trackingGenericService = genericServices.get(aspectName);
    if (trackingGenericService == null) {
      throw new IllegalArgumentException("No service found for aspect: " + aspectName);
    }
    return trackingGenericService;
  }

  public TrackingResourceGetService getGettableService(String aspectName) {
    TrackingResourceGetService getCapableService = capabilityServices.get(aspectName);
    if (getCapableService == null) {
      throw new IllegalArgumentException("No capable service found for aspect: " + aspectName);
    }
    return getCapableService;
  }

  public UpdateTrackingService getUpdateService(String aspectName) {
    UpdateTrackingService service = updateGenericServices.get(aspectName);
    if (service == null) {
      throw new IllegalArgumentException("No update service found for aspect: " + aspectName);
    }
    return service;
  }

  public DeleteTrackingService getDeleteService(String aspectName) {
    DeleteTrackingService service = deleteGenericServices.get(aspectName);
    if (service == null) {
      throw new IllegalArgumentException("No delete service found for aspect: " + aspectName);
    }
    return service;
  }

