
@PostMapping("/generatelabel")
public ResponseEntity<ShipmentBookResponse> shipmentBook(
        @RequestHeader HttpHeaders httpHeaders,
        @RequestBody @Valid ShipmentBookRequest shipmentBookRequest) {

    var requestId = MDC.get(ShipmentBookConstant.CORRELATION_ID);
    long startTime = System.currentTimeMillis();

    String urlPath = "/v1/api/cms/shipment/generatelabel";
    String source = shipmentBookRequest.getSource();

    log.atInfo()
            .addKeyValue(REQUEST_ID, requestId)
            .setMessage("Request to book shipment came for source : " + source)
            .log();

    try {
        ShipmentBookResponse shipmentBookResponse =
                shipmentBookService.bookShipmentGenerateLabel(
                        shipmentBookRequest, requestId, httpHeaders);

        log.atInfo()
                .addKeyValue(REQUEST_ID, requestId)
                .setMessage("Response for book shipment request for source : " + source)
                .log();

        // Persist successful API execution
        saveGenerateLabelRecord(
                urlPath,
                HttpStatus.OK.value(),
                source,
                null,
                null,
                requestId,
                shipmentBookRequest.getFacilityId(),
                System.currentTimeMillis() - startTime
        );

        return ResponseEntity.ok(shipmentBookResponse);

    } catch (Exception ex) {

        log.atError()
                .addKeyValue(REQUEST_ID, requestId)
                .setCause(ex)
                .log("Failed to book shipment for source : {}", source);

        // Persist failed API execution
        saveGenerateLabelRecord(
                urlPath,
                HttpStatus.INTERNAL_SERVER_ERROR.value(),
                source,
                null,
                ex.getMessage(),
                requestId,
                shipmentBookRequest.getFacilityId(),
                System.currentTimeMillis() - startTime
        );

        throw ex;
    }
}

private void saveGenerateLabelRecord(
        String urlPath,
        int statusCode,
        String source,
        String requestJson,
        String responseJson,
        String requestId,
        String facilityId,
        long responseTime) {

    try {
        cmsRecordUtil.saveRecord(
                urlPath,
                statusCode,
                source,
                requestJson,
                responseJson,
                requestId,
                facilityId,
                responseTime
        );
    } catch (Exception loggingException) {
        log.error("Failed to persist generateLabel API record. Request ID: {}",
                requestId, loggingException);
    }
}
