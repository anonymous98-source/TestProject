        activeBillingGroupDto.setSustainId(UUID.randomUUID());

        // ---- Facilities ----
        FacilityDetailsDto facilityDetailsDto = new FacilityDetailsDto();
        UUID facilityId = UUID.randomUUID();
        facilityDetailsDto.setId(null); // Should be overridden
        facilityDetailsDto.setFacilityName("FAC-1");
        facilityDetailsDto.setAddress1("L1");
