import java.time.*;
import java.time.temporal.ChronoUnit;
import java.util.Date;

@RestController
@RequiredArgsConstructor
@PreAuthorize("isAuthenticated()")
@RequestMapping("/v1/api/surround")
public class FedexSurroundTrackingController {

    private final FedexSurroundLogRepository fedexSurroundLogRepository;
    private final FedexNavigatorStatusMapperRepository fedexNavigatorStatusMapperRepository;

    @PostMapping("/recent-created-at")
    public Boolean getRecentCreatedAt(@RequestHeader HttpHeaders httpHeaders , @RequestParam Integer threshold) {
        Instant cutoffInstant = Instant.now().minus(threshold, ChronoUnit.MINUTES);
        Date cutoff = Date.from(cutoffInstant);
        return fedexSurroundLogRepository.existsFirstByCreatedAtGreaterThanEqualOrderByCreatedAtDesc(cutoff);
    }

    @GetMapping("/fedex-navigator-status")
    public List<FedexNavigatorStatusMapperDto> getFedexNavigatorStatus(@RequestHeader HttpHeaders httpHeaders) {
        return fedexNavigatorStatusMapperRepository.findAll().stream()
                .map(entity -> new FedexNavigatorStatusMapperDto(entity.getId(),
                        entity.getFedexStatus(),
                        entity.getNavigatorStatus(),
                        entity.isActive()))
                .toList();
    }
}

