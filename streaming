package com.cardinalhealth.advship.tracking.resource.visualization.util;

import com.cardinalhealth.advship.tracking.resource.exception.ValidationException;
import com.cardinalhealth.advship.tracking.resource.visualization.constant.VisualizationConstant;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.DropDownDataRequestDto;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.GraphDataRequestDto;
import java.util.List;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.util.CollectionUtils;

@Slf4j
public class RequestValidationAndMapperUtils {

  private RequestValidationAndMapperUtils() {
    throw new IllegalStateException("Utility class");
  }

  /**
   * This method is responsible for mapping and updating the incoming graph visualization request
   * with default values based on the selected tab and graph code. It ensures that the carrier and
   * selected filter button are set appropriately to avoid any issues during data fetching.
   *
   * <p>For "Overview" and "Productivity" tabs, the carrier is set to "ALL". For other tabs, if the
   * carrier is blank, it is set to the selected tab name. If the graph code contains "heatmap" and
   * the selected filter button is blank, it defaults to "shipmentCreatedDate".
   *
   * @param requestDto The incoming graph visualization request DTO that needs to be validated and
   *     updated.
   */
  public static void mapAndUpdateRequest(GraphDataRequestDto requestDto) {
    if (VisualizationConstant.TAB_NAME_OVERVIEW.equalsIgnoreCase(
        requestDto.getVisualizationTabName())) { // For Overview tab, set carrier to ALL
      requestDto.setCarrier(VisualizationConstant.CARRIER_ALL);
      log.atInfo(
         )
              .setMessage(
                  String.format(
                      "For %s tab request, setting the carrier to %s",
                      requestDto.getVisualizationTabName(), VisualizationConstant.CARRIER_ALL))
             .log();
    } else if (VisualizationConstant.TAB_NAME_PRODUCTIVITY.equalsIgnoreCase(
        requestDto.getVisualizationTabName())) {
      // For Productivity tab, validate and update the request parameters specific to productivity
      // tab like userEmailIds, selectedCarriers, selectedServiceLevels
      validateAndUpdateRequestForProductivityTab(requestDto);

    } else if (!requestDto.getVisualizationTabName().equalsIgnoreCase(requestDto.getCarrier())) {
      // If the carrier value is not same as tab name for non Overview/Productivity tabs,
      // then set carrier name same as tab name to avoid issues in data fetching
      requestDto.setCarrier(requestDto.getVisualizationTabName());
      log.atWarn(
         )
              .setMessage(
                  "Carrier should be same as tab name, setting carrier to tab name: "
                      + requestDto.getVisualizationTabName())
             .log();
    } else { // When carrier is blank for non Overview/Productivity tabs, set it to ALL
      if (StringUtils.isBlank(requestDto.getCarrier())) {
        requestDto.setCarrier(VisualizationConstant.CARRIER_ALL);
        log.atWarn(
           )
                .setMessage(
                    String.format(
                        "Carrier is set to ALL for %s tab, which may lead to discrepancies",
                        requestDto.getVisualizationTabName()))
               .log();
      }
    }

    if (VisualizationConstant.GRAPH_CODE_SHIPMENT_COUNT_HOURLY_HEAT_MAP.equalsIgnoreCase(
        requestDto.getGraphCode())) {
      if (StringUtils.isNotBlank(requestDto.getSelectedFilterButton())
          && List.of(
                  VisualizationConstant.FILTER_BY_RESIDENTIAL_ADDRESS_VERIFICATION,
                  VisualizationConstant.FILTER_BY_ADDRESS_VERIFICATION)
              .contains(requestDto.getSelectedFilterButton())) {
        // For heatmap graph, selectedFilterButton can not be addressVerification or
        // residentialFlagVerification, as these filters are not applicable for heatmap graph
        throw new ValidationException(
            requestDto.getSelectedFilterButton() + " is not valid filter for heatmap graph.");
      }

      // For heatmap graph, if selectedFilterButton is blank, then default it to shipmentCreatedDate
      if (StringUtils.isBlank(requestDto.getSelectedFilterButton())) {
        requestDto.setSelectedFilterButton(
            VisualizationConstant.FILTER_DATE_SHIPMENT_CREATED_AT_DATE);
        log.atInfo(
           )
                .setMessage(
                    "Selected filter date is blank/ null in request, defaulting to 'shipmentCreatedDate' for heatMap graph")
               .log();
      }
    }
  }

  /**
   * This method validates the incoming request for the Productivity tab and sets default values for
   * userEmailIds, selectedCarriers, and selectedServiceLevels if they are null or empty. It ensures
   * that the request has the necessary information to fetch data for the Productivity tab without
   * any issues.
   *
   * <p>If userEmailIds is null or empty, it defaults to "ALL". If selectedCarriers is null or
   * empty, it defaults to the carrier value if present, otherwise it defaults to "ALL". If
   * selectedServiceLevels is null or empty, it defaults to "ALL".
   *
   * @param requestDto The incoming graph visualization request DTO for the Productivity tab that
   *     needs to be validated and updated with default values.
   */
  private static void validateAndUpdateRequestForProductivityTab(GraphDataRequestDto requestDto) {
    // For productivity tab, if userEmailIds is empty or null, then default it to ALL
    if (CollectionUtils.isEmpty(requestDto.getUserEmailIds())) {
      log.atWarn(
         )
              .setMessage(
                  "Sent userEmailIds for Productivity tab is null or empty, defaulting to 'ALL'")
             .log();
      requestDto.setUserEmailIds(List.of(VisualizationConstant.SELECTED_FILTER_VALUE_ALL));
    }

    // For productivity tab, if selectedCarriers is empty or null,
    // then default it to carrier value if present, else default to ALL
    if (CollectionUtils.isEmpty(requestDto.getSelectedCarriers())) {
      if (StringUtils.isNotBlank(requestDto.getCarrier())) {
        log.atWarn(
           )
                .setMessage(
                    "Sent selectedCarriers for Productivity tab is null or empty, defaulting carrier value: "
                        + requestDto.getCarrier())
               .log();
        requestDto.setSelectedCarriers(List.of(requestDto.getCarrier()));
      } else {
        log.atWarn(
           )
                .setMessage(
                    "Sent selectedCarriers for Productivity tab is null or empty, defaulting to 'ALL'")
               .log();
        requestDto.setSelectedCarriers(List.of(VisualizationConstant.SELECTED_FILTER_VALUE_ALL));
      }
    }

    // For productivity tab, if selectedServiceLevels is empty or null, then default it to ALL
    if (CollectionUtils.isEmpty(requestDto.getSelectedServiceLevels())) {
      log.atWarn(
         )
              .setMessage(
                  "Sent selectedServiceLevels for Productivity tab is null or empty, defaulting to 'ALL'")
             .log();
      requestDto.setSelectedServiceLevels(List.of(VisualizationConstant.SELECTED_FILTER_VALUE_ALL));
    }

    if (requestDto.isIncludeUnverifiedData()) {
      log.atWarn(
         )
              .setMessage("For Productivity tab, unverified data inclusion is not applicable")
             .log();
      requestDto.setIncludeUnverifiedData(false);
    }

    // For Address Suggestion Usage graph in Productivity tab,
    // selectedFilterButton should be either addressVerification or residentialFlagVerification,
    // if it's blank or has any value other than these two, default it to addressVerification
    if (VisualizationConstant.GRAPH_CODE_ADDRESS_SUGGESTION_USAGE.equalsIgnoreCase(
            requestDto.getGraphCode())
        && (StringUtils.isBlank(requestDto.getSelectedFilterButton())
            || !List.of(
                    VisualizationConstant.FILTER_BY_RESIDENTIAL_ADDRESS_VERIFICATION,
                    VisualizationConstant.FILTER_BY_ADDRESS_VERIFICATION)
                .contains(requestDto.getSelectedFilterButton()))) {
      log.atWarn(
         )
              .setMessage(
                  "Selected filter button for Address Suggestion Usage graph is blank or has invalid value, defaulting to 'addressVerification'")
             .log();
      requestDto.setSelectedFilterButton(VisualizationConstant.FILTER_BY_ADDRESS_VERIFICATION);
    }
  }

  /**
   * This method validates the incoming request for heatmap graphs regarding the inclusion of
   * unverified data. For heatmap graphs, the inclusion of unverified data is not applicable, so if
   * the request has includeUnverifiedData set to true, it logs at Warning and sets it false to avoid
   * any issues during data fetching for heatmap graphs.
   *
   * @param requestDto The incoming graph visualization request DTO for heatmap graphs that needs to
   *     be validated for unverified data inclusion.
   */
  public static void validateAndUpdateRequestForProductivityTab(DropDownDataRequestDto requestDto) {
    // For productivity tab, if userEmailIds is empty or null, then default it to ALL
    if (CollectionUtils.isEmpty(requestDto.getUserEmailIds())) {
      log.atWarn(
         )
              .setMessage(
                  "Sent userEmailIds for Productivity tab is null or empty, defaulting to 'ALL'")
             .log();
      requestDto.setUserEmailIds(List.of(VisualizationConstant.SELECTED_FILTER_VALUE_ALL));
    }

    // For productivity tab, if selectedCarriers is empty or null,
    // then default to ALL
    if (CollectionUtils.isEmpty(requestDto.getSelectedCarriers())) {
      log.atWarn(
         )
              .setMessage(
                  "Sent selectedCarriers for Productivity tab is null or empty, defaulting to 'ALL'")
             .log();
      requestDto.setSelectedCarriers(List.of(VisualizationConstant.SELECTED_FILTER_VALUE_ALL));
    }
  }

  /**
   * For heatmap graph, unverified data inclusion is not applicable, if includeUnverifiedData is
   * true in request, then log at Warning and set it false to avoid any issues in data fetching. Then
   * Return the customer ID list if unverified data needs to be included, else return empty list.
   *
   * @param requestDto The incoming graph visualization request DTO for heatmap graphs that needs to
   * @param customerIds List of customer IDs to be used for data fetching, which will be cleared if
   *     includeUnverifiedData is true for heatmap graphs.
   * @return List of customer IDs if un-verified needs to be included else return empty list
   */
  public static List<String> validateHeatMapInclusionOfUnverifiedDataCustomerIdList(
      GraphDataRequestDto requestDto, List<String> customerIds) {
    if (VisualizationConstant.GRAPH_CODE_SHIPMENT_COUNT_HOURLY_HEAT_MAP.equalsIgnoreCase(
            requestDto.getGraphCode())
        && (VisualizationConstant.TAB_NAME_OVERVIEW.equalsIgnoreCase(
                requestDto.getVisualizationTabName())
            || VisualizationConstant.TAB_NAME_FEDEX.equalsIgnoreCase(
                requestDto.getVisualizationTabName()))
        && requestDto.isIncludeUnverifiedData()
        && VisualizationConstant.FILTER_DATE_SHIPMENT_CREATED_AT_DATE.equalsIgnoreCase(
            requestDto.getSelectedFilterButton())) {
      log.atWarn(
         )
              .setMessage(
                  "For Overview and FedEx tab, heatmap graph will not include unverified data when seleted button is Shipment Created DateTime. "
                      + "Setting includeUnverifiedData to false and customer ID list to empty list.")
             .log();
      requestDto.setIncludeUnverifiedData(false);
      return List.of();
    }
    return customerIds;
  }
}

