  public List<String> getAdditionalServiceNamesWithShipmentAndPkg(
      TrackingDetailsProjection trackingDetailsProjection,
      List<ShipmentProtectionEnrollmentProjection> shipmentProtectionEnrollments,
      List<NotificationProjection> notifications) {
    List<String> additionalServiceNames = new ArrayList<>();
    addDryIceService(trackingDetailsProjection, additionalServiceNames);
    addShipmentLevelServices(trackingDetailsProjection, additionalServiceNames);
    addPackageLevelServices(trackingDetailsProjection, additionalServiceNames);
    addInsuranceAndNotification(
        trackingDetailsProjection,
        shipmentProtectionEnrollments,
        notifications,
        additionalServiceNames);
    addHal(trackingDetailsProjection, additionalServiceNames);

    return additionalServiceNames;
  }

  private void addHal(TrackingDetailsProjection trackingDetailsProjection, List<String> services) {
    if (trackingDetailsProjection.getIsHal() != null && trackingDetailsProjection.getIsHal()) {
      services.add(ServiceCommonConstants.HOLD_LOCATION_SERVICE);
    }
  }

  private void addDryIceService(
      TrackingDetailsProjection trackingDetailsProjection, List<String> services) {
    if (trackingDetailsProjection.getPackageDryIceWeight() != null
        && trackingDetailsProjection.getPackageDryIceWeight() > 0) {
      services.add(ServiceCommonConstants.DRY_ICE_VALUE_WITH_SPACE);
    }
