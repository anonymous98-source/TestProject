package com.cardinalhealth.advship.tracking.resource.service.message;

import com.cardinalhealth.advship.tracking.resource.model.dto.sftp.MessageInfo;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.SneakyThrows;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.DefaultUriBuilderFactory;

import java.net.URI;

@Component
public class DataPublisherService {
    private static final Logger LOGGER = LoggerFactory.getLogger(DataPublisherService.class);
    private final DefaultUriBuilderFactory defaultUriBuilderFactory = new DefaultUriBuilderFactory();
    private final ObjectMapper objectMapper;
    private final WebClient webClient;
    private final String messageBaseUrl;

    public DataPublisherService(
            ObjectMapper objectMapper,
            WebClient webClient,
            @Value("${messageBaseUrl}") String messageBaseUrl
            ) {
        this.objectMapper = objectMapper;
        this.webClient = webClient;
        this.messageBaseUrl = messageBaseUrl;
    }

    @SneakyThrows
    public void sendEmail(MessageInfo messageInfo) {
        var uriPath = getEmailUri();
        webClient
                .post()
                .uri(uriPath)
                .accept(MediaType.APPLICATION_JSON)
                .contentType(MediaType.APPLICATION_JSON)
                .bodyValue(objectMapper.writeValueAsString(messageInfo))
                .retrieve()
                .toBodilessEntity()
                .block();
        logSentMessage(getEmailUri(), objectMapper.writeValueAsString(messageInfo));
    }

    private URI getEmailUri() {
        return defaultUriBuilderFactory.uriString(messageBaseUrl).path("/messages").build();
    }

    private void logSentMessage(URI uriPath, String message) {
        if (LOGGER.isDebugEnabled()) {
            LOGGER.atDebug()
                            .setMessage("REST API")
                            .addKeyValue("path", uriPath.toString())
                            .addKeyValue("message", message)
                            .log();
        }
    }
}

