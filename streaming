          Map.entry(SaveFedExPricingService.class, ModelConstants.FEDEX_SHIPMENT_PRICING),
          Map.entry(DynamicFilterServiceImpl.class, ModelConstants.DYNAMIC_FILTER));

  private String resolveKey(Object service) {
    String key = SERVICE_KEY_MAP.get(service.getClass());
