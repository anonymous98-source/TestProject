        row(sheet, row++,
                "Unmatched Directory 1",
                dtos1.stream()
                        .filter(dto ->
                                !matched1.contains(
                                        dto.sourceFile()
                                                .toAbsolutePath()
                                                .toString()))
                        .count());

        row(sheet, row++,
                "Unmatched Directory 2",
                dtos2.stream()
                        .filter(dto ->
                                !matched2.contains(
                                        dto.sourceFile()
                                                .toAbsolutePath()
                                                .toString()))
                        .count());

        autoSize(sheet);
    }

    private void createMatchesSheet(
            Workbook workbook,
            List<DtoMatch> matches) {

        Sheet sheet =
                workbook.createSheet("Matches");

        String[] headers = {
                "Status",
                "DTO 1",
                "DTO 2",
                "Similarity",
                "Directory 1 File",
                "Directory 2 File",
                "Common Fields",
                "Only In DTO 1",
                "Only In DTO 2",
                "Different Types"
        };

        createHeader(sheet, headers);

        int rowIndex = 1;

        for (DtoMatch match : matches) {

            Row row =
                    sheet.createRow(rowIndex++);

            row.createCell(0)
                    .setCellValue(
                            match.status().name()
                    );

            row.createCell(1)
                    .setCellValue(
                            match.dto1().className()
                    );

            row.createCell(2)
                    .setCellValue(
                            match.dto2().className()
                    );

            row.createCell(3)
                    .setCellValue(
                            match.similarity()
                    );

            row.createCell(4)
                    .setCellValue(
                            match.dto1()
                                    .sourceFile()
                                    .toString()
                    );

            row.createCell(5)
                    .setCellValue(
                            match.dto2()
                                    .sourceFile()
                                    .toString()
                    );

            row.createCell(6)
                    .setCellValue(
                            formatFields(
                                    match.commonFields()
                            )
                    );

            row.createCell(7)
                    .setCellValue(
                            formatFields(
                                    match.onlyInDto1()
                            )
                    );

            row.createCell(8)
                    .setCellValue(
                            formatFields(
                                    match.onlyInDto2()
                            )
                    );

            row.createCell(9)
                    .setCellValue(
                            String.join(
                                    " | ",
                                    match.differentTypes()
                            )
                    );

            Cell scoreCell =
                    row.getCell(3);

            CellStyle percentageStyle =
                    workbook.createCellStyle();

            percentageStyle.setDataFormat(
                    workbook
                            .getCreationHelper()
                            .createDataFormat()
                            .getFormat("0.00%")
            );

            scoreCell.setCellStyle(
                    percentageStyle
            );
        }

        sheet.createFreezePane(0, 1);

        autoSize(sheet);
    }

    private void createUnmatchedSheet(
            Workbook workbook,
            String sheetName,
            List<DtoModel> dtos,
            List<DtoMatch> matches,
            boolean firstDirectory) {

        Sheet sheet =
                workbook.createSheet(sheetName);

        String[] headers = {
                "Class Name",
                "Package",
                "File",
                "Field Count",
                "Fields"
        };

        createHeader(sheet, headers);

        Set<String> matchedFiles =
                matches.stream()
                        .map(match ->
                                firstDirectory
                                        ? match.dto1()
                                        .sourceFile()
                                        .toAbsolutePath()
                                        .toString()
                                        : match.dto2()
                                        .sourceFile()
                                        .toAbsolutePath()
                                        .toString()
                        )
                        .collect(Collectors.toSet());

        int rowIndex = 1;

        for (DtoModel dto : dtos) {

            String file =
                    dto.sourceFile()
                            .toAbsolutePath()
                            .toString();

            if (matchedFiles.contains(file)) {
                continue;
            }

            Row row =
                    sheet.createRow(rowIndex++);

            row.createCell(0)
                    .setCellValue(
                            dto.className()
                    );

            row.createCell(1)
                    .setCellValue(
                            dto.packageName()
                    );

            row.createCell(2)
                    .setCellValue(
                            dto.sourceFile()
                                    .toString()
                    );

            row.createCell(3)
                    .setCellValue(
                            dto.fieldCount()
                    );

            row.createCell(4)
                    .setCellValue(
                            formatFields(
                                    new HashSet<>(
                                            dto.fields()
                                    )
                            )
                    );
        }

        sheet.createFreezePane(0, 1);

        autoSize(sheet);
    }

    private void createHeader(
            Sheet sheet,
            String[] headers) {

        Row row =
                sheet.createRow(0);

        for (int i = 0;
             i < headers.length;
             i++) {

            row.createCell(i)
                    .setCellValue(headers[i]);
        }

        sheet.createFreezePane(0, 1);
    }

    private void row(
            Sheet sheet,
            int rowNumber,
            String metric,
            Object value) {

        Row row =
                sheet.createRow(rowNumber);

        row.createCell(0)
                .setCellValue(metric);

        row.createCell(1)
                .setCellValue(
                        String.valueOf(value)
                );
    }

    private String formatFields(
            Set<?> fields) {

        return fields.stream()
                .map(Object::toString)
                .sorted()
                .collect(
                        Collectors.joining(
                                " | "
                        )
                );
    }

    private void autoSize(
            Sheet sheet) {

        int maxColumns = 10;

        for (int i = 0;
             i < maxColumns;
             i++) {

            try {
                sheet.autoSizeColumn(i);
            } catch (Exception ignored) {
                // Ignore sizing issues
            }
        }
    }
}


