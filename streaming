        instanceof NotificationShipmentRequestDto notificationShipmentRequestDto)) {
      throw new IllegalArgumentException(
          ServiceCommonConstants.VALIDATION_ERROR_MSG_GET_FOR_NOTIFICATION_FLOW);
    }

    // Validate the tracking number
