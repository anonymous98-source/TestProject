  private String daysOfWeek;

  @NotNull
  @Column(name = "hours_of_day", length = 24)
  private String hoursOfDay;

  public static ReportScheduleEntity fromDto(
      ReportsScheduleDto dto, ReportScheduleEntity existingEntity) {
    ReportScheduleEntity entity =
        existingEntity != null ? existingEntity : new ReportScheduleEntity();
    entity.setViewId(dto.getViewId());
    entity.setUserId(dto.getUserId());
    entity.setCustomerId(dto.getCustomerId());
    entity.setReportType(dto.getReportType());
    entity.setActive(dto.isActive());
    entity.setEmails(dto.getEmails());
    entity.setUserTimezone(dto.getUserTimezone());
    entity.setDaysOfWeek(dto.getDaysOfWeek());
    entity.setHoursOfDay(dto.getHoursOfDay());
    if (dto.getViewId() != null) {
      SavedViewsReportsEntity ref = new SavedViewsReportsEntity();
      ref.setId(dto.getViewId());
    } else {
      throw new IllegalArgumentException("viewId is required");
    }
    return entity;
  }

  public ReportsScheduleDto toDto() {
    return ReportsScheduleDto.builder()
            .id(this.id)
            .viewId(viewId)
            .userId(userId)
            .customerId(this.customerId)
            .reportType(this.reportType)
            .active(this.active)
            .emails(this.emails)
            .userTimezone(this.userTimezone)
            .daysOfWeek(this.daysOfWeek)
            .hoursOfDay(this.hoursOfDay)
            .lastModifiedBy(this.getLastModifiedBy())
            .build();
  }
}

