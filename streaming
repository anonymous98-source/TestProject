package com.cardinalhealth.advship.tracking.resource.visualization.service.impl;

import com.cardinalhealth.advship.tracking.resource.visualization.constant.VisualizationConstant;
import com.cardinalhealth.advship.tracking.resource.visualization.dto.MVRefreshResponseDto;
import com.cardinalhealth.advship.tracking.resource.visualization.service.AsyncRefreshService;
import com.cardinalhealth.advship.tracking.resource.visualization.service.MaterializedViewRefreshService;
import java.util.List;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.util.CollectionUtils;

@Slf4j
@Service
@RequiredArgsConstructor
public class MaterializedViewRefreshServiceImpl implements MaterializedViewRefreshService {

  private final AsyncRefreshService asyncRefreshService;

  private static final List<String> ALL_MATERIALIZED_VIEWS =
      List.of(
          VisualizationConstant.MATERIALIZED_VIEW_GENERIC_PARENT_MV,
          VisualizationConstant.MATERIALIZED_VIEW_ADDRESS_SUGGESTION_USAGE,
          VisualizationConstant.MATERIALIZED_VIEW_PICKUP_SCAN_TIMELINE,
          VisualizationConstant.MATERIALIZED_VIEW_COURIER_REASON_CODE);

  /**
   * This method refreshes the specified materialized views or all materialized views if "ALL" is
   * specified. It constructs the appropriate refresh queries, fires them asynchronously, and
   * returns a response indicating that the refresh has started.
   *
   * @param materializedViews the list of materialized view names to refresh, or empty / containing
   *     "ALL" to refresh all views
   * @return a DTO containing the status and message of the refresh operation
   */
  @Override
  public MVRefreshResponseDto refreshMaterializedViews(List<String> materializedViews) {
    List<String> distinctViewsToRefresh = getDistinctViewsToRefresh(materializedViews);
    if (CollectionUtils.isEmpty(distinctViewsToRefresh)) {
      log.atWarn()
              .setMessage(
                  "No valid materialized views found to refresh. Provided views: "
                      + materializedViews)
              .log();
      return MVRefreshResponseDto.builder()
          .message(
              VisualizationConstant.INVALID_MATERIALIZED_VIEW_NAME_PROVIDED + materializedViews)
          .status(VisualizationConstant.STATUS_FAILURE)
          .error(VisualizationConstant.INVALID_MATERIALIZED_VIEW_NAME_PROVIDED + materializedViews)
          .httpStatus(HttpStatus.BAD_REQUEST)
          .build();
    }

    // Fire all refresh queries asynchronously using @Async
    distinctViewsToRefresh.stream()
        .filter(StringUtils::isNotBlank)
        .forEach(asyncRefreshService::refreshMaterializedViewInAsync);

    return MVRefreshResponseDto.builder()
        .message(
            String.format(
                VisualizationConstant.REFRESH_STARTED_MESSAGE_TEMPLATE,
                distinctViewsToRefresh.size(),
                distinctViewsToRefresh.size() > 1 ? "They are" : "It is"))
        .status(VisualizationConstant.STATUS_IN_PROGRESS)
        .httpStatus(HttpStatus.ACCEPTED)
        .build();
  }

  /**
   * Determines distinct materialized views to refresh based on the input list. If the input list is
   * empty or contains "ALL", it returns all available materialized views. Otherwise, it filters the
   * input list to include only distinct valid materialized view names.
   *
   * @param materializedViews the list of materialized view names provided for refresh
   * @return a list of distinct materialized view names that should be refreshed
   */
  private List<String> getDistinctViewsToRefresh(List<String> materializedViews) {
    if (CollectionUtils.isEmpty(materializedViews)
        || materializedViews.stream()
            .anyMatch(
                viewName ->
                    StringUtils.isNotBlank(viewName)
                        && viewName.equalsIgnoreCase(
                            VisualizationConstant.SELECTED_FILTER_VALUE_ALL))) {
      return ALL_MATERIALIZED_VIEWS;
    }

    return materializedViews.stream()
        .filter(viewName -> viewName != null && ALL_MATERIALIZED_VIEWS.contains(viewName))
        .distinct()
        .toList();
  }
