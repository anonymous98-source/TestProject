    ShipperRecipientInfoDTO recipientInfo =
        mock(ShipperRecipientInfoDTO.class, RETURNS_DEEP_STUBS);

    ContactAndAddressDTO recipientContact =
        mock(ContactAndAddressDTO.class);

    ContactAndAddressDTO recipientAddress =
        mock(ContactAndAddressDTO.class);

    when(trackResult.getRecipientInfo())
        .thenReturn(recipientInfo);

    when(recipientInfo.getContactAndAddress())
        .thenReturn(recipientContact);

    when(recipientContact.getAddress())
        .thenReturn(recipientAddress);

    when(recipientAddress.concatenateAddressFields())
        .thenReturn("Mumbai, Maharashtra, India");

    // -------------------------------------------------------------------------
    // Scan Event
    // -------------------------------------------------------------------------

    ScanEventDTO scanEvent =
        mock(ScanEventDTO.class, RETURNS_DEEP_STUBS);

    when(scanEvent.getEventDescription())
        .thenReturn("Delivered");

