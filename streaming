    }

    public TrackingDetailsDbResult fetchShipmentData(
            ShipmentTrackExportReq shipmentTrackExportReq, String userId,
            int pageNo, int pageSize, boolean bypassRowLimit) {

        log.atInfo(
                )
                        .setMessage("TotalRowsCount from userFacilityBasedShipmentCount")
                        .log();

        boolean isShipmentPageWanted = shipmentTrackExportReq.getIsShipmentPageWanted();
        boolean myShipment = shipmentTrackExportReq.isMyShipment();
        List<String> shippingLocation = shipmentTrackExportReq.getShippingLocation();
        log.atInfo(
                )
                        .addKeyValue("isShipmentPageWanted: ", isShipmentPageWanted)
                        .addKeyValue("myShipment: ", myShipment)
                        .log();

        String sortColumn = shipmentTrackExportReq.getSortingColumn();
        String sortDirection = shipmentTrackExportReq.getSortingDirection();

        String searchString = shipmentTrackExportReq.getSearch();

        Map<String, String> filters = shipmentTrackExportReq.getFilters();


        String timeZone = shipmentTrackExportReq.getTimezone();
        UUID userMonarchId = userId != null ? UUID.fromString(userId) : null;
        List<String> shipperAccountNumbers = shipmentTrackExportReq.getShipperAccountNumbers();
        boolean nonNavigator = shipmentTrackExportReq.isNonNavigator();

        log.atInfo(
                )
                        .setMessage("isShipmentPageWanted: " + isShipmentPageWanted +
                                ", myShipment: " + myShipment +
                                ", search: " + searchString +
                                ", sortingColumn: " + sortColumn +
                                ", sortingDirection: " + sortDirection +
                                ", filters: " + filters)
                        .log();


        log.atInfo(
                )
                        .setMessage("Page No: " + pageNo + " Page Size" + pageSize)
                        .log();

        Pageable pageable = PageRequest.of(pageNo, pageSize);

        // Build the search specification
        Specification<TrackingEntity> searchSpecification =
                trackingSearchSpecification.buildSearchSpecification(searchString);

        // Build the filter specification
        Specification<TrackingEntity> filterSpec =
                trackingSpecification.buildSpecification(userMonarchId,
                        isShipmentPageWanted,
                        myShipment,
                        shippingLocation,
                        filters,
                        sortColumn,
                        sortDirection, timeZone, shipperAccountNumbers, nonNavigator);


        // Combine the filter and search specifications
        Specification<TrackingEntity> combinedSpec = filterSpec.and(searchSpecification);
        if (pageNo == 0 && !bypassRowLimit) {
            long totalElements = trackingRepository.count(combinedSpec);
            if (totalElements > reportPageSize) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Request exceeds download limit of " + reportPageSize + " rows. Use the provided filters to narrow the dataset and try again.");
            }
        }
        return trackingDetailsDbUtils.fetchTrackingDetails(trackingRepository, combinedSpec, pageable,csvReportAdapterExecutor,false);

    }
}

