    String search = trackingDetailsRequest.getSearch();
    String sortingColumn = trackingDetailsRequest.getSortingColumn();
    String sortingDirection = trackingDetailsRequest.getSortingDirection();
    String timezone = trackingDetailsRequest.getTimezone();
    List<String> shipperAccountNumbers = trackingDetailsRequest.getSurroundBillToNumbers();

    log.atInfo()
            .setMessage("Tracking details request parameters")
            .addKeyValue("isShipmentPageWanted", isShipmentPageWanted)
            .addKeyValue("myShipment", myShipment)
            .addKeyValue("filters", filters)
            .addKeyValue("userEmail", email)
            .addKeyValue("search", search)
            .addKeyValue("sortingColumn", sortingColumn)
            .addKeyValue("sortingDirection", sortingDirection)
            .addKeyValue("timezone", timezone)
            .addKeyValue("non-navigator", trackingDetailsRequest.isNonNavigator())
            .addKeyValue("shipperAccountNumbers", shipperAccountNumbers)
            .log();

    log.atInfo()
            .setMessage("Pagination details")
            .addKeyValue("pageNo", trackingDetailsRequest.getPageNo())
            .addKeyValue("pageSize", trackingDetailsRequest.getPageSize())
            .log();

    Pageable pageable =
            PageRequest.of(trackingDetailsRequest.getPageNo(), trackingDetailsRequest.getPageSize());

    // Build the filter specification

    Specification<TrackingEntity> filterSpec =
        trackingSpecification.buildSpecification(
            monarchId,
            isShipmentPageWanted,
            myShipment,
            shippingLocation,
            filters,
            sortingColumn,
            sortingDirection,
            timezone,
            shipperAccountNumbers,
            trackingDetailsRequest.isNonNavigator());

    // Build the search specification
    Specification<TrackingEntity> searchSpec =
        trackingSearchSpecification.buildSearchSpecification(search);

    // Combine the filter and search specifications
    Specification<TrackingEntity> combinedSpec = filterSpec.and(searchSpec);

    Specification<TrackingEntity> allViewFilterSpec =
        trackingSpecification.buildSpecification(
            monarchId,
            isShipmentPageWanted,
            myShipment,
            shippingLocation,
            null,
            null,
            null,
            timezone,
            shipperAccountNumbers,
            trackingDetailsRequest.isNonNavigator());
    long totalRowsCount = trackingRepository.count(allViewFilterSpec);
    long dbEnd = System.currentTimeMillis();
    log.atInfo()
            .setMessage("DB Query execution time for totalRowsCount in grid api")
            .addKeyValue("executionTimeMs", dbEnd - dbStart)
            .log();

    log.atInfo()
            .setMessage("TotalRowsCount")
            .addKeyValue("totalRowsCount", totalRowsCount)
            .log();

    TrackingDetailsDbResult trackingDetailsDbResult =
        trackingDetailsDbUtils.fetchTrackingDetails(
            trackingRepository, combinedSpec, pageable, defaultAsyncExecutor, true);

    if (trackingDetailsDbResult.trackingDetailsProjections().isEmpty()) {
      return new PageImpl<>(
