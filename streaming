        if (listOfUtcDateTime == null || listOfUtcDateTime.isEmpty()) {
            return null;
        }
        return listOfUtcDateTime.stream()
                .map(utcDateTime -> DateTimeUtil.convertUtcToUserTime(utcDateTime, timezone))
