  @Override
  public List<ShipmentDto> fetchShipmentData(String shipmentTxNumber, String trackingNumber) {
    List<ShipmentDto> shipmentDtos = new ArrayList<>();
    ShipmentEntity shipmentEntity =
        shipmentRepository.findShipmentByShipmentTransactionId(shipmentTxNumber);
    if (shipmentEntity == null) {
      throw new ResourceNotFoundException(
          " shipmentEntity not found the given transaction number" + shipmentTxNumber);
    }

    var shipmentDto = shipmentDtoCommonMapper.fromEntityWithJoins(shipmentEntity);

    shipmentDto.setShipmentHalAddressDetails(getOriginalAddressDetails(shipmentDto));
    mapPackagesHcids(shipmentDto.getPackages());
    sortTrackingEvents(shipmentDto.getPackages());
    addNoOfDaysDelayedAndStatusCondition(shipmentDto);

    if (shipmentDto.getAdditionalServiceShipment() != null) {
      shipmentDto.getAdditionalServiceShipment().setSaturdayDelivery(false);
    }
    shipmentDtos.add(shipmentDto);

    if (shouldAddReturnShipment(shipmentEntity)) {
      var returnShipmentDto = getReturnShipmentDto(shipmentEntity);
      if (returnShipmentDto != null) {
        shipmentDtos.add(returnShipmentDto);
      }
    }
    return shipmentDtos;
  }

  private void addNoOfDaysDelayedAndStatusCondition(ShipmentDto shipmentDto) {
    if (shipmentDto == null || shipmentDto.getPackages() == null) {
      return; // Exit if shipmentDto or its packages are null
    }

    for (PackageDto packageDto : shipmentDto.getPackages()) {
      if (packageDto == null || packageDto.getTracking() == null) {
        continue; // Skip if packageDto or its tracking is null
      }

      LocalDateTime originalTime = shipmentDto.getShipmentExpectedDeliveryDatetime();
      LocalDateTime expectedTime = packageDto.getTracking().getExpectedDeliveryDate();

      if (originalTime != null && expectedTime != null && expectedTime.isAfter(originalTime)) {
        packageDto.getTracking().setNoOfDaysDelayed(
                (int) java.time.Duration.between(originalTime, expectedTime).toDays()
        );
      }

      // Set status condition

      int atRiskScore=packageDto.getTracking().getRiskScore() != null ? packageDto.getTracking().getRiskScore() : 0;

      if (atRiskScore>=40) {
        packageDto.getTracking().setStatusCondition(CSV_DELAYED);
      } else if (atRiskScore>=20) {
        packageDto.getTracking().setStatusCondition(AT_RISK);
      }
    }
  }

  private List<ShipmentHalAddressDetailsDto> getOriginalAddressDetails(ShipmentDto shipmentDto) {
    if (shipmentDto.getShipmentHalAddressDetails() == null) return Collections.emptyList();
    return shipmentDto.getShipmentHalAddressDetails().stream()
        .filter(hal -> hal != null && ORIGINAL.equalsIgnoreCase(hal.getAddressType()))
        .findFirst()
        .map(Collections::singletonList)
        .orElse(Collections.emptyList());
  }

  private void mapPackagesHcids(List<PackageDto> packageDtos) {
    for (PackageDto packageDto : packageDtos) {
      var additionalServicePackageEntity = additionalServicePackageRepository.findByPackageId(packageDto.getId());
      if (additionalServicePackageEntity != null) {
        packageDto.setHcids(
                trackingDetailsAdapter.mapToHcidDtos(
                        additionalServicePackageEntity.getHcidCodes(),
                        additionalServicePackageEntity.getHcidTemperatureCodes()));
      } else {
        packageDto.setHcids(Collections.emptyList());
      }
    }
  }

  public void sortTrackingEvents(List<PackageDto> packageDtos) {
    for (var p : packageDtos) {
      if (p.getTracking() != null && p.getTracking().getTrackingEvents() != null) {
        p.getTracking()
            .getTrackingEvents()
            .sort(
                Comparator.nullsLast(
                    Comparator.comparing(
                        TrackingEventDto::getTrackingEventStatusUpdatedAt,
                        Comparator.nullsLast(Comparator.naturalOrder()))));
      }
    }
  }

  private boolean shouldAddReturnShipment(ShipmentEntity shipmentEntity) {
    return FEDEX.equalsIgnoreCase(shipmentEntity.getShipmentCarrierDetails())
        && NAVIGATOR.equalsIgnoreCase(shipmentEntity.getShipmentSource())
        && shipmentEntity.getReturnType() == null
        && packageRepository.findAllByShipmentId(shipmentEntity.getId()).orElseGet(Collections::emptyList).size() == 1;
  }

  private ShipmentDto getReturnShipmentDto(ShipmentEntity shipmentEntity) {
    UUID parentShipmentID = CommonService.parseUUIDString(shipmentEntity.getShipmentTransactionId());
    if (parentShipmentID == null) {
      log.atError()
              .setMessage(
                  "Invalid parent shipmentEntity ID for shipmentEntity transaction ID:"
                      + shipmentEntity.getShipmentTransactionId())
              .log();
      return null;
    }
    ShipmentEntity returnShipmentEntity =
        shipmentRepository.findByParentShipmentIdAndReturnTypeNot(
            parentShipmentID, ServiceCommonConstants.STANDALONE);
    if (returnShipmentEntity == null) return null;
    ShipmentDto returnShipmentDto = shipmentDtoCommonMapper.fromEntityWithJoins(returnShipmentEntity);
    mapPackagesHcids(returnShipmentDto.getPackages());
    return returnShipmentDto;
  }

