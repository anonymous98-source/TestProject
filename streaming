    private List<String> extractFiltersForFields(List<Object[]> results) {
        Set<String> tempFilters = new HashSet<>();
        for (Object[] row : results) {
            if (row.length > 0 && row[0] != null) {
                String value = row[0].toString().trim();
                if (!value.isEmpty()) {
                    tempFilters.add(value);
                }
            }
        }
        return new ArrayList<>(tempFilters);
    }

