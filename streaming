  private void updateTrackingEventEntities(TrackingEntity trackingEntity, TrackingDto trackingDto) {
    var trackingEventEntities = trackingEventRepository.findAllByTrackingId(trackingEntity.getId());
    if (trackingEventEntities == null) trackingEventEntities = new ArrayList<>();

    var existingEventMap =
            trackingEventEntities.stream()
                    .filter(e -> e.getId() != null)
                    .collect(Collectors.toMap(TrackingEventEntity::getId, Function.identity()));

    var updatedEvents = new ArrayList<TrackingEventEntity>();

    fetchTrackingEvents(
            trackingDto, existingEventMap, trackingEntity, trackingEventEntities, updatedEvents);

    trackingEventRepository.saveAll(updatedEvents);
  }

  private TrackingEntity updateTrackingEntity(TrackingDto trackingDto, PackageEntity pkg) {
    var trackingEntity = trackingRepository.findByPackageId(pkg.getId());
    if (trackingEntity == null) trackingEntity = new TrackingEntity();

    trackingEntity.setTrackingNumber(trackingDto.getTrackingNumber());
    trackingEntity.setTrackingUrl(trackingDto.getTrackingUrl());
    trackingEntity.setShipDate(trackingDto.getShipDate());
    trackingEntity.setDeliveryDate(trackingDto.getDeliveryDate());
    trackingEntity.setLabelContent(trackingDto.getLabelContent());
    trackingEntity.setLabelType(trackingDto.getLabelType());
