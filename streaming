            graphDataRequestDto.getFacilityIdList(),
            false, // unverified data is not applicable for pickup and scan timeline graph
            graphDataRequestDto.getPeriodInDays().intValue());

    if (pickUpAndScanTimelineData.isEmpty()) {
      log.atWarn()
              .setMessage(
                  "No pick up and scan timeline data found for the given filters for "
                      + graphDataRequestDto.getVisualizationTabName())
              .log();
      return Optional.empty(); // if there is no data, return null return blank response
    }

    return pickUpAndScanTimelineData;
  }
