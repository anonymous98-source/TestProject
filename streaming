package com.cardinalhealth.advship.tracking.resource.service.utils;

import com.cardinalhealth.advship.tracking.resource.constants.TrackingSearchConstants;
import com.cardinalhealth.advship.tracking.resource.database.entity.ExternalReferenceEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.PackageEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.ShipmentEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.TrackingEntity;
import com.cardinalhealth.advship.tracking.resource.exception.ValidationException;
import jakarta.persistence.criteria.CriteriaBuilder;
import jakarta.persistence.criteria.Expression;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;
import jakarta.persistence.criteria.Subquery;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Component;

@Component
public class TrackingSearchSpecification {

    public Specification<TrackingEntity> buildSearchSpecification(String search) {
        return (root, query, cb) -> {
            if (search == null || search.isEmpty()) {
                return cb.conjunction();
            }

            String searchLower = search.toLowerCase();
            List<Predicate> predicates = new ArrayList<>();

            // Tracking Number
            prepareTrackingNumberPredicates(predicates, root,  cb, searchLower);

            // Package fields — EXISTS (SELECT 1 FROM package WHERE id = tracking.package_id AND <field LIKE ...>)
            Subquery<UUID> pkgSubquery = query.subquery(UUID.class);
            Root<PackageEntity> pkgRoot = pkgSubquery.from(PackageEntity.class);
            List<Predicate> pkgFieldPredicates = new ArrayList<>();
            pkgFieldPredicates.add(cb.like(cb.lower(pkgRoot.get(TrackingSearchConstants.PACKAGE_LABEL_REFERENCE1)), "%" + searchLower + "%"));
            pkgFieldPredicates.add(cb.like(cb.lower(pkgRoot.get(TrackingSearchConstants.PACKAGE_LABEL_REFERENCE2)), "%" + searchLower + "%"));
            pkgFieldPredicates.add(cb.like(cb.lower(pkgRoot.get(TrackingSearchConstants.PACKAGE_LABEL_REFERENCE3)), "%" + searchLower + "%"));
            pkgFieldPredicates.add(cb.like(cb.lower(pkgRoot.get(TrackingSearchConstants.PACKAGE_LABEL_REFERENCE4)), "%" + searchLower + "%"));
            pkgFieldPredicates.add(cb.like(cb.lower(pkgRoot.get(TrackingSearchConstants.INTERNAL_DESIGNATION_REFERENCE)), "%" + searchLower + "%"));
            pkgSubquery.select(pkgRoot.get("id")).where(
                    cb.and(
                            cb.equal(pkgRoot.get("id"), root.get("packageId")),
                            cb.or(pkgFieldPredicates.toArray(new Predicate[0]))
                    )
            );
            predicates.add(cb.exists(pkgSubquery));

            // Shipment fields — EXISTS (SELECT 1 FROM package p, shipment s
            //                          WHERE p.id = tracking.package_id AND p.shipment_id = s.id AND <field LIKE ...>)
            Subquery<UUID> shipSubquery = query.subquery(UUID.class);
            Root<PackageEntity> pkgForShip = shipSubquery.from(PackageEntity.class);
            Root<ShipmentEntity> shipRoot = shipSubquery.from(ShipmentEntity.class);
            List<Predicate> shipFieldPredicates = new ArrayList<>();
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_COMPANY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIPMENT_RECIPIENT_NAME)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_ADDRESS_LINE1)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_ADDRESS_LINE2)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_ADDRESS_LINE3)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_ZIP)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_CITY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_STATE)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_TO_COUNTRY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIPMENT_COST_CENTER)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_NAME)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_COMPANY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_ADDRESS_LINE1)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_ADDRESS_LINE2)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_ADDRESS_LINE3)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_ZIP)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_CITY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_STATE)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIP_FROM_COUNTRY)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.DELIVERY_NOTES)), "%" + searchLower + "%"));
            shipFieldPredicates.add(cb.like(cb.lower(shipRoot.get(TrackingSearchConstants.SHIPMENT_TRANSACTION_ID)), "%" + searchLower + "%"));
            shipSubquery.select(shipRoot.get("id")).where(
                    cb.and(
                            cb.equal(pkgForShip.get("id"), root.get("packageId")),
                            cb.equal(pkgForShip.get("shipmentId"), shipRoot.get("id")),
                            cb.or(shipFieldPredicates.toArray(new Predicate[0]))
                    )
            );
            predicates.add(cb.exists(shipSubquery));

            // External reference fields — EXISTS (SELECT 1 FROM external_reference WHERE package_id = tracking.package_id AND <json field LIKE ...>)
            Subquery<UUID> extRefSubquery = query.subquery(UUID.class);
            Root<ExternalReferenceEntity> extRefRoot = extRefSubquery.from(ExternalReferenceEntity.class);
            List<Predicate> extRefFieldPredicates = new ArrayList<>();
            String[] jsonKeys = {
                    TrackingSearchConstants.FILL_ID,
                    TrackingSearchConstants.REFERENCE1,
                    TrackingSearchConstants.REFERENCE2,
                    TrackingSearchConstants.REFERENCE3,
                    TrackingSearchConstants.PRESCRIPTION_NUMBER,
                    TrackingSearchConstants.PHARMACY_ORDER_NUMBER,
                    TrackingSearchConstants.INTERNAL_DESIGNATION_REFERENCE
            };
            for (String key : jsonKeys) {
                Expression<String> jsonValue = cb.function(
                        "jsonb_extract_path_text",
                        String.class,
                        extRefRoot.get(TrackingSearchConstants.EXTERNAL_REFERENCE_VALUE_JSON),
                        cb.literal(key)
                );
                extRefFieldPredicates.add(cb.like(cb.lower(jsonValue), "%" + searchLower + "%"));
            }
            extRefSubquery.select(extRefRoot.get("id")).where(
                    cb.and(
                            cb.equal(extRefRoot.get("packageId"), root.get("packageId")),
                            cb.or(extRefFieldPredicates.toArray(new Predicate[0]))
                    )
            );
            predicates.add(cb.exists(extRefSubquery));

            return cb.or(predicates.toArray(new Predicate[0]));
        };
    }

    private void prepareTrackingNumberPredicates(
            List<Predicate> predicates, Root<TrackingEntity> root, CriteriaBuilder cb, String searchLower) {
        List<String> trackingNumbers =
                Arrays.stream(searchLower.split(","))
                        .map(String::trim)
                        .filter(s -> !s.isEmpty())
                        .distinct()
                        .collect(Collectors.toUnmodifiableList());
        if (trackingNumbers.size() > 30) {
            throw new ValidationException("A maximum of 30 tracking number is allowed per search.");
        }
        List<Predicate> likePredicates =
                trackingNumbers.stream()
                        .map(
                                trackingNumber ->
                                        cb.like(
                                                cb.lower(root.get(TrackingSearchConstants.TRACKING_NUMBER)),
                                                "%" + trackingNumber + "%"))
                        .toList();
        predicates.add(cb.or(likePredicates.toArray(new Predicate[0])));
    }
}

