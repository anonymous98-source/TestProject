package com.cardinalhealth.advship.tracking.resource.visualization.db.repo;

import com.cardinalhealth.advship.tracking.resource.visualization.db.entity.PickupTimelineMaterializedViewEntity;
import com.cardinalhealth.advship.tracking.resource.visualization.db.projection.PickupTimelineProjection;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

@Repository
public interface PickupTimelineMVRepository
    extends JpaRepository<PickupTimelineMaterializedViewEntity, UUID> {

  @Query(
      value =
          """
             WITH picked_up_event_data AS (
                  SELECT
                      vw.pickup_date,
                      vw.pickup_time
                  FROM advship_tracking_resource.PICKUP_TIMELINE_MATERIALIZED_VIEW vw
                  WHERE lower(vw.carrier) = lower(:carrier)
                    AND vw.tracking_event_status_updated_at >= CURRENT_DATE - INTERVAL '1 day' * :periodInDays
                    AND (
                          (:includeUnVerifiedShipment IS TRUE
                            AND (
                                    (
                              vw.source_system IN :unverifiedSources
                              AND (
                                  vw.customer_id IN :customerIds
                                  OR EXISTS (
                                      SELECT 1
                                      FROM unnest(vw.linked_entity_customers)
                                    AS linkedEntityCustomerId(customer_id_scaler)
                                      WHERE linkedEntityCustomerId.customer_id_scaler IN :customerIds)
                                    )
                                )
                                OR (
                                    (vw.source_system) IN ('Navigator', 'External')
                                    AND vw.facility_id IN :facilityIds
                                   )
                                )
                              )
                              OR (
                                  (:includeUnVerifiedShipment IS NULL OR :includeUnVerifiedShipment IS FALSE)
                                  AND (vw.source_system) IN ('Navigator', 'External')
                                  AND vw.facility_id IN :facilityIds
                                  )
                            )
                              AND (
                                    ('ALL' NOT IN :selectedServiceLevels AND vw.service_level IN :selectedServiceLevels)
                                    OR ('ALL' IN :selectedServiceLevels AND vw.service_level IS NOT NULL)
                                  )
                        ),
                      
                        daily_aggregates AS (
                            SELECT
                                pickup_date,
                                MIN(pickup_time) AS daily_first_scan,
                                MAX(pickup_time) AS daily_last_scan
                            FROM picked_up_event_data
                            GROUP BY pickup_date
                        ),
                      
                        daily_durations AS (
                            SELECT
                                da.pickup_date,
                                COUNT(ped.pickup_time) AS scan_count,
                                (da.daily_last_scan - da.daily_first_scan) AS duration_interval
                            FROM daily_aggregates da
                            JOIN picked_up_event_data ped
                              ON ped.pickup_date = da.pickup_date
                            GROUP BY
                                da.pickup_date,
                                da.daily_first_scan,
                                da.daily_last_scan
                            HAVING COUNT(ped.pickup_time) >= 2
                        )
            
              SELECT
                  (SELECT MIN(pickup_time) FROM picked_up_event_data) AS absoluteFirstScan,
                  (SELECT MAX(pickup_time) FROM picked_up_event_data) AS absoluteLastScan,
                  (SELECT CAST(AVG(pickup_time::interval) AS time) FROM picked_up_event_data) AS averageOverallPickUpScan,
                  (SELECT CAST(AVG(daily_first_scan::interval) AS time) FROM daily_aggregates) AS overallAverageFirstScan,
                  (SELECT CAST(AVG(daily_last_scan::interval) AS time) FROM daily_aggregates) AS overallAverageLastScan,
            
                  COUNT(dd.pickup_date) AS totalEligibleDurationDates,
                  CAST(AVG(dd.duration_interval) AS time) AS averageDuration
            
              FROM daily_durations dd;
          """,
      nativeQuery = true)
  Optional<PickupTimelineProjection> fetchPickUpScanTimeLines(
      String carrier,
      List<String> selectedServiceLevels,
      List<String> unverifiedSources,
      List<String> customerIds,
      List<String> facilityIds,
      Boolean includeUnVerifiedShipment,
      Integer periodInDays);
}

