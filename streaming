public Exception handleErrorMap(Throwable throwable, String endpoint) {

  if (throwable instanceof WebClientResponseException ex) {

    List<String> errorMessages =
        extractErrorMessages(ex.getResponseBodyAsString());

    int statusCode = ex.getStatusCode().value();

    if (statusCode == SendFlexErrorConstants.BAD_REQUEST
        && ServiceCommonConstants.ADDRESS_VALIDATION_ENDPOINT.equals(endpoint)) {

      log.warn(
          new LogBuilder()
              .withReason(ex.getMessage())
              .withMessage("SendFlex address validation returned a validation error")
              .toString());

      return new ValidationException(
          "Data is not valid: " + errorMessages,
          errorMessages.toString());
    }

    switch (statusCode) {

      case SendFlexErrorConstants.BAD_REQUEST:
        log.error(
            new LogBuilder()
                .withReason(ex.getMessage())
                .withStackTrace(ex.getStackTrace())
                .withMessage("SendFlex API request failed")
                .toString());

        return new ValidationException(
            "Data is not valid: " + errorMessages,
            errorMessages.toString());

      case SendFlexErrorConstants.UNAUTHORIZED:
        log.error(
            new LogBuilder()
                .withReason(ex.getMessage())
                .withStackTrace(ex.getStackTrace())
                .withMessage("SendFlex API request failed")
                .toString());

        return new UnAuthorizedException(
            "Not authorized request" + errorMessages);

      case SendFlexErrorConstants.NOT_FOUND:
        log.error(
            new LogBuilder()
                .withReason(ex.getMessage())
                .withStackTrace(ex.getStackTrace())
                .withMessage("SendFlex API request failed")
                .toString());

        return new ResourceNotFoundException(
            "Resource is not found: " + errorMessages);

      default:
        log.error(
            new LogBuilder()
                .withReason(ex.getMessage())
                .withStackTrace(ex.getStackTrace())
                .withMessage("SendFlex API request failed")
                .toString());

        return new RuntimeException(
            "Unknown HTTP error occurred: "
                + ex.getStatusCode()
                + " - "
                + errorMessages);
    }

  } else {

    log.error(
        new LogBuilder()
            .withReason(throwable.getMessage())
            .withStackTrace(throwable.getStackTrace())
            .withMessage("Unexpected SendFlex API error")
            .toString());

    return new RuntimeException(
        "Unexpected error occurred: "
            + "sendflex API request failed and it's not WebClientResponseException"
            + throwable.getMessage()
            + Arrays.toString(throwable.getStackTrace()));
  }
}

