import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SURROUND_DELIVERY_PREDICTION;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SURROUND_DELIVERY_PREDICTION_COLUMN;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SURROUND_HCID;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.SURROUND_HCID_COLUMN;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.TRACKING_LAST_MODIFIED_AT;

import com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants;
import com.cardinalhealth.advship.tracking.resource.database.entity.AdditionalServiceShipmentEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.PackageEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.ShipmentEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.SurroundInsightsEntity;
import com.cardinalhealth.advship.tracking.resource.database.entity.TrackingEntity;
