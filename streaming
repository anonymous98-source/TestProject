package com.cardinalhealth.advship.tracking.resource.service.impl.sftpaccountdetails;

import com.cardinalhealth.advship.tracking.resource.config.AdvshipTrackingResourceProperties;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Component;

/**
 * Component for managing advisory locks using PostgreSQL's advisory lock mechanism. This ensures
 * thread-safe access to shared resources by acquiring and releasing locks.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class AdvisoryLocker {
  private final AdvshipTrackingResourceProperties
      advshipTrackingResourceProperties; // Configuration properties for the application
  private final JdbcTemplate jdbcTemplate; // JDBC template for executing database queries

  /**
   * Acquires a PostgreSQL advisory lock using the configured lock key. This method blocks until the
   * lock is successfully acquired.
   */
  public boolean tryLock() {
    log.info("Trying to acquire advisory lock for SFTP account details");
    var result =
        jdbcTemplate.queryForObject(
            "SELECT pg_try_advisory_lock(?)", // SQL query to attempt acquiring the advisory lock
            Boolean.class,
            advshipTrackingResourceProperties
                .getSftpAccountDetailsAdvisoryLockKey()); // Sets the lock key parameter
    log.info("Acquiring advisory lock returned " + result);
    return result != null && result;
  }

  /** Releases the PostgreSQL advisory lock using the configured lock key. */
  public void unlock() {
    log.info("Releasing advisory lock for SFTP account details");
    var result =
        jdbcTemplate.queryForObject(
            "SELECT pg_advisory_unlock(?)", // SQL query to release the advisory lock
            Boolean.class,
            advshipTrackingResourceProperties.getSftpAccountDetailsAdvisoryLockKey());
    log.info("Releasing advisory lock returned " + result);
  }
}

