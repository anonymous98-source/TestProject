    /**
     * Discover applications.
     *
     * Every immediate child directory of the
     * supplied parent directory is treated as an app.
     */
    private static List<AppModel>
    discoverApplications(
            Path parentDirectory,
            JavaSourceScanner scanner)
            throws Exception {

        try (Stream<Path> paths =
                     Files.list(parentDirectory)) {

            return paths
                    .filter(Files::isDirectory)
                    .filter(path ->
                            !path.getFileName()
                                    .toString()
                                    .equalsIgnoreCase(
                                            "dto-comparator-output"
                                    ))
                    .map(path -> {

                        try {

                            System.out.println(
                                    "Scanning app: "
                                            + path.getFileName()
                                    .toString()
                            );

                            List<DtoModel> dtos =
                                    scanner.scan(path);

                            return new AppModel(
                                    path.getFileName()
                                            .toString(),
                                    path,
                                    dtos
                            );

                        } catch (Exception e) {

                            throw new CompletionException(
                                    e
                            );
                        }
                    })
                    .collect(
                            Collectors.toList()
                    );
        }
    }

    /**
     * Generate unique application pairs.
     *
     * For:
     *
     * A B C
     *
     * returns:
     *
     * A-B
     * A-C
     * B-C
     */
    private static List<AppPair>
    generatePairs(
            List<AppModel> apps) {

        List<AppPair> pairs =
                new ArrayList<>();

        for (int i = 0;
             i < apps.size();
             i++) {

            for (int j = i + 1;
                 j < apps.size();
                 j++) {

                pairs.add(
                        new AppPair(
                                apps.get(i),
                                apps.get(j)
                        )
                );
            }
        }

        return pairs;
    }

    /**
     * Compare each application pair concurrently.
     */
    private static List<DtoMatch>
    compareApplicationPairs(
            List<AppPair> pairs,
            DtoMatcher matcher) {

        int processors =
                Runtime.getRuntime()
                        .availableProcessors();

        int threadCount =
                Math.max(
                        2,
                        Math.min(
                                processors,
                                pairs.size()
                        )
                );

        ExecutorService executor =
                Executors.newFixedThreadPool(
                        threadCount
                );

        try {

            List<CompletableFuture<List<DtoMatch>>>
                    futures =
                    pairs.stream()
                            .map(pair ->
                                    CompletableFuture
                                            .supplyAsync(
                                                    () -> {

                                                        System.out.println(
                                                                "Comparing: "
                                                                        + pair.app1()
                                                                        .name()
                                                                        + " <-> "
                                                                        + pair.app2()
                                                                        .name()
                                                        );

                                                        return matcher.compare(
                                                                pair.app1()
                                                                        .name(),
                                                                pair.app1()
                                                                        .dtos(),
                                                                pair.app2()
                                                                        .name(),
                                                                pair.app2()
                                                                        .dtos()
                                                        );
                                                    },
                                                    executor
                                            )
                            )
                            .toList();

            return futures.stream()
                    .flatMap(
                            future ->
                                    future.join()
                                            .stream()
                    )
                    .collect(
                            Collectors.toList()
                    );

        } finally {

            executor.shutdown();
        }
    }

    private static void validateDirectory(
            Path directory) {

        if (!Files.exists(directory)) {

            throw new IllegalArgumentException(
                    "Directory does not exist: "
                            + directory
            );
        }

        if (!Files.isDirectory(directory)) {

            throw new IllegalArgumentException(
                    "Not a directory: "
                            + directory
            );
        }
    }

    private record AppPair(
            AppModel app1,
            AppModel app2
    ) {
    }
}


