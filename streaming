    if (StringUtils.isBlank(trackingNumber)) {
      throw new ValidationException(
          "Tracking number is required to fetch shipmentEntity details based on tracking number");
    }

    NotificationShipmentDetailsDto.NotificationShipmentDetailsDtoBuilder shipmentDetailsDtoBuilder =
        NotificationShipmentDetailsDto.builder();

    var trackingEntity = trackingRepository.findByTrackingNumber(trackingNumber);
    if (trackingEntity == null) {
      log.atInfo()
              .setMessage(
                  "No tracking details found for tracking number: " + trackingNumber)
              .log();
      return null;
    }

    var shipmentEntity = shipmentRepository.findByPackageId(trackingEntity.getPackageId());
    if (shipmentEntity == null) {
      log.atInfo()
              .setMessage(
                      "No shipmentEntity found for tracking number: " + trackingNumber)
              .log();
      return null;
    }

    // Set fields in notificationDtoBuilder from tracking entity
    shipmentDetailsDtoBuilder
        .trackingId(trackingEntity.getId().toString())
        .trackingNumber(trackingEntity.getTrackingNumber())
        .trackingUrl(trackingEntity.getTrackingUrl())
        .expectedDeliveryDate(
            trackingEntity.getExpectedDeliveryDate() != null
                ? trackingEntity.getExpectedDeliveryDate().toString()
                : null)
        .deliveryDate(
            trackingEntity.getDeliveryDate() != null ? trackingEntity.getDeliveryDate().toString() : null);

    var additionalServiceShipmentEntity = additionalServiceShipmentRepository.findByShipmentId(shipmentEntity.getId());
    if (additionalServiceShipmentEntity
        != null) { // Fetch additional service shipmentEntity details if available
      Boolean signatureRequired = additionalServiceShipmentEntity.getSignatureRequired();
      String signatureLevel = additionalServiceShipmentEntity.getSignatureLevel();
      shipmentDetailsDtoBuilder
          .signatureRequired(signatureRequired != null && signatureRequired)
          .signatureLevel(StringUtils.isBlank(signatureLevel) ? null : signatureLevel);
    }

    // Set fields in notificationDtoBuilder from shipmentEntity entity and return
    return shipmentDetailsDtoBuilder
        .facilityName(shipmentEntity.getFacilityName())
        .facilityId(shipmentEntity.getFacilityId())
        .customerName(shipmentEntity.getCustomerName())
        .customerId(shipmentEntity.getCustomerId())
        .build();
  }
