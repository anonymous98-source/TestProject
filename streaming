package com.cardinalhealth.advship.tracking.resource.service.adapter.impl;

import com.cardinalhealth.advship.tracking.resource.constants.TrackingFilterConstants;
import com.cardinalhealth.advship.tracking.resource.database.entity.SavedViewsReportsEntity;
import com.cardinalhealth.advship.tracking.resource.database.repository.SavedViewsReportsRepository;
import com.cardinalhealth.advship.tracking.resource.exception.ResourceNotFoundException;
import com.cardinalhealth.advship.tracking.resource.exception.TrackingResourceException;
import com.cardinalhealth.advship.tracking.resource.exception.UnAuthorizedException;
import com.cardinalhealth.advship.tracking.resource.exception.ValidationException;
import com.cardinalhealth.advship.tracking.resource.model.request.SaveFilterRequest;
import com.cardinalhealth.advship.tracking.resource.service.adapter.base.UserFilterAdapter;
import com.fasterxml.jackson.annotation.JsonInclude;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.Collections;
import java.util.List;
import java.util.Optional;
import java.util.UUID;

@Slf4j
@RequiredArgsConstructor
@Service
public class UserFilterAdapterImpl implements UserFilterAdapter {
    private final SavedViewsReportsRepository savedViewsReportsRepository;
    
    private final ObjectMapper objectMapper;


    public void saveDataToTrackingFilter(UUID userId, SaveFilterRequest saveFilterRequest) {

        if(!saveFilterRequest.isBeaconPlusUser()){
            log.atInfo()
                    .setMessage("User is not a Beacon Plus user, cannot save filters")
                    .log();
            throw new ValidationException("Only Beacon Plus user can save filters");
        }
        int filterCountForUser = savedViewsReportsRepository.countDistinctByUserId(userId);
        if (filterCountForUser >= TrackingFilterConstants.MAX_ALLOWED_TRACKING_FILTER_COUNT) {
            log.atDebug().setMessage("New filters will not be allowed for saving as Maximum allowed"
                            + " tracking filter count reached for UserID " + userId)
                    .log();

            throw new ValidationException("Maximum allowed tracking filter count (10 per user) reached");
        }

        // Construct new SavedFilter entity
        SavedViewsReportsEntity newFilter = constructTrackingFilterEntity(saveFilterRequest, userId, null);

        // Save the new entity in DB
        savedViewsReportsRepository.save(newFilter);
        savedViewsReportsRepository.flush();

    }

    public List<SavedViewsReportsEntity> getAllFiltersFromTrackingFilters(UUID userId) {
        Optional<List<SavedViewsReportsEntity>> filters = savedViewsReportsRepository.findByUserIdOrderByViewNameAsc(userId);
        if (filters.isEmpty() || filters.get().isEmpty()) {
            log.atInfo()
                    .addKeyValue(TrackingFilterConstants.USER_ID_TRACE_ID, String.valueOf(userId))
                    .setMessage("No saved filters found for user, returning empty list")
                    .log();
            return Collections.emptyList();
        }
        return filters.get();
    }


    private SavedViewsReportsEntity constructTrackingFilterEntity(SaveFilterRequest requestDTO,
                                                                  UUID userId, UUID filterId) {

        objectMapper.setSerializationInclusion(JsonInclude.Include.NON_NULL);
        JsonNode filterCriteriaJSON;
        try {
            String jsonValueStr = objectMapper.writeValueAsString(requestDTO.getFilterCriteria());
            filterCriteriaJSON = objectMapper.readTree(jsonValueStr);
        } catch (Exception e) {
            log.atError().setMessage("Unable to convert Tracking filter criteria to Json node"
                            + " and the exception details is " + e.getMessage())
                    .log();
            throw new TrackingResourceException("Unable to convert Tracking filter criteria to Json node", e);
        }


        return SavedViewsReportsEntity
                .builder()
                .id(requestDTO.getFilterId() != null ? filterId : null)
                .viewName(requestDTO.getFilterName())
                .userId(userId)
                .viewFilterJson(filterCriteriaJSON)
                .customerId(requestDTO.getCustomerId())
                .build();
    }

    public void updateTrackingFilter(UUID userId, SaveFilterRequest saveFilterRequest) {


        if (saveFilterRequest.getFilterId() == null) {
            throw new ValidationException("Filter ID must be provided for update");
        }
        UUID filterId = UUID.fromString(saveFilterRequest.getFilterId());

        Optional<SavedViewsReportsEntity> existingFilterOpt = savedViewsReportsRepository.findById(filterId);
        if (existingFilterOpt.isEmpty()) {
            throw new ResourceNotFoundException("Tracking filter not found for ID: " + filterId);
        }

        SavedViewsReportsEntity existingFilter = existingFilterOpt.get();

        // Validate user ownership
        if (!existingFilter.getUserId().equals(userId)) {
            throw new ValidationException("User ID mismatch. Cannot update filter not owned by user.");
        }

        // Construct updated filter entity
        SavedViewsReportsEntity updatedFilter = constructTrackingFilterEntity(saveFilterRequest, userId, filterId);

        // Preserve immutable fields if needed
        updatedFilter.setId(existingFilter.getId());

        // Save updated filter
        savedViewsReportsRepository.save(updatedFilter);
        savedViewsReportsRepository.flush();

        log.atInfo()
                .addKeyValue(TrackingFilterConstants.USER_ID_TRACE_ID, userId.toString())
                .setMessage("Tracking filter updated successfully for ID: " + filterId)
                .log();
    }

    public void deleteTrackingFilter(UUID userId, String filterId) {

        final var filterIdToBeDeleted = UUID.fromString(filterId);
        SavedViewsReportsEntity savedFilterToDelete = savedViewsReportsRepository.findById(filterIdToBeDeleted)
                .orElseThrow(() -> new ResourceNotFoundException(
                        String.format("Requested Tracking filter to be deleted with ID %s does not exist",
                                filterIdToBeDeleted))
                );

        // If current user is not attached to Filter with provided ID then throw exception, else delete
        if (savedFilterToDelete.getUserId() != null && !savedFilterToDelete.getUserId().equals(userId)) {
            log.atError()
                    .setMessage("Current user is not attached to the DB record")
                    .log();
            throw new UnAuthorizedException("Current user is not attached to the DB record, "
                    + "deletion not authorized");
        }

        savedViewsReportsRepository.deleteById(filterIdToBeDeleted);
        savedViewsReportsRepository.flush();

        log.atInfo()
                .setMessage("Tracking filter deleted, returning deletion success response")
                .log();
    }

    public SavedViewsReportsEntity getAllFiltersFromTrackingFiltersByFilterId(UUID filterId) {
        Optional<SavedViewsReportsEntity> filters= savedViewsReportsRepository.findByIdOrderByViewNameAsc(filterId);
        if (filters.isEmpty()) {
            log.atInfo()
                    .addKeyValue(TrackingFilterConstants.USER_ID_TRACE_ID, String.valueOf(filterId))
                    .setMessage("No saved filters found for user, returning empty list")
                    .log();
            return SavedViewsReportsEntity.builder().build();
        }
        return filters.get();
    }
}

