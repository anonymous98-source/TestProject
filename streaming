    private List<String> extractFiltersForFieldsStatusCondition(List<Object[]> results) {
        Set<String> tempFilters = new HashSet<>();
        for (Object[] row : results) {
            if (row.length > 0 && row[0] != null) {
                String valueStr = row[0].toString().trim();
                if (!valueStr.isEmpty()) {
                    try {
                        int value = Integer.parseInt(valueStr);
                        validateRiskScoreValue(value, tempFilters);
                    } catch (NumberFormatException e) {
                        log.atWarn().setMessage("Unable to parse risk score value: " + valueStr)
                                .setCause(e).log();
                    }
                }
            }
        }
        return new ArrayList<>(tempFilters);
    }

    private static void validateRiskScoreValue(int value, Set<String> tempFilters) {
        if (value >= -20 && value < 0) {
            tempFilters.add(ServiceCommonConstants.EARLY);
        } else if (value >= 0 && value < 20) {
            tempFilters.add(ServiceCommonConstants.ON_TIME);
        } else if (value >= 20 && value < 40) {
            tempFilters.add(ServiceCommonConstants.AT_RISK);
        } else if (value >= 40 && value < 60) {
            tempFilters.add(ServiceCommonConstants.DELAYED);
        } else if (value >= 60) {
            tempFilters.add(ServiceCommonConstants.AT_RISK_OF_FURTHER_DELAY);
        }
    }


    private Map<String, List<String>> fetchHcidFilters(EntityManager entityManager, Map<String, String> filters,
                                                       UUID monarchId, DynamicFilterRequest dynamicFilterRequest) {

        CriteriaBuilder cb = entityManager.getCriteriaBuilder();
        CriteriaQuery<Object[]> cq = cb.createQuery(Object[].class);

        Root<TrackingEntity> t = cq.from(TrackingEntity.class);
        Root<PackageEntity> p = cq.from(PackageEntity.class);
        Root<ShipmentEntity> s = cq.from(ShipmentEntity.class);
        Root<AdditionalServicePackageEntity> asp = cq.from(AdditionalServicePackageEntity.class);
        Map<String, String> requestFilters = new HashMap<>(filters);

        if (requestFilters.containsKey(ServiceCommonConstants.HCID_CODE_CHILDREN) && !filters.get(ServiceCommonConstants.HCID_CODE_CHILDREN).isBlank()) {
            requestFilters.put(ServiceCommonConstants.HCID_CODE_CHILDREN, "");
        }
        if (requestFilters.containsKey(ServiceCommonConstants.HCID_CODES) && !filters.get(ServiceCommonConstants.HCID_CODES).isBlank()) {
            requestFilters.put(ServiceCommonConstants.HCID_CODES, "");
        }

        List<Predicate> predicates = buildPredicates(requestFilters, cb, s, t, monarchId, dynamicFilterRequest, p, cq);

        // FK join: additional_service_package.package_id = package.id
        predicates.add(cb.equal(asp.get(TrackingFilterConstants.PACKAGE_ID), p.get("id")));
        predicates.add(cb.isNotNull(asp.get(HCID_CODES)));

        Path<String[]> hcidCodesArr = asp.get(HCID_CODES);
        Path<String[]> tempCodesArr = asp.get(HCID_TEMPERATURE_CODES);

        Expression<String> hcidUnnest = cb.function(UNNEST, String.class, hcidCodesArr);
        Expression<String> tempUnnest = cb.function(UNNEST, String.class, tempCodesArr);

        Expression<String> hcidExpr = cb.lower(hcidUnnest);
        Expression<String> tempExpr = cb.lower(tempUnnest);

        cq.multiselect(hcidExpr, tempExpr)
                .distinct(true)
                .where(predicates.toArray(new Predicate[0]));

        List<Object[]> rows = entityManager.createQuery(cq).getResultList();

        List<String> hcidCodes = rows.stream()
                .map(r -> (String) r[0])
                .filter(code -> code != null && !code.equalsIgnoreCase("null") && !code.isBlank())
                .map(DynamicFilterServiceImpl::extractOnlyCode)
                .filter(Objects::nonNull)
                .filter(code -> !code.equalsIgnoreCase("null") && !code.isBlank())
                .map(code -> code.toUpperCase(Locale.ROOT))
                .distinct()
                .toList();

        List<String> tempCodes = rows.stream()
                .map(r -> (String) r[1])
                .filter(code -> code != null && !code.equalsIgnoreCase("null") && !code.isBlank())
                .map(DynamicFilterServiceImpl::extractOnlyCode)
                .filter(Objects::nonNull)
                .filter(code -> !code.equalsIgnoreCase("null") && !code.isBlank())
                .map(code -> code.toUpperCase(Locale.ROOT))
                .distinct()
                .toList();

        Map<String, List<String>> result = new HashMap<>();
        for (String code : hcidCodes) {
            if (HCT.equalsIgnoreCase(code)) {
                result.put(code, tempCodes.isEmpty() ? List.of() : tempCodes);
            } else {
                result.put(code, List.of());
            }
        }

        return result;
    }

    private static String extractOnlyCode(String entry) {
        if (entry == null) return null;
        int idx = entry.indexOf(':');
        return idx == -1 ? entry : entry.substring(0, idx);
    }


    private List<String> fetchTags(EntityManager em,
                           Map<String, String> filters,
                           UUID monarchId,
                           DynamicFilterRequest dynamicFilterRequest,
                           String tagSearchQuery) {

        CriteriaBuilder cb = em.getCriteriaBuilder();

        CriteriaQuery<Object[]> cq = cb.createQuery(Object[].class);

        Root<TrackingEntity> t = cq.from(TrackingEntity.class);
        Root<PackageEntity> p = cq.from(PackageEntity.class);
        Root<ShipmentEntity> s = cq.from(ShipmentEntity.class);
        Root<AdditionalServiceShipmentEntity> a = cq.from(AdditionalServiceShipmentEntity.class);

        Map<String, String> requestFilters = new HashMap<>(filters);
        requestFilters.remove(SHIPPING_PROFILE_TAGS);

        List<Predicate> predicates = buildPredicates(
                requestFilters, cb, s, t, monarchId, dynamicFilterRequest, p, cq);

        // FK join: additional_service_shipment.shipment_id = shipment.id
        predicates.add(cb.equal(a.get(TrackingFilterConstants.SHIPMENT_ID), s.get("id")));
        predicates.add(cb.isNotNull(a.get(SHIPPING_PROFILE_TAGS)));

        String q = (tagSearchQuery == null)
                ? null
                : tagSearchQuery.toLowerCase(Locale.ROOT).trim();
        if (q != null && !q.isEmpty()) {

            Expression<String> tagsJoined = cb.function("array_to_string", String.class, a.get(SHIPPING_PROFILE_TAGS), cb.literal(","));
            Expression<String> tagsJoinedLower = cb.lower(cb.trim(tagsJoined));

            predicates.add(cb.like(tagsJoinedLower, "%" + q + "%"));
        }

        cq.multiselect(a.get(SHIPPING_PROFILE_TAGS))
                .distinct(true)
                .where(predicates.toArray(new Predicate[0]));

        List<Object[]> rows = em.createQuery(cq).getResultList();

        Stream<String> tagStream = rows.stream()
                .flatMap(row -> {
                    if (row == null || row.length == 0 || row[0] == null) {
                        return Stream.empty();
                    }

                    Object tagsObj = row[0];
                    if (tagsObj instanceof Collection<?> collection) {
                        return collection.stream()
                                .filter(Objects::nonNull)
                                .map(Object::toString);
                    }
                    return Stream.empty();
                });


        return tagStream
                .filter(Objects::nonNull)
                .map(sv -> sv.toLowerCase(Locale.ROOT).trim())
                .filter(sv -> q == null || sv.contains(q))
                .distinct()
                .limit(50)
                .sorted()
                .collect(Collectors.toList());
    }


    private List<Predicate> buildPredicates(Map<String, String> filters, CriteriaBuilder cb, Root<ShipmentEntity> s,
                                            Root<TrackingEntity> t, UUID monarchId,
                                            DynamicFilterRequest dynamicFilterRequest, Root<PackageEntity> p,
                                            CriteriaQuery<?> cq) {
        if (CollectionUtils.isEmpty(filters)) {
            filters = Collections.emptyMap();
        }
        List<Predicate> predicates = new ArrayList<>();

        // FK-based cross-join correlation (replaces @ManyToOne/@OneToMany joins)
        predicates.add(cb.equal(t.get(TrackingFilterConstants.PACKAGE_ID), p.get("id")));
        predicates.add(cb.equal(p.get(TrackingFilterConstants.SHIPMENT_ID), s.get("id")));

        Function<String, List<String>> splitCsv = v ->
                Arrays.stream(v.split(","))
                        .map(String::trim)
                        .filter(str -> !str.isEmpty())
                        .toList();
        String timezone = DEFAULT_TIMEZONE;
        LocalDate effectiveStartDate;
        LocalDate effectiveEndDate;


        if (!StringUtils.isEmpty(dynamicFilterRequest.getTimezone())) {
            timezone = dynamicFilterRequest.getTimezone();
        }

        if (dynamicFilterRequest.isMyShipment() && monarchId != null) {
            predicates.add(cb.equal(s.get(USER_ID_TRACE_ID), monarchId));
        }
        if (Boolean.TRUE.equals(dynamicFilterRequest.getIsShipmentPageWanted())) {
            // Last 31 days default
            effectiveStartDate = LocalDate.now().minusDays(31);
        } else {
            // Last 10 years default
            effectiveStartDate = LocalDate.now().minusYears(10);
        }
        effectiveEndDate = LocalDate.now().plusDays(1);

        LocalDateTime startDateTime = effectiveStartDate.atStartOfDay();
        LocalDateTime endDateTime = effectiveEndDate.atStartOfDay().minusDays(1).withHour(23).withMinute(59).withSecond(59);

        // If filters have custom date range → validate and apply
        mapStartDateAndEndDate(cb, t, timezone, startDateTime, endDateTime, predicates, dynamicFilterRequest);
        // shipping locations and shipper account numbers
        mapLocationsAndShipperAccountNumber(cb, s, t, predicates, dynamicFilterRequest);
        // carrier filter
        mapCarriers(filters, s, splitCsv, predicates);
        // serviceLines
        mapServiceLines(filters, s, splitCsv, predicates);
        // statuses
        mapStatuses(filters, t, splitCsv, predicates);
        // detailedStatuses
        mapDetailedStatuses(filters, t, splitCsv, predicates);
        // shippingTo
        mapShippingTo(filters, s, splitCsv, predicates);
