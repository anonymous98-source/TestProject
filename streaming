        if (additionalServicePackage != null) {
            List<String> parentHcid = additionalServicePackage.getHcidCodes() != null ?
                    additionalServicePackage.getHcidCodes() : new ArrayList<>();
            List<String> childHcids = additionalServicePackage.getHcidTemperatureCodes() != null ?
