    public CaseListDTO getLatestCaseNode(JsonNode caseList) {
        if (caseList == null || !caseList.isArray() || caseList.isEmpty()) return null;
        JsonNode latestNode = null;
        LocalDateTime latestDateTime = null;
        for (JsonNode node : caseList) {
            String createTime = node.has(CASE_CREATE_TIME) && !node.get(CASE_CREATE_TIME).isNull()
                    ? node.get(CASE_CREATE_TIME).asText() : null;
            if (createTime == null || createTime.isEmpty()) continue;
            LocalDateTime dateTime = parseDateTime(createTime);
            if (dateTime != null && (latestDateTime == null || dateTime.isAfter(latestDateTime))) {
                latestNode = node;
                latestDateTime = dateTime;
            }
        }
        if (latestNode == null) return null;
        return mapNodeToCaseListDTO(latestNode);
    }

    private LocalDateTime parseDateTime(String dateTimeStr) {
        try {
            return OffsetDateTime.parse(dateTimeStr).toLocalDateTime();
        } catch (Exception e) {
            log.atError()
                    .setMessage("Error parsing")
                    .addKeyValue("errorMessage", e.getMessage())
                    .setCause(e)
                    .log();
            return null;
        }
    }

    private CaseListDTO mapNodeToCaseListDTO(JsonNode node) {
        try {
            return objectMapper.treeToValue(node, CaseListDTO.class);
        } catch (Exception e) {
            log.atError()
                    .setMessage("Error mapping latest case node to CaseListDTO")
                    .addKeyValue("errorMessage", e.getMessage())
                    .setCause(e)
                    .log();
            return null;
        }
    }

    private LocalDateTime parseInterventionDateTime(JsonNode intervention) {
        if (intervention.has(INTERVENTION_DATE_TIME) && !intervention.get(INTERVENTION_DATE_TIME).isNull()) {
            try {
                String dateTimeString = intervention.get(INTERVENTION_DATE_TIME).asText();
                if (dateTimeString.isEmpty()) {
                    return null;
                }
                if (!dateTimeString.endsWith("Z") && !dateTimeString.matches(".*[+-]\\d{2}:\\d{2}$")) {
                    dateTimeString += "Z";
                }
                return OffsetDateTime.parse(dateTimeString)
                        .atZoneSameInstant(ZoneId.of("UTC"))
                        .toLocalDateTime();
            } catch (Exception e) {
                log.atError()
                        .setMessage("Error parsing interventionDateTime")
                        .addKeyValue("errorMessage", e.getMessage())
                        .setCause(e)
                        .log();
            }
        }
        return null;
    }

    private InterventionHistoryDTO mapToInterventionHistoryDto(JsonNode intervention, LocalDateTime interventionDateTime) {
        if (intervention == null || intervention.isNull()) {
            return null;
        }

        String interventionRequested = intervention.has(INTERVENTION_REQUESTED) && !intervention.get(INTERVENTION_REQUESTED).isNull()
                ? intervention.get(INTERVENTION_REQUESTED).asText()
                : null;

        String interventionStatus = intervention.has(INTERVENTION_STATUS) && !intervention.get(INTERVENTION_STATUS).isNull()
                ? intervention.get(INTERVENTION_STATUS).asText()
                : null;

        return InterventionHistoryDTO.builder()
                .interventionDateTime(interventionDateTime)
                .interventionRequested(interventionRequested)
                .interventionStatus(interventionStatus)
                .build();
    }


    public InterventionHistoryDTO getInterventionDetailsFromJson(JsonNode interventionHistory) {
        if (interventionHistory == null || !interventionHistory.isArray() || interventionHistory.isEmpty()) return null;
        JsonNode latestNode = null;
        LocalDateTime latestDateTime = null;
        for (JsonNode node : interventionHistory) {
            LocalDateTime dateTime = parseInterventionDateTime(node);
            if (dateTime == null) continue;
            if (latestDateTime == null || dateTime.isAfter(latestDateTime)) {
                latestNode = node;
                latestDateTime = dateTime;
            }
        }
        return latestNode != null ? mapToInterventionHistoryDto(latestNode, latestDateTime) : null;
    }

