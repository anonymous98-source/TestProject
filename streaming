                    .filter(s -> !s.isEmpty())
                    .toArray(String[]::new);

            if (trimmedSurroundHcidArray.length > 0) {
                Subquery<Long> surroundHcidSubquery = cb.createQuery().subquery(Long.class);
                Root<SurroundInsightsEntity> surroundInsightsRoot = surroundHcidSubquery.from(SurroundInsightsEntity.class);

                surroundHcidSubquery.select(cb.literal(1L))
                        .where(
                                cb.equal(surroundInsightsRoot.get("trackingId"), root.get("id")),
                                cb.or(
                                        Arrays.stream(trimmedSurroundHcidArray)
                                                .map(val -> cb.like(
                                                        cb.lower(surroundInsightsRoot.get(ServiceCommonConstants.SURROUND_HCID_COLUMN)),
                                                        "%" + val + "%"))
                                                .toArray(Predicate[]::new)
                                )
                        );
                predicates.add(cb.exists(surroundHcidSubquery));
            }
        }
    }

    private void mapStatusConditionFilter(Map<String, String> filters, Root<TrackingEntity> t, CriteriaBuilder cb, List<Predicate> predicates) {

        if (filters.containsKey(ServiceCommonConstants.STATUS_CONDITION) && !filters.get(ServiceCommonConstants.STATUS_CONDITION).isBlank()) {

            String statusCondition = filters.get(ServiceCommonConstants.STATUS_CONDITION);

            List<Predicate> statusPredicates = new ArrayList<>();
            String[] statusConditions = statusCondition.split(",");
            log.info("statusConditions DynamicFilter: " + Arrays.toString(statusConditions));
            for (String singleStatus : statusConditions) {

                if (singleStatus == null || singleStatus.trim().isEmpty()) {
                    continue; // skip empty status conditions
                }

                validateStatusCondition(t, cb, singleStatus, statusPredicates);
            }

            if (!statusPredicates.isEmpty()) {
                predicates.add(cb.or(statusPredicates.toArray(new Predicate[0])));
            }
        }
    }

    private void validateStatusCondition(Root<TrackingEntity> t, CriteriaBuilder cb, String singleStatus, List<Predicate> statusPredicates) {
        switch (singleStatus.trim()) {
            case ServiceCommonConstants.AT_RISK: {
                statusPredicates.add(cb.and(
                        cb.greaterThanOrEqualTo(t.get(ServiceCommonConstants.RISK_SCORE), 20),
                        cb.lessThan(t.get(ServiceCommonConstants.RISK_SCORE), 40)
                ));
                break;
            }
            case ServiceCommonConstants.ON_TIME: {
                statusPredicates.add(cb.and(
                        cb.greaterThanOrEqualTo(t.get(ServiceCommonConstants.RISK_SCORE), 0),
                        cb.lessThan(t.get(ServiceCommonConstants.RISK_SCORE), 20)
                ));
                break;
            }
            case ServiceCommonConstants.EARLY:
                statusPredicates.add(cb.and(
                        cb.greaterThanOrEqualTo(t.get(ServiceCommonConstants.RISK_SCORE), -20),
                        cb.lessThan(t.get(ServiceCommonConstants.RISK_SCORE), 0)
                ));
                break;
            case ServiceCommonConstants.DELAYED: {
                statusPredicates.add(cb.and(
                        cb.greaterThanOrEqualTo(t.get(ServiceCommonConstants.RISK_SCORE), 40),
                        cb.lessThan(t.get(ServiceCommonConstants.RISK_SCORE), 60)
                ));
                break;
            }
            case ServiceCommonConstants.AT_RISK_OF_FURTHER_DELAY: {
                statusPredicates.add(cb.greaterThanOrEqualTo(t.get(ServiceCommonConstants.RISK_SCORE), 60));
                break;
            }
            case ServiceCommonConstants.DELIVERED_STATUS: {
                // If delivery_date from tracking table is not null, it is delivered
                statusPredicates.add(cb.isNotNull(t.get(ServiceCommonConstants.DELIVERY_DATE)));
                break;
            }
            case ServiceCommonConstants.INTRANSIT_STATUS: {
                // If trackingLastStatus from tracking table is equal to inTransit, it is in transit
                List<String> inTransitStatuses = statusGroupRepository.findInTransitCarrierStatuses();
                statusPredicates.add(t.get("trackingLastStatus").in(inTransitStatuses));
                break;
            }
            default: {
                log.warn("Unknown status condition filter value: " + singleStatus);
            }
        }
    }


