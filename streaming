                        hasNavigator
                ))
                .where(predicates.toArray(new Predicate[0]))
                .groupBy(sp.get(SHIPPED_FROM))
                .orderBy(cb.desc(countShippedFrom));

        return entityManager.createQuery(query)
                .setMaxResults(TrackingFilterConstants.MAX_LIMIT)
                .getResultList();
