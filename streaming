    when(scanEvent.getLocation()
            .getLocationContactAndAddress()
            .getAddress()
            .getStateOrProvinceCode())
        .thenReturn("MH");

    when(scanEvent.getEventAdditionalInfo())
        .thenReturn(Map.of(
            Constants.RECIPIENT_SIGNEE,
            "John"));

    // -------------------------------------------------------------------------
    // Final DTO
    // -------------------------------------------------------------------------

    TrackingFedexDTO fedex =
        TrackingFedexDTO.builder()
            .trackResult(trackResult)
            .scanEvent(scanEvent)
            .surroundInsights(null)
            .build();

    return fedex;
