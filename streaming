    @PostMapping("/entities")
    public TrackingResourceResponse createTrackingResource(@RequestParam(value = "aspectName")
                                                           String aspectName,
                                                           @RequestBody TrackingResourceRequest trackingResourceRequest,
                                                           @RequestHeader HttpHeaders httpHeaders) throws TrackingResourceException {

        log.atInfo()
                .setMessage("Request arrived with aspectName : " + aspectName)
                .log();
        checkNull(aspectName);
        OflUserDetailsDTO oflUserDetailsDTO = commonService.getUserDetailsFromHeader(httpHeaders);
