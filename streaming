@Slf4j
@Service
public class SavedViewsReportsCountGetter {

  private final TrackingRepository trackingRepository;
  private final TrackingSpecification trackingSpecification;
  private final Executor defaultAsyncExecutor;

  public SavedViewsReportsCountGetter(
      TrackingRepository trackingRepository,
      TrackingSpecification trackingSpecification,
      @Qualifier("defaultAsyncExecutor") Executor defaultAsyncExecutor) {
    this.trackingRepository = trackingRepository;
    this.trackingSpecification = trackingSpecification;
    this.defaultAsyncExecutor = defaultAsyncExecutor;
  }

  public List<SavedViewsReportsDto> addRecordCounts(
      List<SavedViewsReportsDto> savedViewsReportsDtos, CountCriteria countCriteria, UUID userId) {

    Map<String, String> filters = countCriteria.getFilters();

    // Remove buttonFilter for base filters
    Map<String, String> statusConditionFilters = filters != null ? new HashMap<>(filters) : new HashMap<>();
    statusConditionFilters.remove(ServiceCommonConstants.STATUS_CONDITION);

    // Helper to add buttonFilter
    Function<String, Map<String, String>> withStatusConditionFilter =
        filter -> {
          Map<String, String> map = new HashMap<>(statusConditionFilters);
          map.put(ServiceCommonConstants.STATUS_CONDITION, filter);
          return map;
        };

    // Asynchronously fetch counts for each status
      var delayedCountFuture =
        getCountFuture(countCriteria, ServiceCommonConstants.DELAYED, userId, withStatusConditionFilter);
      var atRiskCountFuture =
              getCountFuture(countCriteria, ServiceCommonConstants.AT_RISK, userId, withStatusConditionFilter);
      var allCountFuture =
              getCountFuture(countCriteria, ServiceCommonConstants.ALL, userId, withStatusConditionFilter);

      ZoneId zoneId = ZoneId.of(countCriteria.getTimezone());
      Map<String, String> deliveredTodayFilters = new HashMap<>(countCriteria.getFilters());
      deliveredTodayFilters.put(ServiceCommonConstants.DELIVERED_DATE, LocalDate.now(zoneId).toString());
      var deliveredTodayCountFuture = getCountFuture(countCriteria, userId, deliveredTodayFilters);

      Map<String, String> createdTodayFilters = new HashMap<>(countCriteria.getFilters());
      createdTodayFilters.put(ServiceCommonConstants.CREATED_DATE, LocalDate.now(zoneId).toString());
      var createdTodayCountFuture = getCountFuture(countCriteria, userId, createdTodayFilters);

      Map<String, String> arrivingTodayFilters = new HashMap<>(countCriteria.getFilters());
      arrivingTodayFilters.put(ServiceCommonConstants.ARRIVING_DATE, LocalDate.now(zoneId).toString());
      var arrivingTodayCountFuture = getCountFuture(countCriteria, userId, arrivingTodayFilters);

      var delayedCount = getCount(delayedCountFuture, ServiceCommonConstants.DELAYED);
      var atRiskCount = getCount(atRiskCountFuture, ServiceCommonConstants.AT_RISK);
      var allCount = getCount(allCountFuture, ServiceCommonConstants.ALL);
      var deliveredTodayCount = getCount(deliveredTodayCountFuture, ServiceCommonConstants.DELIVERED_DATE);
      var createdTodayCount = getCount(createdTodayCountFuture, ServiceCommonConstants.CREATED_DATE);
      var arrivingTodayCount = getCount(arrivingTodayCountFuture, ServiceCommonConstants.ARRIVING_DATE);


      addCount(savedViewsReportsDtos, ServiceCommonConstants.DELAYED, delayedCount);
      addCount(savedViewsReportsDtos, ServiceCommonConstants.VIEW_NAME_AT_RISK, atRiskCount);
      addCount(savedViewsReportsDtos, ServiceCommonConstants.DELIVERED_TODAY_STATUS, deliveredTodayCount);
      addCount(savedViewsReportsDtos, ServiceCommonConstants.CREATED_TODAY, createdTodayCount);
      addCount(savedViewsReportsDtos, ServiceCommonConstants.ARRIVING_TODAY, arrivingTodayCount);
      addCount(savedViewsReportsDtos, ServiceCommonConstants.ALL, allCount);
      updateDateFromToToday(savedViewsReportsDtos, countCriteria.getTimezone());

    return savedViewsReportsDtos;
  }
    private static void updateDateFromToToday(List<SavedViewsReportsDto> reportsDtoList, String timezone) {
        if (reportsDtoList == null) return;
        for (SavedViewsReportsDto dto : reportsDtoList) {
            if(dto.getViewName() != null) {
                updateJsonNodeFilter(dto.getViewFilterJson(), timezone, dto.getViewName());
            }
        }
    }
    private static void updateJsonNodeFilter(JsonNode viewFilterJson, String timezone, String viewName) {
        if (viewFilterJson == null || !viewFilterJson.isObject()) return;
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern(ServiceCommonConstants.DATE_FORMAT_YYYY_MM_DD_00_00_00);
        String today = LocalDate.now(ZoneId.of(timezone)).format(formatter);

        Iterator<Map.Entry<String, JsonNode>> fields = viewFilterJson.fields();
        while (fields.hasNext()) {
            Map.Entry<String, JsonNode> entry = fields.next();
            JsonNode filterNode = entry.getValue();
            if (filterNode.has(ServiceCommonConstants.DATE_FROM) &&
                    (viewName.equals(ServiceCommonConstants.DELIVERED_TODAY_STATUS) ||
                    viewName.equals(ServiceCommonConstants.CREATED_TODAY) ||
                    viewName.equals(ServiceCommonConstants.ARRIVING_TODAY))) {
                ((ObjectNode) filterNode).put(ServiceCommonConstants.DATE_FROM, today);
            }
        }
    }

  private static void addCount(
      List<SavedViewsReportsDto> savedViewsReportsDtos, String viewName, long recordCount) {
    savedViewsReportsDtos.stream()
        .filter(dto -> dto.getViewName().equalsIgnoreCase(viewName))
        .findFirst()
        .ifPresent(savedViewsReportsDto -> savedViewsReportsDto.setRecordCount(recordCount));
  }

  private static long getCount(CompletableFuture<Long> future, String viewName) {
    return future
        .handle(
            (result, ex) -> {
              if (ex != null) {
                  log.atError()
                          .setMessage("Error fetching %s count".formatted(viewName))
                          .setCause(ex).log();
                return 0L;
              }
              return result;
            })
        .join();
  }

  private @NonNull CompletableFuture<Long> getCountFuture(
      CountCriteria countCriteria,
      String viewName,
      UUID userId,
      Function<String, Map<String, String>> withStatusConditionFilter) {
    return CompletableFuture.supplyAsync(
        () -> {
          var spec =
              trackingSpecification.buildSpecification(
                  userId,
                  countCriteria.isShipmentPageWanted(),
                  countCriteria.isMyShipment(),
                  countCriteria.getShippingLocation(),
                  withStatusConditionFilter.apply(viewName),
                  null,
                  null,
                  countCriteria.getTimezone(),
                  countCriteria.getShipperAccountNumbers(),
                  countCriteria.isNonNavigator());
          return trackingRepository.count(spec);
        },
        defaultAsyncExecutor);
  }
    private @NonNull CompletableFuture<Long> getCountFuture(
            CountCriteria countCriteria,
            UUID userId, Map<String, String> filters) {
        return CompletableFuture.supplyAsync(
                () -> {
                    var spec =
                            trackingSpecification.buildSpecification(
                                    userId,
                                    countCriteria.isShipmentPageWanted(),
                                    countCriteria.isMyShipment(),
                                    countCriteria.getShippingLocation(),
                                    filters,
                                    null,
                                    null,
                                    countCriteria.getTimezone(),
                                    countCriteria.getShipperAccountNumbers(),
                                    countCriteria.isNonNavigator());
                    return trackingRepository.count(spec);
                },
                defaultAsyncExecutor);
    }
}

