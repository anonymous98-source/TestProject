                    : trackingPviCaseEntities.stream()
                        .map(this::mapTrackingPviCasesToDTO)
                        .toList());

    var shipmentEntity = shipmentRepository.findByPackageId(trackingEntity.getPackageId());
    var packageEntity = packageRepository.findById(trackingEntity.getPackageId());

    if (trackingDownloadRequest.isIncludePriceQuote()) {
      var priceQuoteEntities =
          priceQuoteRepository.findAllByPackageId(trackingEntity.getPackageId());
      String totalAmount =
          Optional.ofNullable(priceQuoteEntities).orElse(Collections.emptyList()).stream()
              .map(pq -> pq != null ? pq.getTotalAmount() : null)
              .filter(Objects::nonNull)
              .map(Object::toString)
              .findFirst()
              .orElse(null);
      trackingDtoBuilder
          .shipmentCostCenter(shipmentEntity.getShipmentCostCenter())
              .shipmentCostCenterNumber(shipmentEntity.getCostCenterNumber())
          .totalAmountPriceQuote(totalAmount);
    }

    if (trackingDownloadRequest.isIncludeTrackingEvents()) {
      trackingDtoBuilder.trackingEvents(
          mapTrackingEventsToDTO(trackingEventRepository.findAllByTrackingId(trackingEntity.getId())));
    }

    if (packageEntity.isPresent()) {
      PackageDTO packageDto = PackageDTO.builder().build();
      if (shipmentEntity != null) {
        var shipmentDto =
            ShipmentDTO.builder()
                .id(shipmentEntity.getId())
                .shiShipmentTransactionId(shipmentEntity.getShipmentTransactionId())
                .shipmentSource(shipmentEntity.getShipmentSource())
                .shiCustomerId(shipmentEntity.getCustomerId())
                .shiBillingGroupId(shipmentEntity.getBillingGroupId())
                .shiFacilityId(shipmentEntity.getFacilityId())
                .shiShipmentCarrierDetails(shipmentEntity.getShipmentCarrierDetails())
                .build();
        packageDto.setShipment(shipmentDto);
      }
      if (Objects.nonNull(trackingEntity.getShipDate()))
        packageDto.setTrkShipDate(trackingEntity.getShipDate());
      trackingDtoBuilder.pkg(packageDto);
    }
    trackingDto = trackingDtoBuilder.build();

    TrackingDownloadResponse trackingDownloadResponse =
        TrackingDownloadResponse.builder().trackingDto(trackingDto).build();
    log.atInfo().setMessage("tracking details set successfully.").log();
    return trackingDownloadResponse;
  }

  private List<TrackingEventDto> mapTrackingEventsToDTO(List<TrackingEventEntity> trackingEventEntities) {
    if (trackingEventEntities == null) {
      return Collections.emptyList();
    }
    return trackingEventEntities.stream()
        .map(
            entity ->
                TrackingEventDto.builder()
                    .id(entity.getId())
                    .trackingId(entity.getTrackingId())
                    .trackingEventType(entity.getTrackingEventType())
                    .trackingStatus(entity.getTrackingStatus())
                    .trackingEventStatusUpdatedAt(entity.getTrackingEventStatusUpdatedAt())
                    .trackingEventMessage(entity.getTrackingEventMessage())
                    .scanLocation(entity.getScanLocation())
                    .trackingTimezoneOffset(entity.getTrackingTimezoneOffset())
                    .trackingEventCode(entity.getTrackingEventCode())
                    .eventAdditionalInfo(entity.getEventAdditionalInfo())
                    .trackingEventReason(entity.getTrackingEventReason())
                    .build())
        .toList();
  }

  private SurroundInsightsDTO mapSurroundInsightsToDTO(
      SurroundInsightsEntity entity,
      Integer pviCaseCount,
      List<TrackingPviCasesEntity> trackingPviCasesEntities) {
    if (entity == null) return null;
    List<InterventionHistoryDTO> interventionHistory = parseInterventionHistory(entity);
    List<SupportUpdateHistoryDTO> supportUpdateHistory = parseSupportUpdateHistory(entity);
    List<String> healthcareIdentifier = parseHealthcareIdentifier(entity);
    List<CaseListDTO> caseList = parseCaseListAndCount(entity, trackingPviCasesEntities);
    return SurroundInsightsDTO.builder()
        .caseList(caseList)
        .caseCount(pviCaseCount)
        .subStatus(entity.getSubStatus())
        .weatherImpacted(entity.getWeatherImpacted())
        .interventionHistory(interventionHistory)
        .healthcareIdentifier(healthcareIdentifier)
        .supportUpdateHistory(supportUpdateHistory)
        .surroundSubscriptionTier(entity.getSurroundSubscriptionTier())
        .surroundDeliveryPrediction(entity.getSurroundDeliveryPrediction())
        .senseAwareMobile(entity.getSenseawareMobile())
        .arrivalStatusCode(entity.getArrivalStatusCode())
        .healthcareIdentifier(Collections.singletonList(entity.getSurroundHcid()))
        .build();
  }

  private List<InterventionHistoryDTO> parseInterventionHistory(SurroundInsightsEntity entity) {
    // Use the shared objectMapper for consistency and performance
    if (entity.getInterventionHistory() != null && !entity.getInterventionHistory().isNull()) {
      try {
        return objectMapper
            .readerForListOf(InterventionHistoryDTO.class)
            .readValue(entity.getInterventionHistory());
      } catch (Exception ignored) {
        // If parsing fails, return an empty list to indicate no valid intervention history
        return Collections.emptyList();
      }
    }
    return Collections.emptyList();
  }

  private List<SupportUpdateHistoryDTO> parseSupportUpdateHistory(SurroundInsightsEntity entity) {
    if (entity.getSupportUpdateHistory() != null && !entity.getSupportUpdateHistory().isNull()) {
      try {
        return objectMapper
            .readerForListOf(SupportUpdateHistoryDTO.class)
            .readValue(entity.getSupportUpdateHistory());
      } catch (Exception ignored) {
        // If parsing fails, return an empty list to indicate no valid support update history
        return Collections.emptyList();
      }
    }
    return Collections.emptyList();
  }

  private List<String> parseHealthcareIdentifier(SurroundInsightsEntity entity) {
    if (entity.getSurroundHcid() != null && !entity.getSurroundHcid().isBlank()) {
      return Arrays.asList(entity.getSurroundHcid().split(","));
    }
    return new ArrayList<>();
  }

  /** Returns a List<CaseListDTO> containing a non-null list of CaseListDTO and its count. */
  private static List<CaseListDTO> parseCaseListAndCount(
      SurroundInsightsEntity entity, List<TrackingPviCasesEntity> trackingPviCasesEntities) {
    List<CaseListDTO> caseList = Collections.emptyList();
    if (trackingPviCasesEntities != null) {
      caseList =
          trackingPviCasesEntities.stream()
              .map(
                  pvi ->
                      new CaseListDTO(
                          pvi.getCaseNumber(),
                          pvi.getCaseType(),
                          pvi.getCaseSubCategory(),
                          pvi.getCaseStatus(),
                          pvi.getCaseCreateTime() != null
                              ? pvi.getCaseCreateTime().toString()
                              : null,
                          pvi.getCaseCloseTime() != null
                              ? pvi.getCaseCloseTime().toString()
                              : null))
              .toList();
    }
    return caseList;
  }

  private TrackingPviCasesDTO mapTrackingPviCasesToDTO(TrackingPviCasesEntity entity) {
    if (entity == null) return null;
    return new TrackingPviCasesDTO(
        entity.getId(),
        null,
        entity.getCaseNumber(),
        entity.getCaseType(),
        entity.getCaseSubCategory(),
        entity.getCaseStatus(),
        entity.getCaseCreateTime(),
        entity.getCaseCloseTime());
  }
}

