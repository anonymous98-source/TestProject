            graphDataRequestDto.getSelectedServiceLevels(),
            graphDataRequestDto.getFacilityIdList(),
            graphDataRequestDto.getPeriodInDays().intValue());

    return shippingProfileCountProjections.stream()
        .map(
            shippingProfileCountProjection ->
                GraphDataResponseDto.builder()
                    .count(shippingProfileCountProjection.getTotalCount())
                    .shippingProfileName(shippingProfileCountProjection.getShippingProfileName())
