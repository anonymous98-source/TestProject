package com.cardinalhealth.advship.tracking.resource.visualization.service.impl;

import com.cardinalhealth.advship.tracking.resource.visualization.constant.VisualizationConstant;
import com.cardinalhealth.advship.tracking.resource.visualization.service.AsyncRefreshService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

@Slf4j
@Service
@RequiredArgsConstructor
public class AsyncRefreshServiceImpl implements AsyncRefreshService {

  private final JdbcTemplate jdbcTemplate;

  /**
   * This method executes the refresh query for a specific materialized view asynchronously. It
   * constructs the appropriate SQL query based on the materialized view name and executes it using
   * JdbcTemplate. The method is annotated with @Async to ensure it runs in a separate thread,
   * allowing multiple refresh operations to run concurrently without blocking the main thread.
   *
   * @param materializedViewName the name of the materialized view to refresh
   */
  @Async("defaultAsyncExecutor")
  @Override
  public void refreshMaterializedViewInAsync(String materializedViewName) {
    String query =
        switch (materializedViewName) {
          case VisualizationConstant.MATERIALIZED_VIEW_GENERIC_PARENT_MV ->
              String.format(
                  VisualizationConstant.REFRESH_MATERIALIZED_VIEW_QUERY,
                  VisualizationConstant.SCHEMA_NAME_TRACKING_RESOURCE,
                  VisualizationConstant.MATERIALIZED_VIEW_GENERIC_PARENT_MV);
          case VisualizationConstant.MATERIALIZED_VIEW_ADDRESS_SUGGESTION_USAGE ->
              String.format(
                  VisualizationConstant.REFRESH_MATERIALIZED_VIEW_QUERY,
                  VisualizationConstant.SCHEMA_NAME_TRACKING_RESOURCE,
                  VisualizationConstant.MATERIALIZED_VIEW_ADDRESS_SUGGESTION_USAGE);
          case VisualizationConstant.MATERIALIZED_VIEW_PICKUP_SCAN_TIMELINE ->
              String.format(
                  VisualizationConstant.REFRESH_MATERIALIZED_VIEW_QUERY,
                  VisualizationConstant.SCHEMA_NAME_TRACKING_RESOURCE,
                  VisualizationConstant.MATERIALIZED_VIEW_PICKUP_SCAN_TIMELINE);
          case VisualizationConstant.MATERIALIZED_VIEW_COURIER_REASON_CODE ->
              String.format(
                  VisualizationConstant.REFRESH_MATERIALIZED_VIEW_QUERY,
                  VisualizationConstant.SCHEMA_NAME_TRACKING_RESOURCE,
                  VisualizationConstant.MATERIALIZED_VIEW_COURIER_REASON_CODE);
          default -> {
            log.atWarn()
                    .setMessage(
                        "Attempted refresh of invalid materialized view: " + materializedViewName)
                    .log();
            yield null;
          }
        };

    if (query == null) {
      return;
    }

    log.atInfo().setMessage("Async refresh started for query: " + query).log();
    jdbcTemplate.execute(query);
    log.atInfo().setMessage("Async refresh completed for query: " + query).log();
  }
}

