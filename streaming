        Map<String, String> filters = new HashMap<>(context.getRequestFilters());
        if (filters.containsKey(CARRIERS) && !filters.get(CARRIERS).isBlank()) {
            filters.put(CARRIERS, "");
        }
        List<Predicate> predicates = buildPredicates(filters, cb, s, t,
                context.getMonarchId(), context.getDynamicFilterRequest(), p, shipmentQuery);

        shipmentQuery.multiselect(
                s.get(SHIPMENT_CARRIER_DETAILS)
        ).distinct(true);

        shipmentQuery.where(predicates.toArray(new Predicate[0]));
    }

