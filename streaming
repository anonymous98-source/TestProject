import static org.assertj.core.api.Assertions.assertThat;

class SqlBundleBuilderTest {

    private final SqlBundleBuilder builder = new SqlBundleBuilder();

    @Test
    void buildOriginalAndRedactedScripts_useConfiguredFields() {
        // Given one row in each table with id = 1
        Map<String, List<Map<String, Object>>> tableRows = Map.of("shipment", List.of(Map.of("id", 1, "ship_to_company", "ACME", "ship_to_email", "x@y.com")), "tracking", List.of(Map.of("id", 2, "signatory_name", "Bob", "user_email", "bob@y.com")), "tracking_pod", List.of(Map.of("id", 3, "pod_content", "signed")), "external_reference", List.of(Map.of("id", 4, "external_reference_value_json", "{\"a\":1}", "patient_record", "{\"p\":1}")));
        // When
        var originals = builder.buildOriginalScripts(tableRows);
        var redacted = builder.buildRedactedScripts(tableRows);

        // Then
        assertThat(originals.get("shipment")).contains("UPDATE shipment SET ship_to_company = 'ACME'").contains("ship_to_email = 'x@y.com'").contains("WHERE id = '1'");
        assertThat(redacted.get("shipment")).contains("UPDATE advship_tracking_resource.shipment SET ship_to_company = 'Redacted'").contains("ship_to_email = 'Redacted'").contains("WHERE id = '1'");


        assertThat(redacted.get("external_reference")).contains("external_reference_value_json = '\"Redacted\"'::jsonb").contains("patient_record = '\"Redacted\"'::jsonb");
    }

