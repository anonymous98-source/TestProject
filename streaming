  @Transactional
  @Override
  public SaveFilterResponse saveTrackingDto(TrackingSaveRequest trackingSaveRequest) {
    try {
      TrackingDTO trackingDto = trackingSaveRequest.getTrackingDto();

    if(trackingDto.getPkg()!=null && trackingDto.getPkg().getShipment()!=null &&
            trackingDto.getPkg().getShipment().getShiShipmentCarrierDetails().equalsIgnoreCase(COURIER)&& STATUS_VOID.equalsIgnoreCase(trackingDto.getTrkTrackingLastStatus())){
      trackingRepository.updateExpectedDeliveryDate(trackingDto.getId(), null);

    }

      TrackingUpdateFieldsDTO updateFields =
          TrackingUpdateFieldsDTO.builder()
              .id(trackingDto.getId())
              .deliveryDate(trackingDto.getTrkDeliveryDate())
              .expectedDeliveryDate(!STATUS_VOID.equalsIgnoreCase(trackingDto.getTrkTrackingLastStatus()) ? trackingDto.getTrkExpectedDeliveryDate():null)
              .signatoryName(trackingDto.getTrkSignatoryName())
              .trackingLastScanLocation(trackingDto.getTrkTrackingLastScanLocation())
              .trackingLastUpdatedAt(trackingDto.getTrkTrackingLastUpdatedAt())
              .trackingLastStatus(trackingDto.getTrkTrackingLastStatus())
              .trackingLastMessage(trackingDto.getTrkTrackingLastMessage())
              .delayReason(trackingDto.getDelayReason())
              .shipDate(trackingDto.getPkg() != null ? trackingDto.getPkg().getTrkShipDate() : null)
              .build();

      TrackingEntity trackingUpdate = trackingRepository.findById(trackingDto.getId())
              .orElseThrow(() -> new ResourceNotFoundException("Tracking data not found: " + trackingDto.getId()));

      if (trackingDto.getPkg() != null && trackingDto.getPkg().getShipment() != null
              && trackingDto.getPkg().getShipment().getShiShipmentCarrierDetails().equalsIgnoreCase(FEDEX)
              && (trackingUpdate.getTrackingLastUpdatedAt() == null
              || !trackingUpdate.getTrackingLastUpdatedAt().isAfter(updateFields.getTrackingLastUpdatedAt()))
              && (trackingUpdate.getTrackingLastStatus() == null
              || !trackingUpdate.getTrackingLastStatus().trim().equalsIgnoreCase("delivered"))){
        updateAndSaveTracking(trackingUpdate, updateFields);
      } else if ((trackingUpdate.getTrackingLastUpdatedAt() == null ||
                      !trackingUpdate.getTrackingLastUpdatedAt().isAfter(updateFields.getTrackingLastUpdatedAt()))
              && (trackingUpdate.getTrackingLastStatus() == null ||
                      (!trackingUpdate.getTrackingLastStatus().trim().equalsIgnoreCase("void") &&
                              !trackingUpdate.getTrackingLastStatus().trim().equalsIgnoreCase("delivered")))) {
        updateAndSaveTracking(trackingUpdate, updateFields);
      }

      // Updated shipmentEntity expected delivery datetime if the value of this field was null on shipmentEntity table
      if(trackingDto.getTrkExpectedDeliveryDate()!=null){
        shipmentRepository.updateShipmentExpectedDeliveryDate(
            trackingDto.getPkg().getShipment().getId(),
            trackingDto.getTrkExpectedDeliveryDate());
      }

      if (PICKED_UP.equalsIgnoreCase(trackingDto.getTrkTrackingLastStatus())) {
        shipmentRepository.updateShipmentFieldsForPickUpDateTime(
            trackingDto.getPkg().getShipment().getId(),
            trackingDto.getPkg().getShipment().getShiShipmentPickupDatetime(),
            trackingDto.getRiskScore(),
            trackingDto.getGpsDeliveryLocation());
      } else if (DELIVERED.equalsIgnoreCase(trackingDto.getTrkTrackingLastStatus())) {
        shipmentRepository.updateShipmentFieldsForDeliveryDateTime(
            trackingDto.getPkg().getShipment().getId(),
            trackingDto.getPkg().getShipment().getShiShipmentDeliveryDatetime(),
            trackingDto.getRiskScore(),
            trackingDto.getGpsDeliveryLocation());
      }

      TrackingEventEntity trackingEventEntity =
          TrackingEventEntity.builder()
              .eventAdditionalInfo(trackingSaveRequest.getTrackingEvent().getEventAdditionalInfo())
              .trackingEventType(trackingSaveRequest.getTrackingEvent().getTrackingEventType())
              .trackingStatus(trackingSaveRequest.getTrackingEvent().getTrackingStatus())
              .trackingEventStatusUpdatedAt(
                  trackingSaveRequest.getTrackingEvent().getTrackingEventStatusUpdatedAt())
              .trackingEventMessage(
                  trackingSaveRequest.getTrackingEvent().getTrackingEventMessage())
              .scanLocation(trackingSaveRequest.getTrackingEvent().getScanLocation())
              .trackingTimezoneOffset(
                  trackingSaveRequest.getTrackingEvent().getTrackingTimezoneOffset())
              .trackingEventCode(trackingSaveRequest.getTrackingEvent().getTrackingEventCode())
              .trackingEventReason(trackingSaveRequest.getTrackingEvent().getTrackingEventReason())
              .trackingId(trackingDto.getId())
              .build();
      trackingEventEntity = trackingEventRepository.save(trackingEventEntity);

      if (Boolean.TRUE.equals(trackingSaveRequest.getTrackingEvent().getIsBackFilledEvent())) {
        trackingEventRepository.updateBackFilledEventData(trackingEventEntity.getId(), BACKFILLED_EVENT);
      }
      TrackingSignatoryDto trackingSignatoryObj = trackingSaveRequest.getTrackingSignatory();
      if (trackingSignatoryObj != null
          && StringUtils.isNotBlank(trackingSignatoryObj.getSignatoryName())) {
        TrackingSignatoryEntity trackingSignatoryEntity =
            TrackingSignatoryEntity.builder()
                .signatoryName(trackingSignatoryObj.getSignatoryName())
                .trackingId(trackingDto.getId())
                .build();
        trackingSignatoryRepository.save(trackingSignatoryEntity);
      }
      // Update or create SurroundInsights from DTO
      if (trackingDto.getSurroundInsights() != null) {
        TrackingEntity trackingEntity = trackingRepository.findById(trackingDto.getId())
                .orElseThrow(() -> new ResourceNotFoundException("Tracking not found: " + trackingDto.getId()));
        trackingEntity.setSurroundConfidenceScore(trackingDto.getSurroundConfidenceScore());
        trackingEntity.setPviCaseCount(trackingDto.getSurroundInsights().getCaseCount());
        JsonNode caseListNode = objectMapper.valueToTree(trackingDto.getSurroundInsights().getCaseList());
        CaseListDTO latestCase = surroundInsightUtils.getLatestCaseNode(caseListNode);
        if (latestCase != null) {
            trackingEntity.setPviCaseLastStatus(latestCase.getCaseStatus()!=null ? latestCase.getCaseStatus() : null);
        } else {
            trackingEntity.setPviCaseLastStatus(null);
        }
        shipmentServiceImpl.upsertSurroundInsights(trackingEntity.getId(), trackingDto.getSurroundInsights());
        shipmentServiceImpl.setLatestInterventionAndCaseFields(trackingEntity, trackingDto.getSurroundInsights());
        trackingRepository.save(trackingEntity);
        trackingPviCasesRepository.saveAll(surroundInsightUtils.upsertTrackingPviCasesEntities(trackingDto.getSurroundInsights().getCaseList(), trackingEntity.getId()));
        var existingSurroundInsightsEntity = surroundInsightsRepository.findByTrackingId(trackingEntity.getId());
        if (existingSurroundInsightsEntity != null) {
          existingSurroundInsightsEntity.setArrivalStatusCode(trackingDto.getSurroundInsights().getArrivalStatusCode());
          existingSurroundInsightsEntity = surroundInsightsRepository.save(existingSurroundInsightsEntity);
        }
        var supportUpdateHistory = existingSurroundInsightsEntity != null ? existingSurroundInsightsEntity.getSupportUpdateHistory() : null;
      }

      log.atInfo()
              .setMessage(
                  "Tracking saved for tracking number: " + trackingDto.getTrkTrackingNumber())
              .log();
      return SaveFilterResponse.builder().status("success").message("successfullySaved").build();
    } catch (Exception e) {
      throw new ResourceNotFoundException(e.getMessage(), e);
    }
  }

  private void updateAndSaveTracking(TrackingEntity trackingUpdate, TrackingUpdateFieldsDTO updateFields) {
    trackingUpdate.setDeliveryDate(updateFields.getDeliveryDate());
    trackingUpdate.setSignatoryName(updateFields.getSignatoryName());
    if (updateFields.getExpectedDeliveryDate() != null) {
      trackingUpdate.setExpectedDeliveryDate(updateFields.getExpectedDeliveryDate());
    }
    trackingUpdate.setTrackingLastScanLocation(updateFields.getTrackingLastScanLocation());
    trackingUpdate.setTrackingLastUpdatedAt(updateFields.getTrackingLastUpdatedAt());
    trackingUpdate.setTrackingLastStatus(updateFields.getTrackingLastStatus());
    trackingUpdate.setTrackingLastMessage(updateFields.getTrackingLastMessage());
    trackingUpdate.setDelayReason(updateFields.getDelayReason());
    trackingUpdate.setShipDate(updateFields.getShipDate());
    trackingRepository.save(trackingUpdate);
  }


  @NotNull
  private Map<String, String> getTrackingIdToShipmentTransactionIdMap(List<TrackingDTO> dtoPage) {
    long mapCreationStartTime = System.currentTimeMillis();
    log.atInfo()
            .setMessage("creating map of tracking id to shipmentEntity transaction id")
            .log();
    Map<String, String> trackingIdWithShipmentTransactionId =
        dtoPage.stream()
            .filter(
                trackingDto ->
                    trackingDto != null
                        && trackingDto.getId() != null
                        && trackingDto.getPkg() != null
                        && trackingDto.getPkg().getShipment() != null
                        && trackingDto.getPkg().getShipment().getShiShipmentTransactionId() != null)
            .collect(
                Collectors.toMap(
                    trackingDto -> trackingDto.getId().toString(),
                    trackingDto -> trackingDto.getPkg().getShipment().getShiShipmentTransactionId(),
                    (existing, replacement) -> {
                      log.atWarn()
                              .setMessage(
                                  "duplicate tracking id found when creating map of tracking id  shipmentTxnId")
                              .addKeyValue("existingShipmentTxnId", existing)
                              .addKeyValue("replacementShipmentTxnId", replacement)
                              .log();
                      return existing;
                    }));

    long mapCreationEndTime = System.currentTimeMillis();
    long mapCreationDuration = mapCreationEndTime - mapCreationStartTime;
    log.atInfo()
            .setMessage("created map of tracking id to sendflex transaction id")
            .addKeyValue(DURATION, mapCreationDuration)
            .log();
    return trackingIdWithShipmentTransactionId;
  }

  @NotNull
  private List<TrackingDTO> mapToTrackingDtos(Page<TrackingPodProjection> page) {
    long dtoCreationStartTime = System.currentTimeMillis();
    log.atInfo()
            .setMessage("converting DB results page to response DTO page")
            .addKeyValue("dbResultsSize", page.getTotalElements())
            .log();
    List<TrackingDTO> trackingDtos =
        page.getContent().stream()
            .map(
                tp -> {
                  TrackingDTO trackingDto =
                      TrackingDTO.builder()
                          .id(tp.getId())
                          .trkTrackingNumber(tp.getTrackingNumber())
                          .trkLastModifiedAt(tp.getLastModifiedAt())
                          .build();

                  ShipmentDTO shipmentDto =
                      ShipmentDTO.builder()
                          .id(tp.getShipmentId())
                          .shiCustomerId(tp.getCustomerId())
                          .shiFacilityId(tp.getFacilityId())
                          .shiShipmentTransactionId(tp.getShipmentTransactionId())
                          .shiShipmentCarrierDetails(tp.getShipmentCarrierDetails())
                          .shiShipperAccountNumber(tp.getSurroundBillToNumber())
                          .shiShipmentOptiFreightNumber(tp.getShipmentOptiFreightNumber())
                          .shiShipmentNonOptiFreightNumber(tp.getShipmentNonOptiFreightNumber())
                          .build();

                  ExternalReferenceDTO externalReferenceDto =
                      ExternalReferenceDTO.builder()
                          .extExternalOrderId(tp.getExternalOrderId())
                          .extExternalReferenceName(tp.getExternalReferenceName())
                          .extPatientRecord(tp.getPatientRecord())
                          .extExternalReferenceValueJson(tp.getExternalReferenceValueJson())
                          .build();

                  PackageDTO packageDto =
                      PackageDTO.builder()
                          .id(tp.getPackageId())
                          .shipment(shipmentDto)
                          .externalReference(externalReferenceDto)
                          .build();

                  trackingDto.setPkg(packageDto);
                  return trackingDto;
                })
            .collect(Collectors.toList());
    long dtoCreationEndTime = System.currentTimeMillis();
    long dtoCreationDuration = dtoCreationEndTime - dtoCreationStartTime;
    log.atInfo()
            .setMessage("converted DB results page to response DTO page")
            .addKeyValue(DURATION, dtoCreationDuration)
            .log();
    return trackingDtos;
  }

  private Page<TrackingPodProjection> getTrackingByDeliveredStatusAndNullPod(
      Pageable pageable, boolean isNonNavigator) {
    long queryStartTime = System.currentTimeMillis();
    log.atInfo()
            .setMessage("fetching distinct tracking by delivered and null POD")
            .log();
    Page<TrackingPodProjection> page;
    Date endDate = Date.from(Instant.now());
    Date startDate = Date.from(Instant.now().minus(properties.getLookBackDays(), ChronoUnit.DAYS));
    if (isNonNavigator) { // fetch non-navigator records
      page =
          trackingRepository.findDistinctRecordsByDeliveredStatusAndNullPod(
              DELIVERED, List.of(NON_NAVIGATOR_POD.toLowerCase()), startDate, endDate, pageable);
    } else {
      page =
          trackingRepository.findDistinctRecordsByDeliveredStatusAndNullPod(
              DELIVERED,
              List.of(NAVIGATOR_POD.toLowerCase(), SHIPMENT_SOURCE_P2P_EXTERNAL.toLowerCase()),
              startDate,
              endDate,
              pageable);
    }
    long queryEndTime = System.currentTimeMillis();
    long queryDuration = queryEndTime - queryStartTime;
    log.atInfo()
            .setMessage("found distinct tracking by delivered and null POD")
            .addKeyValue(DURATION, queryDuration)
            .log();
    return page;
  }
}

