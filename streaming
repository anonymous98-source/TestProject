public class SendFlexRecordServiceImpl implements SendFlexRecordService {
    @Autowired
    private SendFlexRecordRepository sendFlexRecordRepository;

    public SendFlexRecordDto saveSendflexRecord(SendFlexRecordDto sendFlexRecordDto) {

        if(sendFlexRecordDto != null){
           try{
               var savedEntity = sendFlexRecordRepository.save(sendFlexRecordDto.mapToEntity());
               log.atInfo()
                       .addKeyValue(ServiceCommonConstants.STATUS, "success")
                       .setMessage("SendFlex records saved successfully")
                       .log();
            return SendFlexRecordDto.map(savedEntity);
        }
           catch(ResourceNotFoundException e){
               log.atError()
                       .addKeyValue(ServiceCommonConstants.STATUS, "failed")
                       .setMessage("An error occured while saving sendflex records")
                       .setCause(e).log();
               throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "An unexpected error occurred while saving Sendflex records");
           }
        }
        else {
            log.atError()
                    .addKeyValue(ServiceCommonConstants.STATUS, "failed")
                    .setMessage("Record was not saved successfully")
                    .log();

            throw  new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,"Sendflex records was not saved");
        }

    }

    @Override
    public TrackingResourceResponse saveTrackingResourceData(TrackingResourceRequest trackingResourceRequest, OflUserDetailsDTO oflUserDetailsDTO) throws TrackingResourceException {
        log.info( "tracking resource request received.");

        if(!(trackingResourceRequest instanceof SendFlexRecordRequest entity)) {
            throw new IllegalArgumentException("Invalid request type of TrackingRequest");
        }
        SendFlexRecordDto sendFlexRecordDto = SendFlexRecordDto.builder()
                .shipmentId(entity.getShipmentId())
                .sendflexTxid(entity.getSendflexTxid())
                .statusCode(entity.getStatusCode())
                .requestObject(entity.getRequestObject())
                .responseObject(entity.getResponseObject())
                .apiCode(entity.getApiCode())
                .build();

        saveSendflexRecord(sendFlexRecordDto);

        log.info("TrackingResourceResponse saved.");

        return  SendflexRecordResponse.builder()
                .message("sendflex record updated successfully")
                .status("ok").build();
    }

    @Override
    public List<ExternalApiLogDto> getSendFlexRecordsByStatusCode(String statusCode) {
        Date oneHourAgo = new Date(System.currentTimeMillis() - 3600 * 1000);
        return sendFlexRecordRepository.findAllByStatusCodeIgnoreCaseAndCreatedAtAfter(statusCode, oneHourAgo)
                .stream().map(ExternalApiLogDto::map).toList();
    }
}

