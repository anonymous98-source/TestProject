  private TrackingDetailsDbResult buildResult(
          UUID trackingId,
          UUID shipmentId,
          TrackingDetailsProjection projection,
          List<NotificationProjection> notifications,
          boolean isLast) {

    Page<UUID> page = mock(Page.class);
    when(page.hasNext()).thenReturn(!isLast);

    Map<UUID, TrackingDetailsProjection> byId = new HashMap<>();
    byId.put(trackingId, projection);

    Map<UUID, List<NotificationProjection>> notifMap = new HashMap<>();
    notifMap.put(trackingId, notifications != null ? notifications : new ArrayList<>());

    return new TrackingDetailsDbResult(
            page,
            List.of(projection),
            Map.of(),
            notifMap,
            Map.of(),
            Map.of(),
            Map.of(),
            byId,
            List.of(trackingId),
            Map.of(),
            pviCaseProjectionsByTrackingId,
            0L
    );
  }
