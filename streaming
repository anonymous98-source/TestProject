   * @return a list of DashboardCountResponseDto containing shipmentEntity counts
   */
  private List<GraphDataResponseDto> fetchShipmentCountGraphData(
      GraphDataRequestDto graphDataRequestDto, List<String> customerIdList) {
    log.atInfo(
        )
            .setMessage(
                "Fetching data for total Shipment Volume for "
                    + graphDataRequestDto.getVisualizationTabName())
            .log();

    List<CountQueryProjection> totalShipmentCount;
    if (VisualizationConstant.CARRIER_ALL.equalsIgnoreCase(graphDataRequestDto.getCarrier())
        && VisualizationConstant.TAB_NAME_OVERVIEW.equalsIgnoreCase(
            graphDataRequestDto
                .getVisualizationTabName())) { // All carriers selected and tab is Overview
      totalShipmentCount =
          materializedViewRepository.fetchAllShipmentCountGroupingByCarrier(
              graphDataRequestDto.getFacilityIdList(),
              customerIdList,
              List.of(VisualizationConstant.SHIPMENT_SOURCE_NON_NAVIGATOR),
              graphDataRequestDto.isIncludeUnverifiedData(),
              graphDataRequestDto.getPeriodInDays());

    } else {
      totalShipmentCount =
          materializedViewRepository.fetchShipmentCountByCarrierGroupingByServiceLevel(
              graphDataRequestDto.getCarrier(),
              graphDataRequestDto.getFacilityIdList(),
              customerIdList,
              List.of(VisualizationConstant.SHIPMENT_SOURCE_NON_NAVIGATOR),
              graphDataRequestDto.isIncludeUnverifiedData(),
              graphDataRequestDto.getPeriodInDays());
    }

    return totalShipmentCount.stream()
        .map(
            countQueryProjection ->
                GraphDataResponseDto.builder()
                    .carrier(countQueryProjection.getCarrier())
                    .count(countQueryProjection.getShipmentCount())
                    .serviceLevel(countQueryProjection.getServiceLevel())
                    .build())
        .toList();
  }

  /**
   * Fetches shipmentEntity heat map graph data for the Overview tab.
   *
   * @param graphDataRequestDto the request DTO containing filter parameters
   * @param customerIdList the list of customer IDs to filter by (can be null)
   * @return a list of GraphDataResponseDto containing heat map data
   */
  private List<GraphDataResponseDto> fetchShipmentHeatMapGraphData(
      GraphDataRequestDto graphDataRequestDto, List<String> customerIdList) {

    List<HeatMapProjection> heatMapData =
        materializedViewRepository.fetchShipmentProgressHeatMapGraphData(
            graphDataRequestDto.getCarrier(),
            graphDataRequestDto.getFacilityIdList(),
            customerIdList,
            List.of(VisualizationConstant.SHIPMENT_SOURCE_NON_NAVIGATOR),
            graphDataRequestDto.isIncludeUnverifiedData(),
            graphDataRequestDto.getSelectedFilterButton(),
            graphDataRequestDto.getPeriodInDays().intValue());

    boolean hasAtLeastOneNonZeroCount =
        heatMapData.stream()
            .anyMatch(
                heatMapProjection ->
                    heatMapProjection.getShipmentCount() != null
                        && heatMapProjection.getShipmentCount() > 0);

    if (hasAtLeastOneNonZeroCount) { // only return data if there is at least one non-zero count
      return heatMapData.stream()
          .map(
              heatMapProjection ->
                  GraphDataResponseDto.builder()
                      .day(heatMapProjection.getGroupedDay())
                      .hour(heatMapProjection.getGroupedHour())
                      .count(heatMapProjection.getShipmentCount())
                      .build())
          .toList();
    } else {
      log.atWarn()
              .setMessage(
                  "All counts are zero for heat map graph, returning empty data for "
                      + graphDataRequestDto.getVisualizationTabName())
              .log();
      return List.of(); // return empty list if all counts are zero
    }
  }

