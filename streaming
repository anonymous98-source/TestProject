@Service
@Slf4j
@RequiredArgsConstructor
public class SftpAccountService {
  private final SftpAccountDetailsCRUD sftpAccountDetailsCRUD;
  private final MessagingService messagingService;
  private final Environment environment;

  @Transactional
  public SftpAccountDetailsDTO saveSftpAccountDetails(SftpAccountDetailsDTO sftpAccountDetails) {
    var dto =
        sftpAccountDetailsCRUD.getSftpAccountDetails(sftpAccountDetails.getCustomerId()).block();

    if (dto != null) {
      sendEmailForSftpCredentials(sftpAccountDetails, "Update");
      return sftpAccountDetailsCRUD.saveSftpAccountDetailsSynchronized(sftpAccountDetails);
    } else {
      sendEmailForSftpCredentials(sftpAccountDetails, "Create");
      return sftpAccountDetailsCRUD.saveSftpAccountDetailsSynchronized(sftpAccountDetails);
    }
  }

  public Mono<SFTPAccountStatus> getAccountStatus(UUID customerId) {
    return getSftpAccount(customerId)
        .map(dto -> new SFTPAccountStatus(true, dto.getAccountStatus().equalsIgnoreCase("active")))
        .onErrorResume(
            ex ->
                ex instanceof ResponseStatusException rse
                    && rse.getStatusCode() == HttpStatus.NOT_FOUND,
            ex -> Mono.just(new SFTPAccountStatus(false, false)));
  }

  @Transactional
  public void deleteSftpAccount(UUID customerId) {
    var sftpAccountDetailsDTO = sftpAccountDetailsCRUD.getSftpAccountDetails(customerId).block();
    if (sftpAccountDetailsDTO != null) {
      sftpAccountDetailsCRUD.deleteSftpAccountSynchronized(customerId);
      sendEmailForSftpCredentials(sftpAccountDetailsDTO, "Delete");
    }
  }

  public Mono<List<SftpAccountDetailsDTO>> getSftpAccounts(Set<UUID> customerIdSet) {
    return sftpAccountDetailsCRUD
            .getSftpAccountDetails()
            .map(dtos -> dtos.stream().filter(dto -> customerIdSet.contains(dto.getCustomerId())).toList())
