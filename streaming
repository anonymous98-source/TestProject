                .latestInterventionDate(DateTimeUtil.convertUtcToUserTime(
                        trackingDetailsProjection.getLatestInterventionDate(), timezone))
                .latestInterventionRequested(trackingDetailsProjection.getLatestInterventionRequested())
                .latestInterventionStatus(trackingDetailsProjection.getLatestInterventionStatus())

                .surroundConfidenceScore(trackingDetailsProjection.getSurroundConfidenceScore())
                .surroundDeliveryPrediction(trackingDetailsProjection.getSurroundDeliveryPrediction())
                .surroundSubscriptionTier(trackingDetailsProjection.getSurroundSubscriptionTier())
                .surroundHcid(trackingDetailsProjection.getSurroundHcid())
                .senseawareMobile(trackingDetailsProjection.getSenseawareMobile())
                .weatherImpacted(trackingDetailsProjection.getWeatherImpacted())

                    .build();

    trackingDetailsResponseDTO.setSmsNotification(
            trackingDetailsResponseDTO.getPhoneNumbers() != null
                    && !trackingDetailsResponseDTO.getPhoneNumbers().isEmpty());

    // add support update history details
    SupportUpdateHistoryDto supportUpdateHistoryDto =
            trackingDetailsDbUtils.getSupportUpdateHistoryFromJson(trackingDetailsProjection.getSupportUpdateHistory());
    trackingDetailsResponseDTO.setInterventionNotesSupportUpdate(
            trackingDetailsDbUtils.getSegregatedString(supportUpdateHistoryDto.getInterventionNotesSupportUpdate()));
    List<LocalDateTime> listOfSupportUpdateDate = trackingDetailsDbUtils.getUserSpecificTimeZone(
            supportUpdateHistoryDto.getInterventionNotesSupportUpdatedAt(), timezone);
    trackingDetailsResponseDTO.setInterventionNotesSupportUpdatedAt(
            trackingDetailsDbUtils.getSegregatedDateTime(listOfSupportUpdateDate));

    return trackingDetailsResponseDTO;
  }

  private Integer getNoOfDaysDelay(TrackingDetailsProjection trackingDetailsProjection){
    LocalDateTime originalTime = trackingDetailsProjection.getShipmentExpectedDeliveryDatetime();
    LocalDateTime expectedTime = trackingDetailsProjection.getExpectedDeliveryDate();
    if (originalTime != null && expectedTime != null && expectedTime.isAfter(originalTime)) {
      return (int) java.time.Duration.between(originalTime, expectedTime).toDays();
    }
    return null;
  }

  private String getStatusCondition(TrackingDetailsProjection tracking) {
    Integer riskScore = tracking.getAtRiskScore();
    if (riskScore == null) {
      return EMPTY_STRING;
    }
    if (riskScore >= -20 && riskScore < 0){
      return ServiceCommonConstants.EARLY;
    } else if(riskScore >= 0 && riskScore < 20){
      return ServiceCommonConstants.ON_TIME;
    }
    else if (riskScore >= 20 && riskScore < 40) {
      return ServiceCommonConstants.AT_RISK;
    }
    else if (riskScore >= 40 && riskScore < 60) {
      return ServiceCommonConstants.DELAYED;
    }
    else if (riskScore >= 60) {
      return ServiceCommonConstants.AT_RISK_OF_FURTHER_DELAY;
    }
    return EMPTY_STRING;
  }

