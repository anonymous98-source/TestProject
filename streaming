  public String getInsuranceDetails(
      TrackingDetailsProjection trackingDetailsProjection,
      List<ShipmentProtectionEnrollmentProjection> shipmentProtectionEnrollments) {
    String insuranceDetails = null;
    if (trackingDetailsProjection.getIsShipmentProtection() != null
        && trackingDetailsProjection.getIsShipmentProtection()) {
      insuranceDetails =
              getOSPProtectionDetails(trackingDetailsProjection, shipmentProtectionEnrollments);
      log.atInfo()
              .setMessage("OSP Protection Details")
              .addKeyValue("insuranceDetails", insuranceDetails)
              .log();

    } else if (trackingDetailsProjection.getDeclaredValue() != null
        && trackingDetailsProjection.getDeclaredValue()) {
      insuranceDetails =
          ServiceCommonConstants.DOLLAR_SYMBOL
              + trackingDetailsProjection.getValueOfContent()
              + " "
              + ServiceCommonConstants.DECLARED_VALUE;
    } else if (trackingDetailsProjection.getAdditionalInsurance() != null
        && trackingDetailsProjection.getAdditionalInsurance() > 0) {
      insuranceDetails =
          ServiceCommonConstants.DOLLAR_SYMBOL
              + trackingDetailsProjection.getAdditionalInsurance()
              + " "
              + ServiceCommonConstants.ADDITIONAL_INSURANCE;
