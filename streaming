        return repository.findAll().stream().map(this::mapToResponse).toList();
    }

    private CmsReasonCodeDtoResponse mapToResponse(CmsReasonCode entity) {
        CmsReasonCodeDtoResponse response = new CmsReasonCodeDtoResponse();
        response.setReasonCode(entity.getReasonCode());
        response.setDescription(entity.getDescription());
        response.setNormalizedStatus(entity.getNormalizedStatus());
        return response;
    }
