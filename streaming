    private String statusCode;
    private Object requestObject;
    private Object responseObject;
    private String apiCode;
    private String sendflexTxid;

    public static SendFlexRecordDto map(SendFlexRecordEntity entity) {
        return SendFlexRecordDto.builder()
                .shipmentId(entity.getShipmentId())
                .sendflexTxid(entity.getSendflexTxid())
                .statusCode(entity.getStatusCode())
                .requestObject(entity.getRequestJson())
                .responseObject(entity.getResponseJson())
                .apiCode(entity.getApiCode())
                .build();
    }

    public SendFlexRecordEntity mapToEntity() {
        ObjectMapper objectMapper = new ObjectMapper();

        JsonNode requestJson = objectMapper.valueToTree(requestObject);
        JsonNode responseJson = objectMapper.valueToTree(responseObject);

        return SendFlexRecordEntity.builder()
                .shipmentId(shipmentId)
                .sendflexTxid(sendflexTxid)
                .statusCode(statusCode)
                .requestJson(requestJson)
                .responseJson(responseJson)
                .apiCode(apiCode)
                .build();
    }

}

