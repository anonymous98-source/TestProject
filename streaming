    // ShippingTo
    private List<FilterAddressDTO> fetchShippingTo(EntityManager entityManager,
                                                   Map<String, String> requestFilters,
                                                   UUID monarchId, DynamicFilterRequest dynamicFilterRequest) {
        CriteriaBuilder cb = entityManager.getCriteriaBuilder();
        CriteriaQuery<FilterAddressDTO> query = cb.createQuery(FilterAddressDTO.class);

        Root<TrackingEntity> t = query.from(TrackingEntity.class);
        Root<PackageEntity> p = query.from(PackageEntity.class);
        Root<ShipmentEntity> s = query.from(ShipmentEntity.class);
        Map<String, String> filters = new HashMap<>(requestFilters);

        if (filters.containsKey(SHIPPING_TO) && !filters.get(SHIPPING_TO).isBlank()) {
            filters.put(SHIPPING_TO, "");
        }

        List<Predicate> predicates = buildPredicates(filters, cb, s, t,
                monarchId, dynamicFilterRequest, p, query);
        predicates.add(cb.isNotNull(s.get(SHIPPING_TO)));

        String shipToSearch = dynamicFilterRequest.getShipToSearchQuery() != null
                ? dynamicFilterRequest.getShipToSearchQuery().trim()
                : null;

        if (shipToSearch != null && !shipToSearch.isEmpty()) {
            predicates.add(
                    cb.like(cb.lower(s.get(SHIPPING_TO)),
                            "%" + shipToSearch.toLowerCase() + "%")
            );
        }

        // Navigator subquery: check if any tracking row for this shipment has applicationSource = NAVIGATOR
        Subquery<Integer> navSq = query.subquery(Integer.class);
        Root<PackageEntity> p2 = navSq.from(PackageEntity.class);
        Root<TrackingEntity> t2 = navSq.from(TrackingEntity.class);
        Root<ShipmentEntity> s2 = navSq.from(ShipmentEntity.class);
        navSq.select(cb.literal(1))
                .distinct(true)
                .where(
                        cb.equal(p2.get(TrackingFilterConstants.SHIPMENT_ID), s2.get(ID)),
                        cb.equal(t2.get(TrackingFilterConstants.PACKAGE_ID), p2.get(ID)),
                        cb.equal(t2.get(APPLICATION_SOURCE), NAVIGATOR),
                        cb.equal(s2.get(SHIPPING_TO), s.get(SHIPPING_TO))
                );

        Expression<Object> hasNavigator =
                cb.selectCase().when(cb.exists(navSq), cb.literal(true)).otherwise(cb.literal(false));

        Expression<Long> countShippingTo = cb.count(s.get(ID));

        query.select(cb.construct(
                        FilterAddressDTO.class,
                        s.get(SHIPPING_TO),
                        countShippingTo,
                        hasNavigator
                ))
                .where(predicates.toArray(new Predicate[0]))
                .groupBy(s.get(SHIPPING_TO))
                .orderBy(cb.desc(countShippingTo));

        return entityManager.createQuery(query)
                .setMaxResults(TrackingFilterConstants.MAX_LIMIT)
                .getResultList();
    }

    private List<FilterAddressDTO> fetchShippingFrom(EntityManager entityManager,
                                                     Map<String, String> requestFilters,
                                                     UUID monarchId, DynamicFilterRequest dynamicFilterRequest) {
