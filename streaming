                    ? objectMapper.writeValueAsString(supportUpdateHistory)
                    : null;
        } catch (Exception e) {
            throw new ValidationException("Failed to serialize SupportUpdateHistoryDTO list", e);
        }
    }


    public String formatHealthcareIdentifier(SurroundInsightsDTO surroundInsightsDto) {
        if (surroundInsightsDto == null) {
            return null;
        }

        List<String> healthcareIdentifier =
                Optional.ofNullable(surroundInsightsDto.getHealthcareIdentifier())
                        .orElse(Collections.emptyList());

        String formattedIdentifiers = healthcareIdentifier.stream()
                .filter(Objects::nonNull)
                .map(String::trim)
                .filter(value -> !value.isEmpty())
                .map(this::stripWrappingBrackets)
                .filter(Objects::nonNull)
                .flatMap(
                        value ->
                                value.contains(COMMA)
                                        ? Arrays.stream(value.split("\\s*,\\s*"))
                                        : Stream.of(value))
                .map(String::trim)
                .filter(value -> !value.isEmpty())
                .collect(Collectors.joining(COMMA_WITH_SPACE));

        if (!formattedIdentifiers.isEmpty()) {
            return formattedIdentifiers;
        }

        String fallbackSurroundHcid = stripWrappingBrackets(surroundInsightsDto.getSurroundHcid());
        return fallbackSurroundHcid == null || fallbackSurroundHcid.isBlank()
                ? null
                : fallbackSurroundHcid;
    }


    private String stripWrappingBrackets(String value) {
        if (value == null) {
            return null;
        }

        String normalized = value.trim();
        if (normalized.startsWith(OPEN_SQUARE_BRACKET)) {
            normalized = normalized.substring(1).trim();
        }
        if (normalized.endsWith(CLOSE_SQUARE_BRACKET)) {
            normalized = normalized.substring(0, normalized.length() - 1).trim();
        }
        return normalized;
    }

