package com.cardinalhealth.advship.tracking.resource.purge.gcs;

import com.google.cloud.storage.BlobId;
import com.google.cloud.storage.BlobInfo;
import com.google.cloud.storage.Storage;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import java.nio.charset.StandardCharsets;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.FORWARD_SLASH;

/**
 * Uses the existing BucketStorage bean (from GcsBucketConfiguration)
 * to create / reuse buckets and upload purge SQL files.
 */
@Component

@Slf4j
public class PurgeStorageClient {

    private final Storage bucketStorage;


    @Value("${purge.gcs.bucket-name}")
    private String purgeBucketName;

    public PurgeStorageClient(@Qualifier("BucketStorage") Storage bucketStorage) {
        this.bucketStorage = bucketStorage;
    }

    public String upload(String customerKey, String tableName, String fileName, String content) {
        String timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd:HH:mm"));
        String bucketName = purgeBucketName;

        String objectName = String.format("requests/%s/%s/%s/%s",
                customerKey.toLowerCase(),
                tableName,
                timestamp,
                fileName);
        BlobId blobId = BlobId.of(bucketName, objectName);
        BlobInfo blobInfo = BlobInfo.newBuilder(blobId)
                .setContentType("text/plain")
                .build();
        bucketStorage.create(blobInfo, content.getBytes(StandardCharsets.UTF_8));

        String gsPath = "gs://" + bucketName + FORWARD_SLASH + objectName;
        log.atInfo().setMessage(String.format("Uploaded purge script to %s", gsPath)).log();

        return gsPath;
    }
}

