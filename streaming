package com.cardinalhealth.advship.tracking.resource.database;

import jakarta.persistence.criteria.Predicate;
import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Component;
import org.springframework.util.CollectionUtils;

@Component
public class SpecificationBuilder {

  public <T> Specification<T> build(T filter) {
    return build(List.of(), filter);
  }

  /**
   * Builds an AND specification for every non-null field in the given filter object. The specification maps to the
   * following SQL:
   *  - WHERE field1 = 'value1' AND field2 = 'value2' AND field3 = 'value3' ...
   *
   *  The optional nullableFieldNames param allows for fields to be either a value OR null. That SQL would look like:
   *  - WHERE (field1 = 'value1' OR field1 is NULL) AND (field2 = 'value2' OR field2 is NULL) ...
   *
   * @param nullableFieldNames
   * @param filter
   * @return
   * @param <T>
   */
  public <T> Specification<T> build(List<String> nullableFieldNames, T filter) {
    return (root, query, cb) -> {
      var predicates = new ArrayList<>();

      for (var field : filter.getClass().getDeclaredFields()) {
        field.setAccessible(true);
        Object value = null;
        try {
          value = field.get(filter);
          if (value != null) {
            if (!CollectionUtils.isEmpty(nullableFieldNames)
                && (nullableFieldNames.contains(field.getName())
                    || (nullableFieldNames.contains(
                        field.getName().replaceAll("([a-z])([A-Z])", "$1-$2").toLowerCase())))) {
              predicates.add(
                  cb.or(
                      cb.equal(root.get(field.getName()), value),
                      cb.isNull(root.get(field.getName()))));
            } else {
              predicates.add(cb.equal(root.get(field.getName()), value));
            }
          }
        } catch (IllegalAccessException e) {
          throw new RuntimeException("Building filter criteria via reflection failed", e);
        }
      }
      return cb.and(predicates.toArray(new Predicate[0]));
    };
  }

  public <T> Specification<T> build(List<T> filters) {
    return build(List.of(), filters);
  }

  /**
   * Builds an OR specification for every item in the filters list. Each item inside the list has an AND specification
   * for each of their non-null fields. So the SQL would be like:
   * - WHERE (item1.field1 = 'value1' AND item1.field2 = 'value2')
   *      OR (item2.field1 = 'value1' AND item2.field2 = 'value2')
   *
   * The optional nullableFieldNames param allows for fields to be either a value OR null. That SQL would look like:
   * - WHERE ((item1.field1 = 'value1' OR item1.field1 is NULL) AND (item1.field2 = 'value2' OR item1.field2 is NULL))
   *      OR ((item2.field1 = 'value1' OR item2.field1 is NULL) AND (item2.field2 = 'value2' OR item2.field2 is NULL))
   *
   * @param nullableFieldNames
   * @param filters
   * @return
   * @param <T>
   */
  public <T> Specification<T> build(List<String> nullableFieldNames, List<T> filters) {
    return (root, query, cb) -> {
      var predicates = filters.stream()
          .map(filter -> build(nullableFieldNames, filter).toPredicate(root, query, cb))
          .toArray(Predicate[]::new);
      return cb.or(predicates);
    };
  }
}

