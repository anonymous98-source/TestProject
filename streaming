    public List<String> getUserSpecificExpectedTimeFormat(List<LocalDateTime> listOfUtcDateTime, String timezone) {
        if (listOfUtcDateTime == null || listOfUtcDateTime.isEmpty()) {
            return null;
        }
        List<String> formattedDate = new ArrayList<>();

        listOfUtcDateTime.forEach(utcDateTime -> {
            if (utcDateTime != null) {
                String formattedDateTime = expectedDateFormat(utcDateTime);
                formattedDate.add(formattedDateTime);

            } else {
                formattedDate.add(""); // dateTime, , datetime
            }
        });
        return formattedDate;
    }

    public String expectedDateFormat(LocalDateTime utcDateTime) {
        if(utcDateTime!=null){
            try {
                DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MM/dd/yyyy hh:mm a", Locale.ENGLISH);
                return utcDateTime.format(formatter);
            } catch (Exception e) {
                log.atError()
                        .setMessage("Error formatting date time")
                        .addKeyValue("utcDateTime", utcDateTime)
                        .setCause(e)
                        .log();

                return utcDateTime.toString();
            }
        }
        return null;
    }


    public LocalDateTime parseSupportUpdateDateTime(JsonNode supportUpdate) {
        if (supportUpdate.has(ServiceCommonConstants.SUPPORT_UPDATE_DATE_TIME) && !supportUpdate.get(ServiceCommonConstants.SUPPORT_UPDATE_DATE_TIME).isNull()) {
            try {
                String dateTimeString = supportUpdate.get(ServiceCommonConstants.SUPPORT_UPDATE_DATE_TIME).asText();
                // Convert to UTC ZonedDateTime first, then to LocalDateTime
                return OffsetDateTime.parse(dateTimeString)
                        .atZoneSameInstant(ZoneId.of("UTC"))
                        .toLocalDateTime(); // it's concerted to UTC local date time
            } catch (Exception e) {
                log.atError()
                        .setMessage("Error parsing supportUpdateDateTime")
                        .setCause(e)
                        .log();
            }
        }
        return null;
    }

