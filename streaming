package com.cardinalhealth.advship.tracking.resource.service.impl.sftpaccountdetails;

import com.cardinalhealth.advship.tracking.resource.model.dto.sftp.SftpAccountDetailsDTO;
import java.util.ArrayList;
import java.util.List;
import java.util.UUID;
import lombok.RequiredArgsConstructor;
import org.jetbrains.annotations.NotNull;
import org.jetbrains.annotations.Nullable;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

/**
 * Component for managing SFTP account details. Provides synchronized methods for saving,
 * retrieving, and deleting SFTP account details.
 */
@Component
@RequiredArgsConstructor
public class SftpAccountDetailsCRUD {
  private final SftpAccountDetailsReader
      sftpAccountDetailsReader; // Reader for SFTP account details
  private final SftpAccountDetailsWriter
      sftpAccountDetailsWriter; // Writer for SFTP account details
  private final AdvisoryLocker advisoryLocker; // Locker for ensuring synchronized access

  /**
   * Saves the provided SFTP account details in a synchronized manner.
   *
   * @param sftpAccountDetailsDTO the SFTP account details to save
   * @return a Mono containing the response entity
   */
  public SftpAccountDetailsDTO saveSftpAccountDetailsSynchronized(
      SftpAccountDetailsDTO sftpAccountDetailsDTO) {
    boolean locked = advisoryLocker.tryLock();
    try {
      if (!locked) {
        throw new IllegalStateException("Failed to acquire lock");
      }
      saveSftpAccountDetails(sftpAccountDetailsDTO);
      return sftpAccountDetailsDTO;
    } finally {
      advisoryLocker.unlock();
    }
  }

  /**
   * Retrieves the SFTP account details for the specified customer ID.
   *
   * @param customerId the customer ID to retrieve the SFTP account details for
   * @return a Mono containing the SFTP account details
   */
  @NotNull
  public Mono<SftpAccountDetailsDTO> getSftpAccountDetails(UUID customerId) {
    return sftpAccountDetailsReader
        .getExistingSftpAccountDetails()
        .mapNotNull(dtos -> findExistSftpAccountDetailsInList(customerId, dtos));
  }

  /**
   * Deletes the SFTP account details for the specified customer ID in a synchronized manner.
   *
   * @param customerId the customer ID whose SFTP account details should be deleted
   * @return a Mono containing the response entity
   */
  public void deleteSftpAccountSynchronized(UUID customerId) {
    boolean locked = advisoryLocker.tryLock();
    try {
      if (!locked) {
        throw new IllegalStateException("Failed to acquire lock");
      }
      deleteSftpAccount(customerId);
    } finally {
      advisoryLocker.unlock();
    }
  }

  /**
   * Deletes the SFTP account details for the specified customer ID.
   *
   * @param customerId the customer ID whose SFTP account details should be deleted
   */
  private void deleteSftpAccount(UUID customerId) {
    var dtos = sftpAccountDetailsReader.getExistingSftpAccountDetails().block();
    if (dtos == null) {
      dtos = new ArrayList<>();
    }
    var filtered = dtos.stream().filter(dto -> !dto.getCustomerId().equals(customerId)).toList();
    if (filtered.size() < dtos.size()) {
      // Only save if something was actually removed
      sftpAccountDetailsWriter.saveSftpAccountDetails(filtered).block();
    }
  }

  /**
   * Finds the existing SFTP account details for the specified customer ID in the provided list.
   *
   * @param customerId the customer ID to find the SFTP account details for
   * @param dtos the list of SFTP account details
   * @return the SFTP account details for the customer ID, or null if not found
   */
  @Nullable
  private static SftpAccountDetailsDTO findExistSftpAccountDetailsInList(
      UUID customerId, List<SftpAccountDetailsDTO> dtos) {
    return dtos.stream()
        .filter(dto -> dto.getCustomerId().equals(customerId))
        .findFirst()
        .orElse(null);
  }

  /**
   * Saves the provided SFTP account details.
   *
   * @param sftpAccountDetailsDTO the SFTP account details to save
   */
  private void saveSftpAccountDetails(SftpAccountDetailsDTO sftpAccountDetailsDTO) {
    var dtos = sftpAccountDetailsReader.getExistingSftpAccountDetails().block();
    if (dtos == null) {
      dtos = new ArrayList<>();
    }
    var existingDto =
        findExistSftpAccountDetailsInList(sftpAccountDetailsDTO.getCustomerId(), dtos);
    if (existingDto == null || !existingDto.equals(sftpAccountDetailsDTO)) {
      // If no existing DTO or different, update the list
      updateExistingDtosAndSave(sftpAccountDetailsDTO, dtos);
    }
  }

  /**
   * Updates the existing list of SFTP account details and saves the new details.
   *
   * @param sftpAccountDetailsDTO the new SFTP account details to add
   * @param dtos the existing list of SFTP account details
   */
  private void updateExistingDtosAndSave(
      SftpAccountDetailsDTO sftpAccountDetailsDTO, List<SftpAccountDetailsDTO> dtos) {
    var filtered =
        dtos.stream()
