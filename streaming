  public Optional<OflUser> getUser(String userName) {
    return Optional.ofNullable(
        webClient
            .get()
            .uri(userEdgeGetUsersUri(userName))
            .accept(MediaType.APPLICATION_JSON)
            .retrieve()
            .bodyToMono(OflUser.class)
            .onErrorResume(
                WebClientResponseException.class,
                e -> e.getRawStatusCode() == 404 ? Mono.empty() : Mono.error(e))
            .block());
  }

  private URI userEdgeGetUsersUri(String userName) {
    log.atDebug()
            .setMessage("userEdgeGetUsersUri from properties : "+ properties.getUserEdgeBaseUrl())
            .log();
    return new DefaultUriBuilderFactory()
        .uriString(properties.getUserEdgeBaseUrl())
        .pathSegment(V1, USERS)
        .queryParam(USER_QUERY_PARAM, userName)
        .queryParam(FACILITY_FLAG_QUERY_PARAM, true)
        .build();
