@Slf4j
@Service
@RequiredArgsConstructor
public class UserViewXrefService {

  private final UserViewXrefRepository userViewXrefRepository;
  private final UserViewXrefMapper userViewXrefMapper;

  public UserViewXrefDto get(UUID viewId, UUID userId) {
    var xref = userViewXrefRepository.findByUserIdAndViewId(userId, viewId);
    return xref.map(UserViewXrefDto::fromEntity).orElse(null);
  }

  public UserViewXrefDto upsertUserViewXref(UserViewXrefDto dto) {
    var existingOptional =
        userViewXrefRepository.findByUserIdAndViewId(dto.getUserId(), dto.getViewId());

    if (existingOptional.isEmpty()) {
      var saved = userViewXrefRepository.save(dto.toEntity());
      return UserViewXrefDto.fromEntity(saved);
    }

    var existing = existingOptional.get();
    userViewXrefMapper.overwriteEntity(dto, existing);
    var saved = userViewXrefRepository.save(existing);
    return UserViewXrefDto.fromEntity(saved);
  }
}

