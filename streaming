        .thenReturn("IN");

    LocationContactAndAddressDTO originContact =
        mock(LocationContactAndAddressDTO.class);

    LocationDetailDTO originDetail =
        mock(LocationDetailDTO.class);

    LocationDTO originLocation =
        mock(LocationDTO.class);

    when(originContact.getAddress())
        .thenReturn(originAddress);

    when(originDetail.getLocationContactAndAddress())
        .thenReturn(originContact);

    when(originLocation.getLocationDetail())
        .thenReturn(originDetail);

    when(trackResult.getOriginLocation())
        .thenReturn(originLocation);

    // Destination
    AddressDTO destinationAddress =
        mock(AddressDTO.class);

    when(destinationAddress.getCity())
        .thenReturn("Mumbai");

    when(destinationAddress.getPostalCode())
        .thenReturn("400001");

    when(destinationAddress.getStateOrProvinceCode())
        .thenReturn("MH");

    when(destinationAddress.getCountryCode())
        .thenReturn("IN");

    LocationContactAndAddressDTO destinationContact =
        mock(LocationContactAndAddressDTO.class);

    LocationDetailDTO destinationDetail =
        mock(LocationDetailDTO.class);

    LocationDTO destinationLocation =
        mock(LocationDTO.class);

    when(destinationContact.getAddress())
        .thenReturn(destinationAddress);

    when(destinationDetail.getLocationContactAndAddress())
        .thenReturn(destinationContact);

    when(destinationLocation.getLocationDetail())
        .thenReturn(destinationDetail);

    when(trackResult.getDestinationLocation())
        .thenReturn(destinationLocation);

    // Expected delivery date
    EstimatedDeliveryDateDTO estimatedDeliveryDate =
        mock(EstimatedDeliveryDateDTO.class, RETURNS_DEEP_STUBS);

    when(estimatedDeliveryDate.getNewDate().getBegins())
        .thenReturn("2026-09-10");

    when(estimatedDeliveryDate.getNewDate().getEnds())
        .thenReturn("2026-09-12");

    when(estimatedDeliveryDate.getRiskScore())
        .thenReturn("LOW");

    when(estimatedDeliveryDate.getConfidenceScore())
        .thenReturn("HIGH");

    when(estimatedDeliveryDate.getArrivalStatusCode())
        .thenReturn("ON_TIME");

    when(trackResult.getEstimatedDeliveryDate())
        .thenReturn(estimatedDeliveryDate);

    // Scan event
    ScanEventDTO scanEvent =
        mock(ScanEventDTO.class);

    when(scanEvent.getEventDescription())
        .thenReturn("Delivered");

    when(scanEvent.getEventCreateTime())
        .thenReturn("2026-09-10T10:00:00Z");

    when(scanEvent.getDelayDescription())
        .thenReturn("No Delay");

    when(scanEvent.getEventAdditionalInfo())
        .thenReturn(
            Collections.singletonMap(
                Constants.RECIPIENT_SIGNEE,
                "John Doe"));

    LocationDetailDTO scanLocation =
        mock(LocationDetailDTO.class);

    LocationContactAndAddressDTO scanContact =
        mock(LocationContactAndAddressDTO.class);

    AddressDTO scanAddress =
        mock(AddressDTO.class);

