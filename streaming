package com.cardinalhealth.advship.tracking.resource.purge.service;

import com.cardinalhealth.advship.tracking.resource.database.entity.PurgeRequestAudit;
import com.cardinalhealth.advship.tracking.resource.database.repository.PurgeRequestAuditRepository;
import com.cardinalhealth.advship.tracking.resource.purge.dto.PurgeGenerateRequest;
import com.cardinalhealth.advship.tracking.resource.purge.gcs.PurgeStorageClient;
import com.cardinalhealth.advship.tracking.resource.purge.sql.SqlBundleBuilder;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.PlatformTransactionManager;

import java.time.OffsetDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.CUSTOMER_ID;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.DATA_PURGE_BACKOFF_MILLIS;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.DATA_PURGE_MAX_BACKOFF_MILLIS;
import static com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants.DATA_PURGE_MAX_RETRY;
import static com.cardinalhealth.advship.tracking.resource.constants.TrackingSearchConstants.FETCH_ON_CUST_ID;

@Slf4j
@Service
@RequiredArgsConstructor
public class PurgeScriptService {

    private static final String STATUS_RECEIVED = "RECEIVED";
    private static final String STATUS_IN_PROGRESS = "IN_PROGRESS";
    private static final String STATUS_UPLOADING = "UPLOADING";
    private static final String STATUS_COMPLETE = "COMPLETE";
    private static final String STATUS_FAILED = "FAILED";
    private static final String STATUS_NO_DATA = "NO_DATA";

    private final NamedParameterJdbcTemplate jdbcTemplate;
    private final SqlBundleBuilder sqlBundleBuilder;
    private final PurgeStorageClient purgeStorageClient;
    private final PurgeRequestAuditRepository auditRepository;
    private final PlatformTransactionManager txManager;
    

    public PurgeRequestAudit generateScripts(PurgeGenerateRequest request) {
        // Create initial audit row
        PurgeRequestAudit audit = createAudit(request, request.getComments());

        try {
            updateAudit(audit, STATUS_IN_PROGRESS, null);

            // 1) Fetch data
            Map<String, List<Map<String, Object>>> tableRows = new HashMap<>();
            tableRows.put("shipment", fetchShipmentRows(request));
            tableRows.put("tracking", fetchTrackingRows(request));
            tableRows.put("tracking_pod", fetchTrackingPodRows(request));
            tableRows.put("external_reference", fetchExternalReferenceRows(request));

            // When there is no data to redact, complete early and set a null GCS URL
            boolean noData = tableRows.values().stream().allMatch(List::isEmpty);
            if (noData) {
                updateAudit(audit, STATUS_NO_DATA, "No matching rows; nothing to redact.");
                log.warn("No matching rows found; nothing to redact.");
                return audit;
            }

            // 2) Build SQL bundles
            Map<String, String> originalScripts = sqlBundleBuilder.buildOriginalScripts(tableRows);
            Map<String, String> redactedScripts = sqlBundleBuilder.buildRedactedScripts(tableRows);

            // 3) Upload originals + redacted with retry
            updateAudit(audit, STATUS_UPLOADING, null);

            String customerKey = deriveCustomerKey(request.getCustomerId(), tableRows.get("shipmentEntity"));
            StringBuilder gcsBaseBucketPathBuilder = new StringBuilder();

            for (var originalEntry : originalScripts.entrySet()) {
                String table = originalEntry.getKey();
                String path = uploadWithRetry(customerKey, table, table + "_original.sql", originalEntry.getValue());
                if (!gcsBaseBucketPathBuilder.isEmpty()) {
                    gcsBaseBucketPathBuilder.append(", ");
                }
                gcsBaseBucketPathBuilder.append(path);
            }
            for (var redactedEntry : redactedScripts.entrySet()) {
                String table = redactedEntry.getKey();
                String path = uploadWithRetry(customerKey, table, table + "_redacted.sql", redactedEntry.getValue());
                if (!gcsBaseBucketPathBuilder.isEmpty()) {
                    gcsBaseBucketPathBuilder.append(", ");
                }
                gcsBaseBucketPathBuilder.append(path);
            }

            // 4) Apply redactions atomically
            // currently not going to automatically run the redaction script.

            // 5) Complete
            String gcsBaseBucketPath = gcsBaseBucketPathBuilder.toString().trim();
            audit.setGcsBucketUrl(gcsBaseBucketPath);
            updateAudit(audit, STATUS_COMPLETE, null);
            return audit;

        } catch (Exception ex) {
            // Any exception → mark FAILED and persist immediately
            String msg = safeMessage(ex);
            log.atError().setMessage(String.format("Purge generation failed for customerId=%s, billingGroupId=%s, facilityId=%s, ticket=%s: %s",
                    request.getCustomerId(), request.getBillingGroupId(), request.getFacilityId(),
                    request.getServiceNowTicket(), msg)).log();

            updateAudit(audit, STATUS_FAILED, "Error: " + msg);
            return audit;
        }
    }

    //  Audit helpers
    private PurgeRequestAudit createAudit(PurgeGenerateRequest request, String comments) {
        PurgeRequestAudit audit = new PurgeRequestAudit();
        audit.setCustomerId(request.getCustomerId());
        audit.setBillingGroupId(request.getBillingGroupId());
        audit.setFacilityId(request.getFacilityId());
        audit.setComments(comments);
        audit.setUserEmail(request.getUserEmail());
        audit.setServiceNowTicket(request.getServiceNowTicket());
        audit.setStatus(PurgeScriptService.STATUS_RECEIVED);
        audit.setCreatedAt(OffsetDateTime.now());
        audit.setUpdatedAt(OffsetDateTime.now());
        audit.setCreatedBy(request.getUserEmail());
        audit.setUpdatedBy(request.getUserEmail());
        return auditRepository.saveAndFlush(audit);
    }

    private void updateAudit(PurgeRequestAudit audit, String status, String comments) {
        audit.setStatus(status);
        if (comments != null && !comments.isBlank()) {
            audit.setComments(comments);
        }
        audit.setUpdatedAt(OffsetDateTime.now());
        auditRepository.saveAndFlush(audit);
    }

    //  Upload files to GCS with retry logic
    private String uploadWithRetry(String customerKey, String table, String fileName, String contents) {
        final int maxAttempts = DATA_PURGE_MAX_RETRY;
        long backoffMillis = DATA_PURGE_BACKOFF_MILLIS;
        RuntimeException last = null;

        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
            try {
                String path = purgeStorageClient.upload(customerKey, table, fileName, contents);
                if (attempt > 1) {
                    log.info("Upload succeeded on attempt {}/{} for {}/{}", attempt, maxAttempts, table, fileName);
                }
                return path;
            } catch (RuntimeException ex) {
                last = ex;
                log.warn("Upload attempt {}/{} failed for {}/{}: {}", attempt, maxAttempts, table, fileName, ex.getMessage());
                if (attempt == maxAttempts) break;
                try {
                    Thread.sleep(backoffMillis);
                } catch (InterruptedException ie) {
                    Thread.currentThread().interrupt();
                    throw ex;
                }
                backoffMillis = Math.min(backoffMillis * 2, DATA_PURGE_MAX_BACKOFF_MILLIS);
            }
        }
        assert last != null;
        throw last;
    }

    // Utils and fetchers
    private String deriveCustomerKey(String fallbackCustomerId, List<Map<String, Object>> shipmentRows) {
        String customerName = extractCustomerName(shipmentRows);
        return (customerName != null) ? sanitize(customerName.toLowerCase(Locale.ROOT)) : fallbackCustomerId;
    }

    private String extractCustomerName(List<Map<String, Object>> shipment) {
        if (shipment != null && !shipment.isEmpty()) {
            Object name = shipment.get(0).get("customer_name");
            if (name != null) return name.toString();
        }
        return null;
    }

    private String sanitize(String input) {
        return input == null ? null : input.replaceAll("[^a-zA-Z0-9]", "");
    }

    private boolean isNullOrEmpty(String s) {
        return s == null || s.trim().isEmpty();
    }

    private static String safeMessage(Throwable t) {
        String m = (t.getMessage() != null) ? t.getMessage() : t.getClass().getSimpleName();
        m = m.replaceAll("\\s+", " ");
        return m.length() > 1024 ? m.substring(0, 1024) : m; // avoid blowing up DB column
    }

    private List<Map<String, Object>> fetchShipmentRows(PurgeGenerateRequest r) {
        StringBuilder sql = new StringBuilder(
                "SELECT id," +
                        "s.ship_to_company," +
                        "s.ship_to_address_line_1," +
                        "s.ship_to_address_line_2," +
                        "s.ship_to_address_line_3," +
                        "s.ship_to_zip," +
                        "s.ship_to_city," +
                        "s.ship_to_state," +
                        "s.ship_to_country," +
                        "s.shipment_recipient_name," +
                        "s.rma_number," +
                        "s.ship_to_email," +
                        "s.delivery_notes," +
                        "s.gps_delivery_location," +
                        "s.ship_to_phone_number," +
                        "s.shipping_to," +
                        "s.ship_to_address_type," +
                        "s.customer_name " +
                        "FROM advship_tracking_resource.shipment s " +
                        FETCH_ON_CUST_ID
        );
        MapSqlParameterSource params = new MapSqlParameterSource().addValue(CUSTOMER_ID, r.getCustomerId());
        appendOptionalFilters(r, sql, params);
        return jdbcTemplate.queryForList(sql.toString(), params);
    }

    private List<Map<String, Object>> fetchTrackingRows(PurgeGenerateRequest r) {
        StringBuilder sql = new StringBuilder(
                "SELECT t.id," +
                        "t.signatory_name," +
                        "t.user_first_name," +
                        "t.user_last_name," +
                        "t.user_email " +
                        "FROM advship_tracking_resource.tracking t " +
                        "JOIN advship_tracking_resource.package p ON t.package_id = p.id " +
                        "JOIN advship_tracking_resource.shipment s ON p.shipment_id = s.id " +
                        FETCH_ON_CUST_ID
        );
        MapSqlParameterSource params = new MapSqlParameterSource().addValue(CUSTOMER_ID, r.getCustomerId());
        appendOptionalFilters(r, sql, params);
        return jdbcTemplate.queryForList(sql.toString(), params);
    }

    private List<Map<String, Object>> fetchTrackingPodRows(PurgeGenerateRequest r) {
        StringBuilder sql = new StringBuilder(
                "SELECT tp.id," +
                        "tp.pod_content " +
                        "FROM advship_tracking_resource.tracking_pod tp " +
                        "JOIN advship_tracking_resource.tracking t  ON tp.tracking_id = t.id " +
                        "JOIN advship_tracking_resource.package p ON t.package_id = p.id " +
