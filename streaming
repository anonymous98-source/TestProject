  /**
   * Filters TrackingDataStreamProjection based on billing group criteria
   *
   * @param dataStreamRequest the DataStreamRequest containing billing groups
   * @param trackingData the TrackingDataStreamProjection to be filtered
   * @return the filtered TrackingDataStreamProjection or null if no match found
   */
  private TrackingDataStreamProjection getTrackingDataStreamProjection(
          DataStreamRequest dataStreamRequest, TrackingDataStreamProjection trackingData) {
    if (trackingData == null) {
      log.atWarn()
              .setMessage("No tracking data found")
              .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
              .log();
      return null;
    }

    // Navigator logic
    if (ServiceCommonConstants.NAVIGATOR_KEY.equalsIgnoreCase(trackingData.getShipmentSource())) {
      String shipmentBillingGroupId = trackingData.getBillingGroupId();
      if (shipmentBillingGroupId != null
              && dataStreamRequest.getBillingGroups().contains(shipmentBillingGroupId)) {
        log.atInfo()
                .setMessage("Navigator billing group match found")
                .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
                .log();
        return trackingData;
      }
    }

    // Non-Navigator logic
    if (ServiceCommonConstants.NON_NAVIGATOR_KEY.equalsIgnoreCase(
            trackingData.getShipmentSource())) {
      if (Boolean.TRUE.equals(trackingData.getIsCustomerConflict())) {
        log.atWarn()
                .setMessage(
                        "Customer conflict detected for Non-Navigator shipmentEntity, no data will be returned")
                .addKeyValue("trackingNumber", trackingData.getTrackingNumber())
                .addKeyValue("shipmentEntityId", trackingData.getShipmentId())
                .log();
        return null;
      }

      boolean billingGroupMatch =
          Optional.ofNullable(
                  shipmentLinkedEntitiesRepository.findBillingGroupEntitiesByShipmentId(
                      trackingData.getShipmentId()))
              .orElse(Collections.emptyList())
              .stream()
              .map(ShipmentLinkedEntity::getEntityId)
              .anyMatch(dataStreamRequest.getBillingGroups()::contains);

      if (billingGroupMatch) {
        log.atInfo()
                .setMessage("Non-Navigator billing group match found")
                .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
                .log();
        return trackingData;
      }
    }

    log.atWarn()
            .setMessage("No tracking data found for the given shipmentEntity source and billing groups")
            .addKeyValue("trackingNumber", dataStreamRequest.getTrackingNumber())
            .addKeyValue("shipmentEntitySource", dataStreamRequest.getNavigationLevel())
            .addKeyValue(
                    "billingGroups",
                    Optional.ofNullable(dataStreamRequest.getBillingGroups())
                            .map(
                                    billingGroups ->
                                            String.join(ServiceCommonConstants.COMMA_DELIMITER, billingGroups))
                            .orElse(null))
            .log();
    return null;
  }

