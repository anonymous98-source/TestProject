import java.util.UUID;
import lombok.RequiredArgsConstructor;
import lombok.SneakyThrows;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

import javax.xml.stream.XMLInputFactory;
import javax.xml.stream.XMLStreamReader;

@Component
@RequiredArgsConstructor
class SftpAccountDetailsReader {
  private final GoAnywhereWebClient goAnywhereWebClient;
  private final JAXBContext jaxbContext;

  public Mono<List<SftpAccountDetailsDTO>> getExistingSftpAccountDetails() {
    return goAnywhereWebClient
        .getConfigurations()
        .map(this::parseProjectXml)
        .map(this::mapProjectToSftpAccountDetailsDTOs);
  }

  private List<SftpAccountDetailsDTO> mapProjectToSftpAccountDetailsDTOs(GoAProject goAProject) {
    return goAProject.getGoAModule().getGoACallProjects().stream()
        .map(
            callProject -> {
              var dtoBuilder = SftpAccountDetailsDTO.builder();
              for (GoAVariable goAVariable : callProject.getGoAVariables()) {
                switch (goAVariable.getName()) {
                  case "customerId":
                    dtoBuilder.customerId(UUID.fromString(goAVariable.getValue()));
                    break;
                  case "sftpHost":
                    dtoBuilder.sftpHost(goAVariable.getValue());
                    break;
                  case "sftpPort":
                    dtoBuilder.sftpPort(goAVariable.getValue());
                    break;
                  case "sftpUserName":
                    dtoBuilder.sftpUserName(goAVariable.getValue());
                    break;
                  case "sftpUserPassword":
                    dtoBuilder.sftpUserPassword(goAVariable.getValue());
                    break;
                  case "sftpFolder":
                    dtoBuilder.path(goAVariable.getValue());
                    break;
                  case "accountStatus":
                    dtoBuilder.accountStatus(goAVariable.getValue());
                    break;
                  default:
                    // Ignore other variables
                }
              }
              return dtoBuilder.build();
            })
        .toList();
  }

  @SneakyThrows
  private GoAProject parseProjectXml(String xml) {
    Unmarshaller unmarshaller = jaxbContext.createUnmarshaller();
    XMLInputFactory xif = XMLInputFactory.newFactory();
    xif.setProperty(XMLInputFactory.SUPPORT_DTD, false);
    xif.setProperty("javax.xml.stream.isSupportingExternalEntities", false);
    XMLStreamReader xsr = xif.createXMLStreamReader(new StringReader(xml));
    return (GoAProject) unmarshaller.unmarshal(xsr);
  }

}

