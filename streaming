    trackingEntity.setPodUpdatedOnEpic(trackingDto.getPodUpdatedOnEpic());
    trackingEntity.setTrackingLastScanLocation(trackingDto.getTrackingLastScanLocation());
    trackingEntity.setTrackingLastUpdatedAt(trackingDto.getTrackingLastUpdatedAt());
    trackingEntity.setTrackingLastStatus(trackingDto.getTrackingLastStatus());
    trackingEntity.setTrackingLastMessage(trackingDto.getTrackingLastMessage());
    trackingEntity.setTrackingTimezoneOffset(trackingDto.getTrackingTimezoneOffset());
    trackingEntity.setReturnLabelContent(trackingDto.getReturnLabelContent());
    trackingEntity.setReturnLabelType(trackingDto.getReturnLabelType());
    trackingEntity.setTrackingDataSource(trackingDto.getTrackingDataSource());
    trackingEntity.setApplicationSource(trackingDto.getApplicationSource());
    trackingEntity.setPodAvailable(trackingDto.getPodAvailable());
    trackingEntity.setSignatoryName(trackingDto.getSignatoryName());
    trackingEntity.setCarrierCode(trackingDto.getCarrierCode());
    trackingEntity.setCarrierScacCode(trackingDto.getCarrierScacCode());
    trackingEntity.setUserFirstName(trackingDto.getUserFirstName());
    trackingEntity.setUserLastName(trackingDto.getUserLastName());
    trackingEntity.setUserEmail(trackingDto.getUserEmail());
    trackingEntity.setEpicSkipReason(trackingDto.getEpicSkipReason());
    trackingEntity.setPackageId(pkg.getId());

    return trackingRepository.save(trackingEntity);
  }

  private void extractCostCenterDetails(ShipmentDto shipmentDto, ShipmentEntity shipmentEntity) {
    String costCenterName = null;
    String costCenterNumber = null;
    if (!StringUtils.isEmpty(shipmentDto.getShipmentCostCenter())) {
      Matcher matcher = commonService.getMatcher(shipmentDto.getShipmentCostCenter());
      if (matcher.find()) {
        costCenterName = matcher.group(1).trim();
        costCenterNumber = matcher.group(2).trim();
      } else {
        costCenterNumber = shipmentDto.getShipmentCostCenter();
      }
    }
    shipmentEntity.setCostCenterName(costCenterName);
    shipmentEntity.setCostCenterNumber(costCenterNumber);
  }

  private void fetchTrackingEvents(
      TrackingDto trackingDto,
      Map<UUID, TrackingEventEntity> existingEventMap,
      TrackingEntity trackingEntity,
      List<TrackingEventEntity> currentEvents,
      List<TrackingEventEntity> updatedEvents) {
    for (TrackingEventDto eventDto : trackingDto.getTrackingEvents()) {
      TrackingEventEntity event;

      if (eventDto.getId() != null && existingEventMap.containsKey(eventDto.getId())) {
        // Update existing event
        event = existingEventMap.get(eventDto.getId());
      } else {
        // New event
        event = new TrackingEventEntity();
        event.setTrackingId(trackingEntity.getId()); // maintain bidirectional link
        currentEvents.add(event); // add to tracking's list
      }

      // Set/update fields
      event.setTrackingEventType(eventDto.getTrackingEventType());
      event.setTrackingStatus(eventDto.getTrackingStatus());
      event.setTrackingEventStatusUpdatedAt(eventDto.getTrackingEventStatusUpdatedAt());
      event.setTrackingEventMessage(eventDto.getTrackingEventMessage());
      event.setScanLocation(eventDto.getScanLocation());
      event.setTrackingTimezoneOffset(eventDto.getTrackingTimezoneOffset());
      event.setTrackingEventCode(eventDto.getTrackingEventCode());
      event.setEventAdditionalInfo(eventDto.getEventAdditionalInfo());
      event.setTrackingEventReason(eventDto.getTrackingEventReason());

      updatedEvents.add(event);
    }
  }
}

