import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import org.junit.jupiter.api.extension.ExtendWith;

@ExtendWith(MockitoExtension.class)
class FedexSurroundTrackingControllerTest {

    @Mock
    private FedexSurroundLogRepository fedexSurroundLogRepository;

    @Mock
    private FedexNavigatorStatusMapperRepository fedexNavigatorStatusMapperRepository;


    @InjectMocks
    private FedexSurroundTrackingController controller;

    private MockMvc mockMvc;

    private HttpHeaders httpHeaders;

    @BeforeEach
    void setUp() {
        mockMvc = MockMvcBuilders.standaloneSetup(controller).build();
    }

    @Test
    void getRecentCreatedAt_returnsTrue_andComputesUtcCutoffFromThreshold() throws Exception {
        int threshold = 5;
        when(fedexSurroundLogRepository.existsFirstByCreatedAtGreaterThanEqualOrderByCreatedAtDesc(any(Date.class)))
            .thenReturn(true);

        Instant lowerBound = Instant.now().minus(threshold, ChronoUnit.MINUTES).minusSeconds(2);

        mockMvc.perform(post("/v1/api/surround/recent-created-at")
                .header("X-Test", "true")
                .param("threshold", String.valueOf(threshold)))
            .andExpect(status().isOk())
            .andExpect(content().string("true"));

        ArgumentCaptor<Date> cutoffCaptor = ArgumentCaptor.forClass(Date.class);
        verify(fedexSurroundLogRepository, times(1))
            .existsFirstByCreatedAtGreaterThanEqualOrderByCreatedAtDesc(cutoffCaptor.capture());

        Instant upperBound = Instant.now().minus(threshold, ChronoUnit.MINUTES).plusSeconds(2);
        Instant cutoff = cutoffCaptor.getValue().toInstant();
        assertFalse(cutoff.isBefore(lowerBound), "cutoff should not be before the expected UTC lower bound");
        assertFalse(cutoff.isAfter(upperBound), "cutoff should not be after the expected UTC upper bound");
    }

    @Test
    void getRecentCreatedAt_returnsFalse_whenRepositoryHasNoRecentRecord() throws Exception {
        when(fedexSurroundLogRepository.existsFirstByCreatedAtGreaterThanEqualOrderByCreatedAtDesc(any(Date.class)))
            .thenReturn(false);

        mockMvc.perform(post("/v1/api/surround/recent-created-at")
                .header("X-Test", "true")
                .param("threshold", "0"))
            .andExpect(status().isOk())
            .andExpect(content().string("false"));

        verify(fedexSurroundLogRepository, times(1))
            .existsFirstByCreatedAtGreaterThanEqualOrderByCreatedAtDesc(any(Date.class));
    }

    @Test
    void getFedexNavigatorStatus_returnsMappedDtos() {
        // Arrange
        var entity1 = new FedexNavigatorStatusMapEntity(UUID.randomUUID(), "FedexStatus1", "NavigatorStatus1", true);
        var entity2 = new FedexNavigatorStatusMapEntity(UUID.randomUUID(), "FedexStatus2", "NavigatorStatus2", false);
        when(fedexNavigatorStatusMapperRepository.findAll()).thenReturn(List.of(entity1, entity2));

        // Act
        List<FedexNavigatorStatusMapperDto> result = controller.getFedexNavigatorStatus(httpHeaders);

        // Assert
        assertEquals(2, result.size());
        assertEquals("FedexStatus1", result.get(0).getFedexStatus());
        assertEquals("NavigatorStatus1", result.get(0).getNavigatorStatus());
        assertEquals(true, result.get(0).isActive());
        assertEquals("FedexStatus2", result.get(1).getFedexStatus());
        assertEquals("NavigatorStatus2", result.get(1).getNavigatorStatus());
        assertEquals(false, result.get(1).isActive());
    }
}


