public class GlobalExceptionHandler {

  @ExceptionHandler({ResourceNotFoundException.class})
  public ResponseEntity<ErrorResponse> handleResourceNotFoundException(
      ResourceNotFoundException ex, WebRequest request) {
    return new ResponseEntity<>(
        buildErrorResponse(
            request, ex.getMessage(), ErrorConstant.NOT_FOUND, HttpStatus.NOT_FOUND.value()),
        HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler(CsvReportException.class)
  public ResponseEntity<ErrorResponse> unprocessableEntityException(
      CsvReportException ex, WebRequest request) {
    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            ex.getMessage(),
            ErrorConstant.UNPROCESSABLE_ENTITY,
            HttpStatus.UNPROCESSABLE_ENTITY.value()),
        HttpStatus.UNPROCESSABLE_ENTITY);
  }

  @ExceptionHandler({MissingServletRequestParameterException.class})
  public ResponseEntity<ErrorResponse> handleMissingServletRequestParameterNotFoundException(
      MissingServletRequestParameterException ex, WebRequest request) {
    return new ResponseEntity<>(
        buildErrorResponse(
            request, ex.getMessage(), ErrorConstant.NOT_FOUND, HttpStatus.NOT_FOUND.value()),
        HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler(ValidationException.class)
  public ResponseEntity<ErrorResponse> handleValidationException(
      ValidationException ex, WebRequest request) {

    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            ex.getMessage(),
            ErrorConstant.VALIDATION_ERROR,
            HttpStatus.BAD_REQUEST.value()),
        HttpStatus.BAD_REQUEST);
  }

  @ExceptionHandler({NoHandlerFoundException.class, NoResourceFoundException.class})
  public ResponseEntity<ErrorResponse> endPointNotFoundException(Exception ex, WebRequest request) {
    log.error("EndPoint not found: ", ex);
    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            "EndPoint Not Found : " + ex.getMessage(),
            ErrorConstant.NOT_FOUND,
            HttpStatus.NOT_FOUND.value()),
        HttpStatus.NOT_FOUND);
  }

  @ExceptionHandler({HttpRequestMethodNotSupportedException.class})
  public ResponseEntity<ErrorResponse> methodNotSupportedException(
      Exception ex, WebRequest request) {

    log.error("Invalid method: ", ex);

    return new ResponseEntity<>(
        buildErrorResponse(
            request,
            "Method Not Allowed : " + ex.getMessage(),
            ErrorConstant.METHOD_NOT_ALLOWED,
            HttpStatus.METHOD_NOT_ALLOWED.value()),
        HttpStatus.METHOD_NOT_ALLOWED);
  }

  @ExceptionHandler(Exception.class)
