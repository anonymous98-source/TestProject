import jakarta.persistence.criteria.CriteriaQuery;
import jakarta.persistence.criteria.Expression;
import jakarta.persistence.criteria.Order;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;
import jakarta.persistence.criteria.Subquery;
import java.sql.Timestamp;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.Period;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Component;
import org.springframework.util.CollectionUtils;

@Component
@Slf4j
@AllArgsConstructor
public class TrackingSpecification {

  public static final String MAX = "MAX";
  private final PackageRepository packageRepository;
  private final StatusGroupRepository statusGroupRepository;

  public Specification<TrackingEntity> buildSpecification(
      UUID monarchId,
      boolean isShipmentPageWanted,
      boolean myShipment,
      List<String> shippingLocations,
      Map<String, String> filters,
      String sortBy,
      String sortDirection,
      String timezone,
      List<String> shipperAccountNumbers,
      boolean nonNavigator) {
    return (root, query, cb) -> {
      List<Predicate> predicates = new ArrayList<>();

      Root<PackageEntity> packageRoot = query.from(PackageEntity.class);
      Root<ShipmentEntity> shipmentRoot = query.from(ShipmentEntity.class);
      predicates.add(cb.equal(root.get("packageId"), packageRoot.get("id")));
      predicates.add(cb.equal(packageRoot.get("shipmentId"), shipmentRoot.get("id")));

      // User filter
      if (myShipment && monarchId != null) {
        predicates.add(cb.equal(shipmentRoot.get("userId"), monarchId));
      }

      // If shipping locations are provided, create a subquery to filter based on them
      // But it should work only for navigator shipments
      // So added as OR condition for shipper account numbers for non-navigator shipments
      // If shipping locations are not provided, then filter only based on shipper account numbers
      // for non-navigator shipments
      if (shippingLocations != null && !shippingLocations.isEmpty()) {
        Predicate shipFromAndNavigator =
            cb.and(
                shipmentRoot.get("facilityId").in(shippingLocations),
                cb.notEqual(root.get("applicationSource"), "Non-Navigator"));

        if (!CollectionUtils.isEmpty(shipperAccountNumbers) && !myShipment && nonNavigator) {
          Predicate accountAndIsNonNavigator =
              cb.and(
                  shipmentRoot.get("surroundBillToNumber").in(shipperAccountNumbers),
                  cb.equal(root.get("applicationSource"), "Non-Navigator"));
          predicates.add(cb.or(shipFromAndNavigator, accountAndIsNonNavigator));
        } else {
          predicates.add(shipmentRoot.get("facilityId").in(shippingLocations));
        }
      } else if (shipperAccountNumbers != null
          && !shipperAccountNumbers.isEmpty()
          && !myShipment
          && nonNavigator) {
        predicates.add(
            cb.or(
                shipmentRoot.get("surroundBillToNumber").isNull(),
                shipmentRoot.get("surroundBillToNumber").in(shipperAccountNumbers)));
      }

      Predicate trackingUpdatedAtPredicate;
      Predicate shipmentCreatedAtPredicate;

      // Determine date range based on isShipmentPageWanted
      LocalDate effectiveStartDate;
      LocalDate effectiveEndDate;

      if (isShipmentPageWanted) {
        // Last 31 days
        effectiveStartDate = LocalDate.now().minusDays(31);
        effectiveEndDate = LocalDate.now().plusDays(1);
      } else {
        // Default to last 10 years if no date range is provided
        effectiveStartDate = LocalDate.now().minusYears(10);
        effectiveEndDate = LocalDate.now().plusDays(1);
      }
      // If status condition is at risk or delayed, override the effective start date to be last 30
      // days
      if (filters != null && filters.containsKey(STATUS_CONDITION)) {
        LocalDate overrideStartDate =
            Arrays.stream(filters.get(STATUS_CONDITION).split(","))
                .map(String::trim)
                .filter(
                    statusCondition ->
                        statusCondition.equals(ServiceCommonConstants.AT_RISK)
                            || statusCondition.equals(ServiceCommonConstants.DELAYED)
                            || statusCondition.equals(ON_TIME)
                            || statusCondition.equals(EARLY)
                            || statusCondition.equals(AT_RISK_OF_FURTHER_DELAY))
                .findFirst()
                .map(
                    s -> {
                      log.atInfo()
                              .setMessage(
                                  "Status condition is at risk or delayed, overriding effective start date to be last 31 days")
                              .log();
                      return LocalDate.now().minusDays(31);
                    })
                .orElse(null);

        if (overrideStartDate != null) {
          effectiveStartDate = overrideStartDate;
        }
      }

      // Apply date range filter if present in filters map
      if (filters != null
          && filters.containsKey(ServiceCommonConstants.START_DATE)
          && filters.containsKey(ServiceCommonConstants.END_DATE)) {
        LocalDate filterStartDate = LocalDate.parse(filters.get(ServiceCommonConstants.START_DATE));
        LocalDate filterEndDate =
            LocalDate.parse(filters.get(ServiceCommonConstants.END_DATE)).plusDays(1);
        Period period = Period.between(filterStartDate, filterEndDate);
        int years = Math.abs(period.getYears());
        int months = Math.abs(period.getMonths());
        int days = Math.abs(period.getDays());

        LocalDateTime filterStartDateTime = filterStartDate.atStartOfDay();
        LocalDateTime filterEndDateTime =
            filterEndDate.atStartOfDay().minusDays(1).withHour(23).withMinute(59).withSecond(59);
        filterStartDateTime =
            DateTimeUtil.buildLocalDateTimeFromTimeZone(filterStartDateTime, timezone);
        filterEndDateTime =
            DateTimeUtil.buildLocalDateTimeFromTimeZone(filterEndDateTime, timezone);

        if (years > 1 || (years == 1 && (months > 0 || days > 1))) {
          throw new ValidationException("Dates differ by more than one year.");
        }

          boolean isValidStatusCondition = filters.get(STATUS_CONDITION) != null &&
                  (Arrays.stream(filters.get(STATUS_CONDITION).split(","))
                          .map(String::trim)
                          .allMatch(status -> status.equals(ServiceCommonConstants.AT_RISK) ||
                                  status.equals(ServiceCommonConstants.DELAYED) ||
                                  status.equals(ON_TIME) || status.equals(EARLY) ||
                                  status.equals(AT_RISK_OF_FURTHER_DELAY)));

        // Enforce the effective date range
          if ((isShipmentPageWanted) || (filters.containsKey(STATUS_CONDITION) && isValidStatusCondition)) {
          filterStartDateTime =
              filterStartDateTime.isBefore(effectiveStartDate.atStartOfDay())
                  ? effectiveStartDate.atStartOfDay()
                  : filterStartDateTime;
          filterEndDateTime =
              filterEndDateTime.isAfter(effectiveEndDate.atStartOfDay())
                  ? effectiveEndDate.atStartOfDay()
                  : filterEndDateTime;
        }

        shipmentCreatedAtPredicate =
            cb.between(
                root.get(ServiceCommonConstants.TRACKING_CREATED_AT),
                Timestamp.valueOf(filterStartDateTime),
                Timestamp.valueOf(filterEndDateTime));
        trackingUpdatedAtPredicate =
            cb.between(
                root.get(TRACKING_LAST_MODIFIED_AT),
                Timestamp.valueOf(filterStartDateTime),
                Timestamp.valueOf(filterEndDateTime));
      } else {
        // Apply effective date range
        shipmentCreatedAtPredicate =
            cb.between(
                root.get(ServiceCommonConstants.TRACKING_CREATED_AT),
                Timestamp.valueOf(effectiveStartDate.atStartOfDay()),
                Timestamp.valueOf(effectiveEndDate.atStartOfDay()));
        trackingUpdatedAtPredicate =
            cb.between(
                root.get(TRACKING_LAST_MODIFIED_AT),
                Timestamp.valueOf(effectiveStartDate.atStartOfDay()),
                Timestamp.valueOf(effectiveEndDate.atStartOfDay()));
      }

      // Carrier filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.CARRIERS)) {
        String[] carriers = filters.get(ServiceCommonConstants.CARRIERS).split(",");
        predicates.add(
            shipmentRoot
                .get(ServiceCommonConstants.SHIPMENT_CARRIER_DETAILS)
                .in(Arrays.stream(carriers).map(String::trim).toArray()));
      }

      // Service line filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.SERVICE_LINES)) {
        String[] serviceLines = filters.get(ServiceCommonConstants.SERVICE_LINES).split(",");
        predicates.add(
            shipmentRoot
                .get(ServiceCommonConstants.SHIPMENT_SERVICE_LEVEL)
                .in(Arrays.stream(serviceLines).map(String::trim).toArray()));
      }

      // Ship date filter
      if (filters != null
          && filters.containsKey(ServiceCommonConstants.SHIP_DATE_START)
          && filters.containsKey(ServiceCommonConstants.SHIP_DATE_END)) {
        String shipDateStartStr = filters.get(ServiceCommonConstants.SHIP_DATE_START);
        String shipDateEndStr = filters.get(ServiceCommonConstants.SHIP_DATE_END);
        if (!shipDateStartStr.isEmpty() && !shipDateEndStr.isEmpty()) {
          LocalDate shipDateStart = LocalDate.parse(shipDateStartStr);
          LocalDate shipDateEnd = LocalDate.parse(shipDateEndStr);
          predicates.add(
              cb.between(
                  root.get(ServiceCommonConstants.SHIP_DATE),
                  shipDateStart.atStartOfDay(),
                  shipDateEnd
                      .plusDays(1)
                      .atStartOfDay()
                      .minusNanos(
                          1000000) // changing from subtracting 1 nano-second to 1 mili second
                  ));
        }
      }

      // HCID filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.HCID_CODES)) {
        String[] hcidArray = filters.get(ServiceCommonConstants.HCID_CODES).split(",");

        String[] likePatterns =
            Arrays.stream(hcidArray)
                .map(code -> code + ":%") // e.g., "HCT:%"
                .toArray(String[]::new);

        List<UUID> matchingPackageIds = packageRepository.findPackageIdsByHcidCodes(likePatterns);
        if (!matchingPackageIds.isEmpty())
          predicates.add(root.get("packageId").in(matchingPackageIds));
        else predicates.add(cb.disjunction());
      }

      // HCID temperature code children
      if (filters != null && filters.containsKey(ServiceCommonConstants.HCID_CODE_CHILDREN)) {
        String[] hcidCodeChildren =
            filters.get(ServiceCommonConstants.HCID_CODE_CHILDREN).split(",");

        String[] likePatterns =
            Arrays.stream(hcidCodeChildren)
                .map(code -> code + ":%") // e.g., "HCT:%"
                .toArray(String[]::new);

        List<UUID> matchingPackageIds =
            packageRepository.findPackageIdsByHcidTemperatureCodes(likePatterns);
        if (!matchingPackageIds.isEmpty())
          predicates.add(root.get("packageId").in(matchingPackageIds));
        else predicates.add(cb.disjunction());
      }

      // Status filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.STATUSES)) {
        String[] statusesArray = filters.get(ServiceCommonConstants.STATUSES).split(",");
        predicates.add(
            root.get("trackingLastStatus")
                .in(Arrays.stream(statusesArray).map(String::trim).toArray()));
      }

      // Detailed status filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.DETAILED_STATUSES)) {
        String[] detailedStatusesArray =
            filters.get(ServiceCommonConstants.DETAILED_STATUSES).split(",");
        predicates.add(
            root.get("trackingLastMessage")
                .in(Arrays.stream(detailedStatusesArray).map(String::trim).toArray()));
      }

      // shipping to filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.SHIPPING_TO)) {
        String[] shippingTo = filters.get(ServiceCommonConstants.SHIPPING_TO).split(",");
        predicates.add(
            shipmentRoot
                .get(ServiceCommonConstants.SHIPPING_TO)
                .in(Arrays.stream(shippingTo).map(String::trim).toArray()));
      }

      // shipped From filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.SHIPPED_FROM)) {
        String[] shippedFrom = filters.get(ServiceCommonConstants.SHIPPED_FROM).split(",");
        predicates.add(
            shipmentRoot
                .get(ServiceCommonConstants.SHIPPED_FROM)
                .in(Arrays.stream(shippedFrom).map(String::trim).toArray()));
      }

      // Arriving date filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.ARRIVING_DATE)) {
        LocalDateTime arrivingDateStart =
            LocalDate.parse(filters.get(ServiceCommonConstants.ARRIVING_DATE)).atStartOfDay();
        arrivingDateStart =
            DateTimeUtil.buildLocalDateTimeFromTimeZone(arrivingDateStart, timezone);
        LocalDateTime arrivingDateEnd = arrivingDateStart.plusDays(1).minusNanos(1);
        predicates.add(
            cb.between(
                root.get(ServiceCommonConstants.EXPECTED_DELIVERY_DATE),
                Timestamp.valueOf(arrivingDateStart),
                Timestamp.valueOf(arrivingDateEnd)));
      }

      // created filter
      if (filters != null && filters.containsKey(ServiceCommonConstants.CREATED_DATE)) {
        LocalDateTime createdDateStart =
            LocalDate.parse(filters.get(ServiceCommonConstants.CREATED_DATE)).atStartOfDay();
        createdDateStart = DateTimeUtil.buildLocalDateTimeFromTimeZone(createdDateStart, timezone);
        LocalDateTime createdDateEnd = createdDateStart.plusDays(1).minusNanos(1);
        predicates.add(
            cb.between(
                root.get(ServiceCommonConstants.TRACKING_CREATED_AT),
                Timestamp.valueOf(createdDateStart),
                Timestamp.valueOf(createdDateEnd)));
      }

      if (filters != null && filters.containsKey(ServiceCommonConstants.DELIVERED_DATE)) {

        // If delivery_date from tracking table is not null and it matches current date, it is
        // delivered
        LocalDateTime deliveredDateStart =
            LocalDate.parse(filters.get(ServiceCommonConstants.DELIVERED_DATE)).atStartOfDay();
        deliveredDateStart =
            DateTimeUtil.buildLocalDateTimeFromTimeZone(deliveredDateStart, timezone);
        LocalDateTime deliveredDateEnd = deliveredDateStart.plusDays(1).minusNanos(1);

        predicates.add(
            cb.and(
                cb.isNotNull(root.get(ServiceCommonConstants.DELIVERY_DATE)),
                cb.between(
                    root.get(ServiceCommonConstants.DELIVERY_DATE),
                    Timestamp.valueOf(deliveredDateStart),
                    Timestamp.valueOf(deliveredDateEnd))));
      }

      // shipViaCode filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(SHIP_VIA_CODE)) {
        String[] shipViaCodes =
            filters.get(ServiceCommonConstants.SHIP_VIA_CODE).split(ServiceCommonConstants.COMMA);
        predicates.add(
            shipmentRoot
                .get(ServiceCommonConstants.SHIP_VIA_CODE)
                .in(Arrays.stream(shipViaCodes).map(String::trim).toArray()));
      }

      // needsByDate filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(NEEDS_BY_DATE)) {
        String needsByDateStr = filters.get(NEEDS_BY_DATE).trim();
        LocalDate needsByDate = LocalDate.parse(needsByDateStr);
        predicates.add(cb.equal(shipmentRoot.get(NEEDS_BY_DATE), needsByDate));
      }

      // applying caseStatus filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(CASE_STATUS)) {

        String[] caseStatusArray = filters.get(CASE_STATUS).split(",");
        String[] lowerCaseCaseStatuses =
            Arrays.stream(caseStatusArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .toArray(String[]::new);
        Subquery<Long> caseSubquery = query.subquery(Long.class);
        Root<TrackingPviCasesEntity> pviCaseRoot = caseSubquery.from(TrackingPviCasesEntity.class);

        caseSubquery
            .select(cb.literal(1L))
            .where(
                cb.lower(pviCaseRoot.get(CASE_STATUS)).in((Object[]) lowerCaseCaseStatuses),
                cb.equal(pviCaseRoot.get("trackingId"), root.get("id")));
        predicates.add(cb.exists(caseSubquery));
      }
      // applying caseSubCategory filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(CASE_SUB_CATEGORY)) {

        String[] caseSubCategoriesArray = filters.get(CASE_SUB_CATEGORY).split(",");
        String[] lowerCaseSubCategory =
            Arrays.stream(caseSubCategoriesArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .toArray(String[]::new);
        Subquery<Long> caseSubquery = query.subquery(Long.class);
        Root<TrackingPviCasesEntity> pviCaseRoot = caseSubquery.from(TrackingPviCasesEntity.class);

        caseSubquery
            .select(cb.literal(1L))
            .where(
                cb.lower(pviCaseRoot.get(CASE_SUB_CATEGORY)).in((Object[]) lowerCaseSubCategory),
                cb.equal(pviCaseRoot.get("trackingId"), root.get("id")));
        predicates.add(cb.exists(caseSubquery));
      }

      // applying caseType filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(CASE_TYPE)) {

        String[] caseTypeArray = filters.get(CASE_TYPE).split(",");
        String[] lowerCaseType =
            Arrays.stream(caseTypeArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .toArray(String[]::new);
        Subquery<Long> caseSubquery = query.subquery(Long.class);
        Root<TrackingPviCasesEntity> pviCaseRoot = caseSubquery.from(TrackingPviCasesEntity.class);

        caseSubquery
            .select(cb.literal(1L))
            .where(
                cb.lower(pviCaseRoot.get(CASE_TYPE)).in((Object[]) lowerCaseType),
                cb.equal(pviCaseRoot.get("trackingId"), root.get("id")));
        predicates.add(cb.exists(caseSubquery));
      }

      // applying case count filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(CASE_COUNT)) {

        String[] caseCountStringArray = filters.get(CASE_COUNT).split(",");
        Integer[] caseCountIntegerArray =
            Arrays.stream(caseCountStringArray)
                .map(String::trim)
                .map(Integer::parseInt)
                .toArray(Integer[]::new);
        predicates.add(root.get(PVI_CASE_COUNT).in(caseCountIntegerArray));
      }

      // applying intervention requested filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(INTERVENTION_REQUESTED)) {
        String[] interventionRequestedArray = filters.get(INTERVENTION_REQUESTED).split(",");
        String[] lowerCaseInterventionRequestedList =
            Arrays.stream(interventionRequestedArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .toArray(String[]::new);
        predicates.add(
            cb.lower(root.get(INTERVENTION_REQUESTED_COLUMN))
                .in((Object[]) lowerCaseInterventionRequestedList));
      }

      // applying Intervention status filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(INTERVENTION_STATUS)) {
        String[] interventionStatusArray = filters.get(INTERVENTION_STATUS).split(",");
        String[] lowerCaseInterventionStatuses =
            Arrays.stream(interventionStatusArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .toArray(String[]::new);
        predicates.add(
            cb.lower(root.get(INTERVENTION_STATUS_COLUMN))
                .in((Object[]) lowerCaseInterventionStatuses));
      }

      // applying senseawareMobile filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(SENSEAWARE_MOBILE)) {

        String[] senseawareMobiles = filters.get(SENSEAWARE_MOBILE).split(",");
        String[] trimmedSenseawareMobiles =
            Arrays.stream(senseawareMobiles)
                .map(String::trim)
                .map(String::toLowerCase)
                .filter(s -> !s.isEmpty())
                .toArray(String[]::new);
        if (trimmedSenseawareMobiles.length > 0) {
          Subquery<Long> senseawareMobileSubquery = query.subquery(Long.class);
          Root<SurroundInsightsEntity> surroundInsightsRoot =
              senseawareMobileSubquery.from(SurroundInsightsEntity.class);

          senseawareMobileSubquery
              .select(cb.literal(1L))
              .where(
                  cb.lower(surroundInsightsRoot.get(SENSEAWARE_MOBILE_COLUMN))
                      .in((Object[]) trimmedSenseawareMobiles),
                  cb.equal(surroundInsightsRoot.get("trackingId"), root.get("id")));
          predicates.add(cb.exists(senseawareMobileSubquery));
        }
      }

      // applying surround delivery prediction filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(SURROUND_DELIVERY_PREDICTION)) {

        String[] deliveryPredictionsArray = filters.get(SURROUND_DELIVERY_PREDICTION).split(",");
        String[] trimmedDeliveryPredictionArray =
            Arrays.stream(deliveryPredictionsArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .filter(s -> !s.isEmpty())
                .toArray(String[]::new);
        if (trimmedDeliveryPredictionArray.length > 0) {
          Subquery<Long> deliveryPredictionSubquery = query.subquery(Long.class);
          Root<SurroundInsightsEntity> surroundInsightsRoot =
              deliveryPredictionSubquery.from(SurroundInsightsEntity.class);

          deliveryPredictionSubquery
              .select(cb.literal(1L))
              .where(
                  cb.lower(surroundInsightsRoot.get(SURROUND_DELIVERY_PREDICTION_COLUMN))
                      .in((Object[]) trimmedDeliveryPredictionArray),
                  cb.equal(surroundInsightsRoot.get("trackingId"), root.get("id")));
          predicates.add(cb.exists(deliveryPredictionSubquery));
        }
      }

      // applying surroundHcids filter
      if (!CollectionUtils.isEmpty(filters) && filters.containsKey(SURROUND_HCID)) {

        String[] surroubdHcidArray = filters.get(SURROUND_HCID).split(",");
        String[] trimmedSurroundHcidArray =
            Arrays.stream(surroubdHcidArray)
                .map(String::trim)
                .map(String::toLowerCase)
                .filter(s -> !s.isEmpty())
                .toArray(String[]::new);
        if (trimmedSurroundHcidArray.length > 0) {
          Subquery<Long> surroundHcidSubquery = query.subquery(Long.class);
          Root<SurroundInsightsEntity> surroundInsightsRoot =
              surroundHcidSubquery.from(SurroundInsightsEntity.class);

          surroundHcidSubquery
              .select(cb.literal(1L))
              .where(
                  cb.equal(surroundInsightsRoot.get("trackingId"), root.get("id")),
                  cb.or(
                      Arrays.stream(trimmedSurroundHcidArray)
                          .map(
                              val ->
                                  cb.like(
                                      cb.lower(surroundInsightsRoot.get(SURROUND_HCID_COLUMN)),
                                      "%" + val + "%"))
                          .toArray(Predicate[]::new)));
          predicates.add(cb.exists(surroundHcidSubquery));
        }
      }

      // Status condition filter for statuses (at risk, delayed, delivered, in transit)
      if (filters != null && filters.containsKey(STATUS_CONDITION)) {

        String statusCondition = filters.get(STATUS_CONDITION);
        if (statusCondition != null && !statusCondition.isEmpty()) {

          List<Predicate> statusPredicates = new ArrayList<>();
          String[] statusConditions = statusCondition.split(",");
          log.info("status conditions : " + Arrays.toString(statusConditions));
          for (String singleStatus : statusConditions) {

            if (singleStatus == null || singleStatus.trim().isEmpty()) {
              continue; // skip empty status conditions
            }

            switch (singleStatus.trim()) {
              case ServiceCommonConstants.AT_RISK:
                {
                  statusPredicates.add(
                      cb.and(
                          cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 20),
                          cb.lessThan(root.get(RISK_SCORE), 40)));
                  break;
                }
              case ON_TIME:
                {
                  statusPredicates.add(
                      cb.and(
                          cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 0),
                          cb.lessThan(root.get(RISK_SCORE), 20)));
                  break;
                }
              case EARLY:
                statusPredicates.add(
                    cb.and(
                        cb.greaterThanOrEqualTo(root.get(RISK_SCORE), -20),
                        cb.lessThan(root.get(RISK_SCORE), 0)));
                break;
              case ServiceCommonConstants.DELAYED:
                {
                  statusPredicates.add(
                      cb.and(
                          cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 40),
                          cb.lessThan(root.get(RISK_SCORE), 60)));
                  break;
                }
              case AT_RISK_OF_FURTHER_DELAY:
                {
                  statusPredicates.add(cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 60));
                  break;
                }
              case ServiceCommonConstants.DELIVERED_STATUS:
                {
                  // If delivery_date from tracking table is not null, it is delivered
                  statusPredicates.add(
                      cb.isNotNull(root.get(ServiceCommonConstants.DELIVERY_DATE)));
                  break;
                }
              case ServiceCommonConstants.INTRANSIT_STATUS:
                {
                  // If trackingLastStatus from tracking table is equal to inTransit, it is in
                  // transit
                  List<String> inTransitStatuses =
                      statusGroupRepository.findInTransitCarrierStatuses();
                  statusPredicates.add(root.get("trackingLastStatus").in(inTransitStatuses));
                  break;
                }
            }
          }

          if (!statusPredicates.isEmpty()) {
            predicates.add(cb.or(statusPredicates.toArray(new Predicate[0])));
          }
        }
      }

      if ((filters != null) && filters.containsKey(PACKAGE_PROFILE)) {
        String[] profileNames = filters.get(PACKAGE_PROFILE).split(",");
        predicates.add(
            packageRoot
                .get(PACKAGE_PROFILE_NAME)
                .in(Arrays.stream(profileNames).map(String::trim).toArray()));
      }

      if (filters != null && filters.containsKey(SHIPPING_PROFILE)) {
        String[] shippingProfileNames = filters.get(SHIPPING_PROFILE).split(",");
        predicates.add(
            shipmentRoot
                .get(SHIPPING_PROFILE_NAME)
                .in(Arrays.stream(shippingProfileNames).map(String::trim).toArray()));
      }

      if (filters != null && filters.containsKey(SHIPPING_PROFILE_TAGS)) {
        String[] tags =
            Arrays.stream(filters.get(SHIPPING_PROFILE_TAGS).split(","))
                .map(String::trim)
                .filter(s -> !s.isEmpty())
                .toArray(String[]::new);

        Subquery<Long> tagsSubquery = query.subquery(Long.class);
        Root<AdditionalServiceShipmentEntity> addlRoot =
            tagsSubquery.from(AdditionalServiceShipmentEntity.class);
        Expression<String> flat =
            cb.function(
                "array_to_string",
                String.class,
                addlRoot.get(SHIPPING_PROFILE_TAGS),
                cb.literal(","));
        Expression<String> haystack =
            cb.concat(cb.concat(cb.literal(","), cb.coalesce(flat, "")), cb.literal(","));

        Predicate tagPredicate =
            cb.or(
                Arrays.stream(tags)
                    .map(tag -> cb.like(cb.lower(haystack), "%," + tag.toLowerCase() + ",%"))
                    .toArray(Predicate[]::new));

        tagsSubquery
            .select(cb.literal(1L))
            .where(cb.equal(addlRoot.get("shipmentId"), shipmentRoot.get("id")), tagPredicate);
        predicates.add(cb.exists(tagsSubquery));
      }

      // Apply sorting mechanism
      if (sortBy != null && sortDirection != null) {
        
        Expression<?> sortPath = getSortPath(root, shipmentRoot, sortBy, query, cb);
        List<Order> orders = new ArrayList<>();
        boolean isDesc = ServiceCommonConstants.DESCENDING.equalsIgnoreCase(sortDirection);

        if (String.class.equals(sortPath.getJavaType())) {
          Expression<String> normalizedSortPath =
                  cb.lower(cb.trim(cb.coalesce(sortPath.as(String.class), "")));

          orders.add(cb.asc(
                  cb.selectCase()
                          .when(cb.equal(normalizedSortPath, ""), 1)
                          .otherwise(0)
          ));

          orders.add(isDesc ? cb.desc(normalizedSortPath) : cb.asc(normalizedSortPath));
        } else {
          // If the field is not a String — for example a date, number, or enum-like non-string field
          orders.add(cb.asc(
                  cb.selectCase()
                          .when(cb.isNull(sortPath), 1)
                          .otherwise(0)
          ));

          orders.add(isDesc ? cb.desc(sortPath) : cb.asc(sortPath));
        }

        // Stable fallback sort so equal values don't jump around
        orders.add(cb.desc(root.get(ServiceCommonConstants.TRACKING_CREATED_AT)));

        query.orderBy(orders);

      } else {
        query.orderBy(cb.desc(root.get(ServiceCommonConstants.TRACKING_CREATED_AT)));
      }
      predicates.add(cb.or(shipmentCreatedAtPredicate, trackingUpdatedAtPredicate));
      return cb.and(predicates.toArray(new Predicate[0]));
    };
  }

  public Expression<?> getSortPath(
      Root<TrackingEntity> root,
      Root<ShipmentEntity> shipmentRoot,
      String sortBy,
      CriteriaQuery<?> query,
      CriteriaBuilder cb) {
    switch (sortBy) {
      case ServiceCommonConstants.TRACKING_NUMBER:
        return root.get("trackingNumber");

      case ServiceCommonConstants.LAST_SCANNED:
        return root.get("trackingLastUpdatedAt");

      case ServiceCommonConstants.TRACKING_STATUS:
        return root.get("trackingLastStatus");

      case ServiceCommonConstants.DELIVERY_DATE:
        return root.get(ServiceCommonConstants.EXPECTED_DELIVERY_DATE);

      case ServiceCommonConstants.SHIP_DATE:
        return root.get(ServiceCommonConstants.SHIP_DATE);

      case ServiceCommonConstants.EXPECTED_DELIVERY_DATE:
        return root.get(ServiceCommonConstants.EXPECTED_DELIVERY_DATE);

      case INTERVENTION_REQUESTED:
        return root.get(INTERVENTION_REQUESTED_COLUMN);

      case INTERVENTION_STATUS:
        return root.get(INTERVENTION_STATUS_COLUMN);

      case CASE_COUNT:
        return root.get(PVI_CASE_COUNT);

      case CASE_STATUS: {
        return root.get("pviCaseLastStatus");
      }

      case CASE_SUB_CATEGORY: {
        return root.get("pviCaseSubcategory");
      }

      case CASE_TYPE: {
        return root.get("pviCaseType");
      }

      case SURROUND_CONFIDENCE_SCORE:
        return root.get(SURROUND_CONFIDENCE_SCORE);

      case SENSEAWARE_MOBILE:
        {
          Subquery<String> subq = query.subquery(String.class);
          Root<SurroundInsightsEntity> siRoot = subq.from(SurroundInsightsEntity.class);
          subq.select(siRoot.get(SENSEAWARE_MOBILE_COLUMN))
              .where(cb.equal(siRoot.get("trackingId"), root.get("id")));
          return subq;
        }
      case SURROUND_DELIVERY_PREDICTION:
        {
          Subquery<String> subq = query.subquery(String.class);
          Root<SurroundInsightsEntity> siRoot = subq.from(SurroundInsightsEntity.class);
          subq.select(siRoot.get(SURROUND_DELIVERY_PREDICTION_COLUMN))
              .where(cb.equal(siRoot.get("trackingId"), root.get("id")));
          return subq;
        }
      case SURROUND_HCID:
        {
          Subquery<String> subq = query.subquery(String.class);
          Root<SurroundInsightsEntity> siRoot = subq.from(SurroundInsightsEntity.class);
          subq.select(siRoot.get(SURROUND_HCID_COLUMN))
              .where(cb.equal(siRoot.get("trackingId"), root.get("id")));
          return subq;
        }

      case ServiceCommonConstants.SHIPPING_TO_NAME:
        return shipmentRoot.get(ServiceCommonConstants.SHIPMENT_RECIPENT_NAME);
      case ServiceCommonConstants.SHIP_FROM_NAME:
        return shipmentRoot.get(ServiceCommonConstants.SHIP_FROM_NAME);
      case NEEDS_BY_DATE:
        return shipmentRoot.get(NEEDS_BY_DATE);
      case SHIP_VIA_CODE:
        return shipmentRoot.get(SHIP_VIA_CODE);
      case ServiceCommonConstants.SHIPMENT_SERVICE_LEVEL:
        {
          return shipmentRoot.get(ServiceCommonConstants.SHIPMENT_SERVICE_LEVEL);
        }
      case ServiceCommonConstants.SHIPMENT_TXN_ID:
        {
          return shipmentRoot.get(ServiceCommonConstants.SHIPMENT_TXN_ID);
        }

      case STATUS_CONDITION:
        return cb.<Integer>selectCase()
            .when(
                cb.and(
                    cb.greaterThanOrEqualTo(root.get(RISK_SCORE), -20),
                    cb.lessThan(root.get(RISK_SCORE), 0)),
                1)
            .when(
                cb.and(
                    cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 0),
                    cb.lessThan(root.get(RISK_SCORE), 20)),
                2)
            .when(
                cb.and(
                    cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 20),
                    cb.lessThan(root.get(RISK_SCORE), 40)),
                3)
            .when(
                cb.and(
                    cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 40),
                    cb.lessThan(root.get(RISK_SCORE), 60)),
                4)
            .when(cb.and(cb.greaterThanOrEqualTo(root.get(RISK_SCORE), 60)), 5);

      default:
        return root.get(ServiceCommonConstants.TRACKING_CREATED_AT);
    }
  }
