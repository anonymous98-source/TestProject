import jakarta.validation.constraints.NotNull;
import java.util.UUID;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;

@Slf4j
@Service
@RequiredArgsConstructor
public class OspEnrollmentEligibilityService implements TrackingGenericService {

  private final ShipmentDtoCommonMapper shipmentDtoCommonMapper;
  private final PackageRepository packageRepository;
  private final ShipmentRepository shipmentRepository;
  private final AdditionalServicePackageRepository additionalServicePackageRepository;
  private final ShipmentProtectionEnrollmentRepository shipmentProtectionEnrollmentRepository;
  private final TrackingRepository trackingRepository;

  public boolean isEligibleForOspEnrollment(TrackingEntity trackingEntity) {

    if (trackingEntity == null || !StringUtils.hasText(trackingEntity.getTrackingNumber())) {
      log.atWarn()
              .setMessage("Tracking is null or tracking number is missing")
              .log();
      return false;
    }

    var packageEntity = packageRepository.findById(trackingEntity.getPackageId()).orElse(null);
    if (packageEntity == null) {
      log.atWarn()
              .setMessage("Package is null for tracking number")
              .addKeyValue("trackingNumber", trackingEntity.getTrackingNumber())
              .log();
      return false;
    }

    var shipmentEntity = shipmentRepository.findById(packageEntity.getShipmentId()).orElse(null);
    if (shipmentEntity == null) {
      log.atWarn()
              .setMessage("Shipment is null for tracking number")
              .addKeyValue("trackingNumber", trackingEntity.getTrackingNumber())
              .log();
      return false;
    }

    String carrier = shipmentEntity.getShipmentCarrierDetails();
    if (!ServiceCommonConstants.FEDEX.equalsIgnoreCase(carrier)) {
      log.atWarn()
              .setMessage("Carrier is not FedEx")
              .addKeyValue("carrier", carrier)
              .log();
      return false;
    }
    String serviceLevel = shipmentEntity.getShipmentServiceLevel();

    if (!StringUtils.hasText(serviceLevel)) {
      log.atError()
              .setMessage("Service level is missing for FedEx shipmentEntity.")
              .log();
      return false;
    }
    String normalizedServiceLevel = serviceLevel.trim().toUpperCase().replaceAll("\\s+", "_");
    shipmentEntity.setShipmentServiceLevel(normalizedServiceLevel);
    log.atInfo()
            .setMessage("Normalized service level")
            .addKeyValue("normalizedServiceLevel", normalizedServiceLevel)
            .log();

    if (!ServiceCommonConstants.PICKED_UP.equalsIgnoreCase(
            trackingEntity.getTrackingLastStatus())) {
      log.atInfo()
              .setMessage("Tracking status is not PICKED_UP")
              .log();
      return false;
    }

    var additionalServicePackage =
            additionalServicePackageRepository.findByPackageId(packageEntity.getId());
    var isProtectionOpted = additionalServicePackage.getIsShipmentProtection();
    var shipmentId = shipmentEntity.getId();
    var enrollmentOpt =
            shipmentProtectionEnrollmentRepository.findByShipmentIdAndTrackingNumber(
                    shipmentId, trackingEntity.getTrackingNumber());
    var enrollment = enrollmentOpt.orElse(null);
    boolean isEnrollmentRequired =
            (enrollment == null)
                    || (!String.valueOf(HttpStatus.OK.value()).equalsIgnoreCase(enrollment.getStatusCode())
                    && StringUtils.hasText(enrollment.getErrorMessage()));
    return Boolean.TRUE.equals(isProtectionOpted) && isEnrollmentRequired;
  }

  public OspEligibilityResponse checkAndEnrollPackageCoverageInOSP(TrackingEntity trackingEntity) {
    var shipmentEntity = shipmentRepository.findByTrackingId(trackingEntity.getId());
    var additionalServicePackageEntity =
            additionalServicePackageRepository.findByTrackingId(trackingEntity.getId());

    if (additionalServicePackageEntity == null) {
      log.atInfo()
              .setMessage("Additional service package not found")
              .addKeyValue("trackingId", trackingEntity.getId())
              .log();
      return buildOspEligibilityResponse(trackingEntity, false, null);
    }
    var trackingNumber = trackingEntity.getTrackingNumber();
    var hasOptedIn = additionalServicePackageEntity.getIsShipmentProtection();
    var shipmentProtectionAmount = additionalServicePackageEntity.getShipmentProtectionAmount();
    var enrollmentOpt =
            shipmentProtectionEnrollmentRepository.findByShipmentIdAndTrackingNumber(
                    shipmentEntity.getId(), trackingNumber);
    var isRequiredToEnroll =
            isOSPEnrollmentRequired(enrollmentOpt.orElse(null), shipmentEntity.getId(), trackingNumber);
    var shouldEnroll = Boolean.TRUE.equals(hasOptedIn) && isRequiredToEnroll;

    if (!shouldEnroll) {
      log.atInfo()
              .setMessage("OSP enrollment not required")
              .log();
    }

    return buildOspEligibilityResponse(trackingEntity, shouldEnroll, shipmentProtectionAmount);
  }

  public boolean isOSPEnrollmentRequired(
          ShipmentProtectionEnrollmentEntity enrollment,
          @NotNull UUID shipmentId,
          @NotNull String trackingNumber) {
    if (enrollment == null) {
      log.atInfo()
              .setMessage("No enrollment found")
              .addKeyValue("shipmentEntityId", shipmentId)
              .addKeyValue("trackingNumber", trackingNumber)
              .log();
      return true;
    }

    if (StringUtils.hasText(enrollment.getStatusCode())
            && !String.valueOf(HttpStatus.OK.value()).equalsIgnoreCase(enrollment.getStatusCode())
            && StringUtils.hasText(enrollment.getErrorMessage())) {
      log.atInfo()
              .setMessage("Previous enrollment failed")
              .addKeyValue("shipmentEntityId", shipmentId)
              .addKeyValue("trackingNumber", trackingNumber)
              .log();
      return true;
    }

    return false;
  }

  private OspEligibilityResponse buildOspEligibilityResponse(
          TrackingEntity trackingEntity,
          boolean isShipmentProtection,
          Double shipmentProtectionAmount) {
    var additionalServicePackageEntity =
            additionalServicePackageRepository.findByPackageId(trackingEntity.getPackageId());
    if (additionalServicePackageEntity == null) {
      return OspEligibilityResponse.builder()
              .isShipmentProtection(isShipmentProtection)
              .ospShipmentProtectionAmount(shipmentProtectionAmount)
              .build();
    }

    var shipment = shipmentRepository.findByPackageId(trackingEntity.getPackageId());

    return OspEligibilityResponse.builder()
            .shipmentDto(shipmentDtoCommonMapper.fromEntityWithJoins(shipment))
            .isShipmentProtection(isShipmentProtection)
            .ospShipmentProtectionAmount(shipmentProtectionAmount)
            .build();
  }

  @Override
  public TrackingResourceResponse saveTrackingResourceData(
          TrackingResourceRequest trackingResourceRequest, OflUserDetailsDTO oflUserDetailsDTO)
          throws TrackingResourceException {

    var ospEligibilityRequest = (OspEligibilityRequest) trackingResourceRequest;
    var trackingId = ospEligibilityRequest.getTrackingNumber();
    var trackingEntity = trackingRepository.findByTrackingNumber(trackingId);
    var additionalServicePackageEntity =
            additionalServicePackageRepository.findByPackageId(trackingEntity.getPackageId());
    if (additionalServicePackageEntity == null) {
      var shipmentEntity = shipmentRepository.findByPackageId(trackingEntity.getPackageId());
      if (shipmentEntity == null) {
        log.atError()
                .setMessage("Tracking or nested entities are null")
                .addKeyValue(
                        "trackingNumber",
                        trackingEntity.getTrackingNumber())
                .log();
        return buildOspEligibilityResponse(trackingEntity, false, null);
      }
    }
    if (isEligibleForOspEnrollment(trackingEntity)) {
      return checkAndEnrollPackageCoverageInOSP(trackingEntity);
    }

    return buildOspEligibilityResponse(trackingEntity, false, null);
  }
}

