            .graphData(countDetails)
            .totalCount(
                countDetails.stream()
                    .filter(e -> e.getCount() != null)
                    .mapToLong(GraphDataResponseDto::getCount)
                    .sum());

        // Set shipmentEntity trend only if applicable (Overview tab)
        graphDataResponseBuilder.shipmentTrend(
            fetchShipmentTrends(graphDataRequestDto, customerIdList));
      }
      case VisualizationConstant.GRAPH_CODE_SHIPMENT_COUNT_HOURLY_HEAT_MAP -> {
        customerIdList =
            RequestValidationAndMapperUtils.validateHeatMapInclusionOfUnverifiedDataCustomerIdList(
                graphDataRequestDto, customerIdList);
        // All tab - hourly shipmentEntity count heat map graph
        var heatMapResponseData =
            fetchShipmentHeatMapGraphData(graphDataRequestDto, customerIdList);
        graphDataResponseBuilder.graphData(heatMapResponseData);
      }
      case VisualizationConstant.GRAPH_CODE_SHIPMENT_COUNT_PROGRESS -> {
        // All tab - shipmentEntity count progress graph
        var progressLineChartData =
            fetchShipmentProgressLineChart(graphDataRequestDto, customerIdList);
        graphDataResponseBuilder.graphData(progressLineChartData);
      }
      case VisualizationConstant.GRAPH_CODE_SHIPPING_PROFILE_USAGE -> {
        // Productivity tab - shipping profile usage graph
        var shippingProfileGraphDistribution =
            fetchShippingProfileUsageGraphData(graphDataRequestDto);
        graphDataResponseBuilder
            .graphData(shippingProfileGraphDistribution)
            .totalCount( // total count for this graph is sum of counts of each shipping profile
                // used, for % calculation in UI
                shippingProfileGraphDistribution.stream()
                    .filter(e -> e.getCount() != null)
                    .mapToLong(GraphDataResponseDto::getCount)
                    .sum());
      }
      case VisualizationConstant.GRAPH_CODE_OCCURRED_TOP_COURIER_REASON_CODE,
          VisualizationConstant.GRAPH_CODE_COURIER_SHIPMENT_VS_REASON_CODE -> {
