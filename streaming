  /**
   * Fetches address suggestion usage data for the Productivity tab, including total suggestions,
   * accepted, declined suggestions (only applicable for residential), and no action counts.
   *
   * @param graphDataRequestDto the request DTO containing filter parameters
   * @param graphDataResponseBuilder the builder for constructing the response DTO
   */
  private void fetchAddressSuggestionUsageData(
      GraphDataRequestDto graphDataRequestDto,
      DashboardGenericResponseDto.DashboardGenericResponseDtoBuilder graphDataResponseBuilder) {
    // Address suggestion usage graph is only applicable for Productivity tab
    if (!VisualizationConstant.TAB_NAME_PRODUCTIVITY.equalsIgnoreCase(
        graphDataRequestDto.getVisualizationTabName())) {
      throw new ValidationException(
          "Address suggestion usage graph is only applicable for Productivity tab");
    }

    List<AddressAdherenceUsageProjection> addressAdherenceProjections =
        addressAdherenceMVRepository.fetchAddressAdherenceSuggestionUsageData(
            graphDataRequestDto.getSelectedCarriers(),
            graphDataRequestDto.getSelectedServiceLevels(),
            graphDataRequestDto.getFacilityIdList(),
            graphDataRequestDto.getUserEmailIds(),
            graphDataRequestDto.getPeriodInDays().intValue());

    List<GraphDataResponseDto> addressSuggestionUsage = new ArrayList<>();
    AtomicLong totalAddressSuggestions = new AtomicLong(0);
    AtomicLong totalAcceptedAddressSuggestions = new AtomicLong(0);
    AtomicLong totalNoActionAddressSuggestions = new AtomicLong(0);

    AtomicLong totalResidentialAddressSuggestions = new AtomicLong(0);
    AtomicLong totalAcceptedResidentialAddressSuggestions = new AtomicLong(0);
    AtomicLong totalDeclinedResidentialAddressSuggestions = new AtomicLong(0);
    AtomicLong totalNoActionResidentialAddressSuggestions = new AtomicLong(0);

    // Accepted & no-action is applicable for both type of address suggestion
    // Declined is only applicable for residential address suggestion
    addressAdherenceProjections.stream()
        .map(
            projection ->
                GraphDataResponseDto.builder()
                    .date(projection.getGroupedPeriod())
                    .day(projection.getGroupedPeriodDay())
                    .suggestionAcceptedCount(projection.getSuggestionAccepted())
                    .noActionOrNoSuggestionCount(projection.getNoActionOrNoSuggestion())
                    .residentialSuggestionAcceptedCount(
                        projection.getResidentialSuggestionAccepted())
                    .residentialSuggestionDeclinedCount(
                        projection.getResidentialSuggestionDeclined())
                    .residentialNoActionNoSuggestionCount(
                        projection.getResidentialNoActionOrNoSuggestion())
                    .hasNoShipmentForDate(
                        nullSafeCountFetch(projection.getTotalShipmentPackages()) == 0L)
                    .build())
        .forEach(
            graphDataResponseDto -> {
              // Update the graph data list
              addressSuggestionUsage.add(graphDataResponseDto);

              // Sum up the total counts for residential address suggestions
              totalAcceptedAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getSuggestionAcceptedCount()));
              totalNoActionAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getNoActionOrNoSuggestionCount()));
              totalAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getSuggestionAcceptedCount())
                      + nullSafeCountFetch(graphDataResponseDto.getNoActionOrNoSuggestionCount()));

              // Sum up the total counts for residential address suggestions
              totalAcceptedResidentialAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getResidentialSuggestionAcceptedCount()));
              totalDeclinedResidentialAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getResidentialSuggestionDeclinedCount()));
              totalNoActionResidentialAddressSuggestions.addAndGet(
                  nullSafeCountFetch(
                      graphDataResponseDto.getResidentialNoActionNoSuggestionCount()));
              totalResidentialAddressSuggestions.addAndGet(
                  nullSafeCountFetch(graphDataResponseDto.getResidentialSuggestionAcceptedCount())
                      + nullSafeCountFetch(
                          graphDataResponseDto.getResidentialSuggestionDeclinedCount())
                      + nullSafeCountFetch(
                          graphDataResponseDto.getResidentialNoActionNoSuggestionCount()));
            });

    // Set in response builder all the address suggestion usage data
    // And the total counts for residential and address suggestions
    graphDataResponseBuilder.graphData(addressSuggestionUsage);
    graphDataResponseBuilder.totalAddressSuggestions(totalAddressSuggestions.get());
    graphDataResponseBuilder.totalResidentialAddressSuggestions(
        totalResidentialAddressSuggestions.get());
    graphDataResponseBuilder.totalAcceptedAddressSuggestions(totalAcceptedAddressSuggestions.get());
    graphDataResponseBuilder.totalNoSuggestionAddressSuggestions(
        totalNoActionAddressSuggestions.get());
    graphDataResponseBuilder.totalAcceptedResidentialAddressSuggestions(
        totalAcceptedResidentialAddressSuggestions.get());
    graphDataResponseBuilder.totalDeclinedResidentialAddressSuggestions(
        totalDeclinedResidentialAddressSuggestions.get());
    graphDataResponseBuilder.totalNoSuggestionResidentialAddressSuggestions(
        totalNoActionResidentialAddressSuggestions.get());
  }

  /**
   * Fetches pick up and scan timeline data for the carrier tab, including earliest/last scan times,
   * average scan times, and average duration between first and last scan.
   *
   * @param graphDataRequestDto the request DTO containing filter parameters
   * @param customerIdList the list of customer IDs to filter by (can be null)
   * @param graphDataResponseBuilder the builder for constructing the response DTO
   */
  private void fetchPickUpAndScanTimelineData(
      GraphDataRequestDto graphDataRequestDto,
      List<String> customerIdList,
      DashboardGenericResponseDto.DashboardGenericResponseDtoBuilder graphDataResponseBuilder) {

    // Pick Up and Scan Timeline graph is only applicable for all carrier tabs
    if (VisualizationConstant.TAB_NAME_OVERVIEW.equalsIgnoreCase(
            graphDataRequestDto.getVisualizationTabName())
        || VisualizationConstant.TAB_NAME_PRODUCTIVITY.equalsIgnoreCase(
            graphDataRequestDto.getVisualizationTabName())) {
      throw new ValidationException(
          "Pick Up and Scan Timeline graph is only applicable for Carrier tabs");
    }

    // Fetch pick up and scan timeline data from materialized view based on the filters
    Optional<PickupTimelineProjection> pickUpAndScanTimelineData =
        getValidatedPickUpScanTimelineData(graphDataRequestDto, customerIdList);

    if (pickUpAndScanTimelineData.isEmpty()) {
      graphDataResponseBuilder.pickUpTimeLineGraphData(PickUpTimeLineResponseDto.builder().build());
      return; // if there is no data, return empty DTO
    }

    // Calculate averages
    PickUpTimeLineResponseDto pickUpTimeLineDto = PickUpTimeLineResponseDto.builder().build();
    pickUpTimeLineDto.setAveragePickUpDuration(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getAverageDuration)
            .map(this::formatDuration)
            .orElse(null)
    );
    pickUpTimeLineDto.setAbsoluteEarliestScan(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getAbsoluteFirstScan)
            .map(t -> t.format(VisualizationConstant.TIME_FORMATTER_WITH_AM_PM))
            .orElse(null));

    pickUpTimeLineDto.setAverageEarliestScan(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getOverallAverageFirstScan)
            .map(t -> t.format(VisualizationConstant.TIME_FORMATTER_WITH_AM_PM))
            .orElse(null));

    pickUpTimeLineDto.setAverageLastScan(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getOverallAverageLastScan)
            .map(t -> t.format(VisualizationConstant.TIME_FORMATTER_WITH_AM_PM))
            .orElse(null));

    pickUpTimeLineDto.setAbsoluteLastScan(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getAbsoluteLastScan)
            .map(t -> t.format(VisualizationConstant.TIME_FORMATTER_WITH_AM_PM))
            .orElse(null));

    pickUpTimeLineDto.setAveragePickUpScanTime(pickUpAndScanTimelineData
            .map(PickupTimelineProjection::getAverageOverallPickUpScan)
            .map(t -> t.format(VisualizationConstant.TIME_FORMATTER_WITH_AM_PM))
            .orElse(null));

    // adjusting the average pickup duration based on the other calculated pickup & raw data
    // And update required fields in the provided DTO in request
    VisualizationUtils.adjustAvgPickUpDurationBasedOnData(pickUpTimeLineDto);

    // setting the pickup and scan timeline data in graph response builder
    graphDataResponseBuilder.pickUpTimeLineGraphData(pickUpTimeLineDto);
  }

  /**
   * Formats a duration represented as a LocalTime into a string format like "X hr Y min".
   *
   * @param time the LocalTime representing the duration (hours and minutes)
   * @return a formatted string representing the duration, or null if input is null
   */
  private String formatDuration(LocalTime time) {
    if (time == null) return null;
    int hours = time.getHour();
    int minutes = time.getMinute();
    StringBuilder sb = new StringBuilder();
    if (hours > 0) {
      sb.append(hours).append(" hr");
    }
    if (minutes > 0 && !sb.isEmpty()) {
      sb.append(" ").append(minutes).append(" min");
    }

    return sb.toString();
  }

  /**
   * Helper method to determine if there are no shipments for a given date and carrier based on the
   * shipmentEntity count.
   *
   * @param date the date to check for shipments (as a string)
   * @param carrier the carrier to check for shipments (can be null or empty for all carriers)
   * @param shipmentCount the count of shipments for the given date and carrier
   * @return true if there are no shipments for the given date and carrier, false otherwise
   */
  private Boolean determineZeroShipmentOnDate(String date, String carrier, Long shipmentCount) {
    return StringUtils.isBlank(date)
        || StringUtils.isEmpty(carrier)
        || shipmentCount == null
        || shipmentCount <= 0L;
  }

  /**
   * Helper method to safely handle null values for count fields by treating null as zero.
   *
   * @param count the count value that may be null
   * @return the original count if it's not null, or zero if it is null
   */
  private long nullSafeCountFetch(Long count) {
    return Optional.ofNullable(count).orElse(0L);
  }

  /**
   * Fetches and validates pick up and scan timeline data from the materialized view based on the
   * provided filters. It ensures that only records with non-null pickup times are considered for
   * the timeline graph, as pickup time is essential for the graph's accuracy.
