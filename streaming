package com.cardinalhealth.advship.tracking.resource.purge.sql;

import com.cardinalhealth.advship.tracking.resource.purge.PurgeField;
import org.springframework.stereotype.Component;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

import static com.cardinalhealth.advship.tracking.resource.purge.PurgeFieldRegistry.FIELDS;

/**
 * Builds the actual SQL UPDATE statements for backup + redaction.
 */
@Component
public class SqlBundleBuilder {

    public Map<String, String> buildOriginalScripts(Map<String, List<Map<String, Object>>> tableRows) {
        Map<String, StringBuilder> builders = new LinkedHashMap<>();

        Map<String, List<PurgeField>> fieldsByTable = FIELDS.stream()
                .collect(Collectors.groupingBy(PurgeField::getTableName));

        for (Map.Entry<String, List<Map<String, Object>>> entry : tableRows.entrySet()) {
            String table = entry.getKey();
            List<Map<String, Object>> rows = entry.getValue();
            List<PurgeField> fields = fieldsByTable.getOrDefault(table, List.of());
            if (fields.isEmpty() || rows.isEmpty()) {
                continue;
            }

            StringBuilder sb = builders.computeIfAbsent(table, t -> new StringBuilder());

            for (Map<String, Object> row : rows) {
                Object id = row.get("id");
                if (id == null) {
                    continue;
                }

                sb.append("UPDATE ")
                        .append(table)
                        .append(" SET ");

                String setClause = fields.stream()
                        .map(f -> f.getColumnName() + " = " + toSqlLiteral(row.get(f.getColumnName()), f.getDataType()))
                        .collect(Collectors.joining(", "));

                sb.append(setClause)
                        .append(" WHERE id = ")
                        .append(toSqlLiteral(id, "text"))
                        .append(";");
            }
        }

        return builders.entrySet().stream()
                .collect(Collectors.toMap(
                        Map.Entry::getKey,
                        e -> e.getValue().toString(),
                        (a, b) -> a,
                        LinkedHashMap::new
                ));
    }

    public Map<String, String> buildRedactedScripts(Map<String, List<Map<String, Object>>> tableRows) {
        Map<String, StringBuilder> builders = new LinkedHashMap<>();

        Map<String, List<PurgeField>> fieldsByTable = FIELDS.stream()
                .collect(Collectors.groupingBy(PurgeField::getTableName));

        for (Map.Entry<String, List<Map<String, Object>>> entry : tableRows.entrySet()) {
            String table = entry.getKey();
            List<Map<String, Object>> rows = entry.getValue();
            List<PurgeField> fields = fieldsByTable.getOrDefault(table, List.of());
            if (fields.isEmpty() || rows.isEmpty()) {
                continue;
            }

            StringBuilder sb = builders.computeIfAbsent(table, t -> new StringBuilder());

            for (Map<String, Object> row : rows) {
                Object id = row.get("id");
                if (id == null) {
                    continue;
                }

                sb.append("UPDATE advship_tracking_resource.")
                        .append(table)
                        .append(" SET ");

                String setClause = fields.stream()
                        .map(f -> {
                            if ("json".equalsIgnoreCase(f.getDataType())) {
                                return f.getColumnName() + " = '\"Redacted\"'::jsonb";
                            } else {
                                return f.getColumnName() + " = 'Redacted'";
                            }
                        })
                        .collect(Collectors.joining(", "));

                sb.append(setClause)
                        .append(" WHERE id = ")
                        .append(toSqlLiteral(id, "text"))
                        .append("; ");
            }
        }

        return builders.entrySet().stream()
                .collect(Collectors.toMap(
                        Map.Entry::getKey,
                        e -> e.getValue().toString(),
                        (a, b) -> a,
                        LinkedHashMap::new
                ));
    }

    private String toSqlLiteral(Object value, String dataType) {
        if (value == null) {
            return "NULL";
        }
        if ("json".equalsIgnoreCase(dataType)) {
            return "'" + escapeSingleQuotes(value.toString()) + "'::jsonb";
        }
        // default to text
        return "'" + escapeSingleQuotes(value.toString()) + "'";
    }

    private String escapeSingleQuotes(String v) {
        return v.replace("'", "''");
    }
}

