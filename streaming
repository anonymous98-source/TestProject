package com.cardinalhealth.advship.tracking.resource.service.utils;


import com.cardinalhealth.advship.tracking.resource.constants.ServiceCommonConstants;
import com.cardinalhealth.advship.tracking.resource.database.entity.SavedViewsReportsEntity;
import com.cardinalhealth.advship.tracking.resource.model.response.filters.TrackingFilterResponseDto;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import org.springframework.stereotype.Service;

@Service
public class TrackingFilterOrderingService {

    /**
     * Main sorter:
     * - If no explicit order exists (neither in DTOs nor DB), use default code order.
     * - If explicit order exists anywhere, ordered items come first (ascending),
     *   ties are on the same "level" (tie-breakers are deterministic only for stability),
     *   then the rest by default code order.
     */
    public List<TrackingFilterResponseDto> applyOrderingOrDefaultSorting(
            List<TrackingFilterResponseDto> allFilters,
            List<SavedViewsReportsEntity> dbRows
    ) {

        if (allFilters == null || allFilters.isEmpty()) return allFilters;

        // Map DB viewName → order
        Map<String, Integer> dbOrderMap = new HashMap<>();
        for (SavedViewsReportsEntity row : dbRows) {
            if (row == null) continue;
//            dbOrderMap.put(row.getViewName(), row.getViewOrder());
        }

        // --- RULE 1: Check if ALL viewNames in result exist in DB ---
        boolean allPresentInDb = allFilters.stream()
                .allMatch(f -> dbOrderMap.containsKey(f.getViewName()));

        if (allPresentInDb) {

            // --- RULE 2: Check if ALL viewOrders are non-null and >= 0 ---
            boolean allHaveValidOrder = allFilters.stream()
                    .map(f -> dbOrderMap.get(f.getViewName()))
                    .allMatch(ord -> ord != null && ord >= 0);

            if (allHaveValidOrder) {

                // --- Full DB ordering applies ---
                return allFilters.stream()
                        .sorted(Comparator.comparing(
                                f -> dbOrderMap.get(f.getViewName())
                        ))
                        .toList();
            }
        }

        // --- RULE 3: Default fallback sorting ---
        // Standard first by DEFAULT_CODE_ORDER, then custom in any order

        List<TrackingFilterResponseDto> standards = new ArrayList<>();
        List<TrackingFilterResponseDto> customs = new ArrayList<>();

        for (TrackingFilterResponseDto f : allFilters) {
            if (Boolean.TRUE.equals(f.getIsBaseView()))
                standards.add(f);
            else
                customs.add(f);
        }

        // Sort standards by DEFAULT_CODE_ORDER
        standards.sort(Comparator.comparing(
                f -> ServiceCommonConstants.DEFAULT_CODE_ORDER.indexOf(f.getViewName())
        ));

        // Custom order doesn't matter
        List<TrackingFilterResponseDto> finalList = new ArrayList<>();
        finalList.addAll(standards);
        finalList.addAll(customs);

        return finalList;
    }

    /** Upsert a standard view by viewName (case-insensitive). If it already exists in `result`, update its fields; else add it. */
    public void upsertStandardView(
            List<TrackingFilterResponseDto> result,
            String viewName,
            String code,
            Long count // or Integer if your count is Integer
    ) {

        // Find existing standard by exact (case-sensitive) name (prefer baseView==true if present)
        TrackingFilterResponseDto existing = null;
        for (TrackingFilterResponseDto f : result) {
            if (f != null && f.getViewName() != null && f.getViewName().equals(viewName)) {
                // If multiple (DB standard + custom with same name), prefer baseView==true
                if (Boolean.TRUE.equals(f.getIsBaseView())) {
                    existing = f;
                    break;
                }
                if (existing == null) existing = f; // fallback if only a non-base exists
            }
        }

        if (existing != null) {
            // Update the DB-provided standard with fresh, authoritative values
            existing.setCode(code);            // always ensure the canonical code
            existing.setCount(count);          // attach fresh count
            existing.setViewActive(true);      // standards are active by definition here
            existing.setIsBaseView(true);      // ensure it's marked as standard
            // NOTE: Do NOT touch viewOrder here; if DB provided one, we keep it.
        } else {
            // Not present in DB → attach explicitly
            result.add(TrackingFilterResponseDto.builder()
                    .viewName(viewName)
                    .code(code)
                    .count(count)
                    .viewActive(true)
                    .isBaseView(true)
                    .build());
        }
    }
}

