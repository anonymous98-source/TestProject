  private Reference getReference(TrackingDetailsProjection trackingDetailsProjection) {
    JsonNode externalRefJson = trackingDetailsProjection.getExternalReferenceValueJson();

    if (externalRefJson == null || externalRefJson.isNull()) {
      return new Reference(); // return empty Reference if null
    }
    try {
      ObjectMapper mapper = new ObjectMapper();
      return mapper.treeToValue(externalRefJson, Reference.class);
    } catch (Exception e) {
      log.atError()
              .setMessage("Error parsing externalReferenceValueJson")
              .addKeyValue("errorMessage", e.getMessage())
              .setCause(e)
              .log();
      return new Reference(); // fallback to empty Reference
    }
  }

