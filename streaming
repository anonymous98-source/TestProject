  private MockedStatic<FedexToTrackingInputMapper> mockStaticMapper() {

    MockedStatic<FedexToTrackingInputMapper> mocked =
        org.mockito.Mockito.mockStatic(FedexToTrackingInputMapper.class);

    mocked
        .when(() ->
            FedexToTrackingInputMapper.convertToCompatibleFormatWithOffset(anyString()))
        .thenReturn("2026-09-09T10:00:00");

    mocked
        .when(() ->
            FedexToTrackingInputMapper.convertToCompatibleFormatWithoutOffset(anyString()))
        .thenReturn("2026-09-09T10:00:00");

    mocked
        .when(() ->
            FedexToTrackingInputMapper.mapEventTypeFromEventDescriptionStatus(anyString()))
        .thenReturn("DELIVERED");

    mocked
        .when(() ->
            FedexToTrackingInputMapper.getBeginDateByType(any(), any()))
        .thenReturn("2026-09-01");

    /*
     * IMPORTANT:
     *
     * mapFedexToTrackingInput() returns ShipmentDTO,
     * NOT Object.
     */
    mocked
        .when(() ->
            FedexToTrackingInputMapper.mapFedexToTrackingInput(any(), any()))
        .thenReturn(mock(ShipmentDTO.class));

    return mocked;
  }

