import org.mapstruct.AfterMapping;
import org.mapstruct.Mapper;
import org.mapstruct.MappingTarget;

import java.math.BigDecimal;
import java.math.RoundingMode;

@Mapper(componentModel = "spring")
public interface PriceQuoteMapper {

  PriceQuoteDto toDto(PriceQuoteEntity priceQuoteEntity);

  /**
   * Rounds the Double fields in priceQuoteDto to two decimal places after mapping.
   *
   * @param priceQuoteDto the PriceQuoteDto object to be processed
   */
  @AfterMapping
  default void roundDoubleFieldsUptoTwoDecimalPlace(@MappingTarget PriceQuoteDto priceQuoteDto) {
    if (priceQuoteDto == null || priceQuoteDto.getTotalAmount() == null) {
      return;
    }

    // Rounding totalAmount to 2 decimal places, truncating whatever is after 2 decimal places
    priceQuoteDto.setTotalAmount(
            new BigDecimal(String.valueOf(priceQuoteDto.getTotalAmount()))
                    .setScale(2, RoundingMode.DOWN)
                    .doubleValue());
  }
}

