package com.cardinalhealth.advship.tracking.resource.service.utils;

import lombok.extern.slf4j.Slf4j;

import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.ZonedDateTime;

@Slf4j
public class DateTimeUtil {
    private DateTimeUtil() {}

    /**
     * Converts a LocalDateTime in a given time zone to UTC ZonedDateTime.
     * @param localDateTime the local date-time
     * @param timeZone the time zone ID (e.g., "CST", "EST", "America/Chicago")
     * @return ZonedDateTime in UTC
     */
    public static ZonedDateTime toUtcZonedDateTime(LocalDateTime localDateTime, String timeZone) {
        ZoneId sourceZone = ZoneId.of(timeZone, ZoneId.SHORT_IDS);
        ZonedDateTime zonedDateTime = localDateTime.atZone(sourceZone);
        return zonedDateTime.withZoneSameInstant(ZoneId.of("UTC"));
    }

    /**
     * Converts a LocalDateTime in a given time zone to UTC LocalDateTime.
     * @param localDateTime the local date-time
     * @param timeZone the time zone ID (e.g., "CST", "EST", "America/Chicago")
     * @return LocalDateTime in UTC
     */
    public static LocalDateTime toUtcLocalDateTime(LocalDateTime localDateTime, String timeZone) {
        return toUtcZonedDateTime(localDateTime, timeZone).toLocalDateTime();
    }

    public static LocalDateTime buildLocalDateTimeFromTimeZone(LocalDateTime dateTime, String timeZone) {
        if (dateTime == null || timeZone == null || timeZone.isEmpty())
            return dateTime;
        try {
            return DateTimeUtil.toUtcLocalDateTime(dateTime, timeZone);
        } catch (Exception e) {
            log.atError()
                    .setMessage("Failed to convert dateTime to UTC using timeZone: " + timeZone)
                    .setCause(e)
                    .log();
            return dateTime; // Return original dateTime if conversion fails
        }
    }

    public static LocalDateTime convertUtcToUserTime(LocalDateTime utcDateTime, String timeZone) {
        if (utcDateTime == null || timeZone == null || timeZone.isEmpty()) {
            return utcDateTime;
        }

        try {
            ZonedDateTime utcZoned = utcDateTime.atZone(ZoneId.of("UTC"));
            ZonedDateTime userZoned = utcZoned.withZoneSameInstant(ZoneId.of(timeZone));
            return userZoned.toLocalDateTime();
        } catch (Exception e) {

            log.atError()
                    .setMessage("Failed to convert UTC date time to user's timeZone: " + timeZone)
                    .setCause(e)
                    .log();
            return utcDateTime;
        }
    }
}

