@Slf4j
@Service
@RequiredArgsConstructor
public class OspEnrollmentDataService implements TrackingGenericService {

  private final ObjectMapper objectMapper;
  private final ShipmentRepository shipmentRepository;
  private final ShipmentProtectionEnrollmentRepository shipmentProtectionEnrollmentRepository;
  private final ShipmentDtoCommonMapper shipmentDtoCommonMapper;

  private ShipmentProtectionEnrollmentEntity updatedShipmentProtectionData(
      ShipmentProtectionEnrollmentEntity shipmentProtectionEnrollmentEntity,
      List<SaveElectionRequestBody> ospRequestBody,
      String trackingNumber,
      SaveElectionResponseBody ospResponse,
      UUID shipmentId) {

    if (shipmentProtectionEnrollmentEntity == null) {
      log.info("Creating new shipmentEntity protection enrollment entity");
      shipmentProtectionEnrollmentEntity = new ShipmentProtectionEnrollmentEntity();
      shipmentProtectionEnrollmentEntity.setShipmentId(shipmentId);
      shipmentProtectionEnrollmentEntity.setRetrySequence(1);
      shipmentProtectionEnrollmentEntity.setTrackingNumber(trackingNumber);
    } else {
      log.info("Updating existing shipmentEntity protection enrollment entity");
      int currentRetry = shipmentProtectionEnrollmentEntity.getRetrySequence();
      shipmentProtectionEnrollmentEntity.setRetrySequence(Math.min(currentRetry + 1, 3));
    }

    var shipmentEntity =
        shipmentRepository
            .findById(shipmentId)
            .orElseThrow(() -> new RuntimeException("Shipment not found for ID: " + shipmentId));

    shipmentProtectionEnrollmentEntity.setShipmentSubmittedOn(
        shipmentEntity.getShipmentCreatedAt().toInstant().atZone(ZoneOffset.UTC).toLocalDateTime());
    shipmentProtectionEnrollmentEntity.setErrorMessage(ospResponse.getErrorMessage());
    shipmentProtectionEnrollmentEntity.setRequestJson(objectMapper.valueToTree(ospRequestBody));
    shipmentProtectionEnrollmentEntity.setResponseJson(objectMapper.valueToTree(ospResponse));
    shipmentProtectionEnrollmentEntity.setStatusCode(
        ospResponse.getSaveElectionResponseStatusCode());

    return shipmentProtectionEnrollmentEntity;
  }

  @Override
  public TrackingResourceResponse saveTrackingResourceData(
      TrackingResourceRequest trackingResourceRequest, OflUserDetailsDTO oflUserDetailsDTO)
      throws TrackingResourceException {

    OspEnrollmentDataRequest request = (OspEnrollmentDataRequest) trackingResourceRequest;

    var shipmentEntity =
        shipmentRepository
            .findById(request.getShipmentId())
            .orElseThrow(
                () ->
                    new RuntimeException("Shipment not found for ID: " + request.getShipmentId()));

    var existingEnrollment =
        shipmentProtectionEnrollmentRepository
            .findByTrackingNumber(request.getTrackingNumber())
            .orElse(null);

    var updatedEnrollment =
        updatedShipmentProtectionData(
            existingEnrollment,
            request.getSaveElectionRequestBody(),
            request.getTrackingNumber(),
            request.getOspResponse(),
            request.getShipmentId());

    shipmentProtectionEnrollmentRepository.saveAndFlush(updatedEnrollment);

    log.info(
        String.format(
            "OSP Save Election API call finished with status %s, returning from %s",
            updatedEnrollment.getStatusCode(), this.getClass().getName()));

    return OspEnrollmentDataResponse.builder()
        .id(updatedEnrollment.getId())
        .statusCode(updatedEnrollment.getStatusCode())
        .requestJson(updatedEnrollment.getRequestJson())
        .responseJson(updatedEnrollment.getResponseJson())
        .retrySequence(updatedEnrollment.getRetrySequence())
        .errorMessage(updatedEnrollment.getErrorMessage())
        .shipmentSubmittedOn(updatedEnrollment.getShipmentSubmittedOn())
        .shipment(shipmentDtoCommonMapper.fromEntityWithJoins(shipmentEntity))
        .trackingNumber(updatedEnrollment.getTrackingNumber())
        .build();
  }
}

